// purity diagnostics. See all.def.
KEX_DIAGNOSTIC(FoulCallFromPure, "KEXEF-0001", "cannot call foul function '{name}' from pure context")
KEX_DIAGNOSTIC(FoulTagFromPure, "KEXEF-0002", "cannot call foul tag '{name}' from pure context")
KEX_DIAGNOSTIC(FoulCaptureFromPure, "KEXEF-0003", "cannot capture foul function '{name}' from pure context")
KEX_DIAGNOSTIC(FoulKeywordInPure, "KEXEF-0004", "cannot use '{keyword}' in pure context")
KEX_DIAGNOSTIC(FoulCallInGuard, "KEXEF-0005", "cannot call foul function '{name}' in a guard")
KEX_DIAGNOSTIC(FoulTagInGuard, "KEXEF-0006", "cannot call foul tag '{name}' in a guard")
KEX_DIAGNOSTIC(TransitivelyFoulCallInGuard, "KEXEF-0007", "cannot call function '{name}' in a guard: it transitively calls foul operations")
KEX_DIAGNOSTIC(TransitivelyFoulTagInGuard, "KEXEF-0008", "cannot call tag '{name}' in a guard: it transitively calls foul operations")
