// Type diagnostics from the checker's core: typechecker.cxx, its
// intrinsics and unification, and the declaration validator. KEXET-0100 to
// KEXET-0399, and the type warnings, KEXWT-0001 on. See all.def.
KEX_DIAGNOSTIC(UndefinedMethod, "KEXET-0100", "undefined method `{name}`")
KEX_DIAGNOSTIC(UndefinedMethodFor, "KEXET-0101", "undefined method `{name}` for `{receiver}`")
KEX_DIAGNOSTIC(ConstructorArityOne, "KEXET-0102", "`{name}` takes 1 value, but got {given}")
KEX_DIAGNOSTIC(ConstructorArity, "KEXET-0103", "`{name}` takes {count} values, but got {given}")
KEX_DIAGNOSTIC(ConstructorValueType, "KEXET-0104", "`{name}` expects a value of type {expected}, but got {actual}")
KEX_DIAGNOSTIC(ConstructorValueTypeAt, "KEXET-0105", "`{name}` expects value {index} of type {expected}, but got {actual}")
KEX_DIAGNOSTIC(CastSlotImplicitFrom, "KEXET-0106", "`::>` is not valid on a cast slot. Casts have no `from`; use `:>`")
KEX_DIAGNOSTIC(NonExhaustiveMatchOn, "KEXET-0107", "non-exhaustive match on {type}: missing case(s) {cases}")
KEX_DIAGNOSTIC(NonExhaustiveMatch, "KEXET-0108", "non-exhaustive match: missing case(s) {cases}")
KEX_DIAGNOSTIC(TypeArgumentCountOne, "KEXET-0109", "`{name}` takes 1 type argument, but {given} are given")
KEX_DIAGNOSTIC(TypeArgumentCountOneGiven, "KEXET-0110", "`{name}` takes {count} type arguments, but 1 is given")
KEX_DIAGNOSTIC(TypeArgumentCount, "KEXET-0111", "`{name}` takes {count} type arguments, but {given} are given")
KEX_DIAGNOSTIC(ModuleHasNoConstructor, "KEXET-0112", "`{module}` has no constructor `{name}`")
KEX_DIAGNOSTIC(PatternConstructorOfOtherType, "KEXET-0113", "`{name}` is a constructor of `{owner}`, but the value being matched has type `{type}`. This pattern can never match")
KEX_DIAGNOSTIC(ConstructorPatternArity, "KEXET-0114", "`{name}` constructor takes {count} value(s), but the pattern destructures {given}")
KEX_DIAGNOSTIC(PatternNotAConstructorOf, "KEXET-0115", "`{name}` is not a constructor of `{type}` (it has {constructors}). This pattern can never match")
KEX_DIAGNOSTIC(RecordPatternArity, "KEXET-0116", "`{name}` record takes {count} value(s), but the pattern destructures {given}")
KEX_DIAGNOSTIC(TuplePatternArity, "KEXET-0496", "the tuple has {count} value(s), but the pattern destructures {given}: `{type}`")
KEX_DIAGNOSTIC(NotARecordType, "KEXET-0117", "`{name}` is not a record type")
KEX_DIAGNOSTIC(RecordPatternUnknownField, "KEXET-0118", "record `{record}` has no field `{field}`")
KEX_DIAGNOSTIC(DestructureConstructorMismatch, "KEXET-0119", "cannot match `{name}`: expected {expected}, got {actual}")
KEX_DIAGNOSTIC(OverloadPurityMismatch, "KEXET-0120", "overloads of `{name}` must all have the same purity")
KEX_DIAGNOSTIC(InlineReturnTypeDisagrees, "KEXET-0121", "inline return type for `{name}` disagrees with its separate annotation: {inline} versus {declared}")
KEX_DIAGNOSTIC(AnnotationParamDisagrees, "KEXET-0188", "the annotation of `{name}` says `{param}` is {declared}, but its definition says {written}")
KEX_DIAGNOSTIC(AnnotationTupleForParameters, "KEXET-0189", "`{name}` is declared with one tuple parameter, {tuple}, but takes {count}: for {count} parameters, write `{name} : {curried}`")
KEX_DIAGNOSTIC(RequiredParamType, "KEXET-0122", "`{name}` is required to take {expected} for `{param}`, but takes {actual}")
KEX_DIAGNOSTIC(ReturnsRigidTypeVariable, "KEXET-0123", "`{name}` declared to return {expected} but body returns `{variable}`, which stands for any type")
KEX_DIAGNOSTIC(ReturnsOtherTypeHere, "KEXET-0124", "`{name}` declared to return {expected} but returns {actual} here")
KEX_DIAGNOSTIC(CallSlotNoReply, "KEXET-0125", "call slot returns without `reply:` but never uses `from` for a deferred reply")
KEX_DIAGNOSTIC(RequiredReturnTypeMismatch, "KEXET-0126", "`{name}` is required to return {expected} but body returns {actual}")
KEX_DIAGNOSTIC(DeclaredReturnTypeMismatch, "KEXET-0127", "`{name}` declared to return {expected} but body returns {actual}")
KEX_DIAGNOSTIC(RedefinesPreludeMethod, "KEXET-0128", "`{name}` is defined twice for receiver `{receiver}`: here and in the prelude")
KEX_DIAGNOSTIC(AmbiguousTrait, "KEXET-0129", "ambiguous trait: `{name}` could be {candidates}. Write the one you mean")
KEX_DIAGNOSTIC(UnknownTrait, "KEXET-0130", "unknown trait: {name}")
KEX_DIAGNOSTIC(MissingRequiredMethod, "KEXET-0131", "make {type}, implement: {trait}. Missing required method '{method}'")
KEX_DIAGNOSTIC(RequiredMethodNotFoul, "KEXET-0132", "make {type}, implement: {trait}. Method '{method}' must be declared foul (trait requires it)")
KEX_DIAGNOSTIC(RedeclareVarAgain, "KEXET-0133", "cannot redeclare '{name}': already declared with 'var'")
KEX_DIAGNOSTIC(RedeclareVarAsLet, "KEXET-0134", "cannot redeclare '{name}': was declared with 'var'")
KEX_DIAGNOSTIC(RedeclareImmutable, "KEXET-0135", "cannot redeclare immutable binding: {name}")
KEX_DIAGNOSTIC(MethodArity, "KEXET-0136", "`{name}` expects {count} argument(s), got {given}")
KEX_DIAGNOSTIC(MethodArityChoice, "KEXET-0137", "`{name}` expects one of these argument counts: {count} (got {given})")
KEX_DIAGNOSTIC(ConstructorOutOfScope, "KEXET-0138", "`{name}` is a constructor of {type}, declared in module {module}: write `{module}.{name}`, or bring it in with `using {module}`")
KEX_DIAGNOSTIC(UnreachableConstructor, "KEXET-0139", "`{name}` is `{module}.{name}` here: name it so, or bring it in with `using {module}`")
KEX_DIAGNOSTIC(AmbiguousImportedName, "KEXET-0140", "ambiguous name `{name}`, imported from both `{first}` and `{second}`")
KEX_DIAGNOSTIC(TryMixedFailuresUndeclared, "KEXET-0141", "`.try` can fail, and `{name}` declares no result and mixes an Optional's `.try` with a Result's: declare it, as `{type}?` or `{type} or! E`, or handle the failure with `trying` or a `rescue`")
KEX_DIAGNOSTIC(TryReturnsUndeclared, "KEXET-0142", "`.try` can fail, and `{name}` declares no result and `return`s: declare it, as `{type}?` or `{type} or! E`, or handle the failure with `trying` or a `rescue`")
KEX_DIAGNOSTIC(TryFailureNotHeld, "KEXET-0143", "`.try` can fail, and `{name}` returns {type}, which cannot hold the failure: return a Result or an Optional, or handle it with `trying` or a `rescue`")
KEX_DIAGNOSTIC(TryFailureNotHeldBlock, "KEXET-0144", "`.try` can fail, and this block returns {type}, which cannot hold the failure: return a Result or an Optional, or handle it with `trying` or a `rescue`")
KEX_DIAGNOSTIC(UnknownType, "KEXET-0145", "unknown type `{name}`")
KEX_DIAGNOSTIC(UndefinedName, "KEXET-0146", "undefined name: `{name}`")
KEX_DIAGNOSTIC(UndefinedNameHint, "KEXET-0147", "undefined name: `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(UndefinedNameNotImported, "KEXET-0148", "undefined name: `{name}`. `{module}.{name}` is not imported here")
KEX_DIAGNOSTIC(UndefinedNamePrivate, "KEXET-0149", "undefined name: `{name}`. `{module}.{name}` is private to `{module}`")
KEX_DIAGNOSTIC(UndefinedNameNotVisible, "KEXET-0150", "undefined name: `{name}`. Not visible here: {owners}")
KEX_DIAGNOSTIC(UndefinedNameFileLocal, "KEXET-0151", "undefined name: `{name}`. {file} declares it outside its module, for itself")
KEX_DIAGNOSTIC(UndefinedConstructorOrType, "KEXET-0152", "undefined constructor or type: `{name}`")
KEX_DIAGNOSTIC(UndefinedConstructorOrTypeHint, "KEXET-0153", "undefined constructor or type: `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(UndefinedConstructorOrTypeNotImported, "KEXET-0154", "undefined constructor or type: `{name}`. `{module}.{name}` is not imported here")
KEX_DIAGNOSTIC(UndefinedConstructorOrTypePrivate, "KEXET-0155", "undefined constructor or type: `{name}`. `{module}.{name}` is private to `{module}`")
KEX_DIAGNOSTIC(UndefinedConstructorOrTypeNotVisible, "KEXET-0156", "undefined constructor or type: `{name}`. Not visible here: {owners}")
KEX_DIAGNOSTIC(UndefinedConstructorOrTypeFileLocal, "KEXET-0157", "undefined constructor or type: `{name}`. {file} declares it outside its module, for itself")
KEX_DIAGNOSTIC(UndefinedVariable, "KEXET-0158", "undefined variable: `{name}`")
KEX_DIAGNOSTIC(UndefinedVariableHint, "KEXET-0159", "undefined variable: `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(UndefinedVariableNotImported, "KEXET-0160", "undefined variable: `{name}`. `{module}.{name}` is not imported here")
KEX_DIAGNOSTIC(UndefinedVariablePrivate, "KEXET-0161", "undefined variable: `{name}`. `{module}.{name}` is private to `{module}`")
KEX_DIAGNOSTIC(UndefinedVariableNotVisible, "KEXET-0162", "undefined variable: `{name}`. Not visible here: {owners}")
KEX_DIAGNOSTIC(UndefinedFunction, "KEXET-0163", "undefined function: `{name}`")
KEX_DIAGNOSTIC(UndefinedFunctionHint, "KEXET-0164", "undefined function: `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(UndefinedFunctionNotImported, "KEXET-0165", "undefined function: `{name}`. `{module}.{name}` is not imported here")
KEX_DIAGNOSTIC(UndefinedFunctionPrivate, "KEXET-0166", "undefined function: `{name}`. `{module}.{name}` is private to `{module}`")
KEX_DIAGNOSTIC(UndefinedFunctionNotVisible, "KEXET-0167", "undefined function: `{name}`. Not visible here: {owners}")
KEX_DIAGNOSTIC(UndefinedFunctionFileLocal, "KEXET-0168", "undefined function: `{name}`. {file} declares it outside its module, for itself")
KEX_DIAGNOSTIC(UndefinedTag, "KEXET-0169", "undefined tag: `{name}`")
KEX_DIAGNOSTIC(UndefinedTagHint, "KEXET-0170", "undefined tag: `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(UndefinedTagNotImported, "KEXET-0171", "undefined tag: `{name}`. `{module}.{name}` is not imported here")
KEX_DIAGNOSTIC(UndefinedTagPrivate, "KEXET-0172", "undefined tag: `{name}`. `{module}.{name}` is private to `{module}`")
KEX_DIAGNOSTIC(UndefinedTagNotVisible, "KEXET-0173", "undefined tag: `{name}`. Not visible here: {owners}")
KEX_DIAGNOSTIC(ReturnedByNeedsName, "KEXET-0174", "`Type.returnedBy` needs the NAME of a function; a lambda or a function value carries no signature")
KEX_DIAGNOSTIC(ReturnedByOverloaded, "KEXET-0175", "`Type.returnedBy` cannot choose between the overloads of `{name}`{signatures}")
KEX_DIAGNOSTIC(ReturnedByNotConcrete, "KEXET-0176", "`Type.returnedBy` cannot answer for `{name}`: its return type is not concrete")
KEX_DIAGNOSTIC(SpawnPassesType, "KEXET-0177", "`Process.spawn({name})` passes the type, not a value; spawn a server with its initial state: `Process.spawn({value})`")
KEX_DIAGNOSTIC(AsNeedsTypeName, "KEXET-0178", "`.as` needs a type name as its target")
KEX_DIAGNOSTIC(AsAtomNeedsLiteral, "KEXET-0179", "`.as(Atom)` needs a string literal; for text known only at run time use `Atom.from(text)`, or `text.to(Atom)` to find an existing atom")
KEX_DIAGNOSTIC(AsCannotConvert, "KEXET-0180", "cannot convert {source} to {target} with `.as`")
KEX_DIAGNOSTIC(AsListNeedsTupleLiteral, "KEXET-0522", "`.as(List)` needs a tuple literal; for a tuple known only at run time use `.items`, or `.to(List)`")
KEX_DIAGNOSTIC(AsNarrowsToByte, "KEXET-0181", "unchecked narrowing to Byte is not allowed; use `.to(Byte)`")
KEX_DIAGNOSTIC(MakeContractUndefined, "KEXET-0182", "`{name}` is declared in this `make` block but nothing defines it. A method the runtime provides is declared with `:>`, which makes the receiver implicit")
KEX_DIAGNOSTIC(MakeSignatureUndefined, "KEXET-0187", "`{name}` is declared here but never defined: give it a body, `let {name}(...) = ...`")
KEX_DIAGNOSTIC(MakeContractRepeatsField, "KEXET-0183", "`{name}` is declared in this `make` block but nothing defines it. Inside a `make` block `{name} : …` declares a METHOD, not a record field; the field is already declared by `record {record}`, so drop this line")
KEX_DIAGNOSTIC(MakeContractFieldTyped, "KEXET-0184", "`{name}` is declared in this `make` block but nothing defines it. Inside a `make` block `{name} : …` declares a METHOD, not a record field; declare fields in `record {record}`")
KEX_DIAGNOSTIC(NewIsReserved, "KEXET-0185", "`new` is reserved for the next-state binding; use a name such as `build` for constructor functions")
KEX_DIAGNOSTIC(NonExhaustiveClauses, "KEXET-0186", "non-exhaustive clauses of `{name}`: missing case(s) {cases} of {type}")
KEX_DIAGNOSTIC(AnnotationArityMismatch, "KEXWT-0001", "type annotation for '{name}' declares {declared} parameter(s) but definition has {actual}")
// A `/`, `%`, `div`, `modulo` or `divmod` whose divisor the checker knows is
// 0: a literal, literal arithmetic, or a `let` bound to one (kexhq/kex#702).
// It fails at run time on both backends, whatever the dividend.
KEX_DIAGNOSTIC(DivisionByConstantZero, "KEXWT-0002", "division by zero: the divisor of `{operator}` is always 0, so this fails at run time")
