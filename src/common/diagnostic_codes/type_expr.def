// Type diagnostics from checking expressions (typechecker_expr.cxx).
// KEXET-0400 to KEXET-0799. See all.def.
KEX_DIAGNOSTIC(CollectionSpreadNotList, "KEXET-0400", "collection-block spread expects a list, got {type}")
KEX_DIAGNOSTIC(CollectionGuardNotBool, "KEXET-0401", "collection-block guard requires Bool, got {type}")
KEX_DIAGNOSTIC(FromInCast, "KEXET-0402", "`from` is not available in a cast: no caller is waiting for a reply")
KEX_DIAGNOSTIC(NewRequiresRecordReceiver, "KEXET-0403", "`new` requires a record receiver")
KEX_DIAGNOSTIC(NewRequiresRecordReceiverOrBinding, "KEXET-0404", "`new` requires a record receiver (or an explicit local binding)")
KEX_DIAGNOSTIC(ConstructorUsedAsValueOneValue, "KEXET-0405", "`{name}` is a constructor taking 1 value, not a value: call it (`{name}(…)`), or pass a block (`{block}`)")
KEX_DIAGNOSTIC(ConstructorUsedAsValue, "KEXET-0406", "`{name}` is a constructor taking {count} values, not a value: call it (`{name}(…)`), or pass a block (`{block}`)")
KEX_DIAGNOSTIC(NotACapability, "KEXET-0407", "'{capability}' is not a capability, so it cannot be replaced by 'with'. Declare it as `capability {capability} do ... end`")
KEX_DIAGNOSTIC(CapabilityReplacementMismatch, "KEXET-0408", "replacement for capability '{capability}' does not implement it: {type}")
KEX_DIAGNOSTIC(TryNotResultOrOptional, "KEXET-0409", "`.try` expects Result or Optional, got {type}")
KEX_DIAGNOSTIC(TryingRescueMismatch, "KEXET-0410", "`trying` body returns {body} but rescue returns {rescue}")
KEX_DIAGNOSTIC(AssignToImmutable, "KEXET-0411", "cannot assign to immutable binding: {name}")
KEX_DIAGNOSTIC(NestedFieldAssignment, "KEXET-0412", "nested record-field assignment is not supported yet")
KEX_DIAGNOSTIC(FieldAssignmentNeedsRecord, "KEXET-0413", "field assignment requires a record binding")
KEX_DIAGNOSTIC(RecordHasNoField, "KEXET-0414", "record `{record}` has no field `{field}`")
KEX_DIAGNOSTIC(OperatorNotDefined, "KEXET-0415", "`{operator}` is not defined for {left} and {right}")
KEX_DIAGNOSTIC(OperatorNotDefinedDeclareInMake, "KEXET-0416", "`{operator}` is not defined for {left} and {right}; declare it in a `make {left}` block")
KEX_DIAGNOSTIC(OperatorNotDefinedDeclareInTrait, "KEXET-0417", "`{operator}` is not defined for {left} and {right}; declare it in trait `{left}`")
KEX_DIAGNOSTIC(InequalityNotDerivable, "KEXET-0418", "`!=` is not defined here: `{type}`'s `==` answers {result}, not Bool, so there is no inequality to derive. Declare `!=` beside it")
KEX_DIAGNOSTIC(LogicalNotRequiresBool, "KEXET-0419", "logical not '!' requires Bool, got {type}")
KEX_DIAGNOSTIC(NegateRequiresNumber, "KEXET-0420", "unary '-' requires a number, got {type}")
KEX_DIAGNOSTIC(UnknownModule, "KEXET-0421", "unknown module `{module}`")
KEX_DIAGNOSTIC(ModuleHasNoModule, "KEXET-0422", "`{module}` has no module `{name}`")
KEX_DIAGNOSTIC(ModuleHasNoFunction, "KEXET-0423", "`{module}` has no function `{name}`")
KEX_DIAGNOSTIC(ModuleHasNoFunctionDidYouMean, "KEXET-0424", "`{module}` has no function `{name}`, did you mean `{hint}`?")
KEX_DIAGNOSTIC(BangOnImmutable, "KEXET-0425", "cannot use '!' on immutable binding: {name}")
KEX_DIAGNOSTIC(PrivateNameAccess, "KEXET-0426", "cannot access private name `{name}` from {module}")
KEX_DIAGNOSTIC(RetiredInteropRoot, "KEXET-0427", "`{root}.` interop is now `BEAM.`, followed by the module's real name: write `BEAM.lists.reverse(xs)`, `BEAM.erlang.node()`")
KEX_DIAGNOSTIC(RetiredElixirInterop, "KEXET-0428", "`{root}.` interop is now `BEAM.`, followed by the module's real name: write `BEAM.lists.reverse(xs)`, `BEAM.erlang.node()`, `BEAM.Elixir.Enum.map(xs, f)`")
KEX_DIAGNOSTIC(OrWrappedFallbackOptional, "KEXET-0429", "`or` needs a fallback of type {type}, but got {got}. `or` is what leaves the optional; pass a plain default, keep the value as it is, or `match` on it")
KEX_DIAGNOSTIC(OrWrappedFallbackResult, "KEXET-0430", "`or` needs a fallback of type {type}, but got {got}. `or` is what leaves the result; pass a plain default, keep the value as it is, or `match` on it")
KEX_DIAGNOSTIC(OrWrappedFallbackOptionalOpen, "KEXET-0431", "`or` needs the unwrapped value to fall back to, but got {got}. `or` is what leaves the optional; pass a plain default, keep the value as it is, or `match` on it")
KEX_DIAGNOSTIC(OrWrappedFallbackResultOpen, "KEXET-0432", "`or` needs the unwrapped value to fall back to, but got {got}. `or` is what leaves the result; pass a plain default, keep the value as it is, or `match` on it")
KEX_DIAGNOSTIC(OrBlockFallbackOptional, "KEXET-0433", "`or` needs a fallback of type {type}, but got a block. `or` never calls it, so the block itself would be the answer; pass a plain default, or `match` on the optional to compute one")
KEX_DIAGNOSTIC(OrBlockFallbackResult, "KEXET-0434", "`or` needs a fallback of type {type}, but got a block. `or` never calls it, so the block itself would be the answer; pass a plain default, or `match` on the result to compute one")
KEX_DIAGNOSTIC(OrFunctionFallbackOptional, "KEXET-0435", "`or` needs a fallback of type {type}, but got a function. `or` never calls it, so the function itself would be the answer; pass a plain default, or `match` on the optional to compute one")
KEX_DIAGNOSTIC(OrFunctionFallbackResult, "KEXET-0436", "`or` needs a fallback of type {type}, but got a function. `or` never calls it, so the function itself would be the answer; pass a plain default, or `match` on the result to compute one")
