// module diagnostics. See all.def.
KEX_DIAGNOSTIC(ModuleExportsItself, "KEXEM-0001", "module cannot export itself")
KEX_DIAGNOSTIC(ExportedModuleNotFound, "KEXEM-0002", "exported module not found: {module}")
KEX_DIAGNOSTIC(ModuleHasNoName, "KEXEM-0003", "module {module} has no name `{name}`")
KEX_DIAGNOSTIC(ExportPrivateName, "KEXEM-0004", "cannot export private name `{name}` from {module}")
KEX_DIAGNOSTIC(PrivateNameInExceptList, "KEXEM-0005", "cannot reference private name `{name}` in except list")
KEX_DIAGNOSTIC(ModuleHasNoPublicNames, "KEXEM-0006", "module {module} has no public names to export")
KEX_DIAGNOSTIC(ImportPrivateName, "KEXEM-0007", "cannot import private name `{name}` from {module}")
KEX_DIAGNOSTIC(ReferencePrivateName, "KEXEM-0008", "cannot reference private name `{name}` from {module}")
KEX_DIAGNOSTIC(ModuleNotFoundInSourceRoots, "KEXEM-0009", "module not found in source roots: {module}")
KEX_DIAGNOSTIC(ModuleNotFoundInSourceRootsWarning, "KEXWM-0001", "module not found in source roots: {module}")
KEX_DIAGNOSTIC(ModuleFileDeclaresAnother, "KEXEM-0010", "this file is `{module}` by its path, but declares `{declared}`; name it `module {module}`")
KEX_DIAGNOSTIC(ModuleInFileNamedForAnother, "KEXEM-0011", "module `{module}` is declared in a file whose path names `{pathModule}`, so `{module}` is not found; name it `module {pathModule}`, or move it to {path}")
KEX_DIAGNOSTIC(MainInDependency, "KEXEM-0012", "`{module}` is used by another file, so it cannot have a `main`: a program has one `main`, in the file it runs from")
KEX_DIAGNOSTIC(StatementInDependency, "KEXEM-0013", "`{module}` is used by another file, so it cannot run statements at its top level: they are a second `main`. Move them into a function")
KEX_DIAGNOSTIC(ModuleFileShadowsStandardLibrary, "KEXWM-0002", "this file is not loaded for `{module}`: that is the standard library's module, which a program's own file cannot replace; rename the file and its module")
