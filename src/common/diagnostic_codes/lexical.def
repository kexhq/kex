// lexical diagnostics. See all.def.
KEX_DIAGNOSTIC(ExpectedSlotAnnotationClose, "KEXEL-0001", "Expected '>' after '::'")
KEX_DIAGNOSTIC(UnexpectedCharacter, "KEXEL-0002", "Unexpected character: {char}")
KEX_DIAGNOSTIC(MissingHexadecimalDigits, "KEXEL-0003", "Expected hexadecimal digits after '0x'")
KEX_DIAGNOSTIC(MissingOctalDigits, "KEXEL-0004", "Expected octal digits after '0o'")
KEX_DIAGNOSTIC(MissingBinaryDigits, "KEXEL-0005", "Expected binary digits after '0b'")
KEX_DIAGNOSTIC(InvalidHexadecimalLiteral, "KEXEL-0006", "'{digits}' is not a valid hexadecimal literal")
KEX_DIAGNOSTIC(InvalidOctalLiteral, "KEXEL-0007", "'{digits}' is not a valid octal literal")
KEX_DIAGNOSTIC(InvalidBinaryLiteral, "KEXEL-0008", "'{digits}' is not a valid binary literal")
KEX_DIAGNOSTIC(UnterminatedEscape, "KEXEL-0009", "Unterminated escape")
KEX_DIAGNOSTIC(ExpectedHexEscapeDigits, "KEXEL-0010", "Expected two hex digits after '\\x'")
KEX_DIAGNOSTIC(NonAsciiHexEscape, "KEXEL-0011", "'\\x{digits}' is not ASCII; write the character as '{escape}'")
KEX_DIAGNOSTIC(ExpectedUnicodeEscapeBrace, "KEXEL-0012", "Expected {expected} after '\\u'")
KEX_DIAGNOSTIC(UnclosedUnicodeEscape, "KEXEL-0013", "Expected {expected} to close {escape}")
KEX_DIAGNOSTIC(UnicodeEscapeDigitCount, "KEXEL-0014", "Expected 1 to 6 hex digits in {escape}")
KEX_DIAGNOSTIC(InvalidUnicodeScalar, "KEXEL-0015", "'{escape}' is not a Unicode scalar value")
KEX_DIAGNOSTIC(UnknownEscape, "KEXEL-0016", "Unknown escape '\\{char}'; write '\\\\' for a backslash")
KEX_DIAGNOSTIC(UnterminatedString, "KEXEL-0017", "Unterminated string")
KEX_DIAGNOSTIC(UnterminatedBacktickLiteral, "KEXEL-0018", "Unterminated backtick literal")
KEX_DIAGNOSTIC(UnterminatedCharLiteral, "KEXEL-0019", "Unterminated char literal")
KEX_DIAGNOSTIC(EmptyCharLiteral, "KEXEL-0020", "Empty char literal")
KEX_DIAGNOSTIC(UnterminatedQuotedAtom, "KEXEL-0021", "Unterminated quoted atom")
KEX_DIAGNOSTIC(EmptyQuotedAtom, "KEXEL-0022", "Empty quoted atom")
