// lowering diagnostics. See all.def.
KEX_DIAGNOSTIC(AmbiguousRecordLayout, "KEXEB-0001", "ambiguous record layout for field `{field}` on `{record}`: indistinguishable {size}-element layouts place it at positions {first} and {second}")
KEX_DIAGNOSTIC(UnsupportedRecordFieldSubPattern, "KEXEB-0002", "IR lower: unsupported record-field sub-pattern")
KEX_DIAGNOSTIC(UnsupportedLiteralPattern, "KEXEB-0003", "IR lower: unsupported literal pattern")
KEX_DIAGNOSTIC(StringCharPatternNotChar, "KEXEB-0004", "IR lower: a String's character can only be bound or matched against a Char literal")
KEX_DIAGNOSTIC(StringRestPatternNotString, "KEXEB-0005", "IR lower: the rest of a String can only be bound or matched against a String literal")
KEX_DIAGNOSTIC(AnonymousRecordPattern, "KEXEB-0006", "IR lower: anonymous record pattern `{pattern}` is not supported in match/if-let; name the record (`{example}`) so its field layout is known")
KEX_DIAGNOSTIC(UnknownRecordInPattern, "KEXEB-0007", "IR lower: unknown record `{name}` in pattern")
KEX_DIAGNOSTIC(UnsupportedPatternKind, "KEXEB-0008", "IR lower: unsupported pattern kind")
KEX_DIAGNOSTIC(NamedArgumentsUndecided, "KEXEB-0009", "IR lower: named arguments to `{function}` reached lowering undecided")
KEX_DIAGNOSTIC(NamedArgsUnknownModuleParams, "KEXEB-0010", "IR lower: named args to module function with unknown params: {function}")
KEX_DIAGNOSTIC(NamedArgumentsUnplaced, "KEXEB-0011", "IR lower: named arguments to `{function}` reached lowering unplaced")
KEX_DIAGNOSTIC(NamedArgsUnknownImportedParams, "KEXEB-0012", "IR lower: named args to imported function with unknown params: {function}")
KEX_DIAGNOSTIC(UnknownNamedArg, "KEXEB-0013", "IR lower: unknown named arg {label} for {function}")
KEX_DIAGNOSTIC(MissingDictionarySource, "KEXEB-0014", "IR lower: missing source argument for {trait} dictionary")
KEX_DIAGNOSTIC(RecordConstructionUntyped, "KEXEB-0015", "IR lower: record construction `{name}` the checker did not type as a known record")
KEX_DIAGNOSTIC(StaticConstructorNotPorted, "KEXEB-0016", "IR lower: static constructor '{name}' not yet ported")
KEX_DIAGNOSTIC(UnnamedDictionaryParameter, "KEXEB-0017", "IR lower: trait-typed dictionary parameter must be named")
KEX_DIAGNOSTIC(UnsupportedUnaryOperator, "KEXEB-0018", "IR lower: unsupported unary operator")
KEX_DIAGNOSTIC(AssignmentInsideExpression, "KEXEB-0019", "IR lower: an assignment inside a block, branch or `&&`/`||` operand is not supported here; assign in a statement of its own")
KEX_DIAGNOSTIC(UnimplementedExprNode, "KEXEB-0020", "IR lower: unimplemented expr node {node}")
KEX_DIAGNOSTIC(UnknownCapturedModuleFunction, "KEXEB-0021", "IR lower: unknown module function in `~{function}`")
KEX_DIAGNOSTIC(CloneOfNullExpr, "KEXEB-0022", "IR lower: clone of null expr [{site}]")
KEX_DIAGNOSTIC(CloneOfNonAtomicExpr, "KEXEB-0023", "IR lower: clone of non-atomic expr (index {index}) [{site}]")
KEX_DIAGNOSTIC(UnsupportedBinaryOperator, "KEXEB-0024", "IR lower: unsupported binary operator")
KEX_DIAGNOSTIC(TypePatternInReceive, "KEXEB-0025", "IR lower: a type pattern (`x : T`) is not supported in a receive clause")
KEX_DIAGNOSTIC(ExpressionCannotAssign, "KEXEB-0026", "IR lower: `{keyword}` used as an expression cannot assign to `{name}`. Put it in statement position instead")
KEX_DIAGNOSTIC(MatchBinderInLoop, "KEXEB-0027", "IR lower: match |binder| in loop not yet ported")
KEX_DIAGNOSTIC(NestedRecordFieldAssignment, "KEXEB-0028", "IR lower: nested record-field assignment is not supported")
KEX_DIAGNOSTIC(NamedArgsUnknownExternalParams, "KEXEB-0029", "IR lower: named args to external function with unknown params: {function}")
KEX_DIAGNOSTIC(NamedArgsUnknownFunction, "KEXEB-0030", "IR lower: named args to unknown function {function}")
KEX_DIAGNOSTIC(UnknownTraitDictionary, "KEXEB-0031", "IR lower: unknown trait dictionary {trait}")
KEX_DIAGNOSTIC(NoTraitImplementation, "KEXEB-0032", "IR lower: no implementation for {trait}.{method} on {type}")
KEX_DIAGNOSTIC(FreeFunctionAndReceiverMethod, "KEXEB-0033", "IR lower: `{name}/{arity}` names both a free function and a receiver method in this compilation unit. Rename one of them")
KEX_DIAGNOSTIC(FileNotChecked, "KEXEB-0034", "IR lower: {file} was not checked")
KEX_DIAGNOSTIC(UnimplementedTopLevelItem, "KEXEB-0035", "IR lower: unimplemented top-level item {item}")
KEX_DIAGNOSTIC(NonMonotonicTierBounds, "KEXEB-0036", "IR lower: non-monotonic prelude tier bounds")
KEX_DIAGNOSTIC(TierBoundsIncomplete, "KEXEB-0037", "IR lower: tier bounds do not cover the full prelude AST")
KEX_DIAGNOSTIC(UndecidedCallInCheckedProgram, "KEXEB-0038", "IR lower: the checker left `{name}/{arity}` undecided in a checked program")
KEX_DIAGNOSTIC(NestedTooDeepToCompile, "KEXEB-0039", "this is nested too deeply to compile: give an inner part a name with `let`, and use the name")
KEX_DIAGNOSTIC(InvalidLoweredModule, "KEXEB-0040", "IR verify: {problem}. This is a bug in the Kex compiler, not in your program")
