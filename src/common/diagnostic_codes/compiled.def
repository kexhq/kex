KEX_DIAGNOSTIC(ValidatorReturnedNothing, "KEXEC-0049", "compile-time validator `{validator}` must return [TaggedValidation.Issue], got nothing")
KEX_DIAGNOSTIC(ValidatorMalformedIssue, "KEXEC-0050", "compile-time validator `{validator}` returned a malformed Issue")
KEX_DIAGNOSTIC(ValidatorInvalidSpan, "KEXEC-0051", "compile-time validator `{validator}` returned an invalid Issue byte span")
