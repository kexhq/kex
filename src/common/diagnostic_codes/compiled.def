// compiled diagnostics. See all.def.
KEX_DIAGNOSTIC(MakeBodyGeneratesNonMethod, "KEXEC-0001", "a `make` body holds functions, so only `let %name(...)` can be generated inside one. An ordinary `make` follows the same rule")
KEX_DIAGNOSTIC(GeneratedMethodEmptyName, "KEXEC-0002", "generated function has an empty name")
KEX_DIAGNOSTIC(EmbedArity, "KEXEC-0003", "Kex.embed takes exactly one argument: the path of the file to embed")
KEX_DIAGNOSTIC(EmbedArgumentNotLiteral, "KEXEC-0004", "Kex.embed's argument must be a plain string literal naming the file to embed. The path has to be known to the compiler, not only to the running program")
KEX_DIAGNOSTIC(EmbedArgumentInterpolated, "KEXEC-0005", "Kex.embed's argument must be a plain string literal naming the file to embed, not an interpolated one. The path has to be known to the compiler, not only to the running program. A hole may name a `compiled do` loop variable, or a String parameter of the enclosing function, which then gets one clause per matching file")
KEX_DIAGNOSTIC(EmbedCannotRead, "KEXEC-0006", "Kex.embed: cannot read '{path}'")
KEX_DIAGNOSTIC(EmbedPatternMatchesNoFile, "KEXEC-0007", "Kex.embed(\"{pattern}\") matches no file, so `{function}` would have no clause for it")
KEX_DIAGNOSTIC(TemplateElifConditionNotExpression, "KEXEC-0008", "in a template elif condition: expected an expression")
KEX_DIAGNOSTIC(TemplateLetVarRegionNotExpression, "KEXEC-0009", "in a template let/var region: expected an expression")
KEX_DIAGNOSTIC(TemplateIfConditionNotExpression, "KEXEC-0010", "in a template if condition: expected an expression")
KEX_DIAGNOSTIC(TemplateBlockCallNotExpression, "KEXEC-0011", "in a template block call: expected an expression")
KEX_DIAGNOSTIC(TemplateControlRegionNotExpression, "KEXEC-0012", "in a template control region: expected an expression")
KEX_DIAGNOSTIC(TemplateHoleNotExpression, "KEXEC-0013", "in a template hole `{text}`: expected an expression")
KEX_DIAGNOSTIC(TemplateIfNoEnd, "KEXEC-0014", "template `if` has no matching `end`")
KEX_DIAGNOSTIC(TemplateBlockNoEnd, "KEXEC-0015", "template block has no matching `end`")
KEX_DIAGNOSTIC(TemplateBlockNotCall, "KEXEC-0016", "template block `{text}` is not a call that can take a block")
KEX_DIAGNOSTIC(TemplateParamNotType, "KEXEC-0017", "in a template's `params:` frontmatter, `{text}` is not a type: expected a type")
KEX_DIAGNOSTIC(TemplateUnbalanced, "KEXEC-0018", "template's control regions do not balance: an `end`, `else` or `elif` has no opener")
KEX_DIAGNOSTIC(TemplateArity, "KEXEC-0019", "template.{method} takes exactly one argument: the template's source text")
KEX_DIAGNOSTIC(TemplateSourceNotKnown, "KEXEC-0020", "template.{method}'s argument must be a compile-time-known string (a plain literal, or Kex.embed(...)). The template's text has to be known to the compiler, not only to the running program")
KEX_DIAGNOSTIC(ConstantNotInlinable, "KEXEC-0021", "compile-time constant `{name}` cannot be inlined")
KEX_DIAGNOSTIC(ConstantNotInlinableNoValue, "KEXEC-0022", "compile-time constant `{name}` cannot be inlined: no value")
KEX_DIAGNOSTIC(ConstantNotInlinablePlaceholder, "KEXEC-0023", "compile-time constant `{name}` cannot be inlined: `{placeholder}` is not known at compile time and has no expression to fall back on")
KEX_DIAGNOSTIC(ConstantNotInlinableNoLiteral, "KEXEC-0024", "compile-time constant `{name}` cannot be inlined: a {type} has no literal form")
KEX_DIAGNOSTIC(CompileTimeEvaluationTimedOut, "KEXEC-0025", "compile-time evaluation timed out after {ms} ms")
KEX_DIAGNOSTIC(CompileTimeEvaluationFailed, "KEXEC-0026", "compile-time evaluation failed: {error}")
KEX_DIAGNOSTIC(GeneratedDeclarationEmptyName, "KEXEC-0027", "generated declaration has an empty name")
KEX_DIAGNOSTIC(GeneratedTypeNameNotUpper, "KEXEC-0028", "generated type name `{name}` must start with an upper-case letter")
KEX_DIAGNOSTIC(GeneratedTypeNameNotUpperTry, "KEXEC-0029", "generated type name `{name}` must start with an upper-case letter. Try `{fix}`")
KEX_DIAGNOSTIC(GeneratedRecordNameNotUpper, "KEXEC-0030", "generated record name `{name}` must start with an upper-case letter")
KEX_DIAGNOSTIC(GeneratedRecordNameNotUpperTry, "KEXEC-0031", "generated record name `{name}` must start with an upper-case letter. Try `{fix}`")
KEX_DIAGNOSTIC(GeneratedMakeTargetNotUpper, "KEXEC-0032", "generated make target name `{name}` must start with an upper-case letter")
KEX_DIAGNOSTIC(GeneratedMakeTargetNotUpperTry, "KEXEC-0033", "generated make target name `{name}` must start with an upper-case letter. Try `{fix}`")
KEX_DIAGNOSTIC(GeneratedFunctionNameNotLower, "KEXEC-0034", "generated function name `{name}` must start with a lower-case letter")
KEX_DIAGNOSTIC(TemplateScanTimedOut, "KEXEC-0035", "template scan timed out after {ms} ms")
KEX_DIAGNOSTIC(TemplateScanNotEvaluated, "KEXEC-0036", "template.scan could not be evaluated at compile time")
KEX_DIAGNOSTIC(TemplateScanEvaluationError, "KEXEC-0037", "{error}")
