KEX_DIAGNOSTIC(ValidatorNonStringMessage, "KEXEC-0053", "compile-time validator `{validator}` returned an Issue with a non-String message")
KEX_DIAGNOSTIC(TagValidatorError, "KEXEC-0054", "{message}")
KEX_DIAGNOSTIC(CompanionValidatorSignature, "KEXEC-0055", "companion validator `{validator}` must be pure with signature String -> [TaggedValidation.Issue]")
KEX_DIAGNOSTIC(ValidatorTimedOut, "KEXEC-0056", "compile-time validator `{validator}` timed out after {ms} ms")
KEX_DIAGNOSTIC(ValidatorCrashed, "KEXEC-0057", "compile-time validator `{validator}` crashed: {error}")
