# Writes OUT, a C++ source defining kex::skill::topics(), from the Markdown
# files in SOURCES (a `|`-separated list: the guide first). Run at build time
# by the custom command in CMakeLists.txt, so editing a topic rebuilds it.
#
#   cmake -DOUT=<file.cxx> -DHEADER=<skill.hxx> -DSOURCES=<a.md|b.md> -P embed.cmake

set(delimiter "KEXSKILL")
string(REPLACE "|" ";" sources "${SOURCES}")

set(entries "")
foreach(source IN LISTS sources)
    cmake_path(GET source STEM name)
    file(READ "${source}" text)
    string(FIND "${text}" ")${delimiter}\"" clash)
    if(NOT clash EQUAL -1)
        message(FATAL_ERROR
            "${source} contains the raw-string terminator )${delimiter}\"")
    endif()
    string(APPEND entries
        "        {\"${name}\", R\"${delimiter}(${text})${delimiter}\"},\n")
endforeach()

file(WRITE "${OUT}"
"// Generated by src/skill/embed.cmake from plugins/kex/skills/kex/*.md.
// Do not edit.
#include \"${HEADER}\"

namespace kex::skill {

auto topics() -> const std::vector<Topic>& {
    static const std::vector<Topic> all = {
${entries}    };
    return all;
}

} // namespace kex::skill
")
