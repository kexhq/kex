type Backend = Interpreter | Beam

type Feature = Http | FS | Process | WebServer

foul module Kex do
  backend : Backend
  let backend = Kex.Intrinsic.Kex.backend()

  foul module Feature do
    has? : Feature -> Bool
    let has?(f) = Kex.Intrinsic.Kex.featureHas?(f)

    list : [Feature]
    let list = Kex.Intrinsic.Kex.featureList()
  end
end

# Returns the pretty-printed representation of any value — the same form the
# REPL echoes. Universal: reachable on every type through UFCS.
#
# @param value [A]
# @return [String]
#
# @example
#   [1, 2].inspect          # => "[1, 2]"
#   { a: 1 }.inspect        # => "{ a: 1 }"
#   Just("hi").inspect      # => "Just(\"hi\")"
let inspect(value) = Kex.Intrinsic.Kex.inspect(value)
