# Time units are small and universal enough to live in the prelude. Physical
# and information units are opt-in modules under Units.SI and Units.Data.

type TimeUnit = Nanosecond | Microsecond | Millisecond
              | Second | Minute | Hour | Day | Week

record Duration do
  # Canonical storage used by arithmetic.
  seconds : Float

  # Value and symbol used for display.
  value : Float
  symbol : String
end

make Integer do
  let nanosecond -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) / 1000000000.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "ns"
  }

  let microsecond -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) / 1000000.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "μs"
  }

  let millisecond -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) / 1000.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "ms"
  }

  let sec -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "s"
  }

  let minute -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 60.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "min"
  }

  let hour -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 3600.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "h"
  }

  let day -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 86400.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "d"
  }

  let week -> Duration = Duration {
    seconds: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 604800.0,
    value: Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0),
    symbol: "wk"
  }
end

make Float do
  let nanosecond -> Duration = Duration {
    seconds: this / 1000000000.0, value: this, symbol: "ns"
  }
  let microsecond -> Duration = Duration {
    seconds: this / 1000000.0, value: this, symbol: "μs"
  }
  let millisecond -> Duration = Duration {
    seconds: this / 1000.0, value: this, symbol: "ms"
  }
  let sec -> Duration = Duration {
    seconds: this, value: this, symbol: "s"
  }
  let minute -> Duration = Duration {
    seconds: this * 60.0, value: this, symbol: "min"
  }
  let hour -> Duration = Duration {
    seconds: this * 3600.0, value: this, symbol: "h"
  }
  let day -> Duration = Duration {
    seconds: this * 86400.0, value: this, symbol: "d"
  }
  let week -> Duration = Duration {
    seconds: this * 604800.0, value: this, symbol: "wk"
  }
end

make Duration do
  let to(String) -> String = "${this.value} ${this.symbol}"

  let scale(factor: Number) -> Duration do
    let converted = Kex.Intrinsic.Fun.convertTo(factor, Float).or(0.0)
    return Duration {
      seconds: this.seconds * converted,
      value: this.value * converted,
      symbol: this.symbol
    }
  end

  let convert(unit: TimeUnit) -> Duration do
    let (factor, symbol) = durationUnitInfo(unit)
    return Duration {
      seconds: this.seconds,
      value: this.seconds / factor,
      symbol: symbol
    }
  end

  let +(other: Duration) -> Duration do
    return Duration {
      seconds: this.seconds + other.seconds,
      value: this.seconds + other.seconds,
      symbol: "s"
    }
  end

  let -(other: Duration) -> Duration do
    return Duration {
      seconds: this.seconds - other.seconds,
      value: this.seconds - other.seconds,
      symbol: "s"
    }
  end

end

let durationUnitInfo(Nanosecond) = (0.000000001, "ns")
let durationUnitInfo(Microsecond) = (0.000001, "μs")
let durationUnitInfo(Millisecond) = (0.001, "ms")
let durationUnitInfo(Second) = (1.0, "s")
let durationUnitInfo(Minute) = (60.0, "min")
let durationUnitInfo(Hour) = (3600.0, "h")
let durationUnitInfo(Day) = (86400.0, "d")
let durationUnitInfo(Week) = (604800.0, "wk")
