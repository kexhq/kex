# Types that can be written out structurally, for debugging.
#
# The output shows how the value is built: strings in quotes, +Just(...)+
# around an optional. Use +Showable+ for text meant for users.
#
# Every type is inspectable, so +inspected+ and +IO.inspect+ work on any
# value. A type that wants a different rendering overrides +inspectValue+.
#
#   [1, 2].inspected       # => "[1, 2]"
#   Just("hi").inspected   # => "Just(\"hi\")"
trait Inspectable do
  # Writes the value structurally, with ANSI colors when +colors+ is true.
  #
  # +inspected+ and +IO.inspect+ call it with the console's color setting.
  # Call it directly only to force colors on or off.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered value
  #
  # @example
  #   [1, 2].inspectValue(false)   # => "[1, 2]"
  inspectValue :> Bool -> String
end

# Types with a short text form for users.
#
# Interpolation, printing and +to(String)+ use +Showable+. A string shows
# without quotes, +Just(x)+ shows as +x+, and +None+ shows as an empty
# string. Use +Inspectable+ to see a value's structure.
#
#   "hello".showValue          # => "hello"
#   Just("hello").showValue    # => "hello"
#   None.showValue             # => ""
trait Showable do
  # Returns the value's text for users.
  #
  # Implement it for a type whose useful text differs from its structure.
  # Leave out ANSI styling: the text also goes to files and logs.
  #
  # @return [String] the display text
  showValue :> String
end

# Every type is inspectable through this structural rendering.
make Inspectable do
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)
end

# The default text for the built-in Showable types. A type can replace it, as
# +Date+, +Time+ and +DateTime+ do.
make Showable do
  let showValue -> String = Kex.Intrinsic.Kex.show(this)
  let to(String) -> String? = Just(this.showValue)
end

make Optional<Showable>, implement: Showable do
  let showValue(@Just(x)) -> String = x.showValue
  let showValue(@None) -> String = ""
end

# Showing a +Result+ shows what it carries, so +Ok(42)+ shows as +42+, but an
# +Error+ keeps its marker: +Error(bad)+. Without it a failure and a success
# would print alike.
#
# The marker matches how an error appears inside a collection,
# +[1, Error(Bad(no))]+, since elements are written structurally. Inspecting
# a result, or matching on it, is unaffected.
make Result<X, E>, implement: Showable do
  let showValue(@Ok(x)) -> String = x.showValue
  let showValue(@Error(e)) -> String = "Error(${e.showValue})"
end

# The running toolchain: its backend, version and optional features.
#
#   Kex.BACKEND                  # => Interpreter
#   Kex.BACKEND.compiled?        # => false
#   Kex.VERSION.release          # => "0.4.0"
#   Kex.Feature.has?(Kex.FileSystem)   # => true
module Kex do
  # The backend running the program: the tree-walking +Interpreter+ or the
  # +Beam+ virtual machine.
  type Backend = Interpreter | Beam

  make Backend do
    # Returns +true+ for the tree-walking interpreter.
    #
    # @return [Bool] +true+ for +Interpreter+
    #
    # @example
    #   Kex.BACKEND.interpreted?   # => true under `kex -R file.kex`
    interpreted? :> Bool
    let interpreted? = this == Interpreter

    # Returns +true+ for a backend that runs compiled code, which today is
    # only the BEAM.
    #
    # @return [Bool] +true+ for every backend but the interpreter
    #
    # @example
    #   Kex.BACKEND.compiled?   # => true under `kex file.kex`
    compiled? :> Bool
    let compiled? = this != Interpreter

    # Returns +true+ for the BEAM virtual machine, which the web server and
    # clustering need.
    #
    # @return [Bool] +true+ for +Beam+
    #
    # @example
    #   Kex.BACKEND.beam?   # => true under `kex file.kex`
    beam? :> Bool
    let beam? = this == Beam
  end

  # A capability that some builds leave out. Check it with
  # +Kex.Feature.has?+ before relying on it.
  #
  # +FileSystem+ means the program can read and write the host's files
  # (+FS+). +ExternalPrograms+ means it can run other programs
  # (+Process.run+, +Process.stream+); the browser build cannot.
  #
  # Kex's own processes (+spawn+, +receive+) exist on every backend.
  # Networking support is reported separately by +Net.Support.current+.
  type Feature = FileSystem | ExternalPrograms

  # The backend running this program. Ask it with +interpreted?+,
  # +compiled?+ or +beam?+.
  #
  # @return [Backend] the running backend
  #
  # @example
  #   Kex.BACKEND   # => Interpreter
  BACKEND : Backend
  let BACKEND = Kex.Intrinsic.Kex.backend()

  # The version of the Kex toolchain running a program, as +Kex.VERSION+
  # holds it. +kex --version+ and the REPL banner report the same numbers.
  #
  # @example
  #   Kex.VERSION.major      # => 0
  #   Kex.VERSION.revision   # => Just("a1b2c3d")
  #   Kex.VERSION.number     # => "0.4.0 (a1b2c3d)"
  record Version do
    # The major version number.
    major : Integer

    # The minor version number.
    minor : Integer

    # The patch version number.
    patch : Integer

    # The git commit the compiler was built from, or +None+ for a build from
    # a source archive.
    revision : String?

    # The pre-release tag, such as +"rc.1"+ or +"beta.2"+, or +""+ for a
    # stable release.
    preRelease : String = ""
  end

  make Version do
    # Returns the major, minor and patch numbers and the revision as a
    # tuple, for destructuring.
    #
    # @return [(Integer, Integer, Integer, String?)] major, minor, patch, revision
    #
    # @example
    #   let (major, minor, patch, revision) = Kex.VERSION.tuple
    #   major   # => 0
    tuple : (Integer, Integer, Integer, String?)
    let tuple = (this.major, this.minor, this.patch, this.revision)

    # Returns the version as +0.4.0+, or +0.4.0-rc.1+ for a pre-release.
    # Version ranges are matched against this string.
    #
    # @return [String] the release string
    #
    # @example
    #   Kex.VERSION.release   # => "0.4.0-alpha.2"
    release : String
    let release = @preRelease.empty? then "${this.major}.${this.minor}.${this.patch}" else "${this.major}.${this.minor}.${this.patch}-${@preRelease}"

    # Returns +release+ followed by the build revision, if there is one. This
    # is what +kex --version+ and the REPL banner print.
    #
    # @return [String] the full version string
    #
    # @example
    #   Kex.VERSION.number   # => "0.4.0-alpha.2 (219e625)"
    #
    # @example Reporting the toolchain in a tool's output
    #   IO.printLine("built with Kex ${Kex.VERSION.number}")
    number : String
    let number = match this.revision do
      Just(hash) => "${this.release} (${hash})"
      None => this.release
    end
  end

  # This build's version.
  #
  # @return [Version] the running toolchain's version
  #
  # @example
  #   Kex.VERSION.major     # => 0
  #   Kex.VERSION.release   # => "0.4.0-alpha.2"
  #
  # @example Reporting the version in a tool's output
  #   IO.printLine("built with Kex ${Kex.VERSION.number}")
  VERSION : Version
  let VERSION = match Kex.Intrinsic.Kex.version() do
    (major, minor, patch, revision) =>
      Version { major: major, minor: minor, patch: patch, revision: revision,
                preRelease: Kex.Intrinsic.Kex.versionPreRelease() }
  end

  # A compiled module loaded into the running program by +Kex.load+.
  #
  # It is for programs that pick their code at run time, such as a site
  # generator rendering a theme's templates or a plugin host. Compile the
  # source once with +kex --compile -o <dir>+, then load the +.beam+ and call
  # into it as often as needed.
  #
  # Top-level declarations of +<stem>.kex+ compile into the module
  # +kex_<stem>+, in +kex_<stem>.beam+. Give each generated file a distinct
  # name, or put its declarations inside a +module+, whose functions compile
  # into +Kex.<Name>+.
  #
  # Only the BEAM backend can load modules; under the interpreter +Kex.load+
  # returns an +Error+.
  #
  #   let theme = Kex.load("cache/kex_theme_3f2a.beam").try
  #   let html = theme.call(:render, [context]).try
  record LoadedModule do
    # The module's BEAM name, e.g. +:kex_theme+ or +:"Kex.Theme"+.
    name : Atom
  end

  # Loads the compiled module at +path+, replacing any older version of it
  # already loaded. See +Kex.LoadedModule+.
  #
  # @param path [String] a `.beam` file written by `kex --compile`
  # @return [Result<LoadedModule, String>] the module, or why it could not be
  #   loaded
  #
  # @example
  #   let theme = Kex.load("build/kex_theme.beam").try
  load : String -> Result<LoadedModule, String>
  foul load(path) = Kex.Intrinsic.Code.load(path).map { |name| LoadedModule { name: name } }

  # Returns the module already loaded under +name+, or +None+.
  #
  # @param name [Atom] the module's BEAM name
  # @return [LoadedModule?] the module
  #
  # @example Loading only once
  #   let theme = Kex.loaded(:kex_theme).or(Kex.load(path).try)
  loaded : Atom -> LoadedModule?
  foul loaded(name) = Kex.Intrinsic.Code.loaded?(name) then Just(LoadedModule { name: name }) else None

  make LoadedModule do
    # Calls the module's function +function+ with +arguments+.
    #
    # A failure inside the call returns an +Error+ describing it, as does a
    # function the module does not export with that many arguments. A +foul+
    # function takes a hidden extra argument for its capabilities, so only
    # pure functions can be called this way.
    #
    # @param function [Atom] the function's name
    # @param arguments [[Any]] its arguments, in order
    # @return [Result<Any, String>] what the function returned, or why the
    #   call failed
    #
    # @example
    #   theme.call(:render, [context])   # => Ok("<html>...")
    call :> Atom -> [Any] -> Result<Any, String>
    foul call(function, arguments) = Kex.Intrinsic.Code.call(@name, function, arguments)
  end

  # Returns a non-cryptographic hash of any value, an +Integer+ from 0 to
  # 2^32 - 1 that is the same for equal values.
  #
  # It is cheap to compute over a large structure, which suits noticing when
  # data has changed. The number is stable only within one running program:
  # it differs between the interpreter and the BEAM and may change between
  # Kex versions, so do not store or send it. Use +Digest+ for that, or
  # where someone could choose inputs to collide.
  #
  # @param value [Any] the value to hash
  # @return [Integer] the hash, from 0 up to 2^32 - 1
  #
  # @example Noticing that a project's files changed
  #   let stamp = Kex.hash(paths.map { |path| (path, FS.File.info(path).try) })
  hash : Any -> Integer
  let hash(value) = Kex.Intrinsic.Kex.hash(value)

  # Which optional capabilities this build includes. Networking is reported
  # separately by +Net.Support+.
  module Feature do
    # Returns +true+ when this build includes +f+.
    #
    # @param f [Feature] the capability to ask about
    # @return [Bool] +true+ when it is available
    #
    # @example
    #   Kex.Feature.has?(Kex.ExternalPrograms)   # => true, except in a browser
    has? : Feature -> Bool
    let has?(f) = Kex.Intrinsic.Kex.featureHas?(f)

    # Returns every optional capability this build includes.
    #
    # @return [[Feature]] the available capabilities
    #
    # @example
    #   Kex.Feature.list   # => [FileSystem, ExternalPrograms]
    list : [Feature]
    let list = Kex.Intrinsic.Kex.featureList()
  end
end

# Reading the typed public surface of a compiled Kex module.
module Kex.Interface do
  # Reads the typed public interface stored in a compiled Kex module. Returns
  # +None+ when the file does not exist, is not a +.beam+ file, or has no
  # interface chunk.
  #
  # The term is a tree of tuples, lists, atoms, integers and strings, read
  # with pattern matching and +Tuple.items+.
  #
  # @param path [FS.FilePath] the compiled .beam file to read
  # @return [Any?] the decoded interface term, or +None+
  #
  # @example
  #   Kex.Interface.read("build/runtime/beam/kex_prelude.beam")
  read : FS.FilePath -> Any?
  let read(path) = Kex.Intrinsic.Interface.read(path)
end

# Returns the structural text of any value, the form the REPL echoes.
#
# To print a value in the middle of a pipeline, use +inspect+ instead.
#
# @param value [A] any value
# @return [String] its rendered form
#
# @example
#   [1, 2].inspected            # => "[1, 2]"
#   { a: 1 }.inspected          # => "{ a: 1 }"
#   { "a": 1 }.inspected        # => "{ \"a\": 1 }"
#   Just("hi").inspected        # => "Just(\"hi\")"
#
# @example Putting a rendering into a message
#   IO.printError("unexpected value: ${value.inspected}")
let inspected(value: Inspectable) = value.inspectValue(Console.enabled?)

# Prints +value+ and its type to stderr and returns +value+ unchanged, so it
# can go anywhere in a pipeline. The same as +IO.inspect+.
#
# @param value [A] the value to show
# @return [A] the same value, unchanged
#
# @example
#   [1, 2, 3, 4].map { |n| n * 3 }.inspect.filter(~even?)
#   # stderr: [3, 6, 9, 12] : [Integer]
#   # => [6, 12]
inspect : A -> A
let inspect(value) = IO.inspect(value)

# Returns +true+ when +value+ is an atom, such as +:ok+. Universal:
# reachable on every type through UFCS, so it answers where the static type
# is +Any+. A +Bool+, +None+ and a constructor such as +Red+ are values of
# their own types, not atoms.
#
# On the BEAM a constructor is spelled as an atom of its name, so an atom
# written like one of the program's constructors or type names (+:Red+ next
# to +type Color = Red | Green+) answers as that constructor or type would,
# just as +Type.of+ does. Lower-case atoms never collide.
#
# @param value [A] any value
# @return [Bool] whether the value is an atom
#
# @example
#   :ok.atom?      # => true
#   "ok".atom?     # => false
#   true.atom?     # => false
atom? : A -> Bool
let atom?(value) = Kex.Intrinsic.Type.ofValue(value).name == "Atom"
