# Traversal operations that every foldable collection gets for free.
#
# A type becomes +Foldable+ by implementing one method, +reduce+; the rest —
# +each+, +all?+, +any?+, +find+, +count+ — are derived from it. +List+,
# +String+, +Map+, +Range+ and both flavours of +Set+ all implement it, so
# these methods read the same whatever you point them at.
#
#   [1, 2, 3].all? { |n| n > 0 }        # => true
#   "hello".any?(~digit?)               # => false
#   { a: 1, b: 2 }.count { |k, v| v > 1 }   # => 1
#
# Blocks are applied via Kex.Intrinsic.Fun.applyItem, which auto-splats a pair
# item into a two-argument block. That is what lets a +Map+ traversal be
# written +{ |key, value| ... }+ even though the fold hands over one tuple.
trait Foldable do
  # Folds the collection from the left. The one operation a +Foldable+ type
  # must define; everything else here is written in terms of it.
  #
  # @param acc [A] the initial accumulator
  # @param f [A -> T -> A] combines the accumulator with each item
  # @return [A] the final accumulator
  #
  # @example
  #   [1, 2, 3].reduce(0) { |sum, n| sum + n }   # => 6
  reduce :> A -> (A -> T -> A) -> A

  # Calls +f+ with each item, for its side effects.
  #
  # The loop of last resort: when what you want is a new collection rather
  # than an effect, +map+ or +filter+ says so more clearly.
  #
  # @param f [T -> Void] called once per item
  # @return [Void]
  #
  # @example
  #   ["ada", "grace"].each { |name| IO.printLine(name) }
  #
  # @example Over a map, the block takes key and value
  #   { host: "localhost", port: 8080 }.each do |key, value|
  #     IO.printLine("${key} = ${value}")
  #   end
  let each(f) do
    this.reduce(0) do |_, item|
      Kex.Intrinsic.Fun.applyItem(f, item)
      0
    end
    return ()
  end

  # Calls +f+ with each item and its 0-based position, for its side effects.
  #
  # The index is the LAST block parameter, so a +Map+ entry can be taken
  # either whole (+|entry, i|+) or spread (+|k, v, i|+).
  #
  # @param f [T -> Integer -> Void] called with each item and its index
  # @return [Void]
  #
  # @example
  #   ["a", "b"].eachIndexed { |s, i| IO.printLine("${i}: ${s}") }
  #   # prints: 0: a
  #   #         1: b
  #
  # @example Numbering the lines of a file
  #   text.lines.eachIndexed { |line, i| IO.printLine("${i + 1}\t${line}") }
  let eachIndexed(f) do
    this.reduce(0) do |i, item|
      Kex.Intrinsic.Fun.applyIndexed(f, item, i)
      i + 1
    end
    return ()
  end

  # Returns +true+ when every item satisfies +pred+. An empty collection
  # answers +true+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ when every item matches
  #
  # @example
  #   [2, 4].all? { |n| n.even? }   # => true
  #   [2, 5].all? { |n| n.even? }   # => false
  #   [].all? { |n| n.even? }       # => true
  #
  # @example Validating every field of a form
  #   fields.all? { |name, value| !value.blank? }
  let all?(pred) = this.reduce(true) do |acc, item|
    acc && Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # Returns +true+ when at least one item satisfies +pred+. An empty
  # collection answers +false+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ when any item matches
  #
  # @example
  #   [1, 2, 3].any? { |n| n > 2 }   # => true
  #   [1, 2, 3].any? { |n| n > 9 }   # => false
  #
  # @example Detecting a flag among arguments
  #   args.any? { |a| a == "--verbose" }
  let any?(pred) = this.reduce(false) do |acc, item|
    acc || Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # Returns the first item satisfying +pred+, or +None+ when nothing does.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [T?] the first match, or +None+
  #
  # @example
  #   [1, 2, 3].find { |n| n > 1 }   # => Just(2)
  #   [1, 2, 3].find { |n| n > 9 }   # => None
  #
  # @example Looking a record up by one of its fields
  #   users.find { |u| u.email == target }.map { |u| u.name }.or("unknown")
  let find(pred) = this.reduce(None) do |acc, item|
    match acc do
      Just(_) => acc
      None    => Kex.Intrinsic.Fun.applyItem(pred, item) then Just(item) else None
    end
  end

  # Returns how many items satisfy +pred+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Integer] the number of matches
  #
  # @example
  #   [1, 2, 3, 4].count { |n| n.even? }   # => 2
  #
  # @example How many lines are comments
  #   text.lines.count { |line| line.trim.startsWith?("#") }
  let count(pred) = this.reduce(0) do |acc, item|
    Kex.Intrinsic.Fun.applyItem(pred, item) then acc + 1 else acc
  end
end

# Collection-producing operations that every foldable collection gets for
# free.
#
# Like +Foldable+, a type joins by implementing +reduce+ alone. The defaults
# here answer with a list, because the block may return anything at all; a
# type that can do better overrides them — +Map.filter+ gives back a map,
# +Set.map+ gives back a set, +String.filter+ gives back a string.
#
#   [1, 2, 3].map { |n| n * 2 }              # => [2, 4, 6]
#   "a1b2".filter(~digit?)                   # => "12"
#   { a: 1, b: 2 }.filter { |k, v| v > 1 }   # => { :b: 2 }
trait Enumerable do
  # Folds the collection from the left. The one operation an +Enumerable+ type
  # must define.
  #
  # @param acc [A] the initial accumulator
  # @param f [A -> T -> A] combines the accumulator with each item
  # @return [A] the final accumulator
  #
  # @example
  #   [1, 2, 3].reduce(1) { |product, n| product * n }   # => 6
  reduce :> A -> (A -> T -> A) -> A

  # Applies +f+ to each item and collects the results into a list.
  #
  # The single most useful method here: it describes what each item becomes,
  # and leaves the walking of the collection implied.
  #
  # @param f [T -> B] applied to each item
  # @return [[B]] the results, in order
  #
  # @example
  #   [1, 2, 3].map { |n| n * 2 }        # => [2, 4, 6]
  #   ["a", "b"].map(~upperCase)         # => ["A", "B"]
  #
  # @example Extracting one field from a list of records
  #   users.map { |u| u.email }
  let map(f) do
    let acc = this.reduce([]) do |a, item|
      [Kex.Intrinsic.Fun.applyItem(f, item) | a]
    end
    return acc.reverse
  end

  # Applies +f+ to each item and its 0-based position, and collects the
  # results into a list.
  #
  # The index is the LAST block parameter — see +eachIndexed+.
  #
  # @param f [T -> Integer -> B] applied to each item and its index
  # @return [[B]] the results, in order
  #
  # @example
  #   ["a", "b"].mapIndexed { |s, i| "${i}${s}" }   # => ["0a", "1b"]
  #
  # @example Building a numbered list
  #   items.mapIndexed { |item, i| "${i + 1}. ${item}" }.join("\n")
  let mapIndexed(f) do
    let folded = this.reduce(([], 0)) do |state, item|
      match state do
        (acc, i) => ([Kex.Intrinsic.Fun.applyIndexed(f, item, i) | acc], i + 1)
      end
    end
    return match folded do
      (acc, _) => acc.reverse
    end
  end

  # Returns the items for which +pred+ answers +true+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [[T]] the matching items, in order
  #
  # @example
  #   [1, 2, 3, 4].filter { |n| n.even? }   # => [2, 4]
  #
  # @example Dropping blank lines
  #   text.lines.filter { |line| !line.trim.empty? }
  let filter(pred) do
    let acc = this.reduce([]) do |a, item|
      Kex.Intrinsic.Fun.applyItem(pred, item) then [item | a] else a
    end
    return acc.reverse
  end

  # Applies +f+ to each item, expecting a list back, and concatenates the
  # results into one flat list.
  #
  # Use it when each item expands into zero or more results — +map+ would give
  # you a list of lists.
  #
  # @param f [T -> [B]] applied to each item, returning a list
  # @return [[B]] all the results, concatenated
  #
  # @example
  #   [[1, 2], [3]].flatMap { |xs| xs }            # => [1, 2, 3]
  #   ["a b", "c"].flatMap { |s| s.split(" ") }    # => ["a", "b", "c"]
  #
  # @example Every tag used across a list of posts
  #   posts.flatMap { |p| p.tags }
  let flatMap(f) = this.reduce([]) do |acc, item|
    acc + Kex.Intrinsic.Fun.applyItem(f, item)
  end

  # Applies +f+ to each item, expecting an +Optional+ back, and returns the
  # values that were present — unwrapped.
  #
  # This is filter and map fused into one pass, which is what you want
  # whenever the test and the transformation are the same operation. Parsing
  # is the classic case: an item either yields a value or it does not.
  #
  # @param f [T -> B?] applied to each item, returning an optional
  # @return [[B]] the present values, unwrapped, in order
  #
  # @example
  #   ["1", "x", "3"].collect { |s| s.to(Integer) }   # => [1, 3]
  #
  # @example Looking several keys up at once, skipping the missing ones
  #   keys.collect { |k| config.get(k) }
  let collect(f) do
    let acc = this.reduce([]) do |a, item|
      match Kex.Intrinsic.Fun.applyItem(f, item) do
        Just(y) => [y | a]
        None    => a
      end
    end
    return acc.reverse
  end

end
