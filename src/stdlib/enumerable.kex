# Foldable — traversal operations derived from a left fold.
#
# Blocks are applied via Kex.Intrinsic.Fun.applyItem, which auto-splats a pair
# item into a two-argument block.

trait Foldable do
  reduce :> A -> (A -> T -> A) -> A

  # Applies +f+ to each item for its side effects. Returns unit.
  let each(f) do
    this.reduce(0) do |_, item|
      Kex.Intrinsic.Fun.applyItem(f, item)
      0
    end
    return ()
  end

  # Applies +f+ to each item together with its 0-based position, for side
  # effects. Returns unit. The index is the LAST block parameter, so a Map
  # entry can be taken either whole (`|entry, i|`) or spread (`|k, v, i|`).
  #
  # @example
  #   ["a", "b"].eachIndexed { |s, i| IO.printLine("${i}: ${s}") }
  let eachIndexed(f) do
    this.reduce(0) do |i, item|
      Kex.Intrinsic.Fun.applyIndexed(f, item, i)
      i + 1
    end
    return ()
  end

  # True if every item satisfies +pred+.
  let all?(pred) = this.reduce(true) do |acc, item|
    acc && Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # True if at least one item satisfies +pred+.
  let any?(pred) = this.reduce(false) do |acc, item|
    acc || Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # The first item satisfying +pred+ wrapped in Just, or None.
  let find(pred) = this.reduce(None) do |acc, item|
    match acc do
      Just(_) => acc
      None    => Kex.Intrinsic.Fun.applyItem(pred, item) then Just(item) else None
    end
  end

  # Counts the items for which +pred+ holds.
  let count(pred) = this.reduce(0) do |acc, item|
    Kex.Intrinsic.Fun.applyItem(pred, item) then acc + 1 else acc
  end
end

# Enumerable — collection-producing operations derived from a left fold.

trait Enumerable do
  reduce :> A -> (A -> T -> A) -> A

  # Transforms each item by applying +f+, collecting the results into a list.
  let map(f) do
    let acc = this.reduce([]) do |a, item|
      [Kex.Intrinsic.Fun.applyItem(f, item) | a]
    end
    return acc.reverse
  end

  # Transforms each item together with its 0-based position, collecting the
  # results into a list. Index is the LAST block parameter — see eachIndexed.
  #
  # @example
  #   ["a", "b"].mapIndexed { |s, i| "${i}${s}" }   # => ["0a", "1b"]
  let mapIndexed(f) do
    let folded = this.reduce(([], 0)) do |state, item|
      match state do
        (acc, i) => ([Kex.Intrinsic.Fun.applyIndexed(f, item, i) | acc], i + 1)
      end
    end
    return match folded do
      (acc, _) => acc.reverse
    end
  end

  # Keeps the items for which +pred+ holds.
  let filter(pred) do
    let acc = this.reduce([]) do |a, item|
      Kex.Intrinsic.Fun.applyItem(pred, item) then [item | a] else a
    end
    return acc.reverse
  end

  # Maps each item to a list and concatenates the results.
  let flatMap(f) = this.reduce([]) do |acc, item|
    acc + Kex.Intrinsic.Fun.applyItem(f, item)
  end

  # Maps each item through +f+ (returning an +Optional+), keeping and unwrapping
  # the +Just(y)+ results and dropping +None+. Filter + map fused via an
  # Optional-returning function.
  let collect(f) do
    let acc = this.reduce([]) do |a, item|
      match Kex.Intrinsic.Fun.applyItem(f, item) do
        Just(y) => [y | a]
        None    => a
      end
    end
    return acc.reverse
  end

end
