# Traversals that every collection with a +reduce+ gets.
#
# A type becomes +Foldable+ by implementing +reduce+; +each+, +all?+,
# +any?+, +find+, +count+ and the rest are built on it. +List+, +String+,
# +Map+, +Range+, +Set+ and +UnorderedSet+ implement it.
#
#   [1, 2, 3].all? { |n| n > 0 }            # => true
#   "hello".any?(~digit?)                   # => false
#   { a: 1, b: 2 }.count { |k, v| v > 1 }   # => 1
#
# When an item is a pair, as a +Map+ entry is, a block with two parameters
# receives its two halves, so a map traversal can be written
# +{ |key, value| ... }+.
trait Foldable<T> do
  # Folds the collection from the left. Every +Foldable+ type must define it;
  # the other functions here are built on it.
  #
  # @param acc [A] the initial accumulator
  # @param f [A -> T -> A] combines the accumulator with each item
  # @return [A] the final accumulator
  #
  # @example
  #   [1, 2, 3].reduce(0) { |sum, n| sum + n }   # => 6
  reduce :> A -> (A -> T -> A) -> A

  # Calls +f+ with each item, for its side effects.
  #
  # To build a new collection, use +map+ or +filter+.
  #
  # @param f [T -> Void] called once per item
  # @return [Void]
  #
  # @example
  #   ["ada", "grace"].each { |name| IO.printLine(name) }
  #
  # @example Over a map, the block takes key and value
  #   { host: "localhost", port: "8080" }.each do |key, value|
  #     IO.printLine("${key} = ${value}")
  #   end
  let each(f) do
    match Kex.Intrinsic.Kex.backend() do
      Kex.Interpreter => do
        this.reduce(0) do |_, item|
          Kex.Intrinsic.Fun.applyItem(f, item)
          0
        end
        ()
      end
      # Compiled, the items are a list, and the block goes to List.each:
      # a loop the specialize-blocks pass copies into the caller.
      _ => do
        let items: [T] = Kex.Intrinsic.Fun.items(this)
        items.each(f)
      end
    end
  end

  # Calls +f+ with each item and its 0-based position, for its side effects.
  #
  # The index is the last block parameter, so a +Map+ entry can be taken
  # whole (+|entry, i|+) or split (+|k, v, i|+).
  #
  # @param f [T -> Integer -> Void] called with each item and its index
  # @return [Void]
  #
  # @example
  #   ["a", "b"].eachIndexed { |s, i| IO.printLine("${i}: ${s}") }
  #   # prints: 0: a
  #   #         1: b
  #
  # @example Numbering the lines of a file
  #   text.lines.eachIndexed { |line, i| IO.printLine("${i + 1}\t${line}") }
  let eachIndexed(f) do
    this.reduce(0) do |i, item|
      Kex.Intrinsic.Fun.applyIndexed(f, item, i)
      i + 1
    end
    return ()
  end

  # Returns +true+ when every item satisfies +pred+, and +true+ for an empty
  # collection.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ when every item matches
  #
  # @example
  #   [2, 4].all? { |n| n.even? }   # => true
  #   [2, 5].all? { |n| n.even? }   # => false
  #   [].all? { |n| n.even? }       # => true
  #
  # @example Validating every field of a form
  #   fields.all? { |name, value| !value.blank? }
  let all?(pred: T -> Bool) -> Bool = this.reduce(true) do |acc, item|
    acc && Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # Returns +true+ when at least one item satisfies +pred+, and +false+ for an
  # empty collection.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ when any item matches
  #
  # @example
  #   [1, 2, 3].any? { |n| n > 2 }   # => true
  #   [1, 2, 3].any? { |n| n > 9 }   # => false
  #
  # @example Detecting a flag among arguments
  #   args.any? { |a| a == "--verbose" }
  let any?(pred: T -> Bool) -> Bool = this.reduce(false) do |acc, item|
    acc || Kex.Intrinsic.Fun.applyItem(pred, item)
  end

  # Returns +true+ when no item satisfies +pred+, the opposite of +any?+. An
  # empty collection gives +true+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ when nothing matches
  #
  # @example
  #   [1, 2, 3].none? { |n| n > 9 }   # => true
  #   [1, 2, 3].none? { |n| n > 2 }   # => false
  let none?(pred: T -> Bool) -> Bool = !this.any?(pred)

  # Returns +true+ when exactly one item satisfies +pred+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Bool] +true+ for exactly one match
  #
  # @example
  #   [1, 2, 3].one? { |n| n > 2 }   # => true
  #   [1, 2, 3].one? { |n| n > 1 }   # => false
  let one?(pred: T -> Bool) -> Bool = this.count(pred) == 1

  # Returns the first item satisfying +pred+, or +None+ when nothing does.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [T?] the first match, or +None+
  #
  # @example
  #   [1, 2, 3].find { |n| n > 1 }   # => Just(2)
  #   [1, 2, 3].find { |n| n > 9 }   # => None
  #
  # @example Looking a record up by one of its fields
  #   users.find { |u| u.email == target }.map { |u| u.name }.or("unknown")
  let find(pred: T -> Bool) -> T? = this.reduce(None) do |acc, item|
    match acc do
      Just(_) => acc
      None    => Kex.Intrinsic.Fun.applyItem(pred, item) then Just(item) else None
    end
  end

  # Returns how many items satisfy +pred+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [Integer] the number of matches
  #
  # @example
  #   [1, 2, 3, 4].count { |n| n.even? }   # => 2
  #
  # @example How many lines are comments
  #   text.lines.count { |line| line.trim.startsWith?("#") }
  let count(pred: T -> Bool) -> Integer = this.reduce(0) do |acc, item|
    Kex.Intrinsic.Fun.applyItem(pred, item) then acc + 1 else acc
  end
end

# Functions that build a new collection, for every collection with a
# +reduce+.
#
# As with +Foldable+, a type only has to implement +reduce+. The functions
# here return lists, since the block may return anything. Some types
# override them to keep their own shape: +Map.filter+ returns a map,
# +Set.map+ a set, and +String.filter+ a string.
#
#   [1, 2, 3].map { |n| n * 2 }              # => [2, 4, 6]
#   "a1b2".filter(~digit?)                   # => "12"
#   { a: 1, b: 2 }.filter { |k, v| v > 1 }   # => { b: 2 }
trait Enumerable<T> do
  # Folds the collection from the left. Every +Enumerable+ type must define
  # it.
  #
  # @param acc [A] the initial accumulator
  # @param f [A -> T -> A] combines the accumulator with each item
  # @return [A] the final accumulator
  #
  # @example
  #   [1, 2, 3].reduce(1) { |product, n| product * n }   # => 6
  reduce :> A -> (A -> T -> A) -> A

  # Applies +f+ to each item and returns the results as a list.
  #
  # @param f [T -> B] applied to each item
  # @return [[B]] the results, in order
  #
  # @example
  #   [1, 2, 3].map { |n| n * 2 }        # => [2, 4, 6]
  #   ["a", "b"].map(~upperCase)         # => ["A", "B"]
  #
  # @example Extracting one field from a list of records
  #   users.map { |u| u.email }
  let map(f: T -> B) -> [B] do
    let acc = this.reduce([]) do |a, item|
      [Kex.Intrinsic.Fun.applyItem(f, item) | a]
    end
    return acc.reverse
  end

  # Applies +f+ to each item and its 0-based position, and returns the
  # results as a list.
  #
  # The index is the last block parameter, as in +eachIndexed+.
  #
  # @param f [T -> Integer -> B] applied to each item and its index
  # @return [[B]] the results, in order
  #
  # @example
  #   ["a", "b"].mapIndexed { |s, i| "${i}${s}" }   # => ["0a", "1b"]
  #
  # @example Building a numbered list
  #   items.mapIndexed { |item, i| "${i + 1}. ${item}" }.join("\n")
  let mapIndexed(f: T -> Integer -> B) -> [B] do
    let folded = this.reduce(([], 0)) do |state, item|
      match state do
        (acc, i) => ([Kex.Intrinsic.Fun.applyIndexed(f, item, i) | acc], i + 1)
      end
    end
    return match folded do
      (acc, _) => acc.reverse
    end
  end

  # Returns the items for which +pred+ returns +true+.
  #
  # @param pred [T -> Bool] the test applied to each item
  # @return [[T]] the matching items, in order
  #
  # @example
  #   [1, 2, 3, 4].filter { |n| n.even? }   # => [2, 4]
  #
  # @example Dropping blank lines
  #   text.lines.filter { |line| !line.trim.empty? }
  let filter(pred: T -> Bool) -> [T] do
    let acc = this.reduce([]) do |a, item|
      Kex.Intrinsic.Fun.applyItem(pred, item) then [item | a] else a
    end
    return acc.reverse
  end

  # Applies +f+, which returns a list, to each item and concatenates the
  # results.
  #
  # Use it when each item expands into zero or more results; +map+ would give
  # a list of lists.
  #
  # @param f [T -> [B]] applied to each item, returning a list
  # @return [[B]] all the results, concatenated
  #
  # @example
  #   [[1, 2], [3]].into { |xs| xs }            # => [1, 2, 3]
  #   ["a b", "c"].into { |s| s.split(" ") }    # => ["a", "b", "c"]
  #
  # @example Every tag used across a list of posts
  #   posts.into { |p| p.tags }
  let into(f: T -> [B]) -> [B] = this.reduce([]) do |acc, item|
    acc + Kex.Intrinsic.Fun.applyItem(f, item)
  end

  # Applies +f+, which returns an +Optional+, to each item and returns the
  # present values, unwrapped.
  #
  # It filters and maps in one pass. Use it when the test and the
  # transformation are the same step, as in parsing, where each item either
  # gives a value or does not.
  #
  # @param f [T -> B?] applied to each item, returning an optional
  # @return [[B]] the present values, unwrapped, in order
  #
  # @example
  #   ["1", "x", "3"].collect { |s| s.to(Integer) }   # => [1, 3]
  #
  # @example Looking several keys up at once, skipping the missing ones
  #   keys.collect { |k| config.get(k) }
  let collect(f: T -> B?) -> [B] do
    # Typed in place: its body applies `f` through an intrinsic, so nothing
    # could be inferred from it, and every `xs.collect { ... }` was `Any` to the
    # checker and to completion (`make fuzz-lsp`). (A `name :>` line in a trait
    # declares a required function instead.)
    let acc = this.reduce([]) do |a, item|
      match Kex.Intrinsic.Fun.applyItem(f, item) do
        Just(y) => [y | a]
        None    => a
      end
    end
    return acc.reverse
  end

end
