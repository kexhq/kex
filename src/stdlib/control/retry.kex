# Retries an operation that returns an error, with a delay between attempts.
#
# @example Retry a request and handle the final result
#   using Control.Retry
#   using Net.HTTP
#
#   let result = Retry.run(attempts: 5) do
#     HTTP.get("https://api.example.com/inventory")
#   end
#   match result do
#     Ok(response) => IO.printLine(response.status.code)
#     Error(error) => IO.printLine(error.message)
#   end
#
# @example Fixed delays: three waits of 250 milliseconds
#   let schedule = Retry.Schedule {
#     attempts: 4, delay: 250.millisecond, backoff: 1.0,
#     maximumDelay: 250.millisecond, jitter: 0.0
#   }
#   Retry.run(schedule: schedule) do
#     Error("not ready")
#   end
#   # => Error("not ready"), after four calls and 750 ms of sleep
#
# @example Exponential delays: 200, 400, 800, 1600 milliseconds
#   let schedule = Retry.Schedule {
#     attempts: 5, delay: 200.millisecond, backoff: 2.0,
#     maximumDelay: 5.second, jitter: 0.0
#   }
#   Retry.run(schedule: schedule) do
#     Error("busy")
#   end
#   # => Error("busy"), after five calls and three seconds of sleep
#
# @example Capped delays: 500 ms, 1 s, 2 s, 2 s, 2 s
#   Retry.Schedule {
#     attempts: 6, delay: 500.millisecond, backoff: 2.0,
#     maximumDelay: 2.second, jitter: 0.0
#   }
#
# @example Use one schedule for two requests
#   using Net.HTTP
#   let schedule = Retry.Schedule { attempts: 5 }
#   let inventory = Retry.run(schedule: schedule) do
#     HTTP.get("https://api.example.com/inventory")
#   end
#   let orders = Retry.run(schedule: schedule) do
#     HTTP.get("https://api.example.com/orders")
#   end
#   # Each request gets up to five attempts, independently.
#
# @example Set retry options directly
#   Retry.run(attempts: 5, delay: 200.millisecond, jitter: 0.0) do
#     Ok("ready")
#   end
#   # => Ok("ready")
#
# @example Limit the time spent sleeping
#   Retry.run(
#     attempts: 5, delay: 1.second, backoff: 2.0,
#     jitter: 0.0, maximumTotalDelay: Just(2.second)
#   ) do
#     Error("busy")
#   end
#   # => Error("busy"), two calls and one second of sleep
#
# @example Test jitter without waiting
#   Retry.run(
#     attempts: 2, delay: 4.second, jitter: 0.25,
#     sleeper: { |wait| Assert.equal(wait, 3.second) },
#     random: { 0.0 }
#   ) do
#     Error("temporary")
#   end
#   # => Error("temporary"), two calls and one fake sleep
#
# @example Report progress
#   using Net.HTTP
#   Retry.run(attempts: 5, onRetry: { |info|
#     let progress = "retrying ${info.nextAttempt}/${info.maximumAttempts}"
#     IO.printLine("${progress} in ${info.delay.seconds} seconds")
#   }) do
#     HTTP.get("https://api.example.com/inventory")
#   end
#
# @example Retry temporary HTTP failures and selected statuses
#   using Net
#   using Net.HTTP
#   let schedule = Retry.Schedule { attempts: 5 }
#   let outcome = Retry.run(schedule: schedule) do
#     let result = HTTP.get("https://api.example.com/inventory")
#     match result do
#       Error(error) => if error.kind == Timeout || error.kind == Connect
#         Retry.again(result)
#       else
#         Retry.done(result)
#       end
#       Ok(response) => if [429, 502, 503, 504].contains?(response.status.code)
#         Retry.again(result)
#       else
#         Retry.done(result)
#       end
#     end
#   end
#   match outcome do
#     Retry.Done(result) => IO.printLine(result)
#     Retry.Again(last) => IO.printLine("retry budget exhausted: ${last}")
#   end
module Control.Retry

# Running an operation until it succeeds or a +Schedule+ runs out.
#
# +run+ calls the block at once. An +Ok+ result is returned; an +Error+ is
# retried after a wait, and when the schedule runs out the last error is
# returned as it is. To choose yourself what to retry, return +again+ or
# +done+ from the block.
#
# An HTTP 429 or 503 response is +Ok(response)+, so retrying on a status needs
# +again+. Only retry a write when repeating it is harmless, for example with
# an idempotency key. The schedule limits the time spent sleeping, not the time
# spent in the operation, so give requests their own timeouts.
module Retry do
  # The attempt limit and the waits +run+ uses between attempts.
  #
  # Every field has a default: three attempts, a first wait of 100 ms that
  # doubles each time up to 5 seconds, and 20% jitter. A schedule only holds
  # settings, so each +run+ that uses it starts again from the first attempt.
  record Schedule do
    # How many times the operation may run, counting the first call. Default 3.
    # Below 1 counts as 1, since the first call always happens.
    attempts : Integer = 3
    # The wait before the second attempt, before jitter. Default 100 ms.
    # A negative delay counts as zero, and +maximumDelay+ caps it.
    delay : Duration = 100.millisecond
    # What each wait is multiplied by to get the next one. Default 2.0.
    # Use 1.0 for equal waits; below 1 counts as 1. Jitter does not carry over
    # into the next wait.
    backoff : Float = 2.0
    # The longest single wait, after jitter. Default 5 seconds.
    # A negative cap counts as zero. Reaching the cap does not stop retrying.
    maximumDelay : Duration = 5.second
    # How far each wait may vary either way, as a fraction. Default 0.2.
    # With 0.2, a 200 ms wait becomes a random 160 to 240 ms before the cap
    # applies. Use 0.0 for exact waits. Clamped to 0..1.
    jitter : Float = 0.2
    # The most time to spend sleeping over the whole run. Default +None+, no
    # limit. When the next wait would go past it, +run+ returns the last result
    # without sleeping. Time spent in the operation does not count, and a
    # negative limit counts as zero.
    maximumTotalDelay : Duration? = None
  end

  # A block's decision whether to retry, carrying its result.
  #
  # From +run+, +Done(value)+ means the block chose to stop, and +Again(value)+
  # means it still wanted to retry when the schedule ran out. The value can be
  # anything, including an +Error+.
  type Decision<X> = Again(X) | Done(X)

  # Returns +Again(value)+, asking +run+ to try again if the schedule allows.
  #
  # @param value [X] the result, which +run+ returns if the schedule runs out
  # @return [Decision<X>] +Again(value)+
  again : X -> Decision<X>
  let again(value) = Again(value)

  # Returns +Done(value)+, telling +run+ to stop with +value+, whether that is
  # a success or a failure not worth retrying.
  #
  # @param value [X] the final result
  # @return [Decision<X>] +Done(value)+
  done : X -> Decision<X>
  let done(value) = Done(value)

  # What +run+ passes to +onRetry+ just before it waits for the next attempt.
  #
  # +onRetry+ is called only when another attempt will follow, never after a
  # success, a +done+, or the last attempt. The durations count sleep only,
  # not time spent in the operation.
  record Info<X> do
    # The attempt that just failed, counting from 1.
    attempt : Integer
    # The attempt that runs after this wait.
    nextAttempt : Integer
    # The schedule's +attempts+.
    maximumAttempts : Integer
    # How many attempts are left, including the next one.
    remainingAttempts : Integer
    # The wait about to start, after jitter and the cap.
    delay : Duration
    # The time slept so far in this run, not counting this wait.
    totalDelay : Duration
    # The result that is being retried: an +Error+ or an +Again+.
    result : X
  end

  # Calls +operation+ until it succeeds, returns +done+, or runs out of attempts
  # or sleep time, and returns its last result.
  #
  # The first call happens at once, and each later one after a wait. Named
  # timing options override that field of +schedule+ for this run only.
  #
  # When the block returns a +Result+, +Ok+ stops and +Error+ is retried. When
  # it returns +done(value)+ or +again(value)+, it decides itself. Use one of
  # the two forms throughout the block. An error raised inside the block is not
  # caught or retried.
  #
  # Settings out of range are adjusted, not rejected: attempts below 1 become
  # 1, negative durations zero, a backoff below 1 becomes 1, and jitter and the
  # random samples are clamped to 0..1.
  #
  # @param operation [Block<X>] called once per attempt; returns a +Result+ or
  #   a +Decision+
  # @param schedule [Schedule] the settings; defaults to +Schedule {}+
  # @param attempts [Integer] total attempts; defaults to the schedule field
  # @param delay [Duration] initial wait; defaults to the schedule field
  # @param backoff [Float] delay multiplier; defaults to the schedule field
  # @param maximumDelay [Duration] sleep cap; defaults to the schedule field
  # @param jitter [Float] variation fraction; defaults to the schedule field
  # @param maximumTotalDelay [Duration?] sleep budget; defaults to the field
  # @param sleeper [Duration -> Void] waits between attempts; defaults to
  #   +Task.sleep+
  # @param random [Block<Float>] returns a sample in 0..1 for jitter; defaults
  #   to a secure random source
  # @param onRetry [Info<X> -> Void] called before each wait; defaults to doing
  #   nothing
  # @return [X] the first +Ok+ or +Done+, or the last +Error+ or +Again+ when
  #   the schedule runs out
  #
  # +Done(Error(...))+ means the block gave up on an error not worth retrying.
  # +Again(Ok(response))+ means a response the block rejected, such as a 503,
  # kept coming until the schedule ran out. +run+ knows nothing about HTTP:
  # deciding which statuses to retry and honouring +Retry-After+ are up to the
  # block.
  #
  # +sleeper+ and +random+ are for tests, and replacing one leaves the other
  # real. A sample of 0 picks the shortest jittered wait, 0.5 the unjittered
  # one, and 1 the longest. With zero jitter +random+ is not called.
  # lint:allow parameter-count — named options make each setting independent
  run : Block<X> -> Schedule -> Integer -> Duration -> Float -> Duration -> Float -> Duration? -> (Duration -> Void) -> Block<Float> -> (Info<X> -> Void) -> X
  foul run(
    operation,
    schedule = Schedule {},
    attempts = schedule.attempts,
    delay = schedule.delay,
    backoff = schedule.backoff,
    maximumDelay = schedule.maximumDelay,
    jitter = schedule.jitter,
    maximumTotalDelay = schedule.maximumTotalDelay,
    sleeper = { |wait| Task.sleep(wait) },
    random = { Kex.Intrinsic.Retry.randomUnit() },
    onRetry = { |_info| () }
  ) do
    let settings = Schedule {
      attempts: attempts,
      delay: delay,
      backoff: backoff,
      maximumDelay: maximumDelay,
      jitter: jitter,
      maximumTotalDelay: maximumTotalDelay
    }
    attempt(settings, sleeper, random, onRetry, operation, 1, boundedDelay(settings, delay.seconds), 0.0)
  end

  private do
    retry? : Result<X, E> -> Bool
    let retry?(Ok(_)) = false
    let retry?(Error(_)) = true
    retry? : Decision<X> -> Bool
    let retry?(Done(_)) = false
    let retry?(Again(_)) = true

    let clamp(value: Float, low: Float, high: Float) -> Float do
      if value < low
        low
      elif value > high
        high
      else
        value
      end
    end

    let boundedDelay(schedule: Schedule, waitSeconds: Float) -> Float do
      let cap = if schedule.maximumDelay.seconds < 0.0
        0.0
      else
        schedule.maximumDelay.seconds
      end
      clamp(waitSeconds, 0.0, cap)
    end

    attempt : Schedule -> (Duration -> Void) -> Block<Float> -> (Info<X> -> Void) -> Block<X> -> Integer -> Float -> Float -> X
    foul attempt(schedule, sleeper, random, onRetry, operation, number, base, elapsed) do
      let result = operation()
      if number >= schedule.attempts || !retry?(result)
        return result
      end
      let fraction = clamp(schedule.jitter, 0.0, 1.0)
      let sample = fraction == 0.0 then 0.5 else clamp(random(), 0.0, 1.0)
      let sleepSeconds = boundedDelay(schedule, base * (1.0 + (sample * 2.0 - 1.0) * fraction))
      let nextElapsed = elapsed + sleepSeconds
      let allowed = match schedule.maximumTotalDelay do
        None => true
        Just(limit) => nextElapsed <= (limit.seconds < 0.0 then 0.0 else limit.seconds)
      end
      if !allowed
        return result
      end
      onRetry(Info {
        attempt: number,
        nextAttempt: number + 1,
        maximumAttempts: schedule.attempts,
        remainingAttempts: schedule.attempts - number,
        delay: (sleepSeconds).second,
        totalDelay: (elapsed).second,
        result: result
      })
      sleeper((sleepSeconds).second)
      let factor = schedule.backoff < 1.0 then 1.0 else schedule.backoff
      let nextBase = boundedDelay(schedule, base * factor)
      attempt(schedule, sleeper, random, onRetry, operation, number + 1, nextBase, nextElapsed)
    end
  end
end
