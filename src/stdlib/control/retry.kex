module Control.Retry

# A bounded retry schedule. Attempts includes the initial call.
record Policy do
  maximumAttempts : Integer
  initialDelay : Duration
  multiplier : Float
  maximumDelay : Duration
end

fixed : Integer -> Duration -> Policy
let fixed(maximumAttempts, delay) = Policy {
  maximumAttempts: maximumAttempts,
  initialDelay: delay,
  multiplier: 1.0,
  maximumDelay: delay
}

exponential : Integer -> Duration -> Duration -> Policy
let exponential(maximumAttempts, initialDelay, maximumDelay) = Policy {
  maximumAttempts: maximumAttempts,
  initialDelay: initialDelay,
  multiplier: 2.0,
  maximumDelay: maximumDelay
}

run : Policy -> Block<Result<X, E>> -> Result<X, E>
foul run(policy, operation) = attempt(policy, operation, 1, policy.initialDelay)

foul attempt(policy: Policy, operation: Block<Result<X, E>>, number: Integer, delay: Duration) -> Result<X, E> do
  let result = operation()
  return match result do
    Ok(value) => Ok(value)
    Error(error) => do
      if number >= policy.maximumAttempts
        return Error(error)
      end
      Task.sleep(delay)
      let nextSeconds = delay.seconds * policy.multiplier
      let bounded = if nextSeconds > policy.maximumDelay.seconds then policy.maximumDelay else Duration { seconds: nextSeconds } end
      return attempt(policy, operation, number + 1, bounded)
    end
  end
end

# The imported public namespace: `using Control.Retry` then `Retry.run(...)`.
module Retry do
  fixed : Integer -> Duration -> Policy
  let fixed(maximumAttempts, delay) = Control.Retry.fixed(maximumAttempts, delay)

  exponential : Integer -> Duration -> Duration -> Policy
  let exponential(maximumAttempts, initialDelay, maximumDelay) = Control.Retry.exponential(maximumAttempts, initialDelay, maximumDelay)

  run : Policy -> Block<Result<X, E>> -> Result<X, E>
  foul run(policy, operation) = Control.Retry.run(policy, operation)
end
