# Runs bounded retries with a reusable schedule.
#
# +Retry.run+ executes the block immediately. An +Ok+ stops the run; an
# +Error+ schedules another attempt. When attempts or total sleep run out,
# the last error is returned unchanged. Runtime faults are not caught.
#
# @example Retry a request and handle the final result
#   using Control.Retry
#   using Net.HTTP
#
#   let result = Retry.run(attempts: 5) do
#     HTTP.get("https://api.example.com/inventory")
#   end
#   match result do
#     Ok(response) => IO.printLine(response.status.code)
#     Error(error) => IO.printLine(error.message)
#   end
#
# HTTP responses, including 429 and 503, are +Ok(response)+. Automatic
# retries handle request failures, not response statuses. Use +again+ and
# +done+ to classify responses or stop on permanent errors. Repeat writes
# only when the application makes them safe, for example with idempotency
# keys. A schedule bounds retry sleep, not the operation's execution time;
# configure request timeouts separately.
module Control.Retry

# Provides automatic error retries and explicit retry decisions.
module Retry do
  # Describes the timing and limits of one execution of +run+.
  #
  # All fields are optional. Defaults allow three attempts with exponential
  # backoff from 100 milliseconds, capped at 5 seconds, with 20% jitter.
  # Creating a schedule performs no work. It is immutable configuration:
  # each run starts a fresh attempt count and delay sequence.
  #
  # * +attempts+: maximum executions, including the first; default 3.
  # * +delay+: initial base wait; default 100 milliseconds.
  # * +backoff+: base-delay multiplier; default 2.0, or 1.0 for fixed waits.
  # * +maximumDelay+: cap on each actual wait, including jitter; default 5 seconds.
  # * +jitter+: symmetric proportional variation; default 0.2, or 0.0 to disable.
  # * +maximumTotalDelay+: cumulative sleep allowance; default +None+.
  #   Operation execution time is excluded. A wait that exceeds the remaining
  #   allowance ends the run without sleeping or calling the operation again.
  #
  # @example Fixed delays: three waits of 250 milliseconds
  #   let schedule = Retry.Schedule {
  #     attempts: 4, delay: 250.milliseconds, backoff: 1.0,
  #     maximumDelay: 250.milliseconds, jitter: 0.0
  #   }
  #   Retry.run(schedule: schedule) do
  #     Error("not ready")
  #   end
  #   # => Error("not ready"), after four calls and 750 ms of sleep
  #
  # @example Exponential delays: 200, 400, 800, 1600 milliseconds
  #   let schedule = Retry.Schedule {
  #     attempts: 5, delay: 200.milliseconds, backoff: 2.0,
  #     maximumDelay: 5.seconds, jitter: 0.0
  #   }
  #   Retry.run(schedule: schedule) do
  #     Ok("ready")
  #   end
  #   # => Ok("ready"), immediately, without sleeping
  #
  # @example Capped delays: 500 ms, 1 s, 2 s, 2 s, 2 s
  #   Retry.Schedule {
  #     attempts: 6, delay: 500.milliseconds, backoff: 2.0,
  #     maximumDelay: 2.seconds, jitter: 0.0
  #   }
  #
  # @example Share settings, not an attempt budget
  #   using Net.HTTP
  #   let schedule = Retry.Schedule { attempts: 5 }
  #   let inventory = Retry.run(schedule: schedule) do
  #     HTTP.get("https://api.example.com/inventory")
  #   end
  #   let orders = Retry.run(schedule: schedule) do
  #     HTTP.get("https://api.example.com/orders")
  #   end
  #   # Each request gets up to five attempts, independently.
  record Schedule do
    # Maximum executions including the initial call. Default: 3.
    # Values below 1 are treated as 1: the initial call always happens.
    attempts : Integer = 3
    # Base wait before the second attempt. Default: 100 milliseconds.
    # Negative durations are treated as zero; the delay cap applies here too.
    delay : Duration = Duration.milliseconds(100)
    # Base-delay multiplier. Default: 2.0. Values below 1 become 1.
    # Set to 1.0 for fixed delays. Jitter never changes the next base delay.
    backoff : Float = 2.0
    # Maximum actual wait, including jitter. Default: 5 seconds.
    # Negative durations become zero. Hitting this cap does not stop retries.
    maximumDelay : Duration = Duration.seconds(5)
    # Symmetric proportional variation. Default: 0.2; clamped to 0..1.
    # For a 200 ms base, 0.2 samples 160..240 ms, then applies the cap.
    # Set to 0.0 for exact waits. Samples are independent between runs.
    jitter : Float = 0.2
    # Optional bound on cumulative actual sleep. Default: None.
    # A wait exceeding the remaining allowance stops retries before sleeping.
    # Negative bounds become zero. Operation execution time is not counted.
    maximumTotalDelay : Duration? = None
  end

  # Carries an explicit decision and the last application value.
  # +Done(value)+ means the block stopped deliberately. +Again(value)+
  # returned by +run+ means the schedule was exhausted before completion.
  # Neither form wraps the application value in an additional +Result+.
  type Decision<X> = Again(X) | Done(X)

  # Requests another attempt if the schedule allows it.
  #
  # @param value [X] the last outcome, retained if the schedule is exhausted
  # @return [Decision<X>] +Again(value)+
  # @example Polling an application job
  #   Retry.again("pending")
  again : X -> Decision<X>
  let again(value) = Again(value)

  # Stops immediately, even when the application value represents failure.
  #
  # @param value [X] the final application outcome
  # @return [Decision<X>] +Done(value)+
  # @example Stop on invalid credentials without retrying
  #   Retry.done(Error("invalid credentials"))
  done : X -> Decision<X>
  let done(value) = Done(value)

  # Describes a retry that is about to wait and then execute another attempt.
  #
  # Passed to +onRetry+ only after the last outcome requests a retry and
  # the schedule permits it. There is no notification for the initial call,
  # success, explicit completion, or exhaustion. Reporting does not consume
  # attempts. Durations describe scheduled sleep, not wall-clock elapsed time.
  #
  # * +attempt+: the just-completed attempt, starting at 1.
  # * +nextAttempt+: the attempt that follows the upcoming wait.
  # * +maximumAttempts+: total permitted executions, including the first.
  # * +remainingAttempts+: executions remaining, including the upcoming one.
  # * +delay+: actual upcoming wait, after jitter and the delay cap.
  # * +totalDelay+: sleep already performed, excluding the upcoming wait.
  # * +result+: the last +Error+ or +Again+, including its application payload.
  record Info<X> do
    # The attempt that just finished, starting at 1.
    attempt : Integer
    # The attempt that will run after the upcoming delay.
    nextAttempt : Integer
    # Total allowed executions, normalized to at least 1.
    maximumAttempts : Integer
    # Executions still allowed, including the upcoming attempt.
    remainingAttempts : Integer
    # The actual upcoming wait, after jitter and the delay cap.
    delay : Duration
    # Sleep already performed in this run, excluding the upcoming wait.
    totalDelay : Duration
    # The last Error or Again value, including the application's payload.
    result : X
  end

  # Runs a fresh operation until it succeeds, stops, or exhausts its schedule.
  #
  # The first attempt is immediate. Every later attempt follows one sleep.
  # There is no sleep after success or the final error. Named timing options
  # override the corresponding schedule field for this execution only.
  #
  # An ordinary block returns +Result<X, E>+: +Ok+ stops, +Error+ retries,
  # and exhaustion returns the last +Error+ unchanged. An explicit block
  # returns +Decision<X>+: +Done+ stops, +Again+ retries, and exhaustion
  # returns the last +Again+. Match the returned decision to distinguish
  # completion from exhaustion. Use one form consistently within a block.
  #
  # Finite settings are normalized: attempts below one become one, negative
  # durations become zero, backoff below one becomes one, jitter and random
  # samples are clamped to 0..1. Non-finite Float settings are unsupported.
  #
  # @param operation [Block<X>] fresh Result or Decision on each attempt
  # @param schedule [Schedule] reusable settings; defaults to +Schedule {}+
  # @param attempts [Integer] total attempts; defaults to the schedule field
  # @param delay [Duration] initial wait; defaults to the schedule field
  # @param backoff [Float] delay multiplier; defaults to the schedule field
  # @param maximumDelay [Duration] sleep cap; defaults to the schedule field
  # @param jitter [Float] variation fraction; defaults to the schedule field
  # @param maximumTotalDelay [Duration?] sleep budget; defaults to the field
  # @param sleeper [Duration -> Void] defaults to real +Task.sleep+
  # @param random [Block<Float>] defaults to secure backend sampling in 0..1
  # @param onRetry [Info<X> -> Void] reports an allowed retry; defaults to no action
  # @return [X] first Ok/Done or last Error/Again, without extra wrapping
  #
  # @example Named options without constructing a schedule
  #   Retry.run(attempts: 5, delay: 200.milliseconds, jitter: 0.0) do
  #     Ok("ready")
  #   end
  #   # => Ok("ready")
  #
  # @example Stop before a wait exceeds the total sleep budget
  #   Retry.run(
  #     attempts: 5, delay: 1.seconds, backoff: 2.0,
  #     jitter: 0.0, maximumTotalDelay: Just(2.seconds)
  #   ) do
  #     Error("busy")
  #   end
  #   # => Error("busy"), two calls and one second of sleep
  #
  # @example Test jitter without waiting
  #   Retry.run(
  #     attempts: 2, delay: 4.seconds, jitter: 0.25,
  #     sleeper: { |wait| Assert.equal(wait, 3.seconds) },
  #     random: { 0.0 }
  #   ) do
  #     Error("temporary")
  #   end
  #   # => Error("temporary"), two calls and one fake sleep
  #
  # @example Report progress to a user or log
  #   using Net.HTTP
  #   Retry.run(attempts: 5, onRetry: { |info|
  #     let progress = "retrying ${info.nextAttempt}/${info.maximumAttempts}"
  #     IO.printLine("${progress} in ${info.delay.seconds} seconds")
  #   }) do
  #     HTTP.get("https://api.example.com/inventory")
  #   end
  #
  # @example Retry temporary HTTP failures and selected statuses
  #   using Net
  #   using Net.HTTP
  #   let schedule = Retry.Schedule { attempts: 5 }
  #   let outcome = Retry.run(schedule: schedule) do
  #     let result = HTTP.get("https://api.example.com/inventory")
  #     match result do
  #       Error(error) => if error.kind == Timeout || error.kind == Connect
  #         Retry.again(result)
  #       else
  #         Retry.done(result)
  #       end
  #       Ok(response) => if [429, 502, 503, 504].contains?(response.status.code)
  #         Retry.again(result)
  #       else
  #         Retry.done(result)
  #       end
  #     end
  #   end
  #   match outcome do
  #     Done(result) => IO.printLine(result)
  #     Again(last) => IO.printLine("retry budget exhausted: ${last}")
  #   end
  #
  # +Done(Error(...))+ means the application stopped on a permanent error.
  # +Again(Ok(response))+ means an unacceptable HTTP status persisted until
  # exhaustion. HTTP status classification and Retry-After handling are the
  # application's responsibility; +run+ has no HTTP-specific behavior.
  #
  # The testing hooks are independent: replacing sleep keeps normal random
  # sampling, and replacing randomness keeps real sleep. A random sample of
  # 0 selects the lower jitter bound, 0.5 the base, and 1 the upper bound.
  # With zero jitter no random sample is needed.
  # lint:allow parameter-count — named options make each setting independent
  run : Block<X> -> Schedule -> Integer -> Duration -> Float -> Duration -> Float -> Duration? -> (Duration -> Void) -> Block<Float> -> (Info<X> -> Void) -> X
  foul run(
    operation,
    schedule = Schedule {},
    attempts = schedule.attempts,
    delay = schedule.delay,
    backoff = schedule.backoff,
    maximumDelay = schedule.maximumDelay,
    jitter = schedule.jitter,
    maximumTotalDelay = schedule.maximumTotalDelay,
    sleeper = { |wait| Task.sleep(wait) },
    random = { Kex.Intrinsic.Retry.randomUnit() },
    onRetry = { |_info| () }
  ) do
    let settings = Schedule {
      attempts: attempts,
      delay: delay,
      backoff: backoff,
      maximumDelay: maximumDelay,
      jitter: jitter,
      maximumTotalDelay: maximumTotalDelay
    }
    attempt(settings, sleeper, random, onRetry, operation, 1, boundedDelay(settings, delay.seconds), 0.0)
  end

  private do
    retry? : Result<X, E> -> Bool
    let retry?(Ok(_)) = false
    let retry?(Error(_)) = true
    retry? : Decision<X> -> Bool
    let retry?(Done(_)) = false
    let retry?(Again(_)) = true

    let clamp(value: Float, low: Float, high: Float) -> Float do
      if value < low
        low
      elif value > high
        high
      else
        value
      end
    end

    let boundedDelay(schedule: Schedule, waitSeconds: Float) -> Float do
      let cap = if schedule.maximumDelay.seconds < 0.0
        0.0
      else
        schedule.maximumDelay.seconds
      end
      clamp(waitSeconds, 0.0, cap)
    end

    attempt : Schedule -> (Duration -> Void) -> Block<Float> -> (Info<X> -> Void) -> Block<X> -> Integer -> Float -> Float -> X
    foul attempt(schedule, sleeper, random, onRetry, operation, number, base, elapsed) do
      let result = operation()
      if number >= schedule.attempts || !retry?(result)
        return result
      end
      let fraction = clamp(schedule.jitter, 0.0, 1.0)
      let sample = if fraction == 0.0 then 0.5 else clamp(random(), 0.0, 1.0) end
      let sleepSeconds = boundedDelay(schedule, base * (1.0 + (sample * 2.0 - 1.0) * fraction))
      let nextElapsed = elapsed + sleepSeconds
      let allowed = match schedule.maximumTotalDelay do
        None => true
        Just(limit) => nextElapsed <= (if limit.seconds < 0.0 then 0.0 else limit.seconds end)
      end
      if !allowed
        return result
      end
      onRetry(Info {
        attempt: number,
        nextAttempt: number + 1,
        maximumAttempts: schedule.attempts,
        remainingAttempts: schedule.attempts - number,
        delay: Duration { seconds: sleepSeconds },
        totalDelay: Duration { seconds: elapsed },
        result: result
      })
      sleeper(Duration { seconds: sleepSeconds })
      let factor = if schedule.backoff < 1.0 then 1.0 else schedule.backoff end
      let nextBase = boundedDelay(schedule, base * factor)
      attempt(schedule, sleeper, random, onRetry, operation, number + 1, nextBase, nextElapsed)
    end
  end
end
