# Bounded retries for operations whose failures can be classified by the
# application.
#
# A retry is never automatically safe just because an error was temporary.
# The caller owns the operation and, where necessary, a predicate that excludes
# permanent failures and non-idempotent work. Policies bound attempts, delay,
# and optionally total sleep so a dependency cannot stall the program forever.
#
#   using Control.Retry
#
#   let policy = Retry.exponential(4, 100.milliseconds, 2.seconds)
#     .withJitter(0.2)
#   Retry.run(policy, ~retryable?) do
#     client.get("https://api.example.com/inventory")
#   end
module Control.Retry

# A bounded retry schedule. Attempts includes the initial call.
# Delays are immutable +Duration+ values and never exceed +maximumDelay+.
record Policy do
  maximumAttempts : Integer
  initialDelay : Duration
  multiplier : Float
  maximumDelay : Duration
  maximumElapsed : Duration? = None
  jitterFraction : Float = 0.0
end

# Decides whether an application error is eligible for another attempt.
type Predicate<E> = E -> Bool

# Performs one scheduled delay. Supplying this callback makes retry tests
# deterministic without sleeping.
type Sleeper = Duration -> Void

# Builds a constant-delay retry policy.
#
# Fixed delays are predictable and useful for a local resource expected to
# become ready shortly. For many clients sharing a remote dependency, prefer
# exponential backoff with jitter to avoid synchronized retry bursts.
#
# @param maximumAttempts [Integer] total calls including the first
# @param delay [Duration] delay before each subsequent call
# @return [Policy] the retry schedule
#
# @example Waiting briefly for a local test server to start
#   let policy = Retry.fixed(5, 50.milliseconds)
fixed : Integer -> Duration -> Policy
let fixed(maximumAttempts, delay) = Policy {
  maximumAttempts: maximumAttempts,
  initialDelay: delay,
  multiplier: 1.0,
  maximumDelay: delay,
  maximumElapsed: None,
  jitterFraction: 0.0
}

# Builds a doubling backoff capped at +maximumDelay+.
#
# The first retry waits +initialDelay+; later delays double until they reach
# the cap. Add jitter for production network traffic.
#
# @param maximumAttempts [Integer] total calls including the first
# @param initialDelay [Duration] delay after the first failure
# @param maximumDelay [Duration] upper bound for each delay
# @return [Policy] the retry schedule
#
# @example Backing off calls to a busy upstream service
#   Retry.exponential(5, 200.milliseconds, 5.seconds).withJitter(0.25)
exponential : Integer -> Duration -> Duration -> Policy
let exponential(maximumAttempts, initialDelay, maximumDelay) = Policy {
  maximumAttempts: maximumAttempts,
  initialDelay: initialDelay,
  multiplier: 2.0,
  maximumDelay: maximumDelay,
  maximumElapsed: None,
  jitterFraction: 0.0
}

make Policy do
  # Returns the same schedule with a bound on total scheduled sleep time.
  #
  # The operation's own execution time is not counted; use operation-specific
  # deadlines for that. A retry whose next delay would exceed this bound is
  # not started.
  #
  # @param maximumElapsed [Duration] maximum cumulative scheduled delay
  # @return [Policy] a copied policy with the elapsed bound
  # @example +Retry.fixed(5, 1.seconds).withMaximumElapsed(2.seconds)+.
  let withMaximumElapsed(maximumElapsed: Duration) -> Policy = Policy {
    maximumAttempts: @maximumAttempts,
    initialDelay: @initialDelay,
    multiplier: @multiplier,
    maximumDelay: @maximumDelay,
    maximumElapsed: Just(maximumElapsed),
    jitterFraction: @jitterFraction
  }

  # Returns the same schedule with symmetric bounded jitter. A fraction of
  # +0.25+ selects each actual delay from 75% through 125% of its scheduled
  # value. Fractions are clamped to +0.0..1.0+.
  #
  # Jitter prevents many workers that failed together from retrying together.
  # It changes delay timing, never the number of attempts or the backoff cap.
  #
  # @param fraction [Float] maximum proportional variation on either side
  # @return [Policy] a copied policy with bounded jitter
  #
  # @example Spreading retries by up to 20 percent
  #   Retry.exponential(4, 1.seconds, 10.seconds).withJitter(0.2)
  let withJitter(fraction: Float) -> Policy = Policy {
    maximumAttempts: @maximumAttempts,
    initialDelay: @initialDelay,
    multiplier: @multiplier,
    maximumDelay: @maximumDelay,
    maximumElapsed: @maximumElapsed,
    jitterFraction: if fraction < 0.0 then 0.0 else if fraction > 1.0 then 1.0 else fraction end end
  }
end

# Runs +operation+ until it succeeds or exhausts the policy.
#
# The last application error is returned unchanged. This helper performs no
# network-specific classification: callers decide what operation to wrap.
#
# @param policy [Policy] the bounded schedule
# @param operation [Block<Result<X,E>>] a fresh attempt
# @return [Result<X,E>] the first success or final failure
#
# @example Retrying an idempotent health check
#   Retry.run(Retry.fixed(3, 250.milliseconds)) do
#     HTTP.get("https://service.example.com/health")
#   end
run : Policy -> Block<Result<X, E>> -> Result<X, E>
foul run(policy, operation) = runWithRandom(policy, { |error| true }, { |delay| Task.sleep(delay) }, { Kex.Intrinsic.Retry.randomUnit() }, operation)

# Runs with an application-specific error predicate.
#
# A false predicate returns that error immediately. The predicate is evaluated
# only when another attempt would otherwise be possible.
#
# @param policy [Policy] the bounded schedule
# @param predicate [Predicate<E>] whether an error may be retried
# @param operation [Block<Result<X,E>>] a fresh attempt
# @return [Result<X,E>] the first success or final/non-retryable failure
#
# @example Retrying timeouts but returning parse failures immediately
#   Retry.run(policy, { |error| error.kind == Timeout }) do
#     client.get(url)
#   end
run : Policy -> Predicate<E> -> Block<Result<X, E>> -> Result<X, E>
foul run(policy, predicate, operation) = runWithRandom(policy, predicate, { |delay| Task.sleep(delay) }, { Kex.Intrinsic.Retry.randomUnit() }, operation)

# Runs with injected error classification and sleeping.
#
# This is the deterministic testing seam: a fake sleeper can record durations
# or advance a virtual clock. Production callers normally use +Retry.run+.
#
# @param policy [Policy] the bounded schedule
# @param predicate [Predicate<E>] whether an error may be retried
# @param sleeper [Sleeper] performs or records each scheduled delay
# @param operation [Block<Result<X,E>>] a fresh attempt
# @return [Result<X,E>] the first success or final failure
runWith : Policy -> Predicate<E> -> Sleeper -> Block<Result<X, E>> -> Result<X, E>
foul runWith(policy, predicate, sleeper, operation) = runWithRandom(policy, predicate, sleeper, { 0.5 }, operation)

# Runs with injected sleeping and a random source returning a value in
# +0.0..1.0+. Out-of-range test values are clamped. Production +run+ uses a
# cryptographically secure backend source; this overload makes jitter specs
# deterministic.
runWithRandom : Policy -> Predicate<E> -> Sleeper -> Block<Float> -> Block<Result<X, E>> -> Result<X, E>
foul runWithRandom(policy, predicate, sleeper, random, operation) = attempt(policy, predicate, sleeper, random, operation, 1, policy.initialDelay, Duration.seconds(0))

foul attempt(policy: Policy, predicate: Predicate<E>, sleeper: Sleeper, random: Block<Float>, operation: Block<Result<X, E>>, number: Integer, delay: Duration, elapsed: Duration) -> Result<X, E> do
  let result = operation()
  return match result do
    Ok(value) => Ok(value)
    Error(error) => do
      if number >= policy.maximumAttempts || !predicate(error)
        return Error(error)
      end
      let sample = random()
      let boundedSample = if sample < 0.0 then 0.0 else if sample > 1.0 then 1.0 else sample end end
      let jittered = Duration { seconds: delay.seconds * (1.0 + ((boundedSample * 2.0 - 1.0) * policy.jitterFraction)) }
      let nextElapsed = Duration { seconds: elapsed.seconds + jittered.seconds }
      let withinElapsed = match policy.maximumElapsed do
        None => true
        Just(maximum) => nextElapsed.seconds <= maximum.seconds
      end
      if !withinElapsed
        return Error(error)
      end
      sleeper(jittered)
      let nextSeconds = delay.seconds * policy.multiplier
      let bounded = if nextSeconds > policy.maximumDelay.seconds then policy.maximumDelay else Duration { seconds: nextSeconds } end
      return attempt(policy, predicate, sleeper, random, operation, number + 1, bounded, nextElapsed)
    end
  end
end

# The imported public namespace: `using Control.Retry` then `Retry.run(...)`.
module Retry do
  # Public imported alias of +Control.Retry.fixed+.
  fixed : Integer -> Duration -> Policy
  let fixed(maximumAttempts, delay) = Control.Retry.fixed(maximumAttempts, delay)

  # Public imported alias of +Control.Retry.exponential+.
  exponential : Integer -> Duration -> Duration -> Policy
  let exponential(maximumAttempts, initialDelay, maximumDelay) = Control.Retry.exponential(maximumAttempts, initialDelay, maximumDelay)

  # Public imported alias of +Control.Retry.run+.
  run : Policy -> Block<Result<X, E>> -> Result<X, E>
  foul run(policy, operation) = Control.Retry.run(policy, operation)

  # Retries only errors accepted by +predicate+.
  run : Policy -> Predicate<E> -> Block<Result<X, E>> -> Result<X, E>
  foul run(policy, predicate, operation) = Control.Retry.run(policy, predicate, operation)

  # Deterministic seam with an injected sleeper, primarily for specifications.
  runWith : Policy -> Predicate<E> -> Sleeper -> Block<Result<X, E>> -> Result<X, E>
  foul runWith(policy, predicate, sleeper, operation) = Control.Retry.runWith(policy, predicate, sleeper, operation)

  # Deterministic seam with injected sleeping and random sampling.
  runWithRandom : Policy -> Predicate<E> -> Sleeper -> Block<Float> -> Block<Result<X, E>> -> Result<X, E>
  foul runWithRandom(policy, predicate, sleeper, random, operation) = Control.Retry.runWithRandom(policy, predicate, sleeper, random, operation)
end
