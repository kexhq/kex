# Comparison: the +Ordering+ a comparison returns, and the +Comparable+ trait
# for types with a total order.
#
# Orderings chain, which is how to compare on several keys without nested
# +if+s:
#
#   a.age.compare(b.age).thenBy { a.score.compare(b.score) }
#
# +Ordering+ is also a +Monoid+ in which the first decisive result wins, so
# orderings combine with +combine+.

# The result of a comparison: +Less+, +Equal+ or +Greater+.
type Ordering = Less | Equal | Greater

# Types that have a total order.
#
# +Number+ (both +Integer+ and +Float+), +String+ and +Measure+ implement it.
# A type that implements +compare+ gets +max+, +min+, +clamp+ and the
# operators +<+, +>+, +<=+ and +>=+.
trait Comparable do
  # Compares this value with +other+, returning +Less+, +Equal+ or +Greater+.
  #
  # +==+ does not use it, since a type can be equatable without being
  # ordered.
  #
  # @param other [This] the value to compare against
  # @return [Ordering] how this value orders against +other+
  #
  # @example
  #   1.compare(2)     # => Less
  #   2.compare(2)     # => Equal
  #   3.compare(2)     # => Greater
  #
  # @example Sorting with an explicit comparison
  #   people.sort { |a, b| a.age.compare(b.age) == Less }
  compare :> This -> Ordering

  # Returns the larger of this value and +other+, or this value when they are
  # equal.
  #
  # +max(3, 7)+ and +3.max(7)+ are the same call.
  #
  # @param other [This] the value to compare against
  # @return [This] the larger of the two
  #
  # @example
  #   max(3, 7)             # => 7
  #   1.5.max(2.5)          # => 2.5
  #   "pear".max("apple")   # => "pear"
  let max(other: This) -> This = this.compare(other) == Less then other else this

  # Returns the smaller of this value and +other+, or this value when they are
  # equal.
  #
  # @param other [This] the value to compare against
  # @return [This] the smaller of the two
  #
  # @example
  #   min(3, 7)             # => 3
  #   "pear".min("apple")   # => "apple"
  let min(other: This) -> This = this.compare(other) == Greater then other else this

  # Returns this value limited to +low+..+high+: +low+ when it is below,
  # +high+ when it is above, and the value itself otherwise.
  #
  # @param low [This] the smallest value allowed
  # @param high [This] the largest value allowed
  # @return [This] the value, clamped into +low+ to +high+
  #
  # @example
  #   15.clamp(0, 10)      # => 10
  #   (-3).clamp(0, 10)    # => 0
  #   0.5.clamp(0.0, 1.0)  # => 0.5
  let clamp(low: This, high: This) -> This = this.max(low).min(high)

  # Returns +true+ when this value orders before +other+.
  #
  # Defined from +compare+, so a record that implements +Comparable+ can use
  # +<+, +>+, +<=+ and +>=+.
  #
  # @param other [This] the value to compare against
  # @return [Bool] whether this value orders before +other+
  #
  # @example A record ordered by one field
  #   record Grade do
  #     level : Integer
  #   end
  #
  #   make Grade, implement: Comparable do
  #     let compare(other: Grade) -> Ordering = @level.compare(other.level)
  #   end
  #
  #   Grade { level: 1 } < Grade { level: 2 }   # => true
  let <(other: This) -> Bool = this.compare(other) == Less

  # Returns +true+ when this value orders after +other+.
  #
  # @param other [This] the value to compare against
  # @return [Bool] whether this value orders after +other+
  let >(other: This) -> Bool = this.compare(other) == Greater

  # Returns +true+ when this value orders before +other+ or equal to it.
  #
  # @param other [This] the value to compare against
  # @return [Bool] whether this value orders before +other+ or with it
  let <=(other: This) -> Bool = this.compare(other) != Greater

  # Returns +true+ when this value orders after +other+ or equal to it.
  #
  # @param other [This] the value to compare against
  # @return [Bool] whether this value orders after +other+ or with it
  let >=(other: This) -> Bool = this.compare(other) != Less
end

# Numbers compare by value, +Integer+ and +Float+ alike.
make Number, implement: Comparable do
  # Compares two numbers by value, also across +Integer+ and +Float+, so
  # +1.compare(1.0)+ is +Equal+.
  #
  # @param other [Number] the number to compare against
  # @return [Ordering] how this number orders against +other+
  #
  # @example
  #   1.compare(2)      # => Less
  #   1.compare(1.0)    # => Equal
  #   2.5.compare(2)    # => Greater
  let compare(other: Number) -> Ordering do
    return Less if this < other
    return Greater if this > other

    return Equal
  end
end

# Strings order character by character, by codepoint.
make String, implement: Comparable do
  # Compares this string with +other+ character by character, by codepoint,
  # the order +<+ and +>+ use.
  #
  # @param other [String] the string to compare against
  # @return [Ordering] how this string orders against +other+
  #
  # @example
  #   "apple".compare("banana")   # => Less
  #   "kex".compare("kex")        # => Equal
  #   "cherry".compare("apple")   # => Greater
  let compare(other: String) -> Ordering do
    return Less if this < other
    return Greater if this > other

    return Equal
  end
end

# +Ordering+ is a +Monoid+ in which the first decisive result wins and
# +Equal+ is the identity, so a comparison on several keys chains:
#
#   a.name.compare(b.name).combine(a.age.compare(b.age))
#
# +combine+ evaluates its argument even when the first comparison already
# decided; +thenBy+ does not.
make Ordering, implement: Monoid do
  # Returns +Equal+, the identity: an undecided comparison lets the next one
  # decide.
  #
  # @return [Ordering] +Equal+
  let identity = Equal

  # Returns the first decisive ordering: this one if it is not +Equal+,
  # otherwise +other+.
  #
  # +other+ is always evaluated, even when this ordering already decides. Use
  # +thenBy+ when the tie-breaker is expensive.
  #
  # @param other [Ordering] the tie-breaking ordering
  # @return [Ordering] the first decisive ordering
  #
  # @example
  #   Equal.combine(Less)     # => Less
  #   Less.combine(Greater)   # => Less
  #
  # @example Sorting by surname, then by first name
  #   a.last.compare(b.last).combine(a.first.compare(b.first))
  let combine(@Equal, other: Ordering) -> Ordering = other
  let combine(@Less, _) -> Ordering = Less
  let combine(@Greater, _) -> Ordering = Greater

  # Returns the opposite ordering: +Less+ becomes +Greater+, +Greater+ becomes
  # +Less+, and +Equal+ stays +Equal+.
  #
  # Use it to turn an ascending comparison into a descending one.
  #
  # @return [Ordering] the reversed ordering
  #
  # @example
  #   Less.reverse      # => Greater
  #   Greater.reverse   # => Less
  #   Equal.reverse     # => Equal
  #
  # @example Sorting newest first
  #   a.created.compare(b.created).reverse
  reverse :> Ordering
  let reverse(@Less) -> Ordering = Greater
  let reverse(@Greater) -> Ordering = Less
  let reverse(@Equal) -> Ordering = Equal

  # Returns this ordering if it is decisive, otherwise the result of calling
  # +tieBreaker+.
  #
  # Unlike +combine+, it runs the block only when this ordering is +Equal+.
  # Prefer it when the tie-breaker is more than a field read.
  #
  # @param tieBreaker [Block<Ordering>] evaluated only on a tie
  # @return [Ordering] the first decisive ordering
  #
  # @example
  #   Equal.thenBy { 2.compare(1) }   # => Greater
  #   Less.thenBy { 2.compare(1) }    # => Less
  #
  # @example Sorting by age, then by an expensive score
  #   a.age.compare(b.age).thenBy { score(a).compare(score(b)) }
  thenBy :> Block<Ordering> -> Ordering
  let thenBy(@Equal, tieBreaker) -> Ordering = tieBreaker()
  let thenBy(@Less, _) -> Ordering = Less
  let thenBy(@Greater, _) -> Ordering = Greater
end
