# An immutable key-value store, written +{key: value}+.
#
# Keys may be of any type and are compared by structural equality. Atom keys
# have the shorthand +{name: "Ada"}+; other keys are written in full, as in
# +{"name": "Ada"}+. Every value in a map has the same type.
#
# Updates return a new map. The +!+ forms, such as +put!+ and +delete!+,
# rebind the variable to the new map; nothing is modified in place.
#
# Entries come back sorted by key, not in insertion order, so +keys+,
# +values+, +entries+ and every traversal give the same order for equal maps.
#
#   let config = { host: "localhost", port: "8080" }
#   config.get(:host).or("0.0.0.0")     # => "localhost"
#   config.get(:user).or("anonymous")   # => "anonymous"
#   config.put(:port, "9090")           # => { host: "localhost", port: "9090" }
#
# Maps implement +Enumerable+ and +Foldable+. The blocks given to +each+,
# +map+, +filter+, +reject+, +find+, +any?+, +all?+, +none?+, +one?+,
# +count+, +collect+ and +into+ take the key and the value as two
# parameters, and +mapIndexed+ adds the index as a third. Only +reduce+
# passes each entry as one +(key, value)+ tuple.
#
#   config.each { |k, v| IO.printLine("${k} = ${v}") }
#   config.filter { |k, v| k != :port }   # => { host: "localhost" }
#   config.collect { |k, v| k == :port then Just(v) else None }   # => ["8080"]
#   config.mapIndexed { |k, v, i| "${i}. ${k}" }   # => ["0. :host", "1. :port"]

# The type of maps from +K+ to +V+, usually written +{K: V}+.
type Map<K, V> = {K: V}

make Map<K, V>, implement: Enumerable<(K, V)>, Foldable<(K, V)>, Monoid do
  # Folds over the map's +(key, value)+ pairs in key order.
  #
  # +Enumerable+ builds +map+, +filter+, +find+, +any?+ and the rest on it.
  # The block receives the accumulator and one pair, which you destructure to
  # get the key and value.
  #
  # @param acc [A] the initial accumulator
  # @param g [A -> (K, V) -> A] combines the accumulator with each pair
  # @return [A] the final accumulator
  #
  # @example Summing the values
  #   { a: 1, b: 2 }.reduce(0) do |acc, pair|
  #     let (key, value) = pair
  #     acc + value
  #   end
  #   # => 3
  #
  # @example Rendering the map as a query string
  #   { "a": 1, "b": 2 }.entries.map { |k, v| "${k}=${v}" }.join("&")   # => "a=1&b=2"
  let reduce(acc: A, g: A -> (K, V) -> A) -> A = this.entries.reduce(acc, g)

  # Returns the empty map, the +Monoid+ identity: +m.combine({})+ is +m+.
  #
  # @return [Map<K, V>] the empty map
  #
  # @example
  #   { a: 1 }.identity   # => {}
  let identity -> This = {}

  # Merges two maps, keeping +other+'s value when both have a key. This is
  # the +Monoid+ operation, and does the same as +merge+.
  #
  # @param other [This] the map to merge in
  # @return [This] the combined map
  #
  # @example
  #   { a: 1 }.combine({ b: 2 })   # => { a: 1, b: 2 }
  #
  # @example Folding a list of maps into one
  #   [{ a: 1 }, { b: 2 }, { a: 9 }].reduce({}) { |acc, m| acc.combine(m) }
  #   # => { a: 9, b: 2 }
  let combine(other: This) -> This = this.merge(other)

  # Returns the value stored under +key+, or +None+ when the key is absent.
  #
  # When there is a sensible fallback, +get(key, default)+ returns the value
  # unwrapped.
  #
  # @param key [K] the key to look up
  # @return [V?] the value, or +None+
  #
  # @example
  #   let user = { name: "Alice", age: 32 }
  #   user.get(:name)      # => Just("Alice")
  #   user.get(:missing)   # => None
  #
  # @example Chaining through a nested map
  #   settings.get(:server).into { |s| s.get(:port) }.or(8080)
  get :> K -> V?
  let get(key) = Kex.Intrinsic.Map.get(this, key)

  # Returns the value stored under +key+, or +default+ when the key is absent.
  #
  # @param key [K] the key to look up
  # @param default [V] the value to use when the key is missing
  # @return [V] the stored value, or +default+
  #
  # @example
  #   let user = { name: "Alice" }
  #   user.get(:name, "anonymous")      # => "Alice"
  #   user.get(:nickname, "anonymous")  # => "anonymous"
  #
  # @example Counting occurrences
  #   words.reduce({}) { |counts, w| counts.put(w, counts.get(w, 0) + 1) }
  get :> K -> V -> V
  let get(key, default) = Kex.Intrinsic.Map.getWithDefault(this, key, default)

  # Returns a new map with +k+ mapped to +v+, replacing any previous entry for
  # that key.
  #
  # The original map is unchanged. +put!+ rebinds the variable holding the
  # map to the result.
  #
  # @param k [K] the key to set
  # @param v [V] the value to store
  # @return [Map<K, V>] a new map including the entry
  #
  # @example
  #   {}.put(:x, 1)              # => { x: 1 }
  #   { x: 1 }.put(:x, 2)        # => { x: 2 }
  #
  # @example Rebinding with the +!+ form
  #   var totals = {}
  #   totals.put!(:visits, 1)
  #   totals                     # => { visits: 1 }
  put :> K -> V -> Map<K, V>
  let put(k, v) = Kex.Intrinsic.Map.put(this, k, v)

  # Returns a new map without +key+, or the same map when +key+ is not
  # present. +delete!+ rebinds the variable instead.
  #
  # @param key [K] the key to remove
  # @return [Map<K, V>] a new map without that entry
  #
  # @example
  #   { a: 1, b: 2 }.delete(:a)   # => { b: 2 }
  #   { a: 1 }.delete(:z)         # => { a: 1 }
  #
  # @example Stripping a secret before logging
  #   IO.printLine(params.delete(:password))
  delete :> K -> Map<K, V>
  let delete(key) = Kex.Intrinsic.Map.delete(this, key)

  # Returns +true+ when +key+ has an entry in the map.
  #
  # Unlike +get+ with a default, it tells a missing key apart from a key whose
  # value happens to equal the default.
  #
  # @param key [K] the key to test
  # @return [Bool] +true+ when the key is present
  #
  # @example
  #   { a: 1 }.has?(:a)   # => true
  #   { a: 1 }.has?(:z)   # => false
  #
  # @example Checking a required setting
  #   if !config.has?(:host)
  #     IO.printError("host is required")
  #   end
  has? :> K -> Bool
  let has?(key) = Kex.Intrinsic.Map.has?(this, key)

  # Returns +true+ when the map has no entries.
  #
  # @return [Bool] +true+ for the empty map
  #
  # @example
  #   {}.empty?         # => true
  #   { a: 1 }.empty?   # => false
  empty? :> Bool
  let empty? = Kex.Intrinsic.Map.count(this) == 0

  # Returns the number of entries.
  #
  # @return [Integer] the entry count
  #
  # @example
  #   { a: 1, b: 2 }.count   # => 2
  #   {}.count               # => 0
  count :> Integer
  let count = Kex.Intrinsic.Map.count(this)

  # Returns the number of entries satisfying +pred+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Integer] how many entries matched
  #
  # @example
  #   { a: 1, b: 2 }.count { |k, v| v > 1 }   # => 1
  #
  # @example How many settings are still at their default
  #   config.count { |k, v| v == defaults.get(k, v) }
  count :> (K -> V -> Bool) -> Integer
  let count(pred) = this.matching(pred).count

  # Returns the map's keys as a sorted list.
  #
  # @return [[K]] the keys
  #
  # @example
  #   { b: 1, a: 2 }.keys   # => [:a, :b]
  #
  # @example Reporting unrecognised options
  #   params.keys.reject { |k| known.contains?(k) }
  keys :> [K]
  let keys = Kex.Intrinsic.Map.keys(this)

  # Returns the map's values as a list, ordered by their keys.
  #
  # @return [[V]] the values
  #
  # @example
  #   { a: 1, b: 2 }.values       # => [1, 2]
  #   { a: 1, b: 2 }.values.sum   # => 3
  values :> [V]
  let values = Kex.Intrinsic.Map.values(this)

  # Returns the map's entries as a list of +(key, value)+ tuples, in key
  # order.
  #
  # Use it to reach the +List+ functions that maps do not have, such as
  # +sort+.
  #
  # @return [[(K, V)]] the entries
  #
  # @example
  #   { a: 1, b: 2 }.entries   # => [(:a, 1), (:b, 2)]
  #
  # @example Sorting entries by value
  #   scores.entries.sort { |x, y| x.items.last.or(0) > y.items.last.or(0) }
  entries :> [(K, V)]
  let entries = Kex.Intrinsic.Map.entries(this)

  # Calls +f+ with each key and value, for its side effects.
  #
  # @param f [K -> V -> Void] called once per entry
  # @return [Void]
  #
  # @example
  #   scores.each { |k, v| IO.printLine("${k}: ${v}") }
  each :> (K -> V -> Void) -> Void
  let each(f) = this.entries.each(f)

  # Applies +f+ to each key and value and returns the results as a list.
  #
  # The result is a list, not a map, since +f+ may return anything. To get a
  # map back, use +mapValues+ or +mapKeys+.
  #
  # @param f [K -> V -> R] applied to each entry
  # @return [[R]] the results, in key order
  #
  # @example
  #   { "a": 1, "b": 2 }.map { |k, v| "${k}=${v}" }   # => ["a=1", "b=2"]
  #
  # @example Building a header block
  #   headers.map { |name, value| "${name}: ${value}" }.join("\n")
  map :> (K -> V -> R) -> [R]

  # Returns a new map with every value replaced by +f(value)+. The keys are
  # left alone.
  #
  # @param f [V -> W] applied to each value
  # @return [Map<K, W>] a map with the same keys and transformed values
  #
  # @example
  #   { a: 1, b: 2 }.mapValues { |v| v * 10 }   # => { a: 10, b: 20 }
  #
  # @example Normalising values read as text
  #   raw.mapValues { |s| s.trim.lowerCase }
  mapValues :> (V -> W) -> Map<K, W>
  let mapValues(f) do
    let pairs = this.entries.map { |k, v| (k, f(v)) }
    return Kex.Intrinsic.Map.fromEntries(pairs)
  end

  # Returns a new map with every key replaced by +f(key)+. The values are left
  # alone.
  #
  # If +f+ maps two keys to the same result, the entry whose original key
  # sorts last wins.
  #
  # @param f [K -> J] applied to each key
  # @return [Map<J, V>] a map with transformed keys
  #
  # @example
  #   { "a": 1, "b": 2 }.mapKeys { |k| k.upperCase }   # => { "A": 1, "B": 2 }
  #   { "a": 1, "b": 2 }.mapKeys { |k| "x" }           # => { "x": 2 }
  #
  # @example Making header lookups case-insensitive
  #   headers.mapKeys { |name| name.lowerCase }
  mapKeys :> (K -> J) -> Map<J, V>
  let mapKeys(f) do
    let pairs = this.entries.map { |k, v| (f(k), v) }
    return Kex.Intrinsic.Map.fromEntries(pairs)
  end

  # Returns a map of the entries for which +pred+ returns +true+. Unlike
  # +map+, it returns a map.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Map<K, V>] the matching entries
  #
  # @example
  #   { a: 1, b: 2, c: 3 }.filter { |k, v| v > 1 }   # => { b: 2, c: 3 }
  #
  # @example Keeping only the options that were set
  #   options.filter { |name, value| !value.blank? }
  filter :> (K -> V -> Bool) -> Map<K, V>
  let filter(pred) do
    let kept = this.entries.filter { |pair| Kex.Intrinsic.Fun.applyItem(pred, pair) }
    return Kex.Intrinsic.Map.fromEntries(kept)
  end

  # Returns a map of the entries for which +pred+ returns +false+, the
  # opposite of +filter+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Map<K, V>] the entries that failed the predicate
  #
  # @example
  #   { a: 1, b: 2, c: 3 }.reject { |k, v| v > 1 }   # => { a: 1 }
  #
  # @example Dropping internal keys before serialising
  #   record.reject { |name, _| name.startsWith?("_") }
  reject :> (K -> V -> Bool) -> Map<K, V>
  let reject(pred) do
    let kept = this.entries.reject { |pair| Kex.Intrinsic.Fun.applyItem(pred, pair) }
    return Kex.Intrinsic.Map.fromEntries(kept)
  end

  # Returns a new map holding the entries of both. When a key appears in both,
  # +other+'s value wins, which makes it the way to lay overrides on top of
  # defaults.
  #
  # @param other [Map<K, V>] the map whose values take precedence
  # @return [Map<K, V>] the combined map
  #
  # @example
  #   { a: 1, b: 2 }.merge({ b: 99, c: 3 })   # => { a: 1, b: 99, c: 3 }
  #
  # @example Layering user settings over defaults
  #   defaults.merge(userConfig)
  merge :> Map<K, V> -> Map<K, V>
  let merge(other) = Kex.Intrinsic.Map.merge(this, other)

  # Replaces the value under +key+ with +f+ applied to it. A missing key stays
  # missing; to start from a value, pass a default as the second argument.
  #
  # @param key [K] the key to update
  # @param f [V -> V] computes the new value from the old
  # @return [Map<K, V>] the map with that one value replaced
  #
  # @example
  #   { "a": 1 }.update("a") { |n| n + 1 }   # => { "a": 2 }
  #   { "a": 1 }.update("b") { |n| n + 1 }   # => { "a": 1 }
  update :> K -> (V -> V) -> Map<K, V>
  let update(key, f) do
    match this.get(key) do
      Just(value) => this.put(key, f(value))
      None => this
    end
  end

  # Replaces the value under +key+ with +f+ applied to it, applying +f+ to
  # +default+ when the key is missing.
  #
  # @param key [K] the key to update
  # @param default [V] the value +f+ starts from when +key+ is missing
  # @param f [V -> V] computes the new value from the old
  # @return [Map<K, V>] the map with that value set
  #
  # @example Counting words
  #   words.reduce({}) { |acc, w| acc.update(w, 0) { |n| n + 1 } }
  update :> K -> V -> (V -> V) -> Map<K, V>
  let update(key, default, f) = this.put(key, f(this.get(key, default)))

  # Returns +true+ when at least one entry satisfies +pred+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when any entry matches
  #
  # @example
  #   { a: 1, b: 2 }.any? { |k, v| v > 1 }   # => true
  #   { a: 1, b: 2 }.any? { |k, v| v > 9 }   # => false
  any? :> (K -> V -> Bool) -> Bool
  let any?(pred) = !this.matching(pred).empty?

  # Returns +true+ when every entry satisfies +pred+, and +true+ for the empty
  # map.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when all entries match
  #
  # @example
  #   { a: 1, b: 2 }.all? { |k, v| v > 0 }   # => true
  #   { a: 1, b: 2 }.all? { |k, v| v > 1 }   # => false
  #
  # @example Validating a form
  #   fields.all? { |name, value| !value.blank? }
  all? :> (K -> V -> Bool) -> Bool
  let all?(pred) = this.matching(pred).count == this.count

  # Returns the first entry, in key order, that satisfies +pred+ as a
  # +(key, value)+ tuple, or +None+ when nothing matches.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [(K, V)?] the matching entry, or +None+
  #
  # @example
  #   { a: 1, b: 2 }.find { |k, v| v > 1 }   # => Just((:b, 2))
  #   { a: 1, b: 2 }.find { |k, v| v > 9 }   # => None
  #
  # @example Locating a value without knowing its key
  #   users.find { |id, user| user.email == target }
  find :> (K -> V -> Bool) -> (K, V)?
  let find(pred) = this.matching(pred).first

  # Returns +true+ when no entry satisfies +pred+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when nothing matches
  #
  # @example
  #   { a: 1, b: 2 }.none? { |k, v| v > 5 }   # => true
  none? :> (K -> V -> Bool) -> Bool
  let none?(pred) = this.matching(pred).empty?

  # Returns +true+ when exactly one entry satisfies +pred+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when one entry matches
  #
  # @example
  #   { a: 1, b: 2 }.one? { |k, v| v > 1 }   # => true
  one? :> (K -> V -> Bool) -> Bool
  let one?(pred) = this.matching(pred).count == 1

  private do
    # The entries +pred+ holds for, as (key, value) pairs.
    let matching(pred: K -> V -> Bool) -> [(K, V)] do
      return this.entries.filter do |entry|
        match entry do
          (k, v) => pred(k, v)
        end
      end
    end
  end
end

make Map<K,V>, implement: Blankable do
  # Returns +true+ when the map has no entries. It is +empty?+ under the
  # +Blankable+ name, so generic code can test maps as it tests strings and
  # lists.
  #
  # @return [Bool] +true+ for the empty map
  #
  # @example
  #   {}.blank?         # => true
  #   { a: 1 }.blank?   # => false
  blank? :> Bool
  let blank? = this.entries.empty?
end

module Map do
  # Builds a map from +(key, value)+ pairs. A key that appears more than once
  # keeps its last value. Ruby calls this +to_h+.
  #
  # @param entries [[(K, V)]] the pairs
  # @return [Map<K, V>] the map
  #
  # @example
  #   Map.from([("a", 1), ("b", 2)])   # => { "a": 1, "b": 2 }
  #   Map.from(m.entries) == m         # => true
  from : [(K, V)] -> Map<K, V>
  let from(entries) do
    entries.reduce({}) do |acc, entry|
      let (key, value) = entry
      acc.put(key, value)
    end
  end
end
