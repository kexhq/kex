# An immutable key-value store, written +{key: value}+.
#
# Keys are compared by structural equality and may be of any type; atom keys
# get the shorthand +{name: "Ada"}+, string keys are written out in full as
# +{"name": "Ada"}+. Every method answers with a new map — the +!+ forms
# (+put!+, +delete!+) build a new map and rebind the receiver variable, they
# do not modify anything in place.
#
# Entries come back in canonical key order, not insertion order, so +keys+,
# +values+, +entries+ and any traversal are stable and comparable across
# equal maps.
#
#   let config = { host: "localhost", port: 8080 }
#   config.get(:host).or("0.0.0.0")     # => "localhost"
#   config.get(:user).or("anonymous")   # => "anonymous"
#   config.put(:port, 9090)             # => { :host: "localhost", :port: 9090 }
#
# A map is +Enumerable+ and +Foldable+, and the traversal blocks take the key
# and value as two parameters:
#
#   config.each { |k, v| IO.printLine("${k} = ${v}") }
#   config.filter { |k, v| k != :port }   # => { :host: "localhost" }

# Declared for the same reason list.kex declares `type List<X> = [X]`: it
# gives the name `Map` a source declaration, so it resolves as a type through
# the collected interfaces rather than needing to be known to the compiler.
type Map<K, V> = {K: V}

make Map<K, V>, implement: Enumerable, Foldable, Monoid do
  # Folds over the map's +(key, value)+ pairs in canonical key order.
  #
  # This is +Map+'s +Enumerable+ primitive: +map+, +filter+, +find+, +any?+
  # and the rest are built on it. The block receives the accumulator and one
  # pair; destructure the pair to name its halves.
  #
  # @param acc [A] the initial accumulator
  # @param g [A -> (K, V) -> A] combines the accumulator with each pair
  # @return [A] the final accumulator
  #
  # @example Summing the values
  #   { a: 1, b: 2 }.reduce(0) do |acc, pair|
  #     let (key, value) = pair
  #     acc + value
  #   end
  #   # => 3
  #
  # @example Rendering the map as a query string
  #   { a: 1, b: 2 }.entries.map { |k, v| "${k}=${v}" }.join("&")
  let reduce(acc, g) = this.entries.reduce(acc, g)

  # The empty map — the identity element of the +Monoid+ instance, so
  # +m.combine({})+ is +m+.
  #
  # @return [Map<K, V>] the empty map
  #
  # @example
  #   Map.identity   # => {}
  let identity = {}

  # Combines two maps by merging them, with +other+'s values winning on a key
  # conflict. The +Monoid+ operation, and the same thing +merge+ does.
  #
  # @param other [This] the map to merge in
  # @return [This] the combined map
  #
  # @example
  #   { a: 1 }.combine({ b: 2 })   # => { :a: 1, :b: 2 }
  #
  # @example Folding a list of maps into one
  #   [{ a: 1 }, { b: 2 }, { a: 9 }].reduce({}) { |acc, m| acc.combine(m) }
  #   # => { :a: 9, :b: 2 }
  let combine(other: This) -> This = this.merge(other)

  # Returns the value stored under +key+, or +None+ when the key is absent.
  #
  # Missing keys are an ordinary answer rather than a failure, so a lookup on
  # data you did not produce is safe by default. Use the two-argument form
  # below when you have a sensible fallback.
  #
  # @param key [K] the key to look up
  # @return [V?] the value, or +None+
  #
  # @example
  #   let user = { name: "Alice", age: 32 }
  #   user.get(:name)      # => Just("Alice")
  #   user.get(:missing)   # => None
  #
  # @example Chaining through a nested map
  #   settings.get(:server).flatMap { |s| s.get(:port) }.or(8080)
  get :> K -> V?
  let get(key) = Kex.Intrinsic.Map.get(this, key)

  # Returns the value stored under +key+, or +default+ when the key is absent.
  #
  # The total form of +get+: the value comes back unwrapped, so nothing
  # downstream has to deal with an +Optional+.
  #
  # @param key [K] the key to look up
  # @param default [V] the value to use when the key is missing
  # @return [V] the stored value, or +default+
  #
  # @example
  #   let user = { name: "Alice" }
  #   user.get(:name, "anonymous")      # => "Alice"
  #   user.get(:nickname, "anonymous")  # => "anonymous"
  #
  # @example Counting occurrences
  #   words.reduce({}) { |counts, w| counts.put(w, counts.get(w, 0) + 1) }
  get :> K -> V -> V
  let get(key, default) = Kex.Intrinsic.Map.getWithDefault(this, key, default)

  # Returns a new map with +key+ mapped to +value+, replacing any previous
  # entry for that key.
  #
  # The receiver is untouched. Use +put!+ when you want the variable holding
  # the map to be rebound to the result.
  #
  # @param k [K] the key to set
  # @param v [V] the value to store
  # @return [Map<K, V>] a new map including the entry
  #
  # @example
  #   {}.put(:x, 1)              # => { :x: 1 }
  #   { x: 1 }.put(:x, 2)        # => { :x: 2 }
  #
  # @example Rebinding with the +!+ form
  #   var totals = {}
  #   totals.put!(:visits, 1)
  #   totals                     # => { :visits: 1 }
  put :> K -> V -> Map<K, V>
  let put(k, v) = Kex.Intrinsic.Map.put(this, k, v)

  # Returns a new map without +key+. A key that is not present is not an
  # error — the map comes back unchanged.
  #
  # Use +delete!+ to rebind the receiver variable.
  #
  # @param key [K] the key to remove
  # @return [Map<K, V>] a new map without that entry
  #
  # @example
  #   { a: 1, b: 2 }.delete(:a)   # => { :b: 2 }
  #   { a: 1 }.delete(:z)         # => { :a: 1 }
  #
  # @example Stripping a secret before logging
  #   IO.printLine(params.delete(:password))
  delete :> K -> Map<K, V>
  let delete(key) = Kex.Intrinsic.Map.delete(this, key)

  # Returns +true+ when +key+ has an entry in the map.
  #
  # Distinguishes a missing key from one whose value is itself empty, which a
  # +get+ with a default cannot.
  #
  # @param key [K] the key to test
  # @return [Bool] +true+ when the key is present
  #
  # @example
  #   { a: 1 }.has?(:a)   # => true
  #   { a: 1 }.has?(:z)   # => false
  #
  # @example Checking a required setting
  #   if !config.has?(:host)
  #     IO.printError("host is required")
  #   end
  has? :> K -> Bool
  let has?(key) = Kex.Intrinsic.Map.has?(this, key)

  # Returns +true+ when the map has no entries.
  #
  # @return [Bool] +true+ for the empty map
  #
  # @example
  #   {}.empty?         # => true
  #   { a: 1 }.empty?   # => false
  empty? :> Bool
  let empty? = Kex.Intrinsic.Map.count(this) == 0

  # Returns the number of entries.
  #
  # @return [Integer] the entry count
  #
  # @example
  #   { a: 1, b: 2 }.count   # => 2
  #   {}.count               # => 0
  count :> Integer
  let count = Kex.Intrinsic.Map.count(this)

  # Returns the number of entries satisfying +pred+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Integer] how many entries matched
  #
  # @example
  #   { a: 1, b: 2 }.count { |k, v| v > 1 }   # => 1
  #
  # @example How many settings are still at their default
  #   config.count { |k, v| v == defaults.get(k, v) }
  count :> (K -> V -> Bool) -> Integer

  # Returns the map's keys as a list, in canonical key order.
  #
  # @return [[K]] the keys
  #
  # @example
  #   { b: 1, a: 2 }.keys   # => [:a, :b]
  #
  # @example Reporting unrecognised options
  #   params.keys.reject { |k| known.contains?(k) }
  keys :> [K]
  let keys = Kex.Intrinsic.Map.keys(this)

  # Returns the map's values as a list, ordered by their keys.
  #
  # @return [[V]] the values
  #
  # @example
  #   { a: 1, b: 2 }.values       # => [1, 2]
  #   { a: 1, b: 2 }.values.sum   # => 3
  values :> [V]
  let values = Kex.Intrinsic.Map.values(this)

  # Returns the map's entries as a list of +(key, value)+ tuples, in canonical
  # key order.
  #
  # This is the bridge to the +List+ methods a map does not have of its own,
  # and the form the two-parameter blocks elsewhere are splatting from.
  #
  # @return [[(K, V)]] the entries
  #
  # @example
  #   { a: 1, b: 2 }.entries   # => [(:a, 1), (:b, 2)]
  #
  # @example Sorting entries by value
  #   scores.entries.sort { |x, y| x.items.last.or(0) > y.items.last.or(0) }
  entries :> [(K, V)]
  let entries = Kex.Intrinsic.Map.entries(this)

  # Calls +f+ with each key and value, for its side effects.
  #
  # @param f [K -> V -> Void] called once per entry
  # @return [Void]
  #
  # @example
  #   scores.each { |k, v| IO.printLine("${k}: ${v}") }
  each :> (K -> V -> Void) -> Void

  # Applies +f+ to each key and value and collects the results into a LIST.
  #
  # Note the return type: +map+ comes from +Enumerable+, whose contract is to
  # produce a list, because +f+ may return anything at all. Use +mapValues+ or
  # +mapKeys+ when you want a map back.
  #
  # @param f [K -> V -> R] applied to each entry
  # @return [[R]] the results, in canonical key order
  #
  # @example
  #   { "a": 1, "b": 2 }.map { |k, v| "${k}=${v}" }   # => ["a=1", "b=2"]
  #
  # @example Building a header block
  #   headers.map { |name, value| "${name}: ${value}" }.join("\n")
  map :> (K -> V -> R) -> [R]

  # Returns a new map with every value replaced by +f(value)+. The keys are
  # left alone.
  #
  # @param f [V -> W] applied to each value
  # @return [Map<K, W>] a map with the same keys and transformed values
  #
  # @example
  #   { a: 1, b: 2 }.mapValues { |v| v * 10 }   # => { :a: 10, :b: 20 }
  #
  # @example Normalising values read as text
  #   raw.mapValues { |s| s.trim.lowerCase }
  mapValues :> (V -> W) -> Map<K, W>
  let mapValues(f) do
    let pairs = this.entries.map { |k, v| (k, f(v)) }
    return Kex.Intrinsic.Map.fromEntries(pairs)
  end

  # Returns a new map with every key replaced by +f(key)+. The values are left
  # alone.
  #
  # If +f+ maps two keys onto the same result, one entry wins — the map cannot
  # hold both.
  #
  # @param f [K -> J] applied to each key
  # @return [Map<J, V>] a map with transformed keys
  #
  # @example
  #   { "a": 1, "b": 2 }.mapKeys { |k| k.upperCase }   # => { A: 1, B: 2 }
  #
  # @example Making header lookups case-insensitive
  #   headers.mapKeys { |name| name.lowerCase }
  mapKeys :> (K -> J) -> Map<J, V>
  let mapKeys(f) do
    let pairs = this.entries.map { |k, v| (f(k), v) }
    return Kex.Intrinsic.Map.fromEntries(pairs)
  end

  # Returns a new map with only the entries for which +pred+ answers +true+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Map<K, V>] the matching entries
  #
  # @example
  #   { a: 1, b: 2, c: 3 }.filter { |k, v| v > 1 }   # => { :b: 2, :c: 3 }
  #
  # @example Keeping only the options that were actually set
  #   options.filter { |name, value| !value.blank? }
  # Map overrides the map-returning HOFs (Enumerable's default returns a list).
  filter :> (K -> V -> Bool) -> Map<K, V>
  let filter(pred) do
    let kept = this.entries.filter { |pair| Kex.Intrinsic.Fun.applyItem(pred, pair) }
    return Kex.Intrinsic.Map.fromEntries(kept)
  end

  # Returns a new map with the entries for which +pred+ answers +true+
  # removed. The complement of +filter+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Map<K, V>] the entries that failed the predicate
  #
  # @example
  #   { a: 1, b: 2, c: 3 }.reject { |k, v| v > 1 }   # => { :a: 1 }
  #
  # @example Dropping internal keys before serialising
  #   record.reject { |name, _| name.startsWith?("_") }
  reject :> (K -> V -> Bool) -> Map<K, V>
  let reject(pred) do
    let kept = this.entries.reject { |pair| Kex.Intrinsic.Fun.applyItem(pred, pair) }
    return Kex.Intrinsic.Map.fromEntries(kept)
  end

  # Returns a new map holding the entries of both. When a key appears in both,
  # +other+'s value wins.
  #
  # The right-biased rule is what makes this the natural way to apply
  # overrides on top of defaults.
  #
  # @param other [Map<K, V>] the map whose values take precedence
  # @return [Map<K, V>] the combined map
  #
  # @example
  #   { a: 1, b: 2 }.merge({ b: 99, c: 3 })   # => { :a: 1, :b: 99, :c: 3 }
  #
  # @example Layering user settings over defaults
  #   defaults.merge(userConfig)
  merge :> Map<K, V> -> Map<K, V>
  let merge(other) = Kex.Intrinsic.Map.merge(this, other)

  # Returns +true+ when at least one entry satisfies +pred+. Stops at the
  # first match.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when any entry matches
  #
  # @example
  #   { a: 1, b: 2 }.any? { |k, v| v > 1 }   # => true
  #   { a: 1, b: 2 }.any? { |k, v| v > 9 }   # => false
  any? :> (K -> V -> Bool) -> Bool

  # Returns +true+ when every entry satisfies +pred+. The empty map answers
  # +true+.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [Bool] +true+ when all entries match
  #
  # @example
  #   { a: 1, b: 2 }.all? { |k, v| v > 0 }   # => true
  #   { a: 1, b: 2 }.all? { |k, v| v > 1 }   # => false
  #
  # @example Validating a form
  #   fields.all? { |name, value| !value.blank? }
  all? :> (K -> V -> Bool) -> Bool

  # Returns the first entry satisfying +pred+ as a +(key, value)+ tuple, or
  # +None+ when nothing matches.
  #
  # "First" means first in canonical key order.
  #
  # @param pred [K -> V -> Bool] the test applied to each entry
  # @return [(K, V)?] the matching entry, or +None+
  #
  # @example
  #   { a: 1, b: 2 }.find { |k, v| v > 1 }   # => Just((:b, 2))
  #   { a: 1, b: 2 }.find { |k, v| v > 9 }   # => None
  #
  # @example Locating a value without knowing its key
  #   users.find { |id, user| user.email == target }
  find :> (K -> V -> Bool) -> (K, V)?
end

make Map<K,V>, implement: Blankable do
  # Returns +true+ when the map has no entries. The +Blankable+ view of
  # +empty?+, so a map can be tested by the same generic code that tests
  # strings and lists.
  #
  # @return [Bool] +true+ for the empty map
  #
  # @example
  #   {}.blank?         # => true
  #   { a: 1 }.blank?   # => false
  blank? :> Bool
  let blank? = this.entries.empty?
end
