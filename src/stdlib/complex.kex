module Complex

# Complex numbers: one value, readable in rectangular or polar terms.
#
# A +Complex+ is a point in the plane. Its rectangular view is the real and
# imaginary parts, +re+ and +im+; its polar view is the distance from the
# origin and the angle, +abs+ and +arg+. They are two ways of reading the same
# number, not two kinds of number, so either view is available on every
# value and either can build one. Components accept +Number+ values; angles
# are in radians.
#
#   using Complex
#
#   let z = Complex.of(3, 4)
#   z.abs            # => 5.0
#   z.polar          # => (5.0, 0.9272952180016122)
#   Complex.fromPolar(2, Math.PI / 2).im   # approximately 2.0

# A complex number, stored by its real part +re+ and imaginary part +im+.
#
# Write one literally as +Complex { re: 3, im: 4 }+, or with +Complex.of+ and
# +Complex.fromPolar+.
record Complex do
  # The real part.
  re : Number

  # The imaginary part.
  im : Number
end

# The additive identity, +0+0i+.
let ZERO = Complex { re: 0, im: 0 }
# The multiplicative identity, +1+0i+.
let ONE = Complex { re: 1, im: 0 }
# The imaginary unit, +0+1i+.
let I = Complex { re: 0, im: 1 }
# The negative imaginary unit, +0-1i+.
let NEG_I = Complex { re: 0, im: -1 }

# Builds a complex number from its rectangular parts.
#
# @param re [Number] the real part
# @param im [Number] the imaginary part
# @return [Complex] +re + im·i+
#
# @example
#   Complex.of(3, 4).showValue   # => "3+4i"
let of(re: Number, im: Number) -> Complex = Complex { re: re, im: im }

# Builds a complex number from its polar parts: a distance from the origin and
# an angle in radians.
#
# @param radius [Number] distance from the origin
# @param theta [Number] angle in radians
# @return [Complex] the same number, held by its rectangular parts
#
# @example A quarter turn
#   Complex.fromPolar(2, Math.PI / 2).im   # approximately 2.0
#
# @example A polar round trip
#   let (r, t) = z.polar
#   Complex.fromPolar(r, t)   # z, up to rounding
let fromPolar(radius: Number, theta: Number) -> Complex do
  return Complex {
    re: radius * Math.cos(theta),
    im: radius * Math.sin(theta)
  }
end

make Complex, implement: Showable do
  # Renders the number in rectangular form, such as +3+4i+.
  #
  # @return [String] the real and signed imaginary components
  #
  # @example
  #   Complex.of(3, -4).showValue   # => "3-4i"
  let showValue -> String do
    return @im < 0 then "${@re}${@im}i" else "${@re}+${@im}i"
  end

  # The rectangular view: the real and imaginary parts.
  #
  # @return [(Number, Number)] +(re, im)+
  #
  # @example
  #   Complex.of(3, 4).rectangular   # => (3, 4)
  let rectangular -> (Number, Number) = (@re, @im)

  # The polar view: the distance from the origin and the angle in radians.
  #
  # @return [(Float, Float)] +(abs, arg)+
  #
  # @example
  #   Complex.of(3, 4).polar   # => (5.0, 0.9272952180016122)
  let polar -> (Float, Float) = (this.abs, this.arg)

  # The magnitude: the distance from the origin, the polar radius.
  #
  # @return [Float] the distance from the origin
  #
  # @example
  #   Complex.of(3, 4).abs   # => 5.0
  let abs -> Float = Math.hypot(@re, @im)

  # The square of the magnitude, which needs no square root and so stays an
  # +Integer+ for integer parts.
  #
  # @return [Number] +re² + im²+
  #
  # @example
  #   Complex.of(3, 4).absSquared   # => 25
  let absSquared -> Number = @re * @re + @im * @im

  # The argument: the angle from the positive real axis, the polar angle, in
  # the range +Math.atan2+ answers.
  #
  # @return [Float] the angle in radians
  #
  # @example
  #   Complex.I.arg   # => 1.5707963267948966
  let arg -> Float = Math.atan2(@im, @re)

  # Adds two complex numbers component by component.
  #
  # @example
  #   (Complex.of(1, 2) + Complex.I).im   # => 3
  let +(other: Complex) -> Complex do
    return New {
      re: @re + other.re,
      im: @im + other.im
    }
  end

  # Subtracts +other+ from this complex number.
  #
  # @example
  #   (Complex.of(1, 2) - Complex.I).im   # => 1
  let -(other: Complex) -> Complex do
    return New {
      re: @re - other.re,
      im: @im - other.im
    }
  end

  # Multiplies two complex numbers.
  #
  # @example
  #   (Complex.I * Complex.I).re   # => -1
  let *(other: Complex) -> Complex do
    return New {
      re: @re * other.re - @im * other.im,
      im: @re * other.im + @im * other.re
    }
  end

  # Divides by +other+ using the complex conjugate formula. The divisor must
  # be non-zero.
  #
  # @example
  #   (Complex.I / Complex.I).re   # => 1.0
  let /(other: Complex) -> Complex do
    let d = (other.re * other.re + other.im * other.im) * 1.0

    return New {
      re: (@re * other.re + @im * other.im) / d,
      im: (@im * other.re - @re * other.im) / d
    }
  end

  # Adds a real number to the real component.
  #
  # @example
  #   (Complex.I + 2).re   # => 2
  let +(other: Number) -> Complex = New { re: @re + other }

  # Subtracts a real number from the real component.
  #
  # @example
  #   (Complex.I - 2).re   # => -2
  let -(other: Number) -> Complex = New { re: @re - other }

  # Multiplies both components by a real number.
  #
  # @example
  #   (Complex.I * 2).im   # => 2
  let *(other: Number) -> Complex = New { re: @re * other, im: @im * other }

  # Divides both components by a non-zero real number.
  #
  # @example
  #   (Complex.I / 2).im   # => 0.5
  let /(other: Number) -> Complex do
    let divisor = other * 1.0
    return New { re: @re / divisor, im: @im / divisor }
  end

  # Returns the complex conjugate, negating the imaginary part.
  #
  # @example
  #   Complex.I.conjugate.im   # => -1
  let conjugate -> Complex = New { im: -@im }

  # Returns the principal square root. The result's argument lies in the
  # right half-plane.
  #
  # @example
  #   Complex.of(-1, 0).sqrt.im   # approximately 1.0
  let sqrt -> Complex = Complex.fromPolar(Math.sqrt(this.abs), this.arg / 2.0)

  # Returns e raised to this complex number.
  #
  # @example
  #   Complex.ZERO.exp.re   # => 1.0
  let exp -> Complex do
    let magnitude = Math.exp(@re)
    return New { re: magnitude * Math.cos(@im), im: magnitude * Math.sin(@im) }
  end

  # Returns the principal natural logarithm. Zero has no logarithm.
  #
  # @example
  #   Complex.ONE.log.re   # => 0.0
  let log -> Complex = New { re: Math.log(this.abs), im: this.arg }

  # Returns the complex sine.
  #
  # @example
  #   Complex.ZERO.sin.re   # => 0.0
  let sin -> Complex do
    return New {
      re: Math.sin(@re) * Math.cosh(@im),
      im: Math.cos(@re) * Math.sinh(@im)
    }
  end

  # Returns the complex cosine.
  #
  # @example
  #   Complex.ZERO.cos.re   # => 1.0
  let cos -> Complex do
    return New {
      re: Math.cos(@re) * Math.cosh(@im),
      im: -(Math.sin(@re) * Math.sinh(@im))
    }
  end

  # Returns the complex tangent.
  #
  # @example
  #   Complex.ZERO.tan.re   # => 0.0
  let tan -> Complex = this.sin / this.cos

  # Raises this number to a real power using the principal argument.
  #
  # @example
  #   (Complex.I ^ 2).re   # approximately -1.0
  let ^(exponent: Number) -> Complex do
    return Complex.fromPolar(Math.pow(this.abs, exponent), this.arg * exponent)
  end

  # Raises this number to a complex power using the principal logarithm.
  # Zero has no complex power through this formula.
  #
  # @example
  #   (Complex.I ^ Complex.of(2, 0)).re   # approximately -1.0
  let ^(exponent: Complex) -> Complex = (exponent * this.log).exp
end
