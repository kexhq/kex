module Complex

# Complex numbers: one value, readable in rectangular or polar terms.
#
# A +Complex+ is a point in the plane. In rectangular terms it has a real
# part +re+ and an imaginary part +im+; in polar terms, a distance from the
# origin +abs+ and an angle +arg+. Both views work on every value, and either
# can build one. Parts may be any +Number+, and angles are in radians.
#
#   using Complex
#
#   let z = Complex.from(3, 4)
#   z.abs            # => 5.0
#   z.polar          # => (5.0, 0.9272952180016122)
#   Complex.fromPolar(2, Math.PI / 2).im   # approximately 2.0

# A complex number, stored by its real part +re+ and imaginary part +im+.
#
# Write one literally as +Complex { re: 3, im: 4 }+, or with +Complex.from+ and
# +Complex.fromPolar+.
record Complex do
  # The real part.
  re : Number

  # The imaginary part.
  im : Number
end

# The additive identity, +0+0i+.
let ZERO = Complex { re: 0, im: 0 }
# The multiplicative identity, +1+0i+.
let ONE = Complex { re: 1, im: 0 }
# The imaginary unit, +0+1i+.
let I = Complex { re: 0, im: 1 }
# The negative imaginary unit, +0-1i+.
let NEG_I = Complex { re: 0, im: -1 }

# Builds a complex number from its rectangular parts.
#
# @param re [Number] the real part
# @param im [Number] the imaginary part
# @return [Complex] +re + im·i+
#
# @example
#   Complex.from(3, 4).showValue   # => "3+4i"
let from(re: Number, im: Number) -> Complex = Complex { re: re, im: im }

# Builds a complex number from a +(re, im)+ pair, as +rectangular+ returns,
# so +Complex.from(z.rectangular)+ is +z+.
#
# @param parts [(Number, Number)] the real and the imaginary part
# @return [Complex] +re + im·i+
#
# @example
#   Complex.from((3, 4)).im   # => 4
let from(parts: (Number, Number)) -> Complex do
  let (re, im) = parts
  return Complex { re: re, im: im }
end

# Builds a complex number from its polar parts: a distance from the origin and
# an angle in radians.
#
# @param radius [Number] distance from the origin
# @param theta [Number] angle in radians
# @return [Complex] the same number, held by its rectangular parts
#
# @example A quarter turn
#   Complex.fromPolar(2, Math.PI / 2).im   # approximately 2.0
let fromPolar(radius: Number, theta: Number) -> Complex do
  return Complex {
    re: radius * Math.cos(theta),
    im: radius * Math.sin(theta)
  }
end

# Builds a complex number from a +(radius, theta)+ pair, as +polar+ returns,
# so +Complex.fromPolar(z.polar)+ is +z+ up to rounding.
#
# @param parts [(Number, Number)] the distance from the origin and the angle
#   in radians
# @return [Complex] the same number, held by its rectangular parts
#
# @example
#   Complex.fromPolar((2, 0)).re   # => 2.0
let fromPolar(parts: (Number, Number)) -> Complex do
  let (radius, theta) = parts
  return Complex.fromPolar(radius, theta)
end

make Complex, implement: Showable do
  # Renders the number in rectangular form, such as +3+4i+.
  #
  # @return [String] the real and signed imaginary components
  #
  # @example
  #   Complex.from(3, -4).showValue   # => "3-4i"
  let showValue -> String do
    return @im < 0 then "${@re}${@im}i" else "${@re}+${@im}i"
  end

  # Returns the real and imaginary parts as a pair.
  #
  # @return [(Number, Number)] +(re, im)+
  #
  # @example
  #   Complex.from(3, 4).rectangular   # => (3, 4)
  let rectangular -> (Number, Number) = (@re, @im)

  # Returns the distance from the origin and the angle in radians as a pair.
  #
  # @return [(Float, Float)] +(abs, arg)+
  #
  # @example
  #   Complex.from(3, 4).polar   # => (5.0, 0.9272952180016122)
  let polar -> (Float, Float) = (this.abs, this.arg)

  # Returns the magnitude, the distance from the origin.
  #
  # @return [Float] the distance from the origin
  #
  # @example
  #   Complex.from(3, 4).abs   # => 5.0
  let abs -> Float = Math.hypot(@re, @im)

  # Returns the square of the magnitude. It needs no square root, so it stays
  # an +Integer+ when both parts are integers.
  #
  # @return [Number] +re² + im²+
  #
  # @example
  #   Complex.from(3, 4).absSquared   # => 25
  let absSquared -> Number = @re * @re + @im * @im

  # Returns the argument, the angle from the positive real axis, in the range
  # of +Math.atan2+ (-pi to pi).
  #
  # @return [Float] the angle in radians
  #
  # @example
  #   Complex.I.arg   # => 1.5707963267948966
  let arg -> Float = Math.atan2(@im, @re)

  # Adds two complex numbers part by part.
  #
  # @param other [Complex] the number to add
  # @return [Complex] the sum
  #
  # @example
  #   (Complex.from(1, 2) + Complex.I).im   # => 3
  let +(other: Complex) -> Complex do
    return New {
      re: @re + other.re,
      im: @im + other.im
    }
  end

  # Subtracts +other+ from this complex number.
  #
  # @param other [Complex] the number to subtract
  # @return [Complex] the difference
  #
  # @example
  #   (Complex.from(1, 2) - Complex.I).im   # => 1
  let -(other: Complex) -> Complex do
    return New {
      re: @re - other.re,
      im: @im - other.im
    }
  end

  # Negates both parts; this is unary +-+.
  #
  # @return [Complex] the negated number
  #
  # @example
  #   (-Complex.from(1, 2)).im   # => -2
  let -() -> Complex = New { re: -@re, im: -@im }

  # Multiplies two complex numbers.
  #
  # @param other [Complex] the number to multiply by
  # @return [Complex] the product
  #
  # @example
  #   (Complex.I * Complex.I).re   # => -1
  let *(other: Complex) -> Complex do
    return New {
      re: @re * other.re - @im * other.im,
      im: @re * other.im + @im * other.re
    }
  end

  # Divides by +other+, which must not be zero.
  #
  # @param other [Complex] the divisor
  # @return [Complex] the quotient, with +Float+ parts
  #
  # @example
  #   (Complex.I / Complex.I).re   # => 1.0
  let /(other: Complex) -> Complex do
    let d = (other.re * other.re + other.im * other.im) * 1.0

    return New {
      re: (@re * other.re + @im * other.im) / d,
      im: (@im * other.re - @re * other.im) / d
    }
  end

  # Adds a real number to the real part.
  #
  # @param other [Number] the real number to add
  # @return [Complex] the sum
  #
  # @example
  #   (Complex.I + 2).re   # => 2
  let +(other: Number) -> Complex = New { re: @re + other }

  # Subtracts a real number from the real part.
  #
  # @param other [Number] the real number to subtract
  # @return [Complex] the difference
  #
  # @example
  #   (Complex.I - 2).re   # => -2
  let -(other: Number) -> Complex = New { re: @re - other }

  # Multiplies both parts by a real number.
  #
  # @param other [Number] the factor
  # @return [Complex] the product
  #
  # @example
  #   (Complex.I * 2).im   # => 2
  let *(other: Number) -> Complex = New { re: @re * other, im: @im * other }

  # Divides both parts by a real number, which must not be zero.
  #
  # @param other [Number] the divisor
  # @return [Complex] the quotient, with +Float+ parts
  #
  # @example
  #   (Complex.I / 2).im   # => 0.5
  let /(other: Number) -> Complex do
    let divisor = other * 1.0
    return New { re: @re / divisor, im: @im / divisor }
  end

  # Returns the complex conjugate: the same number with the imaginary part
  # negated.
  #
  # @return [Complex] the conjugate
  #
  # @example
  #   Complex.I.conjugate.im   # => -1
  let conjugate -> Complex = New { im: -@im }

  # Returns the principal square root, whose real part is never negative.
  #
  # @return [Complex] the square root
  #
  # @example
  #   Complex.from(-1, 0).sqrt.im   # approximately 1.0
  let sqrt -> Complex = Complex.fromPolar(Math.sqrt(this.abs), this.arg / 2.0)

  # Returns e raised to this complex number.
  #
  # @return [Complex] the exponential
  #
  # @example
  #   Complex.ZERO.exp.re   # => 1.0
  let exp -> Complex do
    let magnitude = Math.exp(@re)
    return New { re: magnitude * Math.cos(@im), im: magnitude * Math.sin(@im) }
  end

  # Returns the principal natural logarithm. Raises an error for zero.
  #
  # @return [Complex] the logarithm
  #
  # @example
  #   Complex.ONE.log.re   # => 0.0
  let log -> Complex = New { re: Math.log(this.abs), im: this.arg }

  # Returns the complex sine.
  #
  # @return [Complex] the sine
  #
  # @example
  #   Complex.ZERO.sin.re   # => 0.0
  let sin -> Complex do
    return New {
      re: Math.sin(@re) * Math.cosh(@im),
      im: Math.cos(@re) * Math.sinh(@im)
    }
  end

  # Returns the complex cosine.
  #
  # @return [Complex] the cosine
  #
  # @example
  #   Complex.ZERO.cos.re   # => 1.0
  let cos -> Complex do
    return New {
      re: Math.cos(@re) * Math.cosh(@im),
      im: -(Math.sin(@re) * Math.sinh(@im))
    }
  end

  # Returns the complex tangent.
  #
  # @return [Complex] the tangent
  #
  # @example
  #   Complex.ZERO.tan.re   # => 0.0
  let tan -> Complex = this.sin / this.cos

  # Raises this number to a real power, using the principal argument.
  #
  # @param exponent [Number] the power
  # @return [Complex] the result
  #
  # @example
  #   (Complex.I ^ 2).re   # approximately -1.0
  let ^(exponent: Number) -> Complex do
    return Complex.fromPolar(Math.pow(this.abs, exponent), this.arg * exponent)
  end

  # Raises this number to a complex power, using the principal logarithm.
  # Raises an error when this number is zero.
  #
  # @param exponent [Complex] the power
  # @return [Complex] the result
  #
  # @example
  #   (Complex.I ^ Complex.from(2, 0)).re   # approximately -1.0
  let ^(exponent: Complex) -> Complex = (exponent * this.log).exp
end
