# Runs Kex source code at run time, in a sandbox.
#
# Use it for code your program is given, such as a formula in a config file
# or a filter a user typed. Each call gets a fresh evaluator that cannot see
# the caller's variables, and the code can reach only what +EvaluatorOptions+
# allows. Step and depth limits stop a runaway program.
#
#   using Evaluator
#
#   Evaluator.runExpression("1 + 2")           # => Ok(3)
#   Evaluator.runExpression("[3,1,2].sort")    # => Ok([1, 2, 3])
#
# Nothing here is in scope until +using Evaluator+. It works only under the
# tree-walk interpreter (+kex -R+).
module Evaluator do
  # Evaluates a whole Kex program and returns its result.
  #
  # The source may declare functions, records and a +main+, as a file would,
  # and the result is what +main+ returns. A runtime error, a call the sandbox
  # does not allow, or running past a limit comes back as an +Error+ with a
  # message. Source that does not parse currently returns +Ok(None)+.
  #
  # @param source [String] the Kex program to run
  # @param opts [EvaluatorOptions] what the sandbox allows; omitted for the defaults
  # @return [Result<Any, String>] the program's result, or why it failed
  #
  # @example
  #   Evaluator.run("main do 1 + 1 end")   # => Ok(2)
  #
  # @example Running a user-supplied script with a tighter budget
  #   Evaluator.run(script, EvaluatorOptions {
  #     allow: [:Math, :List],
  #     maxSteps: 10_000
  #   })
  run : String -> Result<Any, String>
  run : String -> EvaluatorOptions -> Result<Any, String>
  let run(source) = Kex.Intrinsic.Evaluator.run(source)
  let run(source, opts) = Kex.Intrinsic.Evaluator.run(source, opts)

  # Evaluates a single Kex expression and returns its value.
  #
  # Use it when the input is a formula: there is no +main+ to write. Source
  # that does not parse currently returns +Ok(None)+.
  #
  # @param source [String] the Kex expression to evaluate
  # @param opts [EvaluatorOptions] what the sandbox allows; omitted for the defaults
  # @return [Result<Any, String>] the value, or why it failed
  #
  # @example
  #   Evaluator.runExpression("1 + 2")          # => Ok(3)
  #   Evaluator.runExpression("[3,1,2].sort")   # => Ok([1, 2, 3])
  #   Evaluator.runExpression("nope()")
  #   # => Error("Runtime error: <eval>:2:1: runtime error: undefined function: nope")
  #
  # @example Evaluating a formula from a config file
  #   Evaluator.runExpression(formula).or(0)
  runExpression : String -> Result<Any, String>
  runExpression : String -> EvaluatorOptions -> Result<Any, String>
  let runExpression(source) = Kex.Intrinsic.Evaluator.runExpression(source)
  let runExpression(source, opts) = Kex.Intrinsic.Evaluator.runExpression(source, opts)

  # What evaluated code may call, and how long it may run.
  #
  # By default it gets pure computation over the common data types, with no
  # filesystem, network or processes. Narrow +allow+ or lower the limits for
  # less trusted source.
  record EvaluatorOptions do
    # The stdlib modules the code may call. A call into any other module is an
    # +Error+.
    allow : [Atom] = [:Math, :List, :String, :Integer, :Map, :Stream]

    # Extra functions the host program exposes to the code, keyed by module
    # name and then by function name.
    modules : {String: {String: (Any -> Any)}} = {}

    # How many evaluation steps the code may take. Past it, the call returns
    # an +Error+.
    maxSteps : Int = 1_000_000

    # How deep calls may nest. Past it, the call returns an +Error+.
    maxDepth : Int = 256
  end
end
