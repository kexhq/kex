# Calendar dates, wall-clock times, and instants.
#
# Three civil types, each a plain record:
#
#   Date      a calendar day, no time and no zone       (2026-07-30)
#   Time      a time of day, no date and no zone        (14:03:00)
#   DateTime  both, plus a fixed offset from UTC        (2026-07-30T14:03:00+02:00)
#
# Two span types connect them, and which one you want depends on whether the
# calendar gets a say:
#
#   Duration  fixed elapsed time, a count of seconds   (36.hours, 10.days)
#   Period    a calendar step, resolved by the calendar (1.months, 2.years)
#
# `36.hours` is always 129600 seconds; `1.months` is however long that
# particular month turns out to be. So `date + 1.months` clamps January 31st
# to the last day of February, while `date + 30.days` counts thirty days.
#
# A time `Measure` such as `5.second` is a third thing and deliberately NOT a
# Duration: a Measure describes a measurement, a Duration describes elapsed
# time. The plural `5.seconds` builds the Duration.
#
# Values are built through their own module and used through functions:
#
#   let due = Date.of(2026, 7, 30).try           # Date
#   due.weekday.name                             # "Thursday"
#   (due + 10.days).iso                          # "2026-08-09"
#   (due + 1.months).iso                         # "2026-08-30"
#   Time.now().iso                            # e.g. "14:03:00"
#
# Anything that reads the clock is replaceable: `Time.Clock` is a capability,
# and `with Time.Clock = Mock.Clock { at: ... }` pins it for a block.
#
# Zones are fixed offsets: UTC, an explicit `+02:00`, or whatever this
# machine's zone resolves to at a given instant. Named IANA zones and their
# DST rules are not modeled: `Time.now()` asks the host for the offset in
# effect at that moment, so it is right now, but it cannot say what the offset
# WILL be for some future local time.
#
# The records and the two ADTs stay at file level so `make` blocks, callers,
# and every module here can see them.

# Weekday names in ISO order (Monday is day 1).
type Weekday = Monday | Tuesday | Wednesday | Thursday | Friday
             | Saturday | Sunday

# A field out of range, or text that is not a date/time.
type TimeError = InvalidDate(Integer, Integer, Integer)
               | InvalidTime(Integer, Integer, Integer)
               | InvalidFormat(String)

# A calendar day: a year, a month and a day, with no time and no zone.
#
#   let due = Date.of(2026, 7, 30).try
#   due.iso              # => "2026-07-30"
#   due.weekday.name     # => "Thursday"
#   (due + 10.days).iso  # => "2026-08-09"
#
# Build one with +Date.of+, which validates, rather than with the record
# literal, which does not.
record Date do
  # The calendar year.
  year : Integer

  # The month, 1 through 12.
  month : Integer

  # The day of the month, 1 through the length of that month.
  day : Integer
end

# A time of day, with no date and no zone.
#
#   let t = Time.of(14, 3, 0).try
#   t.iso                  # => "14:03:00"
#   (t + 2.hours).iso      # => "16:03:00"
#
# Arithmetic wraps within the day: there is no date to carry into. Reach for
# +DateTime+ when the day rolling over matters.
record Time do
  # The hour, 0 through 23.
  hour : Integer

  # The minute, 0 through 59.
  minute : Integer

  # The second, 0 through 59. Leap seconds are not modeled.
  second : Integer

  # The sub-second part, 0 through 999999999.
  nanosecond : Integer
end

# An instant: a calendar date, a time of day, and a fixed offset from UTC.
#
#   let m = DateTime.parse("2026-07-30T14:03:00+02:00").try
#   m.iso        # => "2026-07-30T14:03:00+02:00"
#   m.utc.iso    # => "2026-07-30T12:03:00Z"
#
# Two +DateTime+ values that name the same instant order +Equal+ under
# +compareTo+ whatever offsets they are written at: ordering goes through
# +epochSeconds+. +==+ is structural, so the same instant written at two
# offsets is not +==+; compare +epochSeconds+ (or +utc+) for that.
record DateTime do
  # The calendar date, as read at this offset.
  date : Date

  # The time of day, as read at this offset.
  time : Time

  # The fixed offset from UTC this value is rendered at.
  offset : Duration
end

# A calendar span. Months and years have no fixed length: February is 28 days
# or 29, a year 365 or 366, so they cannot live in a `Duration`, which is a
# count of seconds and nothing else. A Period carries the calendar fields
# themselves and lets the calendar resolve them:
#
#   Date.of(2026, 1, 31).try + 1.months        # 2026-02-28, not 2026-03-03
#   Date.of(2024, 2, 29).try + 1.years         # 2025-02-28
#
# Use a Duration for elapsed time (`36.hours` is always 129600 seconds) and a
# Period for calendar steps (`1.months` is however long that month is).
record Period do
  # The number of whole years in the span.
  years : Integer

  # The number of whole months in the span.
  months : Integer

  # The number of whole days in the span.
  days : Integer
end

# Building times of day, controlling the clock in tests, and the calendar
# arithmetic the rest of this file is written on.
module Time do

  # Builds a validated time of day.
  #
  # Every field is range-checked, so a +Time+ you hold is always a real time.
  # Leap seconds are not modeled, so a second of 60 is rejected.
  #
  # @param hour [Integer] the hour, 0 through 23
  # @param minute [Integer] the minute, 0 through 59
  # @param second [Integer] the second, 0 through 59
  # @param nanosecond [Integer] the sub-second part, 0 through 999999999; omitted for 0
  # @return [Result<Time, TimeError>] the time, or why it is not one
  #
  # @example
  #   Time.of(14, 3, 0).map { |t| t.iso }   # => Ok("14:03:00")
  #   Time.of(25, 0, 0)                     # => Error(InvalidTime(25, 0, 0))
  #
  # @example With sub-second precision
  #   Time.of(14, 3, 0, 123456789).map { |t| t.iso }
  #   # => Ok("14:03:00.123456789")
  let of(hour: Integer, minute: Integer, second: Integer) -> Result<Time, TimeError> = Time.of(hour, minute, second, 0)

  let of(hour: Integer, minute: Integer, second: Integer, nanosecond: Integer) -> Result<Time, TimeError> do
    return Error(InvalidTime(hour, minute, second)) if hour < 0 || hour > 23
    return Error(InvalidTime(hour, minute, second)) if minute < 0 || minute > 59
    # 60 is rejected: leap seconds are not modeled.
    return Error(InvalidTime(hour, minute, second)) if second < 0 || second > 59
    return Error(InvalidTime(hour, minute, second)) if nanosecond < 0
    return Error(InvalidTime(hour, minute, second)) if nanosecond > 999999999
    return Ok(Time { hour: hour, minute: minute, second: second, nanosecond: nanosecond })
  end

  # Midnight, 00:00:00. The start of a day.
  #
  # @return [Time] 00:00:00
  #
  # @example
  #   Time.midnight().iso                   # => "00:00:00"
  #   (Time.midnight() - 1.seconds).iso     # => "23:59:59"
  let midnight() -> Time = Time { hour: 0, minute: 0, second: 0, nanosecond: 0 }

  # Builds a time of day from a count of seconds since midnight.
  #
  # Wraps, so 86400 is midnight again and -1 is 23:59:59, which is what makes
  # it total where +Time.of+ is fallible.
  #
  # @param count [Integer] seconds since midnight; wraps outside 0..86399
  # @param nanosecond [Integer] the sub-second part; omitted for 0
  # @return [Time] the time of day
  #
  # @example
  #   Time.fromSecondsSinceMidnight(50580).iso   # => "14:03:00"
  #   Time.fromSecondsSinceMidnight(86400).iso   # => "00:00:00"
  #   Time.fromSecondsSinceMidnight(-1).iso      # => "23:59:59"
  #
  # Declared before the two-argument form: the interpreter resolves an
  # overloaded module function to its LAST definition regardless of arity, so
  # a delegating overload has to come first or it recurses into itself.
  let fromSecondsSinceMidnight(count: Integer) -> Time = Time.fromSecondsSinceMidnight(count, 0)

  let fromSecondsSinceMidnight(count: Integer, nanosecond: Integer) -> Time do
    let total = count.modulo(86400)
    return Time { hour: total / 3600, minute: total.modulo(3600) / 60, second: total.modulo(60), nanosecond: nanosecond }
  end

  # Parses an ISO 8601 time of day.
  #
  # Accepts +14:03+, +14:03:00+, or +14:03:00.123456789+. Anything else is
  # +InvalidFormat+.
  #
  # @param text [String] the text to parse
  # @return [Result<Time, TimeError>] the time, or why it could not be read
  #
  # @example
  #   Time.parse("14:03").map { |t| t.iso }   # => Ok("14:03:00")
  #   Time.parse("xx")                        # => Error(InvalidFormat("xx"))
  let parse(text: String) -> Result<Time, TimeError> do
    let parts = text.split(":")
    return Error(InvalidFormat(text)) if parts.count < 2 || parts.count > 3
    let hour = Time.fixedDigitsIn(parts.at(0).or(""), 2, text).try
    let minute = Time.fixedDigitsIn(parts.at(1).or(""), 2, text).try
    let secondParts = parts.at(2).or("00").split(".")
    return Error(InvalidFormat(text)) if secondParts.count > 2
    let second = Time.fixedDigitsIn(secondParts.at(0).or(""), 2, text).try
    let fraction = secondParts.at(1)
    let nanosecond = fraction.set? then Time.parseFraction(fraction.or(""), text).try else 0
    return Time.of(hour, minute, second, nanosecond)
  end

  # The current time of day, in this machine's zone.
  #
  # Reads +Time.Clock+ like everything else here does, so it is pinned by
  # replacing that capability in a test.
  #
  # @return [Time] the current time of day
  #
  # @example
  #   Time.now().iso   # => "14:03:00"
  foul now() -> Time do
    let moment = DateTime.now()
    return moment.time
  end

  # The current time of day in UTC, whatever this machine's zone is.
  #
  # @return [Time] the current UTC time of day
  #
  # @example
  #   Time.utcNow().iso   # => "12:03:00"
  foul utcNow() -> Time do
    let moment = DateTime.utcNow()
    return moment.time
  end

  # Parses an ISO 8601 zone designator into an offset.
  #
  # Accepts +Z+, ++02:00+, +-05:30+, or the empty string (all meaning UTC for
  # the first and last).
  #
  # @param text [String] the zone designator
  # @return [Result<Duration, TimeError>] the offset, or why it could not be read
  #
  # @example
  #   Time.parseOffset("+02:00").map { |d| d.wholeSeconds }   # => Ok(7200)
  #   Time.parseOffset("Z").map { |d| d.wholeSeconds }        # => Ok(0)
  let parseOffset(text: String) -> Result<Duration, TimeError> do
    return Ok(Duration.zero()) if text.empty? || text == "Z"
    # Exactly ±HH:MM: one sign, then the two fields. Not `text.rest`: on BEAM
    # the result of `rest` is not a binary string.
    let sign = text.at(0).or('+')
    return Error(InvalidFormat(text)) if sign != '+' && sign != '-'
    return Error(InvalidFormat(text)) if text.count != 6 || text.at(3) != Just(':')
    let hours = Time.fixedDigitsIn(text.slice(1, 2), 2, text).try
    let minutes = Time.fixedDigitsIn(text.slice(4, 2), 2, text).try
    return Error(InvalidFormat(text)) if hours > 23 || minutes > 59
    return Ok(Duration.utcOffset(0 - hours, 0 - minutes)) if sign == '-'
    return Ok(Duration.utcOffset(hours, minutes))
  end

  # The clock: the one place the current instant comes from.
  #
  # Anything that asks what time it is (`Time.now`, `Date.today`,
  # `DateTime.utcNow`) reads this, so replacing it replaces the whole
  # calendar. It is a capability, so the replacement is for a lexical region:
  # it reaches every call made from the region and every process spawned in
  # it, it nests, and it cannot outlive its block. This is what makes code
  # that calls `Date.today()` testable:
  #
  #   with Time.Clock = Mock.Clock { at: DateTime.parse("2026-07-30T14:03:00Z").try } do
  #     Date.today().iso   # "2026-07-30", always
  #   end
  #
  # +now+ is the whole interface. Its answer carries the zone as its offset,
  # so one member covers both ambient inputs: what time it is, and where.
  # +Mock.Clock+ is the ready-made stand-in; any record that implements +now+
  # is one too.
  capability Clock do
    # The current instant, in this machine's zone as it stands right now.
    #
    # @return [DateTime] the current instant
    foul now() -> DateTime do
      return Time.momentAt(Kex.Intrinsic.Time.nowNanos())
    end
  end

  # The civil instant +nanos+ after the Unix epoch, in this machine's zone as
  # it stands at that instant. Foul because the zone is ambient.
  #
  # @param nanos [Integer] nanoseconds since the Unix epoch
  # @return [DateTime] that instant, in the local zone
  foul momentAt(nanos: Integer) -> DateTime do
    let epochSeconds = Time.floorDiv(nanos, 1000000000)
    let offset = Duration.seconds(Kex.Intrinsic.Time.localOffset(epochSeconds))
    return Time.withNanosecond(DateTime.fromEpochSeconds(epochSeconds, offset), nanos - epochSeconds * 1000000000)
  end

  # Nanoseconds since the Unix epoch for a civil datetime. A plain function
  # rather than a `DateTime` function: on BEAM a function named `epochNanos`
  # flattens onto the same name as the `DateTime.epochNanos()` module
  # function, and the arity-0 one wins: silently, answering for the host
  # clock instead of for `moment`.
  let nanosOf(moment: DateTime) -> Integer do
    return moment.epochSeconds * 1000000000 + moment.time.nanosecond
  end

  # Public because the `make` blocks below live at file level and reach them
  # by qualification; they are equally useful on their own.

  # Returns +true+ when +year+ is a leap year in the proleptic Gregorian
  # calendar.
  #
  # @param year [Integer] the calendar year
  # @return [Bool] +true+ for a leap year
  #
  # @example
  #   Time.leapYear?(2024)   # => true
  #   Time.leapYear?(1900)   # => false
  #   Time.leapYear?(2000)   # => true
  let leapYear?(year: Integer) -> Bool do
    return false if year.modulo(4) != 0
    return true if year.modulo(100) != 0
    return year.modulo(400) == 0
  end

  # The number of days in a month.
  #
  # Year first, matching `Date.of(year, month, day)` and every other
  # date-shaped signature in this file.
  #
  # @param year [Integer] the calendar year, which decides February's length
  # @param month [Integer] the month, 1 through 12
  # @return [Result<Integer, TimeError>] the day count, or why the month is not one
  #
  # @example
  #   Time.daysInMonth(2024, 2)   # => Ok(29)
  #   Time.daysInMonth(2023, 2)   # => Ok(28)
  #   Time.daysInMonth(2026, 13)  # => Error(InvalidDate(2026, 13, 1))
  #
  # Returns +Error(InvalidDate(year, month, 1))+ when the month is outside
  # 1 through 12.
  let daysInMonth(year: Integer, month: Integer) -> Result<Integer, TimeError> do
    return Error(InvalidDate(year, month, 1)) if month < 1 || month > 12
    return Ok(Time.daysInValidMonth(year, month))
  end

  # The number of days in a month, with the range check already done.
  #
  # Every caller inside this file has a month it built or validated itself.
  # Use +daysInMonth+ for a month that came from outside.
  #
  # @param year [Integer] the calendar year
  # @param month [Integer] the month, assumed to be 1 through 12
  # @return [Integer] the day count
  #
  # @example
  #   Time.daysInValidMonth(2024, 2)   # => 29
  let daysInValidMonth(year: Integer, month: Integer) -> Integer do
    return 31 if month == 1 || month == 3 || month == 5 || month == 7
    return 31 if month == 8 || month == 10 || month == 12
    return 30 if month == 4 || month == 6 || month == 9 || month == 11
    return 29 if Time.leapYear?(year)
    return 28
  end

  # The number of days from 1970-01-01 to a calendar date, negative before it.
  #
  # Howard Hinnant's civil-calendar algorithms: exact across the whole
  # proleptic Gregorian range, and they need only truncating integer
  # division: the semantics Kex's `/` already has.
  #
  # @param year [Integer] the calendar year
  # @param month [Integer] the month, 1 through 12
  # @param day [Integer] the day of the month
  # @return [Integer] days since the Unix epoch
  #
  # @example
  #   Time.daysFromCivil(1970, 1, 1)   # => 0
  #   Time.daysFromCivil(2026, 7, 30)  # => 20664
  let daysFromCivil(year: Integer, month: Integer, day: Integer) -> Integer do
    let y = month <= 2 then year - 1 else year
    let era = y < 0 then (y - 399) / 400 else y / 400
    let yoe = y - era * 400
    let mp = month > 2 then month - 3 else month + 9
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
  end

  # The calendar date a count of days since 1970-01-01 lands on. The inverse
  # of +daysFromCivil+.
  #
  # @param epochDay [Integer] days since the Unix epoch
  # @return [Date] the calendar date
  #
  # @example
  #   Time.civilFromDays(0).iso       # => "1970-01-01"
  #   Time.civilFromDays(20664).iso   # => "2026-07-30"
  let civilFromDays(epochDay: Integer) -> Date do
    let z = epochDay + 719468
    let era = z < 0 then (z - 146096) / 146097 else z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = mp < 10 then mp + 3 else mp - 9
    let year = month <= 2 then y + 1 else y
    return Date { year: year, month: month, day: day }
  end

  # The weekday a count of days since 1970-01-01 falls on.
  #
  # @param epochDay [Integer] days since the Unix epoch
  # @return [Weekday] the day of the week
  #
  # @example
  #   Time.weekdayFromEpochDay(0)   # => Thursday   (1970-01-01 was a Thursday)
  let weekdayFromEpochDay(epochDay: Integer) -> Weekday do
    let index = (epochDay + 3).modulo(7)
    return Monday if index == 0
    return Tuesday if index == 1
    return Wednesday if index == 2
    return Thursday if index == 3
    return Friday if index == 4
    return Saturday if index == 5
    return Sunday
  end

  # The ISO number of a weekday: Monday is 1, Sunday is 7.
  #
  # +weekday.number+ is the readable way to ask.
  #
  # @param weekday [Weekday] the day of the week
  # @return [Integer] its ISO number, 1 through 7
  #
  # @example
  #   Time.weekdayNumber(Monday)   # => 1
  let weekdayNumber(@Monday) -> Integer = 1
  let weekdayNumber(@Tuesday) -> Integer = 2
  let weekdayNumber(@Wednesday) -> Integer = 3
  let weekdayNumber(@Thursday) -> Integer = 4
  let weekdayNumber(@Friday) -> Integer = 5
  let weekdayNumber(@Saturday) -> Integer = 6
  let weekdayNumber(@Sunday) -> Integer = 7

  # The English name of a weekday.
  #
  # +weekday.name+ is the readable way to ask.
  #
  # @param weekday [Weekday] the day of the week
  # @return [String] its English name
  #
  # @example
  #   Time.weekdayName(Sunday)   # => "Sunday"
  let weekdayName(@Monday) -> String = "Monday"
  let weekdayName(@Tuesday) -> String = "Tuesday"
  let weekdayName(@Wednesday) -> String = "Wednesday"
  let weekdayName(@Thursday) -> String = "Thursday"
  let weekdayName(@Friday) -> String = "Friday"
  let weekdayName(@Saturday) -> String = "Saturday"
  let weekdayName(@Sunday) -> String = "Sunday"

  make Weekday do
    # This weekday's ISO number: Monday is 1, Sunday is 7.
    #
    # @return [Integer] the ISO number, 1 through 7
    #
    # @example
    #   Monday.number   # => 1
    #   Sunday.number   # => 7
    let number -> Integer = Time.weekdayNumber(this)

    # This weekday's English name.
    #
    # @return [String] the name
    #
    # @example
    #   Date.of(2026, 7, 30).try.weekday.name   # => "Thursday"
    let name -> String = Time.weekdayName(this)

    # Returns +true+ for Saturday and Sunday.
    #
    # @return [Bool] +true+ on a weekend day
    #
    # @example
    #   Saturday.weekend?   # => true
    #   Monday.weekend?     # => false
    #
    # @example Counting working days in a range
    #   days.count { |d| !d.weekday.weekend? }
    let weekend? -> Bool = Time.weekdayNumber(this) > 5
  end

  # Renders a +TimeError+ as a sentence for the user.
  #
  # A plain function rather than an `Errorable` implementation: a `message`
  # function here joins the same BEAM dispatcher as ParseError's `message`
  # FIELD and breaks it (spec/record_field_method_collision.kex).
  #
  # @param error [TimeError] the failure to describe
  # @return [String] the message to show
  #
  # @example
  #   Time.errorMessage(InvalidDate(2026, 13, 1))
  #   # => "not a calendar date: 2026-13-1"
  #
  # @example Reporting a rejected date
  #   match Date.parse(input) do
  #     Ok(date) => IO.printLine(date.iso)
  #     Error(e) => IO.printError(Time.errorMessage(e))
  #   end
  let errorMessage(@InvalidDate(y, m, d)) -> String = "not a calendar date: ${y}-${m}-${d}"
  let errorMessage(@InvalidTime(h, m, s)) -> String = "not a time of day: ${h}:${m}:${s}"
  let errorMessage(@InvalidFormat(text)) -> String = "cannot parse as a date/time: ${text}"


  let formatDate(value: Date) -> String = "${Time.padYear(value.year)}-${Time.pad2(value.month)}-${Time.pad2(value.day)}"

  let formatDateTime(value: DateTime) -> String = "${Time.formatDate(value.date)}T${Time.formatTime(value.time)}${Time.formatOffset(value.offset)}"

  let formatTime(value: Time) -> String = "${Time.pad2(value.hour)}:${Time.pad2(value.minute)}:${Time.pad2(value.second)}${Time.formatFraction(value.nanosecond)}"

  # Fractional seconds, in the 3/6/9-digit groupings ISO 8601 output
  # conventionally uses, whichever is the shortest that loses nothing. A whole
  # second renders no fraction at all, so `14:03:00` is unchanged.
  #
  # Without this the nanosecond field was kept on the value and compared, but
  # never rendered: `Time.parse("14:03:00.5")` and `Time.parse("14:03:00")`
  # produced different values that printed identically, and every parse/format
  # round-trip silently dropped sub-second precision.
  let formatFraction(nanosecond: Integer) -> String do
    return "" if nanosecond == 0
    return ".${Time.padTo(nanosecond / 1000000, 3)}" if nanosecond.modulo(1000000) == 0
    return ".${Time.padTo(nanosecond / 1000, 6)}" if nanosecond.modulo(1000) == 0
    return ".${Time.padTo(nanosecond, 9)}"
  end

  # ±HH:MM, the shape an ISO 8601 offset takes. UTC renders as "Z".
  let formatOffset(offset: Duration) -> String do
    let total = offset.wholeSeconds
    return "Z" if total == 0
    let sign = total < 0 then "-" else "+"
    let magnitude = total < 0 then 0 - total else total
    return "${sign}${Time.pad2(magnitude / 3600)}:${Time.pad2(magnitude.modulo(3600) / 60)}"
  end


  let withNanosecond(moment: DateTime, nanosecond: Integer) -> DateTime do
    let time = Time {
      hour: moment.time.hour,
      minute: moment.time.minute,
      second: moment.time.second,
      nanosecond: nanosecond
    }
    return DateTime { date: moment.date, time: time, offset: moment.offset }
  end

  # Kex's `/` truncates toward zero; instants before the epoch need the floor.
  let floorDiv(value: Integer, divisor: Integer) -> Integer do
    let quotient = value / divisor
    return quotient if value.modulo(divisor) == 0
    return quotient - 1 if (value < 0) != (divisor < 0)
    return quotient
  end

  # A Duration holds Float seconds, so it is rounded to the nanosecond, the
  # finest unit it names, before truncating: 7.nanoseconds is 7e-9 seconds,
  # and dividing that by 1e-9 directly gives 6.999... and so 6.
  let truncatedBy(seconds: Float, unit: Float) -> Integer do
    let nanos = (seconds * 1000000000.0).round
    let unitNanos = (unit * 1000000000.0).round
    return nanos / unitNanos
  end

  let pad2(value: Integer) -> String do
    return "0${value}" if value < 10
    return "${value}"
  end

  # Left-pad with zeros to a fixed width. A value already that wide is left
  # alone rather than truncated: losing digits would be worse than a field
  # one character too long.
  let padTo(value: Integer, width: Integer) -> String do
    var text = "${value}"
    while text.count < width do
      text = "0${text}"
    end
    return text
  end

  # Years keep four digits where they fit; ISO 8601 has no fixed spelling
  # beyond that, so wider years render as-is.
  let padYear(value: Integer) -> String do
    return "${value}" if value < 0 || value > 9999
    return Time.padTo(value, 4)
  end

  # Digits, with the failure reported against the WHOLE input rather than the
  # fragment that failed: `Time.parse("2:03 pm")` should complain about
  # "2:03 pm", not about "03 pm".
  let digitsIn(fragment: String, whole: String) -> Result<Integer, TimeError> do
    match Time.digitsToInteger(fragment) do
      Ok(value) => return Ok(value)
      Error(_) => return Error(InvalidFormat(whole))
    end
  end

  # The same, for a field ISO 8601 writes at a fixed width: "14", never "2".
  let fixedDigitsIn(fragment: String, width: Integer, whole: String) -> Result<Integer, TimeError> do
    return Error(InvalidFormat(whole)) if fragment.count != width
    return Time.digitsIn(fragment, whole)
  end

  # ASCII digits only: Integer.parse would also take a sign or surrounding
  # space, and none of those belongs inside an ISO 8601 field.
  let digitsToInteger(text: String) -> Result<Integer, TimeError> do
    return Error(InvalidFormat(text)) if text.empty? || text.chars.any? { |c| !c.in?('0'..'9') }
    match Integer.parse(text) do
      Ok(value) => return Ok(value)
      Error(_) => return Error(InvalidFormat(text))
    end
  end

  # ".5" is 500000000ns: the digits are padded out to nanosecond scale.
  # The caller has seen the ".", so an empty fraction is malformed, not zero.
  let parseFraction(text: String, whole: String) -> Result<Integer, TimeError> do
    return Error(InvalidFormat(whole)) if text.empty? || text.count > 9
    var digits = text
    while digits.count < 9 do
      digits = "${digits}0"
    end
    return Time.digitsIn(digits, whole)
  end

  # Splits "14:03:00+02:00" into its time and offset halves. A missing offset
  # reads as UTC, matching what a zero offset formats back to.
  let splitOffset(text: String) -> [String] do
    # Only the final "Z" is the designator: "...00ZZ" leaves "...00Z" to fail
    # as a time rather than quietly dropping the extra one.
    return [text.take(text.count - 1), "Z"] if text.endsWith?("Z")
    let plus = text.split("+")
    return [plus.at(0).or(""), "+${plus.at(1).or("")}"] if plus.count == 2
    # The date half is already gone, so any "-" left here starts the offset.
    let minus = text.split("-")
    return [minus.at(0).or(""), "-${minus.at(1).or("")}"] if minus.count == 2
    return [text, "Z"]
  end
end


# Building calendar dates, and asking what today is.
module Date do
  # Builds a +DateFormat+ from a CLDR pattern, for +to(String, format)+ on a
  # +Date+, a +Time+ or a +DateTime+.
  #
  # A pattern that does not fit makes +to(String, format)+ answer +None+;
  # +DateFormat.parse+ says where it goes wrong, and +validateFormat+ is the
  # companion check for the tagged literal. Letters are fields, repeated for width; quote literal letters, as in
  # +'at'+, and write +''+ for a quote itself. Anything else is written as
  # it stands.
  #
  # - +yyyy+ the year, +yy+ its last two digits
  # - +M+ / +MM+ the month number, +MMM+ / +MMMM+ its short / full name
  # - +d+ / +dd+ the day of the month
  # - +EEE+ / +EEEE+ the short / full weekday name
  # - +H+ / +HH+ the hour 0-23, +h+ / +hh+ the hour 1-12, +a+ AM or PM
  # - +m+ / +mm+ minutes, +s+ / +ss+ seconds, +S+ up to +SSSSSSSSS+ the
  #   fraction of a second
  # - +XXX+ the offset as +-05:00+, or +Z+ for UTC; +xxx+ the same without +Z+
  #   (+XX+ / +xx+ write +-0500+, and one letter writes +-05+)
  #
  # Names come from the culture passed to +to(String, format, culture:)+,
  # English without one.
  #
  # @param parts [[String]] the literal pieces of the tagged literal
  # @param values [[Any]] the interpolated values
  # @return [DateFormat] the format
  #
  # @example
  #   let d = Date.of(2026, 11, 7).try
  #   d.to(String, Date.format`yyyy-MM-dd`)        # => Just("2026-11-07")
  #   d.to(String, Date.format`EEE, d MMM yyyy`)   # => Just("Sat, 7 Nov 2026")
  #   d.to(String, Date.format`d MMMM yyyy`, culture: Culture.of("HU_HU").or(Culture.DEFAULT))
  #   # => Just("7 november 2026")
  format : [String] -> [Any] -> DateFormat
  let format(parts, values) do
    let rest = values.zip(parts.rest).map { |value, part| "${value}${part}" }
    return DateFormat { pattern: parts.first.or("") + rest.join("") }
  end

  # Checks a +Date.format+ pattern during compilation, pointing at the first
  # character that does not fit.
  #
  # @param source [String] the pattern
  # @return [[TaggedValidation.Issue]] the problem found, if any
  let validateFormat(source: String) -> [TaggedValidation.Issue] do
    match DateFormat.pieces(source) do
      Ok(_) => return []
      Error((index, message)) => return [TaggedValidation.fatalAt(source.take(index).byteSize, message)]
    end
  end

  # Builds a validated calendar date.
  #
  # The month and the day are both range-checked, and the day is checked
  # against that month's actual length, so February 30th is an +Error+, and a
  # +Date+ you hold is always a real day. The record literal `Date { ... }`
  # bypasses this, so prefer it for anything derived from input.
  #
  # @param year [Integer] the calendar year
  # @param month [Integer] the month, 1 through 12
  # @param day [Integer] the day of the month
  # @return [Result<Date, TimeError>] the date, or why it is not one
  #
  # @example
  #   Date.of(2026, 7, 30).map { |d| d.iso }   # => Ok("2026-07-30")
  #   Date.of(2026, 13, 1)                     # => Error(InvalidDate(2026, 13, 1))
  #   Date.of(2023, 2, 29)                     # => Error(InvalidDate(2023, 2, 29))
  #
  # @example Taking the date or failing loudly
  #   let due = Date.of(year, month, day).try
  let of(year: Integer, month: Integer, day: Integer) -> Result<Date, TimeError> do
    return Error(InvalidDate(year, month, day)) if month < 1 || month > 12
    return Error(InvalidDate(year, month, day)) if day < 1
    return Error(InvalidDate(year, month, day)) if day > Time.daysInValidMonth(year, month)
    return Ok(Date { year: year, month: month, day: day })
  end

  # The calendar date a count of days since 1970-01-01 lands on, negative
  # before it.
  #
  # @param day [Integer] days since the Unix epoch
  # @return [Date] the calendar date
  #
  # @example
  #   Date.fromEpochDay(0).iso       # => "1970-01-01"
  #   Date.fromEpochDay(20664).iso   # => "2026-07-30"
  let fromEpochDay(day: Integer) -> Date = Time.civilFromDays(day)

  # Parses an ISO 8601 calendar date, +2026-07-30+.
  #
  # The result is validated as well as parsed, so a well-formed but impossible
  # date is +InvalidDate+ rather than +InvalidFormat+.
  #
  # @param text [String] the text to parse
  # @return [Result<Date, TimeError>] the date, or why it could not be read
  #
  # @example
  #   Date.parse("2026-07-30").map { |d| d.iso }   # => Ok("2026-07-30")
  #   Date.parse("nope")                           # => Error(InvalidFormat("nope"))
  #   Date.parse("2026-02-30")                     # => Error(InvalidDate(2026, 2, 30))
  let parse(text: String) -> Result<Date, TimeError> do
    let parts = text.split("-")
    # A leading "-" would be a negative year, which this deliberately rejects.
    return Error(InvalidFormat(text)) if parts.count != 3
    # At least four year digits (a wider year renders as-is, so it parses
    # back); exactly two for the month and the day.
    let yearText = parts.at(0).or("")
    return Error(InvalidFormat(text)) if yearText.count < 4
    let year = Time.digitsIn(yearText, text).try
    let month = Time.fixedDigitsIn(parts.at(1).or(""), 2, text).try
    let day = Time.fixedDigitsIn(parts.at(2).or(""), 2, text).try
    return Date.of(year, month, day)
  end

  # Today's date, in this machine's zone. The same as +Date.today()+.
  #
  # +Date.today()+ reads better in most code; +now+ exists so every type in
  # this file answers the same question the same way: +Date.now()+,
  # +Time.now()+ and +DateTime.now()+.
  #
  # @return [Date] today's date
  #
  # @example
  #   Date.now().iso   # => "2026-07-30"
  foul now() -> Date do
    let moment = DateTime.now()
    return moment.date
  end

  # Today's date, in this machine's zone.
  #
  # Pinned by replacing +Time.Clock+ in a test, like everything else that
  # reads the clock.
  #
  # @return [Date] today's date
  #
  # @example
  #   Date.today().iso   # => "2026-07-30"
  #
  # @example Testing code that depends on today
  #   with Time.Clock = Mock.Clock { at: DateTime.parse("2026-07-30T00:00:00Z").try } do
  #     Assert.equal(Date.today().iso, "2026-07-30")
  #   end
  foul today() -> Date do
    let moment = DateTime.now()
    return moment.date
  end

  # The day after today, in this machine's zone.
  #
  # @return [Date] tomorrow's date
  #
  # @example
  #   Date.tomorrow().iso   # => "2026-07-31"
  foul tomorrow() -> Date do
    let moment = DateTime.now()
    return moment.date.addDays(1)
  end

  # The day before today, in this machine's zone.
  #
  # @return [Date] yesterday's date
  #
  # @example
  #   Date.yesterday().iso   # => "2026-07-29"
  foul yesterday() -> Date do
    let moment = DateTime.now()
    return moment.date.addDays(0 - 1)
  end

  # Today's date in UTC, whatever this machine's zone is. The same as
  # +Date.utcToday()+, under the name every type in this file shares.
  #
  # @return [Date] today's UTC date
  #
  # @example
  #   Date.utcNow().iso   # => "2026-07-30"
  foul utcNow() -> Date do
    let moment = DateTime.utcNow()
    return moment.date
  end

  # Today's date in UTC, whatever this machine's zone is.
  #
  # @return [Date] today's UTC date
  #
  # @example
  #   Date.utcToday().iso   # => "2026-07-30"
  foul utcToday() -> Date do
    let moment = DateTime.utcNow()
    return moment.date
  end
end

# Building instants, and asking what time it is now.
module DateTime do
  # Combines a date, a time of day and a UTC offset into an instant.
  #
  # @param date [Date] the calendar date
  # @param time [Time] the time of day
  # @param offset [Duration] the offset from UTC
  # @return [DateTime] the instant
  #
  # @example
  #   DateTime.of(Date.of(2026, 7, 30).try,
  #               Time.of(9, 0, 0).try,
  #               Duration.zero()).iso
  #   # => "2026-07-30T09:00:00Z"
  #
  # @example At an offset
  #   DateTime.of(date, time, Duration.utcOffset(2, 0))
  let of(date: Date, time: Time, offset: Duration) -> DateTime = DateTime { date: date, time: time, offset: offset }

  # The instant a count of seconds since the Unix epoch names, rendered at UTC
  # or at the offset you give.
  #
  # @param count [Integer] seconds since the Unix epoch
  # @param offset [Duration] the offset to render at; omitted for UTC
  # @return [DateTime] the instant
  #
  # @example
  #   DateTime.fromEpochSeconds(0).iso   # => "1970-01-01T00:00:00Z"
  #
  # @example Rendered at a local offset
  #   DateTime.fromEpochSeconds(0, Duration.utcOffset(2, 0)).iso
  #   # => "1970-01-01T02:00:00+02:00"
  #
  # Declared before the two-argument form: the interpreter resolves an
  # overloaded module function to its LAST definition regardless of arity, so
  # a delegating overload has to come first or it recurses into itself.
  let fromEpochSeconds(count: Integer) -> DateTime = DateTime.fromEpochSeconds(count, Duration.zero())

  # The civil rendering of an instant, at a given offset.
  let fromEpochSeconds(count: Integer, offset: Duration) -> DateTime do
    let local = count + offset.wholeSeconds
    let day = Time.floorDiv(local, 86400)
    return DateTime {
      date: Time.civilFromDays(day),
      time: Time.fromSecondsSinceMidnight(local - day * 86400),
      offset: offset
    }
  end

  # Parses an ISO 8601 instant.
  #
  # Accepts +2026-07-30T14:03:00+02:00+, the same with +Z+, or a bare civil
  # datetime with no zone at all, which is read as UTC.
  #
  # @param text [String] the text to parse
  # @return [Result<DateTime, TimeError>] the instant, or why it could not be read
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").map { |m| m.utc.iso }
  #   # => Ok("2026-07-30T12:03:00Z")
  #   DateTime.parse("nope")   # => Error(InvalidFormat("nope"))
  #
  # @example Reading a timestamp out of a log line
  #   DateTime.parse(line.take(20)).map { |m| m.epochSeconds }
  let parse(text: String) -> Result<DateTime, TimeError> do
    let parts = text.split("T")
    return Error(InvalidFormat(text)) if parts.count != 2
    # Each half reports against the whole datetime, not against the fragment
    # it was handed.
    let dateResult = Date.parse(parts.at(0).or(""))
    return Error(InvalidFormat(text)) if dateResult.ok? == false
    let halves = Time.splitOffset(parts.at(1).or(""))
    let timeResult = Time.parse(halves.at(0).or(""))
    return Error(InvalidFormat(text)) if timeResult.ok? == false
    let offsetResult = Time.parseOffset(halves.at(1).or(""))
    return Error(InvalidFormat(text)) if offsetResult.ok? == false
    let date = dateResult.try
    let time = timeResult.try
    let offset = offsetResult.try
    return Ok(DateTime { date: date, time: time, offset: offset })
  end

  # The current instant, in this machine's zone as it stands right now.
  #
  # The offset is the one in effect at this instant, so it is right today.
  # Named IANA zones are not modeled, so it cannot say what the offset
  # WILL be for some future local time.
  #
  # @return [DateTime] the current instant
  #
  # @example
  #   DateTime.now().iso   # => "2026-07-30T14:03:00+02:00"
  foul now() -> DateTime do
    return Time.Clock.now()
  end

  # The current instant, at UTC.
  #
  # The form to prefer when the value is stored, compared or transmitted:
  # there is no zone to disagree about.
  #
  # @return [DateTime] the current instant, at UTC
  #
  # @example
  #   DateTime.utcNow().iso   # => "2026-07-30T12:03:00Z"
  foul utcNow() -> DateTime do
    let nanos = Time.nanosOf(Time.Clock.now())
    let epochSeconds = Time.floorDiv(nanos, 1000000000)
    return Time.withNanosecond(DateTime.fromEpochSeconds(epochSeconds, Duration.zero()), nanos - epochSeconds * 1000000000)
  end

  # Nanoseconds since the Unix epoch, straight from the clock.
  #
  # The right reading for measuring a short interval: a plain integer, with
  # no zone to disagree about.
  #
  # @return [Integer] nanoseconds since the Unix epoch
  #
  # @example Timing a piece of work
  #   let started = DateTime.epochNanos()
  #   doTheThing()
  #   let elapsedMs = (DateTime.epochNanos() - started) / 1000000
  foul epochNanos() -> Integer do
    return Time.nanosOf(Time.Clock.now())
  end

end
# The plural spellings build a Duration; the singular ones from units.kex
# build a time Measure. `5.seconds` is an elapsed span, `5.second` a measurement.

make Integer do
  let nanoseconds -> Duration = Duration { seconds: this / 1000000000.0 }
  let microseconds -> Duration = Duration { seconds: this / 1000000.0 }

  # This many milliseconds, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   500.milliseconds.wholeMilliseconds   # => 500
  let milliseconds -> Duration = Duration { seconds: this / 1000.0 }

  # This many seconds, as a +Duration+.
  #
  # Note the plural: +5.seconds+ is an elapsed span, while +5.second+ from
  # +units.kex+ is a measurement.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   30.seconds.wholeSeconds   # => 30
  let seconds -> Duration = Duration { seconds: this * 1.0 }

  # This many minutes, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   90.minutes.wholeHours   # => 1
  let minutes -> Duration = Duration { seconds: this * 60.0 }

  # This many hours, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   36.hours.wholeDays   # => 1
  let hours -> Duration = Duration { seconds: this * 3600.0 }

  # This many days, as a +Duration+: a fixed 86400 seconds each.
  #
  # Use +Period.days+ when the calendar should get a say.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   (Date.of(2026, 7, 30).try + 10.days).iso   # => "2026-08-09"
  let days -> Duration = Duration { seconds: this * 86400.0 }

  # This many weeks, as a +Duration+: a fixed 604800 seconds each.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   2.weeks.wholeDays   # => 14
  let weeks -> Duration = Duration { seconds: this * 604800.0 }

  # This many calendar months, as a +Period+.
  #
  # A calendar span, not a Duration: see the +Period+ record above.
  # +4.weeks+ and +1.months+ are deliberately different things: the first is
  # exactly 28 days, the second is one calendar month, however long that turns
  # out to be.
  #
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2026, 7, 30).try + 1.months).iso   # => "2026-08-30"
  #
  # @example The calendar clamps a day that does not exist
  #   (Date.of(2026, 1, 31).try + 1.months).iso   # => "2026-02-28"
  let months -> Period = Period { years: 0, months: this, days: 0 }

  # This many calendar years, as a +Period+.
  #
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2024, 2, 29).try + 1.years).iso   # => "2025-02-28"
  let years -> Period = Period { years: this, months: 0, days: 0 }
end

# The same +Duration+ constructors on +Float+, for fractional spans:
# +1.5.hours+, +0.25.seconds+.
make Float do
  let nanoseconds -> Duration = Duration { seconds: this / 1000000000.0 }
  let microseconds -> Duration = Duration { seconds: this / 1000000.0 }

  # This many milliseconds, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  let milliseconds -> Duration = Duration { seconds: this / 1000.0 }

  # This many seconds, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   0.25.seconds.wholeMilliseconds   # => 250
  let seconds -> Duration = Duration { seconds: this }

  # This many minutes, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  let minutes -> Duration = Duration { seconds: this * 60.0 }

  # This many hours, as a +Duration+.
  #
  # @return [Duration] the elapsed span
  #
  # @example
  #   1.5.hours.wholeMinutes   # => 90
  let hours -> Duration = Duration { seconds: this * 3600.0 }

  # This many days, as a +Duration+: a fixed 86400 seconds each.
  #
  # @return [Duration] the elapsed span
  let days -> Duration = Duration { seconds: this * 86400.0 }

  # This many weeks, as a +Duration+: a fixed 604800 seconds each.
  #
  # @return [Duration] the elapsed span
  let weeks -> Duration = Duration { seconds: this * 604800.0 }
end

make Duration do
  let wholeNanoseconds -> Integer = Time.truncatedBy(this.seconds, 0.000000001)
  let wholeMicroseconds -> Integer = Time.truncatedBy(this.seconds, 0.000001)

  # Adds two spans.
  #
  # @param other [Duration] the span to add
  # @return [Duration] the total
  #
  # @example
  #   (90.minutes + 30.minutes).wholeHours   # => 2
  let +(other: Duration) -> Duration = Duration { seconds: this.seconds + other.seconds }

  # Subtracts a span. The result may be negative.
  #
  # @param other [Duration] the span to subtract
  # @return [Duration] the difference
  #
  # @example
  #   (1.hours - 90.minutes).negative?   # => true
  let -(other: Duration) -> Duration = Duration { seconds: this.seconds - other.seconds }

  # The same span with its sign flipped.
  #
  # @return [Duration] the negated span
  #
  # @example
  #   90.minutes.negated.negative?   # => true
  let negated -> Duration = Duration { seconds: 0.0 - this.seconds }

  # Multiplies the span by a plain number.
  #
  # `3 * 1.days` is not the same call because the receiver has to be the
  # Duration, so it is spelled `1.days * 3`.
  #
  # @param factor [Number] the factor to multiply by
  # @return [Duration] the scaled span
  #
  # @example
  #   (90.minutes * 2).wholeHours   # => 3
  let *(factor: Number) -> Duration = Duration { seconds: this.seconds * factor }

  # Divides the span by a plain number.
  #
  # @param divisor [Number] the number to divide by
  # @return [Duration] the scaled span
  #
  # @example
  #   (90.minutes / 2).wholeMinutes   # => 45
  let /(divisor: Number) -> Duration = Duration { seconds: this.seconds / divisor }

  # The span's magnitude, discarding its direction.
  #
  # @return [Duration] the absolute span
  #
  # @example
  #   (1.hours - 90.minutes).abs.wholeMinutes   # => 30
  let abs -> Duration = Duration { seconds: this.seconds < 0.0 then 0.0 - this.seconds else this.seconds }

  # Returns +true+ when the span is exactly zero.
  #
  # @return [Bool] +true+ for a zero span
  #
  # @example
  #   Duration.zero().zero?   # => true
  let zero? -> Bool = this.seconds == 0.0

  # Returns +true+ when the span points backwards.
  #
  # A negative span is what +until+ gives you when the other moment is
  # earlier, so this is how to ask which came first.
  #
  # @return [Bool] +true+ for a negative span
  #
  # @example
  #   date.until(other).negative?   # => true when `other` is earlier
  let negative? -> Bool = this.seconds < 0.0

  # Returns +true+ when the span points forwards.
  #
  # @return [Bool] +true+ for a positive span
  #
  # @example
  #   90.minutes.positive?   # => true
  let positive? -> Bool = this.seconds > 0.0

  # Returns +true+ when this span is shorter than +other+.
  #
  # Named for length rather than for order: `before?`/`after?` are about when
  # something happened, and a Duration is not a point in time.
  #
  # @param other [Duration] the span to compare against
  # @return [Bool] +true+ when this span is shorter
  #
  # @example
  #   30.minutes.shorterThan?(1.hours)   # => true
  #
  # @example Enforcing a timeout
  #   if started.until(DateTime.utcNow()).longerThan?(30.seconds)
  #     IO.printError("timed out")
  #   end
  let shorterThan?(other: Duration) -> Bool = this.seconds < other.seconds

  # Returns +true+ when this span is longer than +other+.
  #
  # @param other [Duration] the span to compare against
  # @return [Bool] +true+ when this span is longer
  #
  # @example
  #   90.minutes.longerThan?(1.hours)   # => true
  let longerThan?(other: Duration) -> Bool = this.seconds > other.seconds

  # The whole milliseconds in the span, truncated toward zero.
  #
  # @return [Integer] the milliseconds
  #
  # @example
  #   500.milliseconds.wholeMilliseconds   # => 500
  let wholeMilliseconds -> Integer = Time.truncatedBy(this.seconds, 0.001)

  # The whole seconds in the span, truncated toward zero.
  #
  # @return [Integer] the seconds
  #
  # @example
  #   Duration.hours(2).wholeSeconds   # => 7200
  let wholeSeconds -> Integer = Time.truncatedBy(this.seconds, 1.0)

  # The whole minutes in the span, truncated toward zero.
  #
  # @return [Integer] the minutes
  #
  # @example
  #   90.minutes.wholeMinutes   # => 90
  #   1.5.hours.wholeMinutes    # => 90
  let wholeMinutes -> Integer = Time.truncatedBy(this.seconds, 60.0)

  # The whole hours in the span, truncated toward zero. A partial hour does
  # not count.
  #
  # @return [Integer] the hours
  #
  # @example
  #   90.minutes.wholeHours   # => 1
  let wholeHours -> Integer = Time.truncatedBy(this.seconds, 3600.0)

  # The whole days in the span, truncated toward zero.
  #
  # This is what +date + span+ uses, which is why +date + 36.hours+ advances
  # exactly one day.
  #
  # @return [Integer] the days
  #
  # @example
  #   36.hours.wholeDays   # => 1
  #   2.weeks.wholeDays    # => 14
  let wholeDays -> Integer = Time.truncatedBy(this.seconds, 86400.0)

  # The whole weeks in the span, truncated toward zero.
  #
  # @return [Integer] the weeks
  #
  # @example
  #   14.days.wholeWeeks   # => 2
  let wholeWeeks -> Integer = Time.truncatedBy(this.seconds, 604800.0)

  # Orders this span against another by length.
  #
  # Delegates to `Number.compare` (algebra.kex), which orders the two Float
  # second counts.
  #
  # @param other [Duration] the span to compare against
  # @return [Ordering] +Less+, +Equal+ or +Greater+
  #
  # @example
  #   90.minutes.compareTo(60.minutes)   # => Greater
  #
  # @example Sorting by length
  #   spans.sort { |a, b| a.compareTo(b) == Less }
  let compareTo(other: Duration) -> Ordering = this.seconds.compare(other.seconds)
end

# Building elapsed spans, and UTC offsets.
module Duration do
  # A span of no time at all. Also the UTC offset.
  #
  # @return [Duration] the zero span
  #
  # @example
  #   Duration.zero().zero?   # => true
  #   date.at(time, Duration.zero()).iso   # => "...T09:00:00Z"
  let zero() -> Duration = Duration { seconds: 0.0 }

  let nanoseconds(count: Number) -> Duration = Duration { seconds: count / 1000000000.0 }
  let microseconds(count: Number) -> Duration = Duration { seconds: count / 1000000.0 }

  # A span of +count+ milliseconds.
  #
  # @param count [Number] how many milliseconds
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.milliseconds(1500).wholeSeconds   # => 1
  let milliseconds(count: Number) -> Duration = Duration { seconds: count / 1000.0 }

  # A span of +count+ seconds.
  #
  # @param count [Number] how many seconds
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.seconds(90).wholeMinutes   # => 1
  let seconds(count: Number) -> Duration = Duration { seconds: count * 1.0 }

  # A span of +count+ minutes.
  #
  # @param count [Number] how many minutes
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.minutes(90).wholeHours   # => 1
  let minutes(count: Number) -> Duration = Duration { seconds: count * 60.0 }

  # A span of +count+ hours.
  #
  # @param count [Number] how many hours
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.hours(2).wholeSeconds   # => 7200
  let hours(count: Number) -> Duration = Duration { seconds: count * 3600.0 }

  # A span of +count+ days, each a fixed 86400 seconds.
  #
  # @param count [Number] how many days
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.days(2).wholeHours   # => 48
  let days(count: Number) -> Duration = Duration { seconds: count * 86400.0 }

  # A span of +count+ weeks, each a fixed 604800 seconds.
  #
  # @param count [Number] how many weeks
  # @return [Duration] the elapsed span
  #
  # @example
  #   Duration.weeks(2).wholeDays   # => 14
  let weeks(count: Number) -> Duration = Duration { seconds: count * 604800.0 }

  # A whole-minute UTC offset, the only kind ISO 8601 can spell.
  #
  # A negative hour or minute puts the whole offset west of UTC, so
  # +utcOffset(-5, 30)+ is five and a half hours behind UTC, not four and a
  # half.
  #
  # @param hours [Integer] the hour part of the offset
  # @param minutes [Integer] the minute part of the offset
  # @return [Duration] the offset
  #
  # @example
  #   Duration.utcOffset(2, 0).wholeSeconds     # => 7200
  #   Duration.utcOffset(-5, 0).wholeSeconds    # => -18000
  #
  # @example Rendering an instant at another offset
  #   moment.at(Duration.utcOffset(-5, 0)).iso
  let utcOffset(hours: Integer, minutes: Integer) -> Duration do
    let magnitude = hours.abs * 3600 + minutes.abs * 60
    return Duration { seconds: 0.0 - (magnitude * 1.0) } if hours < 0 || minutes < 0
    return Duration { seconds: magnitude * 1.0 }
  end
end


# Building calendar spans.
module Period do
  # A span of nothing.
  #
  # @return [Period] the zero span
  #
  # @example
  #   Period.zero().iso     # => "P0D"
  #   Period.zero().zero?   # => true
  let zero() -> Period = Period { years: 0, months: 0, days: 0 }

  # A span of the given years, months and days together.
  #
  # @param years [Integer] whole years
  # @param months [Integer] whole months
  # @param days [Integer] whole days
  # @return [Period] the calendar span
  #
  # @example
  #   Period.of(1, 2, 3).iso   # => "P1Y2M3D"
  let of(years: Integer, months: Integer, days: Integer) -> Period = Period { years: years, months: months, days: days }

  # A span of +count+ calendar years.
  #
  # @param count [Integer] how many years
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2024, 2, 29).try + Period.years(1)).iso   # => "2025-02-28"
  let years(count: Integer) -> Period = Period { years: count, months: 0, days: 0 }

  # A span of +count+ calendar months.
  #
  # @param count [Integer] how many months
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2026, 1, 31).try + Period.months(1)).iso   # => "2026-02-28"
  let months(count: Integer) -> Period = Period { years: 0, months: count, days: 0 }

  # A span of +count+ days, as a calendar step.
  #
  # @param count [Integer] how many days
  # @return [Period] the calendar span
  #
  # @example
  #   Period.days(10).iso   # => "P10D"
  let days(count: Integer) -> Period = Period { years: 0, months: 0, days: count }

  # A span of +count+ weeks, recorded as that many times seven days.
  #
  # @param count [Integer] how many weeks
  # @return [Period] the calendar span
  #
  # @example
  #   Period.weeks(2).iso   # => "P14D"
  let weeks(count: Integer) -> Period = Period { years: 0, months: 0, days: count * 7 }
end

make Period, implement: Inspectable, Showable do
  # Renders the period structurally, for debugging output.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered period
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)

  # Renders the period as its ISO 8601 form, so interpolation and
  # +IO.printLine+ show +P1Y2M3D+.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   "due in ${Period.of(0, 1, 0)}"   # => "due in P1M"
  let showValue -> String = this.iso

  # Adds two calendar spans, field by field.
  #
  # @param other [Period] the span to add
  # @return [Period] the total
  #
  # @example
  #   (Period.of(1, 2, 3) + 1.years).iso   # => "P2Y2M3D"
  let +(other: Period) -> Period = Period { years: this.years + other.years, months: this.months + other.months, days: this.days + other.days }

  # Subtracts a calendar span, field by field. Fields may go negative.
  #
  # @param other [Period] the span to subtract
  # @return [Period] the difference
  #
  # @example
  #   (Period.of(1, 2, 3) - 1.years).iso   # => "P2M3D"
  let -(other: Period) -> Period = Period { years: this.years - other.years, months: this.months - other.months, days: this.days - other.days }

  # The same span with every field's sign flipped: a step backwards.
  #
  # @return [Period] the negated span
  #
  # @example
  #   Period.of(1, 2, 3).negated.iso   # => "P-1Y-2M-3D"
  let negated -> Period = Period { years: 0 - this.years, months: 0 - this.months, days: 0 - this.days }

  # Multiplies every field by +factor+.
  #
  # @param factor [Integer] the factor to multiply by
  # @return [Period] the scaled span
  #
  # @example
  #   (Period.of(1, 2, 3) * 2).iso   # => "P2Y4M6D"
  let *(factor: Integer) -> Period = Period { years: this.years * factor, months: this.months * factor, days: this.days * factor }

  # Returns +true+ when every field is zero.
  #
  # @return [Bool] +true+ for a zero span
  #
  # @example
  #   Period.zero().zero?          # => true
  #   Period.of(0, 1, 0).zero?     # => false
  let zero? -> Bool = this.years == 0 && this.months == 0 && this.days == 0

  # The years and months of the span, as one count of months.
  #
  # Years and months are one quantity for arithmetic: a month is 1/12 of a
  # year exactly, unlike days, which are not a fixed fraction of a month. This
  # is why `date + span` applies them together rather than one after the other.
  #
  # @return [Integer] the total months, ignoring days
  #
  # @example
  #   Period.of(1, 2, 3).totalMonths   # => 14
  let totalMonths -> Integer = this.years * 12 + this.months

  # The same span with excess months carried into years.
  #
  # 14 months becomes 1 year 2 months. Days are left alone: there is no fixed
  # number of them in a month to carry by.
  #
  # @return [Period] the normalised span
  #
  # @example
  #   14.months.normalized.iso   # => "P1Y2M"
  let normalized -> Period do
    let total = this.totalMonths
    return Period { years: (total - total.modulo(12)) / 12, months: total.modulo(12), days: this.days }
  end

  # The span as an ISO 8601 duration, +P1Y2M3D+.
  #
  # A zero period is +P0D+, the shortest spelling the grammar allows: +P+
  # alone is not valid.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   Period.of(1, 2, 3).iso   # => "P1Y2M3D"
  #   Period.zero().iso        # => "P0D"
  #   2.months.iso             # => "P2M"
  let iso -> String do
    return "P0D" if this.zero?
    let years = this.years != 0 then "${this.years}Y" else ""
    let months = this.months != 0 then "${this.months}M" else ""
    let days = this.days != 0 then "${this.days}D" else ""
    return "P${years}${months}${days}"
  end
end


make Date, implement: Inspectable, Showable do
  # Renders the date structurally, for debugging output.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered date
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)

  # Renders the date in ISO form, so interpolation and +IO.printLine+ show
  # +2026-07-30+.
  #
  # @return [String] the ISO 8601 date
  #
  # @example
  #   "due ${Date.of(2026, 7, 30).try}"   # => "due 2026-07-30"
  let showValue -> String = this.iso

  # Days since 1970-01-01, negative before it.
  #
  # The date's identity as a number: comparison and day arithmetic go through
  # it.
  #
  # @return [Integer] days since the Unix epoch
  #
  # @example
  #   Date.of(1970, 1, 1).try.epochDay    # => 0
  #   Date.of(2026, 7, 30).try.epochDay   # => 20664
  let epochDay -> Integer = Time.daysFromCivil(this.year, this.month, this.day)

  # The day of the week this date falls on.
  #
  # @return [Weekday] the day of the week
  #
  # @example
  #   Date.of(2026, 7, 30).try.weekday        # => Thursday
  #   Date.of(2026, 7, 30).try.weekday.name   # => "Thursday"
  let weekday -> Weekday = Time.weekdayFromEpochDay(this.epochDay)

  # The day's position in its year, counting from 1 on January 1st.
  #
  # @return [Integer] the day of the year
  #
  # @example
  #   Date.of(2026, 1, 1).try.dayOfYear    # => 1
  #   Date.of(2026, 7, 30).try.dayOfYear   # => 211
  let dayOfYear -> Integer = this.epochDay - Time.daysFromCivil(this.year, 1, 1) + 1

  # Returns +true+ when this date falls in a leap year.
  #
  # @return [Bool] +true+ in a leap year
  #
  # @example
  #   Date.of(2024, 1, 1).try.leapYear?   # => true
  #   Date.of(2026, 1, 1).try.leapYear?   # => false
  let leapYear? -> Bool = Time.leapYear?(this.year)

  # The number of days in THIS date's month.
  #
  # No Result: a Date's month is in range by construction, unlike
  # `Time.daysInMonth`'s two loose integers.
  #
  # @return [Integer] the length of this month
  #
  # @example
  #   Date.of(2024, 2, 1).try.daysInMonth   # => 29
  #   Date.of(2026, 7, 1).try.daysInMonth   # => 31
  let daysInMonth -> Integer = Time.daysInValidMonth(this.year, this.month)

  # Advances the date by a fixed span, whole days only.
  #
  # A Duration with a sub-day remainder truncates toward zero, so
  # +date + 36.hours+ advances exactly one day. Use a +Period+ when the
  # calendar should get a say.
  #
  # @param span [Duration] the elapsed span to add
  # @return [Date] the later date
  #
  # @example
  #   (Date.of(2026, 7, 30).try + 10.days).iso   # => "2026-08-09"
  #   (Date.of(2026, 7, 30).try + 36.hours).iso  # => "2026-07-31"
  let +(span: Duration) -> Date = Date.fromEpochDay(this.epochDay + span.wholeDays)

  # Moves the date back by a fixed span, whole days only.
  #
  # @param span [Duration] the elapsed span to subtract
  # @return [Date] the earlier date
  #
  # @example
  #   (Date.of(2026, 7, 30).try - 10.days).iso   # => "2026-07-20"
  let -(span: Duration) -> Date = Date.fromEpochDay(this.epochDay - span.wholeDays)

  # Advances the date by a calendar span, so the month length decides the
  # answer.
  #
  # January 31st plus one month is the last day of February. Months are
  # applied before days, and years and months together as one count of
  # months: applying years first would clamp twice and make
  # `2024-02-29 + 1.years + 1.months` land a day off from `+ 13.months`.
  #
  # @param span [Period] the calendar span to add
  # @return [Date] the later date
  #
  # @example
  #   (Date.of(2026, 7, 30).try + 1.months).iso   # => "2026-08-30"
  #   (Date.of(2026, 1, 31).try + 1.months).iso   # => "2026-02-28"
  #   (Date.of(2024, 2, 29).try + 1.years).iso    # => "2025-02-28"
  let +(span: Period) -> Date = this.addMonths(span.totalMonths).addDays(span.days)

  # Moves the date back by a calendar span, with the same clamping as +++.
  #
  # @param span [Period] the calendar span to subtract
  # @return [Date] the earlier date
  #
  # @example
  #   (Date.of(2026, 3, 31).try - 1.months).iso   # => "2026-02-28"
  let -(span: Period) -> Date = this.addMonths(0 - span.totalMonths).addDays(0 - span.days)

  # The date +count+ days later. A negative count moves backwards.
  #
  # @param count [Integer] how many days to add
  # @return [Date] the shifted date
  #
  # @example
  #   Date.of(2026, 7, 30).try.addDays(1).iso    # => "2026-07-31"
  #   Date.of(2026, 7, 30).try.addDays(-1).iso   # => "2026-07-29"
  let addDays(count: Integer) -> Date = Date.fromEpochDay(this.epochDay + count)

  # The date +count+ weeks later. A negative count moves backwards.
  #
  # @param count [Integer] how many weeks to add
  # @return [Date] the shifted date
  #
  # @example
  #   Date.of(2026, 7, 30).try.addWeeks(2).iso   # => "2026-08-13"
  let addWeeks(count: Integer) -> Date = this.addDays(count * 7)

  # No `date.tomorrow`/`date.yesterday` functions: on BEAM a make-block function
  # flattens onto the same name as the `Date.tomorrow()`/`Date.yesterday()`
  # module functions above and one of the two has to win. The module
  # functions win: `Date.tomorrow()` is the spelling people reach for, and
  # `date.addDays(1)` already says the rest.

  # The date +count+ calendar months later, with the day clamped into the
  # target month.
  #
  # One month after January 31st is the last day of February, not March 3rd.
  # A negative count moves backwards.
  #
  # @param count [Integer] how many months to add
  # @return [Date] the shifted date
  #
  # @example
  #   Date.of(2026, 1, 31).try.addMonths(1).iso    # => "2026-02-28"
  #   Date.of(2026, 7, 30).try.addMonths(-1).iso   # => "2026-06-30"
  let addMonths(count: Integer) -> Date do
    let total = this.year * 12 + (this.month - 1) + count
    let month = total.modulo(12) + 1
    let year = (total - total.modulo(12)) / 12
    let last = Time.daysInValidMonth(year, month)
    let day = this.day > last then last else this.day
    return Date { year: year, month: month, day: day }
  end

  # The date +count+ calendar years later, with the day clamped: February
  # 29th plus one year is February 28th.
  #
  # @param count [Integer] how many years to add
  # @return [Date] the shifted date
  #
  # @example
  #   Date.of(2024, 2, 29).try.addYears(1).iso   # => "2025-02-28"
  let addYears(count: Integer) -> Date = this.addMonths(count * 12)

  # The first day of this date's month.
  #
  # @return [Date] the first of the month
  #
  # @example
  #   Date.of(2026, 7, 30).try.startOfMonth.iso   # => "2026-07-01"
  let startOfMonth -> Date = Date { year: this.year, month: this.month, day: 1 }

  # The last day of this date's month, whatever its length.
  #
  # @return [Date] the last of the month
  #
  # @example
  #   Date.of(2026, 7, 30).try.endOfMonth.iso   # => "2026-07-31"
  #   Date.of(2024, 2, 1).try.endOfMonth.iso    # => "2024-02-29"
  let endOfMonth -> Date = Date { year: this.year, month: this.month, day: this.daysInMonth }

  # January 1st of this date's year.
  #
  # @return [Date] the first of the year
  #
  # @example
  #   Date.of(2026, 7, 30).try.startOfYear.iso   # => "2026-01-01"
  let startOfYear -> Date = Date { year: this.year, month: 1, day: 1 }

  # December 31st of this date's year.
  #
  # @return [Date] the last of the year
  #
  # @example
  #   Date.of(2026, 7, 30).try.endOfYear.iso   # => "2026-12-31"
  let endOfYear -> Date = Date { year: this.year, month: 12, day: 31 }

  # The Monday of this date's week.
  #
  # The week runs Monday to Sunday, matching the ISO weekday numbering
  # +weekday.number+ reports.
  #
  # @return [Date] the Monday of this week
  #
  # @example
  #   Date.of(2026, 7, 30).try.startOfWeek.iso   # => "2026-07-27"
  let startOfWeek -> Date = this.addDays(1 - this.weekday.number)

  # The Sunday of this date's week.
  #
  # @return [Date] the Sunday of this week
  #
  # @example
  #   Date.of(2026, 7, 30).try.endOfWeek.iso   # => "2026-08-02"
  let endOfWeek -> Date = this.addDays(7 - this.weekday.number)

  # Whole days from this date to +other+, negative when +other+ is earlier.
  #
  # @param other [Date] the date to measure to
  # @return [Integer] the number of days
  #
  # @example
  #   Date.of(2026, 7, 30).try.daysUntil(Date.of(2026, 8, 9).try)   # => 10
  #   Date.of(2026, 8, 9).try.daysUntil(Date.of(2026, 7, 30).try)   # => -10
  let daysUntil(other: Date) -> Integer = other.epochDay - this.epochDay

  # The span from this date to +other+, as a +Duration+ of whole days.
  #
  # @param other [Date] the date to measure to
  # @return [Duration] the elapsed span
  #
  # @example
  #   Date.of(2026, 7, 30).try.until(Date.of(2026, 8, 9).try).wholeDays   # => 10
  let until(other: Date) -> Duration = Duration.days(this.daysUntil(other))

  # Whole calendar months from this date to +other+, negative when +other+ is
  # earlier.
  #
  # Truncated, not rounded: a partial month does not count, so January 15th to
  # February 14th is 0 months.
  #
  # The count is the exact inverse of `addMonths`, which is why the correction
  # below asks `addMonths` rather than comparing day-of-month fields: January
  # 31st plus one month IS February 28th, so January 31st to February 28th is
  # one month, even though 28 < 31. Comparing the day fields answers 0 there
  # and contradicts the addition this same file performs.
  #
  # @param other [Date] the date to measure to
  # @return [Integer] the number of whole months
  #
  # @example
  #   Date.of(2026, 1, 15).try.monthsUntil(Date.of(2026, 2, 14).try)   # => 0
  #   Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 2, 28).try)   # => 1
  let monthsUntil(other: Date) -> Integer do
    return 0 - other.monthsUntil(this) if other.before?(this)
    let gross = (other.year * 12 + other.month) - (this.year * 12 + this.month)
    return gross - 1 if gross > 0 && this.addMonths(gross).after?(other)
    return gross
  end

  # Whole calendar years from this date to +other+, negative when +other+ is
  # earlier. Truncated, like +monthsUntil+.
  #
  # This is how to compute an age.
  #
  # @param other [Date] the date to measure to
  # @return [Integer] the number of whole years
  #
  # @example
  #   Date.of(2020, 1, 1).try.yearsUntil(Date.of(2026, 7, 30).try)   # => 6
  #
  # @example Someone's age today
  #   born.yearsUntil(Date.today())
  let yearsUntil(other: Date) -> Integer do
    let months = this.monthsUntil(other)
    return (months - months.modulo(12)) / 12 if months >= 0
    return 0 - ((0 - months) - (0 - months).modulo(12)) / 12
  end

  # Returns +true+ when this date is earlier than +other+.
  #
  # @param other [Date] the date to compare against
  # @return [Bool] +true+ when this date comes first
  #
  # @example
  #   Date.of(2026, 7, 30).try.before?(Date.of(2026, 8, 1).try)   # => true
  let before?(other: Date) -> Bool = this.epochDay < other.epochDay

  # Returns +true+ when this date is later than +other+.
  #
  # @param other [Date] the date to compare against
  # @return [Bool] +true+ when this date comes second
  #
  # @example
  #   Date.of(2026, 8, 1).try.after?(Date.of(2026, 7, 30).try)   # => true
  let after?(other: Date) -> Bool = this.epochDay > other.epochDay

  # Orders this date against another.
  #
  # @param other [Date] the date to compare against
  # @return [Ordering] +Less+, +Equal+ or +Greater+
  #
  # @example
  #   Date.of(2026, 7, 30).try.compareTo(Date.of(2026, 8, 1).try)   # => Less
  #
  # @example Sorting dates
  #   dates.sort { |a, b| a.compareTo(b) == Less }
  let compareTo(other: Date) -> Ordering do
    return Less if this.epochDay < other.epochDay
    return Greater if this.epochDay > other.epochDay
    return Equal
  end

  # The date as ISO 8601 text, +2026-07-30+.
  #
  # @return [String] the ISO 8601 date
  #
  # @example
  #   Date.of(2026, 7, 30).try.iso   # => "2026-07-30"
  let iso -> String = Time.formatDate(this)

  # This date at a given time of day and offset, as a +DateTime+.
  #
  # @param time [Time] the time of day
  # @param offset [Duration] the offset from UTC
  # @return [DateTime] the instant
  #
  # @example
  #   Date.of(2026, 7, 30).try.at(Time.of(9, 0, 0).try, Duration.zero()).iso
  #   # => "2026-07-30T09:00:00Z"
  let at(time: Time, offset: Duration) -> DateTime = DateTime { date: this, time: time, offset: offset }
end


make Time, implement: Inspectable, Showable do
  # Renders the time structurally, for debugging output.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered time
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)

  # Renders the time in ISO form, so interpolation and +IO.printLine+ show
  # +14:03:00+.
  #
  # @return [String] the ISO 8601 time
  #
  # @example
  #   "starts at ${Time.of(14, 3, 0).try}"   # => "starts at 14:03:00"
  let showValue -> String = this.iso

  # Seconds from midnight to this time of day, ignoring the nanosecond field.
  #
  # @return [Integer] seconds since midnight
  #
  # @example
  #   Time.of(14, 3, 0).try.secondsSinceMidnight   # => 50580
  let secondsSinceMidnight -> Integer = this.hour * 3600 + this.minute * 60 + this.second

  # Returns +true+ when this time of day is earlier than +other+.
  #
  # @param other [Time] the time to compare against
  # @return [Bool] +true+ when this time comes first
  #
  # @example
  #   Time.of(14, 3, 0).try.before?(Time.of(15, 0, 0).try)   # => true
  let before?(other: Time) -> Bool = this.compareTo(other) == Less

  # Returns +true+ when this time of day is later than +other+.
  #
  # @param other [Time] the time to compare against
  # @return [Bool] +true+ when this time comes second
  #
  # @example
  #   Time.of(15, 0, 0).try.after?(Time.of(14, 3, 0).try)   # => true
  let after?(other: Time) -> Bool = this.compareTo(other) == Greater

  # Advances the time of day by a span, wrapping within the day.
  #
  # A Time has no date to carry into, so 23:00 + 2.hours is 01:00. Reach for
  # +DateTime+ when the day rolling over is something you need to see.
  #
  # Sub-second spans count: the nanoseconds carry into the seconds.
  #
  # @param span [Duration] the elapsed span to add
  # @return [Time] the later time of day
  #
  # @example
  #   (Time.of(14, 3, 0).try + 2.hours).iso            # => "16:03:00"
  #   (Time.of(23, 0, 0).try + 2.hours).iso            # => "01:00:00"
  #   (Time.of(14, 3, 0).try + 500.milliseconds).iso   # => "14:03:00.500"
  let +(span: Duration) -> Time do
    let nanos = this.nanosecond + span.wholeNanoseconds
    let carry = Time.floorDiv(nanos, 1000000000)
    return Time.fromSecondsSinceMidnight(this.secondsSinceMidnight + carry, nanos - carry * 1000000000)
  end

  # Moves the time of day back by a span, wrapping within the day.
  #
  # @param span [Duration] the elapsed span to subtract
  # @return [Time] the earlier time of day
  #
  # @example
  #   (Time.midnight() - 1.seconds).iso   # => "23:59:59"
  let -(span: Duration) -> Time = this + span.negated

  # The time of day +count+ seconds later, wrapping within the day.
  #
  # @param count [Integer] how many seconds to add
  # @return [Time] the shifted time of day
  #
  # @example
  #   Time.of(14, 3, 0).try.addSeconds(60).iso   # => "14:04:00"
  let addSeconds(count: Integer) -> Time = Time.fromSecondsSinceMidnight(this.secondsSinceMidnight + count, this.nanosecond)

  # The time of day +count+ minutes later, wrapping within the day.
  #
  # @param count [Integer] how many minutes to add
  # @return [Time] the shifted time of day
  #
  # @example
  #   Time.of(14, 3, 0).try.addMinutes(30).iso   # => "14:33:00"
  let addMinutes(count: Integer) -> Time = this.addSeconds(count * 60)

  # The time of day +count+ hours later, wrapping within the day.
  #
  # @param count [Integer] how many hours to add
  # @return [Time] the shifted time of day
  #
  # @example
  #   Time.of(23, 0, 0).try.addHours(2).iso   # => "01:00:00"
  let addHours(count: Integer) -> Time = this.addSeconds(count * 3600)

  # Elapsed time from this time of day to +other+, within the same day.
  #
  # Negative when +other+ is earlier. Sub-second precision is kept.
  #
  # @param other [Time] the time to measure to
  # @return [Duration] the elapsed span
  #
  # @example
  #   Time.of(14, 3, 0).try.until(Time.of(15, 3, 0).try).wholeMinutes   # => 60
  let until(other: Time) -> Duration do
    let whole = (other.secondsSinceMidnight - this.secondsSinceMidnight) * 1.0
    let fraction = (other.nanosecond - this.nanosecond) / 1000000000.0
    return Duration { seconds: whole + fraction }
  end

  # The time of day as ISO 8601 text, with fractional seconds only when they
  # are non-zero.
  #
  # @return [String] the ISO 8601 time
  #
  # @example
  #   Time.of(14, 3, 0).try.iso              # => "14:03:00"
  #   Time.of(14, 3, 0, 123456789).try.iso   # => "14:03:00.123456789"
  let iso -> String = Time.formatTime(this)

  # Orders this time of day against another, nanoseconds included.
  #
  # @param other [Time] the time to compare against
  # @return [Ordering] +Less+, +Equal+ or +Greater+
  #
  # @example
  #   Time.of(14, 3, 0).try.compareTo(Time.of(15, 0, 0).try)   # => Less
  let compareTo(other: Time) -> Ordering do
    return Less if this.secondsSinceMidnight < other.secondsSinceMidnight
    return Greater if this.secondsSinceMidnight > other.secondsSinceMidnight
    return Less if this.nanosecond < other.nanosecond
    return Greater if this.nanosecond > other.nanosecond
    return Equal
  end

end


make DateTime, implement: Inspectable, Showable do
  # Renders the instant structurally, for debugging output.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered instant
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)

  # Renders the instant in ISO form, so interpolation and +IO.printLine+ show
  # +2026-07-30T14:03:00+02:00+.
  #
  # @return [String] the ISO 8601 instant
  #
  # @example
  #   "logged at ${DateTime.utcNow()}"   # => "logged at 2026-07-30T12:03:00Z"
  let showValue -> String = this.iso

  # Seconds since the Unix epoch.
  #
  # This is the value to compare and subtract: it identifies the instant,
  # independent of the offset rendering it, so 12:00Z and 14:00+02:00 have the
  # same one.
  #
  # @return [Integer] seconds since the Unix epoch
  #
  # @example
  #   DateTime.parse("1970-01-01T00:00:00Z").try.epochSeconds   # => 0
  #
  # @example Storing an instant as a number
  #   FS.File.write("stamp", "${DateTime.utcNow().epochSeconds}")
  let epochSeconds -> Integer = this.date.epochDay * 86400 + this.time.secondsSinceMidnight - this.offset.wholeSeconds

  # The day of the week this instant falls on, at its own offset.
  #
  # No `year`/`hour`/... shorthands here: a function named after a record field
  # makes `value.year` inside a module function dispatch to it on BEAM and
  # fail with function_clause. Reach through `.date` and `.time`.
  #
  # @return [Weekday] the day of the week
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00Z").try.weekday.name   # => "Thursday"
  let weekday -> Weekday = this.date.weekday

  # The same instant, rendered at another offset.
  #
  # Nothing moves: the wall clock changes because the offset does, and
  # +epochSeconds+ is unchanged.
  #
  # @param offset [Duration] the offset to render at
  # @return [DateTime] the same instant, at that offset
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").try
  #     .at(Duration.utcOffset(-5, 0)).iso
  #   # => "2026-07-30T07:03:00-05:00"
  let at(offset: Duration) -> DateTime = Time.withNanosecond(DateTime.fromEpochSeconds(this.epochSeconds, offset), this.time.nanosecond)

  # The same instant, rendered at UTC.
  #
  # The form to store, compare and transmit: there is no offset to disagree
  # about.
  #
  # @return [DateTime] the same instant, at UTC
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").try.utc.iso
  #   # => "2026-07-30T12:03:00Z"
  let utc -> DateTime = this.at(Duration.zero())

  # Advances the instant by a fixed span, keeping its offset.
  #
  # @param span [Duration] the elapsed span to add
  # @return [DateTime] the later instant
  #
  # @example
  #   (DateTime.parse("2026-07-30T14:03:00Z").try + 90.minutes).iso
  #   # => "2026-07-30T15:33:00Z"
  let +(span: Duration) -> DateTime do
    let nanos = this.time.nanosecond + span.wholeNanoseconds
    let carry = Time.floorDiv(nanos, 1000000000)
    let moved = DateTime.fromEpochSeconds(this.epochSeconds + carry, this.offset)
    return Time.withNanosecond(moved, nanos - carry * 1000000000)
  end

  # Moves the instant back by a fixed span, keeping its offset.
  #
  # @param span [Duration] the elapsed span to subtract
  # @return [DateTime] the earlier instant
  #
  # @example
  #   (DateTime.utcNow() - 24.hours).iso   # yesterday, same wall clock
  let -(span: Duration) -> DateTime = this + span.negated

  # Advances the instant by a calendar span, moving the DATE and leaving the
  # wall clock where it is.
  #
  # 09:00 on January 31st plus one month is 09:00 on February 28th. Going
  # through epoch seconds instead would drift the time of day by whatever the
  # month happened to be worth in seconds.
  #
  # @param span [Period] the calendar span to add
  # @return [DateTime] the later instant
  #
  # @example
  #   (DateTime.parse("2026-07-30T14:03:00+02:00").try + 1.months).iso
  #   # => "2026-08-30T14:03:00+02:00"
  let +(span: Period) -> DateTime = DateTime { date: this.date + span, time: this.time, offset: this.offset }

  # Moves the instant back by a calendar span, keeping the wall clock.
  #
  # @param span [Period] the calendar span to subtract
  # @return [DateTime] the earlier instant
  #
  # @example
  #   (DateTime.parse("2026-07-30T14:03:00Z").try - 1.years).iso
  #   # => "2025-07-30T14:03:00Z"
  let -(span: Period) -> DateTime = DateTime { date: this.date - span, time: this.time, offset: this.offset }

  # The instant +count+ days later, keeping the wall clock and the offset.
  #
  # @param count [Integer] how many days to add
  # @return [DateTime] the shifted instant
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00Z").try.addDays(1).iso
  #   # => "2026-07-31T14:03:00Z"
  let addDays(count: Integer) -> DateTime = DateTime { date: this.date.addDays(count), time: this.time, offset: this.offset }

  # The instant +count+ weeks later, keeping the wall clock and the offset.
  #
  # @param count [Integer] how many weeks to add
  # @return [DateTime] the shifted instant
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00Z").try.addWeeks(1).iso
  #   # => "2026-08-06T14:03:00Z"
  let addWeeks(count: Integer) -> DateTime = this.addDays(count * 7)

  # The instant +count+ calendar months later, with the day clamped into the
  # target month.
  #
  # @param count [Integer] how many months to add
  # @return [DateTime] the shifted instant
  #
  # @example
  #   DateTime.parse("2026-01-31T09:00:00Z").try.addMonths(1).iso
  #   # => "2026-02-28T09:00:00Z"
  let addMonths(count: Integer) -> DateTime = DateTime { date: this.date.addMonths(count), time: this.time, offset: this.offset }

  # The instant +count+ calendar years later, with the day clamped.
  #
  # @param count [Integer] how many years to add
  # @return [DateTime] the shifted instant
  #
  # @example
  #   DateTime.parse("2024-02-29T09:00:00Z").try.addYears(1).iso
  #   # => "2025-02-28T09:00:00Z"
  let addYears(count: Integer) -> DateTime = this.addMonths(count * 12)

  # Elapsed time from this instant to +other+, negative when +other+ is
  # earlier. Sub-second precision is kept.
  #
  # @param other [DateTime] the instant to measure to
  # @return [Duration] the elapsed span
  #
  # @example
  #   started.until(DateTime.utcNow()).wholeSeconds
  #
  # @example Enforcing a deadline
  #   if started.until(DateTime.utcNow()).longerThan?(30.seconds)
  #     IO.printError("timed out")
  #   end
  let until(other: DateTime) -> Duration do
    let whole = (other.epochSeconds - this.epochSeconds) * 1.0
    let fraction = (other.time.nanosecond - this.time.nanosecond) / 1000000000.0
    return Duration { seconds: whole + fraction }
  end

  # Returns +true+ when this instant is earlier than +other+, whatever offsets
  # they are written at.
  #
  # @param other [DateTime] the instant to compare against
  # @return [Bool] +true+ when this instant comes first
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").try
  #     .before?(DateTime.parse("2026-07-31T00:00:00Z").try)
  #   # => true
  let before?(other: DateTime) -> Bool = this.epochSeconds < other.epochSeconds

  # Returns +true+ when this instant is later than +other+.
  #
  # @param other [DateTime] the instant to compare against
  # @return [Bool] +true+ when this instant comes second
  #
  # @example
  #   DateTime.utcNow().after?(started)   # => true
  let after?(other: DateTime) -> Bool = this.epochSeconds > other.epochSeconds

  # The instant as ISO 8601 text, +2026-07-30T14:03:00+02:00+.
  #
  # @return [String] the ISO 8601 instant
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").try.iso
  #   # => "2026-07-30T14:03:00+02:00"
  let iso -> String = Time.formatDateTime(this)

  # Orders this instant against another, by instant rather than by wall
  # clock, so 12:00Z and 14:00+02:00 compare +Equal+.
  #
  # Named `compareTo` rather than `compare`: a make-block `compare` is
  # shadowed by the builtin comparison dispatch and fails at runtime on both
  # backends.
  #
  # @param other [DateTime] the instant to compare against
  # @return [Ordering] +Less+, +Equal+ or +Greater+
  #
  # @example
  #   DateTime.parse("2026-07-30T12:00:00Z").try
  #     .compareTo(DateTime.parse("2026-07-30T14:00:00+02:00").try)
  #   # => Equal
  #
  # @example Sorting events by when they happened
  #   events.sort { |a, b| a.at.compareTo(b.at) == Less }
  let compareTo(other: DateTime) -> Ordering do
    return Less if this.epochSeconds < other.epochSeconds
    return Greater if this.epochSeconds > other.epochSeconds
    return Less if this.time.nanosecond < other.time.nanosecond
    return Greater if this.time.nanosecond > other.time.nanosecond
    return Equal
  end

end

# How +to(String, format)+ writes a date, a time of day or an instant: a
# CLDR pattern such as +"yyyy-MM-dd HH:mm"+, described at +Date.format+.
# Build one with the +Date.format+ tagged literal, or with +DateFormat.parse+,
# which says where a pattern known only at run time goes wrong.
record DateFormat do
  # The CLDR pattern, such as +"yyyy-MM-dd"+.
  pattern : String
end

module DateFormat do
  # One piece of a pattern: a field letter written +width+ times, or text
  # written as it stands.
  type Piece = PatternField(Char, Integer) | PatternText(String)

  # Checks a pattern known only at run time. +Date.format+ describes the
  # patterns.
  #
  # @param pattern [String] the pattern
  # @return [Result<DateFormat, ParseError>] the format, or where the
  #   pattern goes wrong
  #
  # @example
  #   DateFormat.parse("yyyy-MM-dd")   # => Ok(DateFormat { pattern: "yyyy-MM-dd" })
  #   DateFormat.parse("yyyy-QQ")      # => Error(ParseError { position: 5, ... })
  parse : String -> Result<DateFormat, ParseError>
  let parse(pattern) do
    match DateFormat.pieces(pattern) do
      Ok(_) => return Ok(DateFormat { pattern: pattern })
      Error((index, message)) => return Error(ParseError {
        input: pattern,
        position: pattern.take(index).byteSize,
        value: None,
        message: message,
        rest: pattern.drop(index)
      })
    end
  end

  # Splits a pattern into its fields and its literal text. Otherwise the
  # index of its first problem, and what that problem is.
  #
  # @param pattern [String] the pattern
  # @return [Result<[Piece], (Integer, String)>] the pieces, or the problem
  #
  # @example
  #   DateFormat.pieces("d MMM")   # => Ok([PatternField('d', 1), PatternText(" "), PatternField('M', 3)])
  pieces : String -> Result<[Piece], (Integer, String)>
  let pieces(pattern) = scanPattern(pattern.chars, 0, [])

  # Writes +date+, +time+ and +offset+ (whichever the value has) by the
  # pieces of a pattern, with +culture+'s names. +None+ when the pattern
  # asks for a field the value does not have, such as an hour of a +Date+.
  #
  # The +to(String, format)+ functions on +Date+, +Time+ and +DateTime+ are
  # the way to reach this.
  #
  # @param format [DateFormat] the pattern
  # @param date [Date?] the calendar date, when the value has one
  # @param time [Time?] the time of day, when the value has one
  # @param offset [Duration?] the offset from UTC, when the value has one
  # @param culture [Culture] where month, weekday and day-period names come from
  # @return [String?] the text, or +None+
  renderParts : DateFormat -> Date? -> Time? -> Duration? -> Culture -> String?
  let renderParts(format, date, time, offset, culture) do
    match DateFormat.pieces(format.pattern) do
      Error(_) => return None
      Ok(pieces) => do
        let names = Culture.timeNames(culture)
        let parts = pieces.map { |piece| renderPiece(piece, date, time, offset, names) }
        return parts.all?(~set?) then Just(parts.map { |part| part.or("") }.join) else None
      end
    end
  end

  # The pattern a culture writes its dates in: year, month and day in its
  # order, joined by its date separator. ISO order without a time section.
  #
  # @param culture [Culture] the culture
  # @return [String] the pattern, such as +"dd.MM.yyyy"+
  #
  # @example
  #   DateFormat.dateLayout(Culture.of("DE_DE").or(Culture.DEFAULT))   # => "dd.MM.yyyy"
  dateLayout : Culture -> String
  let dateLayout(culture) do
    match culture.time do
      None => return "yyyy-MM-dd"
      Just(settings) => do
        let fields = settings.dateOrder.map { |field| fieldPattern(field) }
        return fields.join(quoted("${settings.dateSeparator}"))
      end
    end
  end

  # The pattern a culture writes a time of day in: hours, minutes and
  # seconds joined by its time separator, on a 12-hour clock with a day
  # period where the culture reads time that way.
  #
  # @param culture [Culture] the culture
  # @return [String] the pattern, such as +"HH:mm:ss"+ or +"h:mm:ss a"+
  #
  # @example
  #   DateFormat.timeLayout(Culture.of("EN_US").or(Culture.DEFAULT))   # => "h:mm:ss a"
  timeLayout : Culture -> String
  let timeLayout(culture) do
    match culture.time do
      None => return "HH:mm:ss"
      Just(settings) => do
        let separator = quoted("${settings.timeSeparator}")
        return "h${separator}mm${separator}ss a" if settings.twelveHour?
        return "HH${separator}mm${separator}ss"
      end
    end
  end

  private do
    # A text piece safe to splice into a pattern: letters are quoted.
    let quoted(text: String) -> String do
      let special = text.chars.any? { |c| c.in?('a'..'z') || c.in?('A'..'Z') || c == '\'' }
      return special then "'${text.replace("'", "''")}'" else text
    end

    let fieldPattern(field: Atom) -> String do
      return "yyyy" if field == :year
      return "MM" if field == :month
      return "dd" if field == :day
      return ""
    end

    # Letters are fields, a quote starts literal text, and anything else is
    # written as it stands.
    let scanPattern(chars: [Char], index: Integer, acc: [Piece]) -> Result<[Piece], (Integer, String)> do
      match chars.first do
        None => return Ok(acc.reverse)
        Just(c) => do
          return quotedText(chars.rest, index + 1, index, "", acc) if c == '\''
          if c.in?('a'..'z') || c.in?('A'..'Z')
            let width = chars.takeWhile { |x| x == c }.count
            if let Just(problem) = fieldProblem(c, width)
              return Error((index, problem))
            end
            return scanPattern(chars.drop(width), index + width, [PatternField(c, width) | acc])
          end
          return scanPattern(chars.rest, index + 1, [PatternText(c.string) | acc])
        end
      end
    end

    # Inside +'...'+: +''+ is one quote, and a lone +'+ closes the text. An
    # empty +''+ outside any text is a quote of its own.
    let quotedText(chars: [Char], index: Integer, start: Integer, text: String, acc: [Piece]) -> Result<[Piece], (Integer, String)> do
      match chars.first do
        None => return Error((start, "quoted text needs its closing `'`"))
        Just(c) => do
          if c == '\''
            if chars.second == Just('\'')
              return quotedText(chars.drop(2), index + 2, start, text + "'", acc)
            end
            let piece = text.empty? then "'" else text
            return scanPattern(chars.rest, index + 1, [PatternText(piece) | acc])
          end
          return quotedText(chars.rest, index + 1, start, text + c.string, acc)
        end
      end
    end

    let fieldProblem(c: Char, width: Integer) -> String? do
      match widestField(c) do
        None => return Just("`${c}` is not a date or time field; quote literal text, as in `'at'`")
        Just(most) => return width > most then Just("`${c}` takes at most ${most} letters") else None
      end
    end

    let widestField(c: Char) -> Integer? do
      return Just(9) if c == 'y' || c == 'S'
      return Just(4) if c == 'M' || c == 'E'
      return Just(3) if c == 'X' || c == 'x'
      return Just(1) if c == 'a'
      return Just(2) if "dHhms".chars.contains?(c)
      return None
    end

    let renderPiece(piece: Piece, date: Date?, time: Time?, offset: Duration?, names: Culture.TimeNames) -> String? do
      match piece do
        PatternText(text) => return Just(text)
        PatternField(c, width) => do
          return date.map { |d| dateField(c, width, d, names) } if "yMdE".chars.contains?(c)
          return time.map { |t| timeField(c, width, t, names) } if "HhmsSa".chars.contains?(c)
          return offset.map { |o| offsetField(c, width, o) }
        end
      end
    end

    let digits(value: Integer, width: Integer) -> String = "${value}".padLeft(width, "0")

    let dateField(c: Char, width: Integer, date: Date, names: Culture.TimeNames) -> String do
      return (width == 2 then digits(date.year.modulo(100), 2) else digits(date.year, width)) if c == 'y'
      return digits(date.day, width) if c == 'd'
      if c == 'M'
        return names.months.get(date.month - 1, "") if width == 4
        return names.shortMonths.get(date.month - 1, "") if width == 3
        return digits(date.month, width)
      end
      let weekday = date.weekday.number - 1
      return width == 4 then names.weekdays.get(weekday, "") else names.shortWeekdays.get(weekday, "")
    end

    let timeField(c: Char, width: Integer, time: Time, names: Culture.TimeNames) -> String do
      return digits(time.hour, width) if c == 'H'
      return digits(time.minute, width) if c == 'm'
      return digits(time.second, width) if c == 's'
      return digits(time.nanosecond, 9).take(width) if c == 'S'
      let (am, pm) = names.dayPeriods
      return (time.hour < 12 then am else pm) if c == 'a'
      let twelve = time.hour.modulo(12)
      return digits(twelve == 0 then 12 else twelve, width)
    end

    # +X+ writes UTC as +Z+, +x+ as +00+; one letter is +HH+ (with +mm+ only
    # when the minutes are not zero), two +HHmm+, three +HH:mm+.
    let offsetField(c: Char, width: Integer, offset: Duration) -> String do
      let total = offset.wholeSeconds
      return "Z" if total == 0 && c == 'X'
      let sign = total < 0 then "-" else "+"
      let magnitude = total.abs
      let hours = digits(magnitude / 3600, 2)
      let minutes = digits(magnitude.modulo(3600) / 60, 2)
      return "${sign}${hours}:${minutes}" if width == 3
      return "${sign}${hours}${minutes}" if width == 2
      return minutes == "00" then "${sign}${hours}" else "${sign}${hours}${minutes}"
    end
  end
end

make Date do
  # Writes the date by a CLDR pattern, with English month and weekday names.
  # Patterns are described at +Date.format+.
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @return [String?] the text, or +None+ when the pattern asks for a time
  #   field, which a date does not have
  #
  # @example
  #   Date.of(2026, 11, 7).try.to(String, Date.format`yyyy-MM-dd`)   # => Just("2026-11-07")
  #   Date.of(2026, 11, 7).try.to(String, Date.format`EEEE, d MMMM yyyy`)
  #   # => Just("Saturday, 7 November 2026")
  let to(String, format: DateFormat) -> String? do
    return DateFormat.renderParts(format, Just(this), None, None, Culture.DEFAULT)
  end

  # Writes the date by a CLDR pattern, with +culture+'s month and weekday
  # names (English names for a culture that carries none).
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @param culture [Culture] where the names come from
  # @return [String?] the text, or +None+
  #
  # @example
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   Date.of(2026, 11, 7).try.to(String, Date.format`yyyy. MMMM d.`, culture: hu)
  #   # => Just("2026. november 7.")
  let to(String, format: DateFormat, culture: Culture) -> String? do
    return DateFormat.renderParts(format, Just(this), None, None, culture)
  end

  # Writes the date the way +culture+ writes dates: its field order and its
  # separator, with two-digit months and days.
  #
  # @param String [Type] the target type
  # @param culture [Culture] the culture to write it for
  # @return [String?] the text
  #
  # @example
  #   Date.of(2026, 11, 7).try.to(String, culture: Culture.of("DE_DE").or(Culture.DEFAULT))
  #   # => Just("07.11.2026")
  let to(String, culture: Culture) -> String? do
    let layout = DateFormat { pattern: DateFormat.dateLayout(culture) }
    return DateFormat.renderParts(layout, Just(this), None, None, culture)
  end
end

make Time do
  # Writes the time of day by a CLDR pattern. Patterns are described at
  # +Date.format+.
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @return [String?] the text, or +None+ when the pattern asks for a date
  #   or an offset field, which a time of day does not have
  #
  # @example
  #   Time.of(14, 3, 0).try.to(String, Date.format`HH:mm`)     # => Just("14:03")
  #   Time.of(14, 3, 0).try.to(String, Date.format`h:mm a`)    # => Just("2:03 PM")
  let to(String, format: DateFormat) -> String? do
    return DateFormat.renderParts(format, None, Just(this), None, Culture.DEFAULT)
  end

  # Writes the time of day by a CLDR pattern, with +culture+'s day-period
  # names.
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @param culture [Culture] where the names come from
  # @return [String?] the text, or +None+
  let to(String, format: DateFormat, culture: Culture) -> String? do
    return DateFormat.renderParts(format, None, Just(this), None, culture)
  end

  # Writes the time of day the way +culture+ does: its separator, on a
  # 12-hour clock where the culture reads time that way.
  #
  # @param String [Type] the target type
  # @param culture [Culture] the culture to write it for
  # @return [String?] the text
  #
  # @example
  #   Time.of(14, 3, 0).try.to(String, culture: Culture.of("EN_US").or(Culture.DEFAULT))
  #   # => Just("2:03:00 PM")
  let to(String, culture: Culture) -> String? do
    let layout = DateFormat { pattern: DateFormat.timeLayout(culture) }
    return DateFormat.renderParts(layout, None, Just(this), None, culture)
  end
end

make DateTime do
  # Writes the instant by a CLDR pattern, as read at its own offset.
  # Patterns are described at +Date.format+.
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @return [String?] the text, or +None+ for a pattern that is not valid
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00+02:00").try.to(String, Date.format`yyyy-MM-dd HH:mm XXX`)
  #   # => Just("2026-07-30 14:03 +02:00")
  let to(String, format: DateFormat) -> String? do
    return DateFormat.renderParts(format, Just(this.date), Just(this.time), Just(this.offset), Culture.DEFAULT)
  end

  # Writes the instant by a CLDR pattern, with +culture+'s names.
  #
  # @param String [Type] the target type
  # @param format [DateFormat] the pattern
  # @param culture [Culture] where the names come from
  # @return [String?] the text, or +None+
  let to(String, format: DateFormat, culture: Culture) -> String? do
    return DateFormat.renderParts(format, Just(this.date), Just(this.time), Just(this.offset), culture)
  end

  # Writes the instant the way +culture+ writes a date and a time of day,
  # separated by a space. The offset is not written.
  #
  # @param String [Type] the target type
  # @param culture [Culture] the culture to write it for
  # @return [String?] the text
  #
  # @example
  #   DateTime.parse("2026-07-30T14:03:00Z").try.to(String, culture: Culture.of("DE_DE").or(Culture.DEFAULT))
  #   # => Just("30.07.2026 14:03:00")
  let to(String, culture: Culture) -> String? do
    let layout = DateFormat {
      pattern: "${DateFormat.dateLayout(culture)} ${DateFormat.timeLayout(culture)}"
    }
    return DateFormat.renderParts(layout, Just(this.date), Just(this.time), Just(this.offset), culture)
  end
end

make Duration, implement: Showable do
  # The span in ISO 8601 form: hours, minutes and seconds, with the
  # fraction of a second written as +iso+ on a +Time+ writes it. A zero span
  # is +PT0S+, and a negative one carries a leading +-+.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   90.minutes.iso          # => "PT1H30M"
  #   500.milliseconds.iso    # => "PT0.500S"
  #   (-2).seconds.iso        # => "-PT2S"
  #   Duration.zero().iso     # => "PT0S"
  iso :> String
  let iso do
    let total = this.wholeNanoseconds
    let sign = total < 0 then "-" else ""
    let span = total.abs
    let hours = span / 3600000000000
    let minutes = span.modulo(3600000000000) / 60000000000
    let nanos = span.modulo(60000000000)
    let fraction = Time.formatFraction(nanos.modulo(1000000000))
    let secondsPart = (nanos == 0) then "" else "${nanos / 1000000000}${fraction}S"
    let hoursPart = hours == 0 then "" else "${hours}H"
    let minutesPart = minutes == 0 then "" else "${minutes}M"
    let body = "${hoursPart}${minutesPart}${secondsPart}"
    return "${sign}PT${body.empty? then "0S" else body}"
  end

  # Shows the span as its ISO 8601 form, as +iso+ writes it, so
  # interpolating a +Duration+ reads as a span rather than as its record.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   "${90.seconds}"   # => "PT1M30S"
  showValue :> String
  let showValue = this.iso
end

make TimeError, implement: Showable do
  # Shows the failure as the sentence +Time.errorMessage+ writes, so
  # +"${e}"+ explains itself rather than printing the constructor.
  #
  # @return [String] the message
  #
  # @example
  #   "${InvalidDate(2026, 13, 1)}"   # => "not a calendar date: 2026-13-1"
  showValue :> String
  let showValue = Time.errorMessage(this)
end
