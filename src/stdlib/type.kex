# Types as values.
#
# +Type.of(x)+ returns the type of a value as a record you can print, compare
# and take apart:
#
#   Type.of(42)                  # => Type { args: [], name: "Integer", pure?: true }
#   Type.of([1, 2]).to(String)   # => Just("[Integer]")
#   Type.of(x) == Type.of(y)     # compares like any record
#   Type.of(due).fieldNames      # => ["year", "month", "day"]
#
# Where it can, the answer comes from the type checker, which knows things a
# value does not carry, such as the error type of an +Ok+ or the element type
# of an empty list. Where the checker has no concrete type (untyped code,
# +--no-check+, a value received from another process), the value itself is
# inspected, and that answer is less complete: an empty list has no element to
# look at, and a +Result+ holds only one side.
record Type<T> do
  # The type's own name, without its arguments: +"Integer"+, +"List"+,
  # +"Point"+.
  name : String

  # The type's arguments. Empty for a plain type, one entry for +[Integer]+,
  # two for +{String: Integer}+.
  args : [Type]

  # +false+ for the type of a +foul+ function, +true+ for every other type.
  pure? : Bool
end

# Building and obtaining +Type+ values.
module Type do
  # Returns the type of +value+.
  #
  # The name of a record or sum type, used as a value, stands for the type
  # itself: +Type.of(User)+ is +User+'s type. A library can take a +Type<T>+
  # parameter this way and so learn its +T+ from the caller.
  #
  # @param value [A] the value to inspect
  # @return [Type<A>] its type, from the checker where it has one
  #
  # @example
  #   Type.of(42)                  # => Type { args: [], name: "Integer", pure?: true }
  #   Type.of([1, 2]).to(String)   # => Just("[Integer]")
  #   Type.of("hi").to(String)     # => Just("String")
  #
  # @example Reporting an unexpected value
  #   IO.printError("expected a list, got ${Type.of(value).to(String)}")
  #
  # @example Taking a type from the caller
  #   let select(as: Type<T>) -> Result<[T], String> do
  #     ...                            # rows decoded with as.construct
  #   end
  #   select(as: User)                 # a Result<[User], String>
  let of(value: A) -> Type<A> = Kex.Intrinsic.Type.ofValue(value)

  # Returns the type with this name and no arguments, for comparing with
  # +Type.of+.
  #
  # @param name [String] the type name
  # @return [Type] the named type
  #
  # @example
  #   Type.of(42) == Type.named("Integer")   # => true
  #
  # @example Checking that a value came back as expected
  #   Type.of(parsed) == Type.named("Date")
  let named(name: String) -> Type = Type { name: name, args: [], pure?: true }

  # Returns the type with this name and these type arguments.
  #
  # @param name [String] the type name
  # @param args [[Type]] its type arguments
  # @return [Type] the generic type
  #
  # @example
  #   Type.of([1]) == Type.generic("List", [Type.named("Integer")])   # => true
  let generic(name: String, args: [Type]) -> Type = Type { name: name, args: args, pure?: true }

  # Returns the function type with these parameter types and result type.
  #
  # @param params [[Type]] the parameter types
  # @param result [Type] the result type
  # @return [Type] the function type
  #
  # @example
  #   Type.function([Type.named("String")], Type.named("String")).to(String)
  #   # => "String -> String"
  let function(params: [Type], result: Type) -> Type = Type { name: "Function", args: params + [result], pure?: true }

  # Returns the return type of a named function, as the checker sees it.
  #
  # Only a named function works. Passing a lambda, a function held in a
  # variable or an overloaded name is a compile error.
  #
  # @param function [Any] a named function
  # @return [Type] its return type
  #
  # @example
  #   Type.returnedBy(Date.parse).to(String)   # => "Result<Date, TimeError>"
  let returnedBy(function: Any) -> Type = Kex.Intrinsic.Type.ofValue(function)

  # Returns a record's field values in declaration order, or +None+ for
  # anything that is not a record.
  #
  # The order is that of +Type.of(record).fields+, so the two zip into
  # name/value pairs. This lets generic code such as an encoder read a record
  # without knowing its type. A tuple is not a record; use its +items+.
  #
  # @param value [Any] the record to read
  # @return [[Any]?] its field values, or +None+
  #
  # @example
  #   Type.fieldValues(Point { x: 1, y: 2 })   # => Just([1, 2])
  #   Type.fieldValues((1, 2))                 # => None
  #
  # @example A record as a map from field names
  #   Type.of(user).fields.map(&.name).zip(Type.fieldValues(user).or([]))
  let fieldValues(value: Any) -> [Any]? = Kex.Intrinsic.Type.recordValues(value)

  # A record field, as +Type.fields+ describes it.
  record Field do
    # The field's name.
    name : String

    # The field's declared type. +Integer?+ is an +Option+ of +Integer+, and a
    # type parameter keeps its own name. An alias is replaced by what it
    # stands for: a field declared +UserId+, with +type UserId = String+, has
    # type +String+.
    valueType : Type

    # Whether the field is declared optional (+T?+), so its value may be
    # +None+.
    optional? : Bool

    # Whether the field has a default, so construction may leave it out.
    default? : Bool
  end

  # A sum type's constructor, as +Type.constructors+ describes it.
  record Constructor do
    # The constructor's name.
    name : String

    # How many arguments it takes. Zero for a bare tag such as +None+.
    arity : Integer

    # The declared types of its arguments, in order.
    argTypes : [Type]
  end

  # Turns the result of a text conversion into a +Result+, with an error
  # naming +expected+ and +text+ when the conversion gave +None+.
  parsed : Any? -> Type -> String -> Result<Any, String>
  let parsed(Just(value), _expected, _text) = Ok(value)
  let parsed(None, expected, text) = Error("expected ${expected.showValue}, got \"${text}\"")

end

make Type.Field do
  # Parses +text+ as a value of this field's declared type, as +Type.parse+
  # does, with the field's name in the error.
  #
  # Use it to turn text from a database row or a form into the typed values
  # +construct+ takes.
  #
  # @param text [String] the text to read
  # @return [Result<Any, String>] the value, or why +text+ is not one
  #
  # @example
  #   Type.named("User").fields.first.map { |field| field.parse("u1") }
  #   # => Just(Ok("u1"))
  let parse(text: String) -> Result<Any, String> do
    match @valueType.parse(text) do
      Ok(value) => Ok(value)
      Error(message) => Error("field \"${@name}\": ${message}")
    end
  end
end

# Reflection functions on runtime type values.
make Type<T> do
  # Returns a record type's fields in declaration order, or +[]+ for anything
  # that is not a record.
  #
  # Each field has its name, its declared type and whether it may be left out.
  # The types are as declared: +Integer?+ is
  # +Type { name: "Option", args: [Integer] }+, and a type parameter keeps its
  # own name.
  #
  # @return [[Type.Field]] the fields, or +[]+
  #
  # @example
  #   Type.of(Point { x: 1, y: 2 }).fields.map(&.name)   # => ["x", "y"]
  #   Type.of(Point { x: 1, y: 2 }).fields.first.map { |f| f.valueType.name }
  #   # => Just("Integer")
  #   Type.of(42).fields                                 # => []
  #
  # @example The fields a decoder may leave out
  #   Type.of(user).fields.filter { |f| f.optional? || f.default? }.map(&.name)
  let fields -> [Type.Field] = Kex.Intrinsic.Type.fieldLayoutsOf(this.name).map do |name, valueType, optional, defaulted|
    Type.Field { name: name, valueType: valueType, optional?: optional, default?: defaulted }
  end

  # Returns a record type's field names in declaration order, or +[]+ for
  # anything that is not a record.
  #
  # @return [[String]] the field names, or +[]+
  #
  # @example
  #   Type.of(Point { x: 1, y: 2 }).fieldNames   # => ["x", "y"]
  #   Type.of(due).fieldNames                    # => ["year", "month", "day"]
  #
  # @example Rendering a record generically
  #   Type.of(value).fieldNames.map { |name| "${name}: ..." }.join(", ")
  let fieldNames -> [String] = Kex.Intrinsic.Type.fieldsOf(this.name)

  # Returns a sum type's constructors in declaration order, each with its name
  # and argument types, or +[]+ for anything that is not a sum type.
  #
  # @return [[Type.Constructor]] the constructors, or +[]+
  #
  # @example
  #   Type.of(Circle(1.0)).constructors.map(&.name)    # => ["Circle", "Square"]
  #   Type.of(Circle(1.0)).constructors.map(&.arity)   # => [1, 2]
  #   Type.of(42).constructors                         # => []
  let constructors -> [Type.Constructor] = Kex.Intrinsic.Type.constructorLayoutsOf(this.name).map do |name, argTypes|
    Type.Constructor { name: name, arity: argTypes.count, argTypes: argTypes }
  end

  # Returns a sum type's constructor names in declaration order, or +[]+ for
  # anything that is not a sum type.
  #
  # @return [[String]] the constructor names, or +[]+
  #
  # @example
  #   Type.of(Circle(1.0)).constructorNames   # => ["Circle", "Square"]
  #
  # @example Listing what a sum type can be
  #   IO.printLine("one of: ${Type.of(shape).constructorNames.join(", ")}")
  let constructorNames -> [String] = Kex.Intrinsic.Type.constructorsOf(this.name)

  # Returns the stored spelling of each constructor without arguments, in
  # snake case and declaration order: +ReadOnly+ is +"read_only"+.
  let constructorValues -> [String] = this.constructors
    .filter { |constructor| constructor.arity == 0 }
    .map { |constructor| constructor.name.snakeCase }

  # Returns the stored spelling of +value+, a constructor of this type without
  # arguments, or +None+ when it is not one.
  let constructorValue(value: Any) -> String? = this.constructors
    .filter { |constructor| constructor.arity == 0 }
    .map(&.name)
    .zip(this.constructorValues)
    .find { |pair| match pair do (name, _) => name == "${value}" end }
    .map { |pair| match pair do (_, spelling) => spelling end }

  # Builds a record of this type from a map of field names to values.
  #
  # Use it in a library that maps data it does not define, such as database
  # rows, decoded JSON or form fields, onto the caller's records. A field
  # missing from +values+ takes its default, or +None+ when it is optional. A
  # missing required field, a key that names no field and a value of the wrong
  # type are each an error naming the field. Values are not converted: +"5"+
  # is not an +Integer+, so convert first, with +Type.Field.parse+ or
  # +"5".to(Integer)+.
  #
  # @param values [{String: Any}] the field values, by field name
  # @return [Result<T, String>] the record, or what was wrong. It is a +User+
  #   for +Type.of(User)+; for a type found by name (+Type.named+) the checker
  #   cannot know +T+, and the value is checked where it is used
  #
  # @example
  #   Type.named("User").construct({"id": "u1", "email": "ada@example.com"})
  #   # => Ok(User { admin?: false, email: "ada@example.com", id: "u1" })
  #   Type.named("User").construct({"id": "u1", "mail": "x"})
  #   # => Error("unknown field \"mail\" for User")
  let construct(values: {String: Any}) -> Result<T, String> = Kex.Intrinsic.Type.construct(this.name, values)

  # Builds the value of this sum type's constructor +name+ from its arguments,
  # for example turning +"Direct"+ read from a database back into +Direct+.
  #
  # The arguments are checked against the constructor's declared types and
  # number.
  #
  # @param name [String] the constructor's name, as +constructorNames+ lists it
  # @param args [[Any]] its arguments; leave them out for a nullary constructor
  # @return [Result<T, String>] the value, or what was wrong
  #
  # @example
  #   Type.named("Kind").variant("Direct")         # => Ok(Direct)
  #   Type.named("Shape").variant("Circle", [2.0]) # => Ok(Circle(2.0))
  #   Type.named("Kind").variant("Nope")           # => Error("Kind has no constructor Nope")
  let variant(name: String, args: [Any]) -> Result<T, String> = Kex.Intrinsic.Type.constructVariant(this.name, name, args)
  let variant(name: String) -> Result<T, String> = Kex.Intrinsic.Type.constructVariant(this.name, name, [])

  # Parses +text+ as a value of this type, for turning text from a database
  # cell, form field or query parameter into a value for +construct+.
  #
  # +String+, +Integer+, +Float+, +Bool+ (+"true"+ or +"false"+) and +Char+
  # (one character) are read as written. +T?+ parses a +T+ and wraps it in
  # +Just+; no text parses as +None+, so leave an absent value out of
  # +construct+'s map. A constructor without arguments is read from its exact
  # name, its name in any case, or its snake-case spelling: +"channel"+ is
  # +Channel+ and +"read_only"+ is +ReadOnly+. A spelling that matches more
  # than one constructor is an error.
  #
  # @param text [String] the text to read
  # @return [Result<T, String>] the value, or why +text+ is not one
  #
  # @example
  #   Type.named("Integer").parse("42")    # => Ok(42)
  #   Type.named("Integer").parse("4x")    # => Error("expected Integer, got \"4x\"")
  #   Type.named("Kind").parse("channel")  # => Ok(Channel)
  let parse(text: String) -> Result<T, String> do
    match this.name do
      "String" => Ok(text)
      "Integer" => Type.parsed(text.to(Integer), this, text)
      "Float" => Type.parsed(text.to(Float), this, text)
      "Bool" => Type.parsed(text == "true" then Just(true) else (text == "false" then Just(false) else None), this, text)
      "Char" => Type.parsed(text.count == 1 then text.at(0) else None, this, text)
      "Option" => match this.args.first do
        Just(inner) => match inner.parse(text) do
          Ok(value) => Ok(Just(value))
          Error(message) => Error(message)
        end
        None => Error("expected ${this.showValue}, got \"${text}\"")
      end
      _ => match this.nullaryNamed(text) do
        Just(name) => this.variant(name)
        None => Error("expected ${this.showValue}, got \"${text}\"")
      end
    end
  end

  private do
    # The nullary constructor +text+ names, including its snake-case value.
    # Exact constructor names take precedence; a normalized spelling must be
    # unambiguous.
    let nullaryNamed(text: String) -> String? do
      let names = this.constructors.filter { |c| c.arity == 0 }.map(&.name)
      let exact = names.find { |name| name == text }
      return exact if exact.set?
      let matches = names.filter { |name| name.lowerCase == text.lowerCase || name.snakeCase == text }
      matches.count == 1 then matches.first else None
    end

  end

  # Returns +true+ when the type is a record with at least one field.
  #
  # @return [Bool] +true+ for a record type
  #
  # @example
  #   Type.of(Point { x: 1, y: 2 }).record?   # => true
  #   Type.of(42).record?                     # => false
  let record? -> Bool = this.fieldNames.count > 0

  # Returns +true+ when the type is a sum type.
  #
  # @return [Bool] +true+ for an ADT
  #
  # @example
  #   Type.of(Circle(1)).adt?   # => true
  #   Type.of(42).adt?          # => false
  let adt? -> Bool = this.constructorNames.count > 0

  # Returns the type as it is written in source, always wrapped in +Just+.
  #
  # A list reads as +[Integer]+, a tuple as +(Integer, String)+, an optional
  # as +String?+, a map as +{String: Integer}+, and a function as its
  # signature.
  #
  # @return [String?] the type, as source
  #
  # @example
  #   Type.of([1, 2]).to(String)      # => Just("[Integer]")
  #   Type.of((1, "a")).to(String)    # => Just("(Integer, String)")
  #   Type.of(Just(1)).to(String)     # => Just("Integer?")
  #   Type.of("hi").to(String)        # => Just("String")
  #
  # @example An error message that names the type
  #   die("cannot serialise a ${Type.of(value)}")
  let to(String) -> String? = Just(this.showValue)

  # Returns the type as it is written in source. String interpolation uses
  # this.
  #
  # @return [String] the type, as source
  #
  # @example
  #   "${Type.of([1, 2])}"   # => "[Integer]"
  let showValue -> String do
    # A function reads as its signature: `String -> String`, `foul () -> Void`.
    if this.name == "Function" && this.args.count > 0
      let arrow = this.args.map(&.showValue).join(" -> ")
      let signature = this.args.count == 1 then "() -> ${arrow}" else arrow
      return "foul ${signature}" if this.pure? == false
      return signature
    end
    return this.name if this.args.count == 0
    let rendered = this.args.map(&.showValue)
    return "[${rendered.at(0).or("?")}]" if this.name == "List" && this.args.count == 1
    return "(${rendered.join(", ")})" if this.name == "Tuple"
    return "${rendered.at(0).or("?")}?" if this.name == "Option" && this.args.count == 1
    return "{${rendered.at(0).or("?")}: ${rendered.at(1).or("?")}}" if this.name == "Map" && this.args.count == 2
    return "${this.name}<${rendered.join(", ")}>"
  end
end
