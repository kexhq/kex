# An optional value: +Just(x)+ carries a value, +None+ says there is none.
#
# +X?+ is shorthand for +Optional<X>+, and is the spelling you will normally
# write. Kex has no +null+: anything that might not produce a value returns
# an +Optional+ instead, so the compiler makes you say what happens when it is
# empty. Most of the time that is a single +.or(default)+ at the end of a
# chain.
#
# @example
#   let names = ["ada", "grace"]
#   names.first.or("nobody")        # => "ada"
#   names.at(9).or("nobody")        # => "nobody"
#   names.first.map(~upperCase)        # => Just("ADA")
#
# Pattern matching handles the cases that need more than a default:
#
# @example
#   match config.get("port") do
#     Just(port) => IO.printLine("listening on ${port}")
#     None       => IO.printLine("no port configured")
#   end
type Optional<X> = Just(X) | None

# The outcome of an operation that can fail: +Ok(x)+ on success,
# +Error(e)+ on failure with a reason.
#
# Use +Result+ over +Optional+ when the *reason* for failure matters to the
# caller. Parsing is the standard example: +"12x".to(Integer)+ answers +None+,
# while +Integer.parse("12x")+ answers an +Error+ that says where it stopped.
# @example
#   Integer.parse("42").or(0)     # => 42
#   Integer.parse("4x").or(0)     # => 0
#
#   match Integer.parse(input) do
#     Ok(n)    => IO.printLine("got ${n}")
#     Error(e) => IO.printError("bad number: ${e}")
#   end
type Result<X, E> = Ok(X) | Error(E)

# One of two values, of possibly different types: +Left(l)+ or +Right(r)+.
#
# Unlike +Result+, neither side means failure: +Either+ is for a value that is
# legitimately one of two shapes.
#
# @example
#   type Id = Either<Integer, String>
#
#   let describe(id: Id) -> String do
#     match id do
#       Left(n)  => "numeric id ${n}"
#       Right(s) => "slug id ${s}"
#     end
#   end
type Either<L, R> = Left(L) | Right(R)

# A value that may be absent. Constrain a generic parameter with it when a
# function accepts any optional value.
#
# The two operations below are what make the constraint worth having: an
# empty trait would accept a value and then let you do nothing with it, since
# there would be no method to call. +map+ is deliberately NOT required — its
# result type differs per implementer (+Y?+ here, +Result<Y, E>+ for
# +Resultable+), which needs a higher-kinded parameter Kex does not have.
trait Optionable do
  # Answers +true+ when a value is present.
  #
  # The one operation an +Optionable+ type must define; +none?+ is its
  # negation.
  #
  # @return [Bool] +true+ for a present value
  #
  # @example
  #   Just(1).set?   # => true
  #   None.set?      # => false
  set? :> Bool

  # Returns the wrapped value, or +default+ when there is none.
  #
  # The way out of the optional world, and the reason a constrained parameter
  # is usable at all.
  #
  # @param default [X] the value to use when absent
  # @return [X] the wrapped value, or +default+
  #
  # @example
  #   Just(42).or(0)   # => 42
  #   None.or(0)       # => 0
  or :> X -> X
end

# A value that either succeeded or failed with a reason. Constrain a generic
# parameter with it when a function accepts any result value.
trait Resultable do
  # Answers +true+ for a success.
  #
  # The one operation a +Resultable+ type must define; +error?+ is its
  # negation.
  #
  # @return [Bool] +true+ for +Ok+
  #
  # @example
  #   Ok(1).ok?         # => true
  #   Error("!").ok?    # => false
  ok? :> Bool

  # Returns the success value, or +default+ on failure.
  #
  # @param default [X] the value to use on failure
  # @return [X] the +Ok+ value, or +default+
  #
  # @example
  #   Ok(42).or(0)       # => 42
  #   Error("!").or(0)   # => 0
  or :> X -> X
end

# One of two values, neither meaning failure. Constrain a generic parameter
# with it when a function accepts any either value.
trait Eitherable do
  # Case analysis: applies +onLeft+ to a +Left+ and +onRight+ to a +Right+.
  #
  # The one operation an +Eitherable+ type must define — +left?+ and +right?+
  # are both written in terms of it. A discriminator alone would let you ask
  # which side a value is on without being able to reach it, which is why this
  # is the requirement rather than those.
  #
  # @param onLeft [L -> A] applied to a +Left+
  # @param onRight [R -> A] applied to a +Right+
  # @return [A] whichever branch ran
  #
  # @example
  #   Left(2).either(~toString, ~upperCase)      # => "2"
  #   Right("ok").either(~toString, ~upperCase)  # => "OK"
  either :> (L -> A) -> (R -> A) -> A
end

make Optional<X>, implement: Optionable do
  # Returns +true+ when a value is present.
  #
  # @return [Bool]
  #
  # @example
  #   Just(42).set?   # => true
  #   None.set?       # => false
  #
  # @example Guarding on presence
  #   let cached = lookup(key)
  #   if cached.set?
  #     IO.printLine("hit")
  #   end
  set? :> Bool
  let set?(@Just(_)) = true
  let set?(@None) = false

  # Returns +true+ when there is no value. The opposite of +set?+.
  #
  # @return [Bool]
  #
  # @example
  #   None.none?       # => true
  #   Just(42).none?   # => false
  #
  # @example Reporting a missing entry
  #   if config.get("host").none?
  #     IO.printError("host is required")
  #   end
  none? :> Bool
  let none?(@Just(_)) = false
  let none?(@None) = true

  # Returns the wrapped value, or +default+ when there is none.
  #
  # This is the usual way an optional leaves the optional world: put +.or+ at
  # the end of a chain and the rest of your code works with a plain value.
  #
  # @param default [X] the value to use when +None+
  # @return [X] the wrapped value, or +default+
  #
  # @example
  #   Just(42).or(0)   # => 42
  #   None.or(0)       # => 0
  #
  # @example Closing a chain of lookups
  #   ["a", "b"].first.or("?")            # => "a"
  #   [].first.or("?")                    # => "?"
  #   "hello".indexOf('z').or(-1)         # => -1
  or :> X -> X
  let or(@Just(x), _) = x
  let or(@None, default) = default

  # Applies +f+ to the wrapped value, keeping the result wrapped. +None+ is
  # returned unchanged, so +f+ never sees a missing value.
  #
  # @param f [X -> Y] applied to the value when present
  # @return [Y?] +Just(f(x))+, or +None+
  #
  # @example
  #   Just(2).map { |x| x * 3 }   # => Just(6)
  #   None.map { |x| x * 3 }      # => None
  #
  # @example Transforming before supplying a default
  #   ["ada"].first.map(~upperCase).or("ANON")   # => "ADA"
  #   [].first.map(~upperCase).or("ANON")        # => "ANON"
  map :> (X -> Y) -> Y?
  let map(@None, _) = None
  let map(@Just(x), f) = Just(f(x))

  # Applies +f+, which itself returns an optional, and flattens the result.
  #
  # Use it instead of +map+ when the step can also fail: +map+ would give you
  # a doubly wrapped +Just(Just(x))+, +flatMap+ gives a single layer. A +None+
  # anywhere in the chain short-circuits the rest.
  #
  # @param f [X -> Y?] the next optional-returning step
  # @return [Y?] the result of +f+, or +None+
  #
  # @example
  #   Just(4).flatMap { |x| x > 0 then Just(x * 2) else None }   # => Just(8)
  #   Just(-4).flatMap { |x| x > 0 then Just(x * 2) else None }  # => None
  #   None.flatMap { |x| Just(x * 2) }                           # => None
  #
  # @example Chaining lookups that may each come up empty
  #   users.get(id)
  #     .flatMap { |user| user.address }
  #     .flatMap { |address| address.postcode }
  #     .or("unknown")
  flatMap :> (X -> Y?) -> Y?
  let flatMap(@None, _) = None
  let flatMap(@Just(x), f) = f(x)
end

make Result<X, E>, implement: Resultable do
  # Returns +true+ when the result is +Ok+.
  #
  # @return [Bool]
  #
  # @example
  #   Ok(42).ok?         # => true
  #   Error("!").ok?     # => false
  #
  # @example Counting successes
  #   inputs.map(~Integer.parse).count(~ok?)
  ok? :> Bool
  let ok?(@Ok(_)) = true
  let ok?(@Error(_)) = false

  # Returns +true+ when the result is +Error+. The opposite of +ok?+.
  #
  # @return [Bool]
  #
  # @example
  #   Error("oops").error?   # => true
  #   Ok(42).error?          # => false
  error? :> Bool
  let error?(@Ok(_)) = false
  let error?(@Error(_)) = true

  # Returns the +Ok+ value, or +default+ when the result is an +Error+.
  #
  # The error payload is discarded. Match on the result instead when you need
  # to report why it failed.
  #
  # @param default [X] the value to use on failure
  # @return [X] the +Ok+ value, or +default+
  #
  # @example
  #   Ok(42).or(0)       # => 42
  #   Error("!").or(0)   # => 0
  #
  # @example Parsing with a fallback
  #   Integer.parse(input).or(8080)
  or :> X -> X
  let or(@Ok(x), _) = x
  let or(@Error(_), default) = default

  # Applies +f+ to the +Ok+ value. An +Error+ passes through untouched, so a
  # chain of +map+ calls describes the success path only.
  #
  # @param f [X -> Y] applied to the value on success
  # @return [Result<Y, E>] +Ok(f(x))+, or the original +Error+
  #
  # @example
  #   Ok(2).map { |x| x * 3 }        # => Ok(6)
  #   Error("oops").map { |x| x }    # => Error("oops")
  #
  # @example Converting a parsed value
  #   Integer.parse("21").map { |n| n * 2 }   # => Ok(42)
  map :> (X -> Y) -> Result<Y, E>
  let map(@Error(e), _) = Error(e)
  let map(@Ok(x), f) = Ok(f(x))

  # Applies +f+, which itself returns a +Result+, and flattens the result.
  #
  # The step-by-step form of +map+ for stages that can fail on their own. The
  # first +Error+ ends the chain and is the answer.
  #
  # @param f [X -> Result<Y, E>] the next fallible step
  # @return [Result<Y, E>] the result of +f+, or the original +Error+
  #
  # @example
  #   Ok(4).flatMap { |x| x > 0 then Ok(x * 2) else Error("neg") }    # => Ok(8)
  #   Ok(-4).flatMap { |x| x > 0 then Ok(x * 2) else Error("neg") }   # => Error("neg")
  #
  # @example A pipeline where each stage may fail
  #   Integer.parse(raw)
  #     .flatMap { |n| n > 0 then Ok(n) else Error("must be positive") }
  #     .flatMap { |n| n < 65536 then Ok(n) else Error("out of range") }
  flatMap :> (X -> Result<Y, E>) -> Result<Y, E>
  let flatMap(@Error(e), _) = Error(e)
  let flatMap(@Ok(x), f) = f(x)

  # Converts the result to an +Optional+, dropping the error payload.
  #
  # Useful when a caller only needs to know whether there is a value, and
  # everything downstream already speaks +Optional+.
  #
  # @return [X?] +Just+ of the +Ok+ value, or +None+
  #
  # @example
  #   Ok(42).optional          # => Just(42)
  #   Error("oops").optional   # => None
  #
  # @example Keeping only the values that parsed
  #   ["1", "x", "3"]
  #     .map { |s| Integer.parse(s).optional }
  #     .filter(~set?)
  #     .map { |o| o.or(0) }    # => [1, 3]
  optional :> X?
  let optional(@Ok(x)) = Just(x)
  let optional(@Error(_)) = None
end

# Converts +value+ to the type +t+, or +None+ if it cannot be represented.
#
# +t+ is a runtime type value: write the type name itself: +String+,
# +Integer+, +Float+, +List+. Conversion to +String+ goes through the
# +Showable+ protocol, so it works for every value.
#
# The result is an +Optional+, not a +Result+, and deliberately so: the reason
# a conversion failed is usually implied by the types alone. When the reason
# carries information (where a parse gave up and on what) reach for
# +Integer.parse+ or +Float.parse+, which answer with
# +Result<_, ParseError>+. So: +to+ for every day, +parse+ when the failure
# needs handling.
#
# @param t [Type] the target type
# @return [A?] the converted value, or +None+
#
# @example Numbers and strings
#   42.to(String)        # => Just("42")
#   "42".to(Integer)     # => Just(42)
#   "4x".to(Integer)     # => None
#   "3.5".to(Float)      # => Just(3.5)
#
# @example Closing the conversion immediately
#   let port = env.get("PORT").flatMap { |s| s.to(Integer) }.or(8080)
let to(value, String) = Just(value.showValue)
let to(value, t) = Kex.Intrinsic.Fun.convertTo(value, t)

# Converts between +Integer+ and +String+ in the given base, 2 through 36.
#
# Digits above 9 are written in lowercase, and accepted in either case when
# reading. Answers +None+ for any other pair of types, or for a radix outside
# 2..36.
#
# @param t [Type] the target type, +String+ or +Integer+
# @param radix [Integer] the base, 2 to 36
# @return [A?] the converted value, or +None+
#
# @example Writing a number in another base
#   255.to(String, radix: 16)    # => Just("ff")
#   255.to(String, radix: 2)     # => Just("11111111")
#
# @example Reading a number written in another base
#   "ff".to(Integer, radix: 16)    # => Just(255)
#   "FF".to(Integer, radix: 16)    # => Just(255)
#   "ff".to(Integer, radix: 10)    # => None
let to(value, t, radix: Integer) = Kex.Intrinsic.Fun.convertTo(value, t, radix)

make Either<L, R>, implement: Eitherable do
  # Case analysis: applies +onLeft+ to a +Left+ and +onRight+ to a +Right+.
  #
  # The way an +Either+ is consumed without a +match+, and the operation
  # +Eitherable+ requires. Both branches answer the same type, so the result
  # is a plain value rather than another +Either+.
  #
  # @param onLeft [L -> A] applied to a +Left+
  # @param onRight [R -> A] applied to a +Right+
  # @return [A] whichever branch ran
  #
  # @example
  #   Left(2).either(~toString, ~upperCase)       # => "2"
  #   Right("ok").either(~toString, ~upperCase)   # => "OK"
  #
  # @example Collapsing an id to text
  #   let render(id: Either<Integer, String>) -> String do
  #     id.either({ |n| "#${n}" }, { |slug| slug })
  #   end
  either :> (L -> A) -> (R -> A) -> A
  let either(@Left(l), onLeft, _) = onLeft(l)
  let either(@Right(r), _, onRight) = onRight(r)

  # Returns +true+ for a +Left+.
  #
  # @return [Bool]
  #
  # @example
  #   Left(1).left?    # => true
  #   Right(1).left?   # => false
  left? :> Bool
  let left?(@Left(_)) = true
  let left?(@Right(_)) = false

  # Returns +true+ for a +Right+. The opposite of +left?+.
  #
  # @return [Bool]
  #
  # @example
  #   Right(1).right?   # => true
  #   Left(1).right?    # => false
  right? :> Bool
  let right?(@Left(_)) = false
  let right?(@Right(_)) = true
end
