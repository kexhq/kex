# An optional value: +Just(x)+ carries a value, +None+ says there is none.
#
# +X?+ is shorthand for +Optional<X>+ and is the usual spelling. Kex has no
# +null+; a function that may have nothing to return returns an +Optional+,
# and the caller has to decide what happens when it is empty. Usually that is
# an +.or(default)+ at the end of a chain.
#
# @example
#   let names = ["ada", "grace"]
#   names.first.or("nobody")        # => "ada"
#   names.at(9).or("nobody")        # => "nobody"
#   names.first.map(~upperCase)     # => Just("ADA")
#
# When a default is not enough, match on the two cases:
#
# @example
#   match config.get("port") do
#     Just(port) => IO.printLine("listening on ${port}")
#     None       => IO.printLine("no port configured")
#   end
type Optional<X> = Just(X) | None

# The outcome of an operation that can fail: +Ok(x)+ on success,
# +Error(e)+ on failure with a reason.
#
# Use +Result+ when the caller needs to know why something failed, and
# +Optional+ when it only needs to know whether it did. +"12x".to(Integer)+
# returns +None+, while +Integer.parse("12x")+ returns
# +Error(Trailing(12, "x"))+, which says where parsing stopped and on what.
#
# @example
#   Integer.parse("42").or(0)     # => 42
#   Integer.parse("4x").or(0)     # => 0
#
#   match Integer.parse(input) do
#     Ok(n)    => IO.printLine("got ${n}")
#     Error(e) => IO.printError("bad number: ${e.message}")
#   end
type Result<X, E> = Ok(X) | Error(E)

# One of two values, of possibly different types: +Left(l)+ or +Right(r)+.
#
# Neither side means failure, as +Error+ does in a +Result+. Use +Either+ for
# a value that can take one of two shapes.
#
# @example
#   type Id = Either<Integer, String>
#
#   let describe(id: Id) -> String do
#     match id do
#       Left(n)  => "numeric id ${n}"
#       Right(s) => "slug id ${s}"
#     end
#   end
type Either<L, R> = Left(L) | Right(R)

# A value that may be absent. Constrain a generic parameter with it when a
# function accepts any optional value.
#
# The trait requires only +set?+ and +or+. It does not require +map+, because
# the result type of +map+ differs between implementers (+Y?+ for an
# +Optional+, +Result<Y, E>+ for a +Result+), and expressing that would need
# a higher-kinded type parameter, which Kex does not have.
trait Optionable do
  # Returns +true+ when a value is present.
  #
  # Every +Optionable+ type must define it; +none?+ is its negation.
  #
  # @return [Bool] +true+ for a present value
  #
  # @example
  #   Just(1).set?   # => true
  #   None.set?      # => false
  set? :> Bool

  # Returns the wrapped value, or +default+ when there is none.
  #
  # @param default [X] the value to use when absent
  # @return [X] the wrapped value, or +default+
  #
  # @example
  #   Just(42).or(0)   # => 42
  #   None.or(0)       # => 0
  or :> X -> X
end

# A value that either succeeded or failed with a reason. Constrain a generic
# parameter with it when a function accepts any result value.
trait Resultable do
  # Returns +true+ for a success.
  #
  # Every +Resultable+ type must define it; +error?+ is its negation.
  #
  # @return [Bool] +true+ for +Ok+
  #
  # @example
  #   Ok(1).ok?         # => true
  #   Error("!").ok?    # => false
  ok? :> Bool

  # Returns the success value, or +default+ on failure.
  #
  # @param default [X] the value to use on failure
  # @return [X] the +Ok+ value, or +default+
  #
  # @example
  #   Ok(42).or(0)       # => 42
  #   Error("!").or(0)   # => 0
  or :> X -> X
end

# One of two values, neither meaning failure. Constrain a generic parameter
# with it when a function accepts any either value.
trait Eitherable do
  # Applies +onLeft+ to a +Left+ or +onRight+ to a +Right+ and returns the
  # result.
  #
  # Every +Eitherable+ type must define it. The trait requires this, and not
  # +left?+ or +right?+, because those only say which side a value is on;
  # +either+ also hands over the value.
  #
  # @param onLeft [L -> A] applied to a +Left+
  # @param onRight [R -> A] applied to a +Right+
  # @return [A] whichever branch ran
  #
  # @example
  #   Left(2).either(~showValue, ~upperCase)      # => "2"
  #   Right("ok").either(~showValue, ~upperCase)  # => "OK"
  either :> (L -> A) -> (R -> A) -> A
end

make Optional<X>, implement: Optionable, Functor, Bindable, Monad, Applicable do
  # Returns +true+ when a value is present.
  #
  # @return [Bool]
  #
  # @example
  #   Just(42).set?   # => true
  #   None.set?       # => false
  #
  # @example Guarding on presence
  #   let cached = lookup(key)
  #   if cached.set?
  #     IO.printLine("hit")
  #   end
  set? :> Bool
  let set?(@Just(_)) = true
  let set?(@None) = false

  # Returns +true+ when there is no value; the opposite of +set?+.
  #
  # @return [Bool]
  #
  # @example
  #   None.none?       # => true
  #   Just(42).none?   # => false
  #
  # @example Reporting a missing entry
  #   if config.get("host").none?
  #     IO.printError("host is required")
  #   end
  none? :> Bool
  let none?(@Just(_)) = false
  let none?(@None) = true

  # Returns the wrapped value, or +default+ when there is none.
  #
  # This is the usual way to end a chain of optional steps: the code after
  # +.or+ works with a plain value.
  #
  # @param default [X] the value to use when +None+
  # @return [X] the wrapped value, or +default+
  #
  # @example
  #   Just(42).or(0)   # => 42
  #   None.or(0)       # => 0
  #
  # @example Closing a chain of lookups
  #   ["a", "b"].first.or("?")            # => "a"
  #   [].first.or("?")                    # => "?"
  #   "hello".indexOf('z').or(-1)         # => -1
  or :> X -> X
  let or(@Just(x), _) = x
  let or(@None, default) = default

  # Applies +f+ to the wrapped value and wraps the result. On +None+, +f+ is
  # not called and +None+ is returned.
  #
  # @param f [X -> Y] applied to the value when present
  # @return [Y?] +Just(f(x))+, or +None+
  #
  # @example
  #   Just(2).map { |x| x * 3 }   # => Just(6)
  #   None.map { |x| x * 3 }      # => None
  #
  # @example Transforming before supplying a default
  #   ["ada"].first.map(~upperCase).or("ANON")   # => "ADA"
  #   [].first.map(~upperCase).or("ANON")        # => "ANON"
  map :> (X -> Y) -> Y?
  let map(@None, _) = None
  let map(@Just(x), f) = Just(f(x))

  # Applies +f+, which itself returns an optional, and returns its result.
  #
  # Use it for a step that can come up empty: +map+ would give a nested
  # +Just(Just(x))+. Once a step returns +None+, the later steps do not run.
  #
  # @param f [X -> Y?] the next optional-returning step
  # @return [Y?] the result of +f+, or +None+
  #
  # @example
  #   Just(4).into { |x| x > 0 then Just(x * 2) else None }   # => Just(8)
  #   Just(-4).into { |x| x > 0 then Just(x * 2) else None }  # => None
  #   None.into { |x| Just(x * 2) }                           # => None
  #
  # @example Chaining lookups that may each come up empty
  #   users.get(id)
  #     .into { |user| user.address }
  #     .into { |address| address.postcode }
  #     .or("unknown")
  into :> (X -> Y?) -> Y?
  let into(@None, _) = None
  let into(@Just(x), f) = f(x)

  # Applies +f+ to this value and +other+'s when both are present, and
  # returns +None+ otherwise. This is +Applicable+'s +with+.
  #
  # @param other [Y?] the second optional
  # @param f [X -> Y -> Z] combines the two values
  # @return [Z?] +Just+ the combined value, or +None+
  #
  # @example
  #   Just(1).with(Just(2)) { |a, b| a + b }   # => Just(3)
  #   Just(1).with(None) { |a, b| a + b }      # => None
  with :> Y? -> (X -> Y -> Z) -> Z?
  let with(@None, _, _) = None
  let with(@Just(_), None, _) = None
  let with(@Just(a), Just(b), f) = Just(f(a, b))

  # Returns +Just(value)+. This is +Monad+'s +wrap+.
  #
  # @param value [Y] the value to wrap
  # @return [Y?] +Just(value)+
  #
  # @example
  #   Optional.wrap(1)   # => Just(1)
  let wrap(value: Y) -> Y? = Just(value)

  # Keeps the value only when +pred+ accepts it, and returns +None+ otherwise.
  #
  # @param pred [X -> Bool] the test the value must pass
  # @return [X?] the value, or +None+
  #
  # @example
  #   Just(4).filter { |n| n.even? }   # => Just(4)
  #   Just(3).filter { |n| n.even? }   # => None
  filter :> (X -> Bool) -> X?
  let filter(@None, _) = None
  let filter(@Just(x), pred) = pred(x) then Just(x) else None
end

make Result<X, E>, implement: Resultable do
  # Returns +true+ when the result is +Ok+.
  #
  # @return [Bool]
  #
  # @example
  #   Ok(42).ok?         # => true
  #   Error("!").ok?     # => false
  #
  # @example Counting successes
  #   inputs.map(~Integer.parse).count(~ok?)
  ok? :> Bool
  let ok?(@Ok(_)) = true
  let ok?(@Error(_)) = false

  # Returns +true+ when the result is +Error+; the opposite of +ok?+.
  #
  # @return [Bool]
  #
  # @example
  #   Error("oops").error?   # => true
  #   Ok(42).error?          # => false
  error? :> Bool
  let error?(@Ok(_)) = false
  let error?(@Error(_)) = true

  # Returns the +Ok+ value, or +default+ when the result is an +Error+.
  #
  # The error is discarded. To report why it failed, match on the result.
  #
  # @param default [X] the value to use on failure
  # @return [X] the +Ok+ value, or +default+
  #
  # @example
  #   Ok(42).or(0)       # => 42
  #   Error("!").or(0)   # => 0
  #
  # @example Parsing with a fallback
  #   Integer.parse(input).or(8080)
  or :> X -> X
  let or(@Ok(x), _) = x
  let or(@Error(_), default) = default

  # Applies +f+ to the +Ok+ value. An +Error+ is returned as it is, and +f+ is
  # not called.
  #
  # @param f [X -> Y] applied to the value on success
  # @return [Result<Y, E>] +Ok(f(x))+, or the original +Error+
  #
  # @example
  #   Ok(2).map { |x| x * 3 }        # => Ok(6)
  #   Error("oops").map { |x| x }    # => Error("oops")
  #
  # @example Converting a parsed value
  #   Integer.parse("21").map { |n| n * 2 }   # => Ok(42)
  map :> (X -> Y) -> Result<Y, E>
  let map(@Error(e), _) = Error(e)
  let map(@Ok(x), f) = Ok(f(x))

  # Applies +f+, which itself returns a +Result+, and returns its result.
  #
  # Use it to chain steps that can each fail. The first +Error+ ends the chain
  # and is what the chain returns.
  #
  # @param f [X -> Result<Y, E>] the next fallible step
  # @return [Result<Y, E>] the result of +f+, or the original +Error+
  #
  # @example
  #   Ok(4).into { |x| x > 0 then Ok(x * 2) else Error("neg") }    # => Ok(8)
  #   Ok(-4).into { |x| x > 0 then Ok(x * 2) else Error("neg") }   # => Error("neg")
  #
  # @example A pipeline where each stage may fail
  #   Integer.parse(raw)
  #     .into { |n| n > 0 then Ok(n) else Error("must be positive") }
  #     .into { |n| n < 65536 then Ok(n) else Error("out of range") }
  into :> (X -> Result<Y, E>) -> Result<Y, E>
  let into(@Error(e), _) = Error(e)
  let into(@Ok(x), f) = f(x)

  # Applies +f+ to this success and +other+'s, or returns the first error.
  # This is +Applicable+'s +with+.
  #
  # @param other [Result<Y, E>] the second result
  # @param f [X -> Y -> Z] combines the two values
  # @return [Result<Z, E>] +Ok+ the combined value, or the first +Error+
  #
  # @example
  #   Ok(1).with(Ok(2)) { |a, b| a + b }           # => Ok(3)
  #   Ok(1).with(Error("no")) { |a, b| a + b }     # => Error("no")
  with :> Result<Y, E> -> (X -> Y -> Z) -> Result<Z, E>
  let with(@Error(e), _, _) = Error(e)
  let with(@Ok(_), Error(e), _) = Error(e)
  let with(@Ok(a), Ok(b), f) = Ok(f(a, b))

  # Converts the result to an +Optional+, dropping the error.
  #
  # Use it when the caller only cares whether there is a value, or the code
  # that follows works with optionals.
  #
  # @return [X?] +Just+ of the +Ok+ value, or +None+
  #
  # @example
  #   Ok(42).optional          # => Just(42)
  #   Error("oops").optional   # => None
  #
  # @example Keeping only the values that parsed
  #   ["1", "x", "3"]
  #     .map { |s| Integer.parse(s).optional }
  #     .filter(~set?)
  #     .map { |o| o.or(0) }    # => [1, 3]
  optional :> X?
  let optional(@Ok(x)) = Just(x)
  let optional(@Error(_)) = None

  # Applies +f+ to the error and leaves a success alone; +map+ for the error
  # side.
  #
  # @param f [E -> F] applied to the error
  # @return [Result<X, F>] the same +Ok+, or +Error(f(e))+
  #
  # @example
  #   Error(404).mapError { |code| "HTTP ${code}" }   # => Error("HTTP 404")
  #   Ok(1).mapError { |code| "HTTP ${code}" }        # => Ok(1)
  mapError :> (E -> F) -> Result<X, F>
  let mapError(@Ok(x), _) = Ok(x)
  let mapError(@Error(e), f) = Error(f(e))

  # Returns the error wrapped in +Just+, or +None+ for a success; the
  # counterpart of +optional+.
  #
  # @return [E?] the error, or +None+
  #
  # @example
  #   Error("bad").error   # => Just("bad")
  #   Ok(1).error          # => None
  error :> E?
  let error(@Ok(_)) = None
  let error(@Error(e)) = Just(e)
end

# Makes +Result+ a +Functor+, +Bindable+, +Monad+ and +Applicable+ over its
# success value, with the error type +E+ fixed. The +map+ and +into+ above
# are the ones these traits use.
make Result<_, E>, implement: Functor, Bindable, Monad, Applicable do
  # Returns +Ok(value)+. This is +Monad+'s +wrap+.
  #
  # @param value [Y] the success value
  # @return [Result<Y, E>] +Ok(value)+
  #
  # @example
  #   Result.wrap(1)   # => Ok(1)
  let wrap(value: Y) -> Result<Y, E> = Ok(value)
end

# The outcome of several independent checks: +Valid+ with the value, or
# +Invalid+ with every failure. Combining +Result+s stops at the first error;
# combining +Validation+s with +with+ collects all of them, so a form or a
# config file can report every problem at once:
#
#   let checkedName(name: String) -> Validation<String, String> do
#     return name.empty? then Invalid(["name is empty"]) else Valid(name)
#   end
#
#   checkedName("").with(checkedEmail("x")) do |n, e|
#     Signup { name: n, email: e }
#   end
#   # => Invalid(["name is empty", "email has no @"])
#
# +Validation+ is +Applicable+ but not a +Monad+. A chained step needs the
# previous value, which a failure does not have, so chaining could only stop
# at the first failure.
type Validation<T, E> = Valid(T) | Invalid([E])

make Validation<X, E> do
  # Applies +f+ to the value when valid, and leaves the failures of an
  # +Invalid+ as they are.
  #
  # @param f [X -> Y] applied to a valid value
  # @return [Validation<Y, E>] +Valid(f(x))+, or the same failures
  #
  # @example
  #   Valid(2).map { |n| n * 10 }   # => Valid(20)
  map :> (X -> Y) -> Validation<Y, E>
  let map(@Valid(x), f) = Valid(f(x))
  let map(@Invalid(errors), _) = Invalid(errors)

  # Applies +f+ to this value and +other+'s when both are valid. Otherwise it
  # returns the failures of both, this one's first. This is +Applicable+'s
  # +with+.
  #
  # @param other [Validation<Y, E>] the second validation
  # @param f [X -> Y -> Z] combines the two values
  # @return [Validation<Z, E>] +Valid+ the combined value, or every failure
  #
  # @example
  #   Valid(1).with(Valid(2)) { |a, b| a + b }                   # => Valid(3)
  #   Invalid(["a"]).with(Invalid(["b"])) { |a, b| a + b }       # => Invalid(["a", "b"])
  with :> Validation<Y, E> -> (X -> Y -> Z) -> Validation<Z, E>
  let with(@Valid(a), Valid(b), f) = Valid(f(a, b))
  let with(@Valid(_), Invalid(theirs), _) = Invalid(theirs)
  let with(@Invalid(mine), Valid(_), _) = Invalid(mine)
  let with(@Invalid(mine), Invalid(theirs), _) = Invalid(mine + theirs)

  # Converts to a +Result+: +Ok+ with the value, or +Error+ with the list of
  # failures.
  #
  # @return [Result<X, [E]>] the value, or every failure
  #
  # @example
  #   Invalid(["a", "b"]).toResult   # => Error(["a", "b"])
  let toResult -> Result<X, [E]> = match this do
    Valid(x) => Ok(x)
    Invalid(errors) => Error(errors)
  end
end

make Validation<_, E>, implement: Functor, Applicable do
  # Returns +Valid(value)+. This is +Applicable+'s +wrap+.
  #
  # @param value [Y] the value
  # @return [Validation<Y, E>] +Valid(value)+
  #
  # @example
  #   Validation.wrap(1)   # => Valid(1)
  let wrap(value: Y) -> Validation<Y, E> = Valid(value)
end

# Converts +value+ to the type +t+, or +None+ if it cannot be represented.
#
# Pass the type name itself as +t+: +String+, +Integer+, +Float+, +List+.
# Conversion to +String+ uses +showValue+, so it works for every value.
#
# Most failed conversions need no explanation, so +to+ returns an
# +Optional+. When you need to know where a parse gave up and on what, use
# +Integer.parse+ or +Float.parse+, which return a +Result+ with a
# +ParseError+.
#
# @param t [Type] the target type
# @return [A?] the converted value, or +None+
#
# @example Numbers and strings
#   42.to(String)        # => Just("42")
#   "42".to(Integer)     # => Just(42)
#   "4x".to(Integer)     # => None
#   "3.5".to(Float)      # => Just(3.5)
#
# @example Closing the conversion immediately
#   let port = env.get("PORT").into { |s| s.to(Integer) }.or(8080)
to : A -> Type<T> -> T?
let to(value: Any, String) = Just(value.showValue)
let to(value: Any, t) = Kex.Intrinsic.Fun.convertTo(value, t)

# Converts between +Integer+ and +String+ in the given base, 2 through 36.
#
# Digits above 9 are written in lowercase, and read in either case. Returns
# +None+ for any other pair of types, or for a radix outside 2..36.
#
# @param t [Type] the target type, +String+ or +Integer+
# @param radix [Integer] the base, 2 to 36
# @return [A?] the converted value, or +None+
#
# @example Writing a number in another base
#   255.to(String, radix: 16)    # => Just("ff")
#   255.to(String, radix: 2)     # => Just("11111111")
#
# @example Reading a number written in another base
#   "ff".to(Integer, radix: 16)    # => Just(255)
#   "FF".to(Integer, radix: 16)    # => Just(255)
#   "ff".to(Integer, radix: 10)    # => None
to : A -> Type<T> -> Integer -> T?
let to(value: Any, t, radix: Integer) = Kex.Intrinsic.Fun.convertTo(value, t, radix)

# Renders a number as a +String+ in the given culture, with its decimal
# separator and digit grouping. Returns +None+ for an invalid culture (see
# +Culture.valid?+).
#
# Needs +using Culture+ at the call site.
#
# @param t [Type] the target type, +String+
# @param culture [Culture] the culture to render with
# @return [String?] the text, or +None+ for an invalid culture
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   (1500.5).to(String, culture: hu)              # => Just("1\u{A0}500,5")
let to(value: Any, t, culture: Culture) = Culture.renderNumber(value.showValue, culture)

# Renders a number with a digit pattern and a culture's separators. The
# pattern sets the precision as in +to(String, format)+, and the culture
# supplies the symbols. Returns +None+ for an invalid pattern or an invalid
# culture.
#
# Needs +using Culture+ at the call site.
#
# @param t [Type] the target type, +String+
# @param format [NumberFormat] the pattern
# @param culture [Culture] the culture to render with
# @return [String?] the text, or +None+ for an invalid pattern or culture
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   (1234.5).to(String, Number.format`#.00`, culture: hu)              # => Just("1\u{A0}234,50")
let to(value: Any, t: Type<String>, format: NumberFormat, culture: Culture) -> String? do
  match value.to(String, format) do
    Just(text) => Culture.renderNumber(text, culture)
    None => None
  end
end

make Either<L, R>, implement: Eitherable do
  # Applies +onLeft+ to a +Left+ or +onRight+ to a +Right+ and returns the
  # result.
  #
  # Use it to turn an +Either+ into one value without a +match+. Both
  # functions return the same type +A+.
  #
  # @param onLeft [L -> A] applied to a +Left+
  # @param onRight [R -> A] applied to a +Right+
  # @return [A] whichever branch ran
  #
  # @example
  #   Left(2).either(~showValue, ~upperCase)       # => "2"
  #   Right("ok").either(~showValue, ~upperCase)   # => "OK"
  #
  # @example Collapsing an id to text
  #   let render(id: Either<Integer, String>) -> String do
  #     id.either({ |n| "#${n}" }, { |slug| slug })
  #   end
  either :> (L -> A) -> (R -> A) -> A
  let either(@Left(l), onLeft, _) = onLeft(l)
  let either(@Right(r), _, onRight) = onRight(r)

  # Returns +true+ for a +Left+.
  #
  # @return [Bool]
  #
  # @example
  #   Left(1).left?    # => true
  #   Right(1).left?   # => false
  left? :> Bool
  let left?(@Left(_)) = true
  let left?(@Right(_)) = false

  # Returns +true+ for a +Right+; the opposite of +left?+.
  #
  # @return [Bool]
  #
  # @example
  #   Right(1).right?   # => true
  #   Left(1).right?    # => false
  right? :> Bool
  let right?(@Left(_)) = false
  let right?(@Right(_)) = true
end
