# +X?+ is shorthand for +Optional<X>+.
# +Just(x)+ wraps a value; +None+ represents absence.
type Optional<X> = Just(X) | None

# +Result<X, E>+ represents a computation that either succeeded with +Ok(x)+
# or failed with +Error(e)+.
type Result<X, E> = Ok(X) | Error(E)

# +Either<L, R>+ holds one of two possible value types.
type Either<L, R> = Left(L) | Right(R)

# Marker traits used by generic code that accepts one of these ADT families.
# Their conformances are exported through KexI like any user-defined trait.
trait Optionable do
end

trait Resultable do
end

trait Eitherable do
end

make Optional<X>, implement: Optionable do
  # Returns +true+ if this optional has value.
  #
  # @return [Bool]
  #
  # @example
  #   Just(42).set?    # => true
  #   None.set?        # => false
  set? :> Bool
  let set?(@Just(_)) = true
  let set?(@None) = false

  # Returns +true+ if this optional is empty.
  #
  # @return [Bool]
  #
  # @example
  #   None.none?       # => true
  #   Just(42).none?   # => false
  none? :> Bool
  let none?(@Just(_)) = false
  let none?(@None) = true

  # Unwraps the value, returning +default+ when +None+.
  #
  # @param default [X]
  # @return [X]
  #
  # @example
  #   Just(42).or(0)   # => 42
  #   None.or(0)       # => 0
  or :> X -> X
  let or(@Just(x), _) = x
  let or(@None, default) = default

  # Applies +f+ to the wrapped value, leaving +None+ unchanged.
  #
  # @param f [X -> Y]
  # @return [Y?]
  #
  # @example
  #   Just(2).map { |x| x * 3 }   # => Just(6)
  #   None.map { |x| x * 3 }      # => None
  map :> (X -> Y) -> Y?
  let map(@None, _) = None
  let map(@Just(x), f) = Just(f(x))

  # Chains optional-returning functions, short-circuiting on +None+.
  #
  # @param f [X -> Y?]
  # @return [Y?]
  #
  # @example
  #   Just(4).flatMap { |x| x > 0 then Just(x * 2) else None }   # => Just(8)
  #   None.flatMap { |x| Just(x * 2) }                           # => None
  flatMap :> (X -> Y?) -> Y?
  let flatMap(@None, _) = None
  let flatMap(@Just(x), f) = f(x)
end

make Result<X, E>, implement: Resultable do
  # Returns +true+ if the result is +Ok+.
  #
  # @return [Bool]
  #
  # @example
  #   Ok(42).ok?      # => true
  #   Error("!").ok?  # => false
  ok? :> Bool
  let ok?(@Ok(_)) = true
  let ok?(@Error(_)) = false

  # Returns +true+ if the result is +Error+.
  #
  # @return [Bool]
  #
  # @example
  #   Error("oops").error?   # => true
  #   Ok(42).error?          # => false
  error? :> Bool
  let error?(@Ok(_)) = false
  let error?(@Error(_)) = true

  # Unwraps the +Ok+ value, returning +default+ on +Error+.
  #
  # @param default [X]
  # @return [X]
  #
  # @example
  #   Ok(42).or(0)       # => 42
  #   Error("!").or(0)   # => 0
  or :> X -> X
  let or(@Ok(x), _) = x
  let or(@Error(_), default) = default

  # Applies +f+ to the +Ok+ value, passing +Error+ through unchanged.
  #
  # @param f [X -> Y]
  # @return [Result<Y, E>]
  #
  # @example
  #   Ok(2).map { |x| x * 3 }      # => Ok(6)
  #   Error("oops").map { |x| x }   # => Error("oops")
  map :> (X -> Y) -> Result<Y, E>
  let map(@Error(e), _) = Error(e)
  let map(@Ok(x), f) = Ok(f(x))

  # Chains result-returning functions, propagating +Error+.
  #
  # @param f [X -> Result<Y, E>]
  # @return [Result<Y, E>]
  #
  # @example
  #   Ok(4).flatMap { |x| x > 0 then Ok(x * 2) else Error("neg") }   # => Ok(8)
  flatMap :> (X -> Result<Y, E>) -> Result<Y, E>
  let flatMap(@Error(e), _) = Error(e)
  let flatMap(@Ok(x), f) = f(x)

  # Converts to +Optional+, discarding the error value on failure.
  #
  # @return [X?]
  #
  # @example
  #   Ok(42).toOptional        # => Just(42)
  #   Error("oops").toOptional # => None
  toOptional :> X?
  let toOptional(@Ok(x)) = Just(x)
  let toOptional(@Error(_)) = None
end

# Universal `.or(default)` catch-all: a value that is neither Optional nor
# Result is already a successful result — return it unchanged.
let or(value, _) = value

# Universal `.to(Type)` conversion. The type argument is a runtime Type
# value (e.g. String, Integer, Float, List). Returns an Optional result.
#
# Optional, NOT Result, and deliberately: `to` is the everyday conversion, and
# what it can report on failure is almost always derivable from the types
# alone — `x.to(List)` on a non-list fails because a non-list is not a list,
# which an error payload saying "cannot convert Int to List" does not improve.
# When the reason IS information — where a parse gave up and on what —
# `Integer.parse`/`Float.parse` answer with `Result<_, ParseError>`. So:
# `to` for every day, `parse` when the failure needs handling.
#
# A String target goes through the Showable protocol, exactly as
# `make Showable do let to(String) = Just(this.showValue)` says it does. The
# intrinsic below renders the raw runtime term instead, which on BEAM never
# reached the `Optional` implementation of showValue: `Just(42).to(String)`
# answered `Just("Just(42)")` there and `Just("42")` on the tree walker, which
# dispatches to the Showable clause. Intrinsics cannot call back into the
# prelude (dependency_layering_test), so the protocol has to be honoured here.
let to(value, String) = Just(value.showValue)
let to(value, t) = Kex.Intrinsic.Fun.convertTo(value, t)

# Base-aware conversion between Integer and String, in base 2..36:
#
#   255.to(String, radix: 16)    # => Just("ff")
#   "ff".to(Integer, radix: 16)  # => Just(255)
#
# Digits above 9 are lowercase on the way out and accepted in either case on
# the way in. None for any other type pair, or a radix outside 2..36.
let to(value, t, radix: Integer) = Kex.Intrinsic.Fun.convertTo(value, t, radix)

make Either<L, R>, implement: Eitherable do
end
