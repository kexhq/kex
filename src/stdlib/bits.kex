# Bitwise operations on +Integer+.
#
#   Bits.and(0xff, 0x0f)      # => 15
#   Bits.shiftLeft(1, 8)      # => 256
#   Bits.test?(0b1010, 1)     # => true
#
# Reach for these to pack flags into one number or to read a binary format or
# protocol that defines its fields in bits.
#
# Integers have no fixed width. A negative one acts as an infinitely long
# two's complement number, so +Bits.not(0)+ is +-1+ and +Bits.and(-1, 255)+ is
# +255+, and nothing overflows. Bit positions count from 0, the least
# significant bit, and a negative position raises an error.
module Bits do
  # Returns the bitwise AND of +a+ and +b+.
  #
  # @param a [Integer] the first operand
  # @param b [Integer] the second operand
  # @return [Integer] the bits set in both
  #
  # @example
  #   Bits.and(0b1100, 0b1010)   # => 8
  #   Bits.and(0xff, 0x0f)       # => 15
  #
  # @example Masking off the low byte of a value
  #   Bits.and(value, 0xff)
  #
  # @example Testing whether a flag is present in a bitmask
  #   Bits.and(flags, READONLY) != 0
  and : Integer -> Integer -> Integer
  let and(a, b) = Kex.Intrinsic.Bits.and(a, b)

  # Returns the bitwise OR of +a+ and +b+.
  #
  # @param a [Integer] the first operand
  # @param b [Integer] the second operand
  # @return [Integer] the bits set in either
  #
  # @example
  #   Bits.or(0b1100, 0b1010)   # => 14
  #
  # @example Combining flags into one value
  #   Bits.or(Bits.or(READ, WRITE), APPEND)
  or : Integer -> Integer -> Integer
  let or(a, b) = Kex.Intrinsic.Bits.or(a, b)

  # Returns the bitwise exclusive OR of +a+ and +b+.
  #
  # @param a [Integer] the first operand
  # @param b [Integer] the second operand
  # @return [Integer] the bits set in exactly one of them
  #
  # @example
  #   Bits.xor(0b1100, 0b1010)   # => 6
  #
  # @example Toggling a set of flags
  #   Bits.xor(flags, VERBOSE)
  xor : Integer -> Integer -> Integer
  let xor(a, b) = Kex.Intrinsic.Bits.xor(a, b)

  # Returns the bitwise complement of +a+, which is always +-(a + 1)+.
  #
  # Integers have no fixed width, so there is no mask of 8, 32 or 64 bits; use
  # +Bits.xor(a, 0xff)+ to flip only the low byte.
  #
  # @param a [Integer] the operand
  # @return [Integer] the complement
  #
  # @example
  #   Bits.not(0)   # => -1
  #   Bits.not(5)   # => -6
  not : Integer -> Integer
  let not(a) = Kex.Intrinsic.Bits.not(a)

  # Returns +n+ shifted left by +by+ bits. Raises an error if +by+ is negative.
  #
  # @param n [Integer] the value to shift
  # @param by [Integer] how many bits to shift by
  # @return [Integer] the shifted value
  #
  # @example
  #   Bits.shiftLeft(1, 8)   # => 256
  #   Bits.shiftLeft(3, 2)   # => 12
  #
  # @example Building a flag constant for bit n
  #   Bits.shiftLeft(1, n)
  shiftLeft : Integer -> Integer -> Integer
  let shiftLeft(n, by) = Kex.Intrinsic.Bits.shiftLeft(n, by)

  # Returns +n+ shifted right by +by+ bits, keeping its sign.
  #
  # A negative number stays negative, so +Bits.shiftRight(-1, 5)+ is +-1+.
  # Raises an error if +by+ is negative.
  #
  # @param n [Integer] the value to shift
  # @param by [Integer] how many bits to shift by
  # @return [Integer] the shifted value
  #
  # @example
  #   Bits.shiftRight(256, 8)   # => 1
  #   Bits.shiftRight(-8, 1)    # => -4
  shiftRight : Integer -> Integer -> Integer
  let shiftRight(n, by) = Kex.Intrinsic.Bits.shiftRight(n, by)

  # Returns whether the bit at +index+ of +n+ is set. Raises an error if
  # +index+ is negative.
  #
  # @param n [Integer] the value to inspect
  # @param index [Integer] the bit position, counting from 0
  # @return [Bool] +true+ when that bit is set
  #
  # @example
  #   Bits.test?(0b1000, 3)   # => true
  #   Bits.test?(0b1000, 0)   # => false
  test? : Integer -> Integer -> Bool
  let test?(n, index) = Kex.Intrinsic.Bits.test?(n, index)

  # Returns +n+ with the bit at +index+ set. Raises an error if +index+ is
  # negative.
  #
  # @param n [Integer] the value to modify
  # @param index [Integer] the bit position, counting from 0
  # @return [Integer] the modified value
  #
  # @example
  #   Bits.set(0, 3)   # => 8
  set : Integer -> Integer -> Integer
  let set(n, index) = Kex.Intrinsic.Bits.set(n, index)

  # Returns +n+ with the bit at +index+ cleared. Raises an error if +index+ is
  # negative.
  #
  # @param n [Integer] the value to modify
  # @param index [Integer] the bit position, counting from 0
  # @return [Integer] the modified value
  #
  # @example
  #   Bits.clear(0b1111, 0)   # => 14
  clear : Integer -> Integer -> Integer
  let clear(n, index) = Kex.Intrinsic.Bits.clear(n, index)

  # Returns +n+ with the bit at +index+ flipped. Raises an error if +index+ is
  # negative.
  #
  # @param n [Integer] the value to modify
  # @param index [Integer] the bit position, counting from 0
  # @return [Integer] the modified value
  #
  # @example
  #   Bits.toggle(0b1010, 0)   # => 11
  toggle : Integer -> Integer -> Integer
  let toggle(n, index) = Kex.Intrinsic.Bits.toggle(n, index)

  # Returns the number of set bits in +n+, its population count.
  #
  # A negative number has infinitely many set bits, so it raises an error.
  #
  # @param n [Integer] the value to measure
  # @return [Integer] the count
  #
  # @example
  #   Bits.count(0b1011)   # => 3
  #   Bits.count(255)      # => 8
  #
  # @example How many flags are set
  #   Bits.count(flags)
  count : Integer -> Integer
  let count(n) = Kex.Intrinsic.Bits.count(n)

  # Returns the number of bits needed to write +n+: the position of its highest
  # set bit plus one.
  #
  # +Bits.width(0)+ is +0+. A negative number raises an error.
  #
  # @param n [Integer] the value to measure
  # @return [Integer] the count
  #
  # @example
  #   Bits.width(0)     # => 0
  #   Bits.width(255)   # => 8
  #   Bits.width(256)   # => 9
  width : Integer -> Integer
  let width(n) = Kex.Intrinsic.Bits.width(n)
end
