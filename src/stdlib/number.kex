# Whole numbers, of arbitrary size.
#
# +Integer+ has no width limit, so a factorial or a cryptographic modulus is
# an +Integer+ like any other.
#
# +Integer+ and +Float+ compare and sort together: +0 == 0.0+ is +true+ and
# +[1, 2.5, 3].sort+ works. Their arithmetic differs. +/+ on two integers is
# integer division, and +sqrt+ always returns a +Float+.
#
#   7 / 2          # => 3      (integer division)
#   7.0 / 2.0      # => 3.5
#   16.sqrt        # => 4.0    (a Float, even from an Integer)
#   (-7).modulo(3) # => 2      (mathematical modulo, not C remainder)
make Integer do
  # Returns +true+ when the integer is divisible by two. Zero is even, and
  # negative numbers follow the same rule.
  #
  # @return [Bool] +true+ for an even integer
  #
  # @example
  #   4.even?      # => true
  #   3.even?      # => false
  #   (-2).even?   # => true
  #
  # @example Splitting a list into evens and odds
  #   [1, 2, 3, 4].partition { |n| n.even? }   # => ([2, 4], [1, 3])
  even? :> Bool
  let even? = this.modulo(2) == 0

  # Returns +true+ when the integer is not divisible by two. The opposite of
  # +even?+.
  #
  # @return [Bool] +true+ for an odd integer
  #
  # @example
  #   3.odd?   # => true
  #   4.odd?   # => false
  odd? :> Bool
  let odd? = this.modulo(2) != 0

  # Returns +true+ when the integer divides evenly by +n+.
  #
  # Zero is divisible by every non-zero integer. Nothing is divisible by
  # zero, not even zero.
  #
  # @param n [Integer] the divisor
  # @return [Bool] +true+ when the integer divides evenly by +n+
  #
  # @example
  #   10.dividesBy?(5)   # => true
  #   10.dividesBy?(3)   # => false
  #   5.dividesBy?(0)    # => false
  #
  # @example FizzBuzz without spelling out the remainder
  #   if i.dividesBy?(15)
  #     IO.printLine("FizzBuzz")
  #   elif i.dividesBy?(3)
  #     IO.printLine("Fizz")
  #   elif i.dividesBy?(5)
  #     IO.printLine("Buzz")
  #   end
  dividesBy? :> Integer -> Bool
  let dividesBy?(0) = false
  let dividesBy?(n) = this.modulo(n) == 0

  # Returns the magnitude of the integer, discarding its sign.
  #
  # @return [Integer] the absolute value
  #
  # @example
  #   (-5).abs   # => 5
  #   5.abs      # => 5
  #
  # @example Distance between two positions
  #   (a - b).abs
  abs :> Integer
  let abs = Kex.Intrinsic.Number.abs(this)

  # Returns the square root as a +Float+.
  #
  # The result is a +Float+ even when the root is exact. Round or floor it
  # to get an integer back.
  #
  # @return [Float] the square root
  #
  # @example
  #   16.sqrt          # => 4.0
  #   2.sqrt           # => 1.4142135623730951
  #   16.sqrt.round    # => 4
  sqrt :> Float
  let sqrt = Kex.Intrinsic.Number.sqrt(this)

  # Returns +this+ modulo +n+.
  #
  # The result takes the sign of +n+, unlike the C-style remainder, so
  # +(-1).modulo(3)+ is +2+. That makes it the one to use for wrapping an
  # index that may have gone negative.
  #
  # @param n [Integer] the modulus
  # @return [Integer] the remainder, with the sign of +n+
  #
  # @example
  #   7.modulo(3)      # => 1
  #   (-7).modulo(3)   # => 2
  #
  # @example Wrapping an index around a list
  #   let items = ["a", "b", "c"]
  #   items.at((-1).modulo(items.count))   # => Just("c")
  modulo :> Integer -> Integer
  let modulo(n) = Kex.Intrinsic.Integer.modulo(this, n)

  # Returns +true+ when the integer falls inside +range+, endpoints included.
  #
  # @param range [Range<Integer>] the inclusive range
  # @return [Bool] +true+ when the integer is in range
  #
  # @example
  #   5.in?(1..10)    # => true
  #   11.in?(1..10)   # => false
  #
  # @example Validating a port number
  #   port.in?(1..65535)
  in? :> Range<Integer> -> Bool
  let in?(range) = range.contains?(this)

  # Calls +f+ exactly +this+ times, passing the 0-based iteration index.
  #
  # When the loop is about the numbers themselves, +(1..n).each+ often
  # reads better.
  #
  # @param f [Integer -> Void] called once per iteration with the index
  # @return [Void]
  #
  # @example
  #   3.times { |i| IO.printLine(i) }   # prints 0, then 1, then 2
  #
  # @example Repeating an action
  #   retries.times { |_| attemptConnection }
  #
  # @example Repeating an action that needs no index
  #   3.times do
  #     IO.printLine("hi")
  #   end
  times :> (Integer -> Void) -> Void
  times :> Block<Void> -> Void
  let times(block) do
    match Kex.Intrinsic.Kex.backend() do
      Kex.Interpreter => Kex.Intrinsic.Integer.times(this, block)
      _ => 0.countTo(this, block)
    end
  end

  # Returns the range from this integer down to +last+, both included,
  # counting by -1. It is empty when +last+ is larger.
  #
  # @param last [Integer] the last element
  # @return [Range<Integer>] the descending range
  #
  # @example
  #   10.downTo(7).items   # => [10, 9, 8, 7]
  #   1.downTo(3).items    # => []
  #
  # @example Counting down
  #   3.downTo(1).each { |n| IO.printLine(n) }   # prints 3, 2, 1
  downTo :> Integer -> Range<Integer>
  let downTo(last) = (this..last).by(-1)

  # Returns the integer unchanged, so code that floors a +Number+ works on
  # integers too.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.floor   # => 7
  floor :> Integer
  let floor = Kex.Intrinsic.Number.floor(this)

  # Returns the integer unchanged. The +Integer+ counterpart of
  # +Float.ceil+.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.ceil   # => 7
  ceil :> Integer
  let ceil = Kex.Intrinsic.Number.ceil(this)

  # Returns the integer unchanged. The +Integer+ counterpart of
  # +Float.round+.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.round   # => 7
  round :> Integer
  let round = Kex.Intrinsic.Number.round(this)

  # Raises the integer to an integer power, exactly. +2.pow(100)+ is the
  # whole 31-digit number; +Math.pow+ returns a +Float+.
  #
  # A negative exponent gives the reciprocal truncated toward zero, as +/+
  # does: +0+ for any base but +1+ and +-1+.
  #
  # @param exponent [Integer] the power to raise to
  # @return [Integer] +this+ multiplied by itself +exponent+ times
  #
  # @example
  #   2.pow(10)    # => 1024
  #   2.pow(100)   # => 1267650600228229401496703205376
  #   (-3).pow(3)  # => -27
  pow :> Integer -> Integer
  let pow(exponent) do
    return 1 / this.pow(0 - exponent) if exponent < 0
    return 1 if exponent == 0
    let half = this.pow(exponent / 2)
    return exponent.even? then half * half else half * half * this
  end

  # Divides and rounds toward negative infinity, the quotient that goes with
  # +modulo+. Plain +/+ truncates toward zero, so the two differ when the
  # signs differ. Ruby's +/+ on integers behaves like this one.
  #
  # @param n [Integer] the divisor, non-zero
  # @return [Integer] the floored quotient
  #
  # @example
  #   7.div(2)      # => 3
  #   (-7).div(2)   # => -4   (-7 / 2 is -3)
  div :> Integer -> Integer
  let div(n) do
    let quotient = this / n
    return (this.modulo(n) != 0 && (this < 0) != (n < 0)) then quotient - 1 else quotient
  end

  # Returns the floored quotient and the +modulo+ remainder together, so
  # +q * n + r == this+ always holds.
  #
  # @param n [Integer] the divisor, non-zero
  # @return [(Integer, Integer)] +(this.div(n), this.modulo(n))+
  #
  # @example
  #   7.divmod(2)      # => (3, 1)
  #   (-7).divmod(2)   # => (-4, 1)
  divmod :> Integer -> (Integer, Integer)
  let divmod(n) = (this.div(n), this.modulo(n))

  # Returns the greatest common divisor, never negative. +0.gcd(0)+ is +0+.
  #
  # @param n [Integer] the other integer
  # @return [Integer] the largest integer dividing both
  #
  # @example
  #   12.gcd(18)    # => 6
  #   (-4).gcd(6)   # => 2
  gcd :> Integer -> Integer
  let gcd(n) = n == 0 then this.abs else n.gcd(this.modulo(n))

  # Returns the least common multiple, never negative. It is +0+ when
  # either integer is zero.
  #
  # @param n [Integer] the other integer
  # @return [Integer] the smallest positive integer both divide
  #
  # @example
  #   4.lcm(6)   # => 12
  lcm :> Integer -> Integer
  let lcm(n) = (this == 0 || n == 0) then 0 else (this * n).abs / this.gcd(n)

  # Returns the decimal digits of the integer's magnitude, least significant
  # first, as Ruby's +digits+ does. +.reverse+ gives reading order.
  #
  # @return [[Integer]] the digits, ones place first
  #
  # @example
  #   1234.digits           # => [4, 3, 2, 1]
  #   0.digits              # => [0]
  #   1234.digits.reverse   # => [1, 2, 3, 4]
  digits :> [Integer]
  let digits do
    let n = this.abs
    return [n] if n < 10
    [n.modulo(10)] + (n / 10).digits
  end

  # Returns +true+ for zero.
  #
  # @example
  #   0.zero?   # => true
  zero? :> Bool
  let zero? = this == 0

  # Returns +true+ when the number is greater than zero.
  #
  # @example
  #   0.positive?   # => false
  positive? :> Bool
  let positive? = this > 0

  # Returns +true+ when the number is less than zero.
  #
  # @example
  #   0.negative?   # => false
  negative? :> Bool
  let negative? = this < 0

  private do
    # +times+ when compiled: +block+ applied to each index from this one up
    # to +limit+, a recursion the specialize-blocks pass copies into the
    # caller with the block in place.
    let countTo(limit, block) do
      if this < limit
        block(this)
        (this + 1).countTo(limit, block)
      end
    end
  end
end

# Double-precision floating-point numbers.
#
# A Kex +Float+ is always finite. An operation that would produce +NaN+ or
# +Infinity+ raises, so there is no +nan?+ to check for.
#
# +Float+ and +Integer+ compare and sort together; see +Integer+.
#
#   3.7.floor      # => 3
#   3.7.round      # => 4
#   (-3.7).toInteger  # => -3   (truncates toward zero)
make Float do
  # Returns the magnitude of the float, discarding its sign.
  #
  # @return [Float] the absolute value
  #
  # @example
  #   (-3.14).abs   # => 3.14
  #   3.14.abs      # => 3.14
  #
  # @example An approximate-equality test
  #   (a - b).abs < 0.0001
  abs :> Float
  let abs = Kex.Intrinsic.Number.abs(this)

  # Returns the square root. Raises for a negative float.
  #
  # @return [Float] the square root
  #
  # @example
  #   25.0.sqrt   # => 5.0
  #   2.0.sqrt    # => 1.4142135623730951
  sqrt :> Float
  let sqrt = Kex.Intrinsic.Number.sqrt(this)

  # Returns +true+ when the float falls inside +range+, endpoints included.
  #
  # @param range [Range<Float>] the inclusive range
  # @return [Bool] +true+ when the float is in range
  #
  # @example
  #   0.75.in?(0.0..1.0)   # => true
  #   1.5.in?(0.0..1.0)    # => false
  in? :> Range<Float> -> Bool
  let in?(range) = range.contains?(this)

  # Returns the largest integer not greater than the float. It rounds toward
  # negative infinity, so for negative values it differs from +toInteger+.
  #
  # @return [Integer] the floor
  #
  # @example
  #   3.7.floor      # => 3
  #   3.2.floor      # => 3
  #   (-3.2).floor   # => -4
  floor :> Integer
  let floor = Kex.Intrinsic.Number.floor(this)

  # Returns the smallest integer not less than the float.
  #
  # @return [Integer] the ceiling
  #
  # @example
  #   3.2.ceil       # => 4
  #   3.0.ceil       # => 3
  #   (-3.7).ceil    # => -3
  #
  # @example How many pages of a fixed size a list needs
  #   (items.count.to(Float).or(0.0) / 20.0).ceil
  ceil :> Integer
  let ceil = Kex.Intrinsic.Number.ceil(this)

  # Returns the nearest integer, with halves rounding away from zero.
  #
  # @return [Integer] the rounded value
  #
  # @example
  #   3.2.round    # => 3
  #   3.5.round    # => 4
  #   3.7.round    # => 4
  round :> Integer
  let round = Kex.Intrinsic.Number.round(this)

  # Drops the fractional part and returns an +Integer+. For negative values
  # this differs from +floor+.
  #
  # @return [Integer] the truncated value
  #
  # @example
  #   3.7.toInteger      # => 3
  #   (-3.7).toInteger   # => -3   (floor would give -4)
  toInteger :> Integer
  let toInteger = Kex.Intrinsic.Number.toInteger(this)

  # Returns +true+ for zero.
  #
  # @example
  #   2.5.zero?   # => false
  zero? :> Bool
  let zero? = this == 0.0

  # Returns +true+ when the number is greater than zero.
  #
  # @example
  #   2.5.positive?   # => true
  positive? :> Bool
  let positive? = this > 0.0

  # Returns +true+ when the number is less than zero.
  #
  # @example
  #   2.5.negative?   # => false
  negative? :> Bool
  let negative? = this < 0.0
end

# Reading integers out of text.
#
# +"42".to(Integer)+ returns an +Optional+. Use +parse+ when the caller needs
# to know why the text is not a number: its +ParseError+ has one case per
# reason.
module Integer do
  # Parses +text+ as an integer: an optional sign, then digits in +radix+.
  # Group separators must follow +culture+'s grouping; digits with no
  # separator read in every culture.
  #
  # A number followed by other text is a +Trailing+ error carrying the number
  # and the rest, so matching on it reads a number off the front of +"10 USD"+.
  #
  # @param text [String] the text to read
  # @param radix [Integer] the base, 2 to 36; digits above 9 in either case
  # @param culture [Culture] whose group separator to accept
  # @return [Result<Integer, ParseError<Integer>>] the integer, or why not
  #
  # @example
  #   Integer.parse("42")                 # => Ok(42)
  #   Integer.parse("ff", radix: 16)      # => Ok(255)
  #   Integer.parse("10 USD")             # => Error(Trailing(10, " USD"))
  #   Integer.parse("abc")                # => Error(NoDigits(0))
  # @example In a culture
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   Integer.parse("1 500", culture: hu)   # => Ok(1500)
  #   Integer.parse("1500", culture: hu)    # => Ok(1500)
  #   Integer.parse("1 50", culture: hu)    # => Error(BadGrouping(2))
  # @example Reading a setting with a fallback
  #   let port = Integer.parse(raw).or(8080)
  let parse(text: String, radix: Integer = 10, culture: Culture = Culture.DEFAULT) -> Result<Integer, ParseError<Integer>> do
    # Plain digits read the same in every culture: only the rest is scanned.
    match Culture.valid?(culture) then Kex.Intrinsic.Integer.fromDigits(text, radix) else None do
      Just(value) => Ok(value)
      None => Number.readNumber(text, culture, radix, false) { |digits, _| Kex.Intrinsic.Integer.fromDigits(digits, radix) }
    end
  end
end

# Reading floating-point numbers out of text.
module Float do
  # Parses +text+ as a float: an optional sign, digits (grouped by
  # +culture+'s rules if separators appear), an optional decimal part after
  # the culture's decimal separator, and an optional exponent (+e3+, +E-2+).
  # A whole number parses too: +"5"+ gives +5.0+.
  #
  # @param text [String] the text to read
  # @param culture [Culture] whose decimal and group separators to accept
  # @return [Result<Float, ParseError<Float>>] the float, or why not
  #
  # @example
  #   Float.parse("3.5")       # => Ok(3.5)
  #   Float.parse("1e3")       # => Ok(1000.0)
  #   Float.parse("12.5kg")    # => Error(Trailing(12.5, "kg"))
  #   Float.parse("1e999")     # => Error(OutOfRange)
  # @example In a culture
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   Float.parse("1,44", culture: hu)   # => Ok(1.44)
  let parse(text: String, culture: Culture = Culture.DEFAULT) -> Result<Float, ParseError<Float>> do
    # Canonical text reads the same in every culture with a "." decimal
    # point: only the rest is scanned.
    match culture.numbers.decimalSeparator == '.' && Culture.valid?(culture) then Kex.Intrinsic.Float.fromDigits(text) else None do
      Just(value) => Ok(value)
      None => Number.readNumber(text, culture, 10, true) { |digits, tail| Kex.Intrinsic.Float.fromDigits(digits + tail) }
    end
  end

  # The largest finite +Float+.
  #
  # Kex has no float infinity, so this is the starting value for a running
  # minimum.
  #
  # @return [Float] 1.7976931348623157e308
  #
  # @example
  #   let smallest = readings.reduce(Float.MAX) { |low, x| x < low then x else low }
  MAX : Float
  let MAX = 1.7976931348623157e308

  # The most negative finite +Float+, +-Float.MAX+. Some languages use MIN
  # for the smallest positive float; Kex does not.
  #
  # @return [Float] -1.7976931348623157e308
  MIN : Float
  let MIN = -1.7976931348623157e308
end

# The range of a 32-bit float. As for every sized float type, +MIN+ is the
# most negative finite value.
module Float32 do
  # The largest Float32: 3.4028234663852886e38.
  MAX : Float32
  let MAX = 3.4028234663852886e38

  # The most negative finite Float32: -3.4028234663852886e38.
  MIN : Float32
  let MIN = -3.4028234663852886e38
end

# The range of a 64-bit float, the same as a +Float+.
module Float64 do
  # The largest Float64: 1.7976931348623157e308.
  MAX : Float64
  let MAX = 1.7976931348623157e308

  # The most negative finite Float64: -1.7976931348623157e308.
  MIN : Float64
  let MIN = -1.7976931348623157e308
end

# The range of a signed 8-bit integer.
module Int8 do
  # The largest Int8: 127.
  MAX : Int8
  let MAX = 127

  # The smallest Int8: -128.
  MIN : Int8
  let MIN = -128
end

# The range of a signed 16-bit integer.
module Int16 do
  # The largest Int16: 32767.
  MAX : Int16
  let MAX = 32767

  # The smallest Int16: -32768.
  MIN : Int16
  let MIN = -32768
end

# The range of a signed 32-bit integer.
module Int32 do
  # The largest Int32: 2147483647.
  MAX : Int32
  let MAX = 2147483647

  # The smallest Int32: -2147483648.
  MIN : Int32
  let MIN = -2147483648
end

# The range of a signed 64-bit integer.
module Int64 do
  # The largest Int64: 9223372036854775807.
  MAX : Int64
  let MAX = 9223372036854775807

  # The smallest Int64: -9223372036854775808.
  MIN : Int64
  let MIN = -9223372036854775808
end

# The range of an unsigned 8-bit integer: +UInt8+ is another name for +Byte+.
module UInt8 do
  # The largest UInt8: 255.
  MAX : UInt8
  let MAX = 255

  # The smallest UInt8: 0.
  MIN : UInt8
  let MIN = 0
end

# The range of an unsigned 16-bit integer.
module UInt16 do
  # The largest UInt16: 65535.
  MAX : UInt16
  let MAX = 65535

  # The smallest UInt16: 0.
  MIN : UInt16
  let MIN = 0
end

# The range of an unsigned 32-bit integer.
module UInt32 do
  # The largest UInt32: 4294967295.
  MAX : UInt32
  let MAX = 4294967295

  # The smallest UInt32: 0.
  MIN : UInt32
  let MIN = 0
end

# The range of an unsigned 64-bit integer.
module UInt64 do
  # The largest UInt64: 18446744073709551615.
  MAX : UInt64
  let MAX = 18446744073709551615

  # The smallest UInt64: 0.
  MIN : UInt64
  let MIN = 0
end

# The range of a +Byte+, Kex's unsigned 8-bit integer (also called +UInt8+).
module Byte do
  # The largest Byte: 255.
  MAX : Byte
  let MAX = 255

  # The smallest Byte: 0.
  MIN : Byte
  let MIN = 0
end

# Reading a number from text that may hold either an integer or a float, and
# writing numbers by a digit pattern.
module Number do
  # Parses +text+ as an +Integer+ or a +Float+, whichever it describes. A
  # fraction or an exponent makes it a +Float+; otherwise the grammar is
  # +Float.parse+'s.
  #
  # Use it for input such as a config value or a CSV column that may hold
  # either kind.
  #
  # @param text [String] the text to read
  # @param culture [Culture] whose decimal and group separators to accept
  # @return [Result<Number, ParseError<Number>>] the number, or why not
  #
  # @example
  #   Number.parse("42")     # => Ok(42)
  #   Number.parse("3.5")    # => Ok(3.5)
  #   Number.parse("x")      # => Error(NoDigits(0))
  # @example In a culture
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   Number.parse("1 500,5", culture: hu)   # => Ok(1500.5)
  #   Number.parse("1 500", culture: hu)     # => Ok(1500)
  let parse(text: String, culture: Culture = Culture.DEFAULT) -> Result<Number, ParseError<Number>> do
    # Canonical text reads the same in every culture with a "." decimal
    # point: only the rest is scanned.
    let valid = Culture.valid?(culture)
    match valid then Kex.Intrinsic.Integer.fromDigits(text, 10) else None do
      Just(value) => return Ok(value)
      None => ()
    end
    match valid && culture.numbers.decimalSeparator == '.' then Kex.Intrinsic.Float.fromDigits(text) else None do
      Just(value) => return Ok(value)
      None => ()
    end
    Number.readNumber(text, culture, 10, true) do |digits, tail|
      tail.empty? then Kex.Intrinsic.Integer.fromDigits(digits, 10) else Kex.Intrinsic.Float.fromDigits(digits + tail)
    end
  end

  # Reads the number in +text+ with the grammar +Integer.parse+,
  # +Float.parse+ and +Number.parse+ share. Most callers want one of those.
  #
  # The grammar is an optional sign, then digits in +radix+ (letters above 9
  # in either case). Group separators must follow +culture+'s grouping;
  # digits with no separator read in every culture. When +fractional+ is
  # true, a decimal part after the culture's decimal separator and an
  # exponent (+e3+, +E-2+) may follow.
  #
  # +convert+ gets the sign and digits without separators (+"-1500"+), and the
  # fraction and exponent in canonical form (+".5e3"+, +".0e3"+ for an
  # exponent alone, +""+ for neither). When it returns +None+ the result is
  # +OutOfRange+. A number followed by more text is +Trailing+.
  #
  # @param text [String] the text to read
  # @param culture [Culture] whose separators to accept
  # @param radix [Integer] the base of the digits, 2 to 36
  # @param fractional [Bool] whether a fraction and an exponent may follow
  # @param convert [String -> String -> T?] the value of the digits read
  # @return [Result<T, ParseError<T>>] the value, or why not
  #
  # @example
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   Number.readNumber("1 500 Ft", hu, 10, false) { |digits, _| digits.to(Integer) }
  #   # => Error(Trailing(1500, " Ft"))
  let readNumber(text: String, culture: Culture, radix: Integer, fractional: Bool, convert: String -> String -> T?) -> Result<T, ParseError<T>> do
    match scanNumber(text, culture, radix, fractional) do
      Ok((digits, tail, length)) => match convert(digits, tail) do
        Just(value) => length == text.count then Ok(value) else Error(Trailing(value, text.drop(length)))
        None => Error(OutOfRange)
      end
      Error(problem) => Error(problem)
    end
  end

  # Builds a +NumberFormat+ from a digit pattern, for +to(String, format)+.
  #
  # The pattern is checked during compilation, so a bad pattern is a build
  # error.
  #
  # - +0+ is a required digit: +000+ pads the integer part to three digits,
  #   and +.00+ always writes two decimals.
  # - +#+ is an optional digit: +#.##+ writes at most two decimals and drops
  #   trailing zeros. Optional digits come before required ones in the
  #   integer part (+#0+) and after them in the decimals (+.0#+).
  # - +.+ starts the decimals. The value is rounded to as many decimals as
  #   the pattern allows, with ties away from zero.
  #
  # The integer part always has at least one digit, so +#.00+ writes
  # +0.50+, never +.50+. A value that rounds to zero has no minus sign.
  #
  # @param parts [[String]] the literal pieces of the tagged literal
  # @param values [[Any]] the interpolated values
  # @return [NumberFormat] the format
  #
  # @example
  #   1.5.to(String, Number.format`#.00`)   # => Just("1.50")
  #   1.5.to(String, Number.format`#.##`)   # => Just("1.5")
  #   2.0.to(String, Number.format`#.##`)   # => Just("2")
  #   7.to(String, Number.format`000`)      # => Just("007")
  format : [String] -> [Any] -> NumberFormat
  let format(parts, values) do
    let rest = values.zip(parts.rest).map { |value, part| "${value}${part}" }
    return NumberFormat { pattern: parts.first.or("") + rest.join("") }
  end

  # Checks a +Number.format+ pattern during compilation and reports the
  # first character that does not fit.
  #
  # @param source [String] the pattern
  # @return [[TaggedValidation.Issue]] the problem found, if any
  let validateFormat(source: String) -> [TaggedValidation.Issue] do
    match NumberFormat.parse(source) do
      Ok(_) => return []
      Error(problem) => return [TaggedValidation.fatalAt(source.take(problem.position).byteSize, problem.message)]
    end
  end

  private do
    # Reads the number +text+ starts with: an optional sign, digits in
    # +radix+, grouped as +culture+ groups them once a separator appears and,
    # when +fractional+, a fraction after the culture's decimal separator and an
    # exponent. This is the one grammar both backends read numbers with; native
    # code only converts what it accepts.
    #
    # Answers the sign and digits without separators, the canonical rest
    # (+".5"+, +".0e3"+, +""+ when neither was read), and how many characters
    # the number took.
    let scanNumber(text: String, culture: Culture, radix: Integer, fractional: Bool) -> Result<(String, String, Integer), ParseError<A>> do
      return Error(BadRadix(radix)) if radix < 2 || radix > 36
      return Error(BadCulture) if !Culture.valid?(culture)
      let (sign, start, afterSign) = match text.chars do
        ['-' | rest] => ("-", 1, rest)
        ['+' | rest] => ("", 1, rest)
        chars => ("", 0, chars)
      end
      let (lead, afterLead) = digitRun(afterSign, radix, [])
      return Error(NoDigits(start)) if lead.empty?
      var groups = [lead]
      var afterWhole = afterLead
      match culture.numbers.groups do
        Just((separator, sizes)) => do
          let (read, after) = groupRun(afterLead, separator, radix, [lead])
          match misplacedGroup(read, sizes) do
            Just(at) => return Error(BadGrouping(start + at))
            None => ()
          end
          groups = read
          afterWhole = after
        end
        None => ()
      end
      let whole = sign + groups.join("")
      let wholeLength = start + groups.reduce(groups.count - 1) { |sum, group| sum + group.count }
      return Ok((whole, "", wholeLength)) if !fractional
      let (fraction, afterFraction) = match afterWhole do
        [c | rest] => c == culture.numbers.decimalSeparator then digitRun(rest, 10, []) else ("", afterWhole)
        [] => ("", [])
      end
      let fractionLength = fraction.empty? then 0 else fraction.count + 1
      let exponent = exponentRun(fraction.empty? then afterWhole else afterFraction)
      let tail = (fraction.empty? && exponent.empty?) then "" else ".${fraction.empty? then "0" else fraction}${exponent}"
      Ok((whole, tail, wholeLength + fractionLength + exponent.count))
    end

    # The digits +chars+ starts with in +radix+, and what follows them.
    let digitRun(chars: [Char], radix: Integer, read: [Char]) -> (String, [Char]) do
      match chars do
        [c | rest] => digitValue(c) < radix then digitRun(rest, radix, [c, ...read]) else (read.reverse.join(""), chars)
        [] => (read.reverse.join(""), [])
      end
    end

    # The value of an ASCII digit or letter digit (+'a'+ and +'A'+ are 10),
    # 99 for anything else.
    let digitValue(c: Char) -> Integer do
      let code = c.codepoint
      return code - 48 if code >= 48 && code <= 57
      return code - 87 if code >= 97 && code <= 122
      return code - 55 if code >= 65 && code <= 90
      99
    end

    # The digit groups after the first, each behind a separator; a separator
    # without digits behind it is not part of the number.
    let groupRun(chars: [Char], separator: Char, radix: Integer, groups: [String]) -> ([String], [Char]) do
      match chars do
        [c | rest] => do
          return (groups, chars) if !separatorLike?(c, separator)
          let (digits, after) = digitRun(rest, radix, [])
          digits.empty? then (groups, chars) else groupRun(after, separator, radix, [...groups, digits])
        end
        [] => (groups, [])
      end
    end

    # The character index of the first group of the wrong size, counted from
    # the first digit. Digits without separators are any length: +"1500"+
    # reads in every culture. Sizes apply from the right, the last repeating
    # (en-IN's +[3, 2]+), and the leftmost group holds one digit up to a full
    # group.
    let misplacedGroup(groups: [String], sizes: [Integer]) -> Integer? do
      return None if groups.count == 1
      var offset = 0
      var index = 0
      var bad: Integer? = None
      groups.each do |group|
        let fromRight = groups.count - 1 - index
        let want = sizes.at(fromRight < sizes.count then fromRight else sizes.count - 1).or(3)
        let fits = index == 0 then group.count <= want else group.count == want
        bad = Just(offset) if bad.none? && !fits
        offset = offset + group.count + 1
        index = index + 1
      end
      bad
    end

    # The exponent +chars+ starts with, canonically spelled (+"e-3"+), or
    # +""+ when there is none: an +e+ or +E+, an optional sign, and digits.
    let exponentRun(chars: [Char]) -> String do
      match chars do
        [e | rest] => do
          return "" if e != 'e' && e != 'E'
          let (sign, digitsFrom) = match rest do
            ['-' | after] => ("-", after)
            ['+' | after] => ("+", after)
            _ => ("", rest)
          end
          let (digits, _) = digitRun(digitsFrom, 10, [])
          digits.empty? then "" else "e${sign}${digits}"
        end
        [] => ""
      end
    end

    # Whether +c+ separates digit groups: the culture's separator, or any space
    # lookalike (plain, NBSP, narrow NBSP) when the separator is one, since
    # keyboards and copy-paste rarely produce NBSP.
    let separatorLike?(c: Char, separator: Char) -> Bool = c == separator || (spaceLike?(separator) && spaceLike?(c))

    # Plain space, NBSP (160) and narrow NBSP (8239).
    let spaceLike?(c: Char) -> Bool = c.codepoint == 32 || c.codepoint == 160 || c.codepoint == 8239
  end
end

# A digit pattern such as +"#.00"+ for +to(String, format)+; the patterns are
# described at +Number.format+. Build one with +Number.format+, which checks
# the pattern during compilation, or with +NumberFormat.parse+ for a pattern
# known only at run time.
record NumberFormat do
  # The digit pattern, such as +"#.00"+.
  pattern : String
end

module NumberFormat do
  # Checks a digit pattern known only at run time and returns it as a
  # +NumberFormat+. +Number.format+ describes the patterns.
  #
  # @param pattern [String] the pattern
  # @return [Result<NumberFormat, PatternError>] the format, or where the
  #   pattern goes wrong
  #
  # @example
  #   NumberFormat.parse("#.00")   # => Ok(NumberFormat { pattern: "#.00" })
  #   NumberFormat.parse("#.#0")   # => Error(PatternError { message: "...", position: 3 })
  let parse(pattern: String) -> Result<NumberFormat, PatternError> do
    match layout(pattern) do
      Ok(_) => return Ok(NumberFormat { pattern: pattern })
      Error((index, message)) => return Error(PatternError { position: index, message: message })
    end
  end

  # Returns what a pattern writes: the fewest integer digits, the fewest
  # decimals and the most decimals. For a bad pattern it returns the index
  # of the first problem and a message.
  #
  # @param pattern [String] the pattern
  # @return [Result<(Integer, Integer, Integer), (Integer, String)>] the
  #   layout, or the problem
  #
  # @example
  #   NumberFormat.layout("#0.0##")   # => Ok((1, 1, 3))
  layout : String -> Result<(Integer, Integer, Integer), (Integer, String)>
  let layout(pattern) do
    let pieces = pattern.split(".")
    let whole = pieces.first.or("")
    let decimals = pieces.get(1, "")
    let point = whole.count
    return Error((0, "a number format needs a digit: `#` or `0`")) if whole.empty?
    if let Just(problem) = misplaced(whole.chars, 0, '#', '0', false)
      return Error(problem)
    end
    if pieces.count > 2
      return Error((point + 1 + decimals.count, "a number format has one decimal point"))
    end
    if pieces.count == 2 && decimals.empty?
      return Error((point, "the point needs a decimal after it: `.0` or `.#`"))
    end
    if let Just(problem) = misplaced(decimals.chars, point + 1, '0', '#', false)
      return Error(problem)
    end
    if decimals.count > 15
      return Error((point + 16, "a number format has at most 15 decimals"))
    end
    let wholeZeros = whole.chars.count { |c| c == '0' }
    let decimalZeros = decimals.chars.count { |c| c == '0' }
    return Ok((wholeZeros, decimalZeros, decimals.count))
  end

  private do
    # The first character of +chars+ (starting at +index+ in the pattern)
    # that is not a digit, or that puts a +late+ digit before an +early+
    # one, with what is wrong with it.
    let misplaced(chars: [Char], index: Integer, early: Char, late: Char,
                  seenLate: Bool) -> (Integer, String)? do
      match chars do
        [] => return None
        [c | rest] => do
          if c != '0' && c != '#'
            return Just((index, "`${c}` is not part of a number format: `0` is a required digit, `#` an optional one, and `.` the decimal point"))
          end
          if c == early && seenLate
            return Just((index, early == '#'
              then "an optional digit cannot follow a required one before the point; write `#0`"
              else "a required decimal cannot follow an optional one; write `.0#`"))
          end
          return misplaced(rest, index + 1, early, late, seenLate || c == late)
        end
      end
    end
  end
end

make Number do
  # Writes the number by a digit pattern, described at +Number.format+.
  #
  # @param String [Type] the target type
  # @param format [NumberFormat] the pattern
  # @return [String?] the text, or +None+ when the pattern is not valid
  #
  # @example
  #   1234.5.to(String, Number.format`#.00`)    # => Just("1234.50")
  #   (-0.001).to(String, Number.format`#.#`)   # => Just("0")
  #   42.to(String, Number.format`0000.0`)      # => Just("0042.0")
  let to(String, format: NumberFormat) -> String? do
    match NumberFormat.layout(format.pattern) do
      Error(_) => return None
      Ok((digits, fewest, most)) => do
        let text = Kex.Intrinsic.Kex.kind(this) == :float
          then Kex.Intrinsic.Float.formatFixed(this, most)
          else this.showValue
        let negative = text.startsWith?("-")
        let pieces = (negative then text.drop(1) else text).split(".")
        let whole = leadingZeros(pieces.first.or("0"), digits)
        let decimals = trailingZeros(pieces.get(1, ""), fewest)
        let sign = negative then "-" else ""
        return Just(decimals.empty? then "${sign}${whole}" else "${sign}${whole}.${decimals}")
      end
    end
  end

  # Writes the number in another base, like the generic
  # +to(value, t, radix:)+.
  #
  # @param String [Type] the target type
  # @param radix [Integer] the base, 2 through 36
  # @return [String?] the digits
  #
  # @example
  #   255.to(String, radix: 16)   # => Just("ff")
  let to(String, radix: Integer) -> String? = Kex.Intrinsic.Fun.convertTo(this, String, radix)

  # Writes the number with a culture's decimal separator and digit grouping.
  # An exponent passes through unchanged. Returns +None+ for an invalid
  # culture (see +Culture.valid?+).
  #
  # @param String [Type] the target type
  # @param culture [Culture] the culture to render with
  # @return [String?] the text, or +None+ for an invalid culture
  #
  # @example
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   (1500.5).to(String, culture: hu)              # => Just("1\u{A0}500,5")
  #   42.to(String, culture: hu)                    # => Just("42")
  let to(String, culture: Culture) -> String? = Culture.renderNumber(this.showValue, culture)

  # Writes the number by a digit pattern, then with a culture's separators.
  # The pattern sets the digits as in +to(String, format)+; the culture only
  # changes the separators. Returns +None+ for an invalid pattern or
  # culture.
  #
  # @param String [Type] the target type
  # @param format [NumberFormat] the pattern
  # @param culture [Culture] the culture to render with
  # @return [String?] the text, or +None+
  #
  # @example
  #   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
  #   (1234.5).to(String, Number.format`#.00`, culture: hu)              # => Just("1\u{A0}234,50")
  let to(String, format: NumberFormat, culture: Culture) -> String? do
    match this.to(String, format) do
      Just(text) => Culture.renderNumber(text, culture)
      None => None
    end
  end

  private do
    # +text+ with leading zeros up to +width+ characters.
    let leadingZeros(text: String, width: Integer) -> String do
      return text.count >= width then text else leadingZeros("0" + text, width)
    end

    # +text+ with exactly +width+ characters if it is shorter, or with its
    # trailing zeros dropped down to +width+ characters if it is longer.
    let trailingZeros(text: String, width: Integer) -> String do
      return trailingZeros(text + "0", width) if text.count < width
      return trailingZeros(text.take(text.count - 1), width) if text.count > width && text.endsWith?("0")
      return text
    end

    # (Culture rendering lives in +Culture.renderNumber+; these helpers
    # moved there with it.)
  end
end
