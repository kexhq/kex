# Whole numbers, of arbitrary size.
#
# +Integer+ has no width limit: factorials and cryptographic moduli are
# ordinary values, not a special big-number type you have to opt into.
#
# +Integer+ and +Float+ are one numeric tower: they compare and order across
# the boundary, so +0 == 0.0+ is +true+ and +[1, 2.5, 3].sort+ works. What
# differs is the arithmetic. +/+ on two integers is integer division, and
# +sqrt+ answers a +Float+ because a square root generally is one.
#
#   7 / 2          # => 3      (integer division)
#   7.0 / 2.0      # => 3.5
#   16.sqrt        # => 4.0    (a Float, even from an Integer)
#   (-7).modulo(3) # => 2      (mathematical modulo, not C remainder)
make Integer do
  # Returns +true+ when the integer is divisible by two. Zero is even, and
  # negative numbers follow the same rule.
  #
  # @return [Bool] +true+ for an even integer
  #
  # @example
  #   4.even?      # => true
  #   3.even?      # => false
  #   (-2).even?   # => true
  #
  # @example Splitting a list into evens and odds
  #   [1, 2, 3, 4].partition { |n| n.even? }   # => ([2, 4], [1, 3])
  even? :> Bool
  let even? = this.modulo(2) == 0

  # Returns +true+ when the integer is not divisible by two. The opposite of
  # +even?+.
  #
  # @return [Bool] +true+ for an odd integer
  #
  # @example
  #   3.odd?   # => true
  #   4.odd?   # => false
  odd? :> Bool
  let odd? = this.modulo(2) != 0

  # Returns the magnitude of the integer, discarding its sign.
  #
  # @return [Integer] the absolute value
  #
  # @example
  #   (-5).abs   # => 5
  #   5.abs      # => 5
  #
  # @example Distance between two positions
  #   (a - b).abs
  abs :> Integer
  let abs = Kex.Intrinsic.Number.abs(this)

  # Returns the square root as a +Float+.
  #
  # The result is a +Float+ even when the root is exact, because in general it
  # is not. Round or floor it when you need an integer back.
  #
  # @return [Float] the square root
  #
  # @example
  #   16.sqrt          # => 4.0
  #   2.sqrt           # => 1.4142135623730951
  #   16.sqrt.round    # => 4
  sqrt :> Float
  let sqrt = Kex.Intrinsic.Number.sqrt(this)

  # Returns +this+ modulo +n+.
  #
  # The result takes the sign of +n+, which is mathematical modulo rather than
  # the C-style remainder other languages give. That is what makes it safe for
  # wrapping an index that may have gone negative.
  #
  # @param n [Integer] the modulus
  # @return [Integer] the remainder, with the sign of +n+
  #
  # @example
  #   7.modulo(3)      # => 1
  #   (-7).modulo(3)   # => 2
  #
  # @example Wrapping an index around a list
  #   let items = ["a", "b", "c"]
  #   items.at((-1).modulo(items.count))   # => Just("c")
  modulo :> Integer -> Integer
  let modulo(n) = Kex.Intrinsic.Integer.modulo(this, n)

  # Returns +true+ when the integer falls inside +range+, endpoints included.
  #
  # @param range [Range<Integer>] the inclusive range
  # @return [Bool] +true+ when the integer is in range
  #
  # @example
  #   5.in?(1..10)    # => true
  #   11.in?(1..10)   # => false
  #
  # @example Validating a port number
  #   port.in?(1..65535)
  in? :> Range<Integer> -> Bool
  let in?(range) = Kex.Intrinsic.List.member(this, range)

  # Calls +f+ exactly +this+ times, passing the 0-based iteration index.
  #
  # This is the counting loop. When you want the numbers themselves rather
  # than a count of repetitions, +(1..n).items.each+ often reads better.
  #
  # @param f [Integer -> Void] called once per iteration with the index
  # @return [Void]
  #
  # @example
  #   3.times { |i| IO.printLine(i) }   # prints 0, then 1, then 2
  #
  # @example Repeating an action
  #   retries.times { |_| attemptConnection }
  #
  # @example Repeating an action that needs no index
  #   3.times do
  #     IO.printLine("hi")
  #   end
  times :> (Integer -> Void) -> Void
  times :> Block<Void> -> Void
  let times(block) = Kex.Intrinsic.Integer.times(this, block)

  # Returns the integer unchanged. Present so that code written against
  # +Number+ works whichever half of the tower it is handed.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.floor   # => 7
  floor :> Integer
  let floor = Kex.Intrinsic.Number.floor(this)

  # Returns the integer unchanged. The +Integer+ counterpart of
  # +Float.ceil+.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.ceil   # => 7
  ceil :> Integer
  let ceil = Kex.Intrinsic.Number.ceil(this)

  # Returns the integer unchanged. The +Integer+ counterpart of
  # +Float.round+.
  #
  # @return [Integer] the same integer
  #
  # @example
  #   7.round   # => 7
  round :> Integer
  let round = Kex.Intrinsic.Number.round(this)

end

# Double-precision floating-point numbers.
#
# A Kex +Float+ is always finite. An operation that would produce +NaN+ or
# +Infinity+ raises instead: the same rule the BEAM enforces, where those two
# values cannot exist at all. So a +Float+ you are holding is always a real
# number, and there is no +nan?+ to check for.
#
# +Float+ and +Integer+ compare and order across the boundary; see
# +Integer+ for the rest of the numeric tower.
#
#   3.7.floor      # => 3
#   3.7.round      # => 4
#   (-3.7).toInteger  # => -3   (truncates toward zero)
make Float do
  # Returns the magnitude of the float, discarding its sign.
  #
  # @return [Float] the absolute value
  #
  # @example
  #   (-3.14).abs   # => 3.14
  #   3.14.abs      # => 3.14
  #
  # @example An approximate-equality test
  #   (a - b).abs < 0.0001
  abs :> Float
  let abs = Kex.Intrinsic.Number.abs(this)

  # Returns the square root. Raises for a negative receiver, which has no real
  # root.
  #
  # @return [Float] the square root
  #
  # @example
  #   25.0.sqrt   # => 5.0
  #   2.0.sqrt    # => 1.4142135623730951
  sqrt :> Float
  let sqrt = Kex.Intrinsic.Number.sqrt(this)

  # Returns +true+ when the float falls inside +range+, endpoints included.
  #
  # @param range [Range<Float>] the inclusive range
  # @return [Bool] +true+ when the float is in range
  #
  # @example Comparing directly is usually clearer for floats
  #   let ratio = 0.75
  #   ratio >= 0.0 && ratio <= 1.0   # => true
  in? :> Range<Float> -> Bool
  let in?(range) = Kex.Intrinsic.List.member(this, range)

  # Returns the largest integer that is not greater than the float: it always
  # rounds toward negative infinity, which is what separates it from
  # +toInteger+ for negative values.
  #
  # @return [Integer] the floor
  #
  # @example
  #   3.7.floor      # => 3
  #   3.2.floor      # => 3
  #   (-3.2).floor   # => -4
  floor :> Integer
  let floor = Kex.Intrinsic.Number.floor(this)

  # Returns the smallest integer that is not less than the float: it always
  # rounds toward positive infinity.
  #
  # @return [Integer] the ceiling
  #
  # @example
  #   3.2.ceil       # => 4
  #   3.0.ceil       # => 3
  #   (-3.7).ceil    # => -3
  #
  # @example How many pages of a fixed size a list needs
  #   (items.count.to(Float).or(0.0) / 20.0).ceil
  ceil :> Integer
  let ceil = Kex.Intrinsic.Number.ceil(this)

  # Returns the nearest integer, with halves rounding away from zero.
  #
  # @return [Integer] the rounded value
  #
  # @example
  #   3.2.round    # => 3
  #   3.5.round    # => 4
  #   3.7.round    # => 4
  round :> Integer
  let round = Kex.Intrinsic.Number.round(this)

  # Truncates toward zero and returns the result as an +Integer+: it drops
  # the fractional part rather than rounding, so it differs from both +floor+
  # and +round+ for negative values.
  #
  # @return [Integer] the truncated value
  #
  # @example
  #   3.7.toInteger      # => 3
  #   (-3.7).toInteger   # => -3   (floor would give -4)
  toInteger :> Integer
  let toInteger = Kex.Intrinsic.Number.toInteger(this)
end

# Reading integers out of text.
#
# Use +parse+ when a failure needs explaining and +"42".to(Integer)+ when it
# does not: +to+ answers a plain +Optional+, +parse+ answers a
# +Result+ carrying a +ParseError+ that says where it stopped and what it had
# read so far.
module Integer do
  # Parses the whole string as a base-10 integer.
  #
  # The string must be entirely consumed: leading or trailing characters make
  # it an +Error+, with a +ParseError+ describing where parsing stopped. Use
  # +parsePrefix+ when a trailing remainder is expected.
  #
  # @param s [String] the text to parse
  # @return [Result<Integer, ParseError>] the integer, or a described failure
  #
  # @example
  #   Integer.parse("42")     # => Ok(42)
  #   Integer.parse("-7")     # => Ok(-7)
  #   Integer.parse("4x")     # => Error(ParseError { ... rest: "x" ... })
  #
  # @example Reading a setting with a fallback
  #   let port = Integer.parse(raw).or(8080)
  #
  # @example Reporting why the input was rejected
  #   match Integer.parse(raw) do
  #     Ok(n)    => IO.printLine("port ${n}")
  #     Error(e) => IO.printError("bad port: ${e.message}")
  #   end
  parse : String -> Result<Integer, ParseError>
  let parse(s) = Kex.Intrinsic.Integer.parse(s)

  # Parses the whole string as an integer written in base +radix+, 2 through
  # 36. Digits above 9 are accepted in either case.
  #
  # @param s [String] the text to parse
  # @param radix [Integer] the base, 2 to 36
  # @return [Result<Integer, ParseError>] the integer, or a described failure
  #
  # @example
  #   Integer.parse("ff", radix: 16)     # => Ok(255)
  #   Integer.parse("FF", radix: 16)     # => Ok(255)
  #   Integer.parse("1010", radix: 2)    # => Ok(10)
  #
  # @example Reading a hex colour component
  #   Integer.parse(hex.take(2), radix: 16).or(0)
  parse : String -> Integer -> Result<Integer, ParseError>
  let parse(s, radix: Integer) = Kex.Intrinsic.Integer.parse(s, radix)

  # Parses an integer from the front of the string and returns it together
  # with whatever text was left over.
  #
  # This is the building block for hand-written scanners: parse a number, keep
  # going from the remainder. Answers +None+ when the string does not begin
  # with a number at all.
  #
  # @param s [String] the text to parse from
  # @return [(Integer, String)?] the value and the unconsumed remainder
  #
  # @example
  #   Integer.parsePrefix("42abc")   # => Just((42, "abc"))
  #   Integer.parsePrefix("abc")     # => None
  #
  # @example Reading a leading count off a line
  #   match Integer.parsePrefix("3 items") do
  #     Just(pair) => do
  #       let (count, rest) = pair
  #       IO.printLine("${count} of${rest}")   # prints: 3 of items
  #     end
  #     None => IO.printError("no leading count")
  #   end
  parsePrefix : String -> (Integer, String)?
  let parsePrefix(s) = Kex.Intrinsic.Integer.parsePrefix(s)
end

# Reading floating-point numbers out of text.
module Float do
  # Parses the whole string as a float.
  #
  # The string must be entirely consumed; anything left over makes it an
  # +Error+ carrying a +ParseError+.
  #
  # @param s [String] the text to parse
  # @return [Result<Float, ParseError>] the float, or a described failure
  #
  # @example
  #   Float.parse("3.5")     # => Ok(3.5)
  #   Float.parse("-0.25")   # => Ok(-0.25)
  #   Float.parse("3.5m")    # => Error(ParseError { ... rest: "m" ... })
  #
  # @example Averaging a column of text values
  #   rows.map { |r| Float.parse(r).or(0.0) }.sum / rows.count.to(Float).or(1.0)
  parse : String -> Result<Float, ParseError>
  let parse(s) = Kex.Intrinsic.Float.parse(s)

  # Parses a float from the front of the string and returns it together with
  # the unconsumed remainder. Answers +None+ when the string does not begin
  # with a number.
  #
  # @param s [String] the text to parse from
  # @return [(Float, String)?] the value and the remainder
  #
  # @example
  #   Float.parsePrefix("3.5rest")   # => Just((3.5, "rest"))
  #   Float.parsePrefix("rest")      # => None
  #
  # @example Splitting a measurement from its unit
  #   Float.parsePrefix("12.5kg")   # => Just((12.5, "kg"))
  parsePrefix : String -> (Float, String)?
  let parsePrefix(s) = Kex.Intrinsic.Float.parsePrefix(s)

  # The largest finite +Float+.
  #
  # A Kex +Float+ is always finite, so there is no infinity to start from:
  # this is the bound to use instead, say as the first "smallest so far".
  #
  # @return [Float] 1.7976931348623157e308
  #
  # @example
  #   let smallest = readings.reduce(Float.MAX) { |low, x| x < low then x else low }
  MAX : Float
  let MAX = 1.7976931348623157e308

  # The most negative finite +Float+: +-Float.MAX+. Not the smallest positive
  # one, which some languages call MIN.
  #
  # @return [Float] -1.7976931348623157e308
  MIN : Float
  let MIN = -1.7976931348623157e308
end

# The bounds of the sized numeric types: +Int8.MAX+, +UInt64.MAX+,
# +Float32.MIN+ and so on. +Integer+ has none: it is arbitrary-precision.
# For a float type, +MIN+ is the most negative finite value, not the smallest
# positive one.

# The range of a 32-bit float.
module Float32 do
  # The largest Float32: 3.4028234663852886e38.
  MAX : Float32
  let MAX = 3.4028234663852886e38

  # The most negative finite Float32: -3.4028234663852886e38.
  MIN : Float32
  let MIN = -3.4028234663852886e38
end

# The range of a 64-bit float, the same as a +Float+.
module Float64 do
  # The largest Float64: 1.7976931348623157e308.
  MAX : Float64
  let MAX = 1.7976931348623157e308

  # The most negative finite Float64: -1.7976931348623157e308.
  MIN : Float64
  let MIN = -1.7976931348623157e308
end

# The range of a signed 8-bit integer.
module Int8 do
  # The largest Int8: 127.
  MAX : Int8
  let MAX = 127

  # The smallest Int8: -128.
  MIN : Int8
  let MIN = -128
end

# The range of a signed 16-bit integer.
module Int16 do
  # The largest Int16: 32767.
  MAX : Int16
  let MAX = 32767

  # The smallest Int16: -32768.
  MIN : Int16
  let MIN = -32768
end

# The range of a signed 32-bit integer.
module Int32 do
  # The largest Int32: 2147483647.
  MAX : Int32
  let MAX = 2147483647

  # The smallest Int32: -2147483648.
  MIN : Int32
  let MIN = -2147483648
end

# The range of a signed 64-bit integer.
module Int64 do
  # The largest Int64: 9223372036854775807.
  MAX : Int64
  let MAX = 9223372036854775807

  # The smallest Int64: -9223372036854775808.
  MIN : Int64
  let MIN = -9223372036854775808
end

# The range of an unsigned 8-bit integer: +UInt8+ is another name for +Byte+.
module UInt8 do
  # The largest UInt8: 255.
  MAX : UInt8
  let MAX = 255

  # The smallest UInt8: 0.
  MIN : UInt8
  let MIN = 0
end

# The range of an unsigned 16-bit integer.
module UInt16 do
  # The largest UInt16: 65535.
  MAX : UInt16
  let MAX = 65535

  # The smallest UInt16: 0.
  MIN : UInt16
  let MIN = 0
end

# The range of an unsigned 32-bit integer.
module UInt32 do
  # The largest UInt32: 4294967295.
  MAX : UInt32
  let MAX = 4294967295

  # The smallest UInt32: 0.
  MIN : UInt32
  let MIN = 0
end

# The range of an unsigned 64-bit integer.
module UInt64 do
  # The largest UInt64: 18446744073709551615.
  MAX : UInt64
  let MAX = 18446744073709551615

  # The smallest UInt64: 0.
  MIN : UInt64
  let MIN = 0
end

# The range of a +Byte+, Kex's unsigned 8-bit integer (also called +UInt8+).
module Byte do
  # The largest Byte: 255.
  MAX : Byte
  let MAX = 255

  # The smallest Byte: 0.
  MIN : Byte
  let MIN = 0
end

# Reading a number out of text without deciding in advance which half of the
# numeric tower it belongs to.
module Number do
  # Parses the whole string as an +Integer+ or a +Float+, whichever the text
  # describes.
  #
  # Use it when the input's shape is not known ahead of time: a config value,
  # a CSV column that may hold either.
  #
  # @param s [String] the text to parse
  # @return [Result<Number, ParseError>] the number, or a described failure
  #
  # @example
  #   Number.parse("42")     # => Ok(42)
  #   Number.parse("3.5")    # => Ok(3.5)
  #   Number.parse("x")      # => Error(ParseError { ... })
  parse : String -> Result<Number, ParseError>
  let parse(s) = Kex.Intrinsic.Number.parse(s)

  # Builds a +NumberFormat+ from a digit pattern, for +to(String, format)+.
  #
  # The pattern is checked during compilation (by +validateFormat+), so a
  # mistake in it fails the build instead of leaving text out at run time.
  #
  # - +0+ is a required digit: +000+ pads the integer part to three digits,
  #   and +.00+ always writes two decimals.
  # - +#+ is an optional digit: +#.##+ writes at most two decimals and drops
  #   trailing zeros. Optional digits come before required ones in the
  #   integer part (+#0+) and after them in the decimals (+.0#+).
  # - +.+ starts the decimals. The value is rounded to as many decimals as
  #   the pattern allows, with ties away from zero.
  #
  # The integer part always has at least one digit, so +#.00+ writes
  # +0.50+, never +.50+. A value that rounds to zero has no minus sign.
  #
  # @param parts [[String]] the literal pieces of the tagged literal
  # @param values [[Any]] the interpolated values
  # @return [NumberFormat] the format
  #
  # @example
  #   1.5.to(String, Number.format`#.00`)   # => Just("1.50")
  #   1.5.to(String, Number.format`#.##`)   # => Just("1.5")
  #   2.0.to(String, Number.format`#.##`)   # => Just("2")
  #   7.to(String, Number.format`000`)      # => Just("007")
  format : [String] -> [Any] -> NumberFormat
  let format(parts, values) do
    let rest = values.zip(parts.rest).map { |value, part| "${value}${part}" }
    return NumberFormat { pattern: parts.first.or("") + rest.join("") }
  end

  # Checks a +Number.format+ pattern during compilation, pointing at the
  # first character that does not fit.
  #
  # @param source [String] the pattern
  # @return [[TaggedValidation.Issue]] the problem found, if any
  let validateFormat(source: String) -> [TaggedValidation.Issue] do
    match NumberFormat.parse(source) do
      Ok(_) => return []
      Error(problem) => return [TaggedValidation.fatalAt(problem.position, problem.message)]
    end
  end
end

# How +to(String, format)+ writes a number: a digit pattern such as
# +"#.00"+, described at +Number.format+. Build one with +Number.format+,
# which checks the pattern during compilation, or with +NumberFormat.parse+
# for a pattern known only at run time.
record NumberFormat do
  # The digit pattern, such as +"#.00"+.
  pattern : String
end

module NumberFormat do
  # Checks a digit pattern known only at run time. +Number.format+
  # describes the patterns.
  #
  # @param pattern [String] the pattern
  # @return [Result<NumberFormat, ParseError>] the format, or where the
  #   pattern goes wrong
  #
  # @example
  #   NumberFormat.parse("#.00")   # => Ok(NumberFormat { pattern: "#.00" })
  #   NumberFormat.parse("#.#0")   # => Error(ParseError { position: 3, ... })
  parse : String -> Result<NumberFormat, ParseError>
  let parse(pattern) do
    match layout(pattern) do
      Ok(_) => return Ok(NumberFormat { pattern: pattern })
      Error((index, message)) => return Error(ParseError {
        input: pattern,
        position: pattern.take(index).byteSize,
        value: None,
        message: message,
        rest: pattern.drop(index)
      })
    end
  end

  # What a pattern writes: the fewest integer digits, the fewest decimals
  # and the most decimals. Otherwise the index of its first problem, and
  # what that problem is.
  #
  # @param pattern [String] the pattern
  # @return [Result<(Integer, Integer, Integer), (Integer, String)>] the
  #   layout, or the problem
  #
  # @example
  #   NumberFormat.layout("#0.0##")   # => Ok((1, 1, 3))
  layout : String -> Result<(Integer, Integer, Integer), (Integer, String)>
  let layout(pattern) do
    let pieces = pattern.split(".")
    let whole = pieces.first.or("")
    let decimals: String = pieces.get(1, "")
    let point = whole.count
    return Error((0, "a number format needs a digit: `#` or `0`")) if whole.empty?
    if let Just(problem) = misplaced(whole.chars, 0, '#', '0', false)
      return Error(problem)
    end
    if pieces.count > 2
      return Error((point + 1 + decimals.count, "a number format has one decimal point"))
    end
    if pieces.count == 2 && decimals.empty?
      return Error((point, "the point needs a decimal after it: `.0` or `.#`"))
    end
    if let Just(problem) = misplaced(decimals.chars, point + 1, '0', '#', false)
      return Error(problem)
    end
    if decimals.count > 15
      return Error((point + 16, "a number format has at most 15 decimals"))
    end
    let wholeZeros = whole.chars.count { |c| c == '0' }
    let decimalZeros = decimals.chars.count { |c| c == '0' }
    return Ok((wholeZeros, decimalZeros, decimals.count))
  end

  private do
    # The first character of +chars+ (starting at +index+ in the pattern)
    # that is not a digit, or that puts a +late+ digit before an +early+
    # one, with what is wrong with it.
    let misplaced(chars: [Char], index: Integer, early: Char, late: Char,
                  seenLate: Bool) -> (Integer, String)? do
      match chars do
        [] => return None
        [c | rest] => do
          if c != '0' && c != '#'
            return Just((index, "`${c}` is not part of a number format: `0` is a required digit, `#` an optional one, and `.` the decimal point"))
          end
          if c == early && seenLate
            return Just((index, early == '#'
              then "an optional digit cannot follow a required one before the point; write `#0`"
              else "a required decimal cannot follow an optional one; write `.0#`"))
          end
          return misplaced(rest, index + 1, early, late, seenLate || c == late)
        end
      end
    end
  end
end

make Number do
  # Writes the number by a digit pattern, described at +Number.format+.
  #
  # @param String [Type] the target type
  # @param format [NumberFormat] the pattern
  # @return [String?] the text, or +None+ when the pattern is not valid
  #
  # @example
  #   1234.5.to(String, Number.format`#.00`)    # => Just("1234.50")
  #   (-0.001).to(String, Number.format`#.#`)   # => Just("0")
  #   42.to(String, Number.format`0000.0`)      # => Just("0042.0")
  let to(String, format: NumberFormat) -> String? do
    match NumberFormat.layout(format.pattern) do
      Error(_) => return None
      Ok((digits, fewest, most)) => do
        let text = Kex.Intrinsic.Kex.kind(this) == :float
          then Kex.Intrinsic.Float.formatFixed(this, most, false)
          else this.showValue
        let negative = text.startsWith?("-")
        let pieces = (negative then text.drop(1) else text).split(".")
        let whole = leadingZeros(pieces.first.or("0"), digits)
        let decimals = trailingZeros(pieces.get(1, ""), fewest)
        let sign = negative then "-" else ""
        return Just(decimals.empty? then "${sign}${whole}" else "${sign}${whole}.${decimals}")
      end
    end
  end

  # Writes the number in another base, as the generic +to(value, t, radix:)+
  # does. Declared here as well so that, on a number, it and
  # +to(String, format)+ are told apart by their argument's type.
  #
  # @param String [Type] the target type
  # @param radix [Integer] the base, 2 through 36
  # @return [String?] the digits
  #
  # @example
  #   255.to(String, radix: 16)   # => Just("ff")
  let to(String, radix: Integer) -> String? = Kex.Intrinsic.Fun.convertTo(this, String, radix)

  private do
    # +text+ with leading zeros up to +width+ characters.
    let leadingZeros(text: String, width: Integer) -> String do
      return text.count >= width then text else leadingZeros("0" + text, width)
    end

    # +text+ with exactly +width+ characters if it is shorter, or with its
    # trailing zeros dropped down to +width+ characters if it is longer.
    let trailingZeros(text: String, width: Integer) -> String do
      return trailingZeros(text + "0", width) if text.count < width
      return trailingZeros(text.take(text.count - 1), width) if text.count > width && text.endsWith?("0")
      return text
    end
  end
end
