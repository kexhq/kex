# Types that can say whether a value holds anything meaningful.
#
# A value is blank when it has no meaningful content: +None+, an empty or
# all-whitespace string, an empty collection, or +false+. The meaning follows
# Rails. One test works across types, so a validation can check every field
# the same way.
#
#   "".blank?        # => true
#   "   ".blank?     # => true   (unlike "   ".empty?)
#   [].blank?        # => true
#   None.blank?      # => true
#   "hi".present?    # => true
#
# +present?+ is the negation, and often reads better:
#
#   fields.all? { |name, value| value.present? }
trait Blankable do
  # Returns +true+ when the value holds nothing meaningful.
  #
  # Each type decides what that means: empty or whitespace-only for a
  # string, no elements for a collection, +None+ for an optional, +false+ for
  # a boolean.
  #
  # @return [Bool] +true+ when the value is blank
  #
  # @example
  #   "".blank?      # => true
  #   "  ".blank?    # => true
  #   "hi".blank?    # => false
  blank? :> Bool

  # Returns +true+ when the value holds something; the negation of +blank?+.
  #
  # @return [Bool] +true+ when the value is present
  #
  # @example
  #   "hi".present?   # => true
  #   "".present?     # => false
  #
  # @example Validating that required fields were filled in
  #   form.all? { |name, value| value.present? }
  let present? = !this.blank?
end

make Bool, implement: Blankable do
  # Returns +true+ for +false+, the only blank boolean.
  #
  # @return [Bool] +true+ when the value is +false+
  #
  # @example
  #   false.blank?   # => true
  #   true.blank?    # => false
  blank? :> Bool
  let blank? = !this
end

make Integer, implement: Blankable do
  # Returns +false+ for every integer, including zero.
  #
  # @return [Bool] always +false+
  #
  # @example
  #   0.blank?    # => false
  #   42.blank?   # => false
  blank? :> Bool
  let blank?(@_) = false
end

make Float, implement: Blankable do
  # Returns +false+ for every float, including zero.
  #
  # @return [Bool] always +false+
  #
  # @example
  #   0.0.blank?   # => false
  blank? :> Bool
  let blank?(@_) = false
end

make String, implement: Blankable do
  # Returns +true+ when the string is empty or contains only whitespace.
  #
  # A string of spaces is blank but not +empty?+. For user input, +blank?+ is
  # usually the test you want.
  #
  # @return [Bool] +true+ for an empty or whitespace-only string
  #
  # @example
  #   "".blank?        # => true
  #   "   ".blank?     # => true
  #   "\n\t".blank?    # => true
  #   " hi ".blank?    # => false
  #
  # @example Rejecting an empty answer
  #   let name = IO.getLine.or("")
  #   if name.blank?
  #     IO.printError("a name is required")
  #   end
  blank? :> Bool
  let blank? = this.trim.empty?
end

make Optional<X>, implement: Blankable do
  # Returns +true+ for +None+ and +false+ for any +Just+.
  #
  # +Just("")+ is not blank: the optional holds a value, even though that
  # value is itself blank.
  #
  # @return [Bool] +true+ for +None+
  #
  # @example
  #   None.blank?        # => true
  #   Just(1).blank?     # => false
  #   Just("").blank?    # => false
  blank? :> Bool
  let blank?(@None) = true
  let blank?(@Just(_)) = false
end

make [X], implement: Blankable do
  # Returns +true+ when the list has no elements.
  #
  # @return [Bool] +true+ for the empty list
  #
  # @example
  #   [].blank?         # => true
  #   [1, 2].blank?     # => false
  #
  # @example Reporting an empty result set
  #   if matches.blank?
  #     IO.printLine("no matches")
  #   end
  blank? :> Bool
  let blank?(@[]) = true
  let blank?(@[_|_]) = false
end
