type NetworkError = ConnectionRefused | Timeout | DnsError | SslError | NotImplemented | MockEmpty | Unknown

record HttpResponse do
  status  : Integer
  body    : String
  headers : Map<String, String>
end

record HttpError do
  kind    : NetworkError
  message : String
end

record HttpOptions do
  headers : Map<String, String> = {}
  timeout : Integer = 30000
end

module Http do
  get     : String -> Result<HttpResponse, HttpError>
  get     : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul get(url) = Kex.Intrinsic.Http.get(url)
  foul get(url, opts) = Kex.Intrinsic.Http.get(url, opts)

  post    : String -> String -> Result<HttpResponse, HttpError>
  post    : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul post(url, body) = Kex.Intrinsic.Http.post(url, body)
  foul post(url, body, opts) = Kex.Intrinsic.Http.post(url, body, opts)

  put     : String -> String -> Result<HttpResponse, HttpError>
  put     : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul put(url, body) = Kex.Intrinsic.Http.put(url, body)
  foul put(url, body, opts) = Kex.Intrinsic.Http.put(url, body, opts)

  patch   : String -> String -> Result<HttpResponse, HttpError>
  patch   : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul patch(url, body) = Kex.Intrinsic.Http.patch(url, body)
  foul patch(url, body, opts) = Kex.Intrinsic.Http.patch(url, body, opts)

  delete  : String -> Result<HttpResponse, HttpError>
  delete  : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul delete(url) = Kex.Intrinsic.Http.delete(url)
  foul delete(url, opts) = Kex.Intrinsic.Http.delete(url, opts)

  head    : String -> Result<HttpResponse, HttpError>
  head    : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul head(url) = Kex.Intrinsic.Http.head(url)
  foul head(url, opts) = Kex.Intrinsic.Http.head(url, opts)

  options : String -> Result<HttpResponse, HttpError>
  options : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul options(url) = Kex.Intrinsic.Http.options(url)
  foul options(url, opts) = Kex.Intrinsic.Http.options(url, opts)
end

# Deterministic HTTP responses for tests. Responses are consumed in FIFO order;
# an empty queue makes the next request return Error(HttpError).
# All Mock.* sub-modules live in a single `module Mock` block to avoid
# duplicate top-level `Mock` modules when prelude files are merged.
module Mock do
  module FS do
    File : FS.FilePath -> String -> Void
    Directory : FS.FilePath -> Void
    clear : Void

    foul File(path: FS.FilePath, content: String) -> Void do
      return Kex.Intrinsic.FS.file(path, content)
    end

    foul Directory(path: FS.FilePath) -> Void do
      return Kex.Intrinsic.FS.directory(path)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.FS.clear()
    end
  end

  module Http do
    start   : Void
    respond : Integer -> String -> Void
    respond : Integer -> String -> Map<String, String> -> Void
    stop    : Void

    foul start() -> Void do
      return Kex.Intrinsic.Http.mockStart()
    end

    foul respond(status: Integer, body: String) -> Void do
      return Kex.Intrinsic.Http.mockRespond(status, body)
    end

    foul respond(status: Integer, body: String, headers: Map<String, String>) -> Void do
      return Kex.Intrinsic.Http.mockRespond(status, body, headers)
    end

    foul stop() -> Void do
      return Kex.Intrinsic.Http.mockStop()
    end
  end

  # Overlays the process environment, so a test can say what `ENV` holds
  # instead of depending on how it was launched. `unset` is separate because
  # a variable being ABSENT is an answer programs act on.
  module ENV do
    set : String -> String -> Void
    unset : String -> Void
    clear : Void

    foul set(name: String, value: String) -> Void do
      return Kex.Intrinsic.Env.mockSet(name, value)
    end

    foul unset(name: String) -> Void do
      return Kex.Intrinsic.Env.mockUnset(name)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.Env.mockClear()
    end
  end

  # Makes the machine claim to be something else, so a test for another
  # system's behaviour can run on this one. Setter per fact, like Mock.FS.
  module System do
    OS : System.OperatingSystem -> Void
    BITWIDTH : Integer -> Void
    clear : Void

    foul OS(name: System.OperatingSystem) -> Void do
      return Kex.Intrinsic.System.mockOS(name)
    end

    foul BITWIDTH(bits: Integer) -> Void do
      return Kex.Intrinsic.System.mockBitWidth(bits)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.System.mockClear()
    end
  end

  module IO do
    foul start() -> Void do
      return Kex.Intrinsic.IO.ioMockStart()
    end

    foul stop() -> Void do
      return Kex.Intrinsic.IO.ioMockStop()
    end

    foul output() -> String do
      return Kex.Intrinsic.IO.ioMockOutput()
    end

    foul clear() -> Void do
      return Kex.Intrinsic.IO.ioMockClear()
    end

    foul input(lines) -> Void do
      return Kex.Intrinsic.IO.ioMockInput(lines)
    end

    foul input(first, second) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second])
    end

    foul input(first, second, third) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third])
    end

    foul input(first, second, third, fourth) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third, fourth])
    end
  end
end
