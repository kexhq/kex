# HTTP client requests.
#
# One function per method — +get+, +post+, +put+, +patch+, +delete+, +head+,
# +options+ — each answering a +Result+, so a network failure is a value you
# handle rather than an exception.
#
#   main do
#     match Http.get("https://example.com/api/status") do
#       Ok(response) => IO.printLine("${response.status}: ${response.body}")
#       Error(e)     => IO.printError("request failed: ${e.message}")
#     end
#   end
#
# An HTTP error status is NOT an +Error+: a 404 is a response the server
# chose to send, so it arrives as +Ok+ with +status: 404+. +Error+ means the
# request never got an answer — refused, timed out, DNS failed.
#
# Every call has a second form taking +HttpOptions+, for headers and timeouts.

# Why a request never reached an answer.
#
# Distinct from an HTTP status, which is an answer. +MockEmpty+ appears only
# under +Mock.Http+, when the queued responses have run out.
type NetworkError = ConnectionRefused | Timeout | DnsError | SslError | NotImplemented | MockEmpty | Unknown

# What the server answered.
record HttpResponse do
  # The HTTP status code — 200, 404, 500. Any of them is a successful
  # request.
  status  : Integer

  # The response body, as text.
  body    : String

  # The response headers, keyed by name.
  headers : Map<String, String>
end

# Why a request could not be completed.
record HttpError do
  # Which kind of network failure occurred.
  kind    : NetworkError

  # A human-readable description of the failure.
  message : String
end

# Per-request settings: headers to send, and how long to wait.
#
#   Http.get(url, HttpOptions {
#     headers: { "Authorization": "Bearer ${token}" },
#     timeout: 5000
#   })
record HttpOptions do
  # Headers to send with the request, keyed by name.
  headers : Map<String, String> = {}

  # How long to wait for an answer, in milliseconds.
  timeout : Integer = 30000
end

# HTTP client requests.
#
# A capability: every member performs a real network request, so a test can
# replace it for a lexical region with `with Http = ...` rather than mutating
# global mock state (kexhq/kex#143).
capability Http do
  # Fetches +url+.
  #
  # Answers +Ok+ whenever the server replied, whatever the status — check
  # +response.status+ for that. +Error+ means no answer arrived at all.
  #
  # @param url [String] the URL to fetch
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example
  #   match Http.get("https://example.com/") do
  #     Ok(response) => IO.printLine(response.body)
  #     Error(e)     => IO.printError(e.message)
  #   end
  #
  # @example An HTTP error status is still Ok
  #   Http.get(url).map { |r| r.status }   # => Ok(404)
  #
  # @example With an authorization header
  #   Http.get(url, HttpOptions {
  #     headers: { "Authorization": "Bearer ${token}" }
  #   })
  get     : String -> Result<HttpResponse, HttpError>
  get     : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul get(url) = Kex.Intrinsic.Http.get(url)
  foul get(url, opts) = Kex.Intrinsic.Http.get(url, opts)

  # Sends +body+ to +url+ with the POST method.
  #
  # The body is sent as given — set +Content-Type+ yourself through +opts+
  # when the server needs to know what it is.
  #
  # @param url [String] the URL to post to
  # @param body [String] the request body
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example Posting JSON
  #   Http.post(url, JSON.stringify(payload), HttpOptions {
  #     headers: { "Content-Type": "application/json" }
  #   })
  #
  # @example Posting a form body
  #   Http.post(url, "name=Ada&role=admin", HttpOptions {
  #     headers: { "Content-Type": "application/x-www-form-urlencoded" }
  #   })
  post    : String -> String -> Result<HttpResponse, HttpError>
  post    : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul post(url, body) = Kex.Intrinsic.Http.post(url, body)
  foul post(url, body, opts) = Kex.Intrinsic.Http.post(url, body, opts)

  # Sends +body+ to +url+ with the PUT method, replacing the resource there.
  #
  # @param url [String] the URL to write to
  # @param body [String] the request body
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example
  #   Http.put("${base}/items/42", JSON.stringify(item), HttpOptions {
  #     headers: { "Content-Type": "application/json" }
  #   })
  put     : String -> String -> Result<HttpResponse, HttpError>
  put     : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul put(url, body) = Kex.Intrinsic.Http.put(url, body)
  foul put(url, body, opts) = Kex.Intrinsic.Http.put(url, body, opts)

  # Sends +body+ to +url+ with the PATCH method, updating part of the
  # resource there.
  #
  # @param url [String] the URL to update
  # @param body [String] the request body
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example
  #   Http.patch("${base}/items/42", JSON.stringify({ done: true }))
  patch   : String -> String -> Result<HttpResponse, HttpError>
  patch   : String -> String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul patch(url, body) = Kex.Intrinsic.Http.patch(url, body)
  foul patch(url, body, opts) = Kex.Intrinsic.Http.patch(url, body, opts)

  # Sends a DELETE request to +url+.
  #
  # @param url [String] the URL to delete
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example
  #   Http.delete("${base}/items/42").map { |r| r.status }   # => Ok(204)
  delete  : String -> Result<HttpResponse, HttpError>
  delete  : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul delete(url) = Kex.Intrinsic.Http.delete(url)
  foul delete(url, opts) = Kex.Intrinsic.Http.delete(url, opts)

  # Fetches +url+'s headers without its body.
  #
  # The cheap way to ask whether something is there, how big it is, or when it
  # last changed.
  #
  # @param url [String] the URL to inspect
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example Checking that a resource exists
  #   Http.head(url).map { |r| r.status == 200 }.or(false)
  #
  # @example Reading a header without downloading the body
  #   Http.head(url).flatMap { |r| r.headers.get("Content-Length").ok? }
  head    : String -> Result<HttpResponse, HttpError>
  head    : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul head(url) = Kex.Intrinsic.Http.head(url)
  foul head(url, opts) = Kex.Intrinsic.Http.head(url, opts)

  # Asks +url+ which methods it supports, with an OPTIONS request.
  #
  # @param url [String] the URL to ask about
  # @param opts [HttpOptions] headers and timeout; omitted for the defaults
  # @return [Result<HttpResponse, HttpError>] the response, or why it failed
  #
  # @example
  #   Http.options(url).flatMap { |r| r.headers.get("Allow") }
  options : String -> Result<HttpResponse, HttpError>
  options : String -> HttpOptions -> Result<HttpResponse, HttpError>
  foul options(url) = Kex.Intrinsic.Http.options(url)
  foul options(url, opts) = Kex.Intrinsic.Http.options(url, opts)
end

# The Mock.* stand-ins used to live here; they moved to mock.kex (opt-in,
# issue #144) — deterministic Http responses for tests are still available
# via `Mock.Http` there: responses are consumed in FIFO order, and an empty
# queue makes the next request return Error(HttpError).
