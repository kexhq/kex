# Parser combinators for user-defined text formats.
#
# An Input is immutable: successful parsers return the parsed value together
# with an advanced cursor. Failure leaves the caller free to try an alternative.
module Parsing

# `Expected` carries what the grammar WANTED rather than what it found — the
# difference between "unexpected `d`" and "expected `version(`". It is what
# `label` and `string` report.
type ParseError = Unexpected(String, Integer)
                | Expected(String, Integer)
                | NoMatch(Integer)

record Input do
  input : String
  pos   : Integer = 0
end

make Input do
  let peek = @pos < @input.count then Just(@input.at(@pos)) else None

  let peekAt(offset: Integer) -> Char? do
    let index = @pos + offset
    return None if index < 0 || index >= @input.count
    return Just(@input.at(index))
  end

  let atEnd? = @pos >= @input.count

  let advance = Input { input: @input, pos: @pos + 1 }

  let advanceBy(count: Integer) -> Input = Input { input: @input, pos: @pos + count }

  let remaining = @input.chars.drop(@pos).join("")

  let charWhen(pred: Char -> Bool) -> Result<(Char, Input), ParseError> do
    match this.peek do
      Just(c) when pred(c) -> Ok((c, this.advance))
      Just(c) -> Error(Unexpected("${c}", @pos))
      None -> Error(Unexpected("EOF", @pos))
    end
  end

  let char(expected: Char) -> Result<(Char, Input), ParseError> do
    this.charWhen { |c| c == expected }
  end

  let whiteSpaces -> Input do
    var cursor = this
    loop do
      break if cursor.peek == None
      let Just(c) = cursor.peek
      break if !c.space?
      cursor = cursor.advance
    end
    return cursor
  end

  let many(f: Input -> Result<(T, Input), ParseError>) -> ([T], Input) do
    var results: [T] = []
    var p = this
    loop do
      trying do
        let (value, advanced) = f(p).try
        return (results, p) if advanced.pos == p.pos
        results.push!(value)
        p = advanced
      rescue return (results, p)
      end
    end
  end

  let some(f: Input -> Result<(T, Input), ParseError>) -> ([T], Input) or! ParseError do
    let (first, p) = f(this).try
    let (rest, advanced) = p.many(f)
    Ok(([first, ...rest], advanced))
  end

  # An exact literal. A keyword grammar is mostly literals — `version(` is one
  # token to a reader and eight calls to `char` — and matching it here reports
  # the failure at the START of the literal, which is where a person looking at
  # the error expects the caret.
  let string(expected: String) -> (String, Input) or! ParseError do
    let wanted = expected.chars
    var index = 0
    loop do
      break if index >= wanted.count
      return Error(Expected(expected, @pos)) if this.peekAt(index) != Just(wanted.at(index))
      index = index + 1
    end
    Ok((expected, this.advanceBy(wanted.count)))
  end

  # Every character while +pred+ holds, as a String. `many(charWhen(...))` gives
  # a [Char] the caller has to join, and a run of characters is almost always
  # wanted as text. Cannot fail: an empty run is an empty String, which is what
  # makes it safe for the optional parts of a grammar.
  let takeWhile(pred: Char -> Bool) -> (String, Input) do
    var cursor = this
    var collected: [Char] = []
    loop do
      break if cursor.peek == None
      let Just(c) = cursor.peek
      break if !pred(c)
      collected.push!(c)
      cursor.advance!
    end
    return (collected.join(""), cursor)
  end

  let choice(alts: [Input -> Result<(T, Input), ParseError>]) -> (T, Input) or! ParseError do
    var index = 0
    loop do
      break if index >= alts.count
      trying do
        let f = alts.at(index)
        let result = f(this).try
        return Ok(result)
      rescue
        _ -> index = index + 1
      end
    end
    Error(NoMatch(@pos))
  end
end
