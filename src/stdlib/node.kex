# Distributed Kex: this BEAM node, and the other nodes it is connected to.
#
# A node is one running BEAM VM with a name. Once two nodes share a cookie and
# are connected, a +Pid+ from one works on the other: +send+, +link+ and
# +monitor+ cross the network unchanged, and so do typed +Process+ and
# +Server+ handles.
#
# Name a node when starting it (`kex --sname a --cookie secret app.kex`), or
# from inside the program with +Node.start+:
#
#   using Node
#
#   main do
#     Node.connect(:b@myhost)
#     Node.send(:b@myhost, :logger, (:hello, Node.self))
#   end
#
# Node names are atoms: `:b@myhost` for a short name, the quoted
# `:"b@host.example.com"` for one with dots, or `Atom.from(text)` for one
# built at runtime.
#
# Both nodes need the same compiled code for anything that carries a function,
# like a lambda or a record whose methods the receiver calls; +Node.spawn+
# sends its block's code along. Plain data — numbers, strings, lists, tuples,
# records — needs nothing.
#
# Backed by Kex.Intrinsic.Node on the BEAM. The tree-walk interpreter is always
# a single, unnamed node.
module Node do
  # This node's name, or +:nonode@nohost+ when it is not distributed.
  #
  # @return [Atom] the node name
  #
  # @example
  #   Node.self   # => :a@myhost
  self : Atom
  foul self = Kex.Intrinsic.Node.self

  # Whether this node is distributed — started with a name, so other nodes
  # can connect to it.
  #
  # @return [Bool] true once the node has a name
  #
  # @example
  #   Node.alive?   # => false, unless started with --sname or Node.start
  alive? : Bool
  foul alive? = Kex.Intrinsic.Node.alive?

  # The nodes this one is currently connected to, not including itself.
  #
  # @return [[Atom]] the connected node names
  #
  # @example
  #   Node.list   # => [:b@myhost]
  list : [Atom]
  foul list = Kex.Intrinsic.Node.list

  # Makes this node distributed under +name+, as `--sname`/`--name` would at
  # startup. A +name+ whose host has a dot (`:"app@host.example.com"`) uses
  # long names; anything else uses short names.
  #
  # @param name [Atom] the node name, like +:app+ or +:app@myhost+
  # @return [Result<Atom, String>] the full node name, or why it could not start
  #
  # @example
  #   Node.start(:app)   # => Ok(:app@myhost)
  start : Atom -> Result<Atom, String>
  foul start(name) = Kex.Intrinsic.Node.start(name)

  # Stops distribution: the node drops its name and every connection.
  #
  # @return [Bool] whether it was distributed and has now stopped
  stop : Bool
  foul stop = Kex.Intrinsic.Node.stop

  # Connects to the node named +node+. Both nodes must share a cookie.
  #
  # @param node [Atom] the node to connect to
  # @return [Bool] whether the connection is up
  #
  # @example
  #   Node.connect(:b@myhost)   # => true
  connect : Atom -> Bool
  foul connect(node) = Kex.Intrinsic.Node.connect(node)

  # Drops the connection to +node+.
  #
  # @param node [Atom] the node to disconnect from
  # @return [Bool] whether a connection was dropped
  disconnect : Atom -> Bool
  foul disconnect(node) = Kex.Intrinsic.Node.disconnect(node)

  # Sets the cookie this node presents when connecting. Nodes connect only
  # when their cookies match.
  #
  # @param cookie [String] the shared secret
  # @return [Void]
  setCookie : String -> Void
  foul setCookie(cookie) = Kex.Intrinsic.Node.setCookie(cookie)

  # Sends +message+ to the process registered as +name+ on +node+, unchanged.
  # Like +Pid.send+, it never blocks and never fails.
  #
  # @param node [Atom] the node the process runs on
  # @param name [Atom] the name it was registered under
  # @param message [X] the message
  # @return [Void]
  #
  # @example
  #   Node.send(:b@myhost, :logger, (:info, "started"))
  send : Atom -> Atom -> X -> Void
  foul send(node, name, message) = Kex.Intrinsic.Node.send(node, name, message)

  # The +Pid+ registered as +name+ on +node+, or +None+.
  #
  # @param node [Atom] the node to ask
  # @param name [Atom] the registered name
  # @return [Pid?] the process, or +None+
  #
  # @example
  #   Node.whereis(:b@myhost, :logger).map { |pid| pid.send(:flush) }
  whereis : Atom -> Atom -> Pid?
  foul whereis(node, name) = Kex.Intrinsic.Node.whereis(node, name)

  # Runs +block+ in a new process on +node+ and returns its +Pid+.
  #
  # The block is a function of THIS program. When +node+ has not loaded the
  # module it belongs to, that module's compiled code is sent over and loaded
  # first. A module +node+ already has is left as it is.
  #
  # @param node [Atom] where to run it
  # @param block [Block<X>] the work
  # @return [Pid] the new process
  #
  # @example
  #   let me = Process.self
  #   Node.spawn(:b@myhost) do me.send(Node.self) end
  spawn : Atom -> Block<X> -> Pid
  foul spawn(node, block) = Kex.Intrinsic.Node.spawn(node, block)
end
