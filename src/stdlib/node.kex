# Distributed Kex: this BEAM node and the nodes it is connected to.
#
# A node is a running BEAM VM with a name. Once two nodes with the same cookie
# are connected, a +Process+ from one works on the other: +send+, +link+,
# +monitor+ and +Server+ handles all work across the network.
#
# Name a node when starting it (+kex --sname a --cookie secret app.kex+), or
# from inside the program with +Node.start+:
#
#   using Node
#
#   main do
#     Node.connect(:b@myhost)
#     Node.send(:b@myhost, :logger, (:hello, Node.self))
#   end
#
# Node names are atoms: +:b@myhost+ for a short name, a quoted
# +:"b@host.example.com"+ for one with dots, or +Atom.from(text)+ for one
# built at run time.
#
# Plain data (numbers, strings, lists, tuples, records) can be sent anywhere.
# A message that carries a function, such as a lambda, needs the same compiled
# code on both nodes; +Node.spawn+ sends its block's code along.
#
# Under the tree-walk interpreter (+kex -R+) the program is always a single
# node with no name.
module Node do
  # Returns this node's name, or +:nonode@nohost+ when it is not distributed.
  #
  # @return [Atom] the node name
  #
  # @example
  #   Node.self   # => :a@myhost
  self : Atom
  foul self = Kex.Intrinsic.Node.self

  # Returns +true+ when this node has a name, so other nodes can connect to
  # it.
  #
  # @return [Bool] +true+ once the node has a name
  #
  # @example
  #   Node.alive?   # => false, unless started with --sname or Node.start
  alive? : Bool
  foul alive? = Kex.Intrinsic.Node.alive?

  # Returns the nodes this one is connected to, not including itself.
  #
  # @return [[Atom]] the connected node names
  #
  # @example
  #   Node.list   # => [:b@myhost]
  list : [Atom]
  foul list = Kex.Intrinsic.Node.list

  # Makes this node distributed under +name+, as +--sname+ or +--name+ would
  # at startup. A name whose host has a dot (+:"app@host.example.com"+) uses
  # long names; any other uses short names.
  #
  # @param name [Atom] the node name, like +:app+ or +:app@myhost+
  # @return [Result<Atom, String>] the full node name, or why it could not start
  #
  # @example
  #   Node.start(:app)   # => Ok(:app@myhost)
  start : Atom -> Result<Atom, String>
  foul start(name) = Kex.Intrinsic.Node.start(name)

  # Stops distribution: the node drops its name and every connection.
  #
  # @return [Result<Void, String>] +Ok+ once stopped, or an +Error+ when the
  #   node was not distributed
  stop : Result<Void, String>
  foul stop = Kex.Intrinsic.Node.stop then Ok(()) else Error("this node is not distributed")

  # Connects to the node named +node+. Both nodes must share a cookie.
  #
  # @param node [Atom] the node to connect to
  # @return [Result<Void, String>] +Ok+ once the connection is up, or why it is not
  #
  # @example
  #   Node.connect(:b@myhost)   # => Ok(())
  connect : Atom -> Result<Void, String>
  foul connect(node) do
    Kex.Intrinsic.Node.connect(node) then Ok(()) else Error("could not connect to ${node}")
  end

  # Drops the connection to +node+.
  #
  # @param node [Atom] the node to disconnect from
  # @return [Result<Void, String>] +Ok+ once dropped, or an +Error+ when there
  #   was no connection
  disconnect : Atom -> Result<Void, String>
  foul disconnect(node) do
    Kex.Intrinsic.Node.disconnect(node) then Ok(()) else Error("not connected to ${node}")
  end

  # Sets the cookie this node presents when connecting. Nodes connect only
  # when their cookies match.
  #
  # @param cookie [String] the shared secret
  # @return [Void]
  setCookie : String -> Void
  foul setCookie(cookie) = Kex.Intrinsic.Node.setCookie(cookie)

  # Sends +message+ to the process registered as +name+ on +node+.
  #
  # Like +Process.send+, it does not block and does not fail, even when no
  # such process exists.
  #
  # @param node [Atom] the node the process runs on
  # @param name [Atom] the name it was registered under
  # @param message [X] the message
  # @return [Void]
  #
  # @example
  #   Node.send(:b@myhost, :logger, (:info, "started"))
  send : Atom -> Atom -> X -> Void
  foul send(node, name, message) = Kex.Intrinsic.Node.send(node, name, message)

  # Returns the process registered as +name+ on +node+, or +None+.
  #
  # @param node [Atom] the node to ask
  # @param name [Atom] the registered name
  # @return [Process<A>?] the process, or +None+
  #
  # @example
  #   Node.whereIs(:b@myhost, :logger).map { |pid| pid.send(:flush) }
  whereIs : Atom -> Atom -> Process<A>?
  foul whereIs(node, name) = Kex.Intrinsic.Node.whereIs(node, name)

  # Runs +block+ in a new process on +node+ and returns it.
  #
  # When +node+ has not loaded the module the block belongs to, that module's
  # compiled code is sent and loaded first. A module +node+ already has is not
  # replaced.
  #
  # @param node [Atom] where to run it
  # @param block [Block<X>] the work
  # @return [Process<A>] the new process
  #
  # @example
  #   let me = Process.self
  #   Node.spawn(:b@myhost) do me.send(Node.self) end
  spawn : Atom -> Block<X> -> Process<A>
  foul spawn(node, block) = Kex.Intrinsic.Node.spawn(node, block)
end
