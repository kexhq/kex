# Calendar spans such as +1.month+ and +2.year+, whose length depends on the
# date they are added to. Elapsed time is a +Duration+, in duration.kex.

# A span of calendar years, months and days.
#
# February has 28 or 29 days and a year 365 or 366, so a month or a year is not
# a fixed number of seconds and cannot be a +Duration+. A +Period+ keeps the
# calendar fields, and adding it to a date clamps the day to the end of a
# shorter month:
#
#   Date.of(2026, 1, 31).try + 1.month        # 2026-02-28
#   Date.of(2024, 2, 29).try + 1.year         # 2025-02-28
#
# Use a +Duration+ for elapsed time (+36.hour+ is always 129600 seconds) and a
# +Period+ for calendar steps.
record Period do
  # The number of whole years in the span.
  years : Integer

  # The number of whole months in the span.
  months : Integer

  # The number of whole days in the span.
  days : Integer
end

# The calendar spans +1.month+ and +2.year+ on +Integer+.
#
# These return a +Period+. The fixed time units (+5.second+, +90.minute+,
# +2.week+) return a +Duration+ and live in units.kex; +4.week+ is always 28
# days.
make Integer do
  # Returns a +Period+ of this many calendar months.
  #
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2026, 7, 30).try + 1.month).iso   # => "2026-08-30"
  #
  # @example The calendar clamps a day that does not exist
  #   (Date.of(2026, 1, 31).try + 1.month).iso   # => "2026-02-28"
  let month -> Period = Period { years: 0, months: this, days: 0 }

  # Returns a +Period+ of this many calendar years.
  #
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2024, 2, 29).try + 1.year).iso   # => "2025-02-28"
  let year -> Period = Period { years: this, months: 0, days: 0 }
end


# Constructors for +Period+.
module Period do
  # Returns the empty span.
  #
  # @return [Period] the zero span
  #
  # @example
  #   Period.zero().iso     # => "P0D"
  #   Period.zero().zero?   # => true
  let zero() -> Period = Period { years: 0, months: 0, days: 0 }

  # Returns a span of the given years, months and days.
  #
  # @param years [Integer] whole years
  # @param months [Integer] whole months
  # @param days [Integer] whole days
  # @return [Period] the calendar span
  #
  # @example
  #   Period.of(1, 2, 3).iso   # => "P1Y2M3D"
  let of(years: Integer, months: Integer, days: Integer) -> Period = Period { years: years, months: months, days: days }

  # Returns a span of +count+ calendar years.
  #
  # @param count [Integer] how many years
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2024, 2, 29).try + Period.years(1)).iso   # => "2025-02-28"
  let years(count: Integer) -> Period = Period { years: count, months: 0, days: 0 }

  # Returns a span of +count+ calendar months.
  #
  # @param count [Integer] how many months
  # @return [Period] the calendar span
  #
  # @example
  #   (Date.of(2026, 1, 31).try + Period.months(1)).iso   # => "2026-02-28"
  let months(count: Integer) -> Period = Period { years: 0, months: count, days: 0 }

  # Returns a span of +count+ calendar days.
  #
  # @param count [Integer] how many days
  # @return [Period] the calendar span
  #
  # @example
  #   Period.days(10).iso   # => "P10D"
  let days(count: Integer) -> Period = Period { years: 0, months: 0, days: count }

  # Returns a span of +count+ weeks, stored as +count * 7+ days.
  #
  # @param count [Integer] how many weeks
  # @return [Period] the calendar span
  #
  # @example
  #   Period.weeks(2).iso   # => "P14D"
  let weeks(count: Integer) -> Period = Period { years: 0, months: 0, days: count * 7 }
end

make Period, implement: Inspectable, Showable do
  # Returns the period's fields, for debugging output.
  #
  # @param colors [Bool] whether to include ANSI color escapes
  # @return [String] the rendered period
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.Kex.inspect(this, colors)

  # Returns the ISO 8601 form, which is what interpolation and +IO.printLine+
  # show.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   "due in ${Period.of(0, 1, 0)}"   # => "due in P1M"
  let showValue -> String = this.iso

  # Returns the sum of two spans, field by field.
  #
  # @param other [Period] the span to add
  # @return [Period] the total
  #
  # @example
  #   (Period.of(1, 2, 3) + 1.year).iso   # => "P2Y2M3D"
  let +(other: Period) -> Period = Period { years: this.years + other.years, months: this.months + other.months, days: this.days + other.days }

  # Returns the difference of two spans, field by field. Fields can go
  # negative.
  #
  # @param other [Period] the span to subtract
  # @return [Period] the difference
  #
  # @example
  #   (Period.of(1, 2, 3) - 1.year).iso   # => "P2M3D"
  let -(other: Period) -> Period = Period { years: this.years - other.years, months: this.months - other.months, days: this.days - other.days }

  # Returns the span with the sign of every field flipped.
  #
  # @return [Period] the negated span
  #
  # @example
  #   Period.of(1, 2, 3).negated.iso   # => "P-1Y-2M-3D"
  let negated -> Period = Period { years: 0 - this.years, months: 0 - this.months, days: 0 - this.days }

  # Returns the span with every field multiplied by +factor+.
  #
  # @param factor [Integer] the factor to multiply by
  # @return [Period] the scaled span
  #
  # @example
  #   (Period.of(1, 2, 3) * 2).iso   # => "P2Y4M6D"
  let *(factor: Integer) -> Period = Period { years: this.years * factor, months: this.months * factor, days: this.days * factor }

  # Returns whether every field is zero.
  #
  # @return [Bool] +true+ for a zero span
  #
  # @example
  #   Period.zero().zero?          # => true
  #   Period.of(0, 1, 0).zero?     # => false
  let zero? -> Bool = this.years == 0 && this.months == 0 && this.days == 0

  # Returns the years and months of the span as one count of months.
  #
  # A year is always 12 months, while a month has no fixed number of days, so
  # +date + span+ adds the years and months in one step and the days after.
  #
  # @return [Integer] the total months, ignoring days
  #
  # @example
  #   Period.of(1, 2, 3).totalMonths   # => 14
  let totalMonths -> Integer = this.years * 12 + this.months

  # Returns the span with whole years of months carried into +years+.
  #
  # 14 months becomes 1 year 2 months. Days are not carried, since a month has
  # no fixed number of them.
  #
  # @return [Period] the normalised span
  #
  # @example
  #   14.month.normalized.iso   # => "P1Y2M"
  let normalized -> Period do
    let total = this.totalMonths
    return Period { years: (total - total.modulo(12)) / 12, months: total.modulo(12), days: this.days }
  end

  # Returns the span as an ISO 8601 duration such as +P1Y2M3D+.
  #
  # The empty span is +P0D+, because a bare +P+ is not valid ISO 8601.
  #
  # @return [String] the ISO 8601 duration
  #
  # @example
  #   Period.of(1, 2, 3).iso   # => "P1Y2M3D"
  #   Period.zero().iso        # => "P0D"
  #   2.month.iso              # => "P2M"
  let iso -> String do
    return "P0D" if this.zero?
    let years = this.years != 0 then "${this.years}Y" else ""
    let months = this.months != 0 then "${this.months}M" else ""
    let days = this.days != 0 then "${this.days}D" else ""
    return "P${years}${months}${days}"
  end
end
