# A lazy, potentially infinite sequence.
#
# A stream holds the rule for producing its elements, so it can be
# infinite. Elements are computed only when you ask for them with +take+.
#
#   let naturals = Stream.from(0) { |n| n + 1 }
#   naturals.take(5)                              # => [0, 1, 2, 3, 4]
#   naturals.map { |n| n * n }.take(4)            # => [0, 1, 4, 9]
#   naturals.filter { |n| n.even? }.take(3)       # => [0, 2, 4]
#
# +map+, +filter+ and +drop+ return another stream, so a whole pipeline stays
# lazy until +take+ turns it into a list.
#
# Streams suit generated sequences that you may read more than once. A file
# or socket can only be read once, so functions that read them return a
# +Feed+. A feed's +toStream+ gives a stream that can be replayed, at the cost
# of keeping every value read so far, so use it only for small inputs.
type Stream<A>

# Constructors for +Stream+.
module Stream do
  # Builds an infinite stream from a first element and a step function.
  #
  # The stream is +start+, then +step(start)+, then +step(step(start))+, and so
  # on. Nothing is computed until you take from it.
  #
  # @param start [A] the first element
  # @param step [A -> A] produces the next element from the current one
  # @return [Stream<A>] the generated stream
  #
  # @example Counting up
  #   let naturals = Stream.from(0) { |n| n + 1 }
  #   naturals.take(5)   # => [0, 1, 2, 3, 4]
  #
  # @example Powers of two
  #   let powers = Stream.from(1) { |n| n * 2 }
  #   powers.take(6)     # => [1, 2, 4, 8, 16, 32]
  #
  # @example A geometric decay
  #   Stream.from(1.0) { |x| x / 2.0 }.take(4)
  #   # => [1.0, 0.5, 0.25, 0.125]
  from :> A -> (A -> A) -> Stream<A>
  let from(start, step) = Kex.Intrinsic.Stream.generate(start, step)

  # Returns the stream with no elements.
  #
  # @return [Stream<A>] the empty stream
  #
  # @example
  #   Stream.empty.take(3)   # => []
  empty :> Stream<A>
  let empty = Kex.Intrinsic.Stream.empty()
end

make Stream<A> do
  # Returns the first +n+ elements as a list, computing the stream up to that
  # point. It is how a lazy pipeline ends.
  #
  # @param n [Integer] how many elements to produce
  # @return [[A]] the first +n+ elements
  #
  # @example
  #   Stream.from(1) { |n| n + 1 }.take(3)   # => [1, 2, 3]
  #
  # @example The first ten squares
  #   Stream.from(1) { |n| n + 1 }
  #     .map { |n| n * n }
  #     .take(10)
  #
  # @example Retry delays that double each time
  #   let delays = Stream.from(1.second) { |d| d * 2 }
  #   delays.take(4)   # => 1, 2, 4 and 8 seconds, as time measures
  take :> Integer -> [A]
  let take(n) = Kex.Intrinsic.Stream.take(this, n)

  # Returns a new stream that skips the first +n+ elements.
  #
  # The result is still lazy. Follow it with +take+ to get a window from the
  # middle.
  #
  # @param n [Integer] how many elements to skip
  # @return [Stream<A>] the stream, offset by +n+
  #
  # @example
  #   Stream.from(0) { |n| n + 1 }.drop(3).take(3)   # => [3, 4, 5]
  #
  # @example Paging through a generated sequence
  #   let page(n: Integer) = source.drop(n * 20).take(20)
  drop :> Integer -> Stream<A>
  let drop(n) = Kex.Intrinsic.Stream.drop(this, n)

  # Returns a new stream with +f+ applied to each element.
  #
  # +f+ is not called until elements are taken, and then only for those that
  # are.
  #
  # @param f [A -> B] applied to each element
  # @return [Stream<B>] the mapped stream
  #
  # @example
  #   Stream.from(1) { |n| n + 1 }.map { |n| n * n }.take(4)
  #   # => [1, 4, 9, 16]
  #
  # @example Formatting as it goes
  #   Stream.from(1) { |n| n + 1 }
  #     .map { |n| "item ${n}" }
  #     .take(3)
  #   # => ["item 1", "item 2", "item 3"]
  map :> (A -> B) -> Stream<B>
  let map(f) = Kex.Intrinsic.Stream.map(this, f)

  # Returns a new stream with only the elements +pred+ accepts.
  #
  # Taking +n+ filtered elements may mean computing many more elements of the
  # original stream. If +pred+ rarely holds, +take+ runs for a long time; if
  # it never holds, +take+ never returns.
  #
  # @param pred [A -> Bool] the test applied to each element
  # @return [Stream<A>] the filtered stream
  #
  # @example
  #   let evens = Stream.from(0) { |n| n + 1 }.filter { |n| n.even? }
  #   evens.take(4)   # => [0, 2, 4, 6]
  #
  # @example Multiples of three, formatted
  #   Stream.from(1) { |n| n + 1 }
  #     .filter { |n| n.dividesBy?(3) }
  #     .map { |n| "#${n}" }
  #     .take(3)
  #   # => ["#3", "#6", "#9"]
  filter :> (A -> Bool) -> Stream<A>
  let filter(pred) = Kex.Intrinsic.Stream.filter(this, pred)

  # Applies +f+ to every element, for its side effects.
  #
  # It only finishes on a stream that ends, such as a file's lines converted
  # with +Feed.toStream+. On an infinite stream from +Stream.from+ it never
  # returns, so bound it with +take+ first.
  #
  # @param f [A -> Void] applied to each element
  # @return [Void]
  #
  # @example
  #   Stream.from(1) { |n| n + 1 }
  #     .map { |n| n * n }
  #     .toFeed
  #     .take(3)
  #     .each { |n| IO.printLine(n) }
  each :> (A -> Void) -> Void
  let each(f) = Kex.Intrinsic.Stream.each(this, f)

  # Returns a +Feed+ that walks this stream once.
  #
  # A stream keeps every element computed from it for as long as the stream
  # is in scope. A feed lets each element go once it has been read, so use
  # +toFeed+ to walk a long stream in constant memory.
  #
  # @return [Feed<A>] a one-shot cursor over the stream
  #
  # @example Summing a long generated sequence without holding it
  #   let total = Stream.from(1) { |n| n + 1 }
  #     .toFeed
  #     .take(1000000)
  #     .sum
  toFeed :> Feed<A>
  let toFeed = Kex.Intrinsic.Stream.toFeed(this)
end
