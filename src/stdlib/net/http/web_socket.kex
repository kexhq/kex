# WebSocket (RFC 6455) connections that send and receive whole messages.
#
# A +Connection+ reassembles fragmented messages and answers pings itself. It
# does not reconnect or send heartbeats: what a dropped connection means, such
# as having to subscribe again or resume from a cursor, is up to your program.
#
#   using Net.HTTP.WebSocket
#
#   let socket = WebSocket.connect("wss://example.test/events").try
#   socket.send(Text("hello")).try
#   let message = socket.receiveMessage.try
#   socket.close
module Net.HTTP.WebSocket

using Net.HTTP

# One complete WebSocket message.
#
# +CloseMessage+ carries the peer's status code and reason. It ends the
# message stream, whatever the code, and later reads fail with +Closed+.
type Message = Text(String) | BinaryMessage(Binary) | CloseMessage(Integer, String)

# Options for a client connection: the subprotocols to offer and the largest
# message to accept.
#
# List +subprotocols+ in order of preference. +maximumMessageBytes+ (16 MiB by
# default) applies to a whole reassembled message, so many small fragments
# cannot get around it; a larger incoming message is a +Limit+ error. It also
# caps what +send+ accepts.
record ClientOptions do
  subprotocols : [String] = []
  maximumMessageBytes : Integer = 16777216
end

# What the handshake settled. +subprotocol+ is +None+ when none was chosen.
record Session do
  subprotocol : String?
end

# An open WebSocket connection, on the client or the server side. It does not
# reconnect on its own.
type Connection

# The subprotocols an incoming upgrade request offers, in the order the
# client listed them.
record Handshake do
  subprotocols : [String] = []
end

# A server's answer to a +Handshake+.
#
# +Accept(handler, headers, subprotocol)+ sends the 101 response and then runs
# +handler+ with the server +Connection+; its return value is ignored. The
# +headers+ are added to the 101 response, except +Upgrade+, +Connection+,
# +Sec-WebSocket-Accept+, +Sec-WebSocket-Protocol+ and +Content-Length+, which
# are dropped. +subprotocol+ must be one the client offered, or +None+;
# choosing any other makes the server answer 500.
#
# +Reject(response)+ sends +response+ as a plain HTTP response, such as
# +Response.text(426, "chat.v2 required")+ for a client that lacks a
# subprotocol you need.
type Upgrade = Accept(Connection -> Void, Headers, String?) | Reject(Response<Binary>)

# Opening client connections and accepting server ones.
module WebSocket do
  # Opens a client connection to a +ws:+ or +wss:+ URL with default options.
  #
  # A +wss:+ connection verifies the server's certificate. The handshake gives
  # up with a +Timeout+ error after about 11 seconds.
  #
  # @param url [String] an absolute WebSocket URL
  # @return [Result<Connection, NetError>] the connection, or why it could not
  #   be opened
  #
  # @example Following a live event feed
  #   let socket = WebSocket.connect("wss://events.example.com/orders").try
  #   match socket.receiveMessage.try do
  #     Text(json) => IO.printLine(json)
  #     _          => IO.printError("unexpected non-text event")
  #   end
  foul connect(url: String) -> Result<Connection, NetError> = Kex.Intrinsic.NetWebSocket.connect(url, ClientOptions {})
  # Opens a client connection with the given subprotocols and message limit.
  #
  # Extensions are never negotiated. An invalid subprotocol name, a server that
  # picks a subprotocol you did not offer, a TLS failure and a malformed
  # handshake are all errors.
  #
  # @param url [String] an absolute WebSocket URL
  # @param options [ClientOptions] the subprotocols to offer and the message
  #   limit
  # @return [Result<Connection, NetError>] the connection, or why it could not
  #   be opened
  #
  # @example Requesting a versioned application protocol with a 1 MiB limit
  #   WebSocket.connect(url, ClientOptions {
  #     subprotocols: ["events.v2", "events.v1"],
  #     maximumMessageBytes: 1024 * 1024
  #   }).try
  foul connect(url: String, options: ClientOptions) -> Result<Connection, NetError> = Kex.Intrinsic.NetWebSocket.connect(url, options)

  # Answers a WebSocket upgrade request in a +Net.HTTP.Server+ route handler.
  #
  # Return the result from the handler as it is. +decide+ is called only for a
  # valid handshake. A request that is not one gets 400 Bad Request (wrong
  # method, a missing or malformed +Sec-WebSocket-Key+), or 426 Upgrade
  # Required when the +Sec-WebSocket-Version+ is not 13.
  #
  # @param request [Request<Binary>] the request the route handler received
  # @param decide [Handshake -> Upgrade] chooses to accept or reject
  # @return [Response<Binary>] the response to return from the handler; the
  #   server recognises an accepted upgrade in it
  #
  # @example An authenticated, subprotocol-gated chat route
  #   foul socketRoute(request: Request<Binary>, context: Context) -> Response<Binary> = WebSocket.upgrade(request) do |handshake|
  #     if handshake.subprotocols.contains?("chat.v2")
  #       let handler : Connection -> Void = { |socket| serveChat(socket) }
  #       Accept(handler, Headers.empty, Just("chat.v2"))
  #     else
  #       Reject(Response.text(426, "chat.v2 required"))
  #     end
  #   end
  #   let router = Router.build.get("/socket", ~socketRoute)
  foul upgrade(request: Request<Binary>, decide: Handshake -> Upgrade) -> Response<Binary> = Kex.Intrinsic.NetWebSocket.upgrade(request, decide)
end

make Connection do
  # Sends one text, binary or close message.
  #
  # Text that is not valid UTF-8, a message over the size limit and an invalid
  # close code are +Protocol+ errors. Sending on a closed connection is a
  # +Closed+ error. On a client connection any failed send also closes the
  # connection.
  #
  # @param message [Message] the message to send
  # @return [Result<Void, NetError>] nothing, or why the message was not sent
  #
  # @example Subscribing after connecting
  #   connection.send(Text(JSON.stringify({ action: "subscribe", topic: topic }))).try
  foul send(message: Message) -> Result<Void, NetError> = Kex.Intrinsic.NetWebSocket.send(this, message)
  # Waits for the next message and returns it, for as long as the peer stays
  # connected.
  #
  # Fragments are joined and pings answered along the way. Text that is not
  # valid UTF-8 is a +Protocol+ error, and a message over the size limit a
  # +Limit+ error. The peer's +CloseMessage+ is returned once; reads after it
  # fail with +Closed+, as do reads after the connection drops.
  #
  # @return [Result<Message, NetError>] the next data or close message
  #
  # @example Processing messages until the server closes the session
  #   loop do
  #     match connection.receiveMessage.try do
  #       Text(text)                  => handleEvent(text)
  #       BinaryMessage(data)         => saveSnapshot(data)
  #       CloseMessage(code, reason)  => break
  #     end
  #   end
  foul receiveMessage() -> Result<Message, NetError> = Kex.Intrinsic.NetWebSocket.receiveMessage(this)
  # Waits up to +timeout+ for the next message and returns it.
  #
  # +Just(duration)+ returns a +Timeout+ error when no message arrives in
  # time, and the connection stays open. +None+ waits like +receiveMessage()+,
  # which on a quiet connection can be forever. A disconnect is a +Closed+
  # error.
  #
  # @param timeout [Duration?] how long to wait before giving up, or +None+
  #   to wait as long as the peer stays connected
  # @return [Result<Message, NetError>] the next data or close message, or
  #   +Timeout+ if none arrived in time
  #
  # @example Prompting an otherwise-quiet client every 30 seconds
  #   match connection.receiveMessage(timeout: Just(30.second)).try do
  #     Text(text) => handleEvent(text)
  #     _          => sendPing(connection)
  #   end
  #
  # @example Waiting with no deadline
  #   connection.receiveMessage(timeout: None)
  foul receiveMessage(timeout: Duration?) -> Result<Message, NetError> = Kex.Intrinsic.NetWebSocket.receiveMessageWithin(this, timeout)
  # Returns what the handshake settled, such as the chosen subprotocol.
  #
  # @return [Session] the handshake's outcome
  #
  # @example Checking which event format the server chose
  #   let protocol = connection.session.subprotocol.or("default")
  foul session() -> Session = Kex.Intrinsic.NetWebSocket.session(this)
  # Sends a normal close frame (code 1000) and closes the connection.
  #
  # Closing an already closed connection does nothing. To give the peer a
  # different code or a reason, +send+ a +CloseMessage+ first.
  #
  # @return [Void]
  foul close() -> Void = Kex.Intrinsic.NetWebSocket.close(this)
  # Returns whether the connection is closed.
  #
  # A server connection counts as closed as soon as either side closes it or
  # the transport fails. A client connection counts as closed once it has
  # finished shutting down.
  #
  # @return [Bool] whether the connection is closed
  foul closed?() -> Bool = Kex.Intrinsic.NetWebSocket.closed?(this)
end
