# DNS lookups, with resolvers that own a bounded cache.
#
# Use +DNS.addresses+ for an occasional lookup. Open a +Resolver+ when a
# service looks names up repeatedly, wants cache statistics or must query a
# particular nameserver; the cache lives in the resolver and is freed when you
# close it. On the interpreter (+kex -R+), lookups work only through a mock.
#
#   using Net.DNS
#
#   let resolver = Resolver.system.try
#   let name = Name.parse("example.test").try
#   let addresses = resolver.addresses(name).try
#   resolver.close
module Net.DNS

# A validated DNS name, in the caller's spelling and in IDNA ASCII.
#
# +display+ is the name as the caller wrote it, for messages. +ascii+ is the
# IDNA form sent in queries.
record Name do
  display : String
  ascii : String
end

# The record types +Resolver.lookup+ can ask for.
type RecordType = A | AAAA | CNAME | MX | TXT | SRV | PTR

# The DNSSEC state the system resolver reported. Kex does not validate DNSSEC
# itself, so this is often +Indeterminate+.
type DNSSECStatus = Secure | Insecure | Bogus | Indeterminate

# A DNS resource record. MX and SRV records keep their priorities (and SRV
# its weight and port), and a TXT record keeps its separate strings.
type DNSRecord = AddressRecord(Net.IP.Address) | CanonicalName(Name) | MailExchange(Integer, Name) | TextRecord([String]) | ServiceRecord(Integer, Integer, Net.Port, Name) | PointerRecord(Name)

# The records from one lookup and their DNSSEC state.
record LookupResponse do
  records : [DNSRecord]
  dnssec : DNSSECStatus
end

# Limits for a resolver's cache.
#
# +entries+ caps the number of cached names. An answer is kept for its DNS TTL,
# but no longer than +maximumTtl+. A failed lookup is kept for +negativeTtl+,
# so a missing hostname is not sent to the nameserver on every request.
record CacheOptions do
  entries : Integer = 1024
  maximumTtl : Duration = 1.hour
  negativeTtl : Duration = 30.second
end

# A DNS server for +Resolver.custom+ to query.
record Nameserver do
  address : Net.IP.Address
  port : Net.Port
end

# Settings for +Resolver.custom+.
#
# With an empty +search+ list only the name as written is queried. Otherwise
# the search domains are tried in order for a name with a single label.
# +retries+ and +timeout+ apply to each query.
record ResolverOptions do
  cache : CacheOptions = CacheOptions {}
  nameservers : [Nameserver]
  search : [Name] = []
  retries : Integer = 2
  timeout : Duration = 2.second
end

# A resolver's cache counters, counted since it was opened. +entries+ is the
# current number of cached names; +clear+ resets it but not the counters.
#
# Compare +hits+ with +misses+ when tuning +CacheOptions+. A rising
# +evictions+ count means the resolver sees more distinct names than its cache
# holds.
record CacheStatistics do
  entries : Integer
  hits : Integer
  misses : Integer
  negativeHits : Integer
  evictions : Integer
end

# A resolver and its cache. Any process may use it.
type Resolver

# Parsing DNS names.
module Name do
  # Parses a hostname, converting Unicode labels to IDNA ASCII.
  #
  # @param text [String] a dotted hostname, optionally with a trailing dot
  # @return [Result<Name, NetError>] the name, or a +Parse+ error
  #
  # @example Preparing a user-supplied hostname for lookup
  #   let name = Name.parse("münich.example").try
  #   IO.printLine(name.display)
  #   resolver.addresses(name).try
  parse : String -> Result<Name, NetError>
  let parse(text) = Kex.Intrinsic.NetDNS.name(text)
end

# Opening resolvers.
module Resolver do
  # Opens a resolver that uses the system's DNS configuration and the default
  # +CacheOptions+.
  #
  # Keep it for the life of a service so repeated names are answered from its
  # cache, and close it at shutdown.
  #
  # @return [Result<Resolver, NetError>] a resolver handle
  #
  # @example A service-owned resolver
  #   let resolver = Resolver.system.try
  #   let upstream = resolver.addresses(Name.parse("api.example.com").try).try
  #   resolver.close
  foul system() -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolverDefault()

  # Opens a resolver that uses the system's DNS configuration and the given
  # cache limits.
  #
  # @param cache [CacheOptions] entry and TTL limits
  # @return [Result<Resolver, NetError>] a resolver, or a +Parse+ error
  #
  # @example Bounding DNS memory in a small worker
  #   Resolver.system(CacheOptions { entries: 128 }).try
  foul system(cache: CacheOptions) -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolver(cache)

  # Opens a resolver that queries the given nameservers.
  #
  # It ignores the machine's nameservers and search domains. Use it for tests,
  # service discovery, or an application with its own DNS settings.
  #
  # @param options [ResolverOptions] nameservers, search domains, retry count,
  #   per-query timeout, and cache bounds
  # @return [Result<Resolver, NetError>] a resolver, or a +Parse+ error
  #
  # @example Querying a DNS server used by a local integration test
  #   let nameserver = Nameserver {
  #     address: Net.IP.Address.parse("127.0.0.1").try,
  #     port: Net.Port.from(5353).try
  #   }
  #   Resolver.custom(ResolverOptions {
  #     nameservers: [nameserver],
  #     timeout: 100.millisecond
  #   }).try
  foul custom(options: ResolverOptions) -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolverWith(options)
end

make Resolver do
  # Resolves AAAA and A records, returning IPv6 addresses first.
  #
  # Use it to find a host to connect to. Use +lookup+ for other record types
  # or the DNSSEC state.
  #
  # @param name [Name] the validated hostname
  # @return [Result<[Net.IP.Address], NetError>] the addresses, or a
  #   +Resolve+ error
  #
  # @example Resolving an application upstream
  #   let host = Name.parse("api.example.com").try
  #   let addresses = resolver.addresses(host).try
  foul addresses(name: Name) -> Result<[Net.IP.Address], NetError> = Kex.Intrinsic.NetDNS.resolverAddresses(this, name)
  # Looks up the records of one type for +name+.
  #
  # @param kind [RecordType] the record type to ask for
  # @param name [Name] the validated name
  # @return [Result<LookupResponse, NetError>] the records, or a +Resolve+
  #   error
  #
  # @example Discovering a domain's mail exchangers
  #   let response = resolver.lookup(MX, Name.parse("example.com").try).try
  #   response.records.each { |record| IO.inspect(record) }
  foul lookup(kind: RecordType, name: Name) -> Result<LookupResponse, NetError> = Kex.Intrinsic.NetDNS.lookup(this, kind, name)
  # Empties the cache, so the next lookup of each name goes to DNS. The
  # +statistics+ counters are kept.
  #
  # @return [Void]
  #
  # @example Refreshing service discovery after configuration changes
  #   resolver.clear
  foul clear() -> Void = Kex.Intrinsic.NetDNS.clear(this)
  # Returns the number of cached names and the cache counters.
  #
  # @return [CacheStatistics] the cache's size and counters
  #
  # @example Reporting whether the cache is doing useful work
  #   let stats = resolver.statistics
  #   IO.printLine("DNS cache: ${stats.hits} hits, ${stats.misses} misses")
  foul statistics() -> CacheStatistics = Kex.Intrinsic.NetDNS.statistics(this)
  # Closes the resolver and frees its cache.
  #
  # Lookups after closing fail with a +Closed+ error. Closing twice is
  # harmless.
  #
  # @return [Void]
  foul close() -> Void = Kex.Intrinsic.NetDNS.close(this)
end

# One-off lookups, for callers that do not need a +Resolver+ of their own.
module DNS do
  # Resolves a name to its addresses with a resolver opened for this one
  # lookup.
  #
  # Use it in command-line tools and one-off checks. A server that looks up
  # names repeatedly should open a +Resolver+, which caches answers.
  #
  # @param name [Name] the validated hostname
  # @return [Result<[Net.IP.Address], NetError>] the addresses, or a
  #   +Resolve+ error
  #
  # @example Resolving one host in a short-lived command
  #   let addresses = DNS.addresses(Name.parse("example.com").try).try
  addresses : Name -> Result<[Net.IP.Address], NetError>
  foul addresses(name) = Kex.Intrinsic.NetDNS.addresses(name)
end
