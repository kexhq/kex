# Typed DNS lookup with explicit resolver ownership and bounded caching.
#
# Use +DNS.addresses+ for an occasional hostname lookup. Own a +Resolver+ when
# a service performs repeated lookups, needs cache statistics, or must query a
# particular nameserver. Resolver ownership makes both caching and cleanup
# visible instead of hiding process-wide state behind every lookup.
#
#   using Net.DNS
#
#   let resolver = Resolver.system.try
#   let name = Name.parse("example.test").try
#   let addresses = resolver.addresses(name).try
#   resolver.close
module Net.DNS

# A validated DNS name with caller-facing and IDNA ASCII spellings.
#
# +display+ keeps the readable form supplied by the caller; +ascii+ is the
# wire-safe IDNA form used in DNS queries. Keeping both lets an error message
# say what the user typed without sending noncanonical labels to a resolver.
record Name do
  display : String
  ascii : String
end

# Record families supported by +Resolver.lookup+.
type RecordType = A | AAAA | CNAME | MX | TXT | SRV | PTR

# DNSSEC state reported by the underlying resolver. Kex does not independently
# validate DNSSEC and therefore commonly reports +Indeterminate+.
type DNSSECStatus = Secure | Insecure | Bogus | Indeterminate

# Typed DNS resource records, preserving MX/SRV priorities and TXT chunks.
type DNSRecord = AddressRecord(Net.IP.Address) | CanonicalName(Name) | MailExchange(Integer, Name) | TextRecord([String]) | ServiceRecord(Integer, Integer, Net.Port, Name) | PointerRecord(Name)

# Records and the reported DNSSEC state from one lookup.
record LookupResponse do
  records : [DNSRecord]
  dnssec : DNSSECStatus
end

# Bounds for a resolver-owned positive and negative cache.
#
# Positive answers honor their DNS TTL up to +maximumTtl+. Failed lookups are
# cached for +negativeTtl+, preventing a missing hostname from hammering the
# configured nameserver on every request.
record CacheOptions do
  entries : Integer = 1024
  maximumTtl : Duration = Duration.hours(1)
  negativeTtl : Duration = Duration.seconds(30)
end

# One DNS server used by a custom resolver.
record Nameserver do
  address : Net.IP.Address
  port : Net.Port
end

# Isolated resolver configuration. An empty search list only queries the name
# as written; search domains are tried in order for single-label names.
record ResolverOptions do
  cache : CacheOptions = CacheOptions {}
  nameservers : [Nameserver]
  search : [Name] = []
  retries : Integer = 2
  timeout : Duration = 2.seconds
end

# Lifetime cache counters. +clear+ empties entries but keeps these counters.
#
# Compare +hits+ with +misses+ when tuning +entries+ or TTL bounds. A rising
# +evictions+ count means the resolver is seeing more distinct names than its
# cache can retain.
record CacheStatistics do
  entries : Integer
  hits : Integer
  misses : Integer
  negativeHits : Integer
  evictions : Integer
end

# An opaque, process-safe resolver that owns its cache.
type Resolver

# Validation and IDNA conversion for DNS names.
module Name do
  # Validates a name and converts Unicode labels to IDNA ASCII.
  #
  # @param text [String] a dotted hostname, optionally with a trailing dot
  # @return [Result<Name, NetError>] the name, or +Parse+
  #
  # @example Preparing a user-supplied hostname for lookup
  #   let name = Name.parse("münich.example").try
  #   IO.printLine(name.display)
  #   resolver.addresses(name).try
  parse : String -> Result<Name, NetError>
  let parse(text) = Kex.Intrinsic.NetDNS.name(text)
end

# Constructors for long-lived, cache-owning resolvers.
module Resolver do
  # Opens a resolver using system configuration and default cache bounds.
  #
  # Reuse the returned resolver for the lifetime of a service so repeated
  # names benefit from its bounded cache, then close it during shutdown.
  #
  # @return [Result<Resolver, NetError>] a resolver handle
  #
  # @example A service-owned resolver
  #   let resolver = Resolver.system.try
  #   let upstream = resolver.addresses(Name.parse("api.example.com").try).try
  #   resolver.close
  foul system() -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolverDefault()

  # Opens a system resolver with explicit cache bounds.
  #
  # @param cache [CacheOptions] entry and TTL limits
  # @return [Result<Resolver, NetError>] a resolver, or +Parse+
  #
  # @example Bounding DNS memory in a small worker
  #   Resolver.system(CacheOptions { entries: 128 }).try
  foul system(cache: CacheOptions) -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolver(cache)

  # Opens an isolated resolver with typed nameservers and query bounds.
  #
  # This does not inherit the machine's search domains or nameservers. It is
  # useful for tests, service discovery, and applications with their own DNS
  # policy.
  #
  # @param options [ResolverOptions] nameservers, search domains, retry count,
  #   per-query timeout, and cache bounds
  # @return [Result<Resolver, NetError>] a resolver, or +Parse+
  # @example Querying a DNS server used by a local integration test
  #   let nameserver = Nameserver {
  #     address: Net.IP.Address.parse("127.0.0.1").try,
  #     port: Net.Port.from(5353).try
  #   }
  #   Resolver.custom(ResolverOptions {
  #     nameservers: [nameserver],
  #     timeout: 100.milliseconds
  #   }).try
  foul custom(options: ResolverOptions) -> Result<Resolver, NetError> = Kex.Intrinsic.NetDNS.resolverWith(options)
end

make Resolver do
  # Resolves AAAA and A records, returning IPv6 addresses first.
  #
  # This is the convenient operation for connecting to a host. Use +lookup+
  # when record type, TTL-related behavior, or DNSSEC status matters.
  #
  # @param name [Name] the validated hostname
  # @return [Result<[Net.IP.Address], NetError>] addresses or +Resolve+
  # @example Resolving an application upstream
  #   let host = Name.parse("api.example.com").try
  #   let addresses = resolver.addresses(host).try
  foul addresses(name: Name) -> Result<[Net.IP.Address], NetError> = Kex.Intrinsic.NetDNS.resolverAddresses(this, name)
  # Looks up one supported resource-record family.
  #
  # @param kind [RecordType] the requested family
  # @param name [Name] the validated owner name
  # @return [Result<LookupResponse, NetError>] typed records or +Resolve+
  #
  # @example Discovering a domain's mail exchangers
  #   let response = resolver.lookup(MX, Name.parse("example.com").try).try
  #   response.records.each { |record| IO.inspect(record) }
  foul lookup(kind: RecordType, name: Name) -> Result<LookupResponse, NetError> = Kex.Intrinsic.NetDNS.lookup(this, kind, name)
  # Empties cached entries without resetting lifetime counters.
  #
  # Existing statistics remain meaningful across a manual refresh, while the
  # next lookup is forced back to DNS.
  #
  # @return [Void]
  #
  # @example Refreshing service discovery after configuration changes
  #   resolver.clear
  foul clear() -> Void = Kex.Intrinsic.NetDNS.clear(this)
  # Reports current occupancy and lifetime cache counters.
  #
  # @return [CacheStatistics] current entries and lifetime counters
  #
  # @example Reporting whether the cache is doing useful work
  #   let stats = resolver.statistics
  #   IO.printLine("DNS cache: ${stats.hits} hits, ${stats.misses} misses")
  foul statistics() -> CacheStatistics = Kex.Intrinsic.NetDNS.statistics(this)
  # Idempotently closes the resolver.
  #
  # Calls after closing fail with +Closed+; closing again is harmless.
  #
  # @return [Void]
  foul close() -> Void = Kex.Intrinsic.NetDNS.close(this)
end

# Convenience lookup operations for callers that do not need resolver
# ownership or cache reuse.
module DNS do
  # Resolves a name once with a short-lived system resolver.
  #
  # Prefer this for command-line tools and one-off checks. A server that looks
  # up names repeatedly should own a +Resolver+ so it can reuse cached answers.
  #
  # @param name [Name] the validated hostname
  # @return [Result<[Net.IP.Address], NetError>] addresses or +Resolve+
  #
  # @example Resolving one host in a short-lived command
  #   let addresses = DNS.addresses(Name.parse("example.com").try).try
  addresses : Name -> Result<[Net.IP.Address], NetError>
  foul addresses(name) = Kex.Intrinsic.NetDNS.addresses(name)
end
