# Process-owned TCP byte streams and listeners. All blocking operations return
# typed +NetError+ values; close operations are idempotent.
#
#   using Net
#   using Net.Socket
#
#   let listener = TCP.listen(TCP.Endpoint.loopback(Port.from(0).try)).try
#   let address = listener.localAddress.try
#   let client = TCP.connect(address).try
#   client.sendAll("ping".to(Binary).try).try
#   listener.close
module Net.Socket
capability TCP do
  # Marker for an unencrypted stream.
  type Plain
  # An opaque connected TCP stream.
  type TCPConnection
  # An opaque TCP listening socket.
  type TCPListener

  # A host name or numeric address paired with a validated port.
  record Endpoint do
    host : String
    port : Net.Port
  end

  # Connection deadlines and operating-system socket policy.
  #
  # Buffer values of zero leave sizing to the operating system. +noDelay?+
  # disables Nagle's algorithm, which is usually right for request/response
  # traffic; bulk-transfer protocols may prefer fewer, larger packets.
  record ConnectOptions do
    connectTimeout : Duration = 10.seconds
    noDelay? : Bool = true
    keepAlive? : Bool = true
    sendBuffer : Integer = 0
    receiveBuffer : Integer = 0
  end

  # Listener queue and policy inherited by accepted connections.
  #
  # +backlog+ bounds connections waiting for +accept+. Buffer values of zero
  # keep the platform defaults rather than requesting a particular byte size.
  record ListenOptions do
    backlog : Integer = 128
    reuseAddress? : Bool = true
    noDelay? : Bool = true
    keepAlive? : Bool = true
    sendBuffer : Integer = 0
    receiveBuffer : Integer = 0
  end

  module Endpoint do
    # Pairs a hostname or numeric address with a port.
    #
    # Resolution happens when connecting, so this preserves +name+ exactly as
    # supplied rather than validating it as an +IP.Address+.
    #
    # @return [Endpoint] the remote or listening endpoint
    #
    # @example Connecting by hostname
    #   TCP.Endpoint.host("cache.internal", Port.from(6379).try)
    host : String -> Net.Port -> Endpoint
    let host(name, port) = Endpoint { host: name, port: port }
    # Builds an IPv4 wildcard endpoint for listening on every local interface.
    #
    # Be deliberate with this in development: unlike +loopback+, it may expose
    # the service to other machines on the network.
    #
    # @return [Endpoint] an IPv4 wildcard listening endpoint
    #
    # @example Exposing a production service on port 8080
    #   TCP.Endpoint.any(Port.from(8080).try)
    any : Net.Port -> Endpoint
    let any(port) = Endpoint { host: "0.0.0.0", port: port }
    # Builds an IPv4 loopback endpoint reachable only from this machine.
    #
    # Port zero lets the operating system choose a free port, which is useful
    # for tests; ask +localAddress+ which port was assigned after listening.
    #
    # @return [Endpoint] an IPv4 loopback endpoint
    #
    # @example Starting an isolated test listener
    #   TCP.Endpoint.loopback(Port.from(0).try)
    loopback : Net.Port -> Endpoint
    let loopback(port) = Endpoint { host: "127.0.0.1", port: port }
    # Splits a "host:port" address instead of assembling an endpoint by parts.
    #
    # Only the port is validated here; the host rides through to the backend,
    # which reports +Resolve+ for an unknown name. The host may itself contain
    # colons, so an IPv6 literal needs no brackets.
    #
    # @return [Result<Endpoint, NetError>] the endpoint or a +Parse+ failure
    #
    # @example Connecting without a Port value in hand
    #   TCP.connect(TCP.Endpoint.parse("127.0.0.1:9000").try).try
    foul parse(address: String) -> Result<Endpoint, NetError> do
      match splitHostPort(address, TCP) do
        Ok(hostPort) => Ok(Endpoint { host: hostPort.host, port: hostPort.port })
        Error(e) => Error(e)
      end
    end
  end

  # Connects to a TCP endpoint with the backend's bounded connect deadline.
  #
  # @return [Result<TCPConnection, NetError>] a stream or +Connect+/+Timeout+
  #
  # @example Connecting to a line-oriented local service
  #   let endpoint = TCP.Endpoint.host("127.0.0.1", Port.from(9000).try)
  #   let connection = TCP.connect(endpoint).try
  connect : Endpoint -> Result<TCPConnection, NetError>
  foul connect(endpoint) = Kex.Intrinsic.NetTCP.connect(endpoint)
  connect : Endpoint -> ConnectOptions -> Result<TCPConnection, NetError>
  foul connect(endpoint, options) = Kex.Intrinsic.NetTCP.connectWith(endpoint, options)
  # Connects to a "host:port" address with the default options.
  #
  # A separate name (not a +connect+ overload) until #619 is fixed: mixing
  # arities and same-arity type overloads breaks call resolution.
  #
  # @example Talking to a local echo server
  #   let connection = TCP.connectTo("127.0.0.1:12321").try
  connectTo : String -> Result<TCPConnection, NetError>
  foul connectTo(address) do
    match Endpoint.parse(address) do
      Ok(endpoint) => connect(endpoint)
      Error(e) => Error(e)
    end
  end
  # Block form: connects to +address+, runs the block with the connection,
  # and closes it.
  #
  # +Ok+ carries whatever the block returned. The close is NOT an +ensure+:
  # a block that raises still leaks the handle (use +trying+ inside the
  # block to cover that), exactly like +FS.File.open+.
  #
  # @param address [String] the "host:port" to connect to
  # @param block [TCPConnection -> A] what to do with the open connection
  # @return [Result<A, NetError>] the block's value, or the failure
  #
  # @example One exchange with no +close+ to forget
  #   TCP.connectTo("127.0.0.1:9000") do |conn|
  #     conn.printLine("hello")
  #   end
  connectTo : String -> (TCPConnection -> A) -> Result<A, NetError>
  foul connectTo(address, block) do
    match connectTo(address) do
      Error(e) => Error(e)
      Ok(conn) => do
        let result = block(conn)
        conn.close
        Ok(result)
      end
    end
  end
  # Binds and starts listening. Port zero selects an ephemeral local port.
  #
  # @return [Result<TCPListener, NetError>] a listener or +Connect+
  #
  # @example Giving each integration test its own free port
  #   let listener = TCP.listen(TCP.Endpoint.loopback(Port.from(0).try)).try
  #   let port = listener.localAddress.try.port
  listen : Endpoint -> Result<TCPListener, NetError>
  foul listen(endpoint) = Kex.Intrinsic.NetTCP.listen(endpoint)
  listen : Endpoint -> ListenOptions -> Result<TCPListener, NetError>
  foul listen(endpoint, options) = Kex.Intrinsic.NetTCP.listenWith(endpoint, options)
  # Binds and starts listening on a "host:port" address.
  #
  # @example A Rosetta-style echo server socket
  #   let listener = TCP.bind("127.0.0.1:12321").try
  bind : String -> Result<TCPListener, NetError>
  foul bind(address) do
    match Endpoint.parse(address) do
      Ok(endpoint) => listen(endpoint)
      Error(e) => Error(e)
    end
  end
  # Block form: binds +address+, runs the block with the listener, and
  # closes it.
  #
  # +Ok+ carries whatever the block returned. The close is NOT an +ensure+:
  # a block that raises still leaks the handle (use +trying+ inside the
  # block to cover that), exactly like +FS.File.open+.
  #
  # @param address [String] the "host:port" to listen on
  # @param block [TCPListener -> A] what to do with the open listener
  # @return [Result<A, NetError>] the block's value, or the failure
  #
  # @example Accepting one connection with no +close+ to forget
  #   TCP.bind("127.0.0.1:9000") do |listener|
  #     listener.accept(5.seconds).try
  #   end
  bind : String -> (TCPListener -> A) -> Result<A, NetError>
  foul bind(address, block) do
    match bind(address) do
      Error(e) => Error(e)
      Ok(listener) => do
        let result = block(listener)
        listener.close
        Ok(result)
      end
    end
  end

  # Sends every byte, retrying partial operating-system writes internally.
  #
  # On failure, +NetError.progress+ records how many bytes were accepted before
  # the error. Do not blindly retry the whole payload when progress is present.
  #
  # @example Sending one newline-delimited request
  #   connection.sendAll("status\n".to(Binary).try).try
  foul sendAll(connection: TCPConnection, data: Binary) -> Result<Integer, NetError> = Kex.Intrinsic.NetTCP.sendAll(connection, data)
  # Writes +content+ verbatim: raw bytes, no rendering, no trailing newline.
  #
  # @example Echoing a received chunk verbatim
  #   connection.put(chunk).try
  foul put(connection: TCPConnection, content: Binary) -> Result<Void, NetError> do
    return Kex.Intrinsic.NetTCP.sendAll(connection, content).map { |_| () }
  end
  # Writes +content+ with no trailing newline.
  #
  # @example Sending a prompt without a newline
  #   connection.write("name? ").try
  foul write(connection: TCPConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = content.showValue.to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetTCP.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ followed by a newline.
  #
  # @example Answering a line-oriented peer
  #   connection.writeLine("hello").try
  foul writeLine(connection: TCPConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = "${content.showValue}\n".to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetTCP.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ with no trailing newline, ignoring a failure. Use
  # +write+ when a failure matters.
  #
  # @example Sending a prompt without a newline
  #   connection.print("name? ")
  foul print(connection: TCPConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetTCP.sendAll(connection, content.showValue.to(Binary).or(Binary.empty))
    return ()
  end
  # Writes +content+ followed by a newline, ignoring a failure. Use
  # +writeLine+ when a failure matters.
  #
  # @example Answering a line-oriented peer
  #   connection.printLine("hello")
  foul printLine(connection: TCPConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetTCP.sendAll(connection, "${content.showValue}\n".to(Binary).or(Binary.empty))
    return ()
  end
  # Reads the next line as text, without its newline.
  #
  # Answers +Ok(None)+ at end of input, like +FileHandle.readLine+. Lines are
  # capped at 64 KiB; a longer line fails with +Limit+ instead of growing
  # without bound.
  #
  # @example Echoing one line back to its sender
  #   match connection.readLine.try do
  #     Just(line) => connection.printLine(line)
  #     None => connection.close
  #   end
  foul readLine(connection: TCPConnection) -> Result<String?, NetError> do
    match Kex.Intrinsic.NetTCP.receiveLine(connection, 65536) do
      Ok(bytes) => match bytes.to(String) do
        Just(text) => do
          let t = text.endsWith?("\n") then text.take(text.count - 1) else text
          return Ok(Just(t.endsWith?("\r") then t.take(t.count - 1) else t))
        end
        None => return Error(NetError { kind: Parse, operation: TCP, message: "received line is not valid UTF-8" })
      end
      Error(e) => return e.kind == Closed then Ok(None) else Error(e)
    end
  end
  # Reads the next line as text, without its newline: +readLine+ for when the
  # end of input and a failed read mean the same thing.
  #
  # @example Printing one received line
  #   IO.printLine(connection.getLine.or("(closed)"))
  foul getLine(connection: TCPConnection) -> String? do
    match Kex.Intrinsic.NetTCP.receiveLine(connection, 65536) do
      Ok(bytes) => match bytes.to(String) do
        Just(text) => do
          let t = text.endsWith?("\n") then text.take(text.count - 1) else text
          return Just(t.endsWith?("\r") then t.take(t.count - 1) else t)
        end
        None => return None
      end
      Error(_) => return None
    end
  end

  # Receives up to +limit+ bytes; EOF is reported as +Closed+.
  #
  # A successful result is one available chunk, not necessarily a complete
  # application message. Use +receiveExactly+, +receiveUntil+, or +receiveLine+
  # when the protocol supplies a boundary.
  #
  # @example Reading up to 16 KiB from a streaming response
  #   let chunk = connection.receiveChunk(16 * 1024).try
  foul receiveChunk(connection: TCPConnection, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveChunk(connection, limit)
  foul receiveChunk(connection: TCPConnection, limit: Integer, timeout: Duration) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveChunkWithin(connection, limit, timeout)
  # Receives exactly +count+ bytes or returns a typed EOF/timeout failure.
  #
  # Useful after a protocol header has declared the payload length.
  #
  # @example Reading a four-byte frame header
  #   let header = connection.receiveExactly(4).try
  foul receiveExactly(connection: TCPConnection, count: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveExactly(connection, count)
  foul receiveExactly(connection: TCPConnection, count: Integer, timeout: Duration) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveExactlyWithin(connection, count, timeout)
  # Receives through the first +delimiter+ without exceeding +limit+ bytes.
  #
  # The delimiter is included in the returned bytes. An empty delimiter is a
  # +Parse+ error; reaching the bound first is a +Limit+ error.
  #
  # @example Read through the end of an HTTP header section
  #   connection.receiveUntil("\r\n\r\n".to(Binary).try, 65536).try
  foul receiveUntil(connection: TCPConnection, delimiter: Binary, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveUntil(connection, delimiter, limit)
  foul receiveUntil(connection: TCPConnection, delimiter: Binary, limit: Integer, timeout: Duration) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveUntilWithin(connection, delimiter, limit, timeout)
  # Receives through a newline without exceeding +limit+ bytes.
  #
  # The newline remains in the returned binary. Decode and trim only after a
  # complete bounded line has been received.
  #
  # @example Reading a response line with a defensive 8 KiB limit
  #   let line = connection.receiveLine(8192).try.to(String).try.trim
  foul receiveLine(connection: TCPConnection, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveLine(connection, limit)
  foul receiveLine(connection: TCPConnection, limit: Integer, timeout: Duration) -> Result<Binary, NetError> = Kex.Intrinsic.NetTCP.receiveLineWithin(connection, limit, timeout)
  # Half-closes the write side while leaving reads available.
  foul shutdownWrite(connection: TCPConnection) -> Result<Void, NetError> = Kex.Intrinsic.NetTCP.shutdownWrite(connection)
  # Waits for and returns the next connection accepted by the listener.
  #
  # A timeout applies to this wait only; it does not become a read timeout on
  # the returned connection.
  #
  # @example Accepting one client in a small test server
  #   let client = listener.accept(5.seconds).try
  foul accept(listener: TCPListener) -> Result<TCPConnection, NetError> = Kex.Intrinsic.NetTCP.accept(listener)
  foul accept(listener: TCPListener, timeout: Duration) -> Result<TCPConnection, NetError> = Kex.Intrinsic.NetTCP.acceptWithin(listener, timeout)
  # @return [Bool] whether the connected stream owner has stopped
  foul closed?(connection: TCPConnection) -> Bool = Kex.Intrinsic.NetTCP.closed?(connection)
  # @return [Bool] whether the listener owner has stopped
  foul closed?(listener: TCPListener) -> Bool = Kex.Intrinsic.NetTCP.closed?(listener)
  # Returns the bound local endpoint, including an ephemeral assigned port.
  foul localAddress(connection: TCPConnection) -> Result<Endpoint, NetError> = Kex.Intrinsic.NetTCP.localAddress(connection)
  # Returns the bound local endpoint, including an ephemeral assigned port.
  foul localAddress(listener: TCPListener) -> Result<Endpoint, NetError> = Kex.Intrinsic.NetTCP.localAddress(listener)
  # Returns the remote endpoint of a connected stream.
  #
  # @example Recording the peer in an access log
  #   let peer = connection.peerAddress.try
  #   IO.printLine("accepted ${peer.host}:${peer.port.string}")
  foul peerAddress(connection: TCPConnection) -> Result<Endpoint, NetError> = Kex.Intrinsic.NetTCP.peerAddress(connection)

end

capability UDP do
  # Connectionless datagrams. A receive limit rejects an oversized datagram
  # instead of returning a silently truncated payload.
  #
  #   let socket = UDP.bind(UDP.Endpoint.loopback(Port.from(0).try)).try
  #   let address = socket.localAddress.try
  #   socket.sendTo(address, "hello".to(Binary).try).try
  #   let packet = socket.receiveFrom(1024).try
  #   socket.close
  #
  # An opaque bound datagram socket.
  type Socket
  # A datagram address paired with a validated port.
  record Endpoint do
    host : String
    port : Net.Port
  end
  # A received datagram and its source endpoint.
  #
  # Reply to +source+ rather than the socket's local address: UDP has no
  # connection that remembers which peer sent the packet.
  record Datagram do
    source : Endpoint
    data : Binary
  end
  # Curated socket policy. Broadcast is opt-in. The receive timeout applies to
  # each +receiveFrom+ call; multicast TTL is bounded to the IP hop-limit range.
  record BindOptions do
    broadcast? : Bool = false
    multicastTtl : Integer = 1
    multicastLoopback? : Bool = true
    receiveTimeout : Duration = 30.seconds
  end
  module Endpoint do
    # Pairs a hostname or numeric address with a UDP port.
    #
    # @return [Endpoint] an endpoint using +name+ exactly as supplied
    #
    # @example Addressing a local metrics collector
    #   UDP.Endpoint.host("metrics.internal", Port.from(8125).try)
    host : String -> Net.Port -> Endpoint
    let host(name, port) = Endpoint { host: name, port: port }
    # Builds an IPv4 wildcard endpoint for receiving on every local interface.
    #
    # @return [Endpoint] an IPv4 wildcard endpoint
    #
    # @example Receiving discovery packets on port 9999
    #   UDP.Endpoint.any(Port.from(9999).try)
    any : Net.Port -> Endpoint
    let any(port) = Endpoint { host: "0.0.0.0", port: port }
    # Builds an IPv4 loopback endpoint reachable only from this machine.
    #
    # @return [Endpoint] an IPv4 loopback endpoint
    #
    # @example Allocating a free UDP port for a test
    #   UDP.Endpoint.loopback(Port.from(0).try)
    loopback : Net.Port -> Endpoint
    let loopback(port) = Endpoint { host: "127.0.0.1", port: port }
    # Splits a "host:port" address instead of assembling an endpoint by parts.
    #
    # Only the port is validated here; the host rides through to the backend,
    # which reports +Resolve+ for an unknown name. The host may itself contain
    # colons, so an IPv6 literal needs no brackets.
    #
    # @return [Result<Endpoint, NetError>] the endpoint or a +Parse+ failure
    #
    # @example Binding without a Port value in hand
    #   UDP.bind(UDP.Endpoint.parse("127.0.0.1:9000").try).try
    foul parse(address: String) -> Result<Endpoint, NetError> do
      match splitHostPort(address, UDP) do
        Ok(hostPort) => Ok(Endpoint { host: hostPort.host, port: hostPort.port })
        Error(e) => Error(e)
      end
    end
  end
  # Binds a datagram socket. Port zero selects an ephemeral local port.
  #
  # @example A local UDP echo test
  #   let socket = UDP.bind(UDP.Endpoint.loopback(Port.from(0).try)).try
  #   let endpoint = socket.localAddress.try
  bind : Endpoint -> Result<Socket, NetError>
  foul bind(endpoint) = Kex.Intrinsic.NetUDP.bind(endpoint)
  # Binds with explicit broadcast, multicast, and receive-timeout policy.
  bind : Endpoint -> BindOptions -> Result<Socket, NetError>
  foul bind(endpoint, options) = Kex.Intrinsic.NetUDP.bindWith(endpoint, options)
  # Binds a datagram socket on a "host:port" address.
  #
  # A separate name (not a +bind+ overload) until #619 is fixed: mixing
  # arities and same-arity type overloads breaks call resolution.
  #
  # @example Receiving on an ephemeral port
  #   let socket = UDP.bindTo("127.0.0.1:0").try
  bindTo : String -> Result<Socket, NetError>
  foul bindTo(address) do
    match Endpoint.parse(address) do
      Ok(endpoint) => bind(endpoint)
      Error(e) => Error(e)
    end
  end
  # Block form: binds +address+, runs the block with the socket, and
  # closes it.
  #
  # +Ok+ carries whatever the block returned. The close is NOT an +ensure+:
  # a block that raises still leaks the handle (use +trying+ inside the
  # block to cover that), exactly like +FS.File.open+.
  #
  # @param address [String] the "host:port" to bind
  # @param block [Socket -> A] what to do with the open socket
  # @return [Result<A, NetError>] the block's value, or the failure
  #
  # @example One exchange with no +close+ to forget
  #   UDP.bindTo("127.0.0.1:0") do |socket|
  #     socket.localAddress.try.port.string
  #   end
  bindTo : String -> (Socket -> A) -> Result<A, NetError>
  foul bindTo(address, block) do
    match bindTo(address) do
      Error(e) => Error(e)
      Ok(socket) => do
        let result = block(socket)
        socket.close
        Ok(result)
      end
    end
  end

  # Sends one complete datagram and returns its byte count.
  #
  # Datagram boundaries are preserved: one +sendTo+ corresponds to one
  # +receiveFrom+, unless the packet is lost by the network.
  #
  # @example Sending a StatsD-style counter
  #   socket.sendTo(collector, "orders:1|c".to(Binary).try).try
  foul sendTo(socket: Socket, endpoint: Endpoint, data: Binary) -> Result<Integer, NetError> = Kex.Intrinsic.NetUDP.sendTo(socket, endpoint, data)
  # Receives one datagram no larger than +limit+ bytes.
  #
  # Oversized packets fail with +Limit+ instead of being silently truncated,
  # so a caller never mistakes a prefix for a complete message.
  #
  # @example Receiving and replying to one packet
  #   let packet = socket.receiveFrom(4096).try
  #   socket.sendTo(packet.source, packet.data).try
  foul receiveFrom(socket: Socket, limit: Integer) -> Result<Datagram, NetError> = Kex.Intrinsic.NetUDP.receiveFrom(socket, limit)
  # @return [Bool] whether the socket owner has stopped
  foul closed?(socket: Socket) -> Bool = Kex.Intrinsic.NetUDP.closed?(socket)
  # Returns the bound endpoint, including an ephemeral assigned port.
  foul localAddress(socket: Socket) -> Result<Endpoint, NetError> = Kex.Intrinsic.NetUDP.localAddress(socket)
  # Joins an IPv4 multicast group on the selected local interface. The group
  # must be multicast and the interface must be an IPv4 address.
  foul joinMulticast(socket: Socket, group: Net.IP.Address, interface: Net.IP.Address) -> Result<Void, NetError> = Kex.Intrinsic.NetUDP.joinMulticast(socket, group, interface)
  # Leaves a membership previously joined with the same group and interface.
  foul leaveMulticast(socket: Socket, group: Net.IP.Address, interface: Net.IP.Address) -> Result<Void, NetError> = Kex.Intrinsic.NetUDP.leaveMulticast(socket, group, interface)

end

capability Unix do
  # Filesystem-domain streams for local IPC. The listener owns and removes
  # only the socket path it successfully created.
  #
  #   let address = Unix.Address.path("/tmp/my-service.sock").try
  #   let listener = Unix.listen(address).try
  #   let client = Unix.connect(address).try
  #   listener.close
  #
  # An opaque connected filesystem-domain byte stream.
  type UnixConnection
  # An opaque filesystem-domain stream listener.
  type UnixListener
  # A validated absolute filesystem socket path.
  record Address do
    path : String
  end

  # Connection and read deadlines for a local IPC client.
  record ConnectOptions do
    connectTimeout : Duration = 10.seconds
    receiveTimeout : Duration = 30.seconds
  end

  # Listener queue, stale-socket policy, and per-operation deadlines.
  #
  # +removeStale?+ removes only a filesystem socket, never a regular file or
  # directory that happens to occupy the requested path.
  record ListenOptions do
    backlog : Integer = 128
    removeStale? : Bool = false
    acceptTimeout : Duration = 30.seconds
    receiveTimeout : Duration = 30.seconds
  end
  module Address do
    # Validates a nonempty absolute Unix-domain socket path.
    #
    # Relative paths are rejected so ownership and cleanup always refer to one
    # unambiguous filesystem entry.
    #
    # @return [Result<Address, NetError>] the address, or +Parse+
    #
    # @example Addressing a per-user background service
    #   Unix.Address.path("/tmp/my-app.sock").try
    path : String -> Result<Address, NetError>
    let path(value) = Kex.Intrinsic.NetUnix.address(value)
  end
  # Connects to a filesystem-domain listener.
  #
  # Unix sockets avoid opening a network port and are a good fit for two
  # processes on the same machine, such as a CLI and its background daemon.
  #
  # @example
  #   let daemon = Unix.connect(Unix.Address.path("/tmp/my-app.sock").try).try
  connect : Address -> Result<UnixConnection, NetError>
  foul connect(address) = Kex.Intrinsic.NetUnix.connect(address)
  connect : Address -> ConnectOptions -> Result<UnixConnection, NetError>
  foul connect(address, options) = Kex.Intrinsic.NetUnix.connectWith(address, options)
  # Binds a new path; an existing filesystem entry is never removed implicitly.
  #
  # This conservative default protects regular files and also avoids taking
  # over a socket that may still belong to a running service.
  listen : Address -> Result<UnixListener, NetError>
  foul listen(address) = Kex.Intrinsic.NetUnix.listen(address)
  # With +removeStale?+, only an existing filesystem socket is removed;
  # regular files, directories, and other path types are always preserved.
  listen : Address -> ListenOptions -> Result<UnixListener, NetError>
  foul listen(address, options) = Kex.Intrinsic.NetUnix.listenWith(address, options)
  # Connects to the listener at +path+ with the default options.
  #
  # @example Talking to a per-user background service
  #   let daemon = Unix.connectTo("/tmp/my-app.sock").try
  connectTo : String -> Result<UnixConnection, NetError>
  foul connectTo(path) do
    match Address.path(path) do
      Ok(address) => connect(address)
      Error(e) => Error(e)
    end
  end
  # Block form: connects to +path+, runs the block with the connection,
  # and closes it.
  #
  # +Ok+ carries whatever the block returned. The close is NOT an +ensure+:
  # a block that raises still leaks the handle (use +trying+ inside the
  # block to cover that), exactly like +FS.File.open+.
  #
  # @param path [String] the socket path to connect to
  # @param block [UnixConnection -> A] what to do with the open connection
  # @return [Result<A, NetError>] the block's value, or the failure
  #
  # @example One exchange with no +close+ to forget
  #   Unix.connectTo("/tmp/my-app.sock") do |conn|
  #     conn.printLine("hello")
  #   end
  connectTo : String -> (UnixConnection -> A) -> Result<A, NetError>
  foul connectTo(path, block) do
    match connectTo(path) do
      Error(e) => Error(e)
      Ok(conn) => do
        let result = block(conn)
        conn.close
        Ok(result)
      end
    end
  end
  # Binds and starts listening on the socket at +path+.
  #
  # @example A Rosetta-style IPC listener
  #   let listener = Unix.bind("/tmp/my-app.sock").try
  bind : String -> Result<UnixListener, NetError>
  foul bind(path) do
    match Address.path(path) do
      Ok(address) => listen(address)
      Error(e) => Error(e)
    end
  end
  # Block form: binds +path+, runs the block with the listener, and closes
  # it.
  #
  # +Ok+ carries whatever the block returned. The close is NOT an +ensure+:
  # a block that raises still leaks the handle (use +trying+ inside the
  # block to cover that), exactly like +FS.File.open+.
  #
  # @param path [String] the socket path to listen on
  # @param block [UnixListener -> A] what to do with the open listener
  # @return [Result<A, NetError>] the block's value, or the failure
  #
  # @example Accepting one connection with no +close+ to forget
  #   Unix.bind("/tmp/my-app.sock") do |listener|
  #     listener.accept.try
  #   end
  bind : String -> (UnixListener -> A) -> Result<A, NetError>
  foul bind(path, block) do
    match bind(path) do
      Error(e) => Error(e)
      Ok(listener) => do
        let result = block(listener)
        listener.close
        Ok(result)
      end
    end
  end

  # Sends every byte and returns the count.
  foul sendAll(connection: UnixConnection, data: Binary) -> Result<Integer, NetError> = Kex.Intrinsic.NetUnix.sendAll(connection, data)
  # Writes +content+ verbatim: raw bytes, no rendering, no trailing newline.
  #
  # @example Echoing a received chunk verbatim
  #   connection.put(chunk).try
  foul put(connection: UnixConnection, content: Binary) -> Result<Void, NetError> do
    return Kex.Intrinsic.NetUnix.sendAll(connection, content).map { |_| () }
  end
  # Writes +content+ with no trailing newline.
  #
  # @example Sending a prompt without a newline
  #   connection.write("name? ").try
  foul write(connection: UnixConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = content.showValue.to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetUnix.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ followed by a newline.
  #
  # @example Answering a line-oriented peer
  #   connection.writeLine("hello").try
  foul writeLine(connection: UnixConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = "${content.showValue}\n".to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetUnix.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ with no trailing newline, ignoring a failure. Use
  # +write+ when a failure matters.
  #
  # @example Sending a prompt without a newline
  #   connection.print("name? ")
  foul print(connection: UnixConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetUnix.sendAll(connection, content.showValue.to(Binary).or(Binary.empty))
    return ()
  end
  # Writes +content+ followed by a newline, ignoring a failure. Use
  # +writeLine+ when a failure matters.
  #
  # @example Answering a line-oriented peer
  #   connection.printLine("hello")
  foul printLine(connection: UnixConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetUnix.sendAll(connection, "${content.showValue}\n".to(Binary).or(Binary.empty))
    return ()
  end
  # Reads the next line as text, without its newline.
  #
  # Answers +Ok(None)+ at end of input, like +FileHandle.readLine+. Lines are
  # capped at 64 KiB; a longer line fails with +Limit+ instead of growing
  # without bound.
  #
  # @example Echoing one line back to its sender
  #   match connection.readLine.try do
  #     Just(line) => connection.printLine(line)
  #     None => connection.close
  #   end
  foul readLine(connection: UnixConnection) -> Result<String?, NetError> do
    match Kex.Intrinsic.NetUnix.receiveLine(connection, 65536) do
      Ok(bytes) => match bytes.to(String) do
        Just(text) => do
          let t = text.endsWith?("\n") then text.take(text.count - 1) else text
          return Ok(Just(t.endsWith?("\r") then t.take(t.count - 1) else t))
        end
        None => return Error(NetError { kind: Parse, operation: Unix, message: "received line is not valid UTF-8" })
      end
      Error(e) => return e.kind == Closed then Ok(None) else Error(e)
    end
  end
  # Reads the next line as text, without its newline: +readLine+ for when the
  # end of input and a failed read mean the same thing.
  #
  # @example Printing one received line
  #   IO.printLine(connection.getLine.or("(closed)"))
  foul getLine(connection: UnixConnection) -> String? do
    match Kex.Intrinsic.NetUnix.receiveLine(connection, 65536) do
      Ok(bytes) => match bytes.to(String) do
        Just(text) => do
          let t = text.endsWith?("\n") then text.take(text.count - 1) else text
          return Just(t.endsWith?("\r") then t.take(t.count - 1) else t)
        end
        None => return None
      end
      Error(_) => return None
    end
  end
  # Receives one bounded chunk; EOF is +Closed+.
  foul receiveChunk(connection: UnixConnection, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetUnix.receiveChunk(connection, limit)
  # Receives exactly +count+ bytes or returns a typed EOF/timeout failure.
  foul receiveExactly(connection: UnixConnection, count: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetUnix.receiveExactly(connection, count)
  # Receives through +delimiter+, including it, within an explicit bound.
  # @example Read through the next newline
  #   connection.receiveUntil("\n".to(Binary).try, 4096).try
  foul receiveUntil(connection: UnixConnection, delimiter: Binary, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetUnix.receiveUntil(connection, delimiter, limit)
  # Receives through a newline without exceeding +limit+ bytes.
  foul receiveLine(connection: UnixConnection, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetUnix.receiveLine(connection, limit)
  # Half-closes the write side while leaving reads available.
  foul shutdownWrite(connection: UnixConnection) -> Result<Void, NetError> = Kex.Intrinsic.NetUnix.shutdownWrite(connection)
  # Waits for and returns the next stream connection.
  foul accept(listener: UnixListener) -> Result<UnixConnection, NetError> = Kex.Intrinsic.NetUnix.accept(listener)
  # @return [Bool] whether the stream owner has stopped
  foul closed?(connection: UnixConnection) -> Bool = Kex.Intrinsic.NetUnix.closed?(connection)
  # @return [Bool] whether the listener owner has stopped
  foul closed?(listener: UnixListener) -> Bool = Kex.Intrinsic.NetUnix.closed?(listener)

end

capability TLS do
  # TLS client streams. Certificate and hostname verification are enabled by
  # default; disabling verification must be an explicit configuration choice.
  #
  #   let endpoint = TCP.Endpoint.host("example.test", Port.from(443).try)
  #   let tls = TLS.connect(endpoint, TLS.ClientConfig {
  #     serverName: "example.test"
  #   }).try
  #   tls.close
  #
  # An opaque verified or explicitly unverified TLS byte stream.
  type TLSConnection
  # Client handshake policy. TLS 1.2/1.3 are enabled; verification defaults on.
  record ClientConfig do
    serverName : String
    verify? : Bool = true
    alpn : [String] = []
  end
  # Opens a direct TLS connection with a bounded handshake deadline.
  #
  # +serverName+ drives both certificate hostname verification and SNI. Pass
  # the DNS name from the URL, not an address it happened to resolve to.
  #
  # @return [Result<TLSConnection, NetError>] a TLS stream or typed failure
  #
  # @example Opening a verified connection to an HTTPS origin
  #   let endpoint = TCP.Endpoint.host("example.com", Port.from(443).try)
  #   let connection = TLS.connect(endpoint, TLS.ClientConfig {
  #     serverName: "example.com",
  #     alpn: ["http/1.1"]
  #   }).try
  connect : Net.Socket.TCP.Endpoint -> ClientConfig -> Result<TLSConnection, NetError>
  foul connect(endpoint, config) = Kex.Intrinsic.NetTLS.connect(endpoint, config)

  # Sends every plaintext byte through the TLS stream.
  foul sendAll(connection: TLSConnection, data: Binary) -> Result<Integer, NetError> = Kex.Intrinsic.NetTLS.sendAll(connection, data)
  # Writes +content+ verbatim: raw bytes, no rendering, no trailing newline.
  #
  # @example Echoing a received chunk verbatim
  #   connection.put(chunk).try
  foul put(connection: TLSConnection, content: Binary) -> Result<Void, NetError> do
    return Kex.Intrinsic.NetTLS.sendAll(connection, content).map { |_| () }
  end
  # Writes +content+ with no trailing newline.
  #
  # @example Sending a prompt without a newline
  #   connection.write("name? ").try
  foul write(connection: TLSConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = content.showValue.to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetTLS.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ followed by a newline.
  #
  # @example Answering a line-oriented peer
  #   connection.writeLine("hello").try
  foul writeLine(connection: TLSConnection, content: Showable) -> Result<Void, NetError> do
    let bytes = "${content.showValue}\n".to(Binary).or(Binary.empty)
    return Kex.Intrinsic.NetTLS.sendAll(connection, bytes).map { |_| () }
  end
  # Writes +content+ with no trailing newline, ignoring a failure. Use
  # +write+ when a failure matters.
  #
  # @example Sending a prompt without a newline
  #   connection.print("name? ")
  foul print(connection: TLSConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetTLS.sendAll(connection, content.showValue.to(Binary).or(Binary.empty))
    return ()
  end
  # Writes +content+ followed by a newline, ignoring a failure. Use
  # +writeLine+ when a failure matters.
  #
  # @example Answering a line-oriented peer
  #   connection.printLine("hello")
  foul printLine(connection: TLSConnection, content: Showable) -> Void do
    Kex.Intrinsic.NetTLS.sendAll(connection, "${content.showValue}\n".to(Binary).or(Binary.empty))
    return ()
  end
  # Receives one decrypted chunk no larger than +limit+.
  foul receiveChunk(connection: TLSConnection, limit: Integer) -> Result<Binary, NetError> = Kex.Intrinsic.NetTLS.receiveChunk(connection, limit)
  # @return [Bool] whether the TLS connection owner has stopped
  foul closed?(connection: TLSConnection) -> Bool = Kex.Intrinsic.NetTLS.closed?(connection)

end

make Net.Socket.TCP.TCPConnection, implement: Closeable do
  # Idempotently closes a connected stream.
  close :> Void
  foul close = Kex.Intrinsic.NetTCP.close(this)
end

make Net.Socket.TCP.TCPListener, implement: Closeable do
  # Idempotently closes a listener and releases its port.
  close :> Void
  foul close = Kex.Intrinsic.NetTCP.close(this)
end

make Net.Socket.UDP.Socket, implement: Closeable do
  # Idempotently closes the socket.
  close :> Void
  foul close = Kex.Intrinsic.NetUDP.close(this)
end

make Net.Socket.Unix.UnixConnection, implement: Closeable do
  # Idempotently closes a stream.
  close :> Void
  foul close = Kex.Intrinsic.NetUnix.close(this)
end

make Net.Socket.Unix.UnixListener, implement: Closeable do
  # Closes the listener and unlinks only the path it successfully created.
  close :> Void
  foul close = Kex.Intrinsic.NetUnix.close(this)
end

make Net.Socket.TLS.TLSConnection, implement: Closeable do
  # Idempotently closes the TLS stream.
  close :> Void
  foul close = Kex.Intrinsic.NetTLS.close(this)
end

# Failure-injection stand-ins for the socket capabilities.
#
# Lives here rather than in +Mock+ because the prebuilt companions only
# cover top-level stdlib files: this subdir module compiles per run, so
# only code compiled alongside it can implement its capabilities.
module Mock do
  # A stand-in for the +Net.Socket.TCP+ capability.
  #
  # Constructors answer +failure+ when set, so a test can force a refused
  # connection or a timeout deterministically; everything else answers a
  # canned +MockEmpty+, because a refused constructor leaves no connection
  # for it to run on. Scripted success needs backend connection devices,
  # which do not exist yet — until then, test success paths against
  # loopback (see +spec/net_socket_text_beam.kex+).
  #
  #   with Net.Socket.TCP = Mock.TCP {} do
  #     TCP.connectTo("127.0.0.1:9")
  #   end
  record TCP do
    failure : NetError? = None
  end

  # A stand-in for the +Net.Socket.UDP+ capability. Same deal as +Mock.TCP+:
  # constructors answer +failure+ when set, everything else answers canned
  # +MockEmpty+.
  #
  #   with Net.Socket.UDP = Mock.UDP {} do
  #     UDP.bindTo("127.0.0.1:0")
  #   end
  record UDP do
    failure : NetError? = None
  end

  # A stand-in for the +Net.Socket.Unix+ capability. Same deal as +Mock.TCP+:
  # constructors answer +failure+ when set, everything else answers canned
  # +MockEmpty+.
  #
  #   with Net.Socket.Unix = Mock.Unix {} do
  #     Unix.connectTo("/tmp/app.sock")
  #   end
  record Unix do
    failure : NetError? = None
  end

  # A stand-in for the +Net.Socket.TLS+ capability. Same deal as +Mock.TCP+:
  # constructors answer +failure+ when set, everything else answers canned
  # +MockEmpty+.
  #
  #   with Net.Socket.TLS = Mock.TLS {} do
  #     TLS.connect(endpoint, config)
  #   end
  record TLS do
    failure : NetError? = None
  end

  make TCP, implement: Net.Socket.TCP do
    foul connect(endpoint) = refusing(@failure, Net.TCP, "TCP refused to connect")
    foul connect(endpoint, options) = refusing(@failure, Net.TCP, "TCP refused to connect")
    foul connectTo(address) = refusing(@failure, Net.TCP, "TCP refused to connect")
    foul connectTo(address, block) = refusing(@failure, Net.TCP, "TCP refused to connect")
    foul listen(endpoint) = refusing(@failure, Net.TCP, "TCP refused to listen")
    foul listen(endpoint, options) = refusing(@failure, Net.TCP, "TCP refused to listen")
    foul bind(address) = refusing(@failure, Net.TCP, "TCP refused to listen")
    foul bind(address, block) = refusing(@failure, Net.TCP, "TCP refused to listen")
    foul accept(listener) = refusing(@failure, Net.TCP, "TCP refused to accept")
    foul accept(listener, timeout) = refusing(@failure, Net.TCP, "TCP refused to accept")
    foul sendAll(connection, data) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul put(connection, content) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul write(connection, content) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul writeLine(connection, content) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul print(connection, content) = ()
    foul printLine(connection, content) = ()
    foul readLine(connection) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul getLine(connection) = None
    foul receiveChunk(connection, limit) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul receiveChunk(connection, limit, timeout) do
      refusing(@failure, Net.TCP, "TCP has no connection")
    end
    foul receiveExactly(connection, count) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul receiveExactly(connection, count, timeout) do
      refusing(@failure, Net.TCP, "TCP has no connection")
    end
    foul receiveUntil(connection, delimiter, limit) do
      refusing(@failure, Net.TCP, "TCP has no connection")
    end
    foul receiveUntil(connection, delimiter, limit, timeout) do
      refusing(@failure, Net.TCP, "TCP has no connection")
    end
    foul receiveLine(connection, limit) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul receiveLine(connection, limit, timeout) do
      refusing(@failure, Net.TCP, "TCP has no connection")
    end
    foul shutdownWrite(connection) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul closed?(handle) = true
    foul localAddress(handle) = refusing(@failure, Net.TCP, "TCP has no connection")
    foul peerAddress(connection) = refusing(@failure, Net.TCP, "TCP has no connection")
  end

  make UDP, implement: Net.Socket.UDP do
    foul bind(endpoint) = refusing(@failure, Net.UDP, "UDP refused to bind")
    foul bind(endpoint, options) = refusing(@failure, Net.UDP, "UDP refused to bind")
    foul bindTo(address) = refusing(@failure, Net.UDP, "UDP refused to bind")
    foul bindTo(address, block) = refusing(@failure, Net.UDP, "UDP refused to bind")
    foul sendTo(socket, endpoint, data) = refusing(@failure, Net.UDP, "UDP has no socket")
    foul receiveFrom(socket, limit) = refusing(@failure, Net.UDP, "UDP has no socket")
    foul closed?(socket) = true
    foul localAddress(socket) = refusing(@failure, Net.UDP, "UDP has no socket")
    foul joinMulticast(socket, group, interface) do
      refusing(@failure, Net.UDP, "UDP has no socket")
    end
    foul leaveMulticast(socket, group, interface) do
      refusing(@failure, Net.UDP, "UDP has no socket")
    end
  end

  make Unix, implement: Net.Socket.Unix do
    foul connect(address) = refusing(@failure, Net.Unix, "Unix refused to connect")
    foul connect(address, options) = refusing(@failure, Net.Unix, "Unix refused to connect")
    foul listen(address) = refusing(@failure, Net.Unix, "Unix refused to listen")
    foul listen(address, options) = refusing(@failure, Net.Unix, "Unix refused to listen")
    foul connectTo(path) = refusing(@failure, Net.Unix, "Unix refused to connect")
    foul connectTo(path, block) = refusing(@failure, Net.Unix, "Unix refused to connect")
    foul bind(path) = refusing(@failure, Net.Unix, "Unix refused to listen")
    foul bind(path, block) = refusing(@failure, Net.Unix, "Unix refused to listen")
    foul accept(listener) = refusing(@failure, Net.Unix, "Unix refused to accept")
    foul sendAll(connection, data) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul put(connection, content) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul write(connection, content) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul writeLine(connection, content) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul print(connection, content) = ()
    foul printLine(connection, content) = ()
    foul readLine(connection) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul getLine(connection) = None
    foul receiveChunk(connection, limit) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul receiveExactly(connection, count) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul receiveUntil(connection, delimiter, limit) do
      refusing(@failure, Net.Unix, "Unix has no connection")
    end
    foul receiveLine(connection, limit) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul shutdownWrite(connection) = refusing(@failure, Net.Unix, "Unix has no connection")
    foul closed?(handle) = true
  end

  make TLS, implement: Net.Socket.TLS do
    foul connect(endpoint, config) = refusing(@failure, Net.TLS, "TLS refused to connect")
    foul sendAll(connection, data) = refusing(@failure, Net.TLS, "TLS has no connection")
    foul put(connection, content) = refusing(@failure, Net.TLS, "TLS has no connection")
    foul write(connection, content) = refusing(@failure, Net.TLS, "TLS has no connection")
    foul writeLine(connection, content) = refusing(@failure, Net.TLS, "TLS has no connection")
    foul print(connection, content) = ()
    foul printLine(connection, content) = ()
    foul receiveChunk(connection, limit) = refusing(@failure, Net.TLS, "TLS has no connection")
    foul closed?(connection) = true
  end
end

private do
  # A split "host:port" address: the shared result of +splitHostPort+.
  record HostPort do
    host : String
    port : Net.Port
  end

  # Splits a "host:port" address into its host and validated port.
  #
  # Shared by the endpoint parsers so the colon logic lives in one
  # place. Failures carry the caller's +operation+.
  foul splitHostPort(address: String, operation: NetOperation) -> Result<HostPort, NetError> do
    let parts = address.split(":")
    if parts.count < 2
      return Error(NetError { kind: Parse, operation: operation, message: "expected host:port, got \"${address}\"" })
    end
    let host = parts.take(parts.count - 1).join(":")
    match Integer.parse(parts.last.or("")) do
      Ok(n) => match Net.Port.from(n) do
        Ok(port) => Ok(HostPort { host: host, port: port })
        Error(e) => Error(e)
      end
      Error(_) => Error(NetError { kind: Parse, operation: operation, message: "bad port in \"${address}\"" })
    end
  end

  # Answers +failure+ when a test injected one, else a canned +MockEmpty+.
  #
  # Shared by the socket stand-ins above: every refusing member is one call.
  foul refusing(failure, operation, what) do
    Error(failure.or(NetError { kind: MockEmpty, operation: operation, message: what }))
  end
end
