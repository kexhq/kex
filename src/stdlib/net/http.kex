# Buffered HTTP clients, responses, and a small declaration-ordered server
# router. Requests never follow redirects or perform generic retries implicitly.
#
#   using Net.HTTP
#
#   let response = HTTP.get("https://example.test/").try
#   response.status.success?   # => true
#
# For connection reuse and statistics, own a client explicitly:
#
#   let client = Client.open.try
#   let response = client.get("https://example.test/").try
#   client.close.try
module Net.HTTP

# An insertion-ordered HTTP field collection. Names compare case-insensitively
# and duplicate fields are preserved.
#
# A list of pairs rather than a +{String: String}+ map, and deliberately so.
# A map cannot hold the same name twice, and +Set-Cookie+ needs exactly that:
# RFC 6265 does not define it as a comma-separated list, so two cookies must
# travel as two fields and cannot be joined into one. A map interface would
# read as the obvious one right up to the first response that sets two
# cookies, then silently keep one — the same class of quiet data loss this
# module's +Result+-returning builders exist to avoid.
#
# Order is kept for the same reason. RFC 9110 makes order insignificant
# BETWEEN different names but significant between fields sharing a name, and
# a map has no order to keep.
record Headers do
  entries : [(String, String)]
end

# A validated HTTP status code in +100..599+.
record Status do
  code : Integer
end

# A typed HTTP response envelope whose body representation is explicit.
record Response<B> do
  status : Status
  headers : Headers
  body : B
end

# A typed HTTP request envelope whose body representation is explicit.
record Request<B> do
  method : String
  target : URI
  headers : Headers
  body : B
end

# Route captures decoded after path segmentation.
record RouteContext do
  parameters : Map<String, String> = {}
end

# Per-request server context.
record Context do
  route : RouteContext
end

# A buffered HTTP route handler. Handling a request is effectful: routes may
# read files, query a database, send messages, or perform other application IO.
type Handler = Type.of(handlerType)

# One declared route; routers preserve declaration order.
record Route do
  method : String
  path : String
  handler : Handler
  # The largest request body this route reads, in bytes, or +None+ for the
  # server's +ServerOptions.maximumBodyBytes+.
  maximumBodyBytes : Integer? = None
end

# An immutable, declaration-ordered HTTP router.
record Router do
  routes : [Route] = []
end

# Counts and elapsed time from graceful server shutdown.
record ShutdownReport do
  completed : Integer
  failed : Integer
  forced : Integer
  elapsedMilliseconds : Integer
end

# Bounded HTTP server resources, default graceful-shutdown duration and
# request body limit.
record ServerOptions do
  maximumHandlers : Integer = 1024
  backlog : Integer = 128
  gracefulShutdown : Duration = Duration.seconds(10)
  # The largest request body a route reads, in bytes, unless the route sets
  # its own. A request declaring a longer +Content-Length+ is answered
  # +413 Payload Too Large+ before any of its body is read.
  maximumBodyBytes : Integer = 10485760
end

# How long one client request may take, and how large an answer it accepts.
#
# A request over a size limit is a +Limit+ error, and one over a time limit a
# +Timeout+.
#
# @example A link preview: a short deadline and a small answer
#   RequestOptions { timeout: Duration.seconds(2), maximumBodyBytes: 262144 }
record RequestOptions do
  # How long connecting to the server may take.
  connectTimeout : Duration = Duration.seconds(10)
  # The whole exchange, from connecting to the last byte of the body.
  timeout : Duration = Duration.seconds(30)
  # The largest response body accepted, in bytes.
  maximumBodyBytes : Integer = 16777216
  # The largest response header block accepted, in bytes. +HTTP.request+
  # leaves header parsing to the runtime and does not apply it.
  maximumHeaderBytes : Integer = 65536
end

# HTTP connection-pool bounds and idle lifetime.
record PoolOptions do
  perOrigin : Integer = 8
  total : Integer = 128
  queuedRequests : Integer = 256
  idleExpiryMilliseconds : Integer = 30000
end

# Options owned by an explicit HTTP client.
record ClientOptions do
  pool : PoolOptions = PoolOptions {}
  # The limits of every request the client makes without its own.
  request : RequestOptions = RequestOptions {}
end

# Lifetime request/reuse counters plus current pooled connections.
record ClientStatistics do
  openConnections : Integer
  requests : Integer
  reusedConnections : Integer
end

# Resources released by +Client.close+.
record ClientCloseReport do
  closedConnections : Integer
end

# The pooled HTTP client. An opaque handle over the connection pool that
# owns it; `Client.open` makes one and `client.close` releases it.
type Client

# Construction and parsing of validated HTTP header collections.
module Headers do
  # Returns a field collection with no entries.
  #
  # @return [Headers] an empty field collection
  #
  # @example Building request headers immutably
  #   Headers.empty
  #     .add("Accept", "application/json").try
  #     .add("User-Agent", "inventory-sync/1.0").try
  empty : Headers
  let empty = Headers { entries: [] }

  # Validates header names and values without folding duplicates.
  #
  # Duplicate fields stay in their original order. Invalid names and values
  # containing line breaks are rejected instead of creating a malformed or
  # injectable HTTP message.
  #
  # @return [Result<Headers, NetError>] validated fields, or +Parse+
  #
  # @example Forwarding an explicitly selected set of request headers
  #   Headers.from([
  #     ("Accept", "application/json"),
  #     ("X-Request-ID", requestId)
  #   ]).try
  from : [(String, String)] -> Result<Headers, NetError>
  let from(entries) = Kex.Intrinsic.NetHTTP.headers(entries)

  # Validates header names and values from unordered pairs, for the common
  # case where every name is used once. Do not use this for `Set-Cookie` or
  # any other field that legitimately repeats — a `Map` cannot hold a name
  # twice, so unlike the list form above, a second value for the same name
  # here does not add a second field; it silently replaces the first (see
  # this module's own +Headers+ record doc for why that specific field
  # cannot be folded into one entry). Reach for the ordered list form for
  # anything that might repeat a name.
  #
  # @return [Result<Headers, NetError>] validated fields, or +Parse+
  #
  # @example Forwarding a set of request headers that are each sent once
  #   Headers.from({ "Accept": "application/json", "X-Request-ID": requestId }).try
  from : Map<String, String> -> Result<Headers, NetError>
  let from(entries: Map<String, String>) = Kex.Intrinsic.NetHTTP.headers(entries.entries)

  # Parses CRLF- or LF-separated header fields.
  #
  # Use this at a protocol boundary when headers arrive as text. Application
  # code normally builds them with +from+, +add+, and +set+.
  #
  # @return [Result<Headers, NetError>] fields in source order, or +Parse+
  #
  # @example Parsing headers captured from a diagnostic fixture
  #   Headers.parse("Content-Type: text/plain\r\nX-Trace: abc\r\n").try
  parse : String -> Result<Headers, NetError>
  let parse(text) = Kex.Intrinsic.NetHTTP.parseHeaders(text)
end

# Validation for numeric HTTP status codes.
module Status do
  # Validates an HTTP status code.
  #
  # @param code [Integer] a status in +100..599+
  # @return [Result<Status, NetError>] the status, or +Parse+
  #
  # @example Validating a configurable health-check success code
  #   let code = ENV.get("HEALTH_STATUS").flatMap { |text| text.to(Integer) }.or(204)
  #   let expected = Status.from(code).try
  from : Integer -> Result<Status, NetError>
  let from(code) = Kex.Intrinsic.NetHTTP.status(code)
end

# Buffered response constructors for route handlers.
module Response do
  # Builds a buffered binary response with validated headers.
  #
  # @example Returning a downloaded file without decoding it as text
  #   Response.binary(200, archive, Headers.empty.add("Content-Type", "application/zip").try)
  foul binary(status: Integer, body: Binary, headers: Headers) -> Response<Binary> = Kex.Intrinsic.NetHTTP.responseBinary(status, body, headers)
  # Builds a UTF-8 text response with an explicit text/plain content type.
  #
  # @example A small health endpoint
  #   Response.text(200, "ok")
  foul text(status: Integer, body: String) -> Response<Binary> = Kex.Intrinsic.NetHTTP.responseText(status, body)
  # Builds a response with an empty body.
  #
  # @example A successful DELETE endpoint
  #   Response.empty(204)
  foul empty(status: Integer) -> Response<Binary> = Kex.Intrinsic.NetHTTP.responseEmpty(status)
end

# The empty starting point for an immutable route declaration chain.
module Router do
  # @return [Router] a router with no routes
  # @example Build a health endpoint
  #   Router.build.get("/health", do |request, context|
  #     Response.text(200, "ok")
  #   end)
  build : Router
  let build = Router { routes: [] }
end

make Router do
  # Appends a route; earlier matching declarations win.
  #
  # Use this for a method without a convenience function. Paths may include
  # named or wildcard captures, which the handler reads from +RouteContext+.
  #
  # @example Adding a custom method
  #   router.route("PURGE", "/cache/:key", ~purge)
  let route(method: String, path: String, handler: Handler) -> Router = this.limited(method, path, handler, None)
  # Appends a route that reads request bodies up to +maximumBodyBytes+,
  # instead of the server's +ServerOptions.maximumBodyBytes+.
  #
  # A request declaring a longer body is answered +413 Payload Too Large+
  # before any of it is read, and the handler never runs.
  #
  # @example An upload route allowing more than every other route
  #   Router.build
  #     .post("/avatar", ~avatar, maximumBodyBytes: 2097152)
  #     .post("/upload", ~upload, maximumBodyBytes: 524288000)
  let route(method: String, path: String, handler: Handler, maximumBodyBytes: Integer) -> Router = this.limited(method, path, handler, Just(maximumBodyBytes))
  # Appends a GET route. GET also supplies automatic HEAD fallback.
  let get(path: String, handler: Handler) -> Router = this.route("GET", path, handler)
  # Appends a GET route with its own request body limit.
  let get(path: String, handler: Handler, maximumBodyBytes: Integer) -> Router = this.route("GET", path, handler, maximumBodyBytes: maximumBodyBytes)
  # Appends an explicit HEAD route, overriding automatic GET fallback.
  let head(path: String, handler: Handler) -> Router = this.route("HEAD", path, handler)
  # Appends an explicit OPTIONS route, overriding generated OPTIONS.
  let options(path: String, handler: Handler) -> Router = this.route("OPTIONS", path, handler)
  # Appends a POST route.
  let post(path: String, handler: Handler) -> Router = this.route("POST", path, handler)
  # Appends a POST route with its own request body limit.
  let post(path: String, handler: Handler, maximumBodyBytes: Integer) -> Router = this.route("POST", path, handler, maximumBodyBytes: maximumBodyBytes)
  # Appends a PUT route.
  let put(path: String, handler: Handler) -> Router = this.route("PUT", path, handler)
  # Appends a PUT route with its own request body limit.
  let put(path: String, handler: Handler, maximumBodyBytes: Integer) -> Router = this.route("PUT", path, handler, maximumBodyBytes: maximumBodyBytes)
  # Appends a PATCH route.
  let patch(path: String, handler: Handler) -> Router = this.route("PATCH", path, handler)
  # Appends a PATCH route with its own request body limit.
  let patch(path: String, handler: Handler, maximumBodyBytes: Integer) -> Router = this.route("PATCH", path, handler, maximumBodyBytes: maximumBodyBytes)
  # Appends a DELETE route.
  let delete(path: String, handler: Handler) -> Router = this.route("DELETE", path, handler)

  private do
    let limited(method: String, path: String, handler: Handler, maximumBodyBytes: Integer?) -> Router = Router {
      routes: @routes + [Route { method: method, path: path, handler: handler, maximumBodyBytes: maximumBodyBytes }]
    }
  end
end

# Starting, observing, and gracefully stopping HTTP servers.
module Server do
  # An opaque asynchronous HTTP server handle.
  type Running
  # Starts a server with conservative defaults and returns immediately.
  #
  # The returned handle owns the listener and active handlers. Use +start+
  # when the process has other work to do; use +serve+ for a foreground server
  # whose main job is handling HTTP.
  #
  # @example
  #   let router = Router.build.get("/health", do |request, context|
  #     Response.text(200, "ok")
  #   end)
  #   let endpoint = Net.Socket.TCP.Endpoint.loopback(Net.Port.from(0).try)
  #   let server = Server.start(endpoint, router).try
  #   Server.stop(server).try
  foul start(endpoint: Net.Socket.TCP.Endpoint, router: Router) -> Result<Running, NetError> = Kex.Intrinsic.NetHTTPServer.start(endpoint, router)
  # Starts a server with explicit concurrency, backlog, and shutdown bounds.
  foul start(endpoint: Net.Socket.TCP.Endpoint, router: Router, options: ServerOptions) -> Result<Running, NetError> = Kex.Intrinsic.NetHTTPServer.start(endpoint, router, options)
  # Starts with defaults and blocks until the server stops.
  foul serve(endpoint: Net.Socket.TCP.Endpoint, router: Router) -> Result<Void, NetError> = Kex.Intrinsic.NetHTTPServer.serve(endpoint, router)
  # Starts with options and blocks until the server stops.
  foul serve(endpoint: Net.Socket.TCP.Endpoint, router: Router, options: ServerOptions) -> Result<Void, NetError> = Kex.Intrinsic.NetHTTPServer.serve(endpoint, router, options)

  # Gracefully stops using the duration captured at start.
  #
  # New requests stop being accepted while in-flight handlers get their grace
  # period to finish. The report says how much work completed or was forced
  # down during shutdown.
  #
  # @example Shutting down from an application lifecycle hook
  #   let report = Server.stop(server).try
  #   IO.printLine("closed after ${report.completed} requests")
  foul stop(server: Running) -> Result<ShutdownReport, NetError> = Kex.Intrinsic.NetHTTPServer.stop(server)
  # Gracefully stops with an operation-specific grace duration.
  foul stop(server: Running, grace: Duration) -> Result<ShutdownReport, NetError> = Kex.Intrinsic.NetHTTPServer.stop(server, grace)
  # Waits until the server owner exits.
  foul join(server: Running) -> Result<Void, NetError> = Kex.Intrinsic.NetHTTPServer.join(server)
  # @return [Bool] whether the server owner is alive
  foul running?(server: Running) -> Bool = Kex.Intrinsic.NetHTTPServer.running?(server)
  # Returns the bound address, including an operating-system-assigned port.
  #
  # @return [Net.Socket.TCP.Endpoint] the bound address
  #
  # @example Publishing the actual address of a test server
  #   let endpoint = Server.localAddress(server)
  #   IO.printLine("test server: http://${endpoint.host}:${endpoint.port.string}")
  foul localAddress(server: Running) -> Net.Socket.TCP.Endpoint = Kex.Intrinsic.NetHTTPServer.localAddress(server)
end

# Constructors for explicitly owned, connection-pooling HTTP clients.
module Client do
  # Opens an explicit pooled client with conservative defaults.
  #
  # Reuse one client for related requests so keep-alive connections and DNS
  # work can be reused. Close it when the owning service shuts down.
  #
  # @example Fetching several pages through one connection pool
  #   let client = Client.open.try
  #   let first = client.get("https://api.example.com/items?page=1").try
  #   let second = client.get("https://api.example.com/items?page=2").try
  #   client.close.try
  open : Result<Client, NetError>
  foul open() = Kex.Intrinsic.NetHTTPClient.open(ClientOptions {})
  # Opens an explicit client owning the supplied pool policy.
  open : ClientOptions -> Result<Client, NetError>
  foul open(options) = Kex.Intrinsic.NetHTTPClient.open(options)
end

make Client do
  # Sends a buffered request. Redirects and generic retries are not implicit.
  #
  # This keeps policy with the caller: inspect a redirect before following it,
  # and retry only methods and failures your application knows are safe.
  #
  # @example Sending JSON with an idempotency key
  #   let headers = Headers.empty
  #     .add("Content-Type", "application/json").try
  #     .add("Idempotency-Key", requestId).try
  #   client.request("POST", url, headers, JSON.stringify(order).to(Binary).try)
  foul request(method: String, url: String, headers: Headers, body: Binary) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, method, url, headers, body)
  # Sends a buffered request with its own limits instead of the client's.
  #
  # @example A link preview that gives up after two seconds
  #   let quick = RequestOptions { timeout: Duration.seconds(2), maximumBodyBytes: 262144 }
  #   client.request("GET", url, Headers.empty, Binary.empty, quick)
  foul request(method: String, url: String, headers: Headers, body: Binary, options: RequestOptions) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, method, url, headers, body, options)
  # Sends a buffered GET request.
  foul get(url: String) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.get(this, url)
  # Sends a buffered binary POST request.
  foul post(url: String, body: Binary) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.post(this, url, body)
  # Sends a buffered binary PUT request.
  foul put(url: String, body: Binary) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, "PUT", url, Headers.empty, body)
  # Sends a buffered binary PATCH request.
  foul patch(url: String, body: Binary) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, "PATCH", url, Headers.empty, body)
  # Sends a DELETE request with an empty body.
  foul delete(url: String) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, "DELETE", url, Headers.empty, Binary.empty)
  # Sends a HEAD request; the returned body is empty.
  foul head(url: String) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, "HEAD", url, Headers.empty, Binary.empty)
  # Sends an OPTIONS request.
  foul options(url: String) -> Result<Response<Binary>, NetError> = Kex.Intrinsic.NetHTTPClient.request(this, "OPTIONS", url, Headers.empty, Binary.empty)
  # Reports current pool occupancy and lifetime request counters.
  #
  # @return [ClientStatistics] current pool and lifetime request counters
  #
  # @example Emitting client-pool diagnostics
  #   let stats = client.statistics
  #   IO.printLine("HTTP reuse: ${stats.reusedConnections}/${stats.requests}")
  foul statistics -> ClientStatistics = Kex.Intrinsic.NetHTTPClient.statistics(this)
  # Idempotently closes the client and every idle pooled connection.
  #
  # Further requests fail with +Closed+; a second close is harmless.
  foul close -> Result<ClientCloseReport, NetError> = Kex.Intrinsic.NetHTTPClient.close(this)
end

make Headers, implement: Showable, Inspectable do
  # Appends a field, keeping existing fields of the same name.
  #
  # Repeats are how +Set-Cookie+ works: it is not a comma-separated list, so
  # two cookies must be two fields. For replace-semantics, +remove+ first.
  #
  # An invalid name or value is an +Error+, not a silent drop. Rejecting
  # +"a\r\nX: y"+ is what stops response splitting, but dropping it quietly
  # left the caller holding a valid +Headers+ that simply lacked the field it
  # asked for, and a response with no +Content-Type+ invites MIME sniffing.
  # +from+ and +parse+ already answer with a +Result+ for this same input.
  #
  # @return [Result<Headers, NetError>] the extended fields, or +Parse+
  #
  # @example Two cookies on one response
  #   Headers.empty
  #     .add("Set-Cookie", "session=abc; HttpOnly").try
  #     .add("Set-Cookie", "theme=dark").try
  #
  # @example Replacing a field
  #   headers.remove("Content-Type").add("Content-Type", "application/json").try
  let add(name: String, value: String) -> Result<Headers, NetError> = Kex.Intrinsic.NetHTTP.addHeader(this, name, value)
  # Removes every field matching +name+ case-insensitively.
  #
  # @example Stripping hop-by-hop state before forwarding
  #   let forwarded = incoming.remove("Connection")
  let remove(name: String) -> Headers = Kex.Intrinsic.NetHTTP.removeHeader(this, name)
  # Returns the first matching field value.
  #
  # @example Selecting a response decoder
  #   let contentType = response.headers.get("Content-Type").or("application/octet-stream")
  let get(name: String) -> String? = Kex.Intrinsic.NetHTTP.getHeader(this, name)
  # Returns every matching value in insertion order.
  #
  # @example Preserving every Set-Cookie field
  #   let cookies = response.headers.getAll("Set-Cookie")
  let getAll(name: String) -> [String] = Kex.Intrinsic.NetHTTP.getAllHeaders(this, name)
  # Renders fields while replacing authorization and cookie values with +***+.
  let showValue -> String = Kex.Intrinsic.NetHTTP.redactedHeaders(this)
  # Structural inspection uses the same credential-safe rendering.
  let inspectValue(colors: Bool) -> String = Kex.Intrinsic.NetHTTP.redactedHeaders(this)
end

make Status do
  # @return [Bool] whether the status is in +100..199+
  let informational? -> Bool = @code >= 100 && @code < 200
  # @return [Bool] whether the status is in +200..299+
  let success? -> Bool = @code >= 200 && @code < 300
  # @return [Bool] whether the status is in +300..399+
  let redirect? -> Bool = @code >= 300 && @code < 400
  # @return [Bool] whether the status is in +400..499+
  let clientError? -> Bool = @code >= 400 && @code < 500
  # @return [Bool] whether the status is in +500..599+
  let serverError? -> Bool = @code >= 500 && @code < 600
end

make RouteContext do
  # Returns one decoded named or wildcard route capture.
  #
  # @param name [String] the capture name declared in the route
  # @return [Result<String, NetError>] the capture, or +Parse+ when absent
  #
  # @example Reading +:id+ from a +/users/:id+ route
  #   let id = context.parameter("id").try
  let parameter(name: String) -> Result<String, NetError> = match @parameters.get(name) do
    Just(value) => Ok(value)
    None => Error(NetError { kind: Parse, operation: HTTPServer, message: "missing route parameter: ${name}" })
  end
end

# Stateless HTTP convenience calls for scripts and occasional requests.
module HTTP do
  # Sends one stateless buffered request with no redirect or hidden retry.
  #
  # Each call owns a short-lived client. This is convenient for scripts and
  # occasional requests; use +Client+ for a service making repeated calls.
  #
  # @example A one-off authenticated request in a command-line tool
  #   let headers = Headers.empty.add("Authorization", "Bearer ${token}").try
  #   HTTP.request("GET", url, headers).try
  request : String -> String -> Headers -> Binary -> Result<Response<Binary>, NetError>
  let request(method, url, headers = Headers.empty, body = Binary.empty) = Kex.Intrinsic.NetHTTP.request(method, url, headers, body)
  # Sends one stateless buffered request with its own time and size limits.
  #
  # The body is read as it arrives and the request abandoned once it passes
  # +maximumBodyBytes+, so an oversized answer is never held whole.
  #
  # @example
  #   HTTP.request("GET", url, Headers.empty, Binary.empty, RequestOptions { timeout: Duration.seconds(2) })
  request : String -> String -> Headers -> Binary -> RequestOptions -> Result<Response<Binary>, NetError>
  let request(method, url, headers, body, options) = Kex.Intrinsic.NetHTTP.request(method, url, headers, body, options)
  # Sends one stateless buffered GET.
  # @example
  #   HTTP.get("https://example.test/").try
  get : String -> Result<Response<Binary>, NetError>
  let get(url) = Kex.Intrinsic.NetHTTP.get(url)
  # Sends one stateless DELETE with an empty body.
  delete : String -> Result<Response<Binary>, NetError>
  let delete(url) = request("DELETE", url, Headers.empty, Binary.empty)
  # Sends one stateless HEAD and returns an empty response body.
  head : String -> Result<Response<Binary>, NetError>
  let head(url) = request("HEAD", url, Headers.empty, Binary.empty)
  # Sends one stateless OPTIONS request.
  options : String -> Result<Response<Binary>, NetError>
  let options(url) = request("OPTIONS", url, Headers.empty, Binary.empty)
  # Sends one stateless buffered binary POST.
  post : String -> Binary -> Result<Response<Binary>, NetError>
  let post(url, body) = request("POST", url, Headers.empty, body)
  # Sends one stateless buffered binary PUT.
  put : String -> Binary -> Result<Response<Binary>, NetError>
  let put(url, body) = request("PUT", url, Headers.empty, body)
  # Sends one stateless buffered binary PATCH.
  patch : String -> Binary -> Result<Response<Binary>, NetError>
  let patch(url, body) = request("PATCH", url, Headers.empty, body)
end

private do
  foul handlerType(
    _request: Request<Binary>,
    _context: Context
  ) -> Response<Binary> = Kex.Intrinsic.NetHTTP.responseEmpty(500)
end
