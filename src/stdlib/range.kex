# Range — a range computes everything from its two bounds; `items`
# materializes the elements into a real list when one is needed.
make Range, implement: Enumerable, Foldable do
  # Shared primitive for Enumerable and Foldable. Range stays structurally
  # minimal; inherited operations reduce over its materialized items in
  # ascending range order.
  let reduce(acc, f) = this.items.reduce(acc, f)

  # Numeric range aggregates are expressed in terms of the Enumerable
  # primitive rather than relying on the walker's historical List fallback.
  let sum = this.reduce(0) { |acc, n| acc + n }
  let product = this.reduce(1) { |acc, n| acc * n }

  # Membership is a Range method, not a fallback into the bare String/List
  # native dispatcher.
  let contains?(value) = this.items.contains?(value)

  # The range's elements as a list.
  #
  # @example
  #   (1..3).items      # => [1, 2, 3]
  #   ('a'..'c').items  # => ['a', 'b', 'c']
  let items = Kex.Intrinsic.Range.items(this)

  # The list operations, over the materialized items. A range is an ordered
  # collection, so `(1..5).first` and `(1..5).length` are questions it can
  # answer — and on the BEAM backend, where a range IS its item list, they
  # already worked. Only the walker rejected them ("Undefined method: first
  # for Range"), so every one of these was a backend divergence rather than a
  # deliberate restriction.
  let first = this.items.first
  let second = this.items.second
  let third = this.items.third
  let last = this.items.last
  let rest = this.items.rest
  let length = this.items.length
  let count = this.items.length
  let empty? = this.items.empty?
  let max = this.items.max
  let min = this.items.min
  let reverse = this.items.reverse
  let sort = this.items.sort
  let sort(comparator) = this.items.sort(comparator)
  let uniq = this.items.uniq
  let join(separator) = this.items.join(separator)
  let at(index) = this.items.at(index)
  let at(index, fallback) = this.items.at(index, fallback)
  let take(n) = this.items.take(n)
  let drop(n) = this.items.drop(n)
  let indexOf(value) = this.items.indexOf(value)
  let zip(other) = this.items.zip(other)
  let partition(pred) = this.items.partition(pred)
  let reject(pred) = this.items.reject(pred)
end
