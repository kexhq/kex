# Networking values shared by the network modules: ports, a report of which
# transports this build supports, and the error type they all return.
#
#   using Net
#
#   let https = Port.from(443).try
#   if Support.current.tls.usable? then https.string else "TLS unavailable" end
module Net

# A TCP or UDP port number, checked to be in +0..65535+.
#
# Build one with +Port.from+. Port zero asks the operating system for a free
# port where a listening API allows it; after binding, ask the server or socket
# which port it got.
record Port do
  # The validated numeric port.
  value : Integer
end

# Whether a networking feature is built in, and whether it can be used here.
#
# +compiled?+ describes the build. +usable?+ also takes the running environment
# into account: a browser build can contain an HTTP client while browser policy
# still blocks a lower-level transport.
record SupportValue do
  # Whether the running Kex build contains the feature.
  compiled? : Bool

  # Whether the feature can be used in the current environment.
  usable? : Bool
end

# The networking features of the running build, one +SupportValue+ each.
#
# Consult it to pick a transport at run time. A program that needs one feature
# can check that field at startup and stop with a clear message. The tree-walk
# interpreter (+kex -R+) reports every feature as unavailable.
record SupportReport do
  dns : SupportValue
  tcp : SupportValue
  udp : SupportValue
  unix : SupportValue
  tls : SupportValue
  httpClient : SupportValue
  httpServer : SupportValue
  webSocketClient : SupportValue
  webSocketServer : SupportValue
end

# Construction of +Port+ values.
module Port do
  # Returns +value+ as a +Port+, or a +Parse+ error when it is outside
  # +0..65535+.
  #
  # @param value [Integer] a number in +0..65535+
  # @return [Result<Port, NetError>] the port, or a +NetError+ of kind +Parse+
  #
  # @example Reading a listen port from the environment
  #   let number = ENV.get("PORT").into { |text| text.to(Integer) }.or(8080)
  #   let port = Port.from(number).try
  from : Integer -> Result<Port, NetError>
  let from(value) = Kex.Intrinsic.Net.port(value)
end

# Run-time discovery of the optional network transports and protocols.
module Support do
  # Returns which networking features this build contains and which are usable
  # now.
  #
  # @return [SupportReport] one flag pair per feature
  #
  # @example Explaining why an HTTP-dependent command cannot run
  #   if !Support.current.httpClient.usable?
  #     die("this Kex build cannot make HTTP requests here")
  #   end
  current : SupportReport
  let current = Kex.Intrinsic.Net.support()
end

# The subsystem or operation that produced a networking error.
type NetOperation = DNS | TCP | UDP | Unix | TLS | HTTPClient | HTTPServer | WebSocketClient | WebSocketServer

# The category of a networking failure, the same on every backend.
type NetErrorKind = Parse | Resolve | Connect | Protocol | Timeout | Cancelled | Limit | Closed | ReadInProgress | UnsupportedBackend | UnsupportedOption | BrowserRestricted | OpaqueRedirect | MockEmpty | Backend

# The error every network module returns.
#
# Branch on +kind+; it does not change between backends. +message+ is text for
# a person and may differ by backend. +phase+ names the protocol step that
# failed, such as a TLS handshake, and +progress+ counts the bytes transferred
# before an operation failed partway.
record NetError do
  kind : NetErrorKind
  operation : NetOperation
  message : String
  phase : String?
  progress : Integer?
end

make Port do
  # Returns the port number as decimal text, with no host or scheme.
  #
  # @return [String] the port number, such as +"443"+
  #
  # @example Building an address for display
  #   IO.printLine("listening on 127.0.0.1:${port.string}")
  let string -> String = @value.to(String).or("")
end
