# Numbers that carry a unit.
#
# +5.second+ and +90.minute+ are +Measure+s: a number, the unit it was
# written in, and the same quantity in the base unit of its dimension.
# Arithmetic and conversion use the base-unit value, so operands can be in
# different units. The dimension is part of the type, as in
# +Measure<Quantity.Time>+, so adding a time to a length does not type-check.
#
#   5.second.to(String)                       # => Just("5.0 s")
#   1.5.hour.to(String)                       # => Just("1.5 h")
#   (1.hour + 30.minute).to(String)           # => Just("1.5 h")
#   90.minute.to(String, in: Hour)            # => Just("1.5 h")
#
# The time units, +nanosecond+ through +week+, are in the prelude. Units for
# other dimensions are in opt-in modules under +Units+, such as +Units.SI+
# and +Units.Data+, and use the same +Measure+.
#
# A time measure is a +Duration+, the span type that +Time+, +Date+ and
# +DateTime+ take: +Date.today() + 3.day+.

# The trait every unit implements: its conversion factor to the base unit
# of its dimension, the dimension, and its symbol.
trait Unit do
  # Returns how many base units one of this unit is: +60.0+ for a minute,
  # since the base unit of time is the second.
  #
  # @return [Float] the conversion factor
  #
  # @example
  #   Minute.factor   # => 60.0
  factor :> Float

  # Returns the dimension this unit measures, as an atom. Only measures of the
  # same dimension can be added or converted into each other.
  #
  # @return [Atom] the dimension tag
  #
  # @example
  #   Second.kind   # => :time
  kind :> Atom

  # Returns the symbol a measure in this unit is shown with.
  #
  # @return [String] the unit's symbol
  #
  # @example
  #   Minute.symbol   # => "min"
  symbol :> String
end

# Returns the dimension of a measure, as an atom.
#
# @param measure [Measure] the measure to inspect
# @return [Atom] the dimension tag
#
# @example
#   measureKind(5.second)   # => :time
let measureKind(measure: Measure<D>) -> Atom = measure.unit.dimension

# Returns the symbol of a measure's unit.
#
# @param measure [Measure] the measure to inspect
# @return [String] the unit's symbol
#
# @example
#   measureSymbol(5.minute)   # => "min"
let measureSymbol(measure: Measure<D>) -> String = measure.unit.notation

# Returns the conversion factor of a measure's unit to its base unit.
#
# @param measure [Measure] the measure to inspect
# @return [Float] the conversion factor
#
# @example
#   measureFactor(5.minute)   # => 60.0
let measureFactor(measure: Measure<D>) -> Float = measure.unit.conversionFactor

# A unit described by its fields instead of a constructor.
#
# Every +Measure+ stores its unit this way. Prefixed units and units made by
# arithmetic, such as +m^2+ from squaring a length or a kilo- prefix on a
# base unit, exist only in this form.
record UnitDefinition do
  # How many base units one of this unit is.
  conversionFactor : Float

  # Which dimension this unit measures.
  dimension : Atom

  # How the unit is written.
  notation : String
end

make UnitDefinition, implement: Unit do
  # How many base units one of this unit is.
  #
  # @return [Float] the conversion factor
  let factor = @conversionFactor

  # Which dimension this unit measures.
  #
  # @return [Atom] the dimension tag
  let kind = @dimension

  # How the unit is written.
  #
  # @return [String] the unit's symbol
  let symbol = @notation
end

# The dimensions a measure can have, as types: the +D+ of +Measure<D>+.
#
# Each unit fixes its dimension: +1.second+ is a +Measure<Quantity.Time>+ and
# +1.meter+ a +Measure<Quantity.Length>+, so adding, comparing or ordering
# measures of different dimensions is a type error. These types have no
# values. Unit arithmetic gives a dimension too: +1.watt * 1.hour+ is a
# +Measure<Quantity.Energy>+, from the products +Units.SI+ declares, and a
# product it does not declare is a type error.
module Quantity do
  record Time do
  end
  record Data do
  end
  record Length do
  end
  record Mass do
  end
  record Volume do
  end
  record Temperature do
  end
  record Force do
  end
  record Energy do
  end
  record Power do
  end
  record Voltage do
  end
  record Current do
  end
  record Resistance do
  end
  record Charge do
  end
  # Dimensions derived from others by the products and quotients in
  # +Units.SI+: length over time is speed, speed over time acceleration,
  # force over length pressure, and length squared area.
  record Area do
  end
  record Speed do
  end
  record Acceleration do
  end
  record Pressure do
  end
end

# A quantity with a unit, of dimension +D+, one of the +Quantity+ types.
#
# Every unit module uses this record. +canonical+ holds the value in the
# dimension's base unit and +unit+ decides how it is shown, which is how
# +1.hour + 30.minute+ comes out right and still prints in hours.
record Measure<D> do
  # The quantity in the dimension's base unit, such as seconds for time.
  # Arithmetic and conversion use this value.
  canonical : Float

  # The quantity as written, in this measure's own unit.
  value : Float

  # The unit this measure displays in.
  unit : UnitDefinition
end

# A span of time, which is any measure of time.
#
# +Time+, +Date+ and +DateTime+ take one: +Date.today() + 3.day+.
type Duration = Measure<Quantity.Time>

# The units of time, from nanoseconds to weeks. The base unit is the second.
type TimeUnit = Nanosecond | Microsecond | Millisecond
              | Second | Minute | Hour | Day | Week

make TimeUnit, implement: Unit do
  let factor(@Nanosecond) = 0.000000001
  let factor(@Microsecond) = 0.000001
  let factor(@Millisecond) = 0.001
  let factor(@Second) = 1.0
  let factor(@Minute) = 60.0
  let factor(@Hour) = 3600.0
  let factor(@Day) = 86400.0
  let factor(@Week) = 604800.0

  let kind = :time

  let symbol(@Nanosecond) = "ns"
  let symbol(@Microsecond) = "μs"
  let symbol(@Millisecond) = "ms"
  let symbol(@Second) = "s"
  let symbol(@Minute) = "min"
  let symbol(@Hour) = "h"
  let symbol(@Day) = "d"
  let symbol(@Week) = "wk"
end

# Time measures from an +Integer+: +5.second+, +90.minute+, +2.week+.
#
# The measure is shown in the unit you named, so +90.minute+ prints as
# minutes, though it holds 5400 seconds as its base value.
make Integer do
  # This many nanoseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in nanoseconds
  #
  # @example
  #   100.nanosecond.to(String)   # => Just("100.0 ns")
  let nanosecond -> Measure<Quantity.Time> = this.timeMeasure(Nanosecond)

  # This many microseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in microseconds
  #
  # @example
  #   250.microsecond.to(String)   # => Just("250.0 μs")
  let microsecond -> Measure<Quantity.Time> = this.timeMeasure(Microsecond)

  # This many milliseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in milliseconds
  #
  # @example
  #   500.millisecond.to(String)   # => Just("500.0 ms")
  let millisecond -> Measure<Quantity.Time> = this.timeMeasure(Millisecond)

  # Returns this many seconds, as a +Measure+. The second is the base unit of
  # time.
  #
  # @return [Measure] the quantity, displayed in seconds
  #
  # @example
  #   5.second.to(String)   # => Just("5.0 s")
  let second -> Measure<Quantity.Time> = this.timeMeasure(Second)

  # This many minutes, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in minutes
  #
  # @example
  #   90.minute.to(String, in: Hour)   # => Just("1.5 h")
  let minute -> Measure<Quantity.Time> = this.timeMeasure(Minute)

  # This many hours, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in hours
  #
  # @example
  #   (1.hour + 30.minute).showValue   # => "1.5 h"
  let hour -> Measure<Quantity.Time> = this.timeMeasure(Hour)

  # This many days, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in days
  #
  # @example
  #   1.day.convertTo(Hour).map { |m| m.showValue }   # => Ok("24.0 h")
  let day -> Measure<Quantity.Time> = this.timeMeasure(Day)

  # This many weeks, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in weeks
  #
  # @example
  #   2.week.to(String)   # => Just("2.0 wk")
  let week -> Measure<Quantity.Time> = this.timeMeasure(Week)

  private do
    let timeMeasure(unit: TimeUnit) -> Measure<Quantity.Time> do
      let value = Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0)
      return Measure {
        canonical: value * unit.factor,
        value: value,
        unit: UnitDefinition {
          conversionFactor: unit.factor,
          dimension: unit.kind,
          notation: unit.symbol
        }
      }
    end
  end
end

# Time measures from a +Float+, for fractional amounts: +1.5.hour+,
# +0.25.second+.
make Float do
  # This many nanoseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in nanoseconds
  let nanosecond -> Measure<Quantity.Time> = this.timeMeasure(Nanosecond)

  # This many microseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in microseconds
  let microsecond -> Measure<Quantity.Time> = this.timeMeasure(Microsecond)

  # This many milliseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in milliseconds
  #
  # @example
  #   2.5.millisecond.to(String)   # => Just("2.5 ms")
  let millisecond -> Measure<Quantity.Time> = this.timeMeasure(Millisecond)

  # This many seconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in seconds
  #
  # @example
  #   0.25.second.to(String)   # => Just("0.25 s")
  let second -> Measure<Quantity.Time> = this.timeMeasure(Second)

  # This many minutes, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in minutes
  let minute -> Measure<Quantity.Time> = this.timeMeasure(Minute)

  # This many hours, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in hours
  #
  # @example
  #   1.5.hour.to(String)   # => Just("1.5 h")
  let hour -> Measure<Quantity.Time> = this.timeMeasure(Hour)

  # This many days, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in days
  let day -> Measure<Quantity.Time> = this.timeMeasure(Day)

  # This many weeks, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in weeks
  let week -> Measure<Quantity.Time> = this.timeMeasure(Week)

  private do
    let timeMeasure(unit: TimeUnit) -> Measure<Quantity.Time> = Measure {
      canonical: this * unit.factor,
      value: this,
      unit: UnitDefinition {
        conversionFactor: unit.factor,
        dimension: unit.kind,
        notation: unit.symbol
      }
    }
  end
end

make Measure<D>, implement: Showable do
  let factor -> Float = this.unit.factor
  let kind -> Atom = this.unit.kind
  let symbol -> String = this.unit.symbol
  # Renders the measure in its own unit.
  #
  # @param String [Type] the target type
  # @return [String?] the rendered measure
  #
  # @example
  #   90.second.to(String)   # => Just("90.0 s")
  let to(String) -> String? = Just(this.showValue)

  # Renders the measure in its own unit, its value written by a digit
  # pattern (see +Number.format+).
  #
  # @param String [Type] the target type
  # @param format [NumberFormat] how to write the value
  # @return [String?] the rendered measure, or +None+ for a pattern that is
  #   not valid
  #
  # @example
  #   28.second.to(String, Number.format`#`)         # => Just("28 s")
  #   1.second.to(String, Number.format`#.##`)       # => Just("1 s")
  #   1.125.second.to(String, Number.format`#.00`)   # => Just("1.13 s")
  let to(String, format: NumberFormat) -> String? do
    return @value.to(String, format).map { |text| "${text} ${@unit.notation}" }
  end

  # Renders the measure in another time unit.
  #
  # Each unit module has the same function for its own units, so a measure
  # of any kind is shown in a chosen unit the same way: +in: Kilo(Meter)+
  # with +Units.SI+, +in: MiB+ with +Units.Data+.
  #
  # Returns +None+ when the measure is not a time.
  #
  # @param String [Type] the target type
  # @param in [TimeUnit] the unit to display in
  # @return [String?] the rendered measure, or +None+
  #
  # @example
  #   90.minute.to(String, in: Hour)   # => Just("1.5 h")
  #   1.5.hour.to(String, in: Minute)  # => Just("90.0 min")
  let to(String, in: TimeUnit) -> String? do
    match this.convertTo(in) do
      Ok(converted) => return converted.to(String)
      Error(_) => return None
    end
  end

  # Renders the measure in another time unit, with its number written by a
  # digit pattern (see +Number.format+).
  #
  # Returns +None+ when the measure is not a time.
  #
  # @example
  #   100.minute.to(String, in: Hour, format: Number.format`#.00`)   # => Just("1.67 h")
  #   90.minute.to(String, in: Hour, format: Number.format`#.###`)   # => Just("1.5 h")
  let to(String, in: TimeUnit, format: NumberFormat) -> String? do
    match this.convertTo(in) do
      Ok(converted) => return converted.to(String, format)
      Error(_) => return None
    end
  end

  # Returns the measure in the largest unit in which its size is at least 1.
  #
  # Time picks from nanoseconds through weeks, data from bytes through
  # terabytes, and SI dimensions from the decimal prefixes nano through giga.
  # Zero is shown in the base unit, and a value smaller than the smallest unit
  # in that unit. Measures of other dimensions keep their unit.
  #
  # @example
  #   90.second.scaled.to(String, Number.format`#.#`)   # => Just("1.5 min")
  let scaled -> This = this.scaled(false)

  # Returns the measure in the largest unit in which its size is at least 1,
  # as +scaled+ does. With +binary+ true, data uses KiB through TiB.
  #
  # @param binary [Bool] whether data uses powers of 1024
  # @return [This] the measure in the chosen unit
  let scaled(binary: Bool) -> This do
    let base = scaledMeasureBase(@unit)
    let family = scaledMeasureFamily(base, binary)
    let magnitude = Math.abs(@canonical)
    let selected = magnitude == 0.0 then base else
      family.filter { |unit| unit.conversionFactor <= magnitude }
        .last.or(family.first.or(base))
    return Measure {
      canonical: @canonical,
      value: scaledValue(@canonical, selected.conversionFactor),
      unit: selected
    }
  end

  # Renders the measure as its number and unit symbol, which is what
  # +IO.printLine+ and interpolation show. +inspected+ and the REPL show the
  # record's fields instead.
  #
  # @return [String] the value and the unit's symbol
  #
  # @example
  #   "drawn: ${1.volt * 5.ampere}"   # => "drawn: 5.0 W"
  let showValue -> String = "${this.value} ${this.unit.symbol}"

  # Multiplies the measure by a plain number, keeping its unit.
  #
  # Three times a two-second interval is six seconds, shown in seconds.
  #
  # @param multiplier [Number] the factor to multiply by
  # @return [Measure] the scaled measure
  #
  # @example
  #   2.second.scale(3).to(String)     # => Just("6.0 s")
  #   1.hour.scale(0.5).to(String)  # => Just("0.5 h")
  let scale(multiplier: Number) -> This do
    let converted = Kex.Intrinsic.Fun.convertTo(multiplier, Float).or(0.0)
    return Measure {
      canonical: this.canonical * converted,
      value: this.value * converted,
      unit: this.unit
    }
  end

  # Returns this measure's unit raised to +exponent+, for +squared+ and
  # +cubed+: the factor raised to that power, a notation such as +m^2+, and
  # the given dimension.
  #
  # @param exponent [Integer] the power
  # @param dimension [Atom] the resulting dimension (+:area+, +:volume+)
  # @return [UnitDefinition] the raised unit
  let raisedUnit(exponent: Integer, dimension: Atom) -> UnitDefinition = UnitDefinition {
    conversionFactor: Kex.Intrinsic.Math.pow(this.factor, exponent),
    dimension: dimension,
    notation: "${this.symbol}^${exponent}"
  }

  # Converts the measure to another unit of the same dimension.
  #
  # Units from opt-in modules such as +Units.SI+ and +Units.Data+ work too.
  # Converting to a unit of another dimension, such as seconds to meters, is
  # an +Error+.
  #
  # @param unit [Unit] the unit to convert to
  # @return [Result<Measure, String>] the converted measure, or why it could not be
  #
  # @example
  #   1.day.convertTo(Hour).map { |m| m.showValue }     # => Ok("24.0 h")
  #   90.minute.convertTo(Hour).map { |m| m.showValue } # => Ok("1.5 h")
  let convertTo(unit: Unit) -> Result<This, String> do
    let target = UnitDefinition {
      conversionFactor: unit.factor,
      dimension: unit.kind,
      notation: unit.symbol
    }
    match this.unit.kind == target.kind do
      true => return Ok(Measure {
        canonical: this.canonical,
        value: scaledValue(this.canonical, target.factor),
        unit: target
      })
      false => return Error("cannot convert between different measurement kinds")
    end
  end

  # Converts the measure to another time unit; +convertTo+ for time units
  # only.
  #
  # @param unit [TimeUnit] the time unit to convert to
  # @return [Result<Measure, String>] the converted measure, or why it could not be
  #
  # @example
  #   90.minute.convert(Hour).map { |m| m.showValue }   # => Ok("1.5 h")
  let convert(unit: TimeUnit) -> Result<This, String> do
    return this.convertTo(unit)
  end

  # Adds two measures of the same dimension.
  #
  # The units can differ. The sum is shown in the left operand's unit.
  # Adding measures of different dimensions does not type-check.
  #
  # @param other [Measure] a measure of the same dimension
  # @return [Measure] the sum, in this measure's unit
  #
  # @example
  #   (1.hour + 30.minute).showValue   # => "1.5 h"
  #   (30.minute + 1.hour).showValue   # => "90.0 min"
  + :> Measure<D> -> Measure<D>
  let +(other) = this.inOwnUnit(this.canonical + other.canonical)

  # Subtracts a measure of the same dimension.
  #
  # As with +++, the result is shown in the left operand's unit.
  #
  # @param other [Measure] a measure of the same dimension
  # @return [Measure] the difference, in this measure's unit
  #
  # @example
  #   (1.hour - 30.minute).showValue   # => "0.5 h"
  - :> Measure<D> -> Measure<D>
  let -(other) = this.inOwnUnit(this.canonical - other.canonical)

  # Returns a measure of +total+ base units, shown in this measure's unit.
  let inOwnUnit(total: Float) -> This = Measure { canonical: total, value: total / this.unit.factor, unit: this.unit }

  private do
    # Divides a canonical value by a unit factor. The conversion is exact in
    # principle (0.000005 W is 5 μW), but neither number is exactly
    # representable in binary, so the quotient can land an ulp or two off
    # (5.000000000000001). Round back to 15 significant digits, comfortably
    # inside a double's ~15.95, so converted measures read the way they were
    # written.
    let scaledValue(canonical: Float, factor: Float) -> Float do
      let raw: Float = canonical / factor
      return raw if raw == 0.0
      # Scaling past the exponent range would overflow to infinity; nothing
      # that extreme is a meaningful measurement anyway.
      return raw if Math.abs(raw) < 1.0e-300 || Math.abs(raw) > 1.0e300
      # Both powers of ten come from `pow` rather than one being the other's
      # reciprocal, which would reintroduce the rounding this removes.
      let exponent = 14 - Math.floor(Math.log10(Math.abs(raw)))
      let scale = Math.pow(10.0, exponent)
      let inverse = Math.pow(10.0, 0 - exponent)
      return (raw / inverse).round / scale
    end

    let scaledMeasureBase(unit: UnitDefinition) -> UnitDefinition do
      let (factor, symbol) = match unit.dimension do
        :time => (1.0, "s")
        :data => (1.0, "B")
        :length => (1.0, "m")
        :mass => (0.001, "g")
        :volume => (0.001, "L")
        :temperature => (1.0, "K")
        :force => (1.0, "N")
        :energy => (1.0, "J")
        :power => (1.0, "W")
        :voltage => (1.0, "V")
        :current => (1.0, "A")
        :resistance => (1.0, "Ω")
        :charge => (1.0, "C")
        _ => (unit.conversionFactor, unit.notation)
      end
      return UnitDefinition {
        conversionFactor: factor, dimension: unit.dimension, notation: symbol
      }
    end

    let scaledMeasureFamily(base: UnitDefinition, binary: Bool) -> [UnitDefinition] do
      if base.dimension == :time
        return [
          (0.000000001, "ns"), (0.000001, "μs"), (0.001, "ms"),
          (1.0, "s"), (60.0, "min"), (3600.0, "h"),
          (86400.0, "d"), (604800.0, "wk")
        ].map do |factor, symbol|
          UnitDefinition {
            conversionFactor: factor, dimension: :time, notation: symbol
          }
        end
      end
      if base.dimension == :data
        let radix = binary then 1024.0 else 1000.0
        let symbols = binary then ["B", "KiB", "MiB", "GiB", "TiB"] else
          ["B", "KB", "MB", "GB", "TB"]
        return (0..4).map do |power|
          UnitDefinition {
            conversionFactor: Math.pow(radix, power),
            dimension: :data,
            notation: symbols[power].or("")
          }
        end
      end
      if ![:length, :mass, :volume, :temperature, :force, :energy,
           :power, :voltage, :current, :resistance, :charge]
            .contains?(base.dimension)
        return [base]
      end
      return [
        (0.000000001, "n"), (0.000001, "μ"), (0.001, "m"),
        (1.0, ""), (1000.0, "k"), (1000000.0, "M"), (1000000000.0, "G")
      ].map do |factor, prefix|
        UnitDefinition {
          conversionFactor: base.conversionFactor * factor,
          dimension: base.dimension,
          notation: "${prefix}${base.notation}"
        }
      end
    end
  end
end

# Powers of a length that have a dimension: +3.meter ^ 2+ is an area and
# +2.meter ^ 3+ a volume, the exponent literal choosing which. Other powers
# go through +pow+ in +Units.Dynamic+, which checks them at run time.
make Measure<Quantity.Length> do
  # Returns the length squared, the same as +squared+.
  #
  # @example
  #   (3.meter ^ 2).to(String)   # => Just("9.0 m^2")
  let ^(2) -> Measure<Quantity.Area> = this.squared

  # Returns the length cubed, the same as +cubed+.
  #
  # @example
  #   (2.meter ^ 3).canonical   # => 8.0
  let ^(3) -> Measure<Quantity.Volume> = this.cubed

  # Returns the length squared, which is an area.
  #
  # @return [Measure<Quantity.Area>] the area, displayed as the unit squared
  #
  # @example
  #   3.meter.squared.to(String)   # => Just("9.0 m^2")
  let squared -> Measure<Quantity.Area> = Measure {
    canonical: @canonical * @canonical,
    value: @value * @value,
    unit: this.raisedUnit(2, :area)
  }

  # Returns the length cubed, which is a volume and converts to litres.
  #
  # @return [Measure<Quantity.Volume>] the volume, displayed as the unit cubed
  #
  # @example
  #   2.meter.cubed.canonical   # => 8.0
  let cubed -> Measure<Quantity.Volume> = Measure {
    canonical: @canonical * @canonical * @canonical,
    value: @value * @value * @value,
    unit: this.raisedUnit(3, :volume)
  }
end

# Equality and ordering of measures by quantity: +1.minute == 60.second+ and
# +1.kilometer == 1000.meter+, whatever units each was written in.
#
# Measures of different dimensions are never equal, and ordering them, as in
# +1.second < 1.meter+, is a type error. A measure whose dimension is only
# known at run time, made by unit arithmetic, is compared by its base-unit
# value alone.
make Measure<D>, implement: Comparable do
  # Returns +true+ when +other+ is the same quantity of the same dimension.
  #
  # @param other [Measure] the measure to compare with
  # @return [Bool] +true+ when both measure the same amount of the same thing
  #
  # @example
  #   1.minute == 60.second   # => true
  #   1.hour == 59.minute     # => false
  == :> Measure<D> -> Bool
  let ==(other) do
    return this.unit.kind == other.unit.kind && this.canonical == other.canonical
  end

  # Compares this quantity with +other+, a measure of the same dimension.
  #
  # @param other [Measure] a measure of the same dimension
  # @return [Ordering] +Less+, +Equal+ or +Greater+
  #
  # @example
  #   90.second.compare(1.minute)   # => Greater
  #   1.minute < 1.hour             # => true
  compare :> Measure<D> -> Ordering
  let compare(other) = this.canonical.compare(other.canonical)

  # The ordering operators of +Comparable+, typed to take only a measure of
  # the same dimension.
  < :> Measure<D> -> Bool
  let <(other) = this.compare(other) == Less
  > :> Measure<D> -> Bool
  let >(other) = this.compare(other) == Greater
  <= :> Measure<D> -> Bool
  let <=(other) = this.compare(other) != Greater
  >= :> Measure<D> -> Bool
  let >=(other) = this.compare(other) != Less
end

# The time units under the +Units+ name. They are also in the prelude.
#
# +Units.Hour+ and +Hour+ are the same constructor: they match the same
# patterns and compare equal. The qualified name makes the unit family
# explicit.
#
#   90.minute.to(String, in: Units.Hour)   # => Just("1.5 h")
module Units do
  let Nanosecond = Nanosecond
  let Microsecond = Microsecond
  let Millisecond = Millisecond
  let Second = Second
  let Minute = Minute
  let Hour = Hour
  let Day = Day
  let Week = Week
end
