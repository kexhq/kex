# Numbers that carry a unit.
#
# Writing +5.second+ or +90.minute+ gives you a +Measure+: a number, the unit it
# was written in, and the same quantity in that dimension's base unit. Adding,
# subtracting and converting all go through the canonical value, so the
# arithmetic is right regardless of which units the operands were written in,
# and mixing dimensions is an +Error+ rather than a silently wrong number.
#
#   5.second.to(String)                     # => Just("5.0 s")
#   1.5.hour.to(String)                  # => Just("1.5 h")
#   (1.hour + 30.minute).map(~to(String))  # => Ok("1.5 h")
#   90.minute.convert(Hour)              # => Ok(1.5 h)
#
# The time units (+nanosecond+ through +week+) are in the prelude. Other
# dimensions live in opt-in modules under +Units+, and every one of them
# measures against the same machinery here.
#
# A +Measure+ is a measurement, not an elapsed span: +5.second+ describes a
# quantity, while +Duration+ is what +Time+ and +Date+ use for a span between
# two moments.

# The trait a unit implements: how it converts to its dimension's base unit,
# which dimension that is, and how it is written.
trait Unit do
  # How many base units one of this unit is: +60.0+ for a minute, whose base
  # unit is the second.
  #
  # @return [Float] the conversion factor
  #
  # @example
  #   Minute.factor   # => 60.0
  factor :> Float

  # Which dimension this unit measures, as an atom. Only measures of the same
  # kind can be added or converted between.
  #
  # @return [Atom] the dimension tag
  #
  # @example
  #   Second.kind   # => :time
  kind :> Atom

  # How this unit is written when a measure is displayed.
  #
  # @return [String] the unit's symbol
  #
  # @example
  #   Minute.symbol   # => "min"
  symbol :> String
end

# The dimension a measure belongs to.
#
# @param measure [Measure] the measure to inspect
# @return [Atom] the dimension tag
#
# @example
#   measureKind(5.second)   # => :time
let measureKind(measure: Measure) -> Atom = measure.unit.dimension

# The symbol a measure displays with.
#
# @param measure [Measure] the measure to inspect
# @return [String] the unit's symbol
#
# @example
#   measureSymbol(5.minute)   # => "min"
let measureSymbol(measure: Measure) -> String = measure.unit.notation

# The conversion factor of a measure's unit.
#
# @param measure [Measure] the measure to inspect
# @return [Float] the conversion factor
#
# @example
#   measureFactor(5.minute)   # => 60.0
let measureFactor(measure: Measure) -> Float = measure.unit.conversionFactor

# A unit described at run time rather than by a constructor.
#
# Runtime-defined units are used for prefixes and units derived by arithmetic:
# +s^2+ from squaring a duration, a kilo- prefix applied to a base unit.
record UnitDefinition do
  # How many base units one of this unit is.
  conversionFactor : Float

  # Which dimension this unit measures.
  dimension : Atom

  # How the unit is written.
  notation : String
end

make UnitDefinition, implement: Unit do
  # How many base units one of this unit is.
  #
  # @return [Float] the conversion factor
  let factor = @conversionFactor

  # Which dimension this unit measures.
  #
  # @return [Atom] the dimension tag
  let kind = @dimension

  # How the unit is written.
  #
  # @return [String] the unit's symbol
  let symbol = @notation
end

# A quantity with a unit.
#
# A Measure is shared by every unit module. `canonical` stores the value in
# that dimension's base unit; its Unit controls its display. That split is what
# makes +1.hour + 30.minute+ correct and still print in hours.
record Measure do
  # The quantity in the dimension's base unit: seconds, for time. Arithmetic
  # and conversion go through this.
  canonical : Float

  # The quantity as written, in this measure's own unit.
  value : Float

  # The unit this measure displays in.
  unit : UnitDefinition
end

# An elapsed span of time, in seconds.
#
# Duration is an elapsed span used by Time, Date, and DateTime. A time Measure
# is deliberately not a Duration: `5.second` describes a measurement.
record Duration do
  # The length of the span, in seconds.
  seconds : Float
end

# The time units, from nanoseconds to weeks. The base unit is the second.
type TimeUnit = Nanosecond | Microsecond | Millisecond
              | Second | Minute | Hour | Day | Week

make TimeUnit, implement: Unit do
  let factor(@Nanosecond) = 0.000000001
  let factor(@Microsecond) = 0.000001
  let factor(@Millisecond) = 0.001
  let factor(@Second) = 1.0
  let factor(@Minute) = 60.0
  let factor(@Hour) = 3600.0
  let factor(@Day) = 86400.0
  let factor(@Week) = 604800.0

  let kind = :time

  let symbol(@Nanosecond) = "ns"
  let symbol(@Microsecond) = "μs"
  let symbol(@Millisecond) = "ms"
  let symbol(@Second) = "s"
  let symbol(@Minute) = "min"
  let symbol(@Hour) = "h"
  let symbol(@Day) = "d"
  let symbol(@Week) = "wk"
end

# Time-unit constructors on +Integer+: +5.second+, +90.minute+, +2.week+.
#
# Each answers a +Measure+ whose display unit is the one you named, so
# +90.minute+ prints as minutes even though it is stored as 5400 seconds.
make Integer do
  # This many nanoseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in nanoseconds
  #
  # @example
  #   100.nanosecond.to(String)   # => Just("100.0 ns")
  let nanosecond -> Measure = this.timeMeasure(Nanosecond)

  # This many microseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in microseconds
  #
  # @example
  #   250.microsecond.to(String)   # => Just("250.0 μs")
  let microsecond -> Measure = this.timeMeasure(Microsecond)

  # This many milliseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in milliseconds
  #
  # @example
  #   500.millisecond.to(String)   # => Just("500.0 ms")
  let millisecond -> Measure = this.timeMeasure(Millisecond)

  # This many seconds, as a +Measure+. Seconds are the base unit of time, so
  # this is the one everything else converts through.
  #
  # @return [Measure] the quantity, displayed in seconds
  #
  # @example
  #   5.second.to(String)   # => Just("5.0 s")
  let second -> Measure = this.timeMeasure(Second)

  # This many minutes, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in minutes
  #
  # @example
  #   90.minute.convert(Hour)   # => Ok(1.5 h)
  let minute -> Measure = this.timeMeasure(Minute)

  # This many hours, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in hours
  #
  # @example
  #   (1.hour + 30.minute).map { |m| m.showValue }   # => Ok("1.5 h")
  let hour -> Measure = this.timeMeasure(Hour)

  # This many days, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in days
  #
  # @example
  #   1.day.convertTo(Hour).map { |m| m.showValue }   # => Ok("24.0 h")
  let day -> Measure = this.timeMeasure(Day)

  # This many weeks, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in weeks
  #
  # @example
  #   2.week.to(String)   # => Just("2.0 wk")
  let week -> Measure = this.timeMeasure(Week)

  private do
    let timeMeasure(unit: TimeUnit) -> Measure do
      let value = Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0)
      return Measure {
        canonical: value * unit.factor,
        value: value,
        unit: UnitDefinition {
          conversionFactor: unit.factor,
          dimension: unit.kind,
          notation: unit.symbol
        }
      }
    end
  end
end

# The same time-unit constructors on +Float+, for fractional quantities:
# +1.5.hour+, +0.25.second+.
make Float do
  # This many nanoseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in nanoseconds
  let nanosecond -> Measure = this.timeMeasure(Nanosecond)

  # This many microseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in microseconds
  let microsecond -> Measure = this.timeMeasure(Microsecond)

  # This many milliseconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in milliseconds
  #
  # @example
  #   2.5.millisecond.to(String)   # => Just("2.5 ms")
  let millisecond -> Measure = this.timeMeasure(Millisecond)

  # This many seconds, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in seconds
  #
  # @example
  #   0.25.second.to(String)   # => Just("0.25 s")
  let second -> Measure = this.timeMeasure(Second)

  # This many minutes, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in minutes
  let minute -> Measure = this.timeMeasure(Minute)

  # This many hours, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in hours
  #
  # @example
  #   1.5.hour.to(String)   # => Just("1.5 h")
  let hour -> Measure = this.timeMeasure(Hour)

  # This many days, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in days
  let day -> Measure = this.timeMeasure(Day)

  # This many weeks, as a +Measure+.
  #
  # @return [Measure] the quantity, displayed in weeks
  let week -> Measure = this.timeMeasure(Week)

  private do
    let timeMeasure(unit: TimeUnit) -> Measure = Measure {
      canonical: this * unit.factor,
      value: this,
      unit: UnitDefinition {
        conversionFactor: unit.factor,
        dimension: unit.kind,
        notation: unit.symbol
      }
    }
  end
end

make Measure, implement: Showable do
  let factor -> Float = this.unit.factor
  let kind -> Atom = this.unit.kind
  let symbol -> String = this.unit.symbol
  # Renders the measure in its own unit.
  #
  # @param String [Type] the target type
  # @return [String?] the rendered measure
  #
  # @example
  #   90.second.to(String)   # => Just("90.0 s")
  let to(String) -> String? = Just(this.showValue)

  # Renders the measure in its own unit, its value written by a digit
  # pattern (see +Number.format+).
  #
  # @param String [Type] the target type
  # @param format [NumberFormat] how to write the value
  # @return [String?] the rendered measure, or +None+ for a pattern that is
  #   not valid
  #
  # @example
  #   28.second.to(String, Number.format`#`)         # => Just("28 s")
  #   1.second.to(String, Number.format`#.##`)       # => Just("1 s")
  #   1.125.second.to(String, Number.format`#.00`)   # => Just("1.13 s")
  let to(String, format: NumberFormat) -> String? do
    return @value.to(String, format).map { |text| "${text} ${@unit.notation}" }
  end

  # Renders the measure in another time unit: +convertTo+, then +to(String)+.
  #
  # Every unit module supplies the same call for its own units, so a measure
  # is displayed in a named unit the same way whatever it measures:
  # +in: Kilo(Meter)+ with +Units.SI+, +in: MiB+ with +Units.Data+.
  #
  # Answers +None+ when the measure is not a time.
  #
  # @param String [Type] the target type
  # @param in [TimeUnit] the unit to display in
  # @return [String?] the rendered measure, or +None+
  #
  # @example
  #   90.minute.to(String, in: Hour)   # => Just("1.5 h")
  #   1.5.hour.to(String, in: Minute)  # => Just("90.0 min")
  let to(String, in: TimeUnit) -> String? do
    match this.convertTo(in) do
      Ok(converted) => return converted.to(String)
      Error(_) => return None
    end
  end

  # Renders the measure in another time unit, its value written by a digit
  # pattern (see +Number.format+).
  #
  # @example
  #   100.minute.to(String, in: Hour, format: Number.format`#.00`)   # => Just("1.67 h")
  #   90.minute.to(String, in: Hour, format: Number.format`#.###`)   # => Just("1.5 h")
  let to(String, in: TimeUnit, format: NumberFormat) -> String? do
    match this.convertTo(in) do
      Ok(converted) => return converted.to(String, format)
      Error(_) => return None
    end
  end

  # Chooses the largest unit whose absolute value is at least one.
  # Time uses nanoseconds through weeks; data uses bytes through terabytes
  # (+binary: true+ selects KiB through TiB). SI dimensions use decimal
  # prefixes. Zero uses the family's base unit; smaller values use its
  # smallest unit. Other dimensions keep their current unit.
  #
  # @example
  #   90.second.scaled.to(String, Number.format`#.#`)   # => Just("1.5 min")
  let scaled -> Measure = this.scaled(false)

  # As +scaled+, using binary scales for data when +binary+ is true.
  let scaled(binary: Bool) -> Measure do
    let base = scaledMeasureBase(@unit)
    let family = scaledMeasureFamily(base, binary)
    let magnitude = Math.abs(@canonical)
    let selected = magnitude == 0.0 then base else
      family.filter { |unit| unit.conversionFactor <= magnitude }
        .last.or(family.first.try)
    return Measure {
      canonical: @canonical,
      value: scaledValue(@canonical, selected.conversionFactor),
      unit: selected
    }
  end

  # Renders the measure as its value and unit, so +IO.printLine+ and
  # interpolation show +5.0 W+ rather than the record's fields. Inspecting
  # it (the REPL's echo, +inspected+) still shows the record itself.
  #
  # @return [String] the value and the unit's symbol
  #
  # @example
  #   "drawn: ${1.volt * 5.ampere}"   # => "drawn: 5.0 W"
  let showValue -> String = "${this.value} ${this.unit.symbol}"

  # Multiplies the measure by a plain number, keeping its unit.
  #
  # The unit is unchanged, so this scales a quantity rather than converting
  # it: three of a two-second interval is six seconds.
  #
  # @param multiplier [Number] the factor to multiply by
  # @return [Measure] the scaled measure
  #
  # @example
  #   2.second.scale(3).to(String)     # => Just("6.0 s")
  #   1.hour.scale(0.5).to(String)  # => Just("0.5 h")
  let scale(multiplier: Number) -> Measure do
    let converted = Kex.Intrinsic.Fun.convertTo(multiplier, Float).or(0.0)
    return Measure {
      canonical: this.canonical * converted,
      value: this.value * converted,
      unit: this.unit
    }
  end

  # Raises the measure to a power, recording the derived unit in its notation.
  #
  # Raising a measure preserves its display unit while applying the power to
  # its canonical value, display value, and conversion factor. The current
  # Unit trait represents a dimension as one Atom, so the dimension remains
  # the base kind; the notation records the derived unit (for example `s^2`).
  #
  # @param exponent [Number] the power to raise to
  # @return [Measure] the raised measure
  #
  # @example
  #   (2.second ^ 2).to(String)   # => Just("4.0 s^2")
  let ^(exponent: Number) -> Measure do
    return Measure {
      canonical: Kex.Intrinsic.Math.pow(this.canonical, exponent),
      value: Kex.Intrinsic.Math.pow(this.value, exponent),
      unit: UnitDefinition {
        conversionFactor: Kex.Intrinsic.Math.pow(this.factor, exponent),
        dimension: this.kind,
        notation: "${this.symbol}^${exponent}"
      }
    }
  end

  # Converts the measure to another unit of the same dimension.
  #
  # Answers +Error+ when the dimensions differ: you cannot express seconds in
  # bytes, and this says so rather than producing a wrong number.
  #
  # Units from opt-in modules such as +Units.SI+ and +Units.Data+ can be used
  # here too, provided their dimension matches.
  #
  # @param unit [Unit] the unit to convert to
  # @return [Result<Measure, String>] the converted measure, or why it could not be
  #
  # @example
  #   1.day.convertTo(Hour).map { |m| m.showValue }     # => Ok("24.0 h")
  #   90.minute.convertTo(Hour).map { |m| m.showValue } # => Ok("1.5 h")
  let convertTo(unit: Unit) -> Result<Measure, String> do
    let target = UnitDefinition {
      conversionFactor: unit.factor,
      dimension: unit.kind,
      notation: unit.symbol
    }
    match this.unit.kind == target.kind do
      true => return Ok(Measure {
        canonical: this.canonical,
        value: scaledValue(this.canonical, target.factor),
        unit: target
      })
      false => return Error("Cannot convert between different measurement kinds")
    end
  end

  # Converts the measure to another time unit. The short spelling of
  # +convertTo+, kept for prelude time measures.
  #
  # @param unit [TimeUnit] the time unit to convert to
  # @return [Result<Measure, String>] the converted measure, or why it could not be
  #
  # @example
  #   90.minute.convert(Hour).map { |m| m.showValue }   # => Ok("1.5 h")
  let convert(unit: TimeUnit) -> Result<Measure, String> do
    return this.convertTo(unit)
  end

  # Adds two measures of the same dimension.
  #
  # The units need not match: the sum goes through the canonical values, and
  # comes back displayed in the LEFT operand's unit. Adding measures of
  # different dimensions is an +Error+.
  #
  # @param other [Measure] the measure to add
  # @return [Result<Measure, String>] the sum, or why they could not be added
  #
  # @example
  #   (1.hour + 30.minute).map { |m| m.showValue }   # => Ok("1.5 h")
  #   (30.minute + 1.hour).map { |m| m.showValue }   # => Ok("90.0 min")
  let +(other: Measure) -> Result<Measure, String> do
    match this.unit.kind == other.unit.kind do
      true => do
        let total = this.canonical + other.canonical
        return Ok(Measure {
          canonical: total,
          value: total / this.unit.factor,
          unit: this.unit
        })
      end
      false => return Error("Cannot add measures of different kinds")
    end
  end

  # Subtracts a measure of the same dimension.
  #
  # Like +++, the result is displayed in the left operand's unit, and mixing
  # dimensions is an +Error+.
  #
  # @param other [Measure] the measure to subtract
  # @return [Result<Measure, String>] the difference, or why they could not be subtracted
  #
  # @example
  #   (1.hour - 30.minute).map { |m| m.showValue }   # => Ok("0.5 h")
  let -(other: Measure) -> Result<Measure, String> do
    match this.unit.kind == other.unit.kind do
      true => do
        let total = this.canonical - other.canonical
        return Ok(Measure {
          canonical: total,
          value: total / this.unit.factor,
          unit: this.unit
        })
      end
      false => return Error("Cannot subtract measures of different kinds")
    end
  end

  private do
    # Divides a canonical value by a unit factor. The conversion is exact in
    # principle (0.000005 W is 5 μW), but neither number is exactly
    # representable in binary, so the quotient can land an ulp or two off
    # (5.000000000000001). Round back to 15 significant digits, comfortably
    # inside a double's ~15.95, so converted measures read the way they were
    # written. The annotation says Number because `Integer / Float` infers
    # Integer; the result is always a Float.
    let scaledValue(canonical: Float, factor: Float) -> Number do
      let raw: Float = canonical / factor
      return raw if raw == 0.0
      # Scaling past the exponent range would overflow to infinity; nothing
      # that extreme is a meaningful measurement anyway.
      return raw if Math.abs(raw) < 1.0e-300 || Math.abs(raw) > 1.0e300
      # Both powers of ten come from `pow` rather than one being the other's
      # reciprocal, which would reintroduce the rounding this removes.
      let exponent = 14 - Math.floor(Math.log10(Math.abs(raw)))
      let scale = Math.pow(10.0, exponent)
      let inverse = Math.pow(10.0, 0 - exponent)
      return (raw / inverse).round / scale
    end

    let scaledMeasureBase(unit: UnitDefinition) -> UnitDefinition do
      let (factor, symbol) = match unit.dimension do
        :time => (1.0, "s")
        :data => (1.0, "B")
        :length => (1.0, "m")
        :mass => (0.001, "g")
        :volume => (0.001, "L")
        :temperature => (1.0, "K")
        :force => (1.0, "N")
        :energy => (1.0, "J")
        :power => (1.0, "W")
        :voltage => (1.0, "V")
        :current => (1.0, "A")
        :resistance => (1.0, "Ω")
        :charge => (1.0, "C")
        _ => (unit.conversionFactor, unit.notation)
      end
      return UnitDefinition {
        conversionFactor: factor, dimension: unit.dimension, notation: symbol
      }
    end

    let scaledMeasureFamily(base: UnitDefinition, binary: Bool) -> [UnitDefinition] do
      if base.dimension == :time
        return [
          (0.000000001, "ns"), (0.000001, "μs"), (0.001, "ms"),
          (1.0, "s"), (60.0, "min"), (3600.0, "h"),
          (86400.0, "d"), (604800.0, "wk")
        ].map do |entry|
          let (factor, symbol) = entry
          UnitDefinition {
            conversionFactor: factor, dimension: :time, notation: symbol
          }
        end
      end
      if base.dimension == :data
        let radix = binary then 1024.0 else 1000.0
        let symbols = binary then ["B", "KiB", "MiB", "GiB", "TiB"] else
          ["B", "KB", "MB", "GB", "TB"]
        return (0..4).map do |power|
          UnitDefinition {
            conversionFactor: Math.pow(radix, power),
            dimension: :data,
            notation: symbols[power].try
          }
        end
      end
      if ![:length, :mass, :volume, :temperature, :force, :energy,
           :power, :voltage, :current, :resistance, :charge]
            .contains?(base.dimension)
        return [base]
      end
      return [
        (0.000000001, "n"), (0.000001, "μ"), (0.001, "m"),
        (1.0, ""), (1000.0, "k"), (1000000.0, "M"), (1000000000.0, "G")
      ].map do |entry|
        let (factor, prefix) = entry
        UnitDefinition {
          conversionFactor: base.conversionFactor * factor,
          dimension: base.dimension,
          notation: "${prefix}${base.notation}"
        }
      end
    end
  end
end

# Time-unit constructors, also available directly from the prelude.
#
# +Units.Hour+ and +Hour+ name the same constructor: they match the same
# patterns and compare equal. Use the qualified spelling to make the unit
# family explicit.
#
#   90.minute.convert(Units.Hour)   # => Ok(1.5 h)
module Units do
  let Nanosecond = Nanosecond
  let Microsecond = Microsecond
  let Millisecond = Millisecond
  let Second = Second
  let Minute = Minute
  let Hour = Hour
  let Day = Day
  let Week = Week
end
