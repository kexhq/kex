# Cryptographic content digests.
#
# A digest of a +String+ is returned as a lowercase hex string, so a Kex
# program never has to handle backend-specific binary values: it compares
# with +==+, prints directly, and goes into a map key unchanged. A digest of a
# +Binary+ is the raw digest bytes, as a +Binary+.
#
#   Digest.sha256("hello")
#   # => "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
#
# SHA-256 is a content fingerprint: use it to tell whether two things are the
# same, to key a cache, or to check that a download arrived intact. It is not
# a password hash: a purpose-built password KDF is what that needs.
module Digest do
  # Returns the SHA-256 digest of +content+, as a 64-character lowercase hex
  # string.
  #
  # @param content [String] the text to hash
  # @return [String] the hex digest
  #
  # @example
  #   Digest.sha256("hello")
  #   # => "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
  #   Digest.sha256("")
  #   # => "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  #
  # @example A cache key derived from an input
  #   let key = Digest.sha256(source).take(12)
  #
  # @example Detecting that content changed
  #   Digest.sha256(newText) != Digest.sha256(oldText)
  sha256 : String -> String
  let sha256(content) = Kex.Intrinsic.Digest.sha256(content)

  # Computes the SHA-256 digest of raw bytes, as the 32 digest bytes.
  #
  # @param content [Binary] the bytes to digest
  # @return [Binary] the 32-byte digest
  #
  # @example
  #   Digest.sha256(Binary.fromBytes([104, 105])).length   # => 32
  sha256 : Binary -> Binary
  let sha256(content) = Kex.Intrinsic.Digest.sha256(content)

  # Returns the SHA-256 digest of the file at +path+, or +ReadFailed+ when the
  # file cannot be read.
  #
  # Reads the file for you, so a large file does not have to be pulled into a
  # +String+ first.
  #
  # @param path [String] the file to hash
  # @return [Result<String, ReadError>] the hex digest, or +ReadFailed+
  #
  # @example
  #   Digest.fileSha256("archive.tar.gz")   # => Ok("a3f1...")
  #   Digest.fileSha256("nowhere")          # => Error(ReadFailed)
  #
  # @example Verifying a download against a published checksum
  #   Digest.fileSha256(path).map { |actual| actual == expected }.or(false)
  fileSha256 : String -> Result<String, ReadError>
  let fileSha256(path) do
    match Kex.Intrinsic.Digest.fileSha256(path) do
      Just(digest) => return Ok(digest)
      None => return Error(ReadFailed)
    end
  end
end
