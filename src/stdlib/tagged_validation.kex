# Diagnostics that compile-time validators return for tagged literals.
#
# A tagged literal (`` re`\d+` ``, `` sql`SELECT ...` ``) can be checked when
# the program is compiled. The compiler looks the checker up by name: tag
# +foo+ is checked by a function +validateFoo+ that takes the literal's text
# and returns a list of +Issue+ values. An empty list means the literal is
# fine.
#
#   let validateHex(source: String) -> [TaggedValidation.Issue] do
#     match source.chars.findIndex { |c| !c.digit? && !c.in?('a'..'f') } do
#       Just(offset) => [TaggedValidation.fatalAt(offset, "not a hex digit")]
#       None         => []
#     end
#   end
#
# A +Fatal+ issue fails the build with its message and puts the caret at its
# offset. A +Warn+ issue is reported and the build goes on.
#
# Offsets count bytes from zero, from the start of the literal body after
# escapes are processed.
module TaggedValidation

# Where in the literal an issue applies: one offset, or a range.
#
# Both count bytes into the literal body from zero.
type ByteSpan = At(Integer) | Between(Integer, Integer)

# One diagnostic about a tagged literal.
#
# +Fatal+ fails the build and +Warn+ is reported while the build goes on. An
# issue about the whole literal has +None+ for its span.
type Issue = Fatal(ByteSpan?, String)
  | Warn(ByteSpan?, String)

# Returns a fatal issue about the whole literal, with no position.
#
# @param message [String] what is wrong
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.fatal("an empty pattern matches nothing")
fatal : String -> Issue
let fatal(message) = Fatal(None, message)

# Returns a fatal issue at one offset in the literal.
#
# The compiler's error puts its caret at +offset+, so pass the position your
# checker reported.
#
# @param offset [Integer] the zero-based byte offset in the literal body
# @param message [String] what is wrong
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.fatalAt(3, "missing closing parenthesis")
#
# @example Reporting what a checker found
#   match checkPattern(source) do
#     Just((offset, message)) => [TaggedValidation.fatalAt(offset, message)]
#     None                    => []
#   end
fatalAt : Integer -> String -> Issue
let fatalAt(offset, message) = Fatal(Just(At(offset)), message)

# Returns a fatal issue covering a range of the literal.
#
# @param start [Integer] the first byte offset of the span
# @param finish [Integer] the offset just past its end
# @param message [String] what is wrong
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.fatalBetween(0, 4, "this group can never match")
fatalBetween : Integer -> Integer -> String -> Issue
let fatalBetween(start, finish, message) do
  Fatal(Just(Between(start, finish)), message)
end

# Returns a warning about the whole literal. The build goes on.
#
# @param message [String] what is questionable
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.warn("this pattern is very slow on long inputs")
warn : String -> Issue
let warn(message) = Warn(None, message)

# Returns a warning at one offset in the literal.
#
# @param offset [Integer] the zero-based byte offset in the literal body
# @param message [String] what is questionable
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.warnAt(7, "redundant escape")
warnAt : Integer -> String -> Issue
let warnAt(offset, message) = Warn(Just(At(offset)), message)

# Returns a warning covering a range of the literal.
#
# @param start [Integer] the first byte offset of the span
# @param finish [Integer] the offset just past its end
# @param message [String] what is questionable
# @return [Issue] the diagnostic
#
# @example
#   TaggedValidation.warnBetween(2, 6, "this alternation is always taken")
warnBetween : Integer -> Integer -> String -> Issue
let warnBetween(start, finish, message) do
  Warn(Just(Between(start, finish)), message)
end
