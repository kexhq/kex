# JSON parsing and serialization.
#
# Opt-in — nothing here is in scope until `using JSON`.
#
#   using JSON
#
#   main do
#     match JSON.parse(source) do
#       Ok(value) => IO.printLine(value)
#       Error(e)  => IO.printError("bad JSON: ${e}")
#     end
#   end
#
# Parsed JSON arrives as ordinary Kex values: an object becomes a +Map+ with
# atom keys, an array becomes a +List+, +null+ becomes +None+, and numbers
# become +Integer+ or +Float+ as written. Going the other way, +stringify+
# accepts those same values and always emits strict JSON.
#
#   JSON.parse("{\"a\": 1}")           # => Ok({ a: 1 })
#   JSON.stringify({ name: "Ada" })    # => "{\"name\":\"Ada\"}"
#
# Comments are accepted only when requested. Stringification always emits
# strict JSON.
using Parsing

module JSON do

# Why a document could not be parsed. Every variant carries the position in
# the input where the parser stopped, so a caller can point at the problem.
#
#   JSON.parse("[1, 2")    # => Error(UnexpectedEnd(5))
#   JSON.parse("// c\n1")  # => Error(UnexpectedCharacter("/", 0))
type Error
  = UnexpectedCharacter(String, Integer)
  | UnexpectedEnd(Integer)
  | InvalidLiteral(String, Integer)
  | InvalidNumber(String, Integer)
  | InvalidEscape(String, Integer)
  | InvalidUnicodeEscape(String, Integer)
  | UnterminatedComment(Integer)
  | TrailingInput(Integer)
  | UnknownOption(Atom)

# Parses a JSON document, strictly.
#
# The whole text must be one JSON value with nothing after it — trailing input
# is +TrailingInput+, not a silently ignored tail. Objects come back as maps
# with atom keys, arrays as lists, +null+ as +None+.
#
# @param text [String] the JSON document
# @return [Result<Any, Error>] the parsed value, or why it failed
#
# @example
#   JSON.parse("{\"a\": 1, \"b\": [true, null, 2.5]}")
#   # => Ok({ a: 1, b: [true, None, 2.5] })
#   JSON.parse("[1, 2")   # => Error(UnexpectedEnd(5))
#
# @example Reading a config file
#   match JSON.parse(FS.File.read("config.json").or("")) do
#     Ok(config) => IO.printLine(config)
#     Error(e)   => IO.printError("config.json is not valid JSON: ${e}")
#   end
parse : String -> Result<Any, Error>
let parse(text: String) -> Result<Any, Error> = parseWithOptions(text, {})

# Parses a JSON document with parsing options.
#
# The one option today is +allowComments+, which accepts +//+ and +/* */+
# comments — the JSONC dialect config files often use. It is off by default,
# so strict JSON stays strict unless you ask otherwise. An unrecognised option
# is +UnknownOption+, not a silent no-op.
#
# @param text [String] the JSON document
# @param options [{Atom: Bool}] parsing options, e.g. +{ allowComments: true }+
# @return [Result<Any, Error>] the parsed value, or why it failed
#
# @example Accepting comments
#   JSON.parse("// a note\n1", options: { allowComments: true })   # => Ok(1)
#   JSON.parse("// a note\n1")   # => Error(UnexpectedCharacter("/", 0))
#
# @example Reading a JSONC config
#   JSON.parse(text, options: { allowComments: true })
parse : String -> {Atom: Bool} -> Result<Any, Error>
let parse(text: String, options: {Atom: Bool}) -> Result<Any, Error> = parseWithOptions(text, options)

private do
  # Camel-case atom literals are represented by map-field syntax today.
  # Derive the key from that syntax so the compiler has no JSON-specific
  # constant or option-name special case. The one-field map has exactly one
  # key, so the single-element pattern is what unwraps it — `at(0)` would
  # answer `Just(key)`, and there is no atom literal to `or` it with.
  let allowCommentsKey = match Kex.Intrinsic.Map.keys({ allowComments: false }) do
    [key] => key
  end

  let parseWithOptions(text: String, options: {Atom: Bool}) -> Result<Any, Error> do
    let optionError = validateOptions(options)
    if optionError != None
      let Just(error) = optionError
      return Error(error)
    end

    let allowComments = Kex.Intrinsic.Map.getWithDefault(options, allowCommentsKey(), false)
    let cursor = skipIgnored(Input { input: text }, allowComments).try
    let (value, afterValue) = parseValue(cursor, allowComments).try
    let rest = skipIgnored(afterValue, allowComments).try
    return Error(TrailingInput(rest.pos)) if !rest.atEnd?
    return Ok(value)
  end
end

# Renders a Kex value as strict JSON text.
#
# Maps become objects, lists become arrays, +None+ becomes +null+, and strings
# are escaped. A map written with atom keys — the usual Kex spelling — renders
# with those names as strings, so +{ name: "Ada" }+ becomes +{"name":"Ada"}+.
# Object keys come out in canonical key order.
#
# Anything the encoder does not recognise renders as +null+ rather than
# failing, so this never raises.
#
# @param value [Any] the value to render
# @return [String] the JSON text
#
# @example
#   JSON.stringify({ name: "Ada", n: 1, ok: true })
#   # => '{"n":1,"name":"Ada","ok":true}'
#   JSON.stringify([1, 2, 3])
#   # => '[1,2,3]'
#
# @example Writing a JSON file
#   FS.File.write("out.json", JSON.stringify(report))
#
# @example A round trip
#   JSON.parse(JSON.stringify({ a: 1 }))   # => Ok({ a: 1 })
stringify : Any -> String
let stringify(value: Any) -> String do
  match Kex.Intrinsic.Kex.kind(value) do
    :none => return "null"
    :bool => return value then "true" else "false"
    :integer => return "${value}"
    :float => return "${value}"
    :string => return encodeString(value)
    :list => return "[${value.map(~stringify).join(",")}]"
    :map => do
      let fields = Kex.Intrinsic.Map.entries(value).map do |entry|
        let (key, item) = entry
        "${encodeString(objectKey(key))}:${stringify(item)}"
      end
      return "{${fields.join(",")}}"
    end
    _ => return "null"
  end
end

private do
  # A JSON object key is a string, but a Kex map literal is written with ATOM
  # keys (`{ n: 1 }`) — the shape most values being stringified actually have.
  # Rendering one gives `:n`, so drop the leading colon; anything else goes
  # through its ordinary text form.
  let objectKey(key: Any) -> String do
    if Kex.Intrinsic.Kex.kind(key) == :string then return key end
    let text = "${key}"
    return text.startsWith?(":") then text.drop(1) else text
  end

  let validateOptions(options: {Atom: Bool}) -> Error? do
    match Kex.Intrinsic.Map.keys(options).find { |key| key != allowCommentsKey() } do
      Just(key) => return Just(UnknownOption(key))
      None => return None
    end
  end

  let skipIgnored(cursor: Input, allowComments: Bool) -> Result<Input, Error> do
    var current = skipWhitespace(cursor)
    loop do
      return Ok(current) if !allowComments || current.peek != Just('/')
      if current.peekAt(1) == Just('/')
        current = current.advanceBy(2)
        while !current.atEnd? && current.peek != Just('\n') do
          current = current.advance
        end
        current = skipWhitespace(current)
      else
        if current.peekAt(1) == Just('*')
          let commentStart = current.pos
          current = current.advanceBy(2)
          loop do
            return Error(UnterminatedComment(commentStart)) if current.atEnd?
            if current.peek == Just('*') && current.peekAt(1) == Just('/')
              current = skipWhitespace(current.advanceBy(2))
              break
            end
            current = current.advance
          end
        else
          return Ok(current)
        end
      end
    end
  end

  let skipWhitespace(cursor: Input) -> Input do
    var current = cursor
    loop do
      break if current.peek != Just(' ') && current.peek != Just('\t') && current.peek != Just('\n') && current.peek != Just('\r')
      current = current.advance
    end
    return current
  end

  let parseValue(cursor: Input, allowComments: Bool) -> Result<(Any, Input), Error> do
    let current = skipIgnored(cursor, allowComments).try
    match current.peek do
      None => return Error(UnexpectedEnd(current.pos))
      Just('n') => return parseLiteral(current, "null", None)
      Just('t') => return parseLiteral(current, "true", true)
      Just('f') => return parseLiteral(current, "false", false)
      Just('"') => return parseString(current)
      Just('[') => return parseArray(current, allowComments)
      Just('{') => return parseObject(current, allowComments)
      Just('-') => return parseNumber(current)
      Just(c) when c.digit? => return parseNumber(current)
      Just(c) => return Error(UnexpectedCharacter("${c}", current.pos))
    end
  end

  let parseLiteral(cursor: Input, literal: String, value: Any) -> Result<(Any, Input), Error> do
    var current = cursor
    var index = 0
    while index < literal.count do
      # Both sides are `Char?`, and `index < literal.count` keeps the right
      # one a `Just`, so a spent cursor's `None` never compares equal.
      return Error(InvalidLiteral(literal, cursor.pos)) if current.peek != literal.at(index)
      current = current.advance
      index = index + 1
    end
    return Ok((value, current))
  end

  let parseString(cursor: Input) -> Result<(Any, Input), Error> do
    let (value, advanced) = parseStringText(cursor).try
    return Ok((value, advanced))
  end

  let parseStringText(cursor: Input) -> Result<(String, Input), Error> do
    var current = cursor.advance
    var pieces: [String] = []
    loop do
      match current.peek do
        None => return Error(UnexpectedEnd(current.pos))
        Just('"') => return Ok((pieces.join(""), current.advance))
        Just('\\') => do
          let (piece, advanced) = parseEscape(current).try
          pieces.push!(piece)
          current = advanced
        end
        Just(c) when c.codepoint < 32 => return Error(UnexpectedCharacter("${c}", current.pos))
        Just(c) => do
          pieces.push!("${c}")
          current = current.advance
        end
      end
    end
  end

  let parseEscape(cursor: Input) -> Result<(String, Input), Error> do
    let escaped = cursor.advance
    match escaped.peek do
      None => return Error(UnexpectedEnd(escaped.pos))
      Just('"') => return Ok(("\"", escaped.advance))
      Just('\\') => return Ok(("\\", escaped.advance))
      Just('/') => return Ok(("/", escaped.advance))
      Just('b') => return Ok((String.fromCodepoint(8).or(""), escaped.advance))
      Just('f') => return Ok((String.fromCodepoint(12).or(""), escaped.advance))
      Just('n') => return Ok(("\n", escaped.advance))
      Just('r') => return Ok(("\r", escaped.advance))
      Just('t') => return Ok(("\t", escaped.advance))
      Just('u') => return parseUnicodeEscape(escaped.advance, cursor.pos)
      Just(c) => return Error(InvalidEscape("${c}", cursor.pos))
    end
  end

  let parseUnicodeEscape(cursor: Input, escapePosition: Integer) -> Result<(String, Input), Error> do
    let (first, afterFirst) = parseHexQuad(cursor, escapePosition).try
    var codepoint = first
    var advanced = afterFirst

    if first >= 55296 && first <= 56319
      return Error(InvalidUnicodeEscape("missing low surrogate", escapePosition)) if advanced.peek != Just('\\') || advanced.peekAt(1) != Just('u')
      let (second, afterSecond) = parseHexQuad(advanced.advanceBy(2), advanced.pos).try
      return Error(InvalidUnicodeEscape("invalid low surrogate", advanced.pos)) if second < 56320 || second > 57343
      codepoint = 65536 + (first - 55296) * 1024 + second - 56320
      advanced = afterSecond
    else
      if first >= 56320 && first <= 57343
        return Error(InvalidUnicodeEscape("unexpected low surrogate", escapePosition))
      end
    end

    match String.fromCodepoint(codepoint) do
      Just(value) => return Ok((value, advanced))
      None => return Error(InvalidUnicodeEscape("invalid codepoint", escapePosition))
    end
  end

  let parseHexQuad(cursor: Input, escapePosition: Integer) -> Result<(Integer, Input), Error> do
    var current = cursor
    var value = 0
    var count = 0
    while count < 4 do
      match current.peek do
        Just(c) => do
          match hexValue(c) do
            Just(digit) => value = value * 16 + digit
            None => return Error(InvalidUnicodeEscape("${c}", escapePosition))
          end
          current = current.advance
        end
        None => return Error(UnexpectedEnd(current.pos))
      end
      count = count + 1
    end
    return Ok((value, current))
  end

  let hexValue(c: Char) -> Integer? do
    return Just(c.codepoint - '0'.codepoint) if c >= '0' && c <= '9'
    return Just(c.codepoint - 'a'.codepoint + 10) if c >= 'a' && c <= 'f'
    return Just(c.codepoint - 'A'.codepoint + 10) if c >= 'A' && c <= 'F'
    return None
  end

  let parseArray(cursor: Input, allowComments: Bool) -> Result<(Any, Input), Error> do
    var current = skipIgnored(cursor.advance, allowComments).try
    var values: [Any] = []
    return Ok((values, current.advance)) if current.peek == Just(']')
    loop do
      let (value, afterValue) = parseValue(current, allowComments).try
      values.push!(value)
      current = skipIgnored(afterValue, allowComments).try
      match current.peek do
        Just(']') => return Ok((values, current.advance))
        Just(',') => do
          current = skipIgnored(current.advance, allowComments).try
          return Error(UnexpectedCharacter("]", current.pos)) if current.peek == Just(']')
        end
        None => return Error(UnexpectedEnd(current.pos))
        Just(c) => return Error(UnexpectedCharacter("${c}", current.pos))
      end
    end
  end

  let parseObject(cursor: Input, allowComments: Bool) -> Result<(Any, Input), Error> do
    var current = skipIgnored(cursor.advance, allowComments).try
    var values: {String: Any} = {}
    return Ok((values, current.advance)) if current.peek == Just('}')
    loop do
      return Error(UnexpectedCharacter("expected object key", current.pos)) if current.peek != Just('"')
      let (key, afterKey) = parseStringText(current).try
      current = skipIgnored(afterKey, allowComments).try
      return Error(UnexpectedCharacter("expected :", current.pos)) if current.peek != Just(':')
      current = skipIgnored(current.advance, allowComments).try
      let (value, afterValue) = parseValue(current, allowComments).try
      values = Kex.Intrinsic.Map.put(values, key, value)
      current = skipIgnored(afterValue, allowComments).try
      match current.peek do
        Just('}') => return Ok((values, current.advance))
        Just(',') => do
          current = skipIgnored(current.advance, allowComments).try
          return Error(UnexpectedCharacter("}", current.pos)) if current.peek == Just('}')
        end
        None => return Error(UnexpectedEnd(current.pos))
        Just(c) => return Error(UnexpectedCharacter("${c}", current.pos))
      end
    end
  end

  let parseNumber(cursor: Input) -> Result<(Any, Input), Error> do
    let start = cursor.pos
    var current = cursor
    var chars: [Char] = []
    if current.peek == Just('-')
      chars.push!('-')
      current = current.advance
    end

    match current.peek do
      Just('0') => do
        chars.push!('0')
        current = current.advance
        if current.peek != None
          let Just(digitAfterZero) = current.peek
          return Error(InvalidNumber("${chars.join("")}${digitAfterZero}", start)) if digitAfterZero.digit?
        end
      end
      Just(c) when c >= '1' && c <= '9' => do
        while match current.peek do Just(d) => d.digit? _ => false end do
          let Just(integerDigit) = current.peek
          chars.push!(integerDigit)
          current = current.advance
        end
      end
      _ => return Error(InvalidNumber(chars.join(""), start))
    end

    var floating = false
    if current.peek == Just('.')
      floating = true
      chars.push!('.')
      current = current.advance
      return Error(InvalidNumber(chars.join(""), start)) if match current.peek do Just(d) => !d.digit? _ => true end
      while match current.peek do Just(d) => d.digit? _ => false end do
        let Just(fractionDigit) = current.peek
        chars.push!(fractionDigit)
        current = current.advance
      end
    end

    if current.peek == Just('e') || current.peek == Just('E')
      floating = true
      let Just(exponent) = current.peek
      chars.push!(exponent)
      current = current.advance
      if current.peek == Just('+') || current.peek == Just('-')
        let Just(sign) = current.peek
        chars.push!(sign)
        current = current.advance
      end
      return Error(InvalidNumber(chars.join(""), start)) if match current.peek do Just(d) => !d.digit? _ => true end
      while match current.peek do Just(d) => d.digit? _ => false end do
        let Just(exponentDigit) = current.peek
        chars.push!(exponentDigit)
        current = current.advance
      end
    end

    let source = chars.join("")
    if floating
      match Float.parse(source) do
        Ok(value) => return Ok((value, current))
        Error(_) => return Error(InvalidNumber(source, start))
      end
    end
    match Integer.parse(source) do
      Ok(value) => return Ok((value, current))
      Error(_) => return Error(InvalidNumber(source, start))
    end
  end

  let encodeString(value: String) -> String do
    var pieces: [String] = ["\""]
    var index = 0
    while index < value.count do
      match value.at(index) do
        Just('"') => pieces.push!("\\\"")
        Just('\\') => pieces.push!("\\\\")
        Just(c) when c.codepoint == 8 => pieces.push!("\\b")
        Just(c) when c.codepoint == 12 => pieces.push!("\\f")
        Just('\n') => pieces.push!("\\n")
        Just('\r') => pieces.push!("\\r")
        Just('\t') => pieces.push!("\\t")
        Just(c) when c.codepoint < 32 => pieces.push!("\\u${hex4(c.codepoint)}")
        Just(c) => pieces.push!("${c}")
        None => pieces.push!("")
      end
      index = index + 1
    end
    pieces.push!("\"")
    return pieces.join("")
  end

  # A codepoint as the four lowercase hex digits a `\uXXXX` escape needs.
  # JSON's only escape that is not a single character, and there is no hex
  # formatter in the prelude to borrow.
  let hex4(value: Integer) -> String do
    let digits = "0123456789abcdef"
    return [4096, 256, 16, 1].map { |place| digits.get((value / place).modulo(16), '0') }.join("")
  end
end

end
