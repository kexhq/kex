# Types whose values can be asked whether they count as true.
#
# Only +false+ and +None+ are falsy. Every other value is truthy, including
# +0+, +""+ and +[]+. +if+ and +while+ take only a +Bool+, so call +truthy?+
# or +falsy?+ to apply this rule; +Assert.truthy+ uses it too.
#
#   0.truthy?       # => true
#   "".truthy?      # => true
#   [].truthy?      # => true
#   None.truthy?    # => false
#   false.truthy?   # => false
#
# To ask whether a value is empty, use +Blankable+'s +blank?+ and
# +present?+.
trait Truthyable do
  # Returns +true+ unless the value is +false+ or +None+.
  #
  # @return [Bool] +true+ unless the value is +false+ or +None+
  #
  # @example
  #   1.truthy?        # => true
  #   None.truthy?     # => false
  truthy? :> Bool

  # Returns +true+ for +false+ and +None+, the opposite of +truthy?+.
  #
  # @return [Bool] +true+ for +false+ and +None+
  #
  # @example
  #   None.falsy?    # => true
  #   0.falsy?       # => false
  #
  # @example Reacting to a lookup that found nothing
  #   if config.get(:host).falsy?
  #     IO.printError("host is not configured")
  #   end
  let falsy? = !this.truthy?
end

make Bool, implement: Truthyable do
  # Returns the boolean itself.
  #
  # @return [Bool] the value
  #
  # @example
  #   true.truthy?    # => true
  #   false.truthy?   # => false
  truthy? :> Bool
  let truthy? = this

  # Returns the negation of this boolean, the same as +!flag+.
  #
  # It reads better than +!+ at the end of a chain.
  #
  # @return [Bool] +false+ for +true+, and +true+ for +false+
  #
  # @example
  #   true.not    # => false
  #   false.not   # => true
  #
  # @example At the end of a chain
  #   book.borrowed?.not
  not :> Bool
  let not = !this
end

make Integer, implement: Truthyable do
  # Always returns +true+, including for zero. Write +count == 0+ when zero
  # matters.
  #
  # @return [Bool] always +true+
  #
  # @example
  #   0.truthy?    # => true
  #   42.truthy?   # => true
  truthy? :> Bool
  let truthy?(@_) = true
end

make Float, implement: Truthyable do
  # Always returns +true+, including for zero.
  #
  # @return [Bool] always +true+
  #
  # @example
  #   0.0.truthy?   # => true
  truthy? :> Bool
  let truthy?(@_) = true
end

make String, implement: Truthyable do
  # Always returns +true+, including for the empty string. Use +blank?+ to
  # treat an empty or whitespace-only string as nothing.
  #
  # @return [Bool] always +true+
  #
  # @example
  #   "".truthy?   # => true
  #   "".blank?    # => true
  truthy? :> Bool
  let truthy?(@_) = true
end

make Optional<X>, implement: Truthyable do
  # Returns +true+ for a +Just+, even +Just(false)+, and +false+ for +None+.
  #
  # @return [Bool] +true+ when a value is present
  #
  # @example
  #   Just(0).truthy?    # => true
  #   None.truthy?       # => false
  truthy? :> Bool
  let truthy?(@None) = false
  let truthy?(@Just(_)) = true
end

make [X], implement: Truthyable do
  # Always returns +true+, including for the empty list. Use +empty?+ or
  # +blank?+ to test for an empty list.
  #
  # @return [Bool] always +true+
  #
  # @example
  #   [].truthy?   # => true
  #   [].blank?    # => true
  truthy? :> Bool
  let truthy?(@_) = true
end

make Map<K,V>, implement: Truthyable do
  # Always returns +true+, including for the empty map.
  #
  # @return [Bool] always +true+
  #
  # @example
  #   {}.truthy?   # => true
  #   {}.blank?    # => true
  truthy? :> Bool
  let truthy?(@_) = true
end
