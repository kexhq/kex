# Atoms are named values such as +:ok+, +:error+, and +:reset+. Use them
# for labels, statuses, and message tags. Atoms with the same name are equal;
# an atom and a string are different values.
#
#   :ok == :ok                    # => true
#   :ok == :error                 # => false
#   :ok.string                    # => "ok"
#
# Write atoms with a leading colon. Node names can include +@+; use quotes for names containing spaces or punctuation:
#
#   :app@localhost
#   :"app@host.example.com"
#   :"two words"
#
# To convert text to an atom:
#
#   "hello".as(Atom)     # converts a string literal at compile time
#   Atom.from("hello")  # creates or finds an atom at run time
#   "hello".to(Atom)    # finds an existing atom: Just(:hello), or None
#
# On the BEAM, atoms are never freed. Use +text.to(Atom)+ for external input
# to avoid creating an unbounded number of atoms.
module Atom do
  # Returns the atom whose name is +text+.
  #
  # On the BEAM atoms are never freed, and a node holds at most about a
  # million. Build atoms from a bounded set of names — node names, config
  # keys — never from untrusted input; +text.to(Atom)+ is the safe form for
  # that, since it only finds atoms that already exist.
  #
  # @param text [String] the atom's name
  # @return [Atom] the atom
  #
  # @example
  #   Atom.from("ok") == :ok                # => true
  #   Atom.from("app@${host}")              # => :"app@myhost"
  from : String -> Atom
  let from(text) = Kex.Intrinsic.Atom.from(text)
end

make Atom do
  # Returns the atom's name as a string, without the leading colon.
  #
  # @return [String] the name
  #
  # @example
  #   :ok.string                    # => "ok"
  #   :"b@host.example.com".string  # => "b@host.example.com"
  string :> String
  let string = Kex.Intrinsic.Atom.name(this)

  # Returns the atom's name as text, like +string+, through the universal
  # conversion. The name, not the displayed form: +:ok+ converts to +"ok"+,
  # not +":ok"+, so +text.to(Atom)+ and this are inverses.
  #
  # @return [String?] the name, always +Just+
  #
  # @example
  #   :hello.to(String)                       # => Just("hello")
  #   "hello".to(Atom).flatMap { |a| a.to(String) }   # => Just("hello")
  let to(String) = Just(this.string)
end
