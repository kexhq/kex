# An ordered, immutable sequence, written [1, 2, 3].
#
# Lists are the default collection in Kex. Every operation answers with a new
# list rather than changing the receiver, so a chain of transformations is
# safe to read from either end.
#
#   let scores = [7, 2, 9, 4]
#   scores.filter { |n| n > 3 }      # => [7, 9, 4]
#   scores.sort                      # => [2, 4, 7, 9]
#   scores.map { |n| n * 10 }.sum    # => 220
#
# Anything that might not be there: the first element, an element at an
# index, a search result: answers with an +Optional+, so an empty list is an
# ordinary case rather than a crash:
#
#   [].first.or(0)        # => 0
#   [1, 2].at(9).or(0)    # => 0
#
# A list is +Enumerable+ and +Foldable+, which is where +map+, +filter+,
# +find+, +all?+ and +reduce+ come from.
#
# @example Building a report line by line
#   users
#     .filter { |u| u.active? }
#     .map { |u| "${u.name} <${u.email}>" }
#     .join("\n")
type List<X> = [X]

make [Number] do
  # Sums all elements. Returns +0+ for an empty list.
  #
  # @return [Number]
  #
  # @example
  #   [1, 2, 3].sum   # => 6
  #   [].sum          # => 0
  sum :> Number
  let sum = Kex.Intrinsic.List.sum(this)

  # Multiplies all elements. Returns +1+ for an empty list.
  #
  # @return [Number]
  #
  # @example
  #   [1, 2, 3].product   # => 6
  #   [].product          # => 1
  product :> Number
  let product = Kex.Intrinsic.List.product(this)
end

make [[Y]] do
  # Flattens exactly one level of nesting.
  #
  # @return [[Y]]
  #
  # @example
  #   [[1, 2], [3, 4]].flatten   # => [1, 2, 3, 4]
  flatten :> [Y]
  let flatten = Kex.Intrinsic.List.flatten(this)
end

make [X], implement: Enumerable, Foldable do
  # Returns the first element wrapped in +Just+, or +None+ if the list is empty.
  #
  # @return [X?]
  #
  # @example
  #   [1, 2, 3].first   # => Just(1)
  #   [].first          # => None
  first :> X?
  let first = Kex.Intrinsic.List.first(this)

  # Returns the second element wrapped in +Just+, or +None+ if the list has
  # fewer than two elements.
  #
  # @return [X?]
  #
  # @example
  #   [1, 2, 3].second   # => Just(2)
  #   [1].second         # => None
  second :> X?
  let second = Kex.Intrinsic.List.first(Kex.Intrinsic.List.drop(this, 1))

  # Returns the third element wrapped in +Just+, or +None+ if the list has
  # fewer than three elements.
  #
  # @return [X?]
  #
  # @example
  #   [1, 2, 3].third   # => Just(3)
  #   [1, 2].third      # => None
  third :> X?
  let third = Kex.Intrinsic.List.first(Kex.Intrinsic.List.drop(this, 2))

  # Returns all elements after the first. Returns +[]+ for an empty or
  # single-element list.
  #
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3].rest   # => [2, 3]
  #   [1].rest         # => []
  #   [].rest          # => []
  rest :> [X]
  let rest = Kex.Intrinsic.List.drop(this, 1)

  # Returns the last element wrapped in +Just+, or +None+ if the list is empty.
  #
  # @return [X?]
  #
  # @example
  #   [1, 2, 3].last   # => Just(3)
  #   [].last          # => None
  last :> X?
  let last = Kex.Intrinsic.List.last(this)

  # Returns the number of elements.
  # When given a predicate, returns the count of elements for which it holds.
  #
  # @return [Integer]
  #
  # @example
  #   [1, 2, 3].count              # => 3
  #   [1, 2, 3, 4].count(~even?)   # => 2
  count :> Integer
  let count = Kex.Intrinsic.List.length(this)

  # Returns the number of elements. The same as +count+, under the name
  # +String+ uses.
  #
  # @return [Integer] the number of elements
  #
  # @example
  #   [1, 2, 3].length   # => 3
  length :> Integer
  let length = Kex.Intrinsic.List.length(this)

  # Returns how many elements satisfy +pred+.
  #
  # @param pred [X -> Bool] the test applied to each element
  # @return [Integer] the number of matches
  #
  # @example
  #   [1, 2, 3, 4].count(~even?)              # => 2
  #   ["a", "", "b"].count { |s| s.empty? }   # => 1
  # count(pred) is provided by the Enumerable trait.
  count :> (X -> Bool) -> Integer

  # Returns +true+ if the list contains no elements.
  #
  # @return [Bool]
  #
  # @example
  #   [].empty?      # => true
  #   [1, 2].empty?  # => false
  empty? :> Bool
  let empty?(@[]) = true
  let empty?(@[_|_]) = false

  # Returns the first element satisfying the predicate wrapped in +Just+,
  # or +None+ if no element matches.
  #
  # @param pred [X -> Bool]
  # @return [X?]
  #
  # @example
  #   [1, 2, 3].find { |x| x > 1 }   # => Just(2)
  #   [1, 2, 3].find { |x| x > 9 }   # => None
  # find/any?/all? are provided by the Enumerable trait.
  find :> (X -> Bool) -> X?

  # Returns +true+ if at least one element satisfies the predicate.
  #
  # @param pred [X -> Bool]
  # @return [Bool]
  #
  # @example
  #   [1, 2, 3].any? { |x| x > 2 }   # => true
  #   [1, 2, 3].any? { |x| x > 9 }   # => false
  any? :> (X -> Bool) -> Bool

  # Returns +true+ if every element satisfies the predicate.
  #
  # @param pred [X -> Bool]
  # @return [Bool]
  #
  # @example
  #   [1, 2, 3].all? { |x| x > 0 }   # => true
  #   [1, 2, 3].all? { |x| x > 1 }   # => false
  all? :> (X -> Bool) -> Bool

  # Transforms each element by applying +f+.
  #
  # @param f [X -> Y]
  # @return [[Y]]
  #
  # @example
  #   [1, 2, 3].map { |x| x * 2 }   # => [2, 4, 6]
  # map/filter/each are provided by the Enumerable trait (in terms of reduce).
  map :> (X -> Y) -> [Y]

  # Returns a new list containing only the elements for which +pred+ is +true+.
  #
  # @param pred [X -> Bool]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3, 4].filter { |x| x.even? }   # => [2, 4]
  filter :> (X -> Bool) -> [X]

  # Returns a new list with all elements for which +pred+ is +true+ removed.
  # The inverse of +filter+.
  #
  # @param pred [X -> Bool]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3, 4].reject { |x| x.even? }   # => [1, 3]
  reject :> (X -> Bool) -> [X]

  # Calls +f+ with each element for its side effects. Returns unit.
  #
  # @param f [X -> Void]
  # @return [Void]
  #
  # @example
  #   [1, 2, 3].each { |x| IO.printLine(x) }
  each :> (X -> Void) -> Void

  # Folds the list from the left, starting with +acc+ and combining each
  # element via +f+.
  #
  # @param acc [A]     initial accumulator value
  # @param f   [A -> X -> A]
  # @return [A]
  #
  # @example
  #   [1, 2, 3].reduce(0) { |acc, x| acc + x }   # => 6
  #   [1, 2, 3].reduce(1) { |acc, x| acc * x }   # => 6
  reduce :> A -> (A -> X -> A) -> A
  let reduce(acc, f) = Kex.Intrinsic.List.foldLeft(this, acc, f)

  let map(f) = Kex.Intrinsic.List.map(this, f)
  let filter(pred) = Kex.Intrinsic.List.filter(this, pred)
  let each(f) = Kex.Intrinsic.List.each(this, f)
  let find(pred) = Kex.Intrinsic.List.find(this, pred)
  let flatMap(f) = Kex.Intrinsic.List.flatMap(this, f)
  let reject(pred) = Kex.Intrinsic.List.reject(this, pred)
  let all?(pred) = Kex.Intrinsic.List.all?(this, pred)
  let any?(pred) = Kex.Intrinsic.List.any?(this, pred)
  let count(pred) = Kex.Intrinsic.List.count(this, pred)

  # Returns the element at position +i+ (0-based) wrapped in +Just+,
  # or +None+ if the index is out of range.
  #
  # @param i [Integer]
  # @return [X?]
  #
  # @example
  #   [10, 20, 30].at(1)   # => Just(20)
  #   [10, 20, 30].at(9)    # => None
  #   [10, 20, 30].at(-1)   # => Just(30)
  at :> Integer -> X?
  let at(i) = Kex.Intrinsic.List.at(this, i < 0 then this.count + i else i)

  # Returns the element at position +i+ (0-based), or +None+ when the index is
  # out of range. The same as +at+ (+get+ also accepts a +Range+, which
  # answers a sublist instead).
  #
  # @param i [Integer] the 0-based index
  # @return [X?] the element, or +None+
  #
  # @example
  #   [10, 20, 30].get(1)   # => Just(20)
  #   [10, 20, 30].get(9)    # => None
  #   [10, 20, 30].get(-1)   # => Just(30)
  get :> Integer -> X?
  let get(i: Integer) = Kex.Intrinsic.List.get(this, i < 0 then this.count + i else i)

  # Returns the element at position +i+ (0-based), or +default+ when the index
  # is out of range. The total form of +get+: the value comes back unwrapped.
  #
  # @param i [Integer] the 0-based index
  # @param default [X] the value to use when out of range
  # @return [X] the element, or +default+
  #
  # @example
  #   [10, 20, 30].get(1, 0)   # => 20
  #   [10, 20, 30].get(9, 0)   # => 0
  #
  # @example Reading positional arguments with defaults
  #   let host = args.get(0, "localhost")
  #   let port = args.get(1, "8080")
  get :> Integer -> X -> X
  let get(i, default) = Kex.Intrinsic.List.get(this, i < 0 then this.count + i else i, default)

  # Returns the sublist addressed by +range+, both ends included. The same
  # as +slice+ over a range, and what the +xs[1..2]+ bracket spelling calls.
  #
  # @param range [Range<Integer>] the inclusive 0-based index range
  # @return [[X]] the elements in that range
  #
  # @example
  #   [1, 2, 3, 4].get(1..2)   # => [2, 3]
  #   [1, 2, 3, 4][1..2]       # => [2, 3]
  #
  # @example Paging through results
  #   page.items[(page.n - 1) * 10..page.n * 10 - 1]
  get :> Range<Integer> -> [X]
  let get(range: Range<Integer>) = this.slice(range)

  # Returns +true+ if +elem+ is present in the list.
  #
  # @param elem [X]
  # @return [Bool]
  #
  # @example
  #   [1, 2, 3].contains?(2)   # => true
  #   [1, 2, 3].contains?(9)   # => false
  contains? :> X -> Bool
  let contains?(elem) = Kex.Intrinsic.List.member(elem, this)

  # Returns +true+ if the first index at which +elem+ appears, wrapped in
  # +Just+, or +None+ if the element is not present.
  #
  # @param elem [X]
  # @return [Integer?]
  #
  # @example
  #   [10, 20, 30].indexOf(20)   # => Just(1)
  #   [10, 20, 30].indexOf(99)   # => None
  indexOf :> X -> Integer?
  let indexOf(elem) = Kex.Intrinsic.List.indexOf(this, elem)

  # Returns the index of the first element satisfying +pred+, wrapped in
  # +Just+, or +None+ if none does. The predicate counterpart of +indexOf+,
  # which searches by value.
  #
  # @param pred [(X) -> Bool]
  # @return [Integer?]
  #
  # @example
  #   [10, 25, 30].findIndex { |n| n > 20 }   # => Just(1)
  #   [10, 25, 30].findIndex { |n| n > 99 }   # => None
  findIndex :> ((X) -> Bool) -> Integer?
  let findIndex(pred) do
    let before = this.takeWhile { |x| !pred(x) }
    return None if before.count == this.count

    return Just(before.count)
  end

  # Returns the longest leading run of elements satisfying +pred+. Stops at the
  # first element that does not, so it is not +filter+: later matches are
  # dropped with everything after the first failure.
  #
  # @param pred [(X) -> Bool]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 9, 1].takeWhile { |n| n < 5 }   # => [1, 2]
  takeWhile :> ((X) -> Bool) -> [X]
  let takeWhile(@[], _) = []
  let takeWhile(@[x | xs], pred) do
    return pred(x) then [x | xs.takeWhile(pred)] else []
  end

  # Returns what is left after +takeWhile+: everything from the first element
  # that does not satisfy +pred+ onwards.
  #
  # @param pred [(X) -> Bool]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 9, 1].dropWhile { |n| n < 5 }   # => [9, 1]
  dropWhile :> ((X) -> Bool) -> [X]
  let dropWhile(@[], _) = []
  let dropWhile(@[x | xs], pred) do
    return pred(x) then xs.dropWhile(pred) else [x | xs]
  end

  # Returns a new list with duplicate elements removed, preserving the
  # first occurrence of each element.
  #
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3, 2, 1].uniq   # => [1, 2, 3]
  uniq :> [X]
  let uniq = Kex.Intrinsic.List.uniq(this)

  # Splits the list into two lists: those for which +pred+ is +true+
  # (first) and those for which it is +false+ (second).
  #
  # @param pred [X -> Bool]
  # @return [([X], [X])]
  #
  # @example
  #   [1, 2, 3, 4].partition { |n| n.even? }   # => ([2, 4], [1, 3])
  partition :> (X -> Bool) -> ([X], [X])
  let partition(pred) = Kex.Intrinsic.List.partition(this, pred)

  # Maps each element to a list and concatenates the results.
  #
  # @param f [X -> [Y]]
  # @return [[Y]]
  #
  # @example
  #   [1, 2, 3].flatMap { |n| [n, n * 10] }   # => [1, 10, 2, 20, 3, 30]
  flatMap :> (X -> [Y]) -> [Y]

  # Maps each element through +f+ (which returns an +Optional+), keeping and
  # unwrapping the +Just(y)+ results and dropping +None+. Filter + map fused.
  #
  # @param f [X -> Y?]
  # @return [[Y]]
  #
  # @example
  #   [1, 2, 3, 4].collect { |n| n > 2 then Just(n * 10) else None }   # => [30, 40]
  collect :> (X -> Y?) -> [Y]

  # Returns the first +n+ elements.
  #
  # @param n [Integer]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3, 4, 5].take(3)   # => [1, 2, 3]
  take :> Integer -> [X]
  let take(n) = Kex.Intrinsic.List.take(this, n)

  # Drops the first +n+ elements.
  #
  # @param n [Integer]
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3, 4, 5].drop(2)   # => [3, 4, 5]
  drop :> Integer -> [X]
  let drop(n) = Kex.Intrinsic.List.drop(this, n)

  # Returns the sublist of +length+ elements starting at index +start+,
  # counting from 0.
  #
  # The window is clamped rather than refused, the way +take+ and +drop+
  # already behave: a start past the end answers +[]+, a length running past
  # the end stops at the end, and a negative length answers +[]+. A negative
  # start counts back from the end, as in Ruby: +-1+ is the last element, and
  # a start still before the beginning answers +[]+.
  #
  # @param start [Integer] the 0-based index of the first element
  # @param length [Integer] how many elements to keep
  # @return [[X]] the elements in that window
  #
  # @example
  #   [1, 2, 3, 4].slice(1, 2)    # => [2, 3]
  #   [1, 2, 3].slice(1, 99)      # => [2, 3]
  #   [1, 2, 3].slice(9, 2)       # => []
  #   [1, 2, 3, 4].slice(-2, 2)   # => [3, 4]
  #
  # @example Taking a page of rows
  #   rows.slice(page * 10, 10)
  slice :> Integer -> Integer -> [X]
  let slice(start, length) do
    let from = start < 0 then this.count + start else start
    return [] if from < 0 || length < 0
    this.drop(from).take(length)
  end

  # Returns the sublist addressed by +range+, both ends included.
  #
  # The bounds are clamped like the start/length form above: a range running
  # past either end is trimmed to the list, and a range whose start lies past
  # its end answers +[]+. Either end may count back from the end, as
  # Ruby's does: +1..-1+ is everything after the first.
  #
  # @param range [Range<Integer>] the inclusive 0-based index range
  # @return [[X]] the elements in that range
  #
  # @example
  #   [1, 2, 3, 4].slice(1..2)   # => [2, 3]
  #   [1, 2, 3].slice(0..2)      # => [1, 2, 3]
  #   [1, 2, 3].slice(2..0)      # => []
  #
  # @example Splitting a header off its body
  #   let body = lines.slice(1..-1)
  slice :> Range<Integer> -> [X]
  let slice(range) do
    let (lo, hi) = Kex.Intrinsic.Range.bounds(range)
    let from = lo < 0 then this.count + lo else lo
    let to = hi < 0 then this.count + hi else hi
    return [] if from < 0
    this.slice(from, to - from + 1)
  end

  # Returns a new list with +x+ appended at the end.
  #
  # @param x [X]
  # @return [[X]]
  #
  # @example
  #   [1, 2].push(3)   # => [1, 2, 3]
  push :> X -> [X]
  let push(x) = Kex.Intrinsic.List.push(this, x)

  # Returns the elements in reverse order.
  #
  # @return [[X]]
  #
  # @example
  #   [1, 2, 3].reverse   # => [3, 2, 1]
  reverse :> [X]
  let reverse = Kex.Intrinsic.List.reverse(this)

  # Pairs each element of this list with the corresponding element of +other+.
  # Stops at the end of the shorter list.
  #
  # @param other [[Y]]
  # @return [[(X, Y)]]
  #
  # @example
  #   [1, 2, 3].zip(["a", "b", "c"])   # => [(1, "a"), (2, "b"), (3, "c")]
  zip :> [Y] -> [(X, Y)]
  let zip(other) = Kex.Intrinsic.List.zip(this, other)

  # Returns the elements sorted in ascending natural order.
  #
  # @return [[X]]
  #
  # @example
  #   [3, 1, 2].sort   # => [1, 2, 3]
  sort :> [X]
  let sort = Kex.Intrinsic.List.sort(this)

  # Returns the elements sorted using a custom comparator.
  # +comp+ should return +true+ when its first argument should come before
  # its second.
  #
  # @param comp [X -> X -> Bool]
  # @return [[X]]
  #
  # @example
  #   [3, 1, 2].sort { |a, b| a > b }   # => [3, 2, 1]
  sort :> (X -> X -> Bool) -> [X]
  let sort(comp) = Kex.Intrinsic.List.sort(this, comp)

  # Returns the smallest element wrapped in +Just+, or +None+ for an empty
  # list. Elements compare in the same natural order +sort+ uses.
  #
  # @return [X?] the smallest element, or +None+
  #
  # @example
  #   [3, 1, 2].min          # => Just(1)
  #   ["pear", "fig"].min    # => Just("fig")
  #   [].min                 # => None
  min :> X?
  let min = Kex.Intrinsic.List.min(this)

  # Returns the largest element wrapped in +Just+, or +None+ for an empty
  # list. Elements compare in the same natural order +sort+ uses.
  #
  # @return [X?] the largest element, or +None+
  #
  # @example
  #   [3, 1, 2].max          # => Just(3)
  #   ["pear", "fig"].max    # => Just("pear")
  max :> X?
  let max = Kex.Intrinsic.List.max(this)

  # Maps each element through +f+ and multiplies the results.
  #
  # @param f [X -> Number]
  # @return [Number]
  #
  # @example
  #   [[1, 2], [3, 4]].product { |pair| pair.first.or(1) }   # => 3
  product :> (X -> Number) -> Number
  let product(f) = this.map(f).product
  # Returns the element with the smallest +f+ key wrapped in +Just+, or
  # +None+ for an empty list. The first of several tying elements wins.
  #
  # @param f [X -> Y] the key each element is compared by
  # @return [X?] the element with the smallest key, or +None+
  #
  # @example
  #   ["hey", "hi"].minBy { |s| s.count }   # => Just("hi")
  #   [].minBy { |s| s.count }              # => None
  minBy :> (X -> Y) -> X?
  let minBy(f) = Kex.Intrinsic.List.minBy(this, f)

  # Returns the element with the largest +f+ key wrapped in +Just+, or
  # +None+ for an empty list. The first of several tying elements wins.
  #
  # @param f [X -> Y] the key each element is compared by
  # @return [X?] the element with the largest key, or +None+
  #
  # @example
  #   ["hey", "hi"].maxBy { |s| s.count }   # => Just("hey")
  maxBy :> (X -> Y) -> X?
  let maxBy(f) = Kex.Intrinsic.List.maxBy(this, f)

  # Returns the elements sorted by the key +f+ gives each one, smallest key
  # first. The sort is stable: elements with equal keys keep their order.
  #
  # @param f [X -> Y] the key each element is sorted by
  # @return [[X]] the sorted elements
  #
  # @example
  #   ["pear", "fig", "apple"].sortBy { |s| s.count }   # => ["fig", "pear", "apple"]
  #
  # @example Newest first
  #   posts.sortBy { |p| p.published }.reverse
  sortBy :> (X -> Y) -> [X]
  let sortBy(f) = this.sort { |a, b| f(a) < f(b) }

  # Groups the elements by the key +f+ gives each one. Each group keeps its
  # elements in their original order.
  #
  # @param f [X -> K] the key each element is grouped under
  # @return [{K: [X]}] each key with the elements that produced it
  #
  # @example
  #   [1, 2, 3, 4].groupBy { |n| n.even? }   # => { false: [1, 3], true: [2, 4] }
  #
  # @example Words by their first letter
  #   words.groupBy { |w| w.first.or(' ') }
  groupBy :> (X -> K) -> {K: [X]}
  let groupBy(f) do
    let groups = this.reduce({}) do |acc, item|
      let key = f(item)
      acc.put(key, [item | acc.get(key, [])])
    end
    groups.mapValues { |items| items.reverse }
  end

  # Counts how many times each distinct element occurs.
  #
  # @return [{X: Integer}] each distinct element with its count
  #
  # @example
  #   ["a", "b", "a"].tally   # => { "a": 2, "b": 1 }
  tally :> {X: Integer}
  let tally = this.reduce({}) { |acc, item| acc.put(item, acc.get(item, 0) + 1) }

  # Splits the list into consecutive pieces of +n+ elements; the last piece
  # holds whatever is left over. Ruby calls this +each_slice+.
  #
  # @param n [Integer] the piece size, at least 1
  # @return [[[X]]] the pieces, in order; +[]+ when +n+ is less than 1
  #
  # @example
  #   [1, 2, 3, 4, 5].slices(2)   # => [[1, 2], [3, 4], [5]]
  #
  # @example Rows of a table, three cells each
  #   cells.slices(3).map { |row| row.join(" | ") }
  slices :> Integer -> [[X]]
  let slices(n) do
    return [] if n < 1 || this.empty?
    [this.take(n)] + this.drop(n).slices(n)
  end

  # Every run of +n+ consecutive elements, each overlapping the next by all
  # but one element. Ruby calls this +each_cons+.
  #
  # @param n [Integer] the window size, at least 1
  # @return [[[X]]] the windows, in order; +[]+ when the list is shorter
  #   than +n+ or +n+ is less than 1
  #
  # @example
  #   [1, 2, 3, 4].windows(2)   # => [[1, 2], [2, 3], [3, 4]]
  #
  # @example Differences between neighbours
  #   readings.windows(2).map { |w| w.get(1, 0) - w.get(0, 0) }
  windows :> Integer -> [[X]]
  let windows(n) do
    return [] if n < 1 || this.count < n
    (0..this.count - n).items.map { |i| this.slice(i, n) }
  end

  # The elements of this list that are not in +other+, in this list's order.
  # Duplicates in this list are kept unless +other+ removes them.
  #
  # @param other [[X]] the elements to leave out
  # @return [[X]] what remains
  #
  # @example
  #   [1, 2, 2, 3].difference([2])   # => [1, 3]
  difference :> [X] -> [X]
  let difference(other) = this.reject { |x| other.contains?(x) }

  # The distinct elements present in both lists, in this list's order.
  #
  # @param other [[X]] the list to intersect with
  # @return [[X]] the shared elements, each once
  #
  # @example
  #   [1, 2, 2, 3].intersect([3, 2, 5])   # => [2, 3]
  intersect :> [X] -> [X]
  let intersect(other) = this.uniq.filter { |x| other.contains?(x) }

  # The distinct elements of both lists: this list's first, then the new ones
  # from +other+.
  #
  # @param other [[X]] the list to add
  # @return [[X]] every distinct element, each once
  #
  # @example
  #   [1, 2, 2].union([2, 3])   # => [1, 2, 3]
  union :> [X] -> [X]
  let union(other) = (this + other).uniq

  # Maps each element through +f+ and sums the results.
  #
  # @param f [X -> Number]
  # @return [Number]
  #
  # @example
  #   ["hello", "hi"].sum { |s| s.count }   # => 7
  sum :> (X -> Number) -> Number
  let sum(f) = Kex.Intrinsic.List.sum(this.map(f))

  # Renders and concatenates the elements, placing +sep+ between adjacent
  # values. With no separator, the rendered values are joined directly.
  #
  # Elements do not have to be strings: each is rendered using the same
  # user-facing conversion used by interpolation and printing.
  #
  # @param sep [String] text placed between adjacent elements
  # @return [String] the concatenated rendering
  #
  # @example
  #   ["hello", "world", "kex"].join(", ")   # => "hello, world, kex"
  #   ["a", "b", "c"].join                   # => "abc"
  #   [1, 2, 3].join(" + ")                 # => "1 + 2 + 3"
  join :> String -> String
  let join(sep) = Kex.Intrinsic.List.join(this, sep)

  join :> String
  let join = Kex.Intrinsic.List.join(this)
end
