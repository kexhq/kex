# Quantities whose units are built at run time.
#
# +Measure+ (units.kex) checks dimensions at compile time. Here a unit is a
# value: a scale to its dimension's canonical unit, a +Dimension+ and a
# notation. Arithmetic checks dimensions when it runs and returns a +Result+,
# with +DimensionMismatch+ when they do not agree.
#
#   let meters = unit(1.0, Dimensions.base(Length {}), "m").try
#   let seconds = unit(1.0, Dimensions.base(Time {}), "s").try
#   let kilometers = meters.scaled(1000.0, "km").try
#   let hours = seconds.scaled(3600.0, "h").try
#   let speed = (measure(36.0, kilometers) / measure(1.0, hours)).try
#   speed.convertTo((meters / seconds).try).try.value   # => 10.0
#   speed.convertTo(meters).ok?                         # => false
module Units.Dynamic

using Dimensions, only: [Dimension]

record DynamicUnit do
  scale     : Float
  dimension : Dimension
  notation  : String
end

record DynamicMeasure do
  canonical : Float
  unit      : DynamicUnit
end

type UnitError = InvalidScale(Float)
               | ScaleOverflow
               | DimensionMismatch(Dimension, Dimension)

# Returns a unit that is +scale+ times the canonical unit of +dimension+.
#
# +scale+ must be positive and finite; otherwise the result is
# +InvalidScale+.
let unit(scale: Float, dimension: Dimension, notation: String) -> Result<DynamicUnit, UnitError> do
  return Error(InvalidScale(scale)) if !(scale > 0.0) || scale > 1.7976931348623157e308
  Ok(DynamicUnit { scale: scale, dimension: dimension, notation: notation })
end

# Returns +value+ of +unit+. The unit is kept for display, and the quantity is
# stored in the canonical unit.
let measure(value: Float, unit: DynamicUnit) -> DynamicMeasure = DynamicMeasure {
  canonical: value * unit.scale,
  unit: unit
}

make DynamicUnit do
  # Returns the product of two units. The notation keeps the grouping, as in
  # +"(m)·(s)"+. The result is +ScaleOverflow+ when the scales overflow and
  # +InvalidScale+ when they underflow.
  let *(other: DynamicUnit) -> Result<DynamicUnit, UnitError> do
    let scale = multiplyScales(@scale, other.scale).try
    unit(scale, @dimension * other.dimension,
      "(${@notation})·(${other.notation})")
  end

  let /(other: DynamicUnit) -> Result<DynamicUnit, UnitError> = unit(
    @scale / other.scale, @dimension / other.dimension,
    "(${@notation})/(${other.notation})"
  )

  let pow(exponent: Integer) -> Result<DynamicUnit, UnitError> = unit(
    Math.pow(@scale, exponent), @dimension ^ exponent,
    "(${@notation})^${exponent}"
  )

  let named(notation: String) -> DynamicUnit = DynamicUnit {
    scale: @scale, dimension: @dimension, notation: notation
  }

  let scaled(factor: Float, notation: String) -> Result<DynamicUnit, UnitError> do
    let scale = multiplyScales(@scale, factor).try
    unit(scale, @dimension, notation)
  end
end

private do
  # Float arithmetic raises on overflow, so validate before multiplying.
  let multiplyScales(left: Float, right: Float) -> Result<Float, UnitError> do
    return Error(InvalidScale(left)) if left <= 0.0
    return Error(InvalidScale(right)) if right <= 0.0
    if right > 1.0
      return Error(ScaleOverflow) if left > 1.7976931348623157e308 / right
    end
    Ok(left * right)
  end
end

make DynamicMeasure do
  # Returns the quantity's magnitude in its display unit.
  let value -> Float = @canonical / @unit.scale

  let convertTo(target: DynamicUnit) -> Result<DynamicMeasure, UnitError> do
    return Error(DimensionMismatch(@unit.dimension, target.dimension)) if @unit.dimension != target.dimension
    Ok(DynamicMeasure { canonical: @canonical, unit: target })
  end

  let +(other: DynamicMeasure) -> Result<DynamicMeasure, UnitError> do
    return Error(DimensionMismatch(@unit.dimension, other.unit.dimension)) if @unit.dimension != other.unit.dimension
    Ok(DynamicMeasure { canonical: @canonical + other.canonical, unit: @unit })
  end

  let -(other: DynamicMeasure) -> Result<DynamicMeasure, UnitError> do
    return Error(DimensionMismatch(@unit.dimension, other.unit.dimension)) if @unit.dimension != other.unit.dimension
    Ok(DynamicMeasure { canonical: @canonical - other.canonical, unit: @unit })
  end

  let *(other: DynamicMeasure) -> Result<DynamicMeasure, UnitError> do
    let composed = (@unit * other.unit).try
    Ok(DynamicMeasure { canonical: @canonical * other.canonical, unit: composed })
  end

  let /(other: DynamicMeasure) -> Result<DynamicMeasure, UnitError> do
    let composed = (@unit / other.unit).try
    Ok(DynamicMeasure { canonical: @canonical / other.canonical, unit: composed })
  end

  let pow(exponent: Integer) -> Result<DynamicMeasure, UnitError> do
    let composed = @unit.pow(exponent).try
    Ok(DynamicMeasure { canonical: Math.pow(@canonical, exponent), unit: composed })
  end

  let scale(factor: Float) -> DynamicMeasure = DynamicMeasure {
    canonical: @canonical * factor, unit: @unit
  }

  # Orders two quantities of the same dimension, whatever their display units.
  # Quantities of different dimensions give +DimensionMismatch+.
  let compareTo(other: DynamicMeasure) -> Result<Ordering, UnitError> do
    return Error(DimensionMismatch(@unit.dimension, other.unit.dimension)) if @unit.dimension != other.unit.dimension
    Ok(@canonical.compare(other.canonical))
  end

  let scalar -> Result<Float, UnitError> do
    return Error(DimensionMismatch(@unit.dimension, Dimensions.one)) if !@unit.dimension.dimensionless?
    Ok(@canonical)
  end
end
