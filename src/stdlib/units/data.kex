# Data sizes: bytes, kilobytes, and their binary counterparts.
#
# Nothing here is in scope until +using Units.Data+.
#
#   using Units.Data
#
#   main do
#     IO.printLine(1500.megabyte.to(String))              # prints: 1500.0 MB
#     IO.printLine(1500000000.byte.to(String, in: GB).or("")) # prints: 1.5 GB
#   end
#
# There are two families of units: +KB+ is 1000 bytes and +KiB+ is 1024.
# Every size is counted in bytes, so the two convert into each other:
# +1.gibibyte.convertTo(MiB)+ gives 1024 MiB.
#
# The constructors have singular names, as in +Units.SI+: +5.megabyte+,
# +2.mebibyte+. +byteSize+ is another name for +byte+.
#
# File and payload functions return plain integer byte counts. Wrap a count
# with +byte+ to convert or display it:
#
#   FS.File.size("report.pdf").map { |n| n.byte.showValue }
#   Binary.fromBytes([104, 105]).length.byte.to(String)  # => Just("2.0 B")
#   "é".bytes.count.byte.to(String)                    # => Just("2.0 B")
#
# To display a size in a particular unit, name the unit:
#
#   1048576.byte.to(String, in: MiB)                           # => Just("1.0 MiB")
#   4312.byte.to(String, in: KB, format: Number.format`#.#`)   # => Just("4.3 KB")
#   1048576.byte.convertTo(MiB).map { |m| m.showValue }        # => Ok("1.0 MiB")
#
# An integer byte count compares directly with a data size:
#
#   30000001 > 30.megabyte   # => true
#   1048576 <= 1.mebibyte    # => true
#
# +<+, +>+, +<=+ and +>=+ work with the count on either side. Comparing a
# count with a measure that is not a data size, such as a time, fails an
# assertion.
#
# Every size is a prelude +Measure+, so measure arithmetic and +to(String)+
# work on it.
module Units.Data

# The data units: decimal (+KB+, +MB+, +GB+, +TB+), binary (+KiB+, +MiB+,
# +GiB+, +TiB+), and the byte +B+. A size's +canonical+ value is in bytes.
#
#   size(1, KB).canonical    # => 1000.0
#   size(1, KiB).canonical   # => 1024.0
type DataUnit = B | KB | MB | GB | TB | KiB | MiB | GiB | TiB

make DataUnit, implement: Unit do
  let factor(@B) = 1.0
  let factor(@KB) = 1000.0
  let factor(@MB) = 1000000.0
  let factor(@GB) = 1000000000.0
  let factor(@TB) = 1000000000000.0
  let factor(@KiB) = 1024.0
  let factor(@MiB) = 1048576.0
  let factor(@GiB) = 1073741824.0
  let factor(@TiB) = 1099511627776.0

  let kind = :data

  let symbol(@B) = "B"
  let symbol(@KB) = "KB"
  let symbol(@MB) = "MB"
  let symbol(@GB) = "GB"
  let symbol(@TB) = "TB"
  let symbol(@KiB) = "KiB"
  let symbol(@MiB) = "MiB"
  let symbol(@GiB) = "GiB"
  let symbol(@TiB) = "TiB"
end

make UnitDefinition, implement: Unit do
  let factor = @conversionFactor
  let kind = @dimension
  let symbol = @notation
end

make Measure do
  let factor -> Float = @unit.factor
  let kind -> Atom = @unit.kind
  let symbol -> String = @unit.symbol
end

# Returns a size of +value+ in the given data unit.
#
# Use it when the unit is chosen at run time. When it is known in the code,
# +megabyte+, +kibibyte+ and the other named constructors read better.
#
# @param value [Number] the quantity
# @param unit [DataUnit] the unit it is counted in
# @return [Measure] the size
#
# @example
#   size(4096, B).to(String)     # => Just("4096.0 B")
#   size(1.5, MB).to(String)     # => Just("1.5 MB")
let size(value: Number, unit: DataUnit) -> Measure<Quantity.Data> do
  let converted = amount(value)
  return Measure {
    canonical: converted * unit.factor,
    value: converted,
    unit: definition(unit)
  }
end

# Converts a size to another data unit.
#
# Decimal and binary units convert into each other. A measure that is not a
# data size, such as a time, gives an +Error+.
#
# @param measure [Measure] the size to convert
# @param unit [DataUnit] the unit to convert to
# @return [Result<Measure, String>] the converted size, or why it could not be
#   converted
#
# @example
#   1.gibibyte.convertTo(MiB).map { |m| m.showValue }   # => Ok("1024.0 MiB")
#   2.gigabyte.convertTo(MB).map { |m| m.showValue }    # => Ok("2000.0 MB")
let convertTo(measure: Measure<D>, unit: DataUnit) -> Result<Measure<D>, String> do
  let target = definition(unit)
  match measure.kind == target.dimension do
    true => return Ok(Measure {
      canonical: measure.canonical,
      value: measure.canonical / target.factor,
      unit: target
    })
    false => return Error("cannot convert between different measurement kinds")
  end
end

# Adds +to(String, in:)+ for this module's units, to display a size in a
# chosen data unit.
make Measure do
  # Renders a size in the given data unit, decimal or binary.
  #
  # A measure that is not a data size gives +None+.
  #
  # @param String [Type] the target type
  # @param in [DataUnit] the unit to display in
  # @return [String?] the rendered size, or +None+
  #
  # @example
  #   1500000000.byte.to(String, in: GB)   # => Just("1.5 GB")
  #   1048576.byte.to(String, in: MiB)     # => Just("1.0 MiB")
  #   1.second.to(String, in: MB)          # => None
  let to(String, in: DataUnit) -> String? do
    match convertTo(this, in) do
      Ok(converted) => return Just(converted.showValue)
      Error(_) => return None
    end
  end

  # Renders a size in the given data unit, with the number written by a digit
  # pattern (see +Number.format+). A measure that is not a data size gives
  # +None+.
  #
  # @param String [Type] the target type
  # @param in [DataUnit] the unit to display in
  # @param format [NumberFormat] the digit pattern
  # @return [String?] the rendered size, or +None+
  #
  # @example
  #   4312.byte.to(String, in: KB, format: Number.format`#.#`)    # => Just("4.3 KB")
  #   1000.byte.to(String, in: KB, format: Number.format`#.##`)   # => Just("1 KB")
  let to(String, in: DataUnit, format: NumberFormat) -> String? do
    match convertTo(this, in) do
      Ok(converted) =>
        return converted.value.to(String, format).map { |text| "${text} ${converted.unit.notation}" }
      Error(_) => return None
    end
  end
end

# Returns a size of +value+ bytes; the same as +byte+.
#
# It is not called +bytes+ because +String.bytes+ already gives a string's
# UTF-8 encoding.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   4096.byteSize.to(String)   # => Just("4096.0 B")
#
# @example Reporting a file's size
#   FS.File.size("report.pdf").map { |n| n.byte.showValue }
let byteSize(value: Number) -> Measure<Quantity.Data> = byte(value)

# Returns a size of +value+ bytes.
#
# Use it to wrap byte counts from +FS.File.size+ or +Binary.length+.
#
# @param value [Number] the byte count
# @return [Measure] the size
#
# @example A binary payload's size
#   let payload = Binary.fromBytes([104, 105])
#   payload.length.byte.to(String)   # => Just("2.0 B")
let byte(value: Number) -> Measure<Quantity.Data> = size(value, B)
# Returns a size of +value+ kilobytes, 1000 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   5.kilobyte.to(String)   # => Just("5.0 KB")
let kilobyte(value: Number) -> Measure<Quantity.Data> = size(value, KB)
# Returns a size of +value+ megabytes, 1000000 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   1500.megabyte.to(String)   # => Just("1500.0 MB")
let megabyte(value: Number) -> Measure<Quantity.Data> = size(value, MB)
# Returns a size of +value+ gigabytes, 10^9 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   2.gigabyte.convertTo(MB).map { |m| m.showValue }   # => Ok("2000.0 MB")
let gigabyte(value: Number) -> Measure<Quantity.Data> = size(value, GB)
# Returns a size of +value+ terabytes, 10^12 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   2.terabyte.to(String)   # => Just("2.0 TB")
let terabyte(value: Number) -> Measure<Quantity.Data> = size(value, TB)
# Returns a size of +value+ kibibytes, 1024 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   1024.kibibyte.to(String)   # => Just("1024.0 KiB")
let kibibyte(value: Number) -> Measure<Quantity.Data> = size(value, KiB)
# Returns a size of +value+ mebibytes, 1024^2 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   3.mebibyte.to(String)   # => Just("3.0 MiB")
let mebibyte(value: Number) -> Measure<Quantity.Data> = size(value, MiB)
# Returns a size of +value+ gibibytes, 1024^3 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   1.gibibyte.convertTo(MiB).map { |m| m.showValue }   # => Ok("1024.0 MiB")
let gibibyte(value: Number) -> Measure<Quantity.Data> = size(value, GiB)
# Returns a size of +value+ tebibytes, 1024^4 bytes each.
#
# @param value [Number] the quantity
# @return [Measure] the size
#
# @example
#   1.tebibyte.to(String)   # => Just("1.0 TiB")
let tebibyte(value: Number) -> Measure<Quantity.Data> = size(value, TiB)

# Lets an integer byte count be compared with a data size.
#
# File and binary sizes are plain integers; with this module imported they
# compare directly against sizes such as +30.megabyte+. A measure that is not
# a data size fails an assertion.
#
# @example Rejecting an oversized file
#   FS.File.size("report.pdf").map { |count| count > 30.megabyte }
#
# @example Checking a payload
#   Binary.fromBytes([104, 105]).length < 1.kibibyte  # => true
make Integer do
  let <(other: Measure<D>) -> Bool = this < byteThreshold(other)
  let >(other: Measure<D>) -> Bool = this > byteThreshold(other)
  let <=(other: Measure<D>) -> Bool = this <= byteThreshold(other)
  let >=(other: Measure<D>) -> Bool = this >= byteThreshold(other)
end

# Lets a data size be compared with an integer byte count, the size on the
# left.
#
# @example
#   30.megabyte < 30000001   # => true
make Measure do
  let <(other: Integer) -> Bool = byteThreshold(this) < other
  let >(other: Integer) -> Bool = byteThreshold(this) > other
  let <=(other: Integer) -> Bool = byteThreshold(this) <= other
  let >=(other: Integer) -> Bool = byteThreshold(this) >= other
end

private do
  let byteThreshold(measure: Measure<D>) -> Float do
    assert(measure.kind == :data, "Byte counts require a data-size threshold")
    return measure.canonical
  end

  let amount(value) = Kex.Intrinsic.Fun.convertTo(value, Float).or(0.0)

  let definition(B) = UnitDefinition { conversionFactor: 1.0, dimension: :data, notation: "B" }
  let definition(KB) = UnitDefinition { conversionFactor: 1000.0, dimension: :data, notation: "KB" }
  let definition(MB) = UnitDefinition { conversionFactor: 1000000.0, dimension: :data, notation: "MB" }
  let definition(GB) = UnitDefinition { conversionFactor: 1000000000.0, dimension: :data, notation: "GB" }
  let definition(TB) = UnitDefinition { conversionFactor: 1000000000000.0, dimension: :data, notation: "TB" }
  let definition(KiB) = UnitDefinition { conversionFactor: 1024.0, dimension: :data, notation: "KiB" }
  let definition(MiB) = UnitDefinition { conversionFactor: 1048576.0, dimension: :data, notation: "MiB" }
  let definition(GiB) = UnitDefinition { conversionFactor: 1073741824.0, dimension: :data, notation: "GiB" }
  let definition(TiB) = UnitDefinition { conversionFactor: 1099511627776.0, dimension: :data, notation: "TiB" }
end
