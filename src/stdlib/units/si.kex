module Units.SI

let meter(value: Number) -> Measure = measure(value, 1.0, :length, :meter, "m")
let gram(value: Number) -> Measure = measure(value, 0.001, :mass, :gram, "g")
let kilogram(value: Number) -> Measure = measure(value, 1.0, :mass, :kilogram, "kg")
let kelvin(value: Number) -> Measure = measure(value, 1.0, :temperature, :kelvin, "K")
let liter(value: Number) -> Measure = measure(value, 1.0, :volume, :liter, "L")
let newton(value: Number) -> Measure = measure(value, 1.0, :force, :newton, "N")
let watt(value: Number) -> Measure = measure(value, 1.0, :power, :watt, "W")
let volt(value: Number) -> Measure = measure(value, 1.0, :voltage, :volt, "V")
let ampere(value: Number) -> Measure = measure(value, 1.0, :current, :ampere, "A")
let ohm(value: Number) -> Measure = measure(value, 1.0, :resistance, :ohm, "Ω")
let coulomb(value: Number) -> Measure = measure(value, 1.0, :charge, :coulomb, "C")

# Applies an SI decimal prefix to the displayed unit.
let kilo(measure: Measure) -> Measure = prefixed(measure, 1000.0, "k")
let mega(measure: Measure) -> Measure = prefixed(measure, 1000000.0, "M")
let giga(measure: Measure) -> Measure = prefixed(measure, 1000000000.0, "G")
let milli(measure: Measure) -> Measure = prefixed(measure, 0.001, "m")
let micro(measure: Measure) -> Measure = prefixed(measure, 0.000001, "μ")
let nano(measure: Measure) -> Measure = prefixed(measure, 0.000000001, "n")

# Named forms of Measure division and multiplication.
let per(measure: Measure, other: Measure) -> Measure = divideMeasures(measure, other)
let times(measure: Measure, other: Measure) -> Measure = multiplyMeasures(measure, other)

make Measure do
  let *(other: Measure) -> Measure = this.product(other)
  let /(other: Measure) -> Measure = this.quotient(other)

  private do
    let product(other) -> Measure do
      let kind = this.productKind(this.kind, other.kind)
      let (unit, symbol) = this.productUnit(kind, this.symbol, other.symbol)
      let value = this.canonical * other.canonical
      return Measure {
        canonical: value,
        value: value,
        factor: 1.0,
        kind: kind,
        unit: unit,
        symbol: symbol
      }
    end

    let quotient(other) -> Measure do
      let kind = this.quotientKind(this.kind, other.kind)
      let (unit, symbol) = this.quotientUnit(kind, this.symbol, other.symbol)
      let value = this.canonical / other.canonical
      return Measure {
        canonical: value,
        value: value,
        factor: 1.0,
        kind: kind,
        unit: unit,
        symbol: symbol
      }
    end

    let productKind(:mass, :acceleration) = :force
    let productKind(:force, :length) = :energy
    let productKind(:voltage, :current) = :power
    let productKind(:current, :resistance) = :voltage
    let productKind(:power, :time) = :energy
    let productKind(:current, :time) = :charge
    let productKind(left, _) = left

    let quotientKind(:length, :time) = :speed
    let quotientKind(:speed, :time) = :acceleration
    let quotientKind(:energy, :time) = :power
    let quotientKind(:force, :length) = :pressure
    let quotientKind(:voltage, :current) = :resistance
    let quotientKind(left, _) = left

    let productUnit(:force, _, _) = (:newton, "N")
    let productUnit(:energy, _, _) = (:joule, "J")
    let productUnit(:power, _, _) = (:watt, "W")
    let productUnit(:voltage, _, _) = (:volt, "V")
    let productUnit(:charge, _, _) = (:coulomb, "C")
    let productUnit(_, left, right) = (:derived, "${left}·${right}")

    let quotientUnit(:speed, left, _) = (:derived, "${left}/s")
    let quotientUnit(:acceleration, left, _) = (:derived, "${left}/s")
    let quotientUnit(:power, _, _) = (:watt, "W")
    let quotientUnit(:pressure, _, _) = (:pascal, "Pa")
    let quotientUnit(:resistance, _, _) = (:ohm, "Ω")
    let quotientUnit(_, left, right) = (:derived, "${left}/${right}")
  end
end

private do
  let amount(value) = Kex.Intrinsic.Fun.convertTo(value, Float).or(0.0)

  let measure(value, factor, kind, unit, symbol) = Measure {
    canonical: amount(value) * factor,
    value: amount(value),
    factor: factor,
    kind: kind,
    unit: unit,
    symbol: symbol
  }

  let derived(value, kind, unit, symbol) = Measure {
    canonical: value,
    value: value,
    factor: 1.0,
    kind: kind,
    unit: unit,
    symbol: symbol
  }

  let prefixed(measure, prefixFactor, prefix) = Measure {
    canonical: measure.canonical,
    value: measure.canonical / (measure.factor * prefixFactor),
    factor: measure.factor * prefixFactor,
    kind: measure.kind,
    unit: measure.unit,
    symbol: "${prefix}${measure.symbol}"
  }

  let multiplyMeasures(left, right) do
    let kind = productKind(left.kind, right.kind)
    let (unit, symbol) = productUnit(kind, left.symbol, right.symbol)
    return derived(left.canonical * right.canonical, kind, unit, symbol)
  end

  let divideMeasures(left, right) do
    let kind = quotientKind(left.kind, right.kind)
    let (unit, symbol) = quotientUnit(kind, left.symbol, right.symbol)
    return derived(left.canonical / right.canonical, kind, unit, symbol)
  end

  let productKind(:mass, :acceleration) = :force
  let productKind(:force, :length) = :energy
  let productKind(:voltage, :current) = :power
  let productKind(:current, :resistance) = :voltage
  let productKind(:power, :time) = :energy
  let productKind(:current, :time) = :charge
  let productKind(left, _) = left

  let quotientKind(:length, :time) = :speed
  let quotientKind(:speed, :time) = :acceleration
  let quotientKind(:energy, :time) = :power
  let quotientKind(:force, :length) = :pressure
  let quotientKind(:voltage, :current) = :resistance
  let quotientKind(left, _) = left

  let productUnit(:force, _, _) = (:newton, "N")
  let productUnit(:energy, _, _) = (:joule, "J")
  let productUnit(:power, _, _) = (:watt, "W")
  let productUnit(:voltage, _, _) = (:volt, "V")
  let productUnit(:charge, _, _) = (:coulomb, "C")
  let productUnit(_, left, right) = (:derived, "${left}·${right}")

  let quotientUnit(:speed, left, _) = (:derived, "${left}/s")
  let quotientUnit(:acceleration, left, _) = (:derived, "${left}/s")
  let quotientUnit(:power, _, _) = (:watt, "W")
  let quotientUnit(:pressure, _, _) = (:pascal, "Pa")
  let quotientUnit(:resistance, _, _) = (:ohm, "Ω")
  let quotientUnit(_, left, right) = (:derived, "${left}/${right}")
end
