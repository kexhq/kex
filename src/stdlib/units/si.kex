module Units.SI

type SIUnit = Meter | Gram | Kilogram | Kelvin | Liter | Newton | Joule | Watt
            | Volt | Ampere | Ohm | Coulomb

# A display prefix carries the unit it will display, for example
# `Kilo(Watt * Hour)`.
type SIPrefix = Kilo(Unit) | Mega(Unit) | Giga(Unit)
              | Milli(Unit) | Micro(Unit) | Nano(Unit)

make SIPrefix, implement: Unit do
  let factor(@Kilo(unit)) = displayFactor(unit) * 1000.0
  let factor(@Mega(unit)) = displayFactor(unit) * 1000000.0
  let factor(@Giga(unit)) = displayFactor(unit) * 1000000000.0
  let factor(@Milli(unit)) = displayFactor(unit) * 0.001
  let factor(@Micro(unit)) = displayFactor(unit) * 0.000001
  let factor(@Nano(unit)) = displayFactor(unit) * 0.000000001

  let kind(@Kilo(unit)) = displayKind(unit)
  let kind(@Mega(unit)) = displayKind(unit)
  let kind(@Giga(unit)) = displayKind(unit)
  let kind(@Milli(unit)) = displayKind(unit)
  let kind(@Micro(unit)) = displayKind(unit)
  let kind(@Nano(unit)) = displayKind(unit)

  let symbol(@Kilo(unit)) = "k${displaySymbol(unit)}"
  let symbol(@Mega(unit)) = "M${displaySymbol(unit)}"
  let symbol(@Giga(unit)) = "G${displaySymbol(unit)}"
  let symbol(@Milli(unit)) = "m${displaySymbol(unit)}"
  let symbol(@Micro(unit)) = "μ${displaySymbol(unit)}"
  let symbol(@Nano(unit)) = "n${displaySymbol(unit)}"
end

make SIUnit, implement: Unit do
  let factor = 1.0
  let kind(@Meter) = :length
  let kind(@Gram) = :mass
  let kind(@Kilogram) = :mass
  let kind(@Kelvin) = :temperature
  let kind(@Liter) = :volume
  let kind(@Newton) = :force
  let kind(@Joule) = :energy
  let kind(@Watt) = :power
  let kind(@Volt) = :voltage
  let kind(@Ampere) = :current
  let kind(@Ohm) = :resistance
  let kind(@Coulomb) = :charge

  let symbol(@Meter) = "m"
  let symbol(@Gram) = "g"
  let symbol(@Kilogram) = "kg"
  let symbol(@Kelvin) = "K"
  let symbol(@Liter) = "L"
  let symbol(@Newton) = "N"
  let symbol(@Joule) = "J"
  let symbol(@Watt) = "W"
  let symbol(@Volt) = "V"
  let symbol(@Ampere) = "A"
  let symbol(@Ohm) = "Ω"
  let symbol(@Coulomb) = "C"
end

make UnitDefinition, implement: Unit do
  let factor = @conversionFactor
  let kind = @dimension
  let symbol = @notation
end

make Measure do
  let factor -> Float = @unit.factor
  let kind -> Atom = @unit.kind
  let symbol -> String = @unit.symbol
end

let meter(value: Number) -> Measure = measure(value, Meter)
let gram(value: Number) -> Measure = measure(value, Gram)
let kilogram(value: Number) -> Measure = measure(value, Kilogram)
let kelvin(value: Number) -> Measure = measure(value, Kelvin)
let liter(value: Number) -> Measure = measure(value, Liter)
let newton(value: Number) -> Measure = measure(value, Newton)
let joule(value: Number) -> Measure = measure(value, Joule)
let watt(value: Number) -> Measure = measure(value, Watt)
let volt(value: Number) -> Measure = measure(value, Volt)
let ampere(value: Number) -> Measure = measure(value, Ampere)
let ohm(value: Number) -> Measure = measure(value, Ohm)
let coulomb(value: Number) -> Measure = measure(value, Coulomb)

make SIUnit do
  let *(@Watt, @Hour) -> UnitDefinition = UnitDefinition {
    conversionFactor: 3600.0,
    dimension: :energy,
    notation: "Wh"
  }
end

let to(measure: Measure, String) -> String = "${measure.value} ${measure.unit.symbol}"
let to(measure: Measure, String, @Kilo) -> String? = Just(displayWithPrefix(measure, 1000.0, "k"))
let to(measure: Measure, String, @Mega) -> String? = Just(displayWithPrefix(measure, 1000000.0, "M"))
let to(measure: Measure, String, @Giga) -> String? = Just(displayWithPrefix(measure, 1000000000.0, "G"))
let to(measure: Measure, String, @Milli) -> String? = Just(displayWithPrefix(measure, 0.001, "m"))
let to(measure: Measure, String, @Micro) -> String? = Just(displayWithPrefix(measure, 0.000001, "μ"))
let to(measure: Measure, String, @Nano) -> String? = Just(displayWithPrefix(measure, 0.000000001, "n"))
let to(measure: Measure, String, in: SIPrefix) -> String? do
  match measure.kind == in.kind do
    true -> return Just("${prefixScaled(measure.canonical, in.factor)} ${in.symbol}")
    false -> return None
  end
end

let mega(measure: Measure) -> Measure = prefixed(measure, 1000000.0, "M")
let giga(measure: Measure) -> Measure = prefixed(measure, 1000000000.0, "G")
let milli(measure: Measure) -> Measure = prefixed(measure, 0.001, "m")
let micro(measure: Measure) -> Measure = prefixed(measure, 0.000001, "μ")
let nano(measure: Measure) -> Measure = prefixed(measure, 0.000000001, "n")

per : Measure -> Measure -> Measure
let per(measure: Measure, other: Measure) = divideMeasures(measure, other)

times : Measure -> Measure -> Measure
let times(measure: Measure, other: Measure) = multiplyMeasures(measure, other)

# Prefixes work both on an existing measure (`5000.meter.kilo`) and at the
# beginning of a postfix unit expression (`3.kilo.watt`).
make Measure do
  let kilo -> Measure = Measure {
    canonical: this.canonical,
    value: prefixScaled(this.canonical, this.factor * 1000.0),
    unit: UnitDefinition {
      conversionFactor: this.factor * 1000.0,
      dimension: this.kind,
      notation: "k${this.symbol}"
    }
  }
end

make Integer do
  let kilo -> Float = Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 1000.0
end

make Float do
  let kilo -> Float = Kex.Intrinsic.Fun.convertTo(this, Float).or(0.0) * 1000.0
end

make Measure do
  let *(other: Measure) -> Measure = this.product(other)
  let /(other: Measure) -> Measure = this.quotient(other)

  private do
    let product(other) -> Measure do
      let kind = this.productKind(this.kind, other.kind)
      let symbol = this.productSymbol(kind, this.symbol, other.symbol)
      let value = this.canonical * other.canonical
      return Measure { canonical: value, value: value,
        unit: UnitDefinition { conversionFactor: 1.0, dimension: kind, notation: symbol } }
    end

    let quotient(other) -> Measure do
      let kind = this.quotientKind(this.kind, other.kind)
      let symbol = this.quotientSymbol(kind, this.symbol, other.symbol)
      let value = this.canonical / other.canonical
      return Measure { canonical: value, value: value,
        unit: UnitDefinition { conversionFactor: 1.0, dimension: kind, notation: symbol } }
    end

    let productKind(:mass, :acceleration) = :force
    let productKind(:force, :length) = :energy
    let productKind(:voltage, :current) = :power
    let productKind(:current, :resistance) = :voltage
    let productKind(:power, :time) = :energy
    let productKind(:current, :time) = :charge
    let productKind(left, _) = left

    let quotientKind(:length, :time) = :speed
    let quotientKind(:speed, :time) = :acceleration
    let quotientKind(:energy, :time) = :power
    let quotientKind(:force, :length) = :pressure
    let quotientKind(:voltage, :current) = :resistance
    let quotientKind(left, _) = left

    let productSymbol(:force, _, _) = "N"
    let productSymbol(:energy, _, _) = "J"
    let productSymbol(:power, _, _) = "W"
    let productSymbol(:voltage, _, _) = "V"
    let productSymbol(:charge, _, _) = "C"
    let productSymbol(_, left, right) = "${left}·${right}"

    let quotientSymbol(:speed, left, _) = "${left}/s"
    let quotientSymbol(:acceleration, left, _) = "${left}/s"
    let quotientSymbol(:power, _, _) = "W"
    let quotientSymbol(:pressure, _, _) = "Pa"
    let quotientSymbol(:resistance, _, _) = "Ω"
    let quotientSymbol(_, left, right) = "${left}/${right}"
  end
end

private do
  # Divides `canonical` by a prefix factor. The conversion is exact in
  # principle — 0.000005 W is 5 μW — but neither the measured value nor the
  # prefix factor is exactly representable in binary, so the quotient lands an
  # ulp or two off (5.000000000000001). Round back to 15 significant digits,
  # comfortably inside a double's ~15.95, so prefixed measures read the way
  # they were written. The result is always a Float; the annotation says
  # Number because `Integer / Float` infers Integer.
  let prefixScaled(canonical: Float, factor: Float) -> Number do
    let raw = canonical / factor
    return raw if raw == 0.0
    # Scaling past the exponent range would overflow to infinity; nothing that
    # extreme is a meaningful measurement anyway.
    return raw if raw.abs < 1.0e-300 || raw.abs > 1.0e300
    # Shift by dividing rather than multiplying: this module also declares `*`
    # overloads on units, and `Float * Float` resolves to one of those. Both
    # powers of ten come from `pow` rather than one being the other's
    # reciprocal, which would reintroduce the rounding this is here to remove.
    let exponent = 14 - Math.log10(raw.abs).floor
    let scale = Math.pow(10.0, exponent)
    let inverse = Math.pow(10.0, 0 - exponent)
    return (raw / inverse).round / scale
  end

  let displayWithPrefix(measure, prefixFactor, prefix) = "${prefixScaled(measure.canonical, measure.factor * prefixFactor)} ${prefix}${measure.symbol}"

  let displayFactor(@Meter) = 1.0
  let displayFactor(@Gram) = 1.0
  let displayFactor(@Kilogram) = 1.0
  let displayFactor(@Kelvin) = 1.0
  let displayFactor(@Liter) = 1.0
  let displayFactor(@Newton) = 1.0
  let displayFactor(@Joule) = 1.0
  let displayFactor(@Watt) = 1.0
  let displayFactor(@Volt) = 1.0
  let displayFactor(@Ampere) = 1.0
  let displayFactor(@Ohm) = 1.0
  let displayFactor(@Coulomb) = 1.0
  let displayFactor(unit) = unit.factor

  let displayKind(@Meter) = :length
  let displayKind(@Gram) = :mass
  let displayKind(@Kilogram) = :mass
  let displayKind(@Kelvin) = :temperature
  let displayKind(@Liter) = :volume
  let displayKind(@Newton) = :force
  let displayKind(@Joule) = :energy
  let displayKind(@Watt) = :power
  let displayKind(@Volt) = :voltage
  let displayKind(@Ampere) = :current
  let displayKind(@Ohm) = :resistance
  let displayKind(@Coulomb) = :charge
  let displayKind(unit) = unit.kind

  let displaySymbol(@Meter) = "m"
  let displaySymbol(@Gram) = "g"
  let displaySymbol(@Kilogram) = "kg"
  let displaySymbol(@Kelvin) = "K"
  let displaySymbol(@Liter) = "L"
  let displaySymbol(@Newton) = "N"
  let displaySymbol(@Joule) = "J"
  let displaySymbol(@Watt) = "W"
  let displaySymbol(@Volt) = "V"
  let displaySymbol(@Ampere) = "A"
  let displaySymbol(@Ohm) = "Ω"
  let displaySymbol(@Coulomb) = "C"
  let displaySymbol(unit) = unit.symbol

  let amount(value) = Kex.Intrinsic.Fun.convertTo(value, Float).or(0.0)
  let measure(value, unit: SIUnit) = Measure {
    canonical: amount(value) * unit.factor,
    value: amount(value),
    unit: UnitDefinition {
      conversionFactor: unit.factor,
      dimension: unit.kind,
      notation: unit.symbol
    }
  }

  let prefixed(measure, prefixFactor, prefix) = Measure {
    canonical: measure.canonical,
    value: prefixScaled(measure.canonical, measure.factor * prefixFactor),
    unit: UnitDefinition {
      conversionFactor: measure.factor * prefixFactor,
      dimension: measure.kind,
      notation: "${prefix}${measure.symbol}"
    }
  }

  let multiplyMeasures(left, right) do
    let kind = productKind(left.kind, right.kind)
    let symbol = productSymbol(kind, left.symbol, right.symbol)
    return derived(left.canonical * right.canonical, kind, symbol)
  end

  let divideMeasures(left, right) do
    let kind = quotientKind(left.kind, right.kind)
    let symbol = quotientSymbol(kind, left.symbol, right.symbol)
    return derived(left.canonical / right.canonical, kind, symbol)
  end

  let derived(value, kind, symbol) = Measure {
    canonical: value,
    value: value,
    unit: UnitDefinition {
      conversionFactor: 1.0,
      dimension: kind,
      notation: symbol
    }
  }

  let productKind(:mass, :acceleration) = :force
  let productKind(:force, :length) = :energy
  let productKind(:voltage, :current) = :power
  let productKind(:current, :resistance) = :voltage
  let productKind(:power, :time) = :energy
  let productKind(:current, :time) = :charge
  let productKind(left, _) = left

  let quotientKind(:length, :time) = :speed
  let quotientKind(:speed, :time) = :acceleration
  let quotientKind(:energy, :time) = :power
  let quotientKind(:force, :length) = :pressure
  let quotientKind(:voltage, :current) = :resistance
  let quotientKind(left, _) = left

  let productSymbol(:force, _, _) = "N"
  let productSymbol(:energy, _, _) = "J"
  let productSymbol(:power, _, _) = "W"
  let productSymbol(:voltage, _, _) = "V"
  let productSymbol(:charge, _, _) = "C"
  let productSymbol(_, left, right) = "${left}·${right}"

  let quotientSymbol(:speed, left, _) = "${left}/s"
  let quotientSymbol(:acceleration, left, _) = "${left}/s"
  let quotientSymbol(:power, _, _) = "W"
  let quotientSymbol(:pressure, _, _) = "Pa"
  let quotientSymbol(:resistance, _, _) = "Ω"
  let quotientSymbol(_, left, right) = "${left}/${right}"
end
