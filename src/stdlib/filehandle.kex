# Why a read failed.
#
# +ReadFailed+ means the source refused the read. +InvalidUtf8+ means bytes
# were read but are not valid UTF-8, and carries the byte offset of the first
# malformed sequence, relative to that one operation. A failed read consumes
# the bytes it attempted to read and never substitutes U+FFFD — use
# +readBytes+ to recover the payload verbatim.
type ReadError = ReadFailed | InvalidUtf8(Integer)

# +Readable+ — a source that yields text.
#
# Named so that anything can be one, not just a file: the vocabulary
# +FileHandle<CanRead, W>+ already carried was an abstraction without a name,
# so nothing else could implement it and +IO+ did not go through it
# (kexhq/kex#139). +IO.in+ is a +Readable+; so is any handle opened for
# reading.
#
#   foul firstLine(source: Readable) -> String do
#     source.getLine.or("(empty)")
#   end
#
#   firstLine(IO.in)
#   firstLine(FS.File.open("notes.txt", Read).try)
trait Readable do
  # Reads the next line, without its newline.
  #
  # @return [Result<String?, ReadError>] the next line, +Ok(None)+ at end of
  #   input, or the failure
  getLine :> Result<String?, ReadError>

  # Reads a single character, as a one-character +String+.
  #
  # Reads one complete Unicode scalar, not one byte.
  #
  # @return [Result<String?, ReadError>] the next character, +Ok(None)+ at end
  #   of input, or the failure
  get :> Result<String?, ReadError>

  # Reads the next line, without its newline. The same as +getLine+.
  #
  # @return [Result<String?, ReadError>] the next line, +Ok(None)+ at end of
  #   input, or the failure
  readLine :> Result<String?, ReadError>

  # Reads everything remaining, as one +String+.
  #
  # Draining an exhausted source answers +Ok("")+.
  #
  # @return [Result<String, ReadError>] the remaining contents, or the failure
  read :> Result<String, ReadError>

  # Reads everything remaining as raw bytes, without decoding it as text.
  #
  # The byte counterpart of +read+: it never validates UTF-8, so it recovers
  # the payload of a source that is not text — or one +read+ has just rejected.
  # Draining an exhausted source answers +Ok(Binary.fromBytes([]))+.
  #
  # @return [Result<Binary, ReadError>] the remaining bytes, or the failure
  readBytes :> Result<Binary, ReadError>

  # Returns +true+ when the source has reached its end.
  #
  # @return [Bool] +true+ at end of input
  eof? :> Bool

  # Returns +true+ when the source has reached its end. The same as +eof?+.
  #
  # @return [Bool] +true+ at end of input
  atEnd? :> Bool
end

# +Writable+ — a sink that accepts text.
#
# The payoff of naming it is that a sink becomes a VALUE a library can accept,
# rather than a global switch it can only sit underneath: output from one
# library can go to a buffer while another's goes to the terminal
# (kexhq/kex#139).
#
#   foul report(out: Writable, lines: [String]) -> Void do
#     lines.each { |line| out.printLine(line) }
#   end
#
#   report(IO.out, results)
#   report(IO.error, warnings)
#   report(FS.File.open("report.txt", Write).try, results)
#
# Two deliberate choices, both settled in kexhq/kex#139:
#
# - The argument is +Showable+, not +String+. +IO.printLine+ always took a
#   +Showable+ while the handle methods took a +String+; the wider one is
#   right, and it is what makes +IO.printLine(x)+ and +IO.out.printLine(x)+
#   the same call.
# - The result is +Void+, not +Bool+. A boolean nobody checks is not an error
#   channel, and +Result<Void, IOError>+ on every print is miserable to use.
#   Erlang's answer is the one taken here: the call says +ok+, and failure
#   belongs to the device rather than to the call site.
trait Writable do
  # Writes +content+ followed by a newline.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  printLine :> Showable -> Void

  # Writes +content+ with no trailing newline.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  print :> Showable -> Void

  # Writes +content+ followed by a newline. The same as +printLine+.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  writeLine :> Showable -> Void

  # Writes +content+ with no trailing newline. The same as +print+.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  write :> Showable -> Void

  # Writes +content+ as raw bytes, with no trailing newline.
  #
  # The byte counterpart of +write+: the payload goes to the sink exactly as
  # given. It never renders the value, so a +Binary+ reaches the sink as its
  # bytes rather than as the +#Binary<N bytes>+ that +Showable+ would print.
  #
  # @param content [Binary] the bytes to write
  # @return [Void]
  writeBytes :> Binary -> Void
end

# An open file, obtained from +FS.File.open+.
#
# The two type parameters record what the handle is allowed to do: +R+ is
# +CanRead+ or +CannotRead+, +W+ is +CanWrite+ or +CannotWrite+. +FS.File.open+
# picks them from the mode you pass, so calling +write+ on a handle opened
# +Read+ is a compile error rather than a run-time failure.
#
#   using FS
#
#   main do
#     match FS.File.open("notes.txt", Read) do
#       Ok(handle) => do
#         IO.printLine(handle.read.or(""))
#         handle.close
#       end
#       Error(e) => IO.printError("cannot open: ${e}")
#     end
#   end
#
# Reach for a handle when you want to walk a large file a line at a time, or
# make many small writes. When a file fits comfortably in memory,
# +FS.File.read+ and +FS.File.write+ are shorter and need no closing. To be
# rid of the closing entirely, pass +FS.File.open+ a block.
#
# The handle methods are +foul+: obtaining a handle is not an effect, but
# reading or writing through one is, so a function that does so is +foul+ no
# matter where the handle came from. Injection makes a thing substitutable,
# not pure.
type FileHandle<R, W>

make FileHandle<CanRead, W>, implement: Readable do
  # Reads the next line from the handle, without its newline.
  #
  # Answers +None+ at end of file, which is what makes it usable as a loop
  # condition. The same operation as +readLine+, under the name +IO.getLine+
  # uses.
  #
  # @return [String?] the next line, or +None+ at end of file
  #
  # @example Walking a file line by line
  #   foul echo(handle: FileHandle<CanRead, W>) -> Void do
  #     match handle.getLine do
  #       Just(line) => do
  #         IO.printLine(line)
  #         echo(handle)
  #       end
  #       None => ()
  #     end
  #   end
  getLine :> Result<String?, ReadError>
  foul getLine = Kex.Intrinsic.FileHandle.getLine(this)

  # Reads a single character from the handle, as a one-character +String+.
  #
  # Answers +None+ at end of file.
  #
  # @return [String?] the next character, or +None+ at end of file
  #
  # @example
  #   let firstChar = handle.get.or("")
  get :> Result<String?, ReadError>
  foul get = Kex.Intrinsic.FileHandle.get(this)

  # Reads the next line from the handle, without its newline. The same as
  # +getLine+, named for reading from a file rather than from a console.
  #
  # @return [String?] the next line, or +None+ at end of file
  #
  # @example
  #   let header = handle.readLine.or("")
  #
  # @example Reading the first three lines
  #   let head = (1..3).items.map { |_| handle.readLine.or("") }
  readLine :> Result<String?, ReadError>
  foul readLine = Kex.Intrinsic.FileHandle.readLine(this)

  # Reads everything remaining in the file and returns it as one +String+.
  #
  # Reads from the current position, so calling it after a +readLine+ gives
  # the rest of the file rather than the whole of it.
  #
  # @return [String?] the remaining contents, or +None+
  #
  # @example
  #   let body = handle.read.or("")
  #
  # @example Skipping a header line, then taking the rest
  #   handle.readLine
  #   let body = handle.read.or("")
  read :> Result<String, ReadError>
  foul read = Kex.Intrinsic.FileHandle.read(this)

  readBytes :> Result<Binary, ReadError>
  foul readBytes = Kex.Intrinsic.FileHandle.readBytes(this)

  # Returns +true+ when the handle has reached the end of the file.
  #
  # @return [Bool] +true+ at end of file
  #
  # @example
  #   handle.eof?   # => false, before anything has been read
  eof? :> Bool
  foul eof? = Kex.Intrinsic.FileHandle.eof?(this)

  # Returns +true+ when the handle has reached the end of the file. The same
  # as +eof?+, spelled out.
  #
  # @return [Bool] +true+ at end of file
  #
  # @example
  #   if !handle.atEnd?
  #     IO.printLine(handle.readLine.or(""))
  #   end
  atEnd? :> Bool
  foul atEnd? = Kex.Intrinsic.FileHandle.atEnd?(this)

  # Returns the handle's remaining lines as a lazy +Stream+.
  #
  # Lines are read on demand, so this is how to look at the start of a very
  # large file, or process one without holding it all in memory.
  #
  # The stream ends at the last line, so taking more lines than the file has
  # answers just the lines there are.
  #
  # NOT part of +Readable+. +docs/streams.md+ describes a one-shot, stateful
  # +Feed<A>+ that does not exist, and a file feed is neither pure nor
  # reusable the way +Stream<A>+ claims to be. Until that is settled this is a
  # FileHandle method rather than something every +Readable+ must answer.
  #
  # @return [Stream<String>?] the lines as a stream, or +None+
  #
  # @example The first ten lines of a large file
  #   handle.feed
  #     .map { |lines| lines.take(10) }
  #     .or([])
  feed :> Stream<String>?
  foul feed = Kex.Intrinsic.FileHandle.feed(this)
end

make FileHandle<R, CanWrite>, implement: Writable do
  writeBytes :> Binary -> Void
  foul writeBytes(content) = Kex.Intrinsic.FileHandle.writeBytes(this, content)
  # Writes +content+ followed by a newline.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example Writing a report line by line
  #   rows.each { |row| handle.printLine(row) }
  printLine :> Showable -> Void
  foul printLine(content) = Kex.Intrinsic.FileHandle.printLine(this, content.showValue)

  # Writes +content+ with no trailing newline.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example Building a line from pieces
  #   handle.print("name,")
  #   handle.print("age")
  #   handle.printLine("")
  print :> Showable -> Void
  foul print(content) = Kex.Intrinsic.FileHandle.print(this, content.showValue)

  # Writes +content+ followed by a newline. The same as +printLine+, named for
  # writing to a file rather than to a console.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example
  #   handle.writeLine("done")
  writeLine :> Showable -> Void
  foul writeLine(content) = Kex.Intrinsic.FileHandle.writeLine(this, content.showValue)

  # Writes +content+ with no trailing newline. The same as +print+.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example Writing a whole document in one call
  #   handle.write(rendered)
  write :> Showable -> Void
  foul write(content) = Kex.Intrinsic.FileHandle.write(this, content.showValue)
end

make FileHandle<R, W> do
  # Closes the handle, flushing anything still buffered.
  #
  # Close every handle you open. A written file is not guaranteed to be
  # complete on disk until its handle is closed. Passing +FS.File.open+ a
  # block closes the handle for you.
  #
  # @return [Void]
  #
  # @example
  #   match FS.File.open("out.txt", Write) do
  #     Ok(handle) => do
  #       handle.printLine("hello")
  #       handle.close
  #     end
  #     Error(_) => IO.printError("cannot open out.txt")
  #   end
  close :> Void
  foul close = Kex.Intrinsic.FileHandle.close(this)
end
