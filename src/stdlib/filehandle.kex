# Why a read failed.
#
# +ReadFailed+ means the source refused the read. +InvalidUtf8+ means bytes
# were read but are not valid UTF-8, and carries the byte offset of the first
# malformed sequence, relative to that one operation. A failed read consumes
# the bytes it attempted to read and never substitutes U+FFFD: use
# +readBytes+ instead of a text read when you need the original bytes.
type ReadError = ReadFailed | InvalidUtf8(Integer)

# Why a write failed: the sink refused it. A closed handle, a full device, or
# standard input all answer +WriteFailed+.
type WriteError = | WriteFailed

# +Readable+: a source of bytes and text.
#
# +IO.in+ and file handles opened for reading are +Readable+. Accept this
# trait when your function should work with either source.
#
# Two families read text. The +read+ family (+readLine+, +read+,
# +readBytes+) answers a +Result+, so a failed read can be told apart from
# the end of the input. The +get+ family is the short form: +getLine+ answers
# an +Optional+, +None+ both at the end and on a failed read, which is what
# most interactive code wants. +get+ itself is the primitive the rest stand
# on: the next chunk of raw bytes.
#
#   foul firstLine(source: Readable) -> String do
#     source.getLine.or("(empty)")
#   end
#
#   firstLine(IO.in)
#   firstLine(FS.File.open("notes.txt", Read).try)
trait Readable do
  # Reads the next chunk of bytes: whatever the source has ready, up to its
  # buffer size. Standard input answers one line at a time, newline included.
  #
  # @return [Result<Binary?, ReadError>] the next chunk, +Ok(None)+ at end of
  #   input, or the failure
  get :> Result<Binary?, ReadError>

  # Reads the next line, without its newline.
  #
  # @return [Result<String?, ReadError>] the next line, +Ok(None)+ at end of
  #   input, or the failure
  readLine :> Result<String?, ReadError>

  # Reads the next line, without its newline: +readLine+ for when the end of
  # the input and a failed read mean the same thing.
  #
  # @return [String?] the next line, or +None+ at end of input or on failure
  getLine :> String?

  # Reads everything remaining, as one +String+.
  #
  # Draining an exhausted source answers +Ok("")+.
  #
  # @return [Result<String, ReadError>] the remaining contents, or the failure
  read :> Result<String, ReadError>

  # Reads everything remaining as raw bytes, without decoding it as text.
  #
  # The byte counterpart of +read+: it returns the remaining bytes without
  # validating UTF-8. Bytes consumed by a failed text read are not returned
  # by a subsequent +readBytes+ call. Draining an exhausted source answers
  # +Ok(Binary.fromBytes([]))+.
  #
  # @return [Result<Binary, ReadError>] the remaining bytes, or the failure
  readBytes :> Result<Binary, ReadError>

  # Returns +true+ when the source has reached its end.
  #
  # @return [Bool] +true+ at end of input
  eof? :> Bool
end

# +Writable+: a sink for bytes and text.
#
# Accept a +Writable+ parameter to let callers choose standard output,
# standard error, or a file as the destination.
#
# Two families write text. The +write+ family (+put+, +write+, +writeLine+)
# answers a +Result+, for when a failed write matters. The +print+ family
# (+print+, +printLine+) answers +Void+, for output where there is nothing
# useful to do about a failure. +put+ is the primitive the rest stand on: raw
# bytes, verbatim.
#
#   foul report(out: Writable, lines: [String]) -> Void do
#     lines.each { |line| out.printLine(line) }
#   end
#
#   report(IO.out, results)
#   report(IO.error, warnings)
#   report(FS.File.open("report.txt", Write).try, results)
trait Writable do
  # Writes +content+ verbatim, with no trailing newline.
  #
  # It never renders the value, so a +Binary+ reaches the sink as its bytes
  # rather than as the +#Binary<N bytes>+ that +Showable+ would print.
  #
  # @param content [Binary] the bytes to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  put :> Binary -> Result<Void, WriteError>

  # Writes +content+ with no trailing newline.
  #
  # @param content [Showable] the value to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  write :> Showable -> Result<Void, WriteError>

  # Writes +content+ followed by a newline.
  #
  # @param content [Showable] the value to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  writeLine :> Showable -> Result<Void, WriteError>

  # Writes +content+ with no trailing newline, ignoring a failure. Use
  # +write+ when a failure matters.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  print :> Showable -> Void

  # Writes +content+ followed by a newline, ignoring a failure. Use
  # +writeLine+ when a failure matters.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  printLine :> Showable -> Void
end

# +Closeable+: anything that holds a releasable resource.
#
# File handles, socket connections, listeners, and datagram sockets are all
# +Closeable+. Closing is idempotent everywhere, so a shared cleanup path
# never has to track who closed what.
#
#   foul shutdown(first: Closeable, second: Closeable) -> Void do
#     first.close
#     second.close
#   end
#
#   shutdown(handle, listener)
trait Closeable do
  # Releases the underlying resource. Idempotent: closing twice is fine.
  #
  # @return [Void]
  close :> Void
end

# An open file, obtained from +FS.File.open+.
#
# The two type parameters record what the handle is allowed to do: +R+ is
# +CanRead+ or +CannotRead+, +W+ is +CanWrite+ or +CannotWrite+. +FS.File.open+
# picks them from the mode you pass, so calling +printLine+ on a handle opened
# +Read+ is a compile error rather than a run-time failure.
#
#   using FS
#
#   main do
#     match FS.File.open("notes.txt", Read) do
#       Ok(handle) => do
#         IO.printLine(handle.read.or(""))
#         handle.close
#       end
#       Error(e) => IO.printError("cannot open: ${e}")
#     end
#   end
#
# Reach for a handle when you want to walk a large file a line at a time, or
# make many small writes. When a file fits comfortably in memory,
# +FS.File.read+ and +FS.File.write+ are shorter and need no closing. To be
# rid of the closing entirely, pass +FS.File.open+ a block.
#
# The handle functions are +foul+: obtaining a handle is not an effect, but
# reading or writing through one is, so a function that does so is +foul+ no
# matter where the handle came from. Injection makes a thing substitutable,
# not pure.
type FileHandle<R, W>

make FileHandle<CanRead, W>, implement: Readable do
  # Reads the next chunk of bytes from the handle, up to 64 KiB.
  #
  # @return [Result<Binary?, ReadError>] the next chunk, or +None+ at end of
  #   file
  #
  # @example Copying a file a chunk at a time
  #   foul copy(source: FileHandle<CanRead, W>, target: FileHandle<R, CanWrite>) -> Void do
  #     match source.get do
  #       Ok(Just(chunk)) => do
  #         target.put(chunk)
  #         copy(source, target)
  #       end
  #       _ => ()
  #     end
  #   end
  get :> Result<Binary?, ReadError>
  foul get = Kex.Intrinsic.FileHandle.getChunk(this, 65536)

  # Reads the next line from the handle, without its newline.
  #
  # @return [Result<String?, ReadError>] the next line, +Ok(None)+ at end of
  #   file, or the failure
  #
  # @example Walking a file line by line
  #   foul echo(handle: FileHandle<CanRead, W>) -> Void do
  #     match handle.readLine do
  #       Ok(Just(line)) => do
  #         IO.printLine(line)
  #         echo(handle)
  #       end
  #       Ok(None) => ()
  #       Error(e) => IO.printError("read failed: ${e}")
  #     end
  #   end
  readLine :> Result<String?, ReadError>
  foul readLine = Kex.Intrinsic.FileHandle.readLine(this)

  # Reads the next line from the handle, without its newline.
  #
  # @return [String?] the next line, or +None+ at end of file or on failure
  #
  # @example
  #   let header = handle.getLine.or("")
  getLine :> String?
  foul getLine do
    match Kex.Intrinsic.FileHandle.readLine(this) do
      Ok(value) => return value
      Error(_) => return None
    end
  end

  # Reads a single character from the handle, as a one-character +String+:
  # one complete Unicode scalar, not one byte.
  #
  # @return [String?] the next character, or +None+ at end of file or on
  #   failure
  #
  # @example
  #   let firstChar = handle.getChar.or("")
  getChar :> String?
  foul getChar do
    match Kex.Intrinsic.FileHandle.getChar(this) do
      Ok(value) => return value
      Error(_) => return None
    end
  end

  # Reads everything remaining in the file and returns it as one +String+.
  #
  # Reads from the current position, so calling it after a +readLine+ gives
  # the rest of the file rather than the whole of it.
  #
  # @return [Result<String, ReadError>] the remaining contents
  #
  # @example
  #   let body = handle.read.or("")
  #
  # @example Skipping a header line, then taking the rest
  #   handle.getLine
  #   let body = handle.read.or("")
  read :> Result<String, ReadError>
  foul read = Kex.Intrinsic.FileHandle.read(this)

  # Reads all remaining bytes from the handle without decoding them.
  #
  # Unlike +read+, this accepts arbitrary binary data and cannot fail because
  # the input is not valid UTF-8. It starts at the handle's current position.
  #
  # @return [Result<Binary, ReadError>] the remaining bytes
  #
  # @example Reading a file with an unknown encoding
  #   let payload = handle.readBytes.try
  readBytes :> Result<Binary, ReadError>
  foul readBytes = Kex.Intrinsic.FileHandle.readBytes(this)

  # Returns +true+ when the handle has reached the end of the file.
  #
  # @return [Bool] +true+ at end of file
  #
  # @example
  #   handle.eof?   # => false, before anything has been read
  eof? :> Bool
  foul eof? = Kex.Intrinsic.FileHandle.eof?(this)

  # Returns the handle's remaining lines as a lazy +Feed+.
  #
  # Lines are read on demand off the handle's own position, so this is how to
  # look at the start of a very large file, or process one without holding it
  # all in memory. The feed shares the handle's cursor: interleaving +readLine+
  # with it advances one position through one open file.
  #
  # The feed ends at the last line, so taking more lines than the file has
  # answers just the lines there are.
  #
  # NOT part of +Readable+: a feed is neither pure nor reusable, so requiring
  # it of every +Readable+ would put a foul, one-shot operation on types that
  # have no such cursor to offer. It stays a FileHandle function.
  #
  # @return [Result<Feed<String>, ReadError>] the lines as a feed, or
  #   +ReadFailed+ for a handle that cannot be read line by line
  #
  # @example The first ten lines of a large file
  #   handle.feed
  #     .map { |lines| lines.take(10) }
  #     .or([])
  feed :> Result<Feed<String>, ReadError>
  foul feed do
    match Kex.Intrinsic.FileHandle.feed(this) do
      Just(lines) => return Ok(lines)
      None => return Error(ReadFailed)
    end
  end
end

make FileHandle<R, CanWrite>, implement: Writable do
  # Writes +content+ verbatim, without text encoding or a trailing newline.
  #
  # @param content [Binary] the bytes to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  #
  # @example Copying an opaque payload
  #   destination.put(source.readBytes.try)
  put :> Binary -> Result<Void, WriteError>
  foul put(content) = Kex.Intrinsic.FileHandle.put(this, content)

  # Writes +content+ with no trailing newline.
  #
  # @param content [Showable] the value to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  #
  # @example
  #   handle.write("total: ${total}").try
  write :> Showable -> Result<Void, WriteError>
  foul write(content) = Kex.Intrinsic.FileHandle.put(this, content.showValue)

  # Writes +content+ followed by a newline.
  #
  # @param content [Showable] the value to write
  # @return [Result<Void, WriteError>] +Ok+, or why the write failed
  #
  # @example Stopping at the first failed write
  #   rows.each { |row| handle.writeLine(row).try }
  writeLine :> Showable -> Result<Void, WriteError>
  foul writeLine(content) = Kex.Intrinsic.FileHandle.put(this, "${content.showValue}\n")

  # Writes +content+ followed by a newline, ignoring a failure.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example Writing a report line by line
  #   rows.each { |row| handle.printLine(row) }
  printLine :> Showable -> Void
  foul printLine(content) = Kex.Intrinsic.FileHandle.printLine(this, content.showValue)

  # Writes +content+ with no trailing newline, ignoring a failure.
  #
  # @param content [Showable] the value to write
  # @return [Void]
  #
  # @example Building a line from pieces
  #   handle.print("name,")
  #   handle.print("age")
  #   handle.printLine("")
  print :> Showable -> Void
  foul print(content) = Kex.Intrinsic.FileHandle.print(this, content.showValue)
end

make FileHandle<R, W> do
  # Moves the handle's cursor to an absolute byte offset from the start of
  # the file. Read and write share one cursor, so this repositions both —
  # a `getLine` right after `seek(0)` starts over from the top, and a
  # `print` right after does too, overwriting from that point.
  #
  # @param offset [Integer] the byte offset to seek to, from the start of
  #   the file
  # @return [Result<Void, ReadError>] +Ok+ on success, or why the seek
  #   failed
  #
  # @example Reading a length-prefixed record, then rewinding past it
  #   let length = handle.getLine.or("0").to(Integer).or(0)
  #   let record = handle.readBytes.try
  #   handle.seek(0)
  seek : Integer -> Result<Void, ReadError>
  foul seek(offset) = Kex.Intrinsic.FileHandle.seek(this, offset)

  # Moves the handle's cursor back to the start of the file — the same as
  # +seek(0)+, for the common case of re-reading a handle from the top.
  #
  # @return [Result<Void, ReadError>] +Ok+ on success, or why the reset
  #   failed
  #
  # @example Reading a file twice
  #   let firstPass = handle.read.or("")
  #   handle.reset
  #   let secondPass = handle.read.or("")
  reset :> Result<Void, ReadError>
  foul reset = Kex.Intrinsic.FileHandle.reset(this)
end

make FileHandle<R, W>, implement: Closeable do
  # Closes the handle, flushing anything still buffered.
  #
  # Close every handle you open. A written file is not guaranteed to be
  # complete on disk until its handle is closed. Passing +FS.File.open+ a
  # block closes the handle for you.
  #
  # @return [Void]
  #
  # @example
  #   match FS.File.open("out.txt", Write) do
  #     Ok(handle) => do
  #       handle.printLine("hello")
  #       handle.close
  #     end
  #     Error(_) => IO.printError("cannot open out.txt")
  #   end
  close :> Void
  foul close = Kex.Intrinsic.FileHandle.close(this)
end
