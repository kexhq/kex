# Algebraic structures: combining values associatively.
#
# Kex traits do not inherit from one another, so a type lists every
# structure it implements.
#
# A +Monoid+ has an associative +combine+ and a neutral +identity+. Integers,
# strings and lists are all monoids, so one +repeat+ serves all three:
#
#   "ab".repeat(3)   # => "ababab"
#   [1].repeat(2)    # => [1, 1]
#   5.repeat(3)      # => 15
#
# +Ordering+ and +Comparable+ are in +comparable.kex+.

# Types whose values combine associatively and have a neutral element.
#
# Implemented by +Integer+ (addition), +String+ and +List+ (concatenation),
# +Map+ (merge), +Set+ and +UnorderedSet+ (union), +Stack+, +Queue+, and
# +Ordering+, where the first decision that is not +Equal+ wins.
trait Monoid do
  # Returns the neutral element: combining it with any value, on either side,
  # gives that value back.
  #
  # @return [This] the identity
  #
  # @example
  #   Integer.identity   # => 0
  #   String.identity    # => ""
  identity :> This

  # Combines this value with +other+.
  #
  # It must be associative: +a.combine(b).combine(c)+ must equal
  # +a.combine(b.combine(c))+.
  #
  # @param other [This] the value to combine with
  # @return [This] the combined value
  #
  # @example
  #   5.combine(3)          # => 8
  #   "ab".combine("cd")    # => "abcd"
  #   [1].combine([2])      # => [1, 2]
  #
  # @example Folding a list of values into one
  #   parts.reduce(String.identity) { |acc, s| acc.combine(s) }
  combine :> This -> This

  # Combines this value with itself +n+ times.
  #
  # Zero or a negative +n+ gives the identity: +""+ for a string, +0+ for an
  # integer, +[]+ for a list. For strings, this is Ruby's +*+.
  #
  # @param n [Integer] how many copies to combine
  # @return [This] the repeated value
  #
  # @example
  #   "ab".repeat(3)   # => "ababab"
  #   [1].repeat(2)    # => [1, 1]
  #   5.repeat(3)      # => 15
  #   "x".repeat(0)    # => ""
  #
  # @example Drawing a separator line
  #   IO.printLine("-".repeat(40))
  let repeat(n: Integer) -> This do
    return this.identity if n <= 0

    # Half the copies combined with themselves (associativity, a Monoid law):
    # logarithmic depth, so a long repeat neither exhausts a stack nor
    # combines one copy at a time.
    let half = this.repeat(n.div(2))
    let doubled = half.combine(half)

    return n.dividesBy?(2) then doubled else doubled.combine(this)
  end
end

# A +Monoid+ in which every value has an inverse that combines with it to give
# the identity.
#
# Implemented by +Integer+, where the inverse is negation.
trait Group do
  # Returns the neutral element.
  #
  # @return [This] the identity
  identity :> This

  # Combines this value with +other+.
  #
  # @param other [This] the value to combine with
  # @return [This] the combined value
  combine :> This -> This

  # Returns the value that combines with this one to give the identity.
  #
  # @return [This] the inverse
  #
  # @example
  #   5.inverse             # => -5
  #   5.combine(5.inverse)  # => 0
  inverse :> This
end

# Makes +Integer+ a +Monoid+ and a +Group+ under addition.
make Integer, implement: Monoid, Group do
  # Returns +0+, the neutral element for addition.
  #
  # @return [Integer] zero
  #
  # @example
  #   Integer.identity   # => 0
  let identity = 0

  # Returns the sum of this integer and +other+.
  #
  # @param other [This] the integer to add
  # @return [This] the sum
  #
  # @example
  #   5.combine(3)   # => 8
  let combine(other: This) -> This = this + other

  # Returns this integer negated, its additive inverse.
  #
  # @return [This] the negation
  #
  # @example
  #   5.inverse    # => -5
  #   (-5).inverse # => 5
  let inverse -> This = -this
end

# Makes +String+ a +Monoid+ under concatenation.
make String, implement: Monoid do
  # Returns +""+, the neutral element for concatenation.
  #
  # @return [String] the empty string
  #
  # @example
  #   String.identity   # => ""
  let identity = ""

  # Returns this string followed by +other+.
  #
  # @param other [This] the string to append
  # @return [This] the concatenation
  #
  # @example
  #   "ab".combine("cd")   # => "abcd"
  let combine(other: This) -> This = this + other
end

# Makes lists a +Monoid+ under concatenation.
make [A], implement: Monoid do
  # Returns +[]+, the neutral element for concatenation.
  #
  # @return [[A]] the empty list
  #
  # @example
  #   [1, 2].identity   # => []
  let identity -> This = []

  # Returns this list followed by +other+.
  #
  # @param other [This] the list to append
  # @return [This] the concatenation
  #
  # @example
  #   [1].combine([2, 3])   # => [1, 2, 3]
  #
  # @example Flattening a list of lists
  #   groups.reduce([]) { |acc, g| acc.combine(g) }
  let combine(other: This) -> This = this + other
end

# Containers whose values can be transformed while the container keeps its
# shape: a list's elements, an optional's value, a result's success. The
# trait ranges over the container type, so a function written once works on
# any of them:
#
#   let bumped(F is Functor => xs: F<Integer>) -> F<Integer> = xs.map { |x| x + 1 }
#
#   bumped([1, 2])     # => [2, 3]
#   bumped(Just(1))    # => Just(2)
#   bumped(Ok(1))      # => Ok(2)
#
# Implemented by +List+, +Optional+ and +Result+, where an error is left as
# it is.
trait Functor<F<_>> do
  # Applies +f+ to each value the container holds, keeping its shape.
  #
  # @param f [A -> B] the transformation
  # @return [F<B>] the container of results
  map : F<A> -> (A -> B) -> F<B>
end

# Containers whose values can each produce another container of the same
# kind, flattened into one. This is the chaining step of a list, an optional
# or a result.
#
#   let chained(F is Bindable => xs: F<Integer>, f: Integer -> F<Integer>) -> F<Integer> = xs.into(f)
#
# Implemented by +List+, +Optional+ and +Result+.
trait Bindable<F<_>> do
  # Applies +f+ to each value and joins the containers it returns.
  #
  # @param f [A -> F<B>] the step
  # @return [F<B>] the joined result
  into : F<A> -> (A -> F<B>) -> F<B>
end

# A +Bindable+ container that can also be made from one plain value with
# +wrap+. Generic code calls it through the type parameter, as +M.wrap(x)+;
# for a concrete type, +List.wrap(1)+ is +[1]+, +Optional.wrap(1)+ is
# +Just(1)+ and +Result.wrap(1)+ is +Ok(1)+.
#
#   let incremented(M is Monad => xs: M<Integer>) -> M<Integer> = xs.into { |x| M.wrap(x + 1) }
#
#   incremented([1, 2])   # => [2, 3]
#   incremented(Just(1))  # => Just(2)
#
# Implemented by +List+, +Optional+ and +Result+, where an error is left as
# it is.
trait Monad<F> do
  # Returns the container holding only +value+.
  #
  # @param value [A] the value to hold
  # @return [F<A>] the container
  wrap : A -> F<A>

  # Applies +f+ to each value and joins the containers it returns.
  #
  # @param f [A -> F<B>] the step
  # @return [F<B>] the joined result
  into : F<A> -> (A -> F<B>) -> F<B>
end

# Containers whose values can be combined with another container's when
# neither depends on the other. +with+ applies a function to the values of
# both. A list combines every pair. An +Optional+ or a +Result+ combines the
# two values or returns the first failure. A +Validation+ combines the values
# or collects every failure, which suits checking several independent inputs.
#
#   [1, 2].with([10, 20]) { |a, b| a + b }       # => [11, 21, 12, 22]
#   Just(1).with(Just(2)) { |a, b| a + b }       # => Just(3)
#   name.checked.with(email.checked) do |n, e|
#     Signup { name: n, email: e }               # every failed check, or a Signup
#   end
#
# +traverse+ and +sequence+ work with any of them.
#
# Implemented by +List+, +Optional+, +Result+ and +Validation+.
trait Applicable<F> do
  # Returns the container holding only +value+.
  #
  # @param value [A] the value to hold
  # @return [F<A>] the container
  wrap : A -> F<A>

  # Applies +f+ to this container's values and +other+'s.
  #
  # @param other [F<B>] the other container
  # @param f [A -> B -> C] combines one value from each
  # @return [F<C>] the results
  with : F<A> -> F<B> -> (A -> B -> C) -> F<C>
end

# Applies +f+ to every element and gathers the results into one container.
# If any step fails, the result is a failure: the first one for an
# +Optional+ or +Result+, all of them for a +Validation+.
#
# @param xs [[A]] the elements
# @param f [A -> F<B>] the step for one element
# @return [F<[B]>] the results, gathered
#
# @example
#   traverse(["1", "2"]) { |s| s.to(Integer) }   # => Just([1, 2])
#   traverse(["1", "x"]) { |s| s.to(Integer) }   # => None
let traverse(F is Applicable => xs: [A], f: A -> F<B>) -> F<[B]> do
  return xs.reduce(F.wrap([])) do |gathered, x|
    gathered.with(f(x)) { |done, item| done + [item] }
  end
end

# Turns a list of containers into one container of a list; +traverse+ with
# nothing to apply.
#
# @param xs [[F<A>]] the containers
# @return [F<[A]>] their values, gathered
#
# @example
#   sequence([Ok(1), Ok(2)])           # => Ok([1, 2])
#   sequence([Ok(1), Error("no")])     # => Error("no")
let sequence(F is Applicable => xs: [F<A>]) -> F<[A]> = traverse(xs) { |x| x }
