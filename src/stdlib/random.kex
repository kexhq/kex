# Random values for simulations, sampling, games, and reproducible tests.
#
# Import with +using Random+. Ordinary calls return a value directly;
# a +Random.Generator+ returns +(value, nextGenerator)+. Reusing the same
# generator replays the same draw. Pass its returned state to continue.
#
# @example Roll a die or initialize a weight
#   using Random
#   let roll = Random.integer(1..6)
#   let weight = Random.float(-1.0..1.0)
#
# @example Reproduce a sequence
#   let generator = Random.seeded(42)
#   let (first, afterFirst) = generator.integer(1..6)
#   let (second, afterSecond) = afterFirst.integer(1..6)
#
# These generators are not cryptographic; do not use their output for secrets.
module Random do
  # Immutable state of a deterministic random sequence.
  #
  # Construct with +Random.seeded+ or +Random.fresh+. Each draw returns its
  # value first and the advanced generator second. Equal seeds reproduce equal
  # sequences for the same operations on both backends.
  record Generator do
    state : Integer = 0
  end

  # Starts a deterministic sequence. Any Integer seed is reduced modulo 2^64.
  # @param seed [Integer] reproducible seed, including negative or large values
  # @return [Generator] initial state; no draw has been consumed
  let seeded(seed: Integer) -> Generator = Generator {
    state: seed.modulo(18446744073709551616)
  }

  # Starts a generator using fresh host entropy.
  # @return [Generator] initial state for a sequence that varies between runs
  foul fresh -> Generator do
    let high = Math.floor(Kex.Intrinsic.Retry.randomUnit() * 4294967296.0)
    let low = Math.floor(Kex.Intrinsic.Retry.randomUnit() * 4294967296.0)
    seeded(high * 4294967296 + low)
  end

  module Generator do
    make Random.Generator do
      # Draws an integer between both endpoints, with the advanced generator.
      # The range must be ascending and contain at most 2^64 integers.
      # A singleton range is valid and still consumes a draw.
      # @param range [Range<Integer>] inclusive integer bounds
      # @return [(Integer, Generator)] drawn integer and advanced state
      # @example A reproducible die roll
      #   let (roll, advanced) = Random.seeded(42).integer(1..6)
      let integer(range: Range<Integer>) -> (Integer, Generator) = drawInteger(this, range)

      # Draws a float from the lower bound inclusive to the upper bound exclusive.
      # Defaults to +0.0..1.0+. Bounds must be finite and strictly ascending.
      # @param range [Range<Float>] half-open floating-point bounds
      # @return [(Float, Generator)] drawn float and advanced state
      # @example Initialize a model weight
      #   let (weight, advanced) = Random.seeded(42).float(-1.0..1.0)
      let float(range: Range<Float>) -> (Float, Generator) = drawFloat(this, range)
      let float -> (Float, Generator) = drawFloat(this, 0.0..1.0)

      # Draws a fair Boolean and returns the advanced generator.
      # @return [(Bool, Generator)] coin flip and advanced state
      let boolean -> (Bool, Generator) = drawBoolean(this)

      # Draws true with the supplied probability. Consumes one draw even at 0 or 1.
      # @param probability [Float] probability from 0.0 through 1.0
      # @return [(Bool, Generator)] outcome and advanced state
      let chance?(probability: Float) -> (Bool, Generator) = drawChance(this, probability)

      # Chooses an input position uniformly. Empty input returns None without a draw.
      # @param items [[X]] values to choose from
      # @return [(X?, Generator)] optional value and advanced state
      let choice(items: [X]) -> (X?, Generator) = drawChoice(this, items)

      # Selects input positions without replacement, in random order.
      # Duplicate input values may appear more than once in the result.
      # A count larger than the input selects every position; zero consumes no draws.
      # @param items [[X]] population; unchanged by sampling
      # @param count [Integer] nonnegative number of positions to select
      # @return [([X], Generator)] selected values and advanced state
      # @example Deal five cards reproducibly
      #   let (hand, advanced) = Random.seeded(42).sample(cards, count: 5)
      let sample(items: [X], count: Integer) -> ([X], Generator) = drawSample(this, items, count)

      # Returns a random permutation, preserving duplicates and the input itself.
      # Empty input consumes no draws.
      # @param items [[X]] values to shuffle
      # @return [([X], Generator)] permutation and advanced state
      let shuffle(items: [X]) -> ([X], Generator) = drawSample(this, items, items.count)
    end
  end

  # Draws an integer from an inclusive range using fresh entropy.
  # @param range [Range<Integer>] ascending inclusive bounds, span at most 2^64
  # @return [Integer] drawn value
  foul integer(range: Range<Integer>) -> Integer do
    let (value, _) = drawInteger(fresh, range)
    value
  end

  # Draws a float; defaults to [0.0, 1.0). The upper bound is excluded.
  # @param range [Range<Float>] finite, strictly ascending bounds
  # @return [Float] drawn value
  foul float(range: Range<Float> = 0.0..1.0) -> Float do
    let (value, _) = drawFloat(fresh, range)
    value
  end

  # Draws a fair coin flip using fresh entropy.
  # @return [Bool] true or false with equal probability
  foul boolean -> Bool do
    let (value, _) = drawBoolean(fresh)
    value
  end

  # Returns true with the supplied probability using fresh entropy.
  # @param probability [Float] probability from 0.0 through 1.0
  # @return [Bool] sampled outcome
  foul chance?(probability: Float) -> Bool do
    let (value, _) = drawChance(fresh, probability)
    value
  end

  # Chooses a position uniformly, returning None for an empty input.
  # @param items [[X]] values to choose from
  # @return [X?] chosen value, if any
  foul choice(items: [X]) -> X? do
    let (value, _) = drawChoice(fresh, items)
    value
  end

  # Samples positions without replacement; duplicate values remain possible.
  # @param items [[X]] population
  # @param count [Integer] nonnegative count; capped at the input size
  # @return [[X]] values selected in random order
  foul sample(items: [X], count: Integer) -> [X] do
    let (value, _) = drawSample(fresh, items, count)
    value
  end

  # Returns a random permutation using fresh entropy.
  # @param items [[X]] values to shuffle
  # @return [[X]] shuffled copy
  foul shuffle(items: [X]) -> [X] do
    let (value, _) = drawSample(fresh, items, items.count)
    value
  end

  private do
    let drawInteger(source: Generator, range: Range<Integer>) -> (Integer, Generator) do
      let (low, high) = integerBounds(range)
      integerBetween(source, low, high)
    end

    let drawFloat(source: Generator, range: Range<Float>) -> (Float, Generator) do
      let (low, high) = floatBounds(range)
      if !(low < high)
        die("Random.float: bounds must be finite and strictly ascending")
      end
      let (word, advanced) = nextWord(source)
      let unit = (Kex.Intrinsic.Bits.shiftRight(word, 11) * 1.0) / 9007199254740992.0
      (Kex.Intrinsic.Float.scaleUnit(low, high, unit), advanced)
    end

    let drawBoolean(source: Generator) -> (Bool, Generator) do
      let (word, advanced) = nextWord(source)
      (Kex.Intrinsic.Bits.shiftRight(word, 63) == 1, advanced)
    end

    let drawChance(source: Generator, probability: Float) -> (Bool, Generator) do
      if !(probability >= 0.0 && probability <= 1.0)
        die("Random.chance?: probability must be between 0.0 and 1.0")
      end
      let (value, advanced) = drawFloat(source, 0.0..1.0)
      (value < probability, advanced)
    end

    let drawChoice(source: Generator, items: [X]) -> (X?, Generator) do
      return (None, source) if items.empty?
      let (index, advanced) = below(source, items.count)
      (items.at(index), advanced)
    end

    let drawSample(source: Generator, items: [X], count: Integer) -> ([X], Generator) do
      if count < 0
        die("Random.sample: count must not be negative")
      end
      var pool = items
      var selected: [X] = []
      var generator = source
      while !pool.empty? && selected.count < count do
        let (index, advanced) = below(generator, pool.count)
        generator = advanced
        selected.push!(pool.at(index).try)
        pool = pool.take(index) + pool.drop(index + 1)
      end
      (selected, generator)
    end

    integerBetween : Generator -> Integer -> Integer -> (Integer, Generator)
    let integerBetween(generator, low, high) do
      if low > high
        die("Random.integer: lower bound must not exceed upper bound")
      end
      let (value, advanced) = below(generator, high - low + 1)
      (low + value, advanced)
    end

    integerBounds : Range<Integer> -> (Integer, Integer)
    let integerBounds(range) = Kex.Intrinsic.Range.bounds(range)

    floatBounds : Range<Float> -> (Float, Float)
    let floatBounds(range) = Kex.Intrinsic.Range.bounds(range)

    # SplitMix64's arithmetic stays private; public operations expose values.
    nextWord : Generator -> (Integer, Generator)
    let nextWord(generator: Generator) -> (Integer, Generator) do
      let mask = 18446744073709551615
      let advanced = Kex.Intrinsic.Bits.and(generator.state + 0x9e3779b97f4a7c15, mask)
      let spread1 = Kex.Intrinsic.Bits.xor(advanced, Kex.Intrinsic.Bits.shiftRight(advanced, 30))
      let mixed1 = Kex.Intrinsic.Bits.and(spread1 * 0xbf58476d1ce4e5b9, mask)
      let spread2 = Kex.Intrinsic.Bits.xor(mixed1, Kex.Intrinsic.Bits.shiftRight(mixed1, 27))
      let mixed2 = Kex.Intrinsic.Bits.and(spread2 * 0x94d049bb133111eb, mask)
      let word = Kex.Intrinsic.Bits.xor(mixed2, Kex.Intrinsic.Bits.shiftRight(mixed2, 31))
      (word, Generator { state: advanced })
    end

    below : Generator -> Integer -> (Integer, Generator)
    let below(generator: Generator, bound: Integer) -> (Integer, Generator) do
      let maximum = 18446744073709551616
      if bound <= 0 || bound > maximum
        die("Random.integer: range must contain between 1 and 2^64 integers")
      end
      let (word, advanced) = nextWord(generator)
      let limit = maximum - maximum.modulo(bound)
      return (word.modulo(bound), advanced) if word < limit
      below(advanced, bound)
    end
  end
end
