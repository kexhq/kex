# Random numbers, choices and shuffles, for simulations, games and
# reproducible tests.
#
# Nothing here is in scope until +using Random+. The module functions, such
# as +Random.integer+, draw from fresh entropy and return the value. For a
# sequence that can be replayed, start a +Random.Generator+ with
# +Random.seeded+: each of its functions returns +(value, nextGenerator)+,
# and the next draw is made from +nextGenerator+. Drawing twice from the
# same generator gives the same value twice.
#
# Invalid arguments, such as a descending range or a probability above 1,
# end the program with +die+.
#
# @example Rolling a die and picking a weight
#   using Random
#   let roll = Random.integer(1..6)
#   let weight = Random.float(-1.0..1.0)
#
# @example Replaying a sequence
#   let generator = Random.seeded(42)
#   let (first, afterFirst) = generator.integer(1..6)      # first is 2
#   let (second, afterSecond) = afterFirst.integer(1..6)   # second is 2
#
# None of this is suitable for secrets such as keys or tokens. Use
# +Random.secureBytes+ or +Random.token+ for those.
module Random do
  # The state of a reproducible random sequence.
  #
  # Start one with +Random.seeded+ or +Random.fresh+. Each draw returns the
  # value and the advanced generator. The same seed gives the same sequence
  # for the same calls, on the walker and on BEAM.
  record Generator do
    state : Integer = 0
  end

  # Starts a reproducible sequence from +seed+.
  #
  # Any Integer works, negative or large; it is reduced modulo 2^64.
  #
  # @param seed [Integer] the seed
  # @return [Generator] a generator from which nothing has been drawn yet
  #
  # @example
  #   let (roll, advanced) = Random.seeded(42).integer(1..6)   # roll is 2, every time
  let seeded(seed: Integer) -> Generator = Generator {
    state: seed.modulo(18446744073709551616)
  }

  # Starts a generator from fresh entropy, so the sequence differs between
  # runs.
  #
  # @return [Generator] a generator from which nothing has been drawn yet
  foul fresh -> Generator do
    let high = Math.floor(Kex.Intrinsic.Retry.randomUnit() * 4294967296.0)
    let low = Math.floor(Kex.Intrinsic.Retry.randomUnit() * 4294967296.0)
    seeded(high * 4294967296 + low)
  end

  module Generator do
    make Random.Generator do
      # Draws an integer from +range+, both ends included.
      #
      # The range must be ascending and hold at most 2^64 integers. A range
      # of one integer is allowed and still advances the generator.
      #
      # @param range [Range<Integer>] the bounds, both included
      # @return [(Integer, Generator)] the integer and the advanced generator
      #
      # @example A reproducible die roll
      #   let (roll, advanced) = Random.seeded(42).integer(1..6)   # roll is 2
      let integer(range: Range<Integer>) -> (Integer, Generator) = drawInteger(this, range)

      # Draws a float from +range+, which includes its lower bound and
      # excludes its upper one.
      #
      # Without an argument the range is +0.0..1.0+. The bounds must be finite
      # and strictly ascending.
      #
      # @param range [Range<Float>] the bounds, upper one excluded
      # @return [(Float, Generator)] the float and the advanced generator
      #
      # @example Initializing a model weight
      #   let (weight, advanced) = Random.seeded(42).float(-1.0..1.0)
      let float(range: Range<Float>) -> (Float, Generator) = drawFloat(this, range)
      let float -> (Float, Generator) = drawFloat(this, 0.0..1.0)

      # Draws +true+ or +false+ with equal probability.
      #
      # @return [(Bool, Generator)] the result and the advanced generator
      let boolean -> (Bool, Generator) = drawBoolean(this)

      # Draws +true+ with the given probability.
      #
      # Even a probability of 0 or 1 advances the generator.
      #
      # @param probability [Float] the probability, from 0.0 to 1.0
      # @return [(Bool, Generator)] the result and the advanced generator
      let chance?(probability: Float) -> (Bool, Generator) = drawChance(this, probability)

      # Picks one element of +items+, each position equally likely.
      #
      # For an empty list it returns +None+ and the generator unchanged.
      #
      # @param items [[X]] the values to choose from
      # @return [(X?, Generator)] the chosen value, and the advanced generator
      let choice(items: [X]) -> (X?, Generator) = drawChoice(this, items)

      # Picks +count+ elements of +items+ without replacement, in random order.
      #
      # Each position is picked at most once, but a value that occurs several
      # times in +items+ can occur several times in the result. A +count+
      # larger than the list returns every element, shuffled. A +count+ of 0
      # returns +[]+ and leaves the generator unchanged; a negative one ends
      # the program.
      #
      # @param items [[X]] the values to pick from
      # @param count [Integer] how many to pick, at least 0
      # @return [([X], Generator)] the picked values and the advanced generator
      #
      # @example Dealing five cards reproducibly
      #   let (hand, advanced) = Random.seeded(42).sample(cards, count: 5)
      let sample(items: [X], count: Integer) -> ([X], Generator) = drawSample(this, items, count)

      # Returns +items+ in random order.
      #
      # An empty list leaves the generator unchanged.
      #
      # @param items [[X]] the values to shuffle
      # @return [([X], Generator)] the shuffled list and the advanced generator
      #
      # @example
      #   let (deck, advanced) = Random.seeded(42).shuffle([1, 2, 3, 4])   # deck is [2, 3, 1, 4]
      let shuffle(items: [X]) -> ([X], Generator) = drawSample(this, items, items.count)
    end
  end

  # Draws an integer from +range+, both ends included.
  #
  # The range must be ascending and hold at most 2^64 integers.
  #
  # @param range [Range<Integer>] the bounds, both included
  # @return [Integer] the integer
  #
  # @example
  #   let roll = Random.integer(1..6)
  foul integer(range: Range<Integer>) -> Integer do
    let (value, _) = drawInteger(fresh, range)
    value
  end

  # Draws a float from +range+, which includes its lower bound and excludes
  # its upper one.
  #
  # The range defaults to +0.0..1.0+. The bounds must be finite and strictly
  # ascending.
  #
  # @param range [Range<Float>] the bounds, upper one excluded
  # @return [Float] the float
  foul float(range: Range<Float> = 0.0..1.0) -> Float do
    let (value, _) = drawFloat(fresh, range)
    value
  end

  # Returns +true+ or +false+ with equal probability.
  #
  # @return [Bool] the result
  foul boolean -> Bool do
    let (value, _) = drawBoolean(fresh)
    value
  end

  # Returns +true+ with the given probability.
  #
  # @param probability [Float] the probability, from 0.0 to 1.0
  # @return [Bool] the result
  #
  # @example
  #   let critical = Random.chance?(0.05)
  foul chance?(probability: Float) -> Bool do
    let (value, _) = drawChance(fresh, probability)
    value
  end

  # Picks one element of +items+, each position equally likely, or returns
  # +None+ for an empty list.
  #
  # @param items [[X]] the values to choose from
  # @return [X?] the chosen value, or +None+
  foul choice(items: [X]) -> X? do
    let (value, _) = drawChoice(fresh, items)
    value
  end

  # Picks +count+ elements of +items+ without replacement, in random order.
  #
  # Each position is picked at most once, but a repeated value can be picked
  # more than once. A +count+ larger than the list returns every element.
  #
  # @param items [[X]] the values to pick from
  # @param count [Integer] how many to pick, at least 0
  # @return [[X]] the picked values
  foul sample(items: [X], count: Integer) -> [X] do
    let (value, _) = drawSample(fresh, items, count)
    value
  end

  # Returns +items+ in random order.
  #
  # @param items [[X]] the values to shuffle
  # @return [[X]] the shuffled list
  foul shuffle(items: [X]) -> [X] do
    let (value, _) = drawSample(fresh, items, items.count)
    value
  end

  # Returns +count+ bytes from the operating system's cryptographically
  # secure generator.
  #
  # Use it for keys, session tokens and identifiers that must not be
  # guessable; the other functions in this module are not fit for that. The
  # bytes cannot be reproduced, and there is no +Generator+ version.
  #
  # @param count [Integer] how many bytes; 0 or less gives an empty binary
  # @return [Binary] the random bytes
  #
  # @example A 256-bit key
  #   let key = Random.secureBytes(32)
  foul secureBytes(count: Integer) -> Binary = Kex.Intrinsic.Random.secureBytes(count)

  # Returns +bytes+ secure random bytes as lowercase hex, a string twice as
  # long as +bytes+.
  #
  # @param bytes [Integer] how many random bytes; 32 if omitted
  # @return [String] the token
  #
  # @example A session identifier
  #   Random.token(32)   # => "9f86d081884c7d65..." (64 characters)
  foul token(bytes: Integer = 32) -> String = secureBytes(bytes).hex

  private do
    let drawInteger(source: Generator, range: Range<Integer>) -> (Integer, Generator) do
      let (low, high) = integerBounds(range)
      integerBetween(source, low, high)
    end

    let drawFloat(source: Generator, range: Range<Float>) -> (Float, Generator) do
      let (low, high) = floatBounds(range)
      if !(low < high)
        die("Random.float: bounds must be finite and strictly ascending")
      end
      let (word, advanced) = nextWord(source)
      let unit = (Kex.Intrinsic.Bits.shiftRight(word, 11) * 1.0) / 9007199254740992.0
      (Kex.Intrinsic.Float.scaleUnit(low, high, unit), advanced)
    end

    let drawBoolean(source: Generator) -> (Bool, Generator) do
      let (word, advanced) = nextWord(source)
      (Kex.Intrinsic.Bits.shiftRight(word, 63) == 1, advanced)
    end

    let drawChance(source: Generator, probability: Float) -> (Bool, Generator) do
      if !(probability >= 0.0 && probability <= 1.0)
        die("Random.chance?: probability must be between 0.0 and 1.0")
      end
      let (value, advanced) = drawFloat(source, 0.0..1.0)
      (value < probability, advanced)
    end

    let drawChoice(source: Generator, items: [X]) -> (X?, Generator) do
      return (None, source) if items.empty?
      let (index, advanced) = below(source, items.count)
      (items.at(index), advanced)
    end

    let drawSample(source: Generator, items: [X], count: Integer) -> ([X], Generator) do
      if count < 0
        die("Random.sample: count must not be negative")
      end
      var pool = items
      var selected: [X] = []
      var generator = source
      while !pool.empty? && selected.count < count do
        let (index, advanced) = below(generator, pool.count)
        generator = advanced
        let Just(picked) = pool.at(index)
        selected.push!(picked)
        pool = pool.take(index) + pool.drop(index + 1)
      end
      (selected, generator)
    end

    integerBetween : Generator -> Integer -> Integer -> (Integer, Generator)
    let integerBetween(generator, low, high) do
      if low > high
        die("Random.integer: lower bound must not exceed upper bound")
      end
      let (value, advanced) = below(generator, high - low + 1)
      (low + value, advanced)
    end

    integerBounds : Range<Integer> -> (Integer, Integer)
    let integerBounds(range) = Kex.Intrinsic.Range.bounds(range)

    floatBounds : Range<Float> -> (Float, Float)
    let floatBounds(range) = Kex.Intrinsic.Range.bounds(range)

    # SplitMix64's arithmetic stays private; public operations expose values.
    nextWord : Generator -> (Integer, Generator)
    let nextWord(generator: Generator) -> (Integer, Generator) do
      let mask = 18446744073709551615
      let advanced = Kex.Intrinsic.Bits.and(generator.state + 0x9e3779b97f4a7c15, mask)
      let spread1 = Kex.Intrinsic.Bits.xor(advanced, Kex.Intrinsic.Bits.shiftRight(advanced, 30))
      let mixed1 = Kex.Intrinsic.Bits.and(spread1 * 0xbf58476d1ce4e5b9, mask)
      let spread2 = Kex.Intrinsic.Bits.xor(mixed1, Kex.Intrinsic.Bits.shiftRight(mixed1, 27))
      let mixed2 = Kex.Intrinsic.Bits.and(spread2 * 0x94d049bb133111eb, mask)
      let word = Kex.Intrinsic.Bits.xor(mixed2, Kex.Intrinsic.Bits.shiftRight(mixed2, 31))
      (word, Generator { state: advanced })
    end

    below : Generator -> Integer -> (Integer, Generator)
    let below(generator: Generator, bound: Integer) -> (Integer, Generator) do
      let maximum = 18446744073709551616
      if bound <= 0 || bound > maximum
        die("Random.integer: range must contain between 1 and 2^64 integers")
      end
      let (word, advanced) = nextWord(generator)
      let limit = maximum - maximum.modulo(bound)
      return (word.modulo(bound), advanced) if word < limit
      below(advanced, bound)
    end
  end
end
