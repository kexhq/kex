make String, implement: Enumerable, Foldable do
  # Enumerable primitive and string-preserving higher-order operations.
  # The private List intrinsics understand String's [Char] representation;
  # the public methods remain owned here in Kex source.
  reduce :> A -> (A -> Char -> A) -> A
  let reduce(acc, f) = Kex.Intrinsic.List.foldLeft(this, acc, f)

  # No `map` override: the Enumerable default collects into a list, which is
  # what `(Char -> B) -> [B]` says. A String-in/String-out mapping is a
  # different operation with a different type, so it gets its own name.
  #
  # @param f [Char -> Char]
  # @return [String]
  #
  # @example
  #   "hi".mapChars(&.upperCase)   # => "HI"
  #   "hi".map(&.upperCase)        # => ['H', 'I']  (a list, per Enumerable)
  mapChars :> (Char -> Char) -> String
  let mapChars(f) = Kex.Intrinsic.List.map(this, f)

  filter :> (Char -> Bool) -> String
  let filter(pred) = Kex.Intrinsic.List.filter(this, pred)

  uniq :> String
  let uniq = Kex.Intrinsic.List.uniq(this)

  # A String is its OWN type, not a [Char] — `chars` converts between them.
  # So the sequence operations below are declared here rather than inherited
  # from List, and they answer in String's terms: `take`/`drop`/`sort` hand
  # back a String, while `first`/`last` hand back a Char. The List intrinsics
  # they delegate to already understand the String representation, so there is
  # one implementation for both backends.

  # Returns the first character, or None when the string is empty.
  #
  # @return [Char?]
  #
  # @example
  #   "hi".first   # => Just('h')
  #   "".first     # => None
  first :> Char?
  let first = Kex.Intrinsic.List.first(this)

  # Returns the last character, or None when the string is empty.
  #
  # @return [Char?]
  #
  # @example
  #   "hi".last   # => Just('i')
  last :> Char?
  let last = Kex.Intrinsic.List.last(this)

  # Returns the character at +i+, or None when out of range.
  #
  # @param i [Integer]
  # @return [Char?]
  #
  # @example
  #   "hi".get(1)   # => 'i'
  get :> Integer -> Char?
  let get(i) = Kex.Intrinsic.List.get(this, i)

  # Returns the character at +i+, or +default+ when out of range.
  #
  # @param i [Integer]
  # @param default [Char]
  # @return [Char]
  get :> Integer -> Char -> Char
  let get(i, default) = Kex.Intrinsic.List.get(this, i, default)

  # Returns the first +n+ characters.
  #
  # @param n [Integer]
  # @return [String]
  #
  # @example
  #   "hello".take(2)   # => "he"
  take :> Integer -> String
  let take(n) = Kex.Intrinsic.List.take(this, n)

  # Returns everything after the first +n+ characters.
  #
  # @param n [Integer]
  # @return [String]
  #
  # @example
  #   "hello".drop(2)   # => "llo"
  drop :> Integer -> String
  let drop(n) = Kex.Intrinsic.List.drop(this, n)

  # Returns the characters that do NOT satisfy the predicate — filter's
  # complement.
  #
  # @param pred [Char -> Bool]
  # @return [String]
  #
  # @example
  #   "hello".reject { |c| c == 'l' }   # => "heo"
  reject :> (Char -> Bool) -> String
  let reject(pred) = Kex.Intrinsic.List.reject(this, pred)

  # Returns the characters in ascending order.
  #
  # @return [String]
  #
  # @example
  #   "hello".sort   # => "ehllo"
  sort :> String
  let sort = Kex.Intrinsic.List.sort(this)

  # Returns the index of the first occurrence of +c+, or None.
  #
  # @param c [Char]
  # @return [Integer?]
  #
  # @example
  #   "hello".indexOf('l')   # => 2
  indexOf :> Char -> Integer?
  let indexOf(c) = Kex.Intrinsic.List.indexOf(this, c)

  # Returns the index of the first character satisfying the predicate, or
  # None. Goes through `chars` because there is no direct intrinsic.
  #
  # @param pred [Char -> Bool]
  # @return [Integer?]
  #
  # @example
  #   "hello".findIndex { |c| c == 'l' }   # => 2
  findIndex :> ((Char) -> Bool) -> Integer?
  let findIndex(pred) = this.chars.findIndex(pred)

  # Pairs each character with the element at the same index in +other+,
  # stopping at the shorter of the two.
  #
  # @param other [[Y]]
  # @return [[(Char, Y)]]
  #
  # @example
  #   "ab".zip([1, 2])   # => [('a', 1), ('b', 2)]
  zip :> [Y] -> [(Char, Y)]
  let zip(other) = Kex.Intrinsic.List.zip(this, other)

  # Splits into the characters that satisfy the predicate and those that do
  # not, in that order.
  #
  # @param pred [Char -> Bool]
  # @return [(String, String)]
  #
  # @example
  #   "hello".partition { |c| c == 'l' }   # => ("ll", "heo")
  partition :> (Char -> Bool) -> (String, String)
  let partition(pred) = Kex.Intrinsic.List.partition(this, pred)

  # Returns the number of characters in the string.
  #
  # @return [Integer]
  #
  # @example
  #   "hello".count   # => 5
  #   "".count        # => 0
  count :> Integer
  let count = Kex.Intrinsic.List.length(this)

  # Compatibility spelling retained as a source-owned String method.
  length :> Integer
  let length = Kex.Intrinsic.List.length(this)

  # Returns +true+ if the string contains no characters.
  #
  # @return [Bool]
  #
  # @example
  #   "".empty?       # => true
  #   "hi".empty?     # => false
  empty? :> Bool
  let empty? = Kex.Intrinsic.List.length(this) == 0

  # Returns an enclosed string, with +wrapper+ on both ends.
  # @param wrapper String
  # @return String
  # @example
  #   "hello".enclose("*")   # => "*hello*"
  #   "hello".enclose("__")   # => "__hello__"
  enclose :> String -> String
  let enclose(wrapper) = "${wrapper}${this}${wrapper}"

  # Returns an enclosed string, +left+ and +right+ on the ends.
  # @param left String
  # @param right String
  # @return String
  # @example
  #   "hello".enclose("<", ">")   # => "<hello>"
  #   "hello".enclose("{", "}")   # => "{hello}"
  enclose :> String -> String -> String
  let enclose(left, right) = "${left}${this}${right}"

  # Returns the character at position +i+ (0-based), or +None+ if out of range.
  #
  # @param i [Integer]
  # @return [Char?]
  #
  # @example
  #   "hello".at(1)   # => Just('e')
  #   "hello".at(9)   # => None
  at :> Integer -> Char?
  let at(i) = Kex.Intrinsic.List.at(this, i)

  # Returns the second character wrapped in +Just+, or +None+ when absent.
  second :> Char?
  let second = Kex.Intrinsic.List.first(Kex.Intrinsic.List.drop(this, 1))

  # Returns the third character wrapped in +Just+, or +None+ when absent.
  third :> Char?
  let third = Kex.Intrinsic.List.first(Kex.Intrinsic.List.drop(this, 2))

  # Returns all characters after the first.
  rest :> String
  let rest = Kex.Intrinsic.List.drop(this, 1)

  # Returns a list of the individual characters in the string.
  #
  # @return [[Char]]
  #
  # @example
  #   "hi".chars   # => ['h', 'i']
  chars :> [Char]
  let chars = Kex.Intrinsic.String.chars(this)

  # Returns the string's UTF-8 encoding, one Byte per byte.
  #
  # `chars` is the TEXT view of a String and `bytes` is the STORAGE view, so
  # they differ for anything outside ASCII: "é" is one Char and two Bytes.
  #
  # @return [[Byte]]
  #
  # @example
  #   "hi".bytes    # => [104, 105]
  #   "é".bytes     # => [195, 169]
  #   "é".chars     # => ['é']
  bytes :> [Byte]
  let bytes = Kex.Intrinsic.String.bytes(this)

  # Splits on every occurrence of +sep+. With no argument, splits into
  # individual characters.
  #
  # @param sep [String]
  # @return [[String]]
  #
  # @example
  #   "a,b,c".split(",")   # => ["a", "b", "c"]
  #   "hi".split           # => ["h", "i"]
  # Separator-less: one part per character, as the example above shows. Only
  # the intrinsic had this form, so the walker answered `"hi".split` with
  # "'this' used outside of a method context" while BEAM returned the parts.
  # Declared BEFORE the separator form, as `sort` is in list.kex: the walker
  # resolves a no-argument call against the first clause of that name.
  split :> [String]
  let split = Kex.Intrinsic.String.split(this)

  split :> (String | Regex) -> [String]
  let split(sep) = Kex.Intrinsic.String.split(this, sep)

  # Splits into lines on +\n+, dropping a single trailing newline so a file
  # ending in one does not yield a final empty line. Windows line endings are
  # not stripped — split on +\r\n+ explicitly if that matters.
  #
  # @return [[String]]
  #
  # @example
  #   "a\nb".lines      # => ["a", "b"]
  #   "a\nb\n".lines    # => ["a", "b"]
  #   "".lines          # => []
  lines :> [String]
  let lines do
    let parts = this.split("\n")
    match parts.last do
      Just("") => parts.take(parts.count - 1)
      _        => parts
    end
  end
  split :> [String]
  let split = Kex.Intrinsic.String.split(this)

  # Replaces every literal occurrence of +pattern+. An empty pattern matches
  # at every character boundary, including both ends.
  #
  # @param pattern [String]
  # @param replacement [String]
  # @return [String]
  #
  # @example
  #   "a-b-c".replace("-", "+")   # => "a+b+c"
  #   "abc".replace("", "-")      # => "-a-b-c-"
  replace :> String -> String -> String
  let replace(pattern, replacement) = Kex.Intrinsic.String.replace(this, pattern, replacement)

  # Replaces every key of +replacements+ with its value, in one pass over the
  # map. The keys are the placeholders exactly as written — no syntax is
  # imposed, and nothing is reserved — so `$NAME$`, `__NAME__`, `{{name}}` and
  # `%name%` are all equally valid, and a template needs no escaping to be a
  # template. `$NAME$` is the convention to reach for when there is no reason
  # to prefer another.
  #
  # Note that a placeholder is NOT `${name}`: that is interpolation, which the
  # compiler resolves before this ever sees the string.
  #
  # This is what a template wants instead of a chain of `.replace` calls: the
  # chain reads as a pipeline when it is really a substitution table, and it
  # quietly depends on its own order, since an earlier replacement's OUTPUT is
  # still visible to every later one.
  #
  # Substitutions are applied in the map's canonical key order and each is
  # applied to the result of the last, so a value that itself contains a key
  # can still be rewritten by a later one. Keep values placeholder-free when
  # that matters.
  #
  # @param replacements [{String: String}]
  # @return [String]
  #
  # @example
  #   "Hello, $WHO$!".substitute({"$WHO$": "world"})           # => "Hello, world!"
  #   "$A$ and $B$".substitute({"$A$": "x", "$B$": "y"})       # => "x and y"
  #   "__A__".substitute({"__A__": "any key works"})           # => "any key works"
  substitute :> {String: String} -> String
  let substitute(replacements) = replacements.entries.reduce(this) do |text, entry|
    let (key, value) = entry
    text.replace(key, value)
  end

  # Removes leading and trailing whitespace.
  #
  # @return [String]
  #
  # @example
  #   "  hello  ".trim   # => "hello"
  trim :> String
  let trim = Kex.Intrinsic.String.trim(this)

  # Returns the string with all characters converted to upper case.
  #
  # @return [String]
  #
  # @example
  #   "hello".upperCase   # => "HELLO"
  upperCase :> String
  let upperCase = Kex.Intrinsic.String.upperCase(this)

  # Returns the string with all characters converted to lower case.
  #
  # @return [String]
  #
  # @example
  #   "HELLO".lowerCase   # => "hello"
  lowerCase :> String
  let lowerCase = Kex.Intrinsic.String.lowerCase(this)

  # Returns the string with its first character upper-cased and the rest
  # LOWER-cased, matching Ruby's String#capitalize — so "hELLO" becomes
  # "Hello", not "HELLO". Unlike +upperCase+, which shouts the whole string.
  #
  # Needed to build type names from data: a generated `type %name = ...`
  # inside a `compiled do` block requires an upper-case identifier, so a list
  # of lower-case words has to be capitalized first.
  #
  # @return [String]
  #
  # @example
  #   "hello".capitalize          # => "Hello"
  #   "hELLO".capitalize          # => "Hello"   (tail is lower-cased)
  #   "already Capital".capitalize # => "Already capital"
  #   "".capitalize               # => ""
  capitalize :> String
  # Destructures the characters rather than using `"${at(0).upperCase}${rest}"`:
  # `rest` returns an empty LIST instead of an empty String when nothing
  # remains, so that spelling gave "A[]" for "a".capitalize on the BEAM
  # backend. See the note on `rest` — the bug is there, not here.
  # The natural spelling is a RECEIVER pattern, matching on `this` directly:
  #
  #     let capitalize(@[])       = ""
  #     let capitalize(@[c | cs]) = "${c.upperCase}${cs.lowerCase}"
  #
  # It parses and works in the interpreter, but the backends disagree on what
  # the tail binds to: a String in the interpreter, a [Char] on BEAM.
  #
  # Re-encoding the BEAM side to a binary looks like the fix and is NOT: the
  # `[Char]`-is-String equivalence is load-bearing for composition. Making
  # `filter` hand back a binary breaks `["hello","world"].flatMap { |s|
  # s.filter(~alpha?) }` (spec/list_hof.kex) with a badarg, because flatMap
  # needs a list to flatten. Any real fix has to keep both readings working.
  # Until then `chars` is explicit on both backends.
  let capitalize = match this.chars do
    []       => ""
    [c | cs] => "${c.upperCase}${cs.join("").lowerCase}"
  end

  # Returns the string with its characters in reverse order.
  #
  # @return [String]
  #
  # @example
  #   "hello".reverse   # => "olleh"
  reverse :> String
  let reverse = Kex.Intrinsic.List.reverse(this)

  # Returns +true+ if +sub+ appears anywhere within the string.
  #
  # @param sub [String]
  # @return [Bool]
  #
  # @example
  #   "hello world".contains?("world")   # => true
  #   "hello world".contains?("xyz")     # => false
  contains? :> String -> Bool
  let contains?(sub) = Kex.Intrinsic.String.contains?(this, sub)

  # Returns +true+ if the string begins with +prefix+.
  #
  # @param prefix [String]
  # @return [Bool]
  #
  # @example
  #   "hello".startsWith?("hel")   # => true
  #   "hello".startsWith?("llo")   # => false
  startsWith? :> String -> Bool
  let startsWith?(prefix) = Kex.Intrinsic.String.startsWith?(this, prefix)

  # Returns +true+ if the string ends with +suffix+.
  #
  # @param suffix [String]
  # @return [Bool]
  #
  # @example
  #   "hello".endsWith?("llo")   # => true
  #   "hello".endsWith?("hel")   # => false
  endsWith? :> String -> Bool
  let endsWith?(suffix) = Kex.Intrinsic.String.endsWith?(this, suffix)

  # Converts to another type. The most common target is +Integer+ or +Float+.
end

make Char do
  # A Char and a String are distinct types, so converting between them is
  # explicit. `to(String)` is the fallible protocol and answers `String?` like
  # every other conversion; `string` is the total one, because a character is
  # always one character of text and has no failure case to report. It is the
  # single-character counterpart of `String.chars` and `[Char].join("")`.
  #
  #   'a'.string                      # => "a"
  #   'a'.to(String)                  # => Just("a")
  #   "hi".chars.map(&.string)        # => ["h", "i"]
  string :> String
  let string = this.showValue

  # Converts this character to upper/lower case while preserving Char.
  upperCase :> Char
  let upperCase = Kex.Intrinsic.String.upperCase(this)
  lowerCase :> Char
  let lowerCase = Kex.Intrinsic.String.lowerCase(this)

  # Returns +true+ if the character is a decimal digit (+0+..+9+).
  #
  # @return [Bool]
  #
  # @example
  #   '3'.digit?   # => true
  #   'a'.digit?   # => false
  digit? :> Bool
  let digit? = Kex.Intrinsic.Char.is_digit(this)
  alpha? :> Bool
  let alpha? = Kex.Intrinsic.Char.is_alpha(this)
  letter? :> Bool
  let letter? = Kex.Intrinsic.Char.is_letter(this)
  upper? :> Bool
  let upper? = Kex.Intrinsic.Char.is_upper(this)
  lower? :> Bool
  let lower? = Kex.Intrinsic.Char.is_lower(this)
  space? :> Bool
  let space? = Kex.Intrinsic.Char.is_space(this)

  # Returns this character's numeric codepoint.
  codepoint :> Integer
  let codepoint = Kex.Intrinsic.Char.codepoint(this)

  # Returns +true+ if the character falls within the given range (inclusive).
  #
  # @param range [Range<Char>]
  # @return [Bool]
  #
  # @example
  #   'b'.in?('a'..'z')   # => true
  #   'B'.in?('a'..'z')   # => false
  in? :> Range<Char> -> Bool
  let in?(range) = Kex.Intrinsic.List.member(this, range)
end

module String do
  # Constructs a one-codepoint UTF-8 string. Surrogates and values outside
  # the Unicode scalar range return None.
  fromCodepoint : Integer -> String?
  let fromCodepoint(value) = Kex.Intrinsic.String.fromCodepoint(value)

  # Rebuilds a String from its UTF-8 bytes — the inverse of `bytes`. A String
  # is TEXT, so bytes outside 0..255 or a malformed encoding return None
  # rather than a string that would decode to replacement characters.
  #
  #   String.fromBytes([104, 105])    # => Just("hi")
  #   String.fromBytes([195, 169])    # => Just("é")
  #   String.fromBytes([255])         # => None
  fromBytes : [Byte] -> String?
  let fromBytes(values) = Kex.Intrinsic.String.fromBytes(values)
end

make Tuple do
  # Returns the tuple's elements as a list.
  #
  # A tuple is not a list — its arity is part of its type — so the List
  # methods do not apply to it. This is the explicit conversion.
  #
  # @return [[Any]]
  #
  # @example
  #   (1, "a").items   # => [1, "a"]
  items :> [Any]
  let items = Kex.Intrinsic.Tuple.items(this)
end
