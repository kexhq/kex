# Declarative command-line parsing shared by Kex tools and applications.
type OptionKind = StringValue | IntegerValue | FlagValue

record OptionSpec do
  long : String
  short : Char? = None
  kind : OptionKind = StringValue
  description : String = ""
  default : String? = None
  required? : Bool = false
end

# What a command does once the line has been parsed. It receives the parsed
# options with the command's own words already removed, so `tey add greet`
# hands its handler `["greet"]`, and returns the process exit code.
type CommandHandler = ParsedOptions -> Integer

record CommandSpec do
  # A name may be several words — `kex install` — and the longest match wins,
  # so a group and its subcommands can both be declared.
  name : String
  description : String = ""
  usage : String = ""
  handler : CommandHandler
  # The help heading this command is listed under. "" is the tool's own
  # `Commands:` block; anything else gets its own heading, in the order the
  # sections were first declared. Commands a tool discovers at runtime — a
  # package manifest's own — are not the tool's vocabulary, and a reader who
  # cannot tell which is which has to guess where to file a bug.
  section : String = ""
end

record OptionConfig do
  name : String = "app"
  description : String = ""
  options : [OptionSpec] = []
  commands : [CommandSpec] = []
end

record ParsedOptions do
  values : { String: String }
  arguments : [String]
end

type OptionParseError = UnknownOption(String)
                      | MissingValue(String)
                      | UnexpectedValue(String)
                      | MissingRequired(String)
                      | InvalidInteger(String, String)

make ParsedOptions do
  let value(name: String) -> String? = @values.get(name)
  let value(name: String, default: String) -> String = @values.get(name, default)
  let flagEnabled?(name: String) -> Bool = @values.get(name, "false") == "true"
  let integerValue(name: String) -> Integer? do
    match @values.get(name) do
      None => None
      Just(value) => match Integer.parse(value) do
        Ok(number) => Just(number)
        Error(_) => None
      end
    end
  end
end

make OptionConfig do
  let string(long: String, short: Char?, description: String,
                   default: String?, required?: Bool) -> OptionConfig do
    let option = OptionSpec { long: long, short: short, kind: StringValue,
                              description: description, default: default,
                              required?: required? }
    New { options: [...@options, option] }
  end

  let integer(long: String, short: Char?, description: String,
                    default: String?, required?: Bool) -> OptionConfig do
    let option = OptionSpec { long: long, short: short, kind: IntegerValue,
                              description: description, default: default,
                              required?: required? }
    New { options: [...@options, option] }
  end

  let flag(long: String, short: Char?, description: String) -> OptionConfig do
    let option = OptionSpec { long: long, short: short, kind: FlagValue,
                              description: description, default: Just("false") }
    New { options: [...@options, option] }
  end

  # Declares a command. `usage` is what the help line shows after the name
  # (`<name>`, `[args...]`); leave it empty for a command that takes none.
  let command(name: String, description: String, handler: CommandHandler) -> OptionConfig do
    let spec = CommandSpec { name: name, description: description,
                             usage: "", handler: handler }
    New { commands: [...@commands, spec] }
  end

  let command(name: String, usage: String, description: String, handler: CommandHandler) -> OptionConfig do
    let spec = CommandSpec { name: name, description: description,
                             usage: usage, handler: handler }
    New { commands: [...@commands, spec] }
  end

  # The same, listed under its own help heading rather than with the tool's
  # built-ins. `section:` is a label at the call site so the fourth string
  # cannot be mistaken for the description.
  let command(name: String, usage: String, description: String, section: String,
              handler: CommandHandler) -> OptionConfig do
    let spec = CommandSpec { name: name, description: description,
                             usage: usage, handler: handler, section: section }
    New { commands: [...@commands, spec] }
  end

  let parse(args: [String]) -> Result<ParsedOptions, OptionParseError> do
    OptionParser.parse(@options, args)
  end

  # Parses `args` and runs the command they name, returning its exit code.
  # A parse failure, an unknown command, or a line with no command at all
  # reports the problem with the help text and returns 1 — the one place that
  # policy has to live for every tool to behave the same way.
  foul run(args: [String]) -> Integer do
    let options = match this.parse(args) do
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${OptionParser.errorMessage(error)}\n\n${this.help}\n")
        return 1
      end
      Ok(value) => value
    end
    return this.printHelp if options.flagEnabled?("help")
    match OptionParser.commandFor(@commands, options.arguments) do
      None => do
        return this.printHelp if options.arguments.empty?
        IO.printError("${Console.RED}error:${Console.RESET} unknown or incomplete command '${Console.BOLD}${options.arguments.first.or("")}${Console.RESET}'\n\n${this.help}\n")
        return 1
      end
      Just(found) => do
        let (spec, rest) = found
        # Bound first, then called: applying a function-valued field directly
        # (`spec.handler(...)`) reads as a method call on the record and fails
        # on both backends. Binding it is the working spelling.
        let handler = spec.handler
        return handler(ParsedOptions { values: options.values, arguments: rest })
      end
    end
  end

  foul printHelp -> Integer do
    IO.printLine(this.help)
    return 0
  end

  # The help text, styled. Every escape comes from `Console`, which the
  # runtime blanks under `--no-colors` and `KEX_COLORS=0`, so the same code
  # produces plain text down a pipe and this needs no second rendering path.
  #
  # Widths are measured on the UNSTYLED label throughout: an escape sequence
  # has a length that a terminal does not draw, so padding computed from a
  # coloured string lines the columns up on paper and nowhere else.
  let help -> String do
    let name = "${Console.BOLD}${@name}${Console.RESET}"
    let title = @description == "" then name else "${name} — ${@description}"
    let lines = @options.map do |option|
      let short = match option.short do
        Just(value) => "${Console.CYAN}-${value}${Console.RESET}, "
        None => "    "
      end
      let required = option.required? then " ${Console.YELLOW}(required)${Console.RESET}" else ""
      let default = match option.default do
        Just(value) => option.kind == FlagValue then "" else " ${Console.DIM}[default: ${value}]${Console.RESET}"
        None => ""
      end
      "  ${short}${Console.CYAN}--${option.long}${Console.RESET}  ${option.description}${required}${default}"
    end
    let optionsText = "${title}\n\n${Console.BOLD}Options:${Console.RESET}\n${lines.join("\n")}"
    return optionsText if @commands.empty?
    let blocks = @commands.map { |command| command.section }.uniq.map do |section|
      let own = section == ""
      let heading = own then "Commands:" else "${section}:"
      # A section exists to say "these came from somewhere else", so its NAMES
      # carry their own colour — that is what a reader scans. The heading
      # stays plain bold like every other heading on the page.
      let nameColor = own then Console.BLUE else Console.MAGENTA
      let listed = @commands.filter { |command| command.section == section }
      # Each block is its own table: a section of short names should not be
      # pushed across the page by the longest built-in three headings up.
      let width = listed.map { |command| OptionParser.commandLabel(command).count }.max.or(0)
      let commandLines = listed.map do |command|
        let label = OptionParser.commandLabel(command)
        # The name is the thing to type; the usage beside it is a shape to
        # read, so it is dimmed rather than given a colour of its own.
        let styled = "${nameColor}${command.name}${Console.RESET}"
        let usage = command.usage == "" then "" else " ${Console.DIM}${command.usage}${Console.RESET}"
        "  ${styled}${usage}${" ".repeat(width - label.count)}  ${command.description}"
      end
      "${Console.BOLD}${heading}${Console.RESET}\n${commandLines.join("\n")}"
    end
    return "${optionsText}\n\n${blocks.join("\n\n")}"
  end
end

module OptionParser do
  let define(name: String, description: String) -> OptionConfig do
    OptionConfig { name: name, description: description }
  end

  let commandLabel(command: CommandSpec) -> String do
    return command.name if command.usage == ""
    return "${command.name} ${command.usage}"
  end

  # The declared command whose words open `arguments`, with what is left
  # after them. Longest match first, so `kex install` is preferred over a
  # `kex` that also exists.
  let commandFor(commands: [CommandSpec], arguments: [String])
      -> (CommandSpec, [String])? do
    let ordered = commands.sort { |a, b| a.name.split(" ").count > b.name.split(" ").count }
    match ordered.find { |command| OptionParser.opensWith?(arguments, command.name) } do
      None => return None
      Just(command) => do
        let words = command.name.split(" ").count
        return Just((command, arguments.drop(words)))
      end
    end
  end

  let opensWith?(arguments: [String], name: String) -> Bool do
    let words = name.split(" ")
    return false if arguments.count < words.count
    return arguments.take(words.count) == words
  end

  let errorMessage(error: OptionParseError) -> String = match error do
    UnknownOption(option) => "unknown option '${option}'"
    MissingValue(option) => "--${option} requires a value"
    UnexpectedValue(option) => "--${option} does not take a value"
    MissingRequired(option) => "--${option} is required"
    InvalidInteger(option, value) => "--${option} expects an integer, got '${value}'"
  end

  let parse(options: [OptionSpec], args: [String]) -> Result<ParsedOptions, OptionParseError> do
    walk(options, args, {}, [], false)
  end

  private do
    let findOption(options: [OptionSpec], argument: String) -> OptionSpec? do
      options.find do |option|
        "--${option.long}" == argument || match option.short do
          Just(short) => "-${short}" == argument
          None => false
        end
      end
    end

    let finish(options: [OptionSpec], values: { String: String },
               arguments: [String]) -> Result<ParsedOptions, OptionParseError> do
      let missing = options.find { |option| option.required? && !values.has?(option.long) }
      OptionParser.finishRequired(missing, options, values, arguments)
    end

    let finishRequired(Just(option), _, _, _) = Error(MissingRequired(option.long))
    let finishRequired(None, options, values, arguments) do
      let complete = options.reduce(values) do |result, option|
        match option.default do
          Just(value) => result.has?(option.long) then result else Kex.Intrinsic.Map.put(result, option.long, value)
          None => result
        end
      end
      Ok(ParsedOptions { values: complete, arguments: arguments })
    end

    walk : [OptionSpec] -> [String] -> { String: String } -> [String] -> Bool -> Result<ParsedOptions, OptionParseError>
    let walk(options, [], values, arguments, _) = OptionParser.finish(options, values, arguments)
    let walk(options, [argument | rest], values, arguments, stopped?: Bool) do
      if stopped?
        return OptionParser.walk(options, rest, values, [...arguments, argument], true)
      end
      if argument == "--"
        return OptionParser.walk(options, rest, values, arguments, true)
      end
      if !argument.startsWith?("-") || argument == "-"
        return OptionParser.walk(options, rest, values, [...arguments, argument], false)
      end

      let equals = argument.startsWith?("--") then argument.split("=") else [argument]
      let spelling = equals.first.or(argument)
      OptionParser.consume(OptionParser.findOption(options, spelling), options, rest,
                           values, arguments, equals.second, spelling)
    end

    let consume(None, _, _, _, _, _, spelling) = Error(UnknownOption(spelling))
    let consume(Just(option), options, rest, values, arguments, inlineValue, _) do
      match option.kind do
        FlagValue => OptionParser.consumeFlag(inlineValue, option, options,
                                               rest, values, arguments)
        _ => OptionParser.consumeValue(
               OptionParser.valueAndRest(inlineValue, rest), option,
               options, values, arguments)
      end
    end

    let consumeFlag(Just(_), option, _, _, _, _) = Error(UnexpectedValue(option.long))
    let consumeFlag(None, option, options, rest, values, arguments) do
      OptionParser.walk(options, rest,
        Kex.Intrinsic.Map.put(values, option.long, "true"), arguments, false)
    end

    let consumeValue(None, option, _, _, _) = Error(MissingValue(option.long))
    let consumeValue(Just((value, remaining)), option, options, values, arguments) do
      if option.kind == IntegerValue && Integer.parse(value).error?
        return Error(InvalidInteger(option.long, value))
      end
      OptionParser.walk(options, remaining,
        Kex.Intrinsic.Map.put(values, option.long, value), arguments, false)
    end

    let valueAndRest(Just(value), rest) = Just((value, rest))
    let valueAndRest(None, []) = None
    let valueAndRest(None, [value | remaining]) = Just((value, remaining))
  end
end
