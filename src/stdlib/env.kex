# The process environment, as an immutable +Map<String, String>+ snapshot
# taken at startup.
#
# +ENV+ supports the whole +Map+ API: +get+, +has?+, +keys+, +values+,
# +count+, +each+, +entries+, so reading a variable looks like any other map
# lookup:
#
#   ENV.get("HOME")                  # => Just("/home/ada")
#   ENV.get("LOG_LEVEL", "info")     # => "info" when unset
#   ENV.has?("PATH")                 # => true
#
# The snapshot itself is immutable, but the global +ENV+ namespace is an
# ambient input: the same call can answer differently between runs without
# anything appearing in a function's arguments. That is why reading it is
# +foul+.
#
# When you would rather the dependency be visible, take it as a parameter:
# +main+ receives the same snapshot as its second argument, and reading a
# parameter is pure:
#
#   main(args, env) do
#     let level = env.get("LOG_LEVEL", "info")
#     IO.printLine("log level: ${level}")
#   end
capability ENV do
  # Returns the value of the environment variable +key+, or +None+ when it is
  # not set.
  #
  # @param key [String] the variable name
  # @return [String?] the value, or +None+
  #
  # @example
  #   ENV.get("HOME")        # => Just("/home/ada")
  #   ENV.get("NOT_SET")     # => None
  #
  # @example Handling both cases explicitly
  #   match ENV.get("HOME") do
  #     Just(home) => IO.printLine("home: ${home}")
  #     None       => IO.printError("HOME is not set")
  #   end
  foul get(key) = Kex.Intrinsic.Env.get(key)

  # Returns the value of +key+, or +default+ when it is not set.
  #
  # The form to reach for when a variable is optional configuration with a
  # sensible fallback, which is most of the time.
  #
  # @param key [String] the variable name
  # @param default [String] the value to use when the variable is unset
  # @return [String] the value, or +default+
  #
  # @example
  #   ENV.get("LOG_LEVEL", "info")   # => "info" when unset
  #
  # @example Reading a port, with a default and a conversion
  #   let port = ENV.get("PORT", "8080").to(Integer).or(8080)
  foul get(key, default) = Kex.Intrinsic.Env.getWithDefault(key, default)

  # Returns +true+ when +key+ is set, whatever its value.
  #
  # Distinguishes an unset variable from one set to the empty string, which a
  # +get+ with a default cannot.
  #
  # @param key [String] the variable name
  # @return [Bool] +true+ when the variable is set
  #
  # @example
  #   ENV.has?("PATH")      # => true
  #   ENV.has?("NOT_SET")   # => false
  #
  # @example Turning a flag on by its presence alone
  #   let debug = ENV.has?("DEBUG")
  foul has?(key) = Kex.Intrinsic.Env.has?(key)

  # Returns every variable name in the environment.
  #
  # @return [[String]] the variable names
  #
  # @example
  #   ENV.keys.count   # => 47
  #
  # @example Every variable belonging to one tool
  #   ENV.keys.filter { |name| name.startsWith?("KEX_") }
  foul keys = Kex.Intrinsic.Env.keys()

  # Returns every variable value in the environment.
  #
  # @return [[String]] the values
  #
  # @example
  #   ENV.values.count   # => 47
  foul values = Kex.Intrinsic.Env.values()

  # Returns how many variables the environment has.
  #
  # @return [Integer] the number of variables
  #
  # @example
  #   IO.printLine("environment has ${ENV.count} variables")
  foul count = Kex.Intrinsic.Env.count()

  # Calls +f+ with each variable's name and value.
  #
  # @param f [String -> String -> Void] called once per variable
  # @return [Void]
  #
  # @example Dumping the environment
  #   ENV.each { |name, value| IO.printLine("${name}=${value}") }
  foul each(f) = Kex.Intrinsic.Env.each(f)

  # Returns the environment as a list of +(name, value)+ pairs.
  #
  # The bridge to the +List+ operations, sorting, grouping, taking a slice.
  #
  # @return [[(String, String)]] the variables
  #
  # @example Printing the environment in name order
  #   ENV.entries.each { |name, value| IO.printLine("${name}=${value}") }
  foul entries = Kex.Intrinsic.Env.entries()

  # Sets an environment variable for this process and every child it starts.
  #
  # +ENV+ is a snapshot, and the write rebuilds it: a later +ENV.get+ answers
  # what was set, not what the process started with.
  #
  # This is how a program decides what a child sees. +Kex.AST+, for instance,
  # shells out to the compiler named by +$KEX+, so a tool that knows which
  # compiler it means says so here rather than hoping +PATH+ agrees.
  #
  # @param name [String] the variable to set
  # @param value [String] the value to give it
  # @return [Void]
  #
  # @example
  #   ENV.set("KEX", "/usr/local/bin/kex")
  #   ENV.get("KEX")   # => Just("/usr/local/bin/kex")
  #
  # @example Making a child process quiet
  #   ENV.set("NO_COLOR", "1")
  # Sets a variable for THIS process and every child it starts. `ENV` is a
  # snapshot, so it is rebuilt by the write: a later `ENV.get` answers what
  # was set, not what the process started with.
  #
  # This is how a program decides what a child sees: `Kex.AST` shells out to
  # the compiler named by `$KEX`, so a tool that knows which compiler it means
  # says so here rather than hoping PATH agrees.
  foul set(name, value) = Kex.Intrinsic.Env.set(name, value)

  # Removes an environment variable from this process and its children.
  #
  # @param name [String] the variable to remove
  # @return [Void]
  #
  # @example
  #   ENV.unset("DEBUG")
  #   ENV.has?("DEBUG")   # => false
  #
  # @example Making sure a child does not inherit a setting
  #   ENV.unset("KEX_TRACE")
  foul unset(name) = Kex.Intrinsic.Env.unset(name)
end
