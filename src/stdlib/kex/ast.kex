# Parses Kex source code into a structured AST, at run time.
#
# Opt-in — nothing here is in scope until `using Kex.AST`.
#
# This is the entry point for tools that read Kex source: linters, formatters,
# documentation generators, code search. The AST includes module definitions,
# function signatures, type/record definitions, traits, make blocks, and the
# doc-comments extracted from +#+ lines — which is how the standard library's
# own documentation is generated.
#
#   using Kex.AST
#
#   main do
#     match Kex.AST.parseFile("src/main.kex") do
#       Ok(program) => IO.printLine("${program.items.count} top-level items")
#       Error(e)    => IO.printError(e.message)
#     end
#   end
#
# Everything answers a +Result+, so a source file that does not parse is a
# value you handle rather than an exception.
module Kex.AST do
  # Where in a source file something appeared.
  #
  # Line and column are 1-based, for reporting to a person; the offsets are
  # 0-based byte positions, for slicing the source.
  record Location do
    # The file the node came from.
    file : String

    # The 1-based line number.
    line : Integer

    # The 1-based column number.
    column : Integer

    # The 0-based byte offset where the node starts.
    startOffset : Integer

    # The 0-based byte offset just past where it ends.
    endOffset : Integer
  end

  # A parsed source file: its schema version, and its top-level items.
  record Program do
    # The AST schema version this program was produced against. Check it
    # before relying on a node shape, so a tool fails loudly rather than
    # silently misreading a newer tree.
    schemaVersion : Integer

    # The file's top-level declarations, in source order.
    items : [Node]
  end

  # Why a source file could not be parsed.
  record ParseError do
    # A human-readable description of the problem.
    message : String

    # Where the parser stopped, when it can say.
    location : Location?
  end

  # Parses Kex source text into a structured AST.
  #
  # Pass +filename+ when you have one — it is what appears in every +Location+
  # and in the error message, so diagnostics can point at a real file.
  #
  # @param source [String] the Kex source text
  # @param filename [String] the name to report locations against; optional
  # @return [Result<Program, ParseError>] the parsed program, or why it failed
  #
  # @example
  #   Kex.AST.parse("let double(n: Integer) -> Integer = n * 2\n")
  #   # => Ok(Program { schemaVersion: 2, items: [...] })
  #   Kex.AST.parse("let x =").error?   # => true
  #
  # @example Counting a file's top-level items
  #   Kex.AST.parse(source, "main.kex").map { |p| p.items.count }
  parse : String -> Result<Program, ParseError>
  parse : String -> String -> Result<Program, ParseError>
  let parse(source) = Kex.Intrinsic.AST.parse(source)
  let parse(source, filename) = Kex.Intrinsic.AST.parse(source, filename)

  # Reads a file and parses it, reporting locations against its path.
  #
  # A file that cannot be read is an +Error+ like one that cannot be parsed.
  #
  # @param path [FS.FilePath] the file to read and parse
  # @return [Result<Program, ParseError>] the parsed program, or why it failed
  #
  # @example
  #   match Kex.AST.parseFile("src/main.kex") do
  #     Ok(program) => IO.printLine("${program.items.count} items")
  #     Error(e)    => IO.printError(e.message)
  #   end
  #
  # @example Parsing every source in a directory
  #   FS.Directory.files(dir)
  #     .or([])
  #     .filter { |f| FS.Path.extension(f) == ".kex" }
  #     .map { |f| Kex.AST.parseFile(FS.Path.join(dir, f)) }
  parseFile : FS.FilePath -> Result<Program, ParseError>
  let parseFile(path) = Kex.Intrinsic.AST.parseFile(path)

  # Parses a type expression on its own, without a surrounding program.
  #
  # Use it to read a type written in data — a signature in a config file, a
  # type named on a command line. +typeRefText+ renders the result back.
  #
  # @param source [String] the type expression
  # @return [Result<TypeRef, ParseError>] the parsed type, or why it failed
  #
  # @example
  #   Kex.AST.parseType("[Integer]").map { |t| Kex.AST.typeRefText(t) }
  #   # => Ok("[Integer]")
  #   Kex.AST.parseType("Map<String, Integer>").map { |t| Kex.AST.typeRefText(t) }
  #   # => Ok("Map<String, Integer>")
  parseType : String -> Result<TypeRef, ParseError>
  let parseType(source) = Kex.Intrinsic.AST.parseType(source)

  # Parses a single expression on its own, without a surrounding program.
  #
  # This gives you the expression's SHAPE. To evaluate one instead, use
  # +Evaluator.runExpression+.
  #
  # @param source [String] the expression text
  # @return [Result<Expression, ParseError>] the parsed expression, or why it failed
  #
  # @example
  #   Kex.AST.parseExpression("1 + 2").ok?   # => true
  #   Kex.AST.parseExpression("1 +").ok?     # => false
  parseExpression : String -> Result<Expression, ParseError>
  let parseExpression(source) = Kex.Intrinsic.AST.parseExpression(source)

  # A type as it was written in source.
  #
  # +typeRefText+ renders one back to the source spelling.
  type TypeRef
    = NamedType(String, [TypeRef])
    | FunctionType([TypeRef], TypeRef)
    | TupleType([TypeRef])
    | ListType(TypeRef)
    | MapType(TypeRef, TypeRef)
    | UnionType([TypeRef])
    | IntersectionType([TypeRef])
    | RecordType([(String, TypeRef)])
    | NullableType(TypeRef)
    | BlockType(TypeRef)
    | AtomType(String)
    | TypeQuery(String, Expression)
    | TypeVar(String)
    | AnyType
    | NoneType

  # Renders a +TypeRef+ back to the way it is written in source.
  #
  # A list reads as +[Integer]+, a map as +{String: Integer}+, an optional as
  # +String?+ — the spelling a reader would recognise, not the constructor
  # tree behind it.
  #
  # @param typeRef [TypeRef] the parsed type
  # @return [String] the type, as source
  #
  # @example
  #   Kex.AST.parseType("[Integer]").map { |t| Kex.AST.typeRefText(t) }
  #   # => Ok("[Integer]")
  #   Kex.AST.parseType("String?").map { |t| Kex.AST.typeRefText(t) }
  #   # => Ok("String?")
  let typeRefText(NamedType(name, [])) -> String = name
  let typeRefText(NamedType(name, args)) -> String = "${name}<${args.map { |arg| Kex.AST.typeRefText(arg) }.join(", ")}>"
  let typeRefText(FunctionType(params, result)) -> String = "(${params.map { |param| Kex.AST.typeRefText(param) }.join(", ")}) -> ${Kex.AST.typeRefText(result)}"
  let typeRefText(TupleType(elements)) -> String = "(${elements.map { |element| Kex.AST.typeRefText(element) }.join(", ")})"
  let typeRefText(ListType(element)) -> String = "[${Kex.AST.typeRefText(element)}]"
  let typeRefText(MapType(key, value)) -> String = "{${Kex.AST.typeRefText(key)}: ${Kex.AST.typeRefText(value)}}"
  let typeRefText(UnionType(members)) -> String = members.map { |member| Kex.AST.typeRefText(member) }.join(" | ")
  let typeRefText(IntersectionType(members)) -> String = members.map { |member| Kex.AST.typeRefText(member) }.join(" & ")
  let typeRefText(RecordType(fields)) -> String = "{" + fields.map { |name, fieldType| "${name}: ${Kex.AST.typeRefText(fieldType)}" }.join(", ") + "}"
  let typeRefText(NullableType(inner)) -> String = "${Kex.AST.typeRefText(inner)}?"
  let typeRefText(BlockType(inner)) -> String = "Block<${Kex.AST.typeRefText(inner)}>"
  let typeRefText(AtomType(name)) -> String = ":${name}"
  let typeRefText(TypeQuery(query, _)) -> String = "Type.${query}(<expression>)"
  let typeRefText(TypeVar(name)) -> String = name
  let typeRefText(AnyType) -> String = "Any"
  let typeRefText(NoneType) -> String = "None"

  # Structured representation of patterns.
  type PatternRef
    = BindPattern(String)
    | LiteralPattern(String)
    | ConstructorPattern(String, [PatternRef])
    | TuplePattern([PatternRef])
    | ListPattern([PatternRef], PatternRef?)
    | RecordPattern(String?, [PatternField])
    | RangePattern(PatternRef, PatternRef)
    | ThisPattern(PatternRef)
    | WildcardPattern

  record PatternField do
    name : String
    pattern : PatternRef?
    stringKey : Bool
  end

  # Renders a +PatternRef+ back to the way it is written in source.
  #
  # @param patternRef [PatternRef] the parsed pattern
  # @return [String] the pattern, as source
  #
  # @example
  #   Kex.AST.patternRefText(WildcardPattern)             # => "_"
  #   Kex.AST.patternRefText(BindPattern("n"))            # => "n"
  let patternRefText(BindPattern(name)) -> String = name
  let patternRefText(LiteralPattern(value)) -> String = value
  let patternRefText(ConstructorPattern(name, [])) -> String = name
  let patternRefText(ConstructorPattern(name, args)) -> String = "${name}(${args.map { |arg| Kex.AST.patternRefText(arg) }.join(", ")})"
  let patternRefText(TuplePattern(elements)) -> String = "(${elements.map { |element| Kex.AST.patternRefText(element) }.join(", ")})"
  let patternRefText(ListPattern(elements, None)) -> String = "[${elements.map { |element| Kex.AST.patternRefText(element) }.join(", ")}]"
  let patternRefText(ListPattern(elements, Just(rest))) -> String = "[${elements.map { |element| Kex.AST.patternRefText(element) }.join(", ")} | ${Kex.AST.patternRefText(rest)}]"
  let patternRefText(RecordPattern(None, fields)) -> String = "{ ${fields.map { |field| Kex.AST.patternFieldText(field) }.join(", ")} }"
  let patternRefText(RecordPattern(Just(typeName), fields)) -> String = "${typeName} { ${fields.map { |field| Kex.AST.patternFieldText(field) }.join(", ")} }"
  let patternRefText(RangePattern(start, finish)) -> String = "${Kex.AST.patternRefText(start)}..${Kex.AST.patternRefText(finish)}"
  let patternRefText(ThisPattern(inner)) -> String = "@${Kex.AST.patternRefText(inner)}"
  let patternRefText(WildcardPattern) -> String = "_"

  let patternFieldText(PatternField { name, pattern, stringKey }) -> String = Kex.AST.patternFieldText(name, pattern, stringKey)
  let patternFieldText(name, None, false) -> String = name
  let patternFieldText(name, None, true) -> String = "\"${name}\""
  let patternFieldText(name, Just(pattern), false) -> String = "${name}: ${Kex.AST.patternRefText(pattern)}"
  let patternFieldText(name, Just(pattern), true) -> String = "\"${name}\": ${Kex.AST.patternRefText(pattern)}"

  # Renders either a type or a pattern back to source.
  #
  # The one call to reach for when a node may carry either — it dispatches to
  # +typeRefText+ or +patternRefText+ as appropriate.
  #
  # @param reference [TypeRef | PatternRef] the parsed node
  # @return [String] the node, as source
  #
  # @example
  #   Kex.AST.referenceText(WildcardPattern)   # => "_"
  #   Kex.AST.referenceText(AnyType)           # => "Any"
  let referenceText(NamedType(name, args)) -> String = Kex.AST.typeRefText(NamedType(name, args))
  let referenceText(FunctionType(params, result)) -> String = Kex.AST.typeRefText(FunctionType(params, result))
  let referenceText(TupleType(elements)) -> String = Kex.AST.typeRefText(TupleType(elements))
  let referenceText(ListType(element)) -> String = Kex.AST.typeRefText(ListType(element))
  let referenceText(MapType(key, value)) -> String = Kex.AST.typeRefText(MapType(key, value))
  let referenceText(UnionType(members)) -> String = Kex.AST.typeRefText(UnionType(members))
  let referenceText(NullableType(inner)) -> String = Kex.AST.typeRefText(NullableType(inner))
  let referenceText(BlockType(inner)) -> String = Kex.AST.typeRefText(BlockType(inner))
  let referenceText(AtomType(name)) -> String = Kex.AST.typeRefText(AtomType(name))
  let referenceText(TypeQuery(query, argument)) -> String = Kex.AST.typeRefText(TypeQuery(query, argument))
  let referenceText(TypeVar(name)) -> String = Kex.AST.typeRefText(TypeVar(name))
  let referenceText(AnyType) -> String = "Any"
  let referenceText(NoneType) -> String = "None"
  let referenceText(BindPattern(name)) -> String = Kex.AST.patternRefText(BindPattern(name))
  let referenceText(LiteralPattern(value)) -> String = Kex.AST.patternRefText(LiteralPattern(value))
  let referenceText(ConstructorPattern(name, args)) -> String = Kex.AST.patternRefText(ConstructorPattern(name, args))
  let referenceText(TuplePattern(elements)) -> String = Kex.AST.patternRefText(TuplePattern(elements))
  let referenceText(ListPattern(elements, rest)) -> String = Kex.AST.patternRefText(ListPattern(elements, rest))
  let referenceText(RecordPattern(typeName, fields)) -> String = Kex.AST.patternRefText(RecordPattern(typeName, fields))
  let referenceText(RangePattern(start, finish)) -> String = Kex.AST.patternRefText(RangePattern(start, finish))
  let referenceText(ThisPattern(inner)) -> String = Kex.AST.patternRefText(ThisPattern(inner))
  let referenceText(WildcardPattern) -> String = "_"

  # Structured representation of expression AST nodes.
  type Expression
    = LitInt(Int)
    | LitFloat(Float)
    | LitChar(Int)
    | LitString(String)
    | InterpolatedString([String], [Expression])
    | LitBool(Bool)
    | LitAtom(String)
    | LitNone
    | Identifier(String)
    | This
    | BinaryOp(Expression, String, Expression)
    | UnaryOp(String, Expression)
    | Call(Expression, [Expression], [NamedArgument], Expression?)
    | TaggedLiteral(String, [String], [Expression])
    | MethodCall(Expression, String, [Expression], [NamedArgument], Expression?, Bool, Bool, TypeRef?)
    | If(Expression, PatternRef?, [Expression], [ElseIf], [Expression]?)
    | Match(Expression, String?, [MatchArm])
    | Receive(String?, [MatchArm], Expression?, Expression?)
    | ListLit([Expression], Expression?)
    | MapLit([MapItem])
    | RecordLit(String, [RecordField])
    | TupleLit([Expression])
    | Block([Expression])
    | Lambda([LambdaParam], [Expression], TypeRef?, RescueInfo?)
    | Let(PatternRef, TypeRef?, Expression)
    | Var(String, TypeRef?, Expression)
    | Assign(String, Expression)
    | Return(Expression)
    | Break
    | Next
    | Spawn([Expression])
    | Try(Expression)
    | Spread(Expression)
    | TrailingIf(Expression, Expression)
    | ThenElse(Expression, Expression, Expression)
    | ShorthandLambda(String, [Expression], Bool)
    | CurryPlaceholder
    | Curry(String, String?, Bool, [[Expression]])
    | Using(String, String?, [String], [String], [Expression])
    | With(String, Expression, [Expression])
    | GeneratedDeclaration(Expression, GeneratedTemplate)
    | ErrorExpression(String)
    | Trying([Expression], RescueInfo)
    | While(Expression, [Expression])
    | Loop([String], [Expression])
    | RangeLit(Expression, Expression)

  record NamedArgument do
    name : String
    value : Expression
  end

  record MatchArm do
    patterns : [PatternRef]
    guard : Expression?
    body : Expression
  end

  record LambdaParam do
    name : String
    type : TypeRef?
  end

  record RescueInfo do
    arms : [MatchArm]
    catchAllName : String?
    catchAllBody : [Expression]
    inlineReturn : Expression?
  end

  record ElseIf do
    condition : Expression
    body : [Expression]
  end

  type MapItem
    = MapEntry(Expression, Expression)
    | MapSpread(Expression)

  record RecordField do
    name : String
    value : Expression
  end

  # A declaration template whose name (and, for a make block, target) is
  # computed by a `compiled do` expression.
  type GeneratedTemplate
    = GeneratedNode(Node)
    | GeneratedMake(GeneratedMakeInfo)

  record GeneratedMakeInfo do
    isFinal : Bool
    implements : [TypeRef]
    body : [CompiledItem]
    location : Location
  end

  record MainInfo do
    doc : String?
    params : [ParamInfo]
    body : [Expression]
    rescueInfo : RescueInfo?
    location : Location
  end

  record ParamInfo do
    name : String?
    pattern : PatternRef?
    type : TypeRef?
    hasDefault : Bool
  end

  record ClauseInfo do
    params : [ParamInfo]
    body : [Expression]
    returnType : TypeRef?
    rescueInfo : RescueInfo?
    hasParamList : Bool
  end

  record FunctionInfo do
    name : String
    doc : String?
    isFoul : Bool
    predicate : Bool
    clauses : [ClauseInfo]
    location : Location
  end

  record AnnotationInfo do
    name : String
    type : TypeRef
    doc : String?
    implicitThis : Bool
    location : Location
  end

  record VariantInfo do
    name : String
    fields : [TypeRef]
  end

  record TypeInfo do
    name : String
    doc : String?
    typeParams : [String]
    parents : [TypeRef]
    variants : [VariantInfo]?
    location : Location
  end

  record FieldInfo do
    name : String
    type : TypeRef
    hasDefault : Bool
  end

  record RecordInfo do
    name : String
    doc : String?
    typeParams : [String]
    fields : [FieldInfo]
    location : Location
  end

  record TraitInfo do
    name : String
    doc : String?
    typeParams : [String]
    body : [Node]
    location : Location
  end

  record MakeInfo do
    target : TypeRef
    doc : String?
    isFinal : Bool
    implements : [TypeRef]
    body : [Node]
    location : Location
  end

  record PragmaInfo do
    name : String
    value : String?
    location : Location
  end

  record ModuleInfo do
    name : String
    doc : String?
    items : [Node]
    location : Location
  end

  record ConstantInfo do
    name : String
    doc : String?
    type : TypeRef?
    location : Location
  end

  record VisibilityInfo do
    isPublic : Bool
    items : [Node]
    location : Location
  end

  record UsingInfo do
    moduleName : String
    alias : String?
    onlyNames : [String]
    exceptNames : [String]
    body : [Expression]
    location : Location
  end

  record ExportInfo do
    moduleName : String
    alias : String?
    onlyNames : [String]
    exceptNames : [String]
    location : Location
  end

  type CompiledItem
    = CompiledNode(Node)
    | CompiledExpression(Expression)

  record CompiledInfo do
    items : [CompiledItem]
    location : Location
  end

  type Node
    = ModuleDef(ModuleInfo)
    | FunctionDef(FunctionInfo)
    | TypeAnnotation(AnnotationInfo)
    | TypeDef(TypeInfo)
    | RecordDef(RecordInfo)
    | TraitDef(TraitInfo)
    | MakeDef(MakeInfo)
    | PragmaDef(PragmaInfo)
    | ConstantDef(ConstantInfo)
    | MainDef(MainInfo)
    | Visibility(VisibilityInfo)
    | UsingDef(UsingInfo)
    | ExportDef(ExportInfo)
    | Compiled(CompiledInfo)

  # Source-like conversion through the standard `.to(String)` spelling.
  make TypeRef | PatternRef do
    let to(String) -> String? = Just(Kex.AST.referenceText(this))
  end
end
