# A one-shot sequence over a source that can only be read once.
#
# Reading a feed consumes it. A +Stream+ remembers its elements so it can be
# walked again; a feed keeps nothing, so it can walk a file, a socket or a
# device larger than memory.
#
#   let lines = FS.File.feed("huge.log").or(Feed.empty)
#   lines.each { |line| IO.printLine(line) if line.contains?("ERROR") }
#
# +map+, +filter+ and +drop+ return a feed that reads from the same source as
# the original, so a pipeline makes one pass:
#
#   FS.File.feed("app.log").or(Feed.empty)
#     .filter { |line| line.contains?("ERROR") }
#     .take(10)
#
# Calling +take(10)+ twice returns the first ten elements and then the next
# ten. On a +Stream+ it would return the same ten both times. To get that
# behaviour from a small source, call +toStream+, which keeps what it reads.
type Feed<A>

# Constructors for +Feed+.
module Feed do
  # Returns a feed with nothing in it, whose first +pull+ returns +None+.
  #
  # It is mostly used as the fallback for a failed open:
  # +FS.File.feed(path).or(Feed.empty)+ then reads nothing.
  #
  # @return [Feed<A>] the empty feed
  #
  # @example
  #   Feed.empty.take(3)   # => []
  empty : Feed<A>
  let empty = Kex.Intrinsic.Feed.empty()

  # Returns a feed over the elements of a list.
  #
  # Use it in tests, to stand in for a real source with something that is
  # consumed the same way.
  #
  # @param xs [[A]] the elements to feed
  # @return [Feed<A>] a feed over +xs+
  #
  # @example
  #   let feed = Feed.Elements(["one", "two"])
  #   feed.take(1)   # => ["one"]
  #   feed.take(1)   # => ["two"]
  Elements : [A] -> Feed<A>
  let Elements(xs) = Kex.Intrinsic.Feed.elements(xs)
end

# Reading a feed consumes it; open a new one to read the same data again.
# Opening a file-backed feed is +foul+, and so is +pull+.
make Feed<A> do
  # Returns the next element and consumes it, or +None+ once the source is
  # spent.
  #
  # @return [A?] the next element, or +None+
  #
  # @example
  #   let feed = Feed.Elements([1, 2])
  #   feed.pull   # => Just(1)
  #   feed.pull   # => Just(2)
  #   feed.pull   # => None
  pull :> A?
  foul pull = Kex.Intrinsic.Feed.pull(this)

  # Returns +true+ once a read has found the source empty.
  #
  # +false+ does not promise another element: the feed only learns that the
  # source has ended when a read finds nothing.
  #
  # @return [Bool] +true+ once the feed is spent
  #
  # @example Draining a feed a piece at a time
  #   let jobs = Feed.Elements(["resize", "index"])
  #   jobs.spent?   # => false
  #   jobs.take(2)  # => ["resize", "index"]
  #   jobs.spent?   # => false
  #   jobs.pull     # => None
  #   jobs.spent?   # => true
  spent? :> Bool
  foul spent? = Kex.Intrinsic.Feed.spent?(this)

  # Returns the next +n+ elements as a list, consuming them.
  #
  # Returns fewer than +n+ when the source ends first, and +[]+ once it is
  # spent. Unlike +Stream.take+, a second call returns the elements after the
  # first.
  #
  # @param n [Integer] how many elements to consume
  # @return [[A]] up to +n+ elements
  #
  # @example Two windows, not the same one twice
  #   let feed = Feed.Elements([1, 2, 3, 4])
  #   feed.take(2)   # => [1, 2]
  #   feed.take(2)   # => [3, 4]
  take :> Integer -> [A]
  let take(n) = Kex.Intrinsic.Feed.take(this, n)

  # Discards the next +n+ elements and returns the same feed.
  #
  # @param n [Integer] how many elements to discard
  # @return [Feed<A>] the same feed, advanced
  #
  # @example
  #   FS.File.feed("log.txt").or(Feed.empty).drop(1).take(3)
  drop :> Integer -> Feed<A>
  let drop(n) = Kex.Intrinsic.Feed.drop(this, n)

  # Returns a feed with +f+ applied to each element.
  #
  # +f+ runs on each element as it is read. The result reads from the same
  # source, so reading it consumes the original feed too.
  #
  # @param f [A -> B] applied to each element
  # @return [Feed<B>] the mapped feed
  #
  # @example
  #   FS.File.feed("log.txt").or(Feed.empty).map(~trim).take(5)
  map :> (A -> B) -> Feed<B>
  let map(f) = Kex.Intrinsic.Feed.map(this, f)

  # Returns a feed of only the elements +pred+ accepts.
  #
  # Reading one element of the result may consume many of the receiver's.
  #
  # @param pred [A -> Bool] the test applied to each element
  # @return [Feed<A>] the filtered feed
  #
  # @example The first ten errors in a long log
  #   FS.File.feed("app.log").or(Feed.empty)
  #     .filter { |line| line.contains?("ERROR") }
  #     .take(10)
  filter :> (A -> Bool) -> Feed<A>
  let filter(pred) = Kex.Intrinsic.Feed.filter(this, pred)

  # Applies +f+ to every remaining element, draining the feed.
  #
  # @param f [A -> Void] applied to each element
  # @return [Void]
  #
  # @example
  #   FS.File.feed("log.txt").or(Feed.empty).each { |line| IO.printLine(line) }
  each :> (A -> Void) -> Void
  let each(f) = Kex.Intrinsic.Feed.each(this, f)

  # Reads the rest of the feed into a list.
  #
  # The whole rest of the source is held in memory. For a source too large to
  # hold, use +each+.
  #
  # @return [[A]] every remaining element
  #
  # @example
  #   FS.File.feed("short.txt").or(Feed.empty).collect
  #
  # @example Loading a small configuration file for repeated passes
  #   let rules = FS.File.feed("rules.txt")
  #     .or(Feed.empty)
  #     .map(~trim)
  #     .filter(~present?)
  #     .collect
  collect :> [A]
  let collect = Kex.Intrinsic.Feed.collect(this)

  # Returns a +Stream+ drawn from the feed.
  #
  # The stream keeps every element it reads, so it can be walked again. Use it
  # only for a source small enough to hold.
  #
  # @return [Stream<A>] the remaining elements, as a stream
  #
  # @example
  #   let lines = FS.File.feed("small.txt").or(Feed.empty).toStream
  #   lines.take(2)   # => ["one", "two"]
  #   lines.take(2)   # => ["one", "two"]
  toStream :> Stream<A>
  let toStream = Kex.Intrinsic.Feed.toStream(this)
end
