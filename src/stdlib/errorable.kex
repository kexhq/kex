# +Errorable+: the trait for values that describe a failure.
#
# Implemented by error types that carry a human-readable message, so a generic
# handler can display or log any error without knowing its concrete type or
# its structured fields.
#
#   foul report(e: Errorable) -> Void do
#     IO.printError("error: ${e.message}")
#   end
trait Errorable do
  # A human-readable description of what went wrong.
  #
  # Written for a person reading output, not for a program to match on:
  # branch on the error's own type or fields for that.
  #
  # @return [String] the failure message
  #
  # @example
  #   IO.printError("error: ${e.message}")
  message :> String
end

# Why +Integer.parse+, +Float.parse+ or +Number.parse+ could not read a
# number: one case per reason, so a caller matches on the reason instead of
# reading a message. Positions count characters from the start of the text.
#
#   match Integer.parse(text) do
#     Ok(n) => Money(n, Currency.DEFAULT)
#     Error(Trailing(n, unit)) => Money(n, unit.trim)
#     Error(NoDigits(_)) => die("no amount in ${text}")
#     Error(e) => die(e.message)
#   end
#
# Reach for +parse+ over +to(Integer)+ exactly when the reason matters: +to+
# answers a plain +None+.
type ParseError<T> =
  # Nothing numeric where a digit was expected, at this position: +""+,
  # +"-"+ and +"abc"+ (all at 0, +"-"+ at 1).
  | NoDigits(Integer)
  # A number, then text it does not belong to: +"10 USD"+ is
  # +Trailing(10, " USD")+, and +"1.5"+ read as an Integer is
  # +Trailing(1, ".5")+. What follows the number is left as written.
  | Trailing(T, String)
  # A group separator with the wrong number of digits behind it, at the
  # group's first digit: +"1 50"+ in Hungarian, which groups by three.
  | BadGrouping(Integer)
  # Digits too large for the type: +Float.parse("1e999")+.
  | OutOfRange
  # A radix outside 2 to 36.
  | BadRadix(Integer)
  # A culture whose number settings are unusable: the same character for
  # the decimal point and the groups, or a group size below 1 (+Culture.valid?+).
  | BadCulture

make ParseError<T>, implement: Errorable do
  # The failure as a sentence for a person: what +Errorable+ asks for.
  #
  # @example
  #   Integer.parse("12 USD").mapError(~message)   # => Error("unexpected \" USD\" after the number")
  let message(@NoDigits(at)) -> String = "expected a digit at ${at}"
  let message(@Trailing(_, rest)) -> String = "unexpected \"${rest}\" after the number"
  let message(@BadGrouping(at)) -> String = "digit group out of place at ${at}"
  let message(@OutOfRange) -> String = "the number is out of range"
  let message(@BadRadix(radix)) -> String = "radix ${radix} is not between 2 and 36"
  let message(@BadCulture) -> String = "the culture's number settings are unusable"
end

# Where a format pattern known only at run time goes wrong:
# +NumberFormat.parse+ and +DateFormat.parse+. Written for the pattern's
# author, who reads the message; the position is a character index.
record PatternError do
  # The character index of the first problem.
  position : Integer

  # What is wrong there.
  message  : String
end
