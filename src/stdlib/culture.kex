# Explicit cultures for parsing and printing numbers: decimal separators,
# digit grouping and group sizes, plus date/time layout data.
#
# A culture is always passed explicitly — parsing and printing never consult
# the ambient locale, so the same call answers the same everywhere. Defaults
# stay dot-only; reach for a culture exactly when the text follows human
# conventions instead of literal syntax:
#
#   using Culture
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Float.parse("1,44", culture: hu)   # => Ok(1.44)
#   Float.parse("1,44")                 # => Error(...)
module Culture

# Number settings: which character marks the decimal point and how digit
# groups are separated and sized.
record NumberSettings do
  # The decimal separator: +.+ in technical text, +,+ across much of Europe.
  decimalSeparator : Char = '.'

  # Digit grouping as +(separator, sizes)+, or +None+ for no grouping. Sizes
  # run outward from the decimal point and the last repeats, so +[3]+ groups
  # by thousands.
  groups : (Char, [Integer])? = None
end

# Date and time layout data. Carried by every preset; no behavior reads it
# yet — culture-aware time parsing and printing is a later slice.
record TimeSettings do
  # Field order as written: +:year+, +:month+ and +:day+ in written order.
  dateOrder : [Atom]

  # Separates date fields: +.+ in +2026. 11. 05.+, +/+ in +11/05/2026+.
  dateSeparator : Char

  # Separates time fields, almost always +:+.
  timeSeparator : Char
end

# A culture: named settings for parsing and printing.
#
# The value carries its own settings — +parse+ and +to+ read them from the
# culture they are handed, never from globals or by-name lookup. Assemble
# one from a preset, from +of+, from +local+, or literally; fields you omit
# take neutral defaults, so a numbers-only custom culture never mentions
# time.
record Culture do
  # Display name: the ISO tag for presets, anything for a custom culture.
  name : String = "custom"

  # Number settings; the only part parsing and printing read today.
  numbers : NumberSettings

  # Time layout data, or +None+ when the culture defines none.
  time : TimeSettings? = None
end

# The technical default: dot decimals, no grouping, no time section. This is
# what no-culture parsing accepts, so +parse(s)+ and
# +parse(s, culture: Culture.DEFAULT)+ always agree. Reach for it when the
# text is machine-written: protocols, data files, logs.
DEFAULT : Culture
let DEFAULT = Culture {
  name: "default",
  numbers: NumberSettings { decimalSeparator: '.', groups: None }
}

# Answers the culture registered under +code+, or +None+ for an unknown tag.
# This is the only way to reach a preset: there are no per-culture constants.
#
# The code is normalized before lookup — upper-cased with +-+ read as +_+ —
# so +"hu-HU"+ and +"HU_HU"+ find the same culture.
#
# @param code [String] the ISO tag, such as +"HU_HU"+
# @return [Culture?] the culture, or +None+
#
# @example
#   Culture.of("HU_HU").or(Culture.DEFAULT).name   # => "HU_HU"
#   Culture.of("hu-HU").or(Culture.DEFAULT).name   # => "HU_HU"
#   Culture.of("XX_YY")                            # => None
of : String -> Culture?
let of(code) do
  let want = normalizeTag(code)
  let rows = [
    ("AF", ',', Just(('\u{A0}', [3])), [:year, :month, :day], '-', ':'),
