    ("RU", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("RU_BY", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("RU_KZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("RU_RU", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("RU_UA", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SK", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SK_SK", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SL", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SL_SI", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SQ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SQ_AL", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SQ_MK", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("SR", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SR_BA", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SR_CYRL_RS", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SR_LATN_RS", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SR_ME", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SR_RS", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("SV", ',', Just(('\u{A0}', [3])), [:year, :month, :day], '-', ':'),
    ("SV_FI", ',', Just(('\u{A0}', [3])), [:year, :month, :day], '-', '.'),
    ("SV_SE", ',', Just(('\u{A0}', [3])), [:year, :month, :day], '-', ':'),
    ("SW", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("SW_KE", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("SW_TZ", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TA", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_IN", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_LK", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_SG", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TE", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TE_IN", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TH", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TH_TH", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TR", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("TR_CY", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("TR_TR", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("UK", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("UK_UA", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("UR", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("UR_IN", '\u{66B}', Just(('\u{66C}', [3])), [:day, :month, :year], '/', ':'),
    ("UR_PK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_CYRL_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_LATN_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("VI", ',', Just(('.', [3])), [:day, :month, :year], '/', ':'),
    ("VI_VN", ',', Just(('.', [3])), [:day, :month, :year], '/', ':'),
    ("XH", '.', Just(('\u{A0}', [3])), [:month, :day, :year], '/', ':'),
    ("XH_ZA", '.', Just(('\u{A0}', [3])), [:month, :day, :year], '/', ':'),
    ("ZH", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_CN", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HANS_CN", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HANT_HK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_HANT_TW", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_MO", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_SG", '.', Just((',', [3])), [:year, :month, :day], '\u{5E74}', ':'),
    ("ZH_TW", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZU", '.', Just((',', [3])), [:year, :month, :day], '-', ':'),
    ("ZU_ZA", '.', Just((',', [3])), [:year, :month, :day], '-', ':')
  ]
  var found: Culture? = None
  rows.each do |tag, decimal, groups, order, dateSeparator, timeSeparator|
    if tag == want
      let numbers = NumberSettings { decimalSeparator: decimal, groups: groups }
      let time = TimeSettings {
        dateOrder: order,
        dateSeparator: dateSeparator,
        timeSeparator: timeSeparator,
        twelveHour?: twelveHour?(tag),
        names: languageNames(tag.split("_").first.or(tag))
      }
      found = Just(Culture { name: tag, numbers: numbers, time: Just(time) })
    end
  end
  found
end

# Answers +true+ when the culture's number settings are usable: grouped
# cultures need a group separator that differs from the decimal separator
# and a non-empty list of positive group sizes.
#
# Parsing and printing check this for you — an invalid culture fails loudly
# at use — so call +valid?+ only to fail earlier with your own message.
#
# @param culture [Culture] the culture to check
# @return [Bool] +true+ when the number settings are usable
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.valid?(hu)              # => true
valid? : Culture -> Bool
let valid?(culture) do
  let decimal = culture.numbers.decimalSeparator
  match culture.numbers.groups do
    None => true
    Just((separator, sizes)) => separator != decimal && validSizes?(sizes)
  end
end

# Reads the number +text+ holds, as +Integer.parse+, +Float.parse+ and
# +Number.parse+ do: the one grammar every number parse uses, on both
# backends.
#
# An optional sign, then digits in +radix+ (letters above 9 in either case),
# grouped as +culture+ groups them once a group separator appears: digits
# with no separator read in every culture. When +fractional+, the culture's
# decimal separator with digits after it, and an exponent (+e3+, +E-2+), may
# follow.
#
# +convert+ makes the value from what was read: the sign and digits without
# separators (+"-1500"+), then the fraction and exponent spelled canonically
# (+".5e3"+, +".0e3"+ for an exponent alone, +""+ for neither). Its +None+ is
# +OutOfRange+. A number followed by more text is +Trailing+.
#
# This is plumbing for the typed parses: most callers want those.
#
# @param text [String] the text to read
# @param culture [Culture] whose separators to accept
# @param radix [Integer] the base of the digits, 2 to 36
# @param fractional [Bool] whether a fraction and an exponent may follow
# @param convert [String -> String -> T?] the value of the digits read
# @return [Result<T, ParseError<T>>] the value, or why not
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.readNumber("1 500 Ft", hu, 10, false) { |digits, _| digits.to(Integer) }
#   # => Error(Trailing(1500, " Ft"))
let readNumber(text: String, culture: Culture, radix: Integer, fractional: Bool, convert: String -> String -> T?) -> Result<T, ParseError<T>> do
  match scanNumber(text, culture, radix, fractional) do
    Ok((digits, tail, length)) => match convert(digits, tail) do
      Just(value) => length == text.count then Ok(value) else Error(Trailing(value, text.drop(length)))
      None => Error(OutOfRange)
    end
    Error(problem) => Error(problem)
  end
end

# Renders plain dot-form +text+ with the culture's separators: the decimal
# separator is substituted and digit groups are inserted per the culture's
# group sizes. An exponent, if any, passes through unchanged. Answers
# +None+ for an invalid culture (see +valid?+).
#
# This is plumbing shared by the typed prints — most callers want
# +(1500.5).to(String, culture: culture)+ instead.
#
# @param text [String] the dot-form text to render
# @param culture [Culture] the culture to render with
# @return [String?] the rendered text, or +None+ for an invalid culture
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.renderNumber("1500.5", hu)              # => Just("1\u{A0}500,5")
renderNumber : String -> Culture -> String?
let renderNumber(text, culture: Culture) do
  if !valid?(culture)
    return None
  end
  let negative = text.startsWith?("-")
  let digits = negative then text.drop(1) else text
  let eParts = digits.split("e")
  let bigParts = digits.split("E")
  var mantissa = digits
  var exponent = ""
  if eParts.count > 1
    mantissa = eParts.at(0).or("")
    exponent = "e" + eParts.at(1).or("")
  end
  if bigParts.count > 1
    mantissa = bigParts.at(0).or("")
    exponent = "E" + bigParts.at(1).or("")
  end
  let dotParts = mantissa.split(".")
  let grouped = insertGroups(dotParts.at(0).or(""), culture)
  let head = negative then "-" + grouped else grouped
  let decimal = "${culture.numbers.decimalSeparator}"
  match dotParts.at(1) do
    Just(frac) => Just(head + decimal + frac + exponent)
    None => Just(head + exponent)
  end
end

# Answers the machine's culture as an ordinary value: numbers follow the
# +LC_ALL+, +LC_NUMERIC+ or +LANG+ environment variable, falling back to
# +DEFAULT+ when none names a known culture.
#
# The query is explicit and +foul+ — ambient locale never leaks into parsing
# or printing on its own. Bind the answer once and pass it like any other
# culture:
#
#   let culture = Culture.local
#   Float.parse(input, culture: culture)
#
# @return [Culture] the machine's culture, or +DEFAULT+
local : Culture
foul local do
  if let Just(tag) = envNonEmpty("LC_ALL")
    return cultureFromTag(tag)
  end
  if let Just(tag) = envNonEmpty("LC_NUMERIC")
    return cultureFromTag(tag)
  end
  if let Just(tag) = envNonEmpty("LANG")
    return cultureFromTag(tag)
  end
  DEFAULT
end

private do
  # The presets that read the time of day on a 12-hour clock by default.
  let twelveHour?(tag: String) -> Bool do
    ["EN", "EN_US", "EN_AU", "EN_CA", "EN_NZ", "EN_PH", "EN_IN"].contains?(tag)
  end

  # Date and time names by language, the part of the tag before any "_".
  # +None+ for a language this table does not cover yet.
  let languageNames(language: String) -> TimeNames? do
    return Just(ENGLISH_TIME_NAMES) if language == "EN"
    return Just(HUNGARIAN_NAMES) if language == "HU"
    return Just(GERMAN_NAMES) if language == "DE"
    return Just(FRENCH_NAMES) if language == "FR"
    return Just(SPANISH_NAMES) if language == "ES"
    return Just(ITALIAN_NAMES) if language == "IT"
    return Just(PORTUGUESE_NAMES) if language == "PT"
    return Just(DUTCH_NAMES) if language == "NL"
    return None
  end

  let HUNGARIAN_NAMES = TimeNames {
    months: ["január", "február", "március", "április", "május", "június",
      "július", "augusztus", "szeptember", "október", "november", "december"],
    shortMonths: ["jan.", "febr.", "márc.", "ápr.", "máj.", "jún.", "júl.",
      "aug.", "szept.", "okt.", "nov.", "dec."],
    weekdays: ["hétfő", "kedd", "szerda", "csütörtök", "péntek", "szombat",
      "vasárnap"],
    shortWeekdays: ["H", "K", "Sze", "Cs", "P", "Szo", "V"],
    dayPeriods: ("de.", "du.")
  }

  let GERMAN_NAMES = TimeNames {
    months: ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli",
      "August", "September", "Oktober", "November", "Dezember"],
    shortMonths: ["Jan.", "Feb.", "März", "Apr.", "Mai", "Juni", "Juli",
      "Aug.", "Sept.", "Okt.", "Nov.", "Dez."],
    weekdays: ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag",
      "Samstag", "Sonntag"],
    shortWeekdays: ["Mo.", "Di.", "Mi.", "Do.", "Fr.", "Sa.", "So."],
    dayPeriods: ("AM", "PM")
  }

  let FRENCH_NAMES = TimeNames {
    months: ["janvier", "février", "mars", "avril", "mai", "juin", "juillet",
      "août", "septembre", "octobre", "novembre", "décembre"],
    shortMonths: ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.",
      "août", "sept.", "oct.", "nov.", "déc."],
    weekdays: ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi",
      "dimanche"],
    shortWeekdays: ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."],
    dayPeriods: ("AM", "PM")
  }

  let SPANISH_NAMES = TimeNames {
    months: ["enero", "febrero", "marzo", "abril", "mayo", "junio", "julio",
      "agosto", "septiembre", "octubre", "noviembre", "diciembre"],
    shortMonths: ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago",
      "sept", "oct", "nov", "dic"],
    weekdays: ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado",
      "domingo"],
    shortWeekdays: ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"],
    dayPeriods: ("a. m.", "p. m.")
  }

  let ITALIAN_NAMES = TimeNames {
    months: ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno",
      "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"],
    shortMonths: ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago",
      "set", "ott", "nov", "dic"],
    weekdays: ["lunedì", "martedì", "mercoledì", "giovedì", "venerdì",
      "sabato", "domenica"],
    shortWeekdays: ["lun", "mar", "mer", "gio", "ven", "sab", "dom"],
    dayPeriods: ("AM", "PM")
  }

  let PORTUGUESE_NAMES = TimeNames {
    months: ["janeiro", "fevereiro", "março", "abril", "maio", "junho",
      "julho", "agosto", "setembro", "outubro", "novembro", "dezembro"],
    shortMonths: ["jan.", "fev.", "mar.", "abr.", "mai.", "jun.", "jul.",
      "ago.", "set.", "out.", "nov.", "dez."],
    weekdays: ["segunda-feira", "terça-feira", "quarta-feira", "quinta-feira",
      "sexta-feira", "sábado", "domingo"],
    shortWeekdays: ["seg.", "ter.", "qua.", "qui.", "sex.", "sáb.", "dom."],
    dayPeriods: ("AM", "PM")
  }

  let DUTCH_NAMES = TimeNames {
    months: ["januari", "februari", "maart", "april", "mei", "juni", "juli",
      "augustus", "september", "oktober", "november", "december"],
    shortMonths: ["jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug",
      "sep", "okt", "nov", "dec"],
    weekdays: ["maandag", "dinsdag", "woensdag", "donderdag", "vrijdag",
      "zaterdag", "zondag"],
    shortWeekdays: ["ma", "di", "wo", "do", "vr", "za", "zo"],
    dayPeriods: ("a.m.", "p.m.")
  }

  # Upper-cases a lookup tag and reads +-+ as +_+, so +"hu-HU"+ finds +HU_HU+.
  let normalizeTag(code: String) -> String = code.upperCase.split("-").join("_")

  # Reads the number +text+ starts with: an optional sign, digits in
  # +radix+, grouped as +culture+ groups them once a separator appears and,
  # when +fractional+, a fraction after the culture's decimal separator and an
  # exponent. This is the one grammar both backends read numbers with; native
  # code only converts what it accepts.
  #
  # Answers the sign and digits without separators, the canonical rest
  # (+".5"+, +".0e3"+, +""+ when neither was read), and how many characters
  # the number took.
  let scanNumber(text: String, culture: Culture, radix: Integer, fractional: Bool) -> Result<(String, String, Integer), ParseError<A>> do
    return Error(BadRadix(radix)) if radix < 2 || radix > 36
    return Error(BadCulture) if !valid?(culture)
    let (sign, start, afterSign) = match text.chars do
      ['-' | rest] => ("-", 1, rest)
      ['+' | rest] => ("", 1, rest)
      chars => ("", 0, chars)
    end
    let (lead, afterLead) = digitRun(afterSign, radix, [])
    return Error(NoDigits(start)) if lead.empty?
    var groups = [lead]
    var afterWhole = afterLead
    match culture.numbers.groups do
      Just((separator, sizes)) => do
        let (read, after) = groupRun(afterLead, separator, radix, [lead])
        match misplacedGroup(read, sizes) do
          Just(at) => return Error(BadGrouping(start + at))
          None => ()
        end
        groups = read
        afterWhole = after
      end
      None => ()
    end
    let whole = sign + groups.join("")
    let wholeLength = start + groups.reduce(groups.count - 1) { |sum, group| sum + group.count }
    return Ok((whole, "", wholeLength)) if !fractional
    let (fraction, afterFraction) = match afterWhole do
      [c | rest] => c == culture.numbers.decimalSeparator then digitRun(rest, 10, []) else ("", afterWhole)
      [] => ("", [])
    end
    let fractionLength = fraction.empty? then 0 else fraction.count + 1
    let exponent = exponentRun(fraction.empty? then afterWhole else afterFraction)
    let tail = (fraction.empty? && exponent.empty?) then "" else ".${fraction.empty? then "0" else fraction}${exponent}"
    Ok((whole, tail, wholeLength + fractionLength + exponent.count))
  end

  # The digits +chars+ starts with in +radix+, and what follows them.
  let digitRun(chars: [Char], radix: Integer, read: [Char]) -> (String, [Char]) do
    match chars do
      [c | rest] => digitValue(c) < radix then digitRun(rest, radix, [c, ...read]) else (read.reverse.join(""), chars)
      [] => (read.reverse.join(""), [])
    end
  end

  # The value of an ASCII digit or letter digit (+'a'+ and +'A'+ are 10),
  # 99 for anything else.
  let digitValue(c: Char) -> Integer do
    let code = c.codepoint
    return code - 48 if code >= 48 && code <= 57
    return code - 87 if code >= 97 && code <= 122
    return code - 55 if code >= 65 && code <= 90
    99
  end

  # The digit groups after the first, each behind a separator; a separator
  # without digits behind it is not part of the number.
  let groupRun(chars: [Char], separator: Char, radix: Integer, groups: [String]) -> ([String], [Char]) do
    match chars do
      [c | rest] => do
        return (groups, chars) if !separatorLike?(c, separator)
        let (digits, after) = digitRun(rest, radix, [])
        digits.empty? then (groups, chars) else groupRun(after, separator, radix, [...groups, digits])
      end
      [] => (groups, [])
    end
  end

  # The character index of the first group of the wrong size, counted from
  # the first digit. Digits without separators are any length: +"1500"+
  # reads in every culture. Sizes apply from the right, the last repeating
  # (en-IN's +[3, 2]+), and the leftmost group holds one digit up to a full
  # group.
  let misplacedGroup(groups: [String], sizes: [Integer]) -> Integer? do
    return None if groups.count == 1
    var offset = 0
    var index = 0
    var bad: Integer? = None
    groups.each do |group|
      let fromRight = groups.count - 1 - index
      let want = sizes.at(fromRight < sizes.count then fromRight else sizes.count - 1).or(3)
      let fits = index == 0 then group.count <= want else group.count == want
      bad = Just(offset) if bad.none? && !fits
      offset = offset + group.count + 1
      index = index + 1
    end
    bad
  end

  # The exponent +chars+ starts with, canonically spelled (+"e-3"+), or
  # +""+ when there is none: an +e+ or +E+, an optional sign, and digits.
  let exponentRun(chars: [Char]) -> String do
    match chars do
      [e | rest] => do
        return "" if e != 'e' && e != 'E'
        let (sign, digitsFrom) = match rest do
          ['-' | after] => ("-", after)
          ['+' | after] => ("+", after)
          _ => ("", rest)
        end
        let (digits, _) = digitRun(digitsFrom, 10, [])
        digits.empty? then "" else "e${sign}${digits}"
      end
      [] => ""
    end
  end

  # Whether +c+ separates digit groups: the culture's separator, or any space
  # lookalike (plain, NBSP, narrow NBSP) when the separator is one, since
  # keyboards and copy-paste rarely produce NBSP.
  let separatorLike?(c: Char, separator: Char) -> Bool = c == separator || (spaceLike?(separator) && spaceLike?(c))

  # Plain space, NBSP (160) and narrow NBSP (8239).
  let spaceLike?(c: Char) -> Bool = c.codepoint == 32 || c.codepoint == 160 || c.codepoint == 8239

  # Answers +true+ for a non-empty list of positive group sizes.
  let validSizes?(sizes: [Integer]) -> Bool do
    return sizes.count > 0 && sizes.filter { |n| n >= 1 }.count == sizes.count
  end

  # Inserts the culture's group separators into integer +digits+.
  let insertGroups(digits: String, culture: Culture) -> String do
    match culture.numbers.groups do
      None => digits
      Just((separator, sizes)) => groupDigits(digits, separator, sizes)
    end
  end

  # Groups +digits+ from the right; the last size repeats forever
  # (CLDR primary/secondary, e.g. en-IN [3, 2]); the leftmost group
  # takes whatever remains. Callers check +valid?+ first.
  let groupDigits(digits: String, separator: Char, sizes: [Integer]) -> String do
    var parts: [String] = []
    var pos = digits.count
    var k = 0
    while pos > 0 do
      let capped = k < sizes.count then k else sizes.count - 1
      let size = sizes.at(capped).or(3)
      if pos <= size
        parts = [digits.take(pos) | parts]
        pos = 0
      else
        parts = [digits.drop(pos - size).take(size) | parts]
        pos = pos - size
      end
      k = k + 1
    end
    parts.join("${separator}")
  end

  # Reads one variable, treating missing and empty alike as +None+.
  foul envNonEmpty(name: String) -> String? do
    let value = ENV.get(name, "")
    if value.empty?
      return None
    end
    Just(value)
  end

  # Resolves an environment locale tag to a culture, defaulting to +DEFAULT+.
  # Strips any codeset suffix first, so +"hu_HU.UTF-8"+ finds +HU_HU+.
  foul cultureFromTag(tag: String) -> Culture do
    let bare = tag.split(".").first.or("")
    let clean = bare.split("@").first.or("")
    of(clean).or(DEFAULT)
  end
end
