    ("SV_SE", ',', Just(('\u{A0}', [3])), [:year, :month, :day], '-', ':'),
    ("SW", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("SW_KE", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("SW_TZ", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TA", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_IN", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_LK", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TA_SG", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TE", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TE_IN", '.', Just((',', [3, 2])), [:day, :month, :year], '/', ':'),
    ("TH", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TH_TH", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("TR", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("TR_CY", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("TR_TR", ',', Just(('.', [3])), [:day, :month, :year], '.', ':'),
    ("UK", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("UK_UA", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '.', ':'),
    ("UR", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("UR_IN", '\u{66B}', Just(('\u{66C}', [3])), [:day, :month, :year], '/', ':'),
    ("UR_PK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_CYRL_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_LATN_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("UZ_UZ", ',', Just(('\u{A0}', [3])), [:day, :month, :year], '/', ':'),
    ("VI", ',', Just(('.', [3])), [:day, :month, :year], '/', ':'),
    ("VI_VN", ',', Just(('.', [3])), [:day, :month, :year], '/', ':'),
    ("XH", '.', Just(('\u{A0}', [3])), [:month, :day, :year], '/', ':'),
    ("XH_ZA", '.', Just(('\u{A0}', [3])), [:month, :day, :year], '/', ':'),
    ("ZH", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_CN", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HANS_CN", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HANT_HK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_HANT_TW", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZH_HK", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_MO", '.', Just((',', [3])), [:day, :month, :year], '/', ':'),
    ("ZH_SG", '.', Just((',', [3])), [:year, :month, :day], '\u{5E74}', ':'),
    ("ZH_TW", '.', Just((',', [3])), [:year, :month, :day], '/', ':'),
    ("ZU", '.', Just((',', [3])), [:year, :month, :day], '-', ':'),
    ("ZU_ZA", '.', Just((',', [3])), [:year, :month, :day], '-', ':')
  ]
  var found: Culture? = None
  rows.each do |row|
    let (tag, decimal, groups, order, dateSeparator, timeSeparator) = row
    if tag == want
      let numbers = NumberSettings { decimalSeparator: decimal, groups: groups }
      let time = TimeSettings {
        dateOrder: order,
        dateSeparator: dateSeparator,
        timeSeparator: timeSeparator
      }
      found = Just(Culture { name: tag, numbers: numbers, time: Just(time) })
    end
  end
  found
end

# Answers +true+ when the culture's number settings are usable: grouped
# cultures need a group separator that differs from the decimal separator
# and a non-empty list of positive group sizes.
#
# Parsing and printing check this for you — an invalid culture fails loudly
# at use — so call +valid?+ only to fail earlier with your own message.
#
# @param culture [Culture] the culture to check
# @return [Bool] +true+ when the number settings are usable
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.valid?(hu)              # => true
valid? : Culture -> Bool
let valid?(culture) do
  let decimal = culture.numbers.decimalSeparator
  match culture.numbers.groups do
    None => true
    Just((separator, sizes)) => separator != decimal && validSizes?(sizes)
  end
end

# Validates +text+ as an integer in +culture+, answering the normalized
# dot-form text a strict parse delegates to.
#
# The grammar is strict: an optional sign, digits with validated grouping,
# nothing else. Group separators must match the culture and land on group
# boundaries; anything else fails at its exact position with +value: None+.
#
# This is plumbing shared by the typed parses — most callers want
# +Integer.parse(s, culture:)+ instead.
#
# @param text [String] the text to validate
# @param culture [Culture] the culture to validate against
# @return [Result<String, ParseError>] the normalized text, or the failure
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.validateInteger("1 500", hu)              # => Ok("1500")
validateInteger : String -> Culture -> Result<String, ParseError>
let validateInteger(text, culture: Culture) do
  if !valid?(culture)
    return Error(parseErrorAt(text, 0, "invalid culture"))
  end
  if text.empty?
    return Error(parseErrorAt(text, 0, "invalid integer for culture"))
  end
  let (sign, body) = splitSign(text)
  if body.empty?
    return Error(parseErrorAt(text, 1, "invalid integer for culture"))
  end
  let base = text.count - body.count
  let decimal = culture.numbers.decimalSeparator
  let badDecimal = firstFailure(body) { |c| c != decimal }
  match badDecimal do
    Just(i) => return Error(parseErrorAt(text, base + i, "invalid integer for culture"))
    None => None
  end
  match validateIntPart(text, base, body, culture, "invalid integer for culture") do
    Ok(digits) => Ok(sign + digits)
    Error(e) => Error(e)
  end
end

# Validates +text+ as a float in +culture+, answering the normalized
# dot-form text a strict parse delegates to.
#
# The grammar is strict: an optional sign, grouped integer digits, an
# optional decimal separator with required fraction digits, and an optional
# exponent. The decimal separator and exponent marker follow the culture
# only in shape — the normalized text always uses +.+ and +e+.
#
# This is plumbing shared by the typed parses — most callers want
# +Float.parse(s, culture:)+ instead.
#
# @param text [String] the text to validate
# @param culture [Culture] the culture to validate against
# @return [Result<String, ParseError>] the normalized text, or the failure
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.validateFloat("1,44", hu)              # => Ok("1.44")
validateFloat : String -> Culture -> Result<String, ParseError>
let validateFloat(text, culture: Culture) do
  if !valid?(culture)
    return Error(parseErrorAt(text, 0, "invalid culture"))
  end
  if text.empty?
    return Error(parseErrorAt(text, 0, "invalid float for culture"))
  end
  let (sign, body) = splitSign(text)
  if body.empty?
    return Error(parseErrorAt(text, 1, "invalid float for culture"))
  end
  let base = text.count - body.count
  let decimal = culture.numbers.decimalSeparator
  var mantissa = body
  var exponent = ""
  let eFound = firstFailure(body) { |c| c != 'e' && c != 'E' }
  match eFound do
    Just(ei) => do
      mantissa = body.take(ei)
      exponent = body.drop(ei + 1)
    end
    None => None
  end
  if exponent.empty? == false
    let signed = exponent.startsWith?("-") || exponent.startsWith?("+")
    let tail = signed then exponent.drop(1) else exponent
    if tail.empty?
      return Error(parseErrorAt(text, base + body.count, "invalid float for culture"))
    end
    let badTail = firstFailure(tail) { |c| c.digit? }
    match badTail do
      Just(j) => do
        let at = base + (body.count - tail.count) + j
        return Error(parseErrorAt(text, at, "invalid float for culture"))
      end
      None => None
    end
  end
  let (intPart, fracPart, hasDecimal, di) = splitDecimal(mantissa, decimal)
  if intPart.empty?
    return Error(parseErrorAt(text, base, "invalid float for culture"))
  end
  if hasDecimal
    if fracPart.empty?
      return Error(parseErrorAt(text, base + di + 1, "invalid float for culture"))
    end
    let badFrac = firstFailure(fracPart) { |c| c.digit? }
    match badFrac do
      Just(j) => return Error(parseErrorAt(text, base + di + 1 + j, "invalid float for culture"))
      None => None
    end
  end
  match validateIntPart(text, base, intPart, culture, "invalid float for culture") do
    Ok(intDigits) => Ok(sign + intDigits + fracText(fracPart, hasDecimal) + expText(exponent))
    Error(e) => Error(e)
  end
end

# Renders plain dot-form +text+ with the culture's separators: the decimal
# separator is substituted and digit groups are inserted per the culture's
# group sizes. An exponent, if any, passes through unchanged. Answers
# +None+ for an invalid culture (see +valid?+).
#
# This is plumbing shared by the typed prints — most callers want
# +(1500.5).to(String, culture: culture)+ instead.
#
# @param text [String] the dot-form text to render
# @param culture [Culture] the culture to render with
# @return [String?] the rendered text, or +None+ for an invalid culture
#
# @example
#   let hu = Culture.of("HU_HU").or(Culture.DEFAULT)
#   Culture.renderNumber("1500.5", hu)              # => Just("1\u{A0}500,5")
renderNumber : String -> Culture -> String?
let renderNumber(text, culture: Culture) do
  if !valid?(culture)
    return None
  end
  let negative = text.startsWith?("-")
  let digits = negative then text.drop(1) else text
  let eParts = digits.split("e")
  let bigParts = digits.split("E")
  var mantissa = digits
  var exponent = ""
  if eParts.count > 1
    mantissa = eParts.at(0).or("")
    exponent = "e" + eParts.at(1).or("")
  end
  if bigParts.count > 1
    mantissa = bigParts.at(0).or("")
    exponent = "E" + bigParts.at(1).or("")
  end
  let dotParts = mantissa.split(".")
  let grouped = insertGroups(dotParts.at(0).or(""), culture)
  let head = negative then "-" + grouped else grouped
  let decimal = "${culture.numbers.decimalSeparator}"
  match dotParts.at(1) do
    Just(frac) => Just(head + decimal + frac + exponent)
    None => Just(head + exponent)
  end
end

# Answers the machine's culture as an ordinary value: numbers follow the
# +LC_ALL+, +LC_NUMERIC+ or +LANG+ environment variable, falling back to
# +DEFAULT+ when none names a known culture.
#
# The query is explicit and +foul+ — ambient locale never leaks into parsing
# or printing on its own. Bind the answer once and pass it like any other
# culture:
#
#   let culture = Culture.local
#   Float.parse(input, culture: culture)
#
# @return [Culture] the machine's culture, or +DEFAULT+
local : Culture
foul local do
  if let Just(tag) = envNonEmpty("LC_ALL")
    return cultureFromTag(tag)
  end
  if let Just(tag) = envNonEmpty("LC_NUMERIC")
    return cultureFromTag(tag)
  end
  if let Just(tag) = envNonEmpty("LANG")
    return cultureFromTag(tag)
  end
  DEFAULT
end

private do
  # Upper-cases a lookup tag and reads +-+ as +_+, so +"hu-HU"+ finds +HU_HU+.
  let normalizeTag(code: String) -> String = code.upperCase.split("-").join("_")

  # Answers the index of the first character failing +pred+, or +None+ when
  # every character passes.
  let firstFailure(text: String, pred: Char -> Bool) -> Integer? do
    var found: Integer? = None
    var index = 0
    text.chars.each do |c|
      if found.none? && pred(c) == false
        found = Just(index)
      end
      index = index + 1
    end
    found
  end

  # Splits leading sign from body, dropping a leading +++. Answers
  # +(sign, body)+ where sign is +"-"+ or +""+.
  let splitSign(text: String) -> (String, String) do
    if text.startsWith?("-")
      return ("-", text.drop(1))
    end
    if text.startsWith?("+")
      return ("", text.drop(1))
    end
    ("", text)
  end

  # Splits a mantissa on the decimal separator: +(before, after, present,
  # index)+. Only the first separator splits; a second one is the caller's
  # error to report.
  let splitDecimal(text: String, decimal: Char) -> (String, String, Bool, Integer) do
    match firstFailure(text) { |c| c != decimal } do
      Just(i) => (text.take(i), text.drop(i + 1), true, i)
      None => (text, "", false, -1)
    end
  end

  # Builds the +ParseError+ for +index+, counting in characters and reporting
  # byte offsets as +ParseError.position+ requires.
  let parseErrorAt(text: String, index: Integer, message: String) -> ParseError do
    ParseError {
      input: text,
      position: text.take(index).byteSize,
      value: None,
      message: message,
      rest: text.drop(index)
    }
  end

  # Answers +true+ for the space lookalikes: plain space, NBSP (160) and
  # narrow NBSP (8239).
  let spaceLike?(c: Char) -> Bool = c.codepoint == 32 || c.codepoint == 160 || c.codepoint == 8239

  # Accepts every space lookalike (plain, NBSP, narrow NBSP) when the group
  # separator is any of them: keyboards and copy-paste rarely produce NBSP.
  let unifySpaces(text: String, separator: Char) -> String do
    if spaceLike?(separator)
      return text.mapChars { |c| spaceLike?(c) then separator else c }
    end
    text
  end

  # Removes every group separator from already-validated text.
  let stripSeparator(text: String, separator: Char) -> String = text.split("${separator}").join("")

  # Checks grouping structure: every group non-empty with valid sizes, the
  # leftmost holding one up to a full group. Answers +None+ when fine, else
  # the failing group's first character index relative to +part+.
  let checkGroups(part: String, separator: Char, sizes: [Integer]) -> Integer? do
    if sizes.count == 0
      return Just(0)
    end
    let parts = part.split("${separator}")
    var bad: Integer? = None
    var offset = 0
    var i = 0
    parts.each do |piece|
      if bad.none?
        if piece.empty?
          bad = Just(offset)
        else
          match firstFailure(piece) { |c| c.digit? } do
            Just(j) => do
              bad = Just(offset + j)
            end
            None => do
              let fromRight = parts.count - 1 - i
              let capped = fromRight < sizes.count then fromRight else sizes.count - 1
              let want = sizes.at(capped).or(0)
              if parts.count == 1 || i == 0
                if piece.count > want
                  bad = Just(offset)
                end
              else
                if piece.count != want
                  bad = Just(offset)
                end
              end
            end
          end
        end
      end
      offset = offset + piece.count + 1
      i = i + 1
    end
    bad
  end

  # Answers +true+ for a non-empty list of positive group sizes.
  let validSizes?(sizes: [Integer]) -> Bool do
    return sizes.count > 0 && sizes.filter { |n| n >= 1 }.count == sizes.count
  end

  # Validates an integer digit string with the culture's grouping, answering
  # the bare digits. Positions count from +base+ inside +text+.
  let validateIntPart(
    text: String,
    base: Integer,
    part: String,
    culture: Culture,
    message: String
  ) -> Result<String, ParseError> do
    match culture.numbers.groups do
      Just(groups) => do
        let (separator, sizes) = groups
        let unified = unifySpaces(part, separator)
        match checkGroups(unified, separator, sizes) do
          Just(j) => return Error(parseErrorAt(text, base + j, message))
          None => None
        end
        return Ok(stripSeparator(unified, separator))
      end
      None => None
    end
    let badDigit = firstFailure(part) { |c| c.digit? }
    match badDigit do
      Just(j) => return Error(parseErrorAt(text, base + j, message))
      None => None
    end
    Ok(part)
  end

  # Inserts the culture's group separators into integer +digits+.
  let insertGroups(digits: String, culture: Culture) -> String do
    match culture.numbers.groups do
      None => digits
      Just((separator, sizes)) => groupDigits(digits, separator, sizes)
    end
  end

  # Groups +digits+ from the right; the last size repeats forever
  # (CLDR primary/secondary, e.g. en-IN [3, 2]); the leftmost group
  # takes whatever remains. Callers check +valid?+ first.
  let groupDigits(digits: String, separator: Char, sizes: [Integer]) -> String do
    var parts: [String] = []
    var pos = digits.count
    var k = 0
    while pos > 0 do
      let capped = k < sizes.count then k else sizes.count - 1
      let size = sizes.at(capped).or(3)
      if pos <= size
        parts = [digits.take(pos)] + parts
        pos = 0
      else
        parts = [digits.drop(pos - size).take(size)] + parts
        pos = pos - size
      end
      k = k + 1
    end
    parts.join("${separator}")
  end

  # Renders the fraction tail of normalized text: dot plus digits, or nothing
  # without a decimal separator.
  let fracText(frac: String, present: Bool) -> String do
    if present
      return "." + frac
    end
    ""
  end

  # Renders the exponent tail of normalized text, dropping a leading +++.
  let expText(exponent: String) -> String do
    if exponent.empty?
      return ""
    end
    if exponent.startsWith?("+")
      return "e" + exponent.drop(1)
    end
    "e" + exponent
  end

  # Reads one variable, treating missing and empty alike as +None+.
  foul envNonEmpty(name: String) -> String? do
    let value = ENV.get(name, "")
    if value.empty?
      return None
    end
    Just(value)
  end

  # Resolves an environment locale tag to a culture, defaulting to +DEFAULT+.
  # Strips any codeset suffix first, so +"hu_HU.UTF-8"+ finds +HU_HU+.
  foul cultureFromTag(tag: String) -> Culture do
    let bare = tag.split(".").first.or("")
    let clean = bare.split("@").first.or("")
    of(clean).or(DEFAULT)
  end
end
