# A small, WEBrick-style web server.
#
# You build a server by naming a port and mounting routes on it, then start
# it. Configuration is immutable: mounting a route returns an updated server,
# and +start+ hands that configuration to the BEAM runtime.
#
#   let hello(request: Web.Request) -> Web.Response do
#     let name = request.query.get("name", "world")
#     return Web.Response.text("Hello, ${name}!\n")
#   end
#
#   main do
#     let server = Web.Server.build(8080)
#       .get("/", ~home)
#       .get("/hello", ~hello)
#       .post("/echo", ~echo)
#
#     IO.printLine("listening on http://localhost:8080")
#     if let Error(reason) = server.start()
#       IO.printLine("server stopped: ${reason}")
#     end
#   end
#
# A handler is any function from a +Web.Request+ to a +Web.Response+, and the
# +Web.Response+ constructors cover the usual replies — text, HTML, JSON, a
# redirect, a 404.
#
# The server runs on the BEAM backend: +kex -R yourfile.kex+.
module Web do
# One incoming HTTP request.
record Request do
  # The HTTP method, upper case: +"GET"+, +"POST"+.
  method      : String

  # The request path, without the query string: +"/hello"+.
  path        : String

  # The raw query string, without its leading +?+: +"name=Kex"+.
  queryString : String

  # The query string parsed into a map: +{ "name": "Kex" }+.
  query       : Map<String, String>

  # The request headers, keyed by name.
  headers     : Map<String, String>

  # The request body, as text. Empty for a request that has none.
  body        : String
end

# One outgoing HTTP response.
#
# Build one with the +Web.Response+ constructors rather than by hand — they
# set the status and content type for you.
record Response do
  # The HTTP status code to send.
  status  : Integer = 200

  # The response headers, keyed by name.
  headers : Map<String, String> = {}

  # The response body, as text.
  body    : String = ""
end

# Constructors for the usual kinds of reply.
module Response do
  # A 200 response carrying plain text.
  #
  # @param body [String] the text to send
  # @return [Response] a text/plain response
  #
  # @example
  #   Web.Response.text("Hello, ${name}!\n")
  let text(body: String) -> Response do
    return Response {
      status: 200,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
      body: body
    }
  end

  # A plain-text response with a status you choose.
  #
  # @param body [String] the text to send
  # @param status [Integer] the HTTP status code
  # @return [Response] a text/plain response with that status
  #
  # @example
  #   Web.Response.textWithStatus("no such item\n", 404)
  #   Web.Response.textWithStatus("try again later\n", 503)
  let textWithStatus(body: String, status: Integer) -> Response do
    return Response {
      status: status,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
      body: body
    }
  end

  # A 200 response carrying HTML.
  #
  # @param body [String] the HTML to send
  # @return [Response] a text/html response
  #
  # @example
  #   Web.Response.html("<h1>Hello from Kex!</h1>")
  let html(body: String) -> Response do
    return Response {
      status: 200,
      headers: { "Content-Type": "text/html; charset=utf-8" },
      body: body
    }
  end

  # A 200 response carrying JSON.
  #
  # Takes the JSON as text, so pair it with +JSON.stringify+.
  #
  # @param body [String] the JSON text to send
  # @return [Response] an application/json response
  #
  # @example
  #   Web.Response.json(JSON.stringify({ status: "ok" }))
  let json(body: String) -> Response do
    return Response {
      status: 200,
      headers: { "Content-Type": "application/json" },
      body: body
    }
  end

  # A 302 response sending the client to +location+.
  #
  # @param location [String] where to send the client
  # @return [Response] a redirect response
  #
  # @example
  #   Web.Response.redirect("/login")
  let redirect(location: String) -> Response do
    return Response {
      status: 302,
      headers: { "Location": location },
      body: ""
    }
  end

  # A 404 response with a plain-text body.
  #
  # @return [Response] a not-found response
  #
  # @example A handler that falls through to 404
  #   items.get(id).map(~renderItem).or(Web.Response.notFound)
  let notFound -> Response do
    return Response {
      status: 404,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
      body: "Not Found\n"
    }
  end
end

type Handler = Request -> Response

record Route do
  method  : String
  path    : String
  handler : Handler
end

record Server do
  port   : Integer
  routes : [Route] = []
end

private do
  let buildServer(port: Integer) -> Server do
    return Web.Server { port: port }
  end
end

make Web.Server do
  # Mounts +handler+ at +path+ for ANY HTTP method.
  #
  # Use the method-specific forms below when only one method should be
  # answered.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   Web.Server.build(8080).mount("/health", ~health)
  let mount(path: String, handler: Handler) -> Server do
    let route = Route { method: "*", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Mounts +handler+ at +path+ for GET requests.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   Web.Server.build(8080)
  #     .get("/", ~home)
  #     .get("/hello", ~hello)
  let get(path: String, handler: Handler) -> Server do
    let route = Route { method: "GET", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Mounts +handler+ at +path+ for POST requests.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   server.post("/echo", ~echo)
  let post(path: String, handler: Handler) -> Server do
    let route = Route { method: "POST", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Mounts +handler+ at +path+ for PUT requests.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   server.put("/items", ~replaceItem)
  let put(path: String, handler: Handler) -> Server do
    let route = Route { method: "PUT", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Mounts +handler+ at +path+ for PATCH requests.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   server.patch("/items", ~updateItem)
  let patch(path: String, handler: Handler) -> Server do
    let route = Route { method: "PATCH", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Mounts +handler+ at +path+ for DELETE requests.
  #
  # @param path [String] the request path to answer
  # @param handler [Handler] what to run
  # @return [Server] the server, with the route added
  #
  # @example
  #   server.delete("/items", ~removeItem)
  let delete(path: String, handler: Handler) -> Server do
    let route = Route { method: "DELETE", path: path, handler: handler }
    return Server { port: @port, routes: @routes + [route] }
  end

  # Starts listening, and blocks until the server stops.
  #
  # Answers +Error+ with a reason when the server could not start — a port
  # already in use, for instance — or when it stops unexpectedly.
  #
  # Runs on the BEAM backend: +kex -R yourfile.kex+.
  #
  # @return [Result<Void, String>] why the server stopped
  #
  # @example
  #   IO.printLine("listening on http://localhost:8080")
  #   if let Error(reason) = server.start()
  #     IO.printLine("server stopped: ${reason}")
  #   end
  foul start() -> Result<Void, String> do
    return Kex.Intrinsic.Web.serve(this)
  end
end

module Server do
  let build(port: Integer) -> Server = buildServer(port)
end
end
