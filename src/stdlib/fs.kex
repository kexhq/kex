# The filesystem: reading and writing files, walking directories, and
# manipulating paths.
#
# +FS+ is not in the prelude — start with +using FS+.
#
#   using FS
#
#   main do
#     match FS.File.read("config.txt") do
#       Just(text) => IO.printLine(text.lines.count)
#       None       => IO.printError("config.txt is missing")
#     end
#   end
#
# It is organised in three parts:
#
#   FS.File        reading, writing, copying and deleting files
#   FS.Directory   creating, listing and removing directories
#   FS.Path        pure path arithmetic, with no filesystem access at all
#
# The first two are capabilities: everything in them touches the real
# filesystem, so they can only be called from `foul` code, and a test can
# replace the whole of +FS.File+ for a lexical region rather than mutating
# global state. +FS.Path+ is ordinary pure code.
#
# Most read operations answer with an +Optional+ and most write operations
# with a +Bool+, so a missing file or a failed write is an ordinary value you
# handle rather than an exception you catch.
module FS do
  # A filesystem path. An alias for +String+, so every +String+ method applies
  # to one; +FS.Path+ adds the path-aware operations.
  type FilePath = String

  # How a file should be opened: +Read+ to read it, +Write+ to replace it,
  # +Append+ to add to its end, +ReadWrite+ for both. The mode chosen decides
  # what type the resulting +FileHandle+ has, and therefore which operations
  # the compiler will let you call on it.
  type FileModes = Read | Write | Append | ReadWrite

  # Whether a +FileHandle+ may be read from. Part of the handle's type rather
  # than a runtime flag, so reading from a write-only handle is a compile
  # error.
  type ReadPermission = CanRead | CannotRead

  # Whether a +FileHandle+ may be written to. Part of the handle's type, so
  # writing to a read-only handle is a compile error.
  type WritePermission = CanWrite | CannotWrite

  # A file operation that failed, carrying the path it failed on.
  #
  # +OpenFailed+ and +ReadFailed+ mean the filesystem refused the operation.
  # +InvalidUtf8+ means the bytes were read but are not valid UTF-8, and
  # carries the byte offset of the first malformed sequence.
  type FileError = OpenFailed(FilePath)
    | ReadFailed(FilePath)
    | InvalidUtf8(FilePath, Integer)

  # Reading and writing files.
  #
  # A capability: every member reaches the real filesystem, so a test can
  # replace the whole thing for a lexical region with `with FS.File = ...`
  # instead of mutating global mock state (kexhq/kex#143). The boundary is here
  # rather than on `FS`, because `FS.Path` below is pure string work with no
  # implementation to substitute.
  capability File do
    # Opens +path+ and returns a +FileHandle+ for it.
    #
    # The mode decides the handle's type, and the type decides what you may
    # do with it: a handle opened +Read+ has no +write+, a handle opened
    # +Write+ has no +read+. That is checked at compile time, not at run time.
    #
    # Use the whole-file +read+ and +write+ below when a file fits in memory
    # and you have no reason to hold it open; reach for a handle when you want
    # to stream through a large file or make many small writes.
    #
    # Close the handle when you are done with it.
    #
    # @param path [FilePath] the file to open
    # @param mode [FileModes] +Read+, +Write+, +Append+ or +ReadWrite+
    # @return [Result<FileHandle, FileError>] the handle, or +OpenFailed+
    #
    # @example Reading a file line by line
    #   match FS.File.open("log.txt", Read) do
    #     Ok(handle) => do
    #       IO.printLine(handle.readLine.or(""))
    #       handle.close
    #     end
    #     Error(e) => IO.printError("cannot open: ${e}")
    #   end
    #
    # @example Writing a report
    #   match FS.File.open("report.txt", Write) do
    #     Ok(handle) => do
    #       rows.each { |row| handle.printLine(row) }
    #       handle.close
    #     end
    #     Error(_) => IO.printError("cannot write report")
    #   end
    #
    # @example A failure names the path
    #   FS.File.open("missing/x.txt", Read)   # => Error(OpenFailed("missing/x.txt"))
    open : FilePath -> Read -> Result<FileHandle<CanRead, CannotWrite>, FileError>
    open : FilePath -> Write -> Result<FileHandle<CannotRead, CanWrite>, FileError>
    open : FilePath -> Append -> Result<FileHandle<CannotRead, CanWrite>, FileError>
    open : FilePath -> ReadWrite -> Result<FileHandle<CanRead, CanWrite>, FileError>
    foul open(path, mode) = Kex.Intrinsic.File.open(path, mode)

    # Block form: opens +path+, runs the block with the handle, and closes it.
    #
    # +Ok+ carries whatever the block returned, so the handle does not outlive
    # the region allowed to use it and no call site has to remember +close+.
    # The mode picks the handle's type here exactly as it does above, so a
    # block given a +Read+ handle still cannot write through it.
    #
    # The close is NOT an +ensure+: Kex has no such form, so a block that
    # raises still leaks the handle. Use +trying+ inside the block to cover
    # that today.
    #
    # @param path [FilePath] the file to open
    # @param mode [FileModes] +Read+, +Write+, +Append+ or +ReadWrite+
    # @param block [FileHandle -> A] what to do with the open handle
    # @return [Result<A, FileError>] the block's value, or +OpenFailed+
    #
    # @example Writing a report, with no +close+ to forget
    #   FS.File.open("report.txt", Write) do |handle|
    #     rows.each { |row| handle.printLine(row) }
    #   end
    #
    # @example The block's value comes back in +Ok+
    #   FS.File.open("log.txt", Read) do |handle|
    #     handle.read.or("").lines.length
    #   end
    #   # => Ok(42)
    #
    # @example A failure to open never runs the block
    #   FS.File.open("missing/x.txt", Read) { |h| h.read }
    #   # => Error(OpenFailed("missing/x.txt"))
    open : FilePath -> Read -> (FileHandle<CanRead, CannotWrite> -> A) -> Result<A, FileError>
    open : FilePath -> Write -> (FileHandle<CannotRead, CanWrite> -> A) -> Result<A, FileError>
    open : FilePath -> Append -> (FileHandle<CannotRead, CanWrite> -> A) -> Result<A, FileError>
    open : FilePath -> ReadWrite -> (FileHandle<CanRead, CanWrite> -> A) -> Result<A, FileError>
    foul open(path, mode, block) do
      match Kex.Intrinsic.File.open(path, mode) do
        Error(e) => Error(e)
        Ok(handle) => do
          let result = block(handle)
          handle.close
          Ok(result)
        end
      end
    end

    # Reads the whole file and decodes it as UTF-8 text.
    #
    # Answers +Error(ReadFailed(path))+ when the file does not exist or cannot
    # be read, and +Error(InvalidUtf8(path, offset))+ when the bytes are not
    # valid UTF-8 — so a missing or non-text file is something you handle
    # rather than something that stops the program. Reach for
    # +FS.File.readBytes+ when the contents are not text.
    #
    # @param path [FilePath] the file to read
    # @return [Result<String, FileError>] the contents, or the failure
    #
    # @example
    #   FS.File.read("hello.txt")     # => Ok("hello\n")
    #   FS.File.read("nowhere.txt")   # => Error(ReadFailed("nowhere.txt"))
    #
    # @example Reading with a default
    #   let config = FS.File.read("app.conf").or("")
    #
    # @example Counting words in a file
    #   FS.File.read("essay.txt").or("").split(" ").reject(~empty?).count
    read : FilePath -> Result<String, FileError>
    foul read(path) = Kex.Intrinsic.File.read(path)

    # Reads the whole file as raw bytes, without decoding it as text.
    #
    # The byte counterpart of +FS.File.read+: it never validates UTF-8, so it
    # round trips images, archives, and any other non-text payload losslessly.
    # Answers +Error(ReadFailed(path))+ when the file cannot be read.
    #
    # @param path [FilePath] the file to read
    # @return [Result<Binary, FileError>] the contents, or the failure
    #
    # @example
    #   FS.File.readBytes("logo.png")   # => Ok(#Binary<2048 bytes>)
    #
    # @example Hashing a file
    #   FS.File.readBytes(path).map { |data| Digest.sha256(data).hex }
    readBytes : FilePath -> Result<Binary, FileError>
    foul readBytes(path) = Kex.Intrinsic.File.readBytes(path)

    # Writes +content+ to +path+ as raw bytes, replacing whatever was there.
    #
    # The byte counterpart of +FS.File.write+: the payload lands on disk
    # exactly as given, with no encoding step. Answers +false+ when the write
    # fails.
    #
    # @param path [FilePath] the file to write
    # @param content [Binary] the bytes to write
    # @return [Bool] +true+ when the write succeeded
    #
    # @example
    #   FS.File.writeBytes("out.bin", Binary.fromBytes([0, 255]))   # => true
    #
    # @example Copying a file without decoding it
    #   FS.File.readBytes(source).map { |data| FS.File.writeBytes(target, data) }
    writeBytes : FilePath -> Binary -> Bool
    foul writeBytes(path, content) = Kex.Intrinsic.File.writeBytes(path, content)

    # Writes +content+ to +path+, replacing whatever was there.
    #
    # Creates the file if it does not exist. The containing directory must
    # already exist — see +FS.Directory.create+. Answers +false+ when the
    # write fails.
    #
    # @param path [FilePath] the file to write
    # @param content [String] the text to write
    # @return [Bool] +true+ when the write succeeded
    #
    # @example
    #   FS.File.write("out.txt", "hello\n")   # => true
    #
    # @example Reporting a failed write
    #   if !FS.File.write(target, rendered)
    #     IO.printError("could not write ${target}")
    #   end
    #
    # @example Writing a list of lines
    #   FS.File.write("names.txt", names.join("\n") + "\n")
    write : FilePath -> String -> Bool
    foul write(path, content) = Kex.Intrinsic.File.write(path, content)

    # Adds +content+ to the end of +path+, keeping what is already there.
    #
    # Creates the file if it does not exist, so it is safe to append to a log
    # that has not been started yet.
    #
    # @param path [FilePath] the file to append to
    # @param content [String] the text to add
    # @return [Bool] +true+ when the write succeeded
    #
    # @example
    #   FS.File.append("app.log", "started\n")   # => true
    #
    # @example A simple logger
    #   foul log(message: String) -> Void do
    #     FS.File.append("app.log", "${Time.now.to(String).or("")} ${message}\n")
    #   end
    append : FilePath -> String -> Bool
    foul append(path, content) = Kex.Intrinsic.File.append(path, content)

    # Returns +true+ when something exists at +path+ — a file, a directory, or
    # anything else. Use +file?+ or +directory?+ when the kind matters.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ when the path exists
    #
    # @example
    #   FS.File.exists?("README.md")   # => true
    #   FS.File.exists?("nowhere")     # => false
    #
    # @example Not overwriting an existing file
    #   if FS.File.exists?(target)
    #     IO.printError("${target} already exists")
    #   else
    #     FS.File.write(target, content)
    #   end
    exists? : FilePath -> Bool
    foul exists?(path) = Kex.Intrinsic.File.exists?(path)

    # Returns +true+ when +path+ exists and is a regular file — not a
    # directory.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a regular file
    #
    # @example
    #   FS.File.file?("README.md")   # => true
    #   FS.File.file?("src")         # => false
    file? : FilePath -> Bool
    foul file?(path) = Kex.Intrinsic.File.file?(path)

    # Returns +true+ when +path+ exists and is a directory.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a directory
    #
    # @example
    #   FS.File.directory?("src")        # => true
    #   FS.File.directory?("README.md")  # => false
    #
    # @example Separating files from directories in a listing
    #   entries.partition { |e| FS.File.directory?(e) }
    directory? : FilePath -> Bool
    foul directory?(path) = Kex.Intrinsic.File.directory?(path)

    # Deletes the file at +path+.
    #
    # Answers +false+ when the file does not exist or cannot be removed. Use
    # +FS.Directory.delete+ for a directory.
    #
    # @param path [FilePath] the file to delete
    # @return [Bool] +true+ when the file was deleted
    #
    # @example
    #   FS.File.delete("tmp.txt")   # => true
    #
    # @example Cleaning up after a temporary file
    #   FS.File.write(tmp, data)
    #   process(tmp)
    #   FS.File.delete(tmp)
    delete : FilePath -> Bool
    foul delete(path) = Kex.Intrinsic.File.delete(path)

    # Copies the file at +src+ to +dst+, replacing +dst+ if it exists.
    #
    # @param src [FilePath] the file to copy
    # @param dst [FilePath] where to copy it
    # @return [Bool] +true+ when the copy succeeded
    #
    # @example
    #   FS.File.copy("app.conf", "app.conf.bak")   # => true
    #
    # @example Backing a file up before rewriting it
    #   FS.File.copy(path, "${path}.bak")
    #   FS.File.write(path, updated)
    copy : FilePath -> FilePath -> Bool
    foul copy(src, dst) = Kex.Intrinsic.File.copy(src, dst)

    # Renames — or moves — the file at +src+ to +dst+.
    #
    # @param src [FilePath] the current path
    # @param dst [FilePath] the new path
    # @return [Bool] +true+ when the rename succeeded
    #
    # @example
    #   FS.File.rename("draft.txt", "final.txt")   # => true
    #
    # @example Writing to a temporary file, then swapping it in
    #   FS.File.write("${path}.tmp", content)
    #   FS.File.rename("${path}.tmp", path)
    rename : FilePath -> FilePath -> Bool
    foul rename(src, dst) = Kex.Intrinsic.File.rename(src, dst)

    # Reads the file and returns its lines, without their newlines.
    #
    # Answers +None+ when the file cannot be read. A trailing newline does not
    # produce a final empty line, so the count is the number of lines you
    # would see in an editor.
    #
    # @param path [FilePath] the file to read
    # @return [[String]?] the lines, or +None+
    #
    # @example
    #   FS.File.readLines("names.txt")   # => Just(["ada", "grace"])
    #   FS.File.readLines("nowhere")     # => None
    #
    # @example Ignoring blank lines and comments
    #   FS.File.readLines("hosts")
    #     .or([])
    #     .map(~trim)
    #     .reject { |line| line.empty? || line.startsWith?("#") }
    # NOT `lines`: FilePath is an alias for String, so a receiver function
    # named `lines` here is indistinguishable from String's own `lines` at
    # every call site, and merely saying `using FS` made `text.lines`
    # ambiguous. `readLines` also says what it does — it reads the file.
    readLines : FilePath -> [String]?
    foul readLines(path) = Kex.Intrinsic.File.lines(path)

    # Returns a lazy +Feed+ of the file's lines, or +None+ when it cannot be
    # read.
    #
    # Unlike +readLines+, the file is read a line at a time off a handle held
    # open for the feed's lifetime, so this is the way to walk a file too large
    # to hold in memory — nothing but the current line is retained.
    #
    # A +Feed+ rather than a +Stream+ because that is what a file honestly is:
    # reading consumes, and there is no rewinding. Taking twice walks forward
    # rather than answering the same lines again. On a file small enough to
    # replay, +toStream+ buys that back.
    #
    # The feed ends at the last line, so asking for more lines than the file
    # has answers just the lines there are — unlike +Stream.Sequence+, which is
    # deliberately infinite.
    #
    #   FS.File.feed("two-lines.txt").map { |lines| lines.take(5) }.or([])
    #   # => ["one", "two"]
    #
    # @param path [FilePath] the file to read
    # @return [Feed<String>?] the lines as a feed, or +None+
    #
    # @example Peeking at the head of a large file
    #   match FS.File.feed("huge.log") do
    #     Just(lines) => lines.take(10).each { |line| IO.printLine(line) }
    #     None        => IO.printError("cannot read huge.log")
    #   end
    #
    # @example The first ten errors in a long log, in one pass
    #   FS.File.feed("app.log")
    #     .map { |lines| lines.filter { |line| line.contains?("ERROR") }.take(10) }
    #     .or([])
    feed : FilePath -> Feed<String>?
    foul feed(path) = Kex.Intrinsic.File.feed(path)

    # Returns the file's size in bytes, or +None+ when it cannot be read.
    #
    # Bytes, not characters — a file of non-ASCII text has more bytes than it
    # has characters.
    #
    # @param path [FilePath] the file to measure
    # @return [Integer?] the size in bytes, or +None+
    #
    # @example
    #   FS.File.size("hello.txt")   # => Just(6)
    #   FS.File.size("nowhere")     # => None
    #
    # @example Skipping files that are too large
    #   paths.filter { |p| FS.File.size(p).or(0) < 1048576 }
    size : FilePath -> Integer?
    foul size(path) = Kex.Intrinsic.File.size(path)

    # Resolves +path+ against the process's current directory and returns the
    # absolute form, or +None+ when it cannot be resolved.
    #
    # This is the one path operation that is not in +FS.Path+, because it is
    # not lexical: it asks the process where it is.
    #
    # @param path [FilePath] the path to resolve
    # @return [String?] the absolute path, or +None+
    #
    # @example
    #   FS.File.absolute("src/main.kex")   # => Just("/home/ada/proj/src/main.kex")
    #
    # @example Reporting a file unambiguously
    #   IO.printError("failed: ${FS.File.absolute(path).or(path)}")
    # Path manipulation lives in FS.Path — `basename`, `dirname`,
    # `extension` and `join` used to be here too, but a name cannot sit in
    # both modules: FilePath IS String, so two same-named receiver functions
    # on it are indistinguishable at every call site. `absolute` stays
    # because it is not lexical — it asks the process where it is.
    absolute : FilePath -> String?
    foul absolute(path) = Kex.Intrinsic.File.absolute(path)
  end

  # Path arithmetic: joining, splitting, normalising and comparing paths.
  #
  # Everything here is pure string manipulation with no filesystem access, so
  # the answer is the same whether or not the path exists — which also means
  # these functions can be called from ordinary pure code, unlike +FS.File+.
  # POSIX separators only for now.
  #
  #   FS.Path.join("src", "main.kex")            # => "src/main.kex"
  #   FS.Path.extension("src/main.kex")          # => ".kex"
  #   FS.Path.withExtension("src/main.kex", "beam")   # => "src/main.beam"
  module Path do
    # The path separator, +"/"+.
    #
    # @return [String] the separator
    #
    # @example
    #   FS.Path.separator   # => "/"
    separator : String
    let separator = "/"

    # Joins two path parts with a single separator and normalises the result.
    #
    # Repeated separators collapse, so +join("a/", "/b")+ is +"a/b"+ and not
    # +"a//b"+. An absolute second part does NOT restart the path, the way
    # Ruby's +Pathname#join+ would — use that part on its own if that is what
    # you mean.
    #
    # @param a [FilePath] the first part
    # @param b [FilePath] the second part
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.join("src", "main.kex")   # => "src/main.kex"
    #   FS.Path.join("a/", "/b")          # => "a/b"
    #   FS.Path.join("a/b", "../c")       # => "a/c"
    #
    # @example Building a path under a base directory
    #   FS.Path.join(outputDir, FS.Path.basename(source))
    join : FilePath -> FilePath -> String
    let join(a, b) = FS.Path.joinAll([a, b])

    # Joins three path parts with single separators and normalises the
    # result.
    #
    # @param a [FilePath] the first part
    # @param b [FilePath] the second part
    # @param c [FilePath] the third part
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.join("a", "b", "c.txt")   # => "a/b/c.txt"
    join : FilePath -> FilePath -> FilePath -> String
    let join(a, b, c) = FS.Path.joinAll([a, b, c])

    # Joins any number of path parts, skipping empty ones, and normalises the
    # result. An empty list gives +"."+.
    #
    # @param parts [[FilePath]] the parts to join
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.joinAll(["a", "b", "c.txt"])   # => "a/b/c.txt"
    #   FS.Path.joinAll(["a", "", "b"])        # => "a/b"
    #   FS.Path.joinAll([])                    # => "."
    #
    # @example Rebuilding a path from its segments
    #   FS.Path.joinAll(FS.Path.segments(path).drop(1))
    # The list form is `joinAll`, not another `join` overload: a list
    # receiver already has `List.join`, and a second one-argument `join` on
    # the same receiver would be indistinguishable from it.
    joinAll : [FilePath] -> String
    let joinAll(parts) do
      let present = parts.filter { |part| !part.empty? }
      return "." if present.empty?
      return FS.Path.normalize(FS.Path.glue(present))
    end

    # Resolves +.+ and +..+ in a path, lexically.
    #
    # Because it is lexical it never follows a symlink and never touches the
    # disk. A leading +..+ in a RELATIVE path is kept — there is no way to
    # know what it escapes to — while one in an absolute path is dropped,
    # since +/+ has no parent.
    #
    # @param path [FilePath] the path to normalise
    # @return [String] the normalised path
    #
    # @example
    #   FS.Path.normalize("a/./b/../c")   # => "a/c"
    #   FS.Path.normalize("../a")         # => "../a"
    #   FS.Path.normalize("/a/../../b")   # => "/b"
    #
    # @example Comparing two paths for equality
    #   FS.Path.normalize(a) == FS.Path.normalize(b)
    normalize : FilePath -> String
    let normalize(path) do
      let rooted = FS.Path.absolute?(path)
      let parts = path.split(FS.Path.separator)
        .filter { |part| !part.empty? && part != "." }
      let empty: [String] = []
      let stack = parts.reduce(empty) do |acc, part|
        FS.Path.resolveStep(acc, part, rooted)
      end
      let joined = FS.Path.glue(stack)
      return "${FS.Path.separator}${joined}" if rooted
      return "." if joined.empty?
      return joined
    end

    # Returns the non-empty parts of the normalised path. The root +/+ and the
    # current directory +.+ have none.
    #
    # @param path [FilePath] the path to split
    # @return [[String]] the segments, outermost first
    #
    # @example
    #   FS.Path.segments("/a/b/c")   # => ["a", "b", "c"]
    #   FS.Path.segments("a/./b")    # => ["a", "b"]
    #   FS.Path.segments("/")        # => []
    #
    # @example How deep a path is
    #   FS.Path.segments(path).count
    segments : FilePath -> [String]
    let segments(path) do
      let normalized = FS.Path.normalize(path)
      return [] if normalized == "." || normalized == FS.Path.separator
      return normalized.split(FS.Path.separator).filter { |part| !part.empty? }
    end

    # Returns +true+ when the path starts at the root.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for an absolute path
    #
    # @example
    #   FS.Path.absolute?("/etc/hosts")   # => true
    #   FS.Path.absolute?("src/main")     # => false
    absolute? : FilePath -> Bool
    let absolute?(path) = path.startsWith?(FS.Path.separator)

    # Returns +true+ when the path does not start at the root. The opposite of
    # +absolute?+.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a relative path
    #
    # @example
    #   FS.Path.relative?("src/main")     # => true
    #   FS.Path.relative?("/etc/hosts")   # => false
    relative? : FilePath -> Bool
    let relative?(path) = !FS.Path.absolute?(path)

    # Returns the path's parent directory.
    #
    # A child of the root has +"/"+ as its parent; a bare name has +"."+, the
    # current directory.
    #
    # @param path [FilePath] the path to take the parent of
    # @return [String] the parent directory
    #
    # @example
    #   FS.Path.dirname("/a/b/c.txt")   # => "/a/b"
    #   FS.Path.dirname("/c.txt")       # => "/"
    #   FS.Path.dirname("c.txt")        # => "."
    #
    # @example Making sure a file's directory exists before writing
    #   FS.Directory.create(FS.Path.dirname(target))
    dirname : FilePath -> String
    let dirname(path) do
      let rooted = FS.Path.absolute?(path)
      let parts = FS.Path.segments(path)
      if parts.count <= 1
        return FS.Path.separator if rooted
        return "."
      end
      let head = FS.Path.glue(parts.take(parts.count - 1))
      return "${FS.Path.separator}${head}" if rooted
      return head
    end

    # Returns the last segment of the path — the file or directory name.
    #
    # The root itself answers +"/"+, and an empty path answers +"."+.
    #
    # @param path [FilePath] the path to take the name of
    # @return [String] the last segment
    #
    # @example
    #   FS.Path.basename("/a/b/c.txt")   # => "c.txt"
    #   FS.Path.basename("/a/b")         # => "b"
    #   FS.Path.basename("/")            # => "/"
    #
    # @example Listing names rather than paths
    #   paths.map { |p| FS.Path.basename(p) }
    basename : FilePath -> String
    let basename(path) do
      let parts = FS.Path.segments(path)
      match parts.last do
        Just(name) => return name
        None => return FS.Path.absolute?(path) then FS.Path.separator else "."
      end
    end

    # Returns the file extension, including its leading dot, or +""+ when
    # there is none.
    #
    # Only the last extension counts, so +"a.tar.gz"+ has +".gz"+. A leading
    # dot is part of the NAME rather than an extension, so +".gitignore"+ has
    # none.
    #
    # @param path [FilePath] the path to inspect
    # @return [String] the extension, or +""+
    #
    # @example
    #   FS.Path.extension("src/main.kex")   # => ".kex"
    #   FS.Path.extension("a/b.tar.gz")     # => ".gz"
    #   FS.Path.extension("README")         # => ""
    #   FS.Path.extension(".gitignore")     # => ""
    #
    # @example Selecting sources by extension
    #   files.filter { |f| FS.Path.extension(f) == ".kex" }
    extension : FilePath -> String
    let extension(path) do
      let name = FS.Path.basename(path)
      return "" if name.startsWith?(".")
      let pieces = name.split(".")
      return "" if pieces.count < 2
      match pieces.last do
        Just(suffix) => return ".${suffix}"
        None => return ""
      end
    end

    # Returns the basename with its extension removed.
    #
    # A name that IS its extension — +".gitignore"+ — keeps it, because it has
    # none to drop.
    #
    # @param path [FilePath] the path to inspect
    # @return [String] the name without its extension
    #
    # @example
    #   FS.Path.stem("src/main.kex")   # => "main"
    #   FS.Path.stem("a/b.tar.gz")     # => "b.tar"
    #   FS.Path.stem(".gitignore")     # => ".gitignore"
    #
    # @example Deriving a module name from a filename
    #   FS.Path.stem(source).capitalize
    stem : FilePath -> String
    let stem(path) do
      let name = FS.Path.basename(path)
      let suffix = FS.Path.extension(path)
      return name if suffix.empty?
      return name.take(name.count - suffix.count)
    end

    # Returns the path with its extension replaced by +wanted+.
    #
    # The new extension may be written with or without its leading dot; an
    # empty one removes the extension entirely.
    #
    # @param path [FilePath] the path to rewrite
    # @param wanted [String] the new extension, with or without its dot
    # @return [String] the rewritten path
    #
    # @example
    #   FS.Path.withExtension("src/main.kex", "beam")    # => "src/main.beam"
    #   FS.Path.withExtension("src/main.kex", ".beam")   # => "src/main.beam"
    #   FS.Path.withExtension("src/main.kex", "")        # => "src/main"
    #
    # @example Deriving an output path from a source path
    #   FS.Path.withExtension(FS.Path.join(outDir, FS.Path.basename(src)), "o")
    withExtension : FilePath -> String -> String
    let withExtension(path, wanted) do
      let bare = !wanted.empty? && !wanted.startsWith?(".")
      let dotted = bare then ".${wanted}" else wanted
      let name = "${FS.Path.stem(path)}${dotted}"
      let parent = FS.Path.dirname(path)
      return name if parent == "."
      return FS.Path.join(parent, name)
    end

    # Expresses +path+ relative to +base+, walking up with +..+ as needed.
    #
    # Purely lexical, so it answers only when both sides are anchored the same
    # way; a relative path against an absolute base, or the reverse, comes
    # back unchanged. A path that IS the base answers +"."+.
    #
    # @param path [FilePath] the path to re-express
    # @param base [FilePath] the directory to express it against
    # @return [String] the relative path
    #
    # @example
    #   FS.Path.relativeTo("/a/b/c.txt", "/a/d")   # => "../b/c.txt"
    #   FS.Path.relativeTo("/a/b/c.txt", "/a")     # => "b/c.txt"
    #   FS.Path.relativeTo("/a/b", "/a/b")         # => "."
    #
    # @example Printing project-relative paths in a report
    #   matches.each { |p| IO.printLine(FS.Path.relativeTo(p, projectRoot)) }
    relativeTo : FilePath -> FilePath -> String
    let relativeTo(path, base) do
      let target = FS.Path.normalize(path)
      let from = FS.Path.normalize(base)
      return target if FS.Path.absolute?(target) != FS.Path.absolute?(from)
      let targetParts = FS.Path.segments(target)
      let fromParts = FS.Path.segments(from)
      let shared = FS.Path.sharedPrefix(targetParts, fromParts, 0)
      let ups = fromParts.drop(shared).map { |_| ".." }
      let rest = targetParts.drop(shared)
      let steps = [...ups, ...rest]
      return "." if steps.empty?
      return FS.Path.glue(steps)
    end

    private do
      # Separator-joins parts that are already clean. Not `parts.join(sep)`:
      # with FilePath aliased to String that call is ambiguous against
      # Path.join itself.
      let glue(parts: [String]) -> String do
        return parts.reduce("") do |acc, part|
          acc.empty? then part else "${acc}${FS.Path.separator}${part}"
        end
      end

      # One `..`-aware step of the normalize fold.
      let resolveStep(acc: [String], part: String, rooted: Bool) -> [String] do
        return acc.push(part) if part != ".."
        let top = match acc.last do
          Just(value) => value
          None => ""
        end
        return acc.take(acc.count - 1) if top != "" && top != ".."
        return acc if rooted
        return acc.push("..")
      end

      let sharedPrefix(a: [String], b: [String], index: Integer) -> Integer do
        return index if index >= a.count || index >= b.count
        return index if a.at(index) != b.at(index)
        return FS.Path.sharedPrefix(a, b, index + 1)
      end
    end
  end

  # Creating, listing and removing directories.
  #
  # Like +FS.File+, everything here reaches the real filesystem and so is
  # `foul`. Listings answer with an +Optional+, so a directory that cannot be
  # read is a value you handle rather than an exception.
  module Directory do
    # Returns +true+ when something exists at +path+.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ when the path exists
    #
    # @example
    #   FS.Directory.exists?("src")   # => true
    exists? : FilePath -> Bool
    foul exists?(path) = Kex.Intrinsic.Directory.exists?(path)

    # Returns +true+ when +path+ exists and is a directory.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a directory
    #
    # @example
    #   FS.Directory.directory?("src")        # => true
    #   FS.Directory.directory?("README.md")  # => false
    directory? : FilePath -> Bool
    foul directory?(path) = Kex.Intrinsic.Directory.directory?(path)

    # Returns +true+ when +path+ exists and is a regular file.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a regular file
    #
    # @example
    #   FS.Directory.file?("README.md")   # => true
    file? : FilePath -> Bool
    foul file?(path) = Kex.Intrinsic.Directory.file?(path)

    # Creates the directory at +path+.
    #
    # @param path [FilePath] the directory to create
    # @return [Bool] +true+ when the directory was created
    #
    # @example
    #   FS.Directory.create("build")   # => true
    #
    # @example Making sure an output directory is there
    #   FS.Directory.create(outDir) if !FS.Directory.exists?(outDir)
    create : FilePath -> Bool
    foul create(path) = Kex.Intrinsic.Directory.create(path)

    # Removes the directory at +path+, which must be empty.
    #
    # Use +deleteAll+ to remove a directory together with its contents.
    #
    # @param path [FilePath] the directory to remove
    # @return [Bool] +true+ when the directory was removed
    #
    # @example
    #   FS.Directory.delete("empty")   # => true
    delete : FilePath -> Bool
    foul delete(path) = Kex.Intrinsic.Directory.delete(path)

    # Removes the directory at +path+ and everything inside it, recursively.
    #
    # This deletes data and cannot be undone — check the path before calling
    # it, particularly when it was computed or came from user input.
    #
    # @param path [FilePath] the directory tree to remove
    # @return [Bool] +true+ when the tree was removed
    #
    # @example
    #   FS.Directory.deleteAll("build")   # => true
    #
    # @example Rebuilding a scratch directory from clean
    #   FS.Directory.deleteAll(tmpDir)
    #   FS.Directory.create(tmpDir)
    deleteAll : FilePath -> Bool
    foul deleteAll(path) = Kex.Intrinsic.Directory.deleteAll(path)

    # Lists the names in +path+ — both files and directories, one level deep.
    #
    # The results are bare names, not paths; join them with +path+ to get
    # something you can open. Answers +None+ when the directory cannot be
    # read.
    #
    # @param path [FilePath] the directory to list
    # @return [[String]?] the entry names, or +None+
    #
    # @example
    #   FS.Directory.list("src")   # => Just(["main.kex", "lexer"])
    #
    # @example Turning names into usable paths
    #   FS.Directory.list(dir).or([]).map { |name| FS.Path.join(dir, name) }
    list : FilePath -> [String]?
    foul list(path) = Kex.Intrinsic.Directory.list(path)

    # Lists only the regular files in +path+, one level deep.
    #
    # @param path [FilePath] the directory to list
    # @return [[String]?] the file names, or +None+
    #
    # @example
    #   FS.Directory.files("src")   # => Just(["main.kex"])
    #
    # @example Every Kex source in a directory
    #   FS.Directory.files(dir)
    #     .or([])
    #     .filter { |f| FS.Path.extension(f) == ".kex" }
    files : FilePath -> [String]?
    foul files(path) = Kex.Intrinsic.Directory.files(path)

    # Lists only the subdirectories of +path+, one level deep.
    #
    # @param path [FilePath] the directory to list
    # @return [[String]?] the directory names, or +None+
    #
    # @example
    #   FS.Directory.directories("src")   # => Just(["lexer", "parser"])
    #
    # @example Walking one level down
    #   FS.Directory.directories(root).or([]).each do |name|
    #     IO.printLine(FS.Path.join(root, name))
    #   end
    directories : FilePath -> [String]?
    foul directories(path) = Kex.Intrinsic.Directory.directories(path)

    # Returns the process's current working directory, as an absolute path.
    #
    # @return [String] the current directory
    #
    # @example
    #   FS.Directory.current   # => "/home/ada/project"
    #
    # @example Resolving a relative path by hand
    #   FS.Path.join(FS.Directory.current, "build")
    current : String
    foul current = Kex.Intrinsic.Directory.current

    # Returns the current user's home directory, or +None+ when it cannot be
    # determined.
    #
    # @return [String?] the home directory, or +None+
    #
    # @example
    #   FS.Directory.home   # => Just("/home/ada")
    #
    # @example A per-user config path
    #   FS.Path.join(FS.Directory.home.or("."), ".apprc")
    home : String?
    foul home = Kex.Intrinsic.Directory.home

    # Returns the directory this system puts temporary files in.
    #
    # Total, unlike +home+: it answers +TMPDIR+ when the environment sets one
    # (+TEMP+ or +TMP+ on Windows) and falls back to +/tmp+, so there is always
    # somewhere to write. The path never ends in a separator, so it composes
    # with +FS.Path.join+ directly.
    #
    # The directory is shared with every other process on the machine, so pick
    # a name unlikely to collide and delete it when you are done.
    #
    # @return [String] the temporary directory
    #
    # @example
    #   FS.Directory.temporary   # => "/tmp"
    #
    # @example A scratch file that cleans up after itself
    #   let scratch = FS.Path.join(FS.Directory.temporary, "report.bin")
    #   FS.File.writeBytes(scratch, payload)
    #   FS.File.delete(scratch)
    temporary : String
    foul temporary = Kex.Intrinsic.Directory.temporary
  end
end

# Mock.FS declarations are in mock.kex alongside Mock.ENV and Mock.IO.
