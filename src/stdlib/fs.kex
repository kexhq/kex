# Files, directories and paths. Bring them into scope with +using FS+.
#
#   using FS
#
#   main do
#     match FS.File.read("config.txt") do
#       Ok(text) => IO.printLine(text.lines.count)
#       Error(_) => IO.printError("config.txt is missing")
#     end
#   end
#
# It has three parts:
#
#   FS.File        reading, writing, copying and deleting files
#   FS.Directory   creating, listing and removing directories
#   FS.Path        path arithmetic, which never touches the filesystem
#
# +FS.File+ and +FS.Directory+ use the real filesystem, so only +foul+ code
# can call them. +FS.File+ is a capability: a test can swap it for a fake
# within a block with +with FS.File = ... do ... end+.
#
# Functions that can fail return a +Result+ with a +FileError+, so a missing
# file is a value to match on. Questions such as +exists?+, +file?+ and
# +directory?+ return a +Bool+, and +Directory.home+, which may not be known,
# returns an +Optional+.
module FS do
  # A filesystem path. It is another name for +String+, so every +String+
  # function works on one; +FS.Path+ has the path functions.
  type FilePath = String

  # How to open a file: +Read+ to read it, +Write+ to replace it, +Append+ to
  # add to its end, +ReadWrite+ for both. The mode sets the type of the
  # +FileHandle+ you get, and so which functions you can call on it.
  type FileMode = Read | Write | Append | ReadWrite

  # Something a file may allow, for +FS.File.changePermission+.
  type Permission = Readable | Writable | Executable

  # Returns the POSIX mode +FS.File.changePermission+ gives a file.
  #
  # The owner gets every listed permission, and everyone else gets the same
  # without +Writable+.
  #
  # @param permissions [[Permission]] everything the file should allow
  # @return [Integer] the permission bits
  #
  # @example
  #   FS.permissionMode([FS.Readable, FS.Writable])   # => 420, which is 0o644
  let permissionMode(permissions: [Permission]) -> Integer do
    let read = permissions.contains?(Readable) then 0o444 else 0
    let write = permissions.contains?(Writable) then 0o200 else 0
    let execute = permissions.contains?(Executable) then 0o111 else 0
    return read + write + execute
  end

  # A file operation that failed, with the path or paths it failed on.
  #
  # Each variant but +InvalidUtf8+ names the operation the filesystem refused:
  # opening, reading, writing, creating, deleting, copying from the first path
  # to the second, renaming the first to the second, or changing permissions.
  # +InvalidUtf8+ means the file was read but is not valid UTF-8; it carries
  # the byte offset of the first bad sequence.
  type FileError = OpenFailed(FilePath)
    | ReadFailed(FilePath)
    | WriteFailed(FilePath)
    | CreateFailed(FilePath)
    | DeleteFailed(FilePath)
    | CopyFailed(FilePath, FilePath)
    | RenameFailed(FilePath, FilePath)
    | ModeFailed(FilePath)
    | InvalidUtf8(FilePath, Integer)

  # What a path names, as +FS.File.info+ reports it.
  #
  # A regular +:file+, a +:directory+, a +:symlink+ (the link itself, not what
  # it points to), or +:other+ for devices, sockets and pipes.
  type FileKind = :file | :directory | :symlink | :other

  # The kind, size and modification time of a path, from +FS.File.info+.
  record FileInfo do
    # Which kind of entry the path names.
    kind : FileKind

    # The size in bytes. For a symlink, the length of the path it holds.
    size : Integer

    # When the contents last changed, in UTC, to the whole second.
    modified : DateTime
  end

  # Reading and writing files.
  #
  # This is a capability, so a test can replace all of it within a block with
  # +with FS.File = ... do ... end+ and run file code without touching the
  # disk. +Mock.Files+ is a ready-made in-memory replacement.
  capability File do
    # Opens +path+ and returns a +FileHandle+ for it.
    #
    # The mode sets the handle's type, and the compiler checks its use: a
    # handle opened +Read+ has no +write+, and one opened +Write+ has no
    # +read+.
    #
    # When the file fits in memory, the whole-file +read+ and +write+ are
    # simpler. Use a handle to stream through a large file or to make many
    # small writes, and close it when you are done; the block form of +open+
    # closes it for you.
    #
    # @param path [FilePath] the file to open
    # @param mode [FileMode] +Read+, +Write+, +Append+ or +ReadWrite+
    # @return [Result<FileHandle, FileError>] the handle, or +OpenFailed+
    #
    # @example Reading a file line by line
    #   match FS.File.open("log.txt", FS.Read) do
    #     Ok(handle) => do
    #       IO.printLine(handle.getLine.or(""))
    #       handle.close
    #     end
    #     Error(e) => IO.printError("cannot open: ${e}")
    #   end
    #
    # @example Writing a report
    #   match FS.File.open("report.txt", FS.Write) do
    #     Ok(handle) => do
    #       rows.each { |row| handle.printLine(row) }
    #       handle.close
    #     end
    #     Error(_) => IO.printError("cannot write report")
    #   end
    #
    # @example A failure names the path
    #   FS.File.open("missing/x.txt", FS.Read)   # => Error(OpenFailed("missing/x.txt"))
    open : FilePath -> FileMode.Read -> Result<FileHandle<CanRead, CannotWrite>, FileError>
    open : FilePath -> FileMode.Write -> Result<FileHandle<CannotRead, CanWrite>, FileError>
    open : FilePath -> FileMode.Append -> Result<FileHandle<CannotRead, CanWrite>, FileError>
    open : FilePath -> FileMode.ReadWrite -> Result<FileHandle<CanRead, CanWrite>, FileError>
    foul open(path, mode) = Kex.Intrinsic.File.open(path, mode)

    # Opens +path+, runs +block+ with the handle, closes it, and returns the
    # block's value in +Ok+.
    #
    # The mode sets the handle's type as in the two-argument +open+, so a
    # block given a +Read+ handle cannot write through it.
    #
    # The handle is closed only when the block returns normally. If the block
    # raises, the handle stays open, so catch errors with +trying+ inside the
    # block when that matters.
    #
    # @param path [FilePath] the file to open
    # @param mode [FileMode] +Read+, +Write+, +Append+ or +ReadWrite+
    # @param block [FileHandle -> A] what to do with the open handle
    # @return [Result<A, FileError>] the block's value, or +OpenFailed+
    #
    # @example Writing a report, with no +close+ to forget
    #   FS.File.open("report.txt", FS.Write) do |handle|
    #     rows.each { |row| handle.printLine(row) }
    #   end
    #
    # @example The block's value comes back in +Ok+
    #   FS.File.open("log.txt", FS.Read) do |handle|
    #     handle.read.or("").lines.length
    #   end
    #   # => Ok(42)
    #
    # @example A failure to open never runs the block
    #   FS.File.open("missing/x.txt", FS.Read) { |h| h.read }
    #   # => Error(OpenFailed("missing/x.txt"))
    open : FilePath -> FileMode.Read -> (FileHandle<CanRead, CannotWrite> -> A) -> Result<A, FileError>
    open : FilePath -> FileMode.Write -> (FileHandle<CannotRead, CanWrite> -> A) -> Result<A, FileError>
    open : FilePath -> FileMode.Append -> (FileHandle<CannotRead, CanWrite> -> A) -> Result<A, FileError>
    open : FilePath -> FileMode.ReadWrite -> (FileHandle<CanRead, CanWrite> -> A) -> Result<A, FileError>
    foul open(path, mode, block) do
      match Kex.Intrinsic.File.open(path, mode) do
        Error(e) => Error(e)
        Ok(handle) => do
          let result = block(handle)
          handle.close
          Ok(result)
        end
      end
    end

    # Reads the whole file and decodes it as UTF-8 text.
    #
    # Returns +Error(ReadFailed(path))+ when the file does not exist or cannot
    # be read, and +Error(InvalidUtf8(path, offset))+ when it is not valid
    # UTF-8. Use +FS.File.readBytes+ for contents that are not text.
    #
    # @param path [FilePath] the file to read
    # @return [Result<String, FileError>] the contents, or the failure
    #
    # @example
    #   FS.File.read("hello.txt")     # => Ok("hello\n")
    #   FS.File.read("nowhere.txt")   # => Error(ReadFailed("nowhere.txt"))
    #
    # @example Reading with a default
    #   let config = FS.File.read("app.conf").or("")
    #
    # @example Counting words in a file
    #   FS.File.read("essay.txt").or("").split(" ").reject(~empty?).count
    read : FilePath -> Result<String, FileError>
    foul read(path) = Kex.Intrinsic.File.read(path)

    # Reads the whole file as raw bytes, without decoding it as text.
    #
    # Use it for images, archives and anything else that is not text. Returns
    # +Error(ReadFailed(path))+ when the file cannot be read.
    #
    # @param path [FilePath] the file to read
    # @return [Result<Binary, FileError>] the contents, or the failure
    #
    # @example
    #   FS.File.readBytes("logo.png")   # => Ok(#Binary<2048 bytes>)
    #
    # @example Hashing a file
    #   FS.File.readBytes(path).map { |data| Digest.sha256(data).hex }
    readBytes : FilePath -> Result<Binary, FileError>
    foul readBytes(path) = Kex.Intrinsic.File.readBytes(path)

    # Writes +content+ to +path+ as raw bytes, replacing whatever was there.
    #
    # The bytes are written exactly as given. Returns +Error(WriteFailed(path))+
    # when the write fails.
    #
    # @param path [FilePath] the file to write
    # @param content [Binary] the bytes to write
    # @return [Result<Void, FileError>] +Ok+ when the write succeeded, or the
    #   failure
    #
    # @example
    #   FS.File.writeBytes("out.bin", Binary.fromBytes([0, 255])).ok?   # => true
    #
    # @example Copying a file without decoding it
    #   FS.File.readBytes(source).into { |data| FS.File.writeBytes(target, data) }
    writeBytes : FilePath -> Binary -> Result<Void, FileError>
    foul writeBytes(path, content) = Kex.Intrinsic.File.writeBytes(path, content)

    # Writes +content+ to +path+, replacing whatever was there.
    #
    # Creates the file if it does not exist, but not its directory; create
    # that first with +FS.Directory.create+. Returns +Error(WriteFailed(path))+
    # when the write fails.
    #
    # @param path [FilePath] the file to write
    # @param content [String] the text to write
    # @return [Result<Void, FileError>] +Ok+ when the write succeeded, or the
    #   failure
    #
    # @example
    #   FS.File.write("out.txt", "hello\n").ok?   # => true
    #
    # @example Reporting a failed write
    #   if FS.File.write(target, rendered).error?
    #     IO.printError("could not write ${target}")
    #   end
    #
    # @example Writing a list of lines
    #   FS.File.write("names.txt", names.join("\n") + "\n")
    write : FilePath -> String -> Result<Void, FileError>
    foul write(path, content) = Kex.Intrinsic.File.write(path, content)

    # Adds +content+ to the end of +path+, keeping what is already there.
    #
    # Creates the file if it does not exist.
    #
    # @param path [FilePath] the file to append to
    # @param content [String] the text to add
    # @return [Result<Void, FileError>] +Ok+ when the write succeeded, or
    #   +WriteFailed+
    #
    # @example
    #   FS.File.append("app.log", "started\n")   # => Ok(())
    #
    # @example A simple logger
    #   foul log(message: String) -> Void do
    #     FS.File.append("app.log", "${Time.now.to(String).or("")} ${message}\n")
    #   end
    append : FilePath -> String -> Result<Void, FileError>
    foul append(path, content) do
      return Kex.Intrinsic.File.append(path, content) then Ok(()) else Error(WriteFailed(path))
    end

    # Returns whether anything exists at +path+, whether a file, a directory
    # or something else. Use +file?+ or +directory?+ when the kind matters.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ when the path exists
    #
    # @example
    #   FS.File.exists?("README.md")   # => true
    #   FS.File.exists?("nowhere")     # => false
    #
    # @example Not overwriting an existing file
    #   if FS.File.exists?(target)
    #     IO.printError("${target} already exists")
    #   else
    #     FS.File.write(target, content)
    #   end
    exists? : FilePath -> Bool
    foul exists?(path) = Kex.Intrinsic.File.exists?(path)

    # Returns whether +path+ exists and is a regular file.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a regular file
    #
    # @example
    #   FS.File.file?("README.md")   # => true
    #   FS.File.file?("src")         # => false
    file? : FilePath -> Bool
    foul file?(path) = Kex.Intrinsic.File.file?(path)

    # Returns whether +path+ exists and is a directory.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a directory
    #
    # @example
    #   FS.File.directory?("src")        # => true
    #   FS.File.directory?("README.md")  # => false
    #
    # @example Separating files from directories in a listing
    #   entries.partition { |e| FS.File.directory?(e) }
    directory? : FilePath -> Bool
    foul directory?(path) = Kex.Intrinsic.File.directory?(path)

    # Deletes the file at +path+.
    #
    # Returns +DeleteFailed+ when the file does not exist or cannot be
    # removed. Use +FS.Directory.delete+ for a directory.
    #
    # @param path [FilePath] the file to delete
    # @return [Result<Void, FileError>] +Ok+ when the file was deleted, or
    #   +DeleteFailed+
    #
    # @example
    #   FS.File.delete("tmp.txt")   # => Ok(())
    #
    # @example Cleaning up after a temporary file
    #   FS.File.write(tmp, data)
    #   process(tmp)
    #   FS.File.delete(tmp)
    delete : FilePath -> Result<Void, FileError>
    foul delete(path) do
      return Kex.Intrinsic.File.delete(path) then Ok(()) else Error(DeleteFailed(path))
    end

    # Copies the file at +src+ to +dst+, replacing +dst+ if it exists.
    #
    # @param src [FilePath] the file to copy
    # @param dst [FilePath] where to copy it
    # @return [Result<Void, FileError>] +Ok+ when the copy succeeded, or
    #   +CopyFailed+
    #
    # @example
    #   FS.File.copy("app.conf", "app.conf.bak")   # => Ok(())
    #
    # @example Backing a file up before rewriting it
    #   FS.File.copy(path, "${path}.bak")
    #   FS.File.write(path, updated)
    copy : FilePath -> FilePath -> Result<Void, FileError>
    foul copy(src, dst) do
      return Kex.Intrinsic.File.copy(src, dst) then Ok(()) else Error(CopyFailed(src, dst))
    end

    # Renames or moves the file at +src+ to +dst+.
    #
    # @param src [FilePath] the current path
    # @param dst [FilePath] the new path
    # @return [Result<Void, FileError>] +Ok+ when the rename succeeded, or
    #   +RenameFailed+
    #
    # @example
    #   FS.File.rename("draft.txt", "final.txt")   # => Ok(())
    #
    # @example Writing to a temporary file, then swapping it in
    #   FS.File.write("${path}.tmp", content)
    #   FS.File.rename("${path}.tmp", path)
    rename : FilePath -> FilePath -> Result<Void, FileError>
    foul rename(src, dst) do
      return Kex.Intrinsic.File.rename(src, dst) then Ok(()) else Error(RenameFailed(src, dst))
    end

    # Sets what may be done with the file at +path+, in a way that works on
    # every system.
    #
    # The file gets exactly the listed permissions, and loses any left out.
    # The owner gets all of them and everyone else the same without
    # +Writable+: on POSIX that is +0o755+ for all three, +0o644+ for
    # +[Readable, Writable]+ and +0o444+ for +[Readable]+. On Windows only
    # +Writable+ has an effect, through the read-only attribute.
    #
    # Use +changeMode+ for exact POSIX bits, such as a file only its owner may
    # read.
    #
    # @param path [FilePath] the file whose permissions to change
    # @param permissions [[Permission]] everything the file should allow
    # @return [Result<Void, FileError>] +Ok+ when the permissions were
    #   changed, or +ModeFailed+
    #
    # @example Making a file read-only
    #   FS.File.changePermission("report.txt", [FS.Readable])   # => Ok(())
    #
    # @example Writing a script and running it
    #   FS.File.write(script, "#!/bin/sh\necho hello\n")
    #   FS.File.changePermission(script, [FS.Readable, FS.Writable, FS.Executable])
    #   Process.run(script, [])
    changePermission : FilePath -> [Permission] -> Result<Void, FileError>
    foul changePermission(path, permissions) do
      let mode = FS.permissionMode(permissions)
      return Kex.Intrinsic.File.changeMode(path, mode) then Ok(()) else Error(ModeFailed(path))
    end

    # Sets the POSIX permission bits of the file at +path+ to +mode+, as
    # +chmod+ does with a numeric mode.
    #
    # Write +mode+ in octal: +0o600+ lets only the owner read and write. The
    # bits are replaced, not added to, and a mode outside +0o0000..0o7777+ is
    # a +ModeFailed+ error. On Windows only the owner-write bit has an effect.
    # +changePermission+ covers the common cases on every system.
    #
    # @param path [FilePath] the file whose mode to change
    # @param mode [Integer] the permission bits, as for +chmod+
    # @return [Result<Void, FileError>] +Ok+ when the mode was changed, or
    #   +ModeFailed+
    #
    # @example
    #   FS.File.changeMode("secrets.txt", 0o600)   # => Ok(())
    changeMode : FilePath -> Integer -> Result<Void, FileError>
    foul changeMode(path, mode) do
      return Kex.Intrinsic.File.changeMode(path, mode) then Ok(()) else Error(ModeFailed(path))
    end

    # Reads the file and returns its lines, without their newlines.
    #
    # Fails as +FS.File.read+ does. A trailing newline does not add an empty
    # last line, so the count matches what an editor shows.
    #
    # It is not called +lines+ because a +FilePath+ is a +String+, and that
    # name would clash with +String.lines+.
    #
    # @param path [FilePath] the file to read
    # @return [Result<[String], FileError>] the lines, or why they could not
    #   be read
    #
    # @example
    #   FS.File.readLines("names.txt")   # => Ok(["ada", "grace"])
    #   FS.File.readLines("nowhere")     # => Error(ReadFailed("nowhere"))
    #
    # @example Ignoring blank lines and comments
    #   FS.File.readLines("hosts")
    #     .or([])
    #     .map(~trim)
    #     .reject { |line| line.empty? || line.startsWith?("#") }
    readLines : FilePath -> Result<[String], FileError>
    foul readLines(path) = Kex.Intrinsic.File.read(path).map { |text| text.lines }

    # Returns the file's lines as a lazy +Feed+, or +ReadFailed+ when the file
    # cannot be opened.
    #
    # The file is read one line at a time from a handle that stays open while
    # the feed is in use, so only the current line is held in memory. Use it
    # for files too large for +readLines+.
    #
    # Reading from a feed consumes it: taking twice gives the next lines, not
    # the same ones again. Call +toStream+ on it when a small file needs to be
    # read more than once. The feed ends at the last line, so taking more
    # lines than the file has returns the lines there are.
    #
    #   FS.File.feed("two-lines.txt").map { |lines| lines.take(5) }.or([])
    #   # => ["one", "two"]
    #
    # @param path [FilePath] the file to read
    # @return [Result<Feed<String>, FileError>] the lines as a feed, or
    #   +ReadFailed+
    #
    # @example Peeking at the head of a large file
    #   match FS.File.feed("huge.log") do
    #     Ok(lines) => lines.take(10).each { |line| IO.printLine(line) }
    #     Error(_)  => IO.printError("cannot read huge.log")
    #   end
    #
    # @example The first ten errors in a long log, in one pass
    #   FS.File.feed("app.log")
    #     .map { |lines| lines.filter { |line| line.contains?("ERROR") }.take(10) }
    #     .or([])
    feed : FilePath -> Result<Feed<String>, FileError>
    foul feed(path) do
      match Kex.Intrinsic.File.feed(path) do
        Just(lines) => return Ok(lines)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns the file's size in bytes, or +ReadFailed+ when it cannot be read.
    #
    # A file of non-ASCII text has more bytes than characters.
    #
    # @param path [FilePath] the file to measure
    # @return [Result<Integer, FileError>] the size in bytes, or +ReadFailed+
    #
    # @example
    #   FS.File.size("hello.txt")   # => Ok(6)
    #   FS.File.size("nowhere")     # => Error(ReadFailed("nowhere"))
    #
    # @example Skipping files that are too large
    #   paths.filter { |p| FS.File.size(p).or(0) < 1048576 }
    size : FilePath -> Result<Integer, FileError>
    foul size(path) do
      match Kex.Intrinsic.File.size(path) do
        Just(bytes) => return Ok(bytes)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns +path+ made absolute against the current directory, or
    # +ReadFailed+ when it cannot be resolved.
    #
    # It lives here and not in +FS.Path+ because it depends on the current
    # directory. Use +canonical+ to also resolve +..+ and symlinks.
    #
    # @param path [FilePath] the path to resolve
    # @return [Result<String, FileError>] the absolute path, or +ReadFailed+
    #
    # @example
    #   FS.File.absolute("src/main.kex")   # => Ok("/home/ada/proj/src/main.kex")
    #
    # @example Reporting a file unambiguously
    #   IO.printError("failed: ${FS.File.absolute(path).or(path)}")
    absolute : FilePath -> Result<String, FileError>
    foul absolute(path) do
      match Kex.Intrinsic.File.absolute(path) do
        Just(resolved) => return Ok(resolved)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns the canonical form of +path+: absolute, with every +.+, +..+ and
    # symlink resolved, like +realpath(3)+.
    #
    # It reads the filesystem, so a path that does not exist or a symlink loop
    # is a +ReadFailed+ error. To keep reads and writes inside a directory,
    # check that the canonical path starts with the directory's canonical
    # path; neither +../+ nor a symlink can get around that.
    #
    # @param path [FilePath] the path to resolve
    # @return [Result<String, FileError>] the canonical path, or +ReadFailed+
    #
    # @example
    #   FS.File.canonical("/tmp/../etc")   # => Ok("/etc") on Linux
    canonical : FilePath -> Result<String, FileError>
    foul canonical(path) = Kex.Intrinsic.File.canonical(path)

    # Returns whether +path+ is itself a symlink. A link to nothing still
    # counts.
    #
    # @param path [FilePath] the path to inspect
    # @return [Bool] +true+ for a symlink
    #
    # @example
    #   FS.File.symlink?("current")   # => true
    symlink? : FilePath -> Bool
    foul symlink?(path) = Kex.Intrinsic.File.symlink?(path)

    # Returns the kind, size and modification time of +path+ in one call.
    #
    # It covers what +file?+, +directory?+, +symlink?+ and +size+ would ask
    # one by one, which suits walking a tree or checking it for changes. A
    # symlink is described as itself, not followed.
    #
    # @param path [FilePath] the path to inspect
    # @return [Result<FileInfo, FileError>] what the path names, or
    #   +ReadFailed+ when it cannot be read
    #
    # @example
    #   FS.File.info("hello.txt").try.size   # => 6
    #   FS.File.info("src").try.kind         # => :directory
    #   FS.File.info("nowhere")              # => Error(ReadFailed("nowhere"))
    #
    # @example Noticing that a file changed
    #   let before = FS.File.info(path).try
    #   ...
    #   let changed = FS.File.info(path).try != before
    info : FilePath -> Result<FileInfo, FileError>
    foul info(path) = match Kex.Intrinsic.File.info(path) do
      Just((kind, size, modified)) => Ok(FileInfo { kind: kind, size: size, modified: DateTime.fromEpochSeconds(modified) })
      None => Error(ReadFailed(path))
    end
  end

  # Path arithmetic: joining, splitting, normalising and comparing paths.
  #
  # These functions only look at the text of the path, never the filesystem,
  # so the result is the same whether or not the path exists, and they can be
  # called from code that is not +foul+. Only the POSIX separator +/+ is
  # understood.
  #
  #   FS.Path.join("src", "main.kex")            # => "src/main.kex"
  #   FS.Path.extension("src/main.kex")          # => ".kex"
  #   FS.Path.withExtension("src/main.kex", "beam")   # => "src/main.beam"
  module Path do
    # The path separator, +"/"+.
    #
    # @return [String] the separator
    #
    # @example
    #   FS.Path.separator   # => "/"
    separator : String
    let separator = "/"

    # Joins two path parts with a single separator and normalises the result.
    #
    # Repeated separators collapse, so +join("a/", "/b")+ is +"a/b"+. An
    # absolute second part does not start the path over, as it would with
    # Ruby's +Pathname#join+.
    #
    # @param a [FilePath] the first part
    # @param b [FilePath] the second part
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.join("src", "main.kex")   # => "src/main.kex"
    #   FS.Path.join("a/", "/b")          # => "a/b"
    #   FS.Path.join("a/b", "../c")       # => "a/c"
    #
    # @example Building a path under a base directory
    #   FS.Path.join(outputDir, FS.Path.basename(source))
    join : FilePath -> FilePath -> String
    let join(a, b) = FS.Path.joinAll([a, b])

    # Joins three path parts with single separators and normalises the
    # result.
    #
    # @param a [FilePath] the first part
    # @param b [FilePath] the second part
    # @param c [FilePath] the third part
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.join("a", "b", "c.txt")   # => "a/b/c.txt"
    join : FilePath -> FilePath -> FilePath -> String
    let join(a, b, c) = FS.Path.joinAll([a, b, c])

    # Joins any number of path parts, skipping empty ones, and normalises the
    # result.
    #
    # An empty list gives +"."+.
    #
    # @param parts [[FilePath]] the parts to join
    # @return [String] the joined, normalised path
    #
    # @example
    #   FS.Path.joinAll(["a", "b", "c.txt"])   # => "a/b/c.txt"
    #   FS.Path.joinAll(["a", "", "b"])        # => "a/b"
    #   FS.Path.joinAll([])                    # => "."
    #
    # @example Rebuilding a path from its segments
    #   FS.Path.joinAll(FS.Path.segments(path).drop(1))
    joinAll : [FilePath] -> String
    let joinAll(parts) do
      # Not another `join` overload: a list already has `List.join`, and a
      # one-argument `join` on it could not be told apart from that.
      let present = parts.filter { |part| !part.empty? }
      return "." if present.empty?
      return FS.Path.normalize(FS.Path.glue(present))
    end

    # Resolves +.+ and +..+ in a path, lexically.
    #
    # It does not look at the disk or follow symlinks. A leading +..+ is kept
    # in a relative path and dropped in an absolute one, since +/+ has no
    # parent.
    #
    # @param path [FilePath] the path to normalise
    # @return [String] the normalised path
    #
    # @example
    #   FS.Path.normalize("a/./b/../c")   # => "a/c"
    #   FS.Path.normalize("../a")         # => "../a"
    #   FS.Path.normalize("/a/../../b")   # => "/b"
    #
    # @example Comparing two paths for equality
    #   FS.Path.normalize(a) == FS.Path.normalize(b)
    normalize : FilePath -> String
    let normalize(path) do
      let rooted = FS.Path.absolute?(path)
      let parts = path.split(FS.Path.separator)
        .filter { |part| !part.empty? && part != "." }
      let empty: [String] = []
      let stack = parts.reduce(empty) do |acc, part|
        FS.Path.resolveStep(acc, part, rooted)
      end
      let joined = FS.Path.glue(stack)
      return "${FS.Path.separator}${joined}" if rooted
      return "." if joined.empty?
      return joined
    end

    # Returns the non-empty parts of the normalised path. The root +/+ and the
    # current directory +.+ have none.
    #
    # @param path [FilePath] the path to split
    # @return [[String]] the segments, outermost first
    #
    # @example
    #   FS.Path.segments("/a/b/c")   # => ["a", "b", "c"]
    #   FS.Path.segments("a/./b")    # => ["a", "b"]
    #   FS.Path.segments("/")        # => []
    #
    # @example How deep a path is
    #   FS.Path.segments(path).count
    segments : FilePath -> [String]
    let segments(path) do
      let normalized = FS.Path.normalize(path)
      return [] if normalized == "." || normalized == FS.Path.separator
      return normalized.split(FS.Path.separator).filter { |part| !part.empty? }
    end

    # Returns whether the path starts at the root.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for an absolute path
    #
    # @example
    #   FS.Path.absolute?("/etc/hosts")   # => true
    #   FS.Path.absolute?("src/main")     # => false
    absolute? : FilePath -> Bool
    let absolute?(path) = path.startsWith?(FS.Path.separator)

    # Returns whether the path does not start at the root, the opposite of
    # +absolute?+.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a relative path
    #
    # @example
    #   FS.Path.relative?("src/main")     # => true
    #   FS.Path.relative?("/etc/hosts")   # => false
    relative? : FilePath -> Bool
    let relative?(path) = !FS.Path.absolute?(path)

    # Returns the path's parent directory.
    #
    # A child of the root has +"/"+ as its parent, and a bare name has +"."+.
    # Like POSIX +dirname+, it does not resolve +..+: +dirname("a/b/..")+ is
    # +"a/b"+. Call +normalize+ first to resolve it.
    #
    # @param path [FilePath] the path to take the parent of
    # @return [String] the parent directory
    #
    # @example
    #   FS.Path.dirname("/a/b/c.txt")   # => "/a/b"
    #   FS.Path.dirname("/c.txt")       # => "/"
    #   FS.Path.dirname("c.txt")        # => "."
    #
    # @example Making sure a file's directory exists before writing
    #   FS.Directory.create(FS.Path.dirname(target))
    dirname : FilePath -> String
    let dirname(path) do
      let rooted = FS.Path.absolute?(path)
      let parts = FS.Path.lexicalParts(path)
      if parts.count <= 1
        return FS.Path.separator if rooted
        return "."
      end
      let head = FS.Path.glue(parts.take(parts.count - 1))
      return "${FS.Path.separator}${head}" if rooted
      return head
    end

    # Returns the last segment of the path, the file or directory name.
    #
    # The root gives +"/"+ and an empty path +""+. Like +dirname+, it does not
    # resolve +..+: +basename("a/b/..")+ is +".."+.
    #
    # @param path [FilePath] the path to take the name of
    # @return [String] the last segment
    #
    # @example
    #   FS.Path.basename("/a/b/c.txt")   # => "c.txt"
    #   FS.Path.basename("/a/b")         # => "b"
    #   FS.Path.basename("/")            # => "/"
    #
    # @example Listing names rather than paths
    #   paths.map { |p| FS.Path.basename(p) }
    basename : FilePath -> String
    let basename(path) do
      return "" if path.empty?
      match FS.Path.lexicalParts(path).last do
        Just(name) => return name
        None => return FS.Path.absolute?(path) then FS.Path.separator else "."
      end
    end

    # Returns the file extension, including its leading dot, or +""+ when
    # there is none.
    #
    # Only the last extension counts, so +"a.tar.gz"+ has +".gz"+. A leading
    # dot belongs to the name, so +".gitignore"+ has no extension.
    #
    # @param path [FilePath] the path to inspect
    # @return [String] the extension, or +""+
    #
    # @example
    #   FS.Path.extension("src/main.kex")   # => ".kex"
    #   FS.Path.extension("a/b.tar.gz")     # => ".gz"
    #   FS.Path.extension("README")         # => ""
    #   FS.Path.extension(".gitignore")     # => ""
    #
    # @example Selecting sources by extension
    #   files.filter { |f| FS.Path.extension(f) == ".kex" }
    extension : FilePath -> String
    let extension(path) do
      let name = FS.Path.basename(path)
      return "" if name.startsWith?(".")
      let pieces = name.split(".")
      return "" if pieces.count < 2
      match pieces.last do
        Just(suffix) => return ".${suffix}"
        None => return ""
      end
    end

    # Returns the basename with its extension removed.
    #
    # +".gitignore"+ stays as it is, since it has no extension.
    #
    # @param path [FilePath] the path to inspect
    # @return [String] the name without its extension
    #
    # @example
    #   FS.Path.stem("src/main.kex")   # => "main"
    #   FS.Path.stem("a/b.tar.gz")     # => "b.tar"
    #   FS.Path.stem(".gitignore")     # => ".gitignore"
    #
    # @example Deriving a module name from a filename
    #   FS.Path.stem(source).capitalize
    stem : FilePath -> String
    let stem(path) do
      let name = FS.Path.basename(path)
      let suffix = FS.Path.extension(path)
      return name if suffix.empty?
      return name.take(name.count - suffix.count)
    end

    # Returns the path with its extension replaced by +wanted+.
    #
    # +wanted+ may be written with or without its leading dot, and an empty one
    # removes the extension. A path with no file name, such as +"."+ or +"/"+,
    # comes back unchanged.
    #
    # @param path [FilePath] the path to rewrite
    # @param wanted [String] the new extension, with or without its dot
    # @return [String] the rewritten path
    #
    # @example
    #   FS.Path.withExtension("src/main.kex", "beam")    # => "src/main.beam"
    #   FS.Path.withExtension("src/main.kex", ".beam")   # => "src/main.beam"
    #   FS.Path.withExtension("src/main.kex", "")        # => "src/main"
    #
    # @example Deriving an output path from a source path
    #   FS.Path.withExtension(FS.Path.join(outDir, FS.Path.basename(src)), "o")
    withExtension : FilePath -> String -> String
    let withExtension(path, wanted) do
      # A path that names no file (empty, ".", "..", or the root) has no
      # extension to change.
      return path if ["", ".", "..", FS.Path.separator].contains?(FS.Path.basename(path))
      let bare = !wanted.empty? && !wanted.startsWith?(".")
      let dotted = bare then ".${wanted}" else wanted
      let name = "${FS.Path.stem(path)}${dotted}"
      let parent = FS.Path.dirname(path)
      return name if parent == "."
      return FS.Path.join(parent, name)
    end

    # Returns +path+ relative to +base+, going up with +..+ as needed.
    #
    # It works on the text alone, so both must be absolute or both relative;
    # otherwise +path+ comes back normalised but otherwise unchanged. A path
    # equal to +base+ gives +"."+.
    #
    # @param path [FilePath] the path to re-express
    # @param base [FilePath] the directory to express it against
    # @return [String] the relative path
    #
    # @example
    #   FS.Path.relativeTo("/a/b/c.txt", "/a/d")   # => "../b/c.txt"
    #   FS.Path.relativeTo("/a/b/c.txt", "/a")     # => "b/c.txt"
    #   FS.Path.relativeTo("/a/b", "/a/b")         # => "."
    #
    # @example Printing project-relative paths in a report
    #   matches.each { |p| IO.printLine(FS.Path.relativeTo(p, projectRoot)) }
    relativeTo : FilePath -> FilePath -> String
    let relativeTo(path, base) do
      let target = FS.Path.normalize(path)
      let from = FS.Path.normalize(base)
      return target if FS.Path.absolute?(target) != FS.Path.absolute?(from)
      let targetParts = FS.Path.segments(target)
      let fromParts = FS.Path.segments(from)
      let shared = FS.Path.sharedPrefix(targetParts, fromParts, 0)
      let ups = fromParts.drop(shared).map { |_| ".." }
      let rest = targetParts.drop(shared)
      let steps = [...ups, ...rest]
      return "." if steps.empty?
      return FS.Path.glue(steps)
    end

    private do
      # The path's non-empty components as written: no "." or ".." resolved,
      # so +basename+ and +dirname+ read the path the way POSIX and Ruby do.
      let lexicalParts(path: String) -> [String] do
        return path.split(FS.Path.separator).filter { |part| !part.empty? }
      end

      # Separator-joins parts that are already clean. Not `parts.join(sep)`:
      # with FilePath aliased to String that call is ambiguous against
      # Path.join itself.
      let glue(parts: [String]) -> String do
        return parts.reduce("") do |acc, part|
          acc.empty? then part else "${acc}${FS.Path.separator}${part}"
        end
      end

      # One `..`-aware step of the normalize fold.
      let resolveStep(acc: [String], part: String, rooted: Bool) -> [String] do
        return acc.push(part) if part != ".."
        let top = match acc.last do
          Just(value) => value
          None => ""
        end
        return acc.take(acc.count - 1) if top != "" && top != ".."
        return acc if rooted
        return acc.push("..")
      end

      let sharedPrefix(a: [String], b: [String], index: Integer) -> Integer do
        return index if index >= a.count || index >= b.count
        return index if a.at(index) != b.at(index)
        return FS.Path.sharedPrefix(a, b, index + 1)
      end
    end
  end

  # Creating, listing and removing directories.
  #
  # Everything here uses the real filesystem, so only +foul+ code can call it.
  # Unlike +FS.File+, it is not a capability and cannot be swapped out in a
  # test.
  module Directory do
    # Returns whether a directory exists at +path+. A file there gives +false+;
    # use +FS.File.exists?+ to ask about anything at all.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ when +path+ is a directory
    #
    # @example
    #   FS.Directory.exists?("src")         # => true
    #   FS.Directory.exists?("README.md")   # => false
    exists? : FilePath -> Bool
    foul exists?(path) = Kex.Intrinsic.Directory.exists?(path)

    # Returns whether +path+ exists and is a directory.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a directory
    #
    # @example
    #   FS.Directory.directory?("src")        # => true
    #   FS.Directory.directory?("README.md")  # => false
    directory? : FilePath -> Bool
    foul directory?(path) = Kex.Intrinsic.Directory.directory?(path)

    # Returns whether +path+ exists and is a regular file.
    #
    # @param path [FilePath] the path to test
    # @return [Bool] +true+ for a regular file
    #
    # @example
    #   FS.Directory.file?("README.md")   # => true
    file? : FilePath -> Bool
    foul file?(path) = Kex.Intrinsic.Directory.file?(path)

    # Creates the directory at +path+ and any missing parents, as +mkdir -p+
    # does. A directory that already exists is +Ok+.
    #
    # @param path [FilePath] the directory to create
    # @return [Result<Void, FileError>] +Ok+ when the directory is there, or
    #   +CreateFailed+
    #
    # @example
    #   FS.Directory.create("build")   # => Ok(())
    #
    # @example Making sure an output directory is there
    #   FS.Directory.create(outDir).try
    create : FilePath -> Result<Void, FileError>
    foul create(path) do
      return Kex.Intrinsic.Directory.create(path) then Ok(()) else Error(CreateFailed(path))
    end

    # Removes the directory at +path+, which must be empty.
    #
    # A file or symlink at +path+ is left alone and gives +DeleteFailed+, as
    # does a directory that is not empty.
    #
    # Use +deleteAll+ to remove a directory together with its contents.
    #
    # @param path [FilePath] the directory to remove
    # @return [Result<Void, FileError>] +Ok+ when the directory was removed,
    #   or +DeleteFailed+
    #
    # @example
    #   FS.Directory.delete("empty")   # => Ok(())
    delete : FilePath -> Result<Void, FileError>
    foul delete(path) do
      return Kex.Intrinsic.Directory.delete(path) then Ok(()) else Error(DeleteFailed(path))
    end

    # Removes the directory at +path+ and everything in it.
    #
    # A path that is not a directory, such as a file or a symlink, is left
    # alone and gives +DeleteFailed+. The deletion cannot be undone, so check
    # the path first, especially one that was computed or came from a user.
    #
    # @param path [FilePath] the directory tree to remove
    # @return [Result<Void, FileError>] +Ok+ when the tree was removed, or
    #   +DeleteFailed+
    #
    # @example
    #   FS.Directory.deleteAll("build")   # => Ok(())
    #
    # @example Rebuilding a scratch directory from clean
    #   FS.Directory.deleteAll(tmpDir)
    #   FS.Directory.create(tmpDir)
    deleteAll : FilePath -> Result<Void, FileError>
    foul deleteAll(path) do
      return Kex.Intrinsic.Directory.deleteAll(path) then Ok(()) else Error(DeleteFailed(path))
    end

    # Returns the names of the files and directories directly inside +path+.
    #
    # They are bare names, not paths, sorted; join each with +path+ to open
    # it. Returns +ReadFailed+ when the directory cannot be read.
    #
    # @param path [FilePath] the directory to list
    # @return [Result<[String], FileError>] the entry names, or +ReadFailed+
    #
    # @example
    #   FS.Directory.list("src")   # => Ok(["lexer", "main.kex"])
    #
    # @example Turning names into usable paths
    #   FS.Directory.list(dir).or([]).map { |name| FS.Path.join(dir, name) }
    list : FilePath -> Result<[String], FileError>
    foul list(path) do
      match Kex.Intrinsic.Directory.list(path) do
        Just(names) => return Ok(names)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns the names of the regular files directly inside +path+.
    #
    # @param path [FilePath] the directory to list
    # @return [Result<[String], FileError>] the file names, or +ReadFailed+
    #
    # @example
    #   FS.Directory.files("src")   # => Ok(["main.kex"])
    #
    # @example Every Kex source in a directory
    #   FS.Directory.files(dir)
    #     .or([])
    #     .filter { |f| FS.Path.extension(f) == ".kex" }
    files : FilePath -> Result<[String], FileError>
    foul files(path) do
      match Kex.Intrinsic.Directory.files(path) do
        Just(names) => return Ok(names)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns the names of the directories directly inside +path+.
    #
    # @param path [FilePath] the directory to list
    # @return [Result<[String], FileError>] the directory names, or
    #   +ReadFailed+
    #
    # @example
    #   FS.Directory.directories("src")   # => Ok(["lexer", "parser"])
    #
    # @example Walking one level down
    #   FS.Directory.directories(root).or([]).each do |name|
    #     IO.printLine(FS.Path.join(root, name))
    #   end
    directories : FilePath -> Result<[String], FileError>
    foul directories(path) do
      match Kex.Intrinsic.Directory.directories(path) do
        Just(names) => return Ok(names)
        None => return Error(ReadFailed(path))
      end
    end

    # Returns the current working directory as an absolute path.
    #
    # @return [String] the current directory
    #
    # @example
    #   FS.Directory.current   # => "/home/ada/project"
    #
    # @example Resolving a relative path by hand
    #   FS.Path.join(FS.Directory.current, "build")
    current : String
    foul current = Kex.Intrinsic.Directory.current

    # Returns the current user's home directory, or +None+ when it cannot be
    # determined.
    #
    # @return [String?] the home directory, or +None+
    #
    # @example
    #   FS.Directory.home   # => Just("/home/ada")
    #
    # @example A per-user config path
    #   FS.Path.join(FS.Directory.home.or("."), ".apprc")
    home : String?
    foul home = Kex.Intrinsic.Directory.home

    # Returns the directory this system puts temporary files in.
    #
    # It is +TMPDIR+, +TEMP+ or +TMP+ from the environment, the first one set,
    # and +/tmp+ when none is. The path never ends in a separator.
    #
    # Other processes share the directory, so pick names that will not collide,
    # or use +createTemporary+, and delete what you create.
    #
    # @return [String] the temporary directory
    #
    # @example
    #   FS.Directory.temporary   # => "/tmp"
    #
    # @example A scratch file that cleans up after itself
    #   let scratch = FS.Path.join(FS.Directory.temporary, "report.bin")
    #   FS.File.writeBytes(scratch, payload)
    #   FS.File.delete(scratch)
    temporary : String
    foul temporary = Kex.Intrinsic.Directory.temporary

    # Creates a fresh, empty directory under +temporary+ and returns its path.
    #
    # The name is +prefix+, a dash and a random suffix, so callers using the
    # same prefix each get their own directory. Nothing removes it for you;
    # call +deleteAll+ when you are done.
    #
    # @param prefix [String] the start of the directory name, to say whose it is
    # @return [Result<FilePath, FileError>] the new directory, or
    #   +CreateFailed+
    #
    # @example
    #   FS.Directory.createTemporary("report")   # => Ok("/tmp/report-9f2c41d07ab35e68")
    #
    # @example A scratch directory that cleans up after itself
    #   let scratch = FS.Directory.createTemporary("build").try
    #   FS.File.write(FS.Path.join(scratch, "out.txt"), text)
    #   FS.Directory.deleteAll(scratch)
    createTemporary : String -> Result<FilePath, FileError>
    foul createTemporary(prefix) do
      let path = FS.Path.join(FS.Directory.temporary, "${prefix}-${Random.token(8)}")
      return FS.Directory.create(path).map { |_| path }
    end
  end
end

# Mock.FS declarations are in mock.kex alongside Mock.ENV and Mock.IO.
