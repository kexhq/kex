# ANSI terminal styling: colors, text attributes, and cursor control.
#
# Every constant here becomes an empty string when Kex is started with
# +--no-colors+, or when output is not going to a terminal. That is the point
# of the design — you can splice them into a string unconditionally and the
# result is plain text where color is unwanted, with no branching at the call
# site.
#
#   IO.printLine("${Console.GREEN}ok${Console.RESET}")
#   IO.printLine(Console.colorize("failed", Console.RED))
#
# +colorize+ is usually what you want, since it applies the reset for you.
module Console do
  # Clears every active style. Ends a styled run started with a color or
  # attribute constant; +colorize+ appends it for you.
  #
  # @return [String] the reset sequence, or +""+ when color is off
  #
  # @example
  #   "${Console.BOLD}important${Console.RESET}"
  let RESET = Kex.Intrinsic.Console.Reset

  # Renders following text in bold.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.printLine("${Console.BOLD}Summary${Console.RESET}")
  let BOLD = Kex.Intrinsic.Console.Bold

  # Renders following text dimmed. Useful for secondary detail that should
  # not compete with the main output.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.printLine("done ${Console.DIM}(0.4s)${Console.RESET}")
  let DIM = Kex.Intrinsic.Console.Dim

  # Renders following text in italics, where the terminal supports it.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let ITALIC = Kex.Intrinsic.Console.Italic

  # Underlines following text.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   Console.colorize("https://kex.run", Console.UNDERLINE)
  let UNDERLINE = Kex.Intrinsic.Console.Underline

  # Makes following text blink, where the terminal supports it. Most do not,
  # and most users would rather they did not.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let BLINK = Kex.Intrinsic.Console.Blink

  # Swaps the foreground and background colors of following text.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example Highlighting a selected row
  #   Console.colorize(row, Console.REVERSE)
  let REVERSE = Kex.Intrinsic.Console.Reverse

  # Hides following text — it occupies space but is not drawn.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let HIDDEN = Kex.Intrinsic.Console.Hidden

  # Strikes through following text.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example Showing a completed item
  #   Console.colorize(task, Console.STRIKETHROUGH)
  let STRIKETHROUGH = Kex.Intrinsic.Console.Strikethrough

  # Red. Conventionally: errors and failures.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.printError(Console.colorize("error: ${message}", Console.RED))
  let RED = Kex.Intrinsic.Console.Red

  # Green. Conventionally: success.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.printLine(Console.colorize("all tests passed", Console.GREEN))
  let GREEN = Kex.Intrinsic.Console.Green

  # Yellow. Conventionally: warnings.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.warn(Console.colorize("deprecated option", Console.YELLOW))
  let YELLOW = Kex.Intrinsic.Console.Yellow

  # Blue.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let BLUE = Kex.Intrinsic.Console.Blue

  # Magenta.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let MAGENTA = Kex.Intrinsic.Console.Magenta

  # Cyan.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let CYAN = Kex.Intrinsic.Console.Cyan

  # White.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let WHITE = Kex.Intrinsic.Console.White

  # Gray. Conventionally: de-emphasised detail, like +DIM+ but as a color.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.printLine(Console.colorize(timestamp, Console.GRAY))
  let GRAY = Kex.Intrinsic.Console.Gray

  # Purple.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  let PURPLE = Kex.Intrinsic.Console.Purple

  # Erases the screen and moves the cursor to the top-left corner.
  #
  # Use it to start a fresh frame. When you are redrawing repeatedly, +HOME+
  # gives a smoother result — see below.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example
  #   IO.print(Console.CLEAR)
  # Cursor and screen control, empty under --no-colors like the styles above.
  # CLEAR erases the screen and homes the cursor; HOME only moves the cursor,
  # so a redraw paints over the previous frame without a blank flash between
  # them; CLEARLINE erases the current line and returns to its start.
  let CLEAR = Kex.Intrinsic.Console.Clear

  # Moves the cursor to the top-left corner without erasing anything.
  #
  # A redraw that starts here paints over the previous frame, so there is no
  # blank flash between frames the way +CLEAR+ produces.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example An animation loop that does not flicker
  #   frames.each do |frame|
  #     IO.print(Console.HOME)
  #     IO.print(frame)
  #   end
  let HOME = Kex.Intrinsic.Console.Home

  # Erases the current line and returns the cursor to its start.
  #
  # This is how to write a progress line in place rather than one line per
  # update.
  #
  # @return [String] the escape sequence, or +""+ when color is off
  #
  # @example A progress counter on one line
  #   (1..100).items.each do |n|
  #     IO.print("${Console.CLEARLINE}processing ${n}/100")
  #   end
  #   IO.printLine("")
  let CLEARLINE = Kex.Intrinsic.Console.ClearLine

  # Wraps +text+ in +color+ and appends a reset, so the style ends where the
  # text does.
  #
  # Preferred over splicing the constants by hand: it cannot leak a style into
  # the rest of the line, and it still produces plain text when color is off.
  #
  # @param text [String] the text to style
  # @param color [String] a style constant from this module
  # @return [String] the styled text
  #
  # @example
  #   Console.colorize("ok", Console.GREEN)
  #   Console.colorize("error", Console.RED)
  #
  # @example Styling a status word inside a longer line
  #   IO.printLine("build ${Console.colorize("passed", Console.GREEN)} in 2.1s")
  colorize : String -> String -> String
  let colorize(text, color) = Kex.Intrinsic.Console.colorize(text, color)

  # Returns +true+ when terminal styling is on for this process.
  #
  # It is +false+ under +--no-colors+ and when output is redirected. You
  # rarely need to check it — the constants already collapse to +""+ — but it
  # is the right test when the alternative is a different layout rather than a
  # different color.
  #
  # @return [Bool] +true+ when styling is enabled
  #
  # @example Falling back to plain markers
  #   let bullet = Console.enabled? then "•" else "-"
  enabled? : Bool
  let enabled? = Kex.Intrinsic.Console.enabled?
end
