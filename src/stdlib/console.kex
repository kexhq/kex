# ANSI terminal styling: colors, text attributes and cursor control.
#
# Every constant here is the empty string when styling is off: when stdout
# is not a terminal, when +NO_COLOR+ is set, or when Kex runs with
# +--no-colors+. +--colors+ or +FORCE_COLOR+ turns it back on. So the
# constants can go into a string without a check.
#
# @example
#   IO.printLine("${Console.GREEN}ok${Console.RESET}")
#   IO.printLine(Console.colorize("failed", Console.RED))
#
# +colorize+ is usually the better choice, since it adds the reset for you.
module Console do
  # Clears every active style, ending a run started by one of the color or
  # attribute constants. +colorize+ appends it for you.
  #
  # @return [String] the reset sequence, or +""+ when styling is off
  #
  # @example
  #   "${Console.BOLD}important${Console.RESET}"
  RESET : String
  let RESET = Kex.Intrinsic.Console.Reset

  # Renders the text that follows in bold.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine("${Console.BOLD}Summary${Console.RESET}")
  BOLD : String
  let BOLD = Kex.Intrinsic.Console.Bold

  # Renders the text that follows dimmed, for detail that should stay in the
  # background.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine("done ${Console.DIM}(0.4s)${Console.RESET}")
  DIM : String
  let DIM = Kex.Intrinsic.Console.Dim

  # Renders the text that follows in italics, on terminals that support it.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example Setting apart a command name
  #   IO.printLine("run ${Console.colorize("kex check", Console.ITALIC)} next")
  ITALIC : String
  let ITALIC = Kex.Intrinsic.Console.Italic

  # Underlines the text that follows.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   Console.colorize("https://kex.run", Console.UNDERLINE)
  UNDERLINE : String
  let UNDERLINE = Kex.Intrinsic.Console.Underline

  # Makes the text that follows blink, on the few terminals that support it.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example An alarm that must not be missed
  #   IO.printError(Console.colorize("DATABASE OFFLINE", Console.BLINK))
  BLINK : String
  let BLINK = Kex.Intrinsic.Console.Blink

  # Swaps the foreground and background colors of the text that follows.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example Highlighting a selected row
  #   Console.colorize(row, Console.REVERSE)
  REVERSE : String
  let REVERSE = Kex.Intrinsic.Console.Reverse

  # Hides the text that follows: it takes up space but is not drawn.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example Reserving space so a table does not shift when a status changes
  #   let padding = Console.colorize("..........", Console.HIDDEN)
  HIDDEN : String
  let HIDDEN = Kex.Intrinsic.Console.Hidden

  # Strikes through the text that follows.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example Showing a completed item
  #   Console.colorize(task, Console.STRIKETHROUGH)
  STRIKETHROUGH : String
  let STRIKETHROUGH = Kex.Intrinsic.Console.Strikethrough

  # Red, usually for errors and failures.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printError(Console.colorize("error: ${message}", Console.RED))
  RED : String
  let RED = Kex.Intrinsic.Console.Red

  # Green, usually for success.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize("all tests passed", Console.GREEN))
  GREEN : String
  let GREEN = Kex.Intrinsic.Console.Green

  # Yellow, usually for warnings.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printError(Console.colorize("deprecated option", Console.YELLOW))
  YELLOW : String
  let YELLOW = Kex.Intrinsic.Console.Yellow

  # Blue, often used for informational labels and links.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize("info:", Console.BLUE) + " cache refreshed")
  BLUE : String
  let BLUE = Kex.Intrinsic.Console.Blue

  # Magenta, for marking a category apart from the status colors.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize("migration", Console.MAGENTA) + " 20260830")
  MAGENTA : String
  let MAGENTA = Kex.Intrinsic.Console.Magenta

  # Cyan, often used for identifiers, paths and other values within text.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine("wrote ${Console.colorize(path, Console.CYAN)}")
  CYAN : String
  let CYAN = Kex.Intrinsic.Console.Cyan

  # White, for primary text on a dark terminal.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize("Build summary", Console.WHITE))
  WHITE : String
  let WHITE = Kex.Intrinsic.Console.White

  # Gray, for detail that matters less; a color counterpart of +DIM+.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize(timestamp, Console.GRAY))
  GRAY : String
  let GRAY = Kex.Intrinsic.Console.Gray

  # Purple, a second accent color when magenta is already taken.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.printLine(Console.colorize("plugin", Console.PURPLE) + ": formatter")
  PURPLE : String
  let PURPLE = Kex.Intrinsic.Console.Purple

  # Erases the screen and moves the cursor to the top-left corner.
  #
  # To redraw the screen many times, +HOME+ avoids the flicker.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example
  #   IO.print(Console.CLEAR)
  CLEAR : String
  let CLEAR = Kex.Intrinsic.Console.Clear

  # Moves the cursor to the top-left corner without erasing anything.
  #
  # A redraw that starts here paints over the previous frame, so the screen
  # does not go blank between frames as it does with +CLEAR+.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example An animation loop that does not flicker
  #   frames.each do |frame|
  #     IO.print(Console.HOME)
  #     IO.print(frame)
  #   end
  HOME : String
  let HOME = Kex.Intrinsic.Console.Home

  # Erases the current line and moves the cursor back to its start, so a
  # progress line can be rewritten in place.
  #
  # @return [String] the escape sequence, or +""+ when styling is off
  #
  # @example A progress counter on one line
  #   (1..100).items.each do |n|
  #     IO.print("${Console.CLEARLINE}processing ${n}/100")
  #   end
  #   IO.printLine("")
  CLEARLINE : String
  let CLEARLINE = Kex.Intrinsic.Console.ClearLine

  # Wraps +text+ in +color+ and appends a reset, so the style ends where the
  # text does.
  #
  # It cannot leak a style into the rest of the line, which hand-placed
  # constants can. When styling is off it returns +text+ unchanged.
  #
  # @param text [String] the text to style
  # @param color [String] a style constant from this module
  # @return [String] the styled text
  #
  # @example
  #   Console.colorize("ok", Console.GREEN)
  #   Console.colorize("error", Console.RED)
  #
  # @example Styling a status word inside a longer line
  #   IO.printLine("build ${Console.colorize("passed", Console.GREEN)} in 2.1s")
  colorize : String -> String -> String
  let colorize(text, color) = Kex.Intrinsic.Console.colorize(text, color)

  # Returns +true+ when terminal styling is on for this process.
  #
  # The constants already turn into +""+ when it is off, so a check is only
  # needed when the output should change in some other way, such as a
  # different layout or different characters.
  #
  # @return [Bool] +true+ when styling is on
  #
  # @example Falling back to plain markers
  #   let bullet = Console.enabled? then "•" else "-"
  enabled? : Bool
  let enabled? = Kex.Intrinsic.Console.enabled?
end
