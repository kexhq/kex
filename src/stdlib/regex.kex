module Regex

# Regular expressions, backed by PCRE2 in the interpreter and Erlang's `re`
# on BEAM — the same PCRE pattern language on both. See docs/regex-plan.md.
#
# Opt-in, not prelude: nothing here is in scope until `using Regex`.
#
# @example
#   using Regex
#
#   match regex("\\d+") do
#     Ok(re)   -> IO.printLine("compiled")
#     Error(e) -> IO.printLine("bad pattern at ${e.position}: ${e.message}")
#   end

# +Regex+ carries only its pattern source. The compiled engine object lives in
# a runtime cache keyed by that source, deliberately: a compiled pattern bakes
# in the host's PCRE version and must never be embedded in a distributed
# artifact, so the source string is the value's identity.
record Regex do
  source : String
end

# +RegexError+ describes a pattern that failed to compile. Mirrors +ParseError+
# — the +position+ is a *character* offset into the pattern, not a byte offset,
# so it agrees across backends on patterns containing non-ASCII.
record RegexError do
  source   : String
  position : Integer
  message  : String
end

make RegexError, implement: Errorable do
  message :> String
  let message(e) = e.message
end

# Compiles a pattern. Returns +Result+ because an arbitrary string may not be a
# valid pattern; the tag form `regex`...`` returns a bare +Regex+ instead, since
# a literal is validated at compile time and cannot fail.
#
# @param source [String]
# @return [Result<Regex, RegexError>]
#
# @example
#   regex("\\d+")        # => Ok(Regex)
#   regex("(")           # => Error(RegexError)
regex : String -> Result<Regex, RegexError>
let regex(source) = Kex.Intrinsic.Regex.compile(source)

# Escapes every regex metacharacter in +s+, so the result matches +s+
# literally. Escapes per character rather than wrapping in `\Q...\E`, which a
# value containing `\E` would break out of.
#
# @param s [String]
# @return [String]
#
# @example
#   Regex.quote("a.b")   # => "a\\.b"
quote : String -> String
let quote(s) = Kex.Intrinsic.Regex.quote(s)

# +Match+ is the result of a successful match. It behaves like a map keyed by
# both group number (+0+ is the whole match) and group name (+:year+), but is a
# named type so it can grow spans and surrounding context later without
# breaking existing +get+ call sites.
#
# A group that did not participate is an absent key, so +get+ returns +None+ —
# distinct from a group that matched the empty string, which returns +Just("")+.
record Match do
  captures : Map<Any, String>
end

make Match do
  # Returns the captured text for a group, by number or by name.
  #
  # @param key [Atom | Int]
  # @return [String?]
  #
  # @example
  #   m.get(0)        # whole match
  #   m.get(1)        # first positional group
  #   m.get(:year)    # named group
  get :> (Atom | Integer) -> String?
  let get(key) = this.captures.get(key)

  # Returns the captured text for a group, or +default+ if the group is absent.
  #
  # @param key [Atom | Int]
  # @param default [String]
  # @return [String]
  get :> (Atom | Integer) -> String -> String
  let get(key, default) = this.captures.get(key, default)
end

# Finds the first occurrence of +re+ anywhere in +s+. Unanchored — anchor with
# +^...$+ in the pattern if a whole-string match is wanted.
#
# @param s [String]
# @param re [Regex]
# @return [Match?]
#
# @example
#   "order #4271".matches(re)   # => Just(Match)
matches : String -> Regex -> Match?
let matches(s, re) = Kex.Intrinsic.Regex.matches(s, re)

# Reports whether +re+ occurs anywhere in +s+. The boolean form of +matches+,
# and unanchored for the same reason.
#
# @param s [String]
# @param re [Regex]
# @return [Bool]
#
# @example
#   "hello".matches?(re)   # => true
matches? : String -> Regex -> Bool
let matches?(s, re) = Kex.Intrinsic.Regex.matches?(s, re)
