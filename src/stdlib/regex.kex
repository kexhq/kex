module Regex

# Regular expressions in PCRE syntax. Bring them into scope with
# +using Regex+.
#
# There are two ways to write a pattern. The usual one is the tagged literal
# `` re`...` ``, which is checked when the program is compiled and gives a
# +Regex+ directly.
#
#   using Regex
#
#   main do
#     let line = "order #4271 shipped"
#     IO.printLine(line.matches?(re`#\d+`))                     # => true
#     IO.printLine(line.matches(re`#(\d+)`).into { |m| m.get(1) }.or(""))  # => 4271
#   end
#
# The call form +regex(source)+ takes a pattern built at run time and returns
# a +Result+, since the string may not be a valid pattern:
#
#   match regex(userSupplied) do
#     Ok(pattern) => IO.printLine(text.matches?(pattern))
#     Error(e)    => IO.printError("bad pattern at ${e.position}: ${e.message}")
#   end
#
# The operations are +matches?+ (is it there), +matches+ (the first match),
# +scan+ (every match), +replace+, +replaceFirst+, +split+ and +splitLimit+.

# A compiled regular expression.
#
# Create one with a +re+ tagged literal or +regex(source)+.
#
#   let digits = re`[0-9]+`
#   "item 42".matches(digits).into { |m| m.get(0) }   # => Just("42")
record Regex do
  # The pattern text this regex was built from.
  source : String
end

make Regex, implement: Showable do
  # Returns the regex written as a +re+ literal, which is what interpolation
  # shows.
  #
  # @return [String] the pattern as a +re+ literal
  #
  # @example
  #   "${re`\d+`}"   # => "re`\d+`"
  showValue :> String
  let showValue -> String = "re`${@source}`"
end

# A pattern that failed to compile.
#
# +position+ counts characters, not bytes, from the start of the pattern.
#
#   regex("(")
#   # => Error(Regex.RegexError { message: "missing closing parenthesis",
#   #                             position: 1, source: "(" })
record RegexError do
  # The pattern text that failed to compile.
  source   : String

  # The character offset in the pattern where compilation stopped.
  position : Integer

  # What was wrong, for a person to read.
  message  : String
end

# Compiles +source+ into a +Regex+.
#
# Use it for a pattern built at run time, such as one read from a config file
# or typed by a user. For a pattern written in the source, the tag form
# `` regex`\d+` `` is checked at compile time and returns a +Regex+ directly.
#
# @param source [String] the pattern text
# @return [Result<Regex, RegexError>] the compiled pattern, or why it failed
#
# @example
#   regex("\\d+")   # => Ok(Regex.Regex { source: "\d+" })
#   regex("(")      # => Error(Regex.RegexError { message: "missing closing parenthesis", position: 1, source: "(" })
#
# @example Compiling a user-supplied filter
#   match regex(pattern) do
#     Ok(re)   => lines.filter { |line| line.matches?(re) }
#     Error(e) => do
#       IO.printError("bad pattern at ${e.position}: ${e.message}")
#       []
#     end
#   end
regex : String -> Result<Regex, RegexError>
let regex(source) = Kex.Intrinsic.Regex.compile(source)

# Compiles +source+ with matching options, like Ruby's
# +Regexp.new(source, options)+.
#
# The options are +ignoreCase+ (+/i+), +multiline+ (+^+ and +$+ match at every
# line), +dotAll+ (+.+ also matches a newline) and +extended+ (whitespace and
# +#+ comments in the pattern are ignored). An option set to +false+ is the
# same as leaving it out, and an unknown one is a +RegexError+ at position 0.
#
# The options are added to the pattern as an inline +(?imsx)+ prefix, so the
# resulting +source+ shows them. Positions in a compile error still count from
# the start of +source+ as you passed it.
#
# @param source [String] the pattern text
# @param options [{Atom: Bool}] which options to turn on
# @return [Result<Regex, RegexError>] the regex, or why it did not compile
#
# @example
#   Regex.withOptions("hello", { ignoreCase: true }).map { |re| "HeLLo".matches?(re) }
#   # => Ok(true)
#   Regex.withOptions("x", { verbose: true })
#   # => Error(Regex.RegexError { message: "unknown regex option :verbose", position: 0, source: "x" })
withOptions : String -> {Atom: Bool} -> Result<Regex, RegexError>
let withOptions(source: String, options: {Atom: Bool}) -> Result<Regex, RegexError> do
  let letters = { ignoreCase: "i", multiline: "m", dotAll: "s", extended: "x" }
  if let Just(unknown) = options.keys.find { |key| !letters.has?(key) }
    return Error(RegexError { source: source, position: 0, message: "unknown regex option ${unknown}" })
  end
  let chosen = options.filter { |key, on| on }.keys.map { |key| letters.get(key, "") }.join
  return regex(source) if chosen.empty?
  let prefix = "(?${chosen})"
  match regex(prefix + source) do
    Ok(built) => return Ok(built)
    Error(problem) => do
      let position = problem.position - prefix.count
      return Error(RegexError {
        source: source,
        position: position < 0 then 0 else position,
        message: problem.message
      })
    end
  end
end

# Builds the +Regex+ for a tagged literal such as `` regex`\d+` ``.
#
# It returns a +Regex+, not a +Result+, because +validateRegex+ has already
# checked the pattern at compile time.
#
# Values interpolated into the literal (`` regex$`^${x}` ``) are escaped, so
# they match as literal text and cannot add pattern syntax. To build pattern
# structure from a value, use the call form +regex(source)+.
#
# @param parts [[String]] the literal pieces of the tagged literal
# @param values [[Any]] the interpolated values, escaped before splicing
# @return [Regex] the compiled pattern
#
# @example
#   re`\d+`                 # matches a run of digits
#   re`^(?<key>\w+)=(.*)$`  # named and positional groups
regex : [String] -> [Any] -> Regex
let regex(parts, values) = Kex.Intrinsic.Regex.tag(parts, values)

# Checks a +regex+ tagged literal at compile time.
#
# The compiler finds it by the +validate<Tag>+ naming convention described in
# +TaggedValidation+. An invalid literal such as `` regex`(` `` is a compile
# error, with the caret at the offset where the pattern went wrong.
#
# @param source [String] the literal's pattern text
# @return [[TaggedValidation.Issue]] the problems found, if any
let validateRegex(source: String) -> [TaggedValidation.Issue] do
  # Keep this pure: the compiler runs it on the tree-walk interpreter while
  # compiling, so making it foul would break builds.
  match Kex.Intrinsic.Regex.validate(source) do
    Just((offset, message)) => [TaggedValidation.fatalAt(offset, message)]
    None          => []
  end
end

# A short name for +regex+, in both its call and tag forms.
#
# It behaves exactly like +regex+. Most code uses it as a tag, where the
# shorter name reads better.
#
# @param source [String] the pattern text (call form)
# @return [Result<Regex, RegexError>] the compiled pattern, or why it failed
#
# @example
#   re`https?://\S+`   # tag form  -> Regex
#   re("\\d+")         # call form -> Result<Regex, RegexError>
re : String -> Result<Regex, RegexError>
let re(source) = regex(source)

re : [String] -> [Any] -> Regex
let re(parts, values) = regex(parts, values)

# Checks an +re+ tagged literal at compile time, as +validateRegex+ does.
#
# @param source [String] the literal's pattern text
# @return [[TaggedValidation.Issue]] the problems found, if any
let validateRe(source: String) -> [TaggedValidation.Issue] do
  return validateRegex(source)
end

# Returns +s+ with every regex metacharacter escaped, as a pattern that
# matches +s+ literally.
#
# Use it to search for text that may contain pattern syntax, such as a search
# term typed by a user or a file name. Each character is escaped on its own,
# so a +\E+ in +s+ cannot end the quoting early as it would inside
# +\Q...\E+.
#
# @param s [String] the text to escape
# @return [String] a pattern matching +s+ literally
#
# @example
#   Regex.quote("a.b")   # => "a\.b"
#
# @example Searching for a literal term supplied by a user
#   match regex(Regex.quote(term)) do
#     Ok(needle) => lines.filter { |line| line.matches?(needle) }
#     Error(_)   => []
#   end
quote : String -> String
let quote(s) = Kex.Intrinsic.Regex.quote(s)

# A successful match, and the groups it captured.
#
# Read groups with +get+, by number (+0+ is the whole match) or by name
# (+:year+).
#
# A group that took no part in the match is missing, so +get+ returns +None+.
# A group that matched the empty string returns +Just("")+.
record Match do
  # The captured text, keyed by group number and by group name.
  captures : Map<Any, String>

  # Where the whole match starts in the searched string, in characters from 0,
  # like Ruby's +begin(0)+. It ends +get(0, "").count+ characters later.
  #
  # @example
  #   "item 42".matches(re`\d+`).map { |m| m.offset }   # => Just(5)
  offset : Integer
end

make Match do
  # Returns the text captured by a group, by number or by name.
  #
  # Group +0+ is the whole match; +1+ is the first parenthesised group. A
  # named group +(?<year>...)+ is read with the atom +:year+. A group that
  # took no part in the match returns +None+.
  #
  # @param key [Atom | Integer] the group number or name
  # @return [String?] the captured text, or +None+
  #
  # @example
  #   let found = "order #4271".matches(re`#(\d+)`)
  #   found.into { |m| m.get(0) }   # => Just("#4271")
  #   found.into { |m| m.get(1) }   # => Just("4271")
  #
  # @example Named groups
  #   "2026-07-04".matches(re`(?<year>\d{4})-(?<month>\d{2})`)
  #     .into { |m| m.get(:year) }
  #   # => Just("2026")
  get :> (Atom | Integer) -> String?
  let get(key) = Kex.Intrinsic.Map.get(this.captures, key)

  # Returns the text captured by a group, or +default+ when the group is
  # absent.
  #
  # Most +scan+ pipelines want this form, since the text comes back without a
  # +Just+.
  #
  # @param key [Atom | Integer] the group number or name
  # @param default [String] the value to use when the group did not match
  # @return [String] the captured text, or +default+
  #
  # @example
  #   "cat=1, dog=2".scan(re`(\w+)=(\d+)`).map { |m| m.get(1, "") }
  #   # => ["cat", "dog"]
  get :> (Atom | Integer) -> String -> String
  let get(key, default) = Kex.Intrinsic.Map.getWithDefault(this.captures, key, default)
end

# Finds the first occurrence of +re+ in +s+ and returns what it matched.
#
# The pattern may match anywhere in the string; anchor it with +^...$+ to
# match the whole string. Returns +None+ when the pattern does not occur.
#
# @param s [String] the text to search
# @param re [Regex] the pattern to look for
# @return [Match?] the first match, or +None+
#
# @example
#   "order #4271".matches(re`#(\d+)`).into { |m| m.get(1) }   # => Just("4271")
#   "no number here".matches(re`#(\d+)`)                          # => None
#
# @example Pulling a version out of a line
#   line.matches(re`v(\d+)\.(\d+)`).map { |m| (m.get(1, "0"), m.get(2, "0")) }
matches : String -> Regex -> Match?
let matches(s, re) = Kex.Intrinsic.Regex.matches(s, re)

# Returns whether +re+ occurs anywhere in +s+.
#
# Like +matches+, the pattern is not anchored.
#
# @param s [String] the text to search
# @param re [Regex] the pattern to look for
# @return [Bool] +true+ when the pattern occurs
#
# @example
#   "hello".matches?(re`^h`)      # => true
#   "hello".matches?(re`\d`)      # => false
#
# @example Keeping only the lines that look like assignments
#   lines.filter { |line| line.matches?(re`^\w+\s*=`) }
matches? : String -> Regex -> Bool
let matches?(s, re) = Kex.Intrinsic.Regex.matches?(s, re)

# Returns every match of +re+ in +s+, left to right.
#
# The result is a list of +Match+ whether or not the pattern has groups, so
# adding a group does not change its type. An empty list means nothing
# matched.
#
# @param s [String] the text to search
# @param re [Regex] the pattern to look for
# @return [[Match]] every match, in order
#
# @example
#   "cat=1, dog=2".scan(re`(\w+)=(\d+)`).map { |m| m.get(1, "") }
#   # => ["cat", "dog"]
#
# @example Building a map out of key=value pairs
#   Map.from(
#     text.scan(re`(\w+)=(\w+)`).map { |m| (m.get(1, ""), m.get(2, "")) }
#   )
scan : String -> Regex -> [Match]
let scan(s, re) = Kex.Intrinsic.Regex.scan(s, re)

# Returns +s+ with every match of +re+ replaced, like Ruby's +gsub+.
#
# The replacement is a +String+, inserted as it is (+$1+ and +\1+ have no
# special meaning), or a block that gets the +Match+ and returns the text. Use
# the block to build the replacement from the captured groups.
#
# @param s [String] the text to rewrite
# @param re [Regex] the pattern to replace
# @param replacement [String | (Match -> String)] the literal text, or a block
# @return [String] the rewritten text
#
# @example A literal replacement
#   "a-b-c".replace(re`-`, "+")   # => "a+b+c"
#
# @example A replacement computed from the match
#   "2026-7-4".replace(re`(\d+)`) do |m|
#     m.get(1, "").length.to(String).or("")
#   end
#   # => "4-1-1"
#
# @example Redacting numbers in a log line
#   line.replace(re`\d`, "x")
replace : String -> Regex -> (String | (Match -> String)) -> String
let replace(s, re, replacement) = Kex.Intrinsic.Regex.replace(s, re, replacement)

# Returns +s+ with only the first match of +re+ replaced, like Ruby's +sub+.
#
# The replacement works as for +replace+.
#
# @param s [String] the text to rewrite
# @param re [Regex] the pattern to replace
# @param replacement [String | (Match -> String)] the new text, or how to
#   compute it
# @return [String] the text with its first match replaced, or unchanged
#
# @example
#   "a1b22c".replaceFirst(re`\d+`, "#")   # => "a#b22c"
#   "abc".replaceFirst(re`\d`, "#")       # => "abc"
replaceFirst : String -> Regex -> (String | (Match -> String)) -> String
let replaceFirst(s, re, replacement) = Kex.Intrinsic.Regex.replace(s, re, replacement, 1)

# Splits +s+ on +re+, with a limit on the fields.
#
# A positive +limit+ is the most fields to return, and the last one holds the
# rest of the string unsplit. A negative +limit+ keeps trailing empty fields,
# which are dropped otherwise.
#
# Without a limit, use +s.split(re)+. It follows Ruby: trailing empty fields
# are dropped, leading ones kept, and the text of capture groups is included
# between the fields.
#
# @param s [String] the text to split
# @param re [Regex] the separator pattern
# @param limit [Integer] the field cap; negative keeps trailing empty fields
# @return [[String]] the fields
#
# @example Plain splitting needs no limit
#   "a, b ,c".split(re`\s*,\s*`)   # => ["a", "b", "c"]
#
# @example Splitting off just the first field
#   Regex.splitLimit("a,b,c", re`,`, 2)    # => ["a", "b,c"]
#
# @example Keeping the trailing empty fields
#   Regex.splitLimit("a,b,,", re`,`, -1)   # => ["a", "b", "", ""]
splitLimit : String -> Regex -> Integer -> [String]
let splitLimit(s, re, limit) = Kex.Intrinsic.Regex.split(s, re, limit)
