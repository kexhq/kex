module Regex

# Regular expressions, backed by PCRE2 in the interpreter and Erlang's `re`
# on BEAM — the same PCRE pattern language on both. See docs/regex-plan.md.
#
# Opt-in, not prelude: nothing here is in scope until `using Regex`.
#
# @example
#   using Regex
#
#   match regex("\\d+") do
#     Ok(re)   -> IO.printLine("compiled")
#     Error(e) -> IO.printLine("bad pattern at ${e.position}: ${e.message}")
#   end

# +Regex+ carries only its pattern source. The compiled engine object lives in
# a runtime cache keyed by that source, deliberately: a compiled pattern bakes
# in the host's PCRE version and must never be embedded in a distributed
# artifact, so the source string is the value's identity.
record Regex do
  source : String
end

# +RegexError+ describes a pattern that failed to compile. Mirrors +ParseError+
# — the +position+ is a *character* offset into the pattern, not a byte offset,
# so it agrees across backends on patterns containing non-ASCII.
record RegexError do
  source   : String
  position : Integer
  message  : String
end

# NOTE: deliberately does NOT `implement: Errorable`, even though the trait
# exists for exactly this shape. Declaring a `message` method alongside the
# `message` field makes `e.message` dispatch to the method instead of reading
# the field, which fails with `undef` on the BEAM backend. `ParseError` — the
# prelude's equivalent error record — carries a bare `message` field for the
# same reason; nothing in the tree implements Errorable today.

# Compiles a pattern. Returns +Result+ because an arbitrary string may not be a
# valid pattern; the tag form `regex`...`` returns a bare +Regex+ instead, since
# a literal is validated at compile time and cannot fail.
#
# @param source [String]
# @return [Result<Regex, RegexError>]
#
# @example
#   regex("\\d+")        # => Ok(Regex)
#   regex("(")           # => Error(RegexError)
regex : String -> Result<Regex, RegexError>
let regex(source) = Kex.Intrinsic.Regex.compile(source)

# The tagged-literal form — `` regex`\d+` `` — which the parser lowers to the
# two-argument tag ABI regex(parts, values).
#
# Returns a BARE Regex, not a Result: the pattern is known at compile time and
# `validateRegex` below has already proven it compiles, so there is no failure
# to report. That difference in return type is the whole reason both spellings
# exist — see docs/regex-plan.md, "The tag returns Regex; the call returns
# Result".
#
# Interpolated values (`` regex$`^${x}` ``) are escaped per character before
# splicing, so a value contributes literal text and can never inject pattern
# syntax. There is no opt-out; building pattern *structure* from a value is
# what the call form and its Result are for.
#
# @param parts [[String]]
# @param values [[Any]]
# @return [Regex]
regex : [String] -> [Any] -> Regex
let regex(parts, values) = Kex.Intrinsic.Regex.tag(parts, values)

# Companion validator for the `regex` tag, found by the compiler through the
# standard `validate<Tag>` naming convention (nothing about regex is special-
# cased). A raw `` regex`(` `` is a compile error, with the caret pointing at
# the byte offset PCRE2 reported inside the literal.
#
# Must stay pure: the compiler evaluates it on the tree-walk interpreter at
# compile time, so marking it `foul` would break builds, not just calls.
#
# @param source [String]
# @return [[TaggedValidation.Issue]]
let validateRegex(source: String) -> [TaggedValidation.Issue] do
  match Kex.Intrinsic.Regex.validate(source) do
    Just((offset, message)) -> [TaggedValidation.fatalAt(offset, message)]
    None          -> []
  end
end

# +re+ is a short alias for +regex+ — a second name bound to the same two
# functions, not a lexer synonym, so every property of +regex+ (escaping,
# backend mapping, error shape) applies to it unchanged.
#
# @example
#   re`https?://\S+`     # tag form
#   re("\\d+")             # call form -> Result
let re(source) = regex(source)
let re(parts, values) = regex(parts, values)

# Companion validator for the `re` tag, delegating to validateRegex. The
# compiler finds it by the same `validate<Tag>` convention.
let validateRe(source: String) -> [TaggedValidation.Issue] do
  return validateRegex(source)
end

# Escapes every regex metacharacter in +s+, so the result matches +s+
# literally. Escapes per character rather than wrapping in `\Q...\E`, which a
# value containing `\E` would break out of.
#
# @param s [String]
# @return [String]
#
# @example
#   Regex.quote("a.b")   # => "a\\.b"
quote : String -> String
let quote(s) = Kex.Intrinsic.Regex.quote(s)

# +Match+ is the result of a successful match. It behaves like a map keyed by
# both group number (+0+ is the whole match) and group name (+:year+), but is a
# named type so it can grow spans and surrounding context later without
# breaking existing +get+ call sites.
#
# A group that did not participate is an absent key, so +get+ returns +None+ —
# distinct from a group that matched the empty string, which returns +Just("")+.
record Match do
  captures : Map<Any, String>
end

# NOTE: the accessor is +get+, not +get+. A `make` block on a user type that
# defines a method name the prelude also uses breaks that name's dispatch for
# every OTHER type on the BEAM backend — with `get` here, merely saying
# `using Regex` made a plain `someMap.get(k)` fail with function_clause.
# `get` also matches Python's `m.get(1)` and Java's `matcher.get(1)`.
# See docs/regex-plan.md, "Match accessor is `get`".

make Match do
  # Returns the captured text for a group, by number or by name.
  #
  # @param key [Atom | Int]
  # @return [String?]
  #
  # @example
  #   m.get(0)      # whole match
  #   m.get(1)      # first positional group
  #   m.get(:year)  # named group
  get :> (Atom | Integer) -> String?
  let get(key) = Kex.Intrinsic.Map.get(this.captures, key)

  # Returns the captured text for a group, or +default+ if the group is absent.
  #
  # @param key [Atom | Int]
  # @param default [String]
  # @return [String]
  get :> (Atom | Integer) -> String -> String
  let get(key, default) = Kex.Intrinsic.Map.getWithDefault(this.captures, key, default)
end

# Finds the first occurrence of +re+ anywhere in +s+. Unanchored — anchor with
# +^...$+ in the pattern if a whole-string match is wanted.
#
# @param s [String]
# @param re [Regex]
# @return [Match?]
#
# @example
#   "order #4271".matches(re)   # => Just(Match)
matches : String -> Regex -> Match?
let matches(s, re) = Kex.Intrinsic.Regex.matches(s, re)

# Reports whether +re+ occurs anywhere in +s+. The boolean form of +matches+,
# and unanchored for the same reason.
#
# @param s [String]
# @param re [Regex]
# @return [Bool]
#
# @example
#   "hello".matches?(re)   # => true
matches? : String -> Regex -> Bool
let matches?(s, re) = Kex.Intrinsic.Regex.matches?(s, re)

# Every match of +re+ in +s+, left to right.
#
# Always returns +[Match]+, whether or not the pattern has capture groups —
# adding a group to a pattern must not change the type flowing out of +scan+.
#
# @param s [String]
# @param re [Regex]
# @return [[Match]]
#
# @example
#   "cat=1, dog=2".scan(re).map do |m| m.get(1, "") end
scan : String -> Regex -> [Match]
let scan(s, re) = Kex.Intrinsic.Regex.scan(s, re)

# Replaces **every** match of +re+ in +s+ — this is +gsub+, not +sub+.
#
# The replacement is either a literal String, inserted verbatim with no
# +$1+/+\1+ backreference syntax, or a block receiving the +Match+.
#
# @param s [String]
# @param replacement [String]
# @return [String]
#
# @example
#   "a-b-c".replace(re, "+")                       # => "a+b+c"
#   "2026-7-4".replace(re) do |m| m.get(1, "") end
replace : String -> Regex -> String -> String
let replace(s, re, replacement) = Kex.Intrinsic.Regex.replace(s, re, replacement)

# Splits +s+ on +re+, following Ruby's semantics: trailing empty fields are
# dropped (leading ones are kept), and any capture groups in the pattern are
# interleaved into the result.
#
# @param s [String]
# @param re [Regex]
# @return [[String]]
#
# @example
#   "a, b ,c".split(regex("\\s*,\\s*"))   # => ["a", "b", "c"]
# Splits with a field limit — the qualified-only companion to +s.split(re)+. A positive +limit+ caps the number of fields,
# leaving the remainder unsplit in the last one; a negative +limit+ keeps
# trailing empty fields instead of dropping them.
#
# Plain +s.split(re)+ needs no function here at all: it resolves to
# +String.split+, which dispatches to this engine when handed a Regex (in both
# backends). Only the limit form needs a name, and it deliberately is NOT
# `split` — this module must not export that name. On BEAM, a module in scope
# via `using` captures a method name for EVERY receiver, so exporting `split`
# here would route `"a,b".split(",")` and even the no-argument `"hi".split`
# through this module and break them. See docs/regex-plan.md, "split shares
# String's UFCS name".
#
# @param s [String]
# @param re [Regex]
# @param limit [Integer]
# @return [[String]]
#
# @example
#   Regex.splitLimit("a,b,c", re, 2)    # => ["a", "b,c"]
#   Regex.splitLimit("a,b,,", re, -1)   # => ["a", "b", "", ""]
splitLimit : String -> Regex -> Integer -> [String]
let splitLimit(s, re, limit) = Kex.Intrinsic.Regex.split(s, re, limit)
