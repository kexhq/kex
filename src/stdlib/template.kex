# ERB-style templates: scanning template text into nodes, and filling simple
# templates at run time.
#
# Nothing here is in scope until +using Template+.
#
# +Template.scan+ turns template text into its frontmatter and a flat list of
# +Node+s: plain text and the four kinds of +<% %>+ region. It does not run
# anything or parse Kex; the text inside a tag is kept as written.
# +Template.render+ fills a template that only substitutes values, from a
# map. A template with Kex control flow is compiled instead, with
# +Template.html(Kex.embed(path))+ or +Template.text(Kex.embed(path))+.
#
#   using Template
#
#   let source = "---\ntitle: Welcome\nparams: [name, library: Bool]\n---\nHi <%= name %>!"
#   let parsed = Template.scan(source).try
#   parsed.frontmatter.get("title")    # => Just(Scalar("Welcome"))
#   parsed.parameters.map { |p| (p.name, p.type) }
#   # => [("name", ""), ("library", "Bool")]
#   parsed.nodes                       # => [Text("Hi "), Interpolate("name"), Text("!")]
#
# A template file's name puts the extension of what it produces before
# +.ket+, such as +README.md.ket+ or +profile.html.ket+, so an editor can
# highlight it:
#
#   ---
#   params: [name, library: Bool, dependencies: [Dependency]]
#   ---
#   # <%= name %>
#
#   <% if library %>
#   A Kex library.
#   <% else %>
#   A Kex application.
#   <% end %>
#
#   <% dependencies.map do |dep| %>
#   - `<%= dep.name %>` ~> <%= dep.version %>
#   <% end %>
#
# ## Syntax
#
#   <%= expr %>     inserts the value, HTML-escaped by Template.html and
#                   Template.render
#   <%== expr %>    inserts the value without escaping
#   <% ... %>       Kex control code: if and match arms, block bodies, let
#   <%# ... %>      a comment, which produces nothing
#   <%- ... -%>     trims the indentation before the tag and the newline
#                   after it (see Whitespace below)
#   <%%             a literal <%, for a template that writes ERB itself
#
# ## Layouts
#
# A layout is a template that takes the page as a block. The two templates
# do not refer to each other; the Kex code that calls them puts them
# together. Insert the block's result with +<%== %>+, since it is already
# rendered, and already escaped if it came from +Template.html+.
#
#   ---
#   params: [title: String, content: Block<String>]
#   ---
#   <title><%= title %></title>
#   <main><%== content() %></main>
#
#   let frame = Template.html(Kex.embed("views/layouts/auth.html.ket"))
#   let form = Template.html(Kex.embed("views/signin.html.ket"))
#
#   let signin(email: String) -> String = frame("Sign in") { form(email) }
#
# ## Whitespace
#
# A +<% %>+ or +<%# %>+ tag that is alone on its line, with only whitespace
# around it, removes the whole line from the output, its indentation and
# newline included. So the template reads the way its output does:
#
#   <% if dependencies.count > 0 %>
#   ## Dependencies
#   <% end %>
#
#   # => "## Dependencies\n", with no blank lines where the tags were
#
# The +<%-+ and +-%>+ markers are for a tag that shares its line with other
# content, where only the author knows what should be trimmed:
#
#   Total: <%= total %> <%- if pending > 0 %>(<%= pending %> pending)<% end %>
#
# An interpolation is never trimmed, even alone on its line. It stands for
# content, so the whitespace around it is content too:
#
#   <%= greeting %>
#   <%= name %>
#
#   # => "Hi\nAda\n", with both newlines kept
#
# ## Frontmatter
#
# A template may start with a +---+ line, then +key: value+ lines, then a
# closing +---+ line before the body. The keys are for whatever reads the
# template, such as a title or a list of tags, and the scanner reads every
# key the same way. A value is a plain string or a +[a, b, c]+ list.
#
#   ---
#   title: Release notes
#   tags: [changelog, public]
#   ---
#   # <%= title %>
#
# By convention, a template declares its parameters under +params+, as a
# list of names, each with an optional +: Type+:
#
#   ---
#   params: [name, library: Bool, dependencies: [Dependency]]
#   ---
#   # <%= name %>
#
# +Parsed.parameters+ reads that list and splits each entry at its first
# colon into a +TemplateParam+. The type stays text: +[Dependency]+ is the
# string +"[Dependency]"+, not a resolved Kex type.
module Template
using Parsing

# One piece of a scanned template: plain text, or one kind of tag with the
# text inside it.
#
# The text inside a tag is the Kex source between the delimiters, with the
# surrounding whitespace trimmed. It is not parsed.
type Node = Text(String)
          | Interpolate(String)
          | InterpolateRaw(String)
          | Control(String)
          | Comment(String)

# A frontmatter value: a plain string, or a +[a, b, c]+ list.
type Tag = Scalar(String)
         | Tags([String])

# The reason a template could not be scanned or rendered.
#
# +UnterminatedTag+ carries the character position of the tag that is not
# closed. +MalformedFrontmatterLine+ carries the offending line.
# +UndefinedVariable+ and +UnsupportedControl+ come from +Template.render+
# and +Template.renderParsed+, and carry the tag's text.
type TemplateError = UnterminatedTag(Integer)
                    | UnterminatedFrontmatter
                    | MalformedFrontmatterLine(String)
                    | UndefinedVariable(String)
                    | UnsupportedControl(String)

# One entry of a +params: [...]+ frontmatter list: a name and its type.
#
# +type+ is the text after the colon, or +""+ for a bare name. It is not
# resolved to a Kex type.
record TemplateParam do
  name : String
  type : String
end

# One scanned +<% ... %>+ tag and the whitespace trims its delimiters ask
# for. Used inside the scanner only.
#
# It is declared outside +private do+ because a record nested there loses
# its field names on BEAM.
record TagScan do
  node      : Node
  leftTrim?  : Bool
  rightTrim? : Bool
end

# A scanned template: its frontmatter, and its body as a list of nodes.
record Parsed do
  frontmatter : {String: Tag}
  nodes       : [Node]
end

make Parsed do
  # Returns the parameters declared under the template's +params+ key, in
  # the order written.
  #
  # Returns +[]+ when there is no +params+ key, or when its value is not a
  # list.
  #
  # @return [[TemplateParam]] the declared parameters
  #
  # @example
  #   Template.scan("---\nparams: [name, library: Bool]\n---\n").try
  #     .parameters.map { |p| (p.name, p.type) }
  #   # => [("name", ""), ("library", "Bool")]
  let parameters -> [TemplateParam] do
    let none: [TemplateParam] = []
    match @frontmatter.get("params") do
      Just(Tags(names)) => parseTemplateParams(names)
      _ => none
    end
  end
end

# Scans template text into its frontmatter and nodes.
#
# @param source [String] the template's full text
# @return [Result<Parsed, TemplateError>] the scanned template, or what is
#   wrong with it
#
# @example
#   Template.scan("Hi <%= name %>!").map(~nodes)
#   # => Ok([Text("Hi "), Interpolate("name"), Text("!")])
#
# @example A control tag alone on its line leaves no blank line behind
#   Template.scan("<% if admin %>\nWelcome back.\n<% end %>\n").try.nodes
#   # => [Control("if admin"), Text("Welcome back.\n"), Control("end")]
#
# @example An unclosed tag, reported at its position
#   Template.scan("Hi <%= name")
#   # => Error(UnterminatedTag(6))
let scan(source: String) -> Result<Parsed, TemplateError> do
  let cursor = Input { input: source }
  let (frontmatter, afterFrontmatter) = scanFrontmatter(cursor).try
  let (nodes, _) = scanBody(afterFrontmatter).try
  Ok(Parsed { frontmatter: frontmatter, nodes: nodes })
end

# Escapes +&+, +<+, +>+, double quotes and single quotes, so the text is safe
# in HTML content and in quoted attribute values.
#
# +Template.html+ escapes +<%= %>+ tags this way. It does not make text safe
# inside a URL, a script or a style sheet.
#
# @param text [String] the text to escape
# @return [String] the escaped text
#
# @example
#   Template.escapeHtml("<b>Tom & Jerry</b>")
#   # => "&lt;b&gt;Tom &amp; Jerry&lt;/b&gt;"
let escapeHtml(text: String) -> String do
  text.replace("&", "&amp;")
      .replace("<", "&lt;")
      .replace(">", "&gt;")
      .replace("\"", "&quot;")
      .replace("'", "&#39;")
end

# Fills a scanned template with the values in +context+.
#
# +<%= %>+ inserts the value HTML-escaped, and +<%== %>+ inserts it as is.
# Only substitution is supported: a +<% ... %>+ control tag gives an
# +UnsupportedControl+ error. For templates with control flow, use
# +Template.html+ or +Template.text+, which compile the template.
#
# Each tag's trimmed text is looked up as a key, whole. +<%= dep.name %>+
# reads the +"dep.name"+ key; it does not read a field of a value under
# +"dep"+.
#
# @param parsed [Parsed] a template scanned by +Template.scan+
# @param context [{String: String}] a value for every +<%= %>+ and
#   +<%== %>+ tag, keyed by the tag's trimmed text
# @return [Result<String, TemplateError>] the rendered text, or why it could
#   not be rendered
#
# @example
#   let parsed = Template.scan("Hi <%= name %>!").try
#   Template.renderParsed(parsed, { "name": "<Ada>" })
#   # => Ok("Hi &lt;Ada&gt;!")
#
# @example A tag that +context+ has no value for
#   Template.renderParsed(Template.scan("<%= missing %>").try, {})
#   # => Error(UndefinedVariable("missing"))
#
# @example A control tag
#   Template.renderParsed(Template.scan("<% if x %>y<% end %>").try, {})
#   # => Error(UnsupportedControl("if x"))
let renderParsed(parsed: Parsed, context: {String: String}) -> Result<String, TemplateError> do
  var out = ""
  var i = 0
  loop do
    break if i >= parsed.nodes.count
    match parsed.nodes.at(i).or(Text("")) do
      Text(text) => out = "${out}${text}"
      Interpolate(name) => do
        let value = context.get(name.trim)
        return Error(UndefinedVariable(name.trim)) if value == None
        out = "${out}${escapeHtml(value.or(""))}"
      end
      InterpolateRaw(name) => do
        let value = context.get(name.trim)
        return Error(UndefinedVariable(name.trim)) if value == None
        out = "${out}${value.or("")}"
      end
      Comment(_) => ()
      Control(body) => return Error(UnsupportedControl(body))
    end
    i = i + 1
  end
  Ok(out)
end

# Scans +source+ and fills it with the values in +context+, as
# +Template.renderParsed+ does.
#
# @param source [String] the template's full text
# @param context [{String: String}] a value for every +<%= %>+ and
#   +<%== %>+ tag, keyed by the tag's trimmed text
# @return [Result<String, TemplateError>] the rendered text, or why it could
#   not be scanned or rendered
#
# @example
#   Template.render("Hi <%= name %>!", { "name": "Ada" })
#   # => Ok("Hi Ada!")
let render(source: String, context: {String: String}) -> Result<String, TemplateError> do
  let parsed = scan(source).try
  renderParsed(parsed, context)
end

private do
  # True when `cursor` sits at the very start of the input and that line is
  # exactly `---`: the only place a frontmatter block may open.
  # Hand-rolled peek chain rather than `Input#string("---")`: `string`'s name
  # collides with `Char#string` (a zero-arg property) the same way
  # `takeWhile`/`atEnd?`/`readLine` collide elsewhere in this file: the
  # prelude-interface build picks the wrong candidate and reports an arity
  # mismatch even though the receiver type here is unambiguous.
  let atFrontmatterOpen?(cursor: Input) -> Bool do
    (cursor.pos == 0 &&
      cursor.peek == Just('-') && cursor.peekAt(1) == Just('-') && cursor.peekAt(2) == Just('-') &&
      (cursor.peekAt(3) == Just('\n') || cursor.peekAt(3) == Just('\r') || cursor.peekAt(3) == None))
  end

  # A cursor advanced past the current character if it is `\r\n` or `\n`;
  # otherwise unchanged. What a `-%>` closer's trailing-newline trim needs.
  let skipOneNewline(cursor: Input) -> Input do
    if cursor.peek == Just('\r') && cursor.peekAt(1) == Just('\n')
      cursor.advanceBy(2)
    elif cursor.peek == Just('\n')
      cursor.advance
    else
      cursor
    end
  end

  # A cursor advanced to the next `\n` (not past it), and the text skipped.
  #
  # Hand-rolled rather than `Input#takeWhile`: see `scanText`'s comment on why.
  #
  # Tracks the run's start position and slices once at the end, rather than
  # building it one `Char` at a time with `push!`: pushing to a `var` list
  # rebinds it to a freshly copied list every call (kexhq/kex#379), so a
  # character-at-a-time accumulation of an N-character line cost O(N^2), not
  # O(N). One slice is O(N) total regardless of how many lines are scanned.
  let scanLine(cursor: Input) -> (String, Input) do
    var cur = cursor
    let start = cur.pos
    loop do
      break if cur.peek == None
      break if cur.peek == Just('\n')
      cur.advance!
    end
    (cur.input.chars.drop(start).take(cur.pos - start).join(""), cur)
  end

  # A line's text with any trailing `\r` dropped, for a source that mixes
  # `\r\n` and `\n` line endings.
  let stripTrailingCR(text: String) -> String do
    text.endsWith?("\r") then text.take(text.count - 1) else text
  end

  # Strips one layer of matching `"..."` or `'...'` quotes, if present.
  let unquote(text: String) -> String do
    let quoted = (text.count >= 2 &&
      ((text.startsWith?("\"") && text.endsWith?("\"")) || (text.startsWith?("'") && text.endsWith?("'"))))
    quoted then text.drop(1).take(text.count - 2) else text
  end

  # A frontmatter value's text, parsed as a `[a, b, c]` list or a scalar.
  # Splits `text` on commas that are not nested inside `[]`, `()`, `<>`, or
  # `{}`, so a `params` entry's type, `Map<String, Integer>` or
  # `[Dependency, Other]`, stays one list item rather than splitting on its
  # own internal comma.
  let splitTopLevelCommas(text: String) -> [String] do
    let empty: ([String], String, Integer) = ([], "", 0)
    let (parts, last, _) = text.reduce(empty) do |acc, ch|
      let (parts, current, depth) = acc
      if ch == '[' || ch == '(' || ch == '<' || ch == '{'
        (parts, "${current}${ch}", depth + 1)
      elif ch == ']' || ch == ')' || ch == '>' || ch == '}'
        (parts, "${current}${ch}", depth - 1)
      elif ch == ',' && depth == 0
        ([...parts, current], "", depth)
      else
        (parts, "${current}${ch}", depth)
      end
    end
    last.empty? then parts else [...parts, last]
  end

  let parseFrontmatterValue(raw: String) -> Tag do
    if raw.startsWith?("[") && raw.endsWith?("]")
      let inner = raw.drop(1).take(raw.count - 2).trim
      let items = inner.empty? then [] else splitTopLevelCommas(inner).map { |item| unquote(item.trim) }
      Tags(items)
    else
      Scalar(unquote(raw))
    end
  end

  # One `key: value` frontmatter line, split at its first colon.
  let parseFrontmatterLine(line: String) -> Result<(String, Tag), TemplateError> do
    let colon = line.findIndex { |ch| ch == ':' }
    return Error(MalformedFrontmatterLine(line)) if colon == None
    # `.or(0)` rather than `let Just(index) = colon`: the guard above already
    # rules out `None`, but destructuring it and feeding the bound name
    # straight into another generic call (`take`/`drop`) trips a real
    # type-checker bug where the prelude-interface build cross-contaminates
    # unrelated generic inference elsewhere in the stdlib. Unwrapping with a
    # (dead) default avoids it.
    let index = colon.or(0)
    let key = line.take(index).trim
    return Error(MalformedFrontmatterLine(line)) if key.empty?
    let value = parseFrontmatterValue(line.drop(index + 1).trim)
    Ok((key, value))
  end

  # One `params` list entry, split into a name and its optional `: Type`.
  # `type` is `""` when `raw` is a bare name.
  let parseTemplateParam(raw: String) -> TemplateParam do
    let colon = raw.findIndex { |ch| ch == ':' }
    if colon == None
      TemplateParam { name: raw.trim, type: "" }
    else
      # `.or(0)` rather than destructuring: see `parseFrontmatterLine`'s
      # comment on why.
      let index = colon.or(0)
      TemplateParam { name: raw.take(index).trim, type: raw.drop(index + 1).trim }
    end
  end

  # `names.map(~parseTemplateParam)`, spelled as an indexed loop rather than a
  # generic `map`/`reduce` call: `[String]`'s element type is itself a type
  # that implements `Enumerable`, and going through the shared HOF name here
  # sends the prelude-interface build's overload resolution to `String`'s own
  # `reduce` (iterating characters) instead of `List`'s: the bound block
  # parameter then type-checks as `Char`, not `String`. Same collision class
  # as `Input#takeWhile`/`atEnd?`/`string` elsewhere in this file.
  let parseTemplateParams(names: [String]) -> [TemplateParam] do
    var params: [TemplateParam] = []
    var i = 0
    loop do
      break if i >= names.count
      params.push!(parseTemplateParam(names.at(i).or("")))
      i = i + 1
    end
    params
  end

  # Reads a leading `---` ... `---` frontmatter block, if the input opens with
  # one. Answers an empty map and the cursor unmoved when it does not.
  let scanFrontmatter(cursor: Input) -> Result<({String: Tag}, Input), TemplateError> do
    return Ok(({}, cursor)) if !atFrontmatterOpen?(cursor)

    let (_, afterOpenLine) = scanLine(cursor)
    var cur = skipOneNewline(afterOpenLine)
    var tags: {String: Tag} = {}
    loop do
      return Error(UnterminatedFrontmatter) if cur.peek == None
      let (rawLine, afterLine) = scanLine(cur)
      let line = stripTrailingCR(rawLine).trim
      cur = skipOneNewline(afterLine)
      return Ok((tags, cur)) if line == "---"
      if !line.empty?
        let (key, value) = parseFrontmatterLine(line).try
        tags = tags.put(key, value)
      end
    end
  end

  # True when `cursor` sits at a `<%` tag opener (and it is not the `<%%`
  # escape for a literal `<%`).
  let atTagOpen?(cursor: Input) -> Bool do
    cursor.peek == Just('<') && cursor.peekAt(1) == Just('%') && cursor.peekAt(2) != Just('%')
  end

  # Reads plain text up to the next tag opener or end of input. `<%%` is
  # consumed as a literal `<%` and folded into the text rather than ending it.
  #
  # Hand-rolled rather than built on `Input#takeWhile`: that function's name
  # collides with `List#takeWhile`, and calling it through an `Input` receiver
  # sends overload resolution down the wrong path (`json.kex`'s own scanners
  # hit the same thing and avoid it the same way).
  #
  # Tracks each run's start position and slices it out whole, rather than
  # pushing one `Char` at a time: see `scanLine`'s comment on why that was
  # quadratic (kexhq/kex#379). `<%%` still needs a per-occurrence split (it
  # folds three input characters into two output ones), but that split is as
  # rare as `<%%` itself, not once per character of ordinary text.
  let scanText(cursor: Input) -> (String, Input) do
    var cur = cursor
    var pieces: [String] = []
    var runStart = cur.pos
    loop do
      break if cur.peek == None
      break if atTagOpen?(cur)
      if cur.peek == Just('<') && cur.peekAt(1) == Just('%') && cur.peekAt(2) == Just('%')
        pieces.push!(cur.input.chars.drop(runStart).take(cur.pos - runStart).join(""))
        pieces.push!("<%")
        cur.advanceBy!(3)
        runStart = cur.pos
      else
        cur.advance!
        ()
      end
    end
    pieces.push!(cur.input.chars.drop(runStart).take(cur.pos - runStart).join(""))
    (pieces.join(""), cur)
  end

  # Strips trailing spaces and tabs (not newlines): the indentation a `<%-`
  # opener asks to have removed from the text before it.
  let trimTrailingIndent(text: String) -> String do
    var chars = text.chars
    loop do
      break if chars.empty?
      let Just(last) = chars.last
      break if last != ' ' && last != '\t'
      chars = chars.take(chars.count - 1)
    end
    chars.join("")
  end

  # A tag that emits nothing of its own. Only these can have their whole
  # line disappear: a tag that produces output stands in real content, so
  # the whitespace around it is content too.
  let silent?(node: Node) -> Bool do
    match node do
      Control(_) => true
      Comment(_) => true
      _          => false
    end
  end

  # Whether the text scanned before a tag leaves the cursor at the start of
  # a line — nothing but spaces and tabs since the last newline. `prior`
  # answers it for text that holds no newline at all, carrying forward what
  # was true before that text: two tags separated by spaces alone are both
  # still at the start of their line.
  let atLineStart?(text: String, prior: Bool) -> Bool do
    let after = text.split("\n").last
    match after do
      Just(tail) => text.contains?("\n") then blank?(tail) else prior && blank?(text)
      None       => prior
    end
  end

  # True for text of spaces and tabs alone, the empty string included.
  let blank?(text: String) -> Bool do
    text.chars.all? { |ch| ch == ' ' || ch == '\t' }
  end

  # True when nothing but spaces and tabs stands between `cursor` and the end
  # of its line. The right half of what makes a tag stand alone; end of input
  # counts, since there is no trailing content there either.
  let blankToLineEnd?(cursor: Input) -> Bool do
    var cur = cursor
    loop do
      break if cur.peek != Just(' ') && cur.peek != Just('\t')
      cur.advance!
    end
    cur.peek == None || cur.peek == Just('\n') || cur.peek == Just('\r')
  end

  # A cursor advanced past the rest of a blank line, its newline included.
  # What a standalone tag's own line needs once the tag itself is scanned.
  let skipBlankLineRest(cursor: Input) -> Input do
    var cur = cursor
    loop do
      break if cur.peek != Just(' ') && cur.peek != Just('\t')
      cur.advance!
    end
    skipOneNewline(cur)
  end

  # `<%=`, `<%==`, `<%#`, or plain `<%`, which kind of region this is, and
  # the cursor past the marker.
  let classifyTag(cursor: Input) -> (String, Input) do
    if cursor.peek == Just('=') && cursor.peekAt(1) == Just('=')
      ("raw", cursor.advanceBy(2))
    elif cursor.peek == Just('=')
      ("interpolate", cursor.advance)
    elif cursor.peek == Just('#')
      ("comment", cursor.advance)
    else
      ("control", cursor)
    end
  end

  # Reads a tag's body up to its closer, `%>` or `-%>`. Answers the raw text,
  # whether the closer trims the following newline, and the cursor past it.
  #
  # Slices the body out once at the closer, rather than pushing one `Char` at
  # a time — see `scanLine`'s comment on why that was quadratic
  # (kexhq/kex#379).
  let scanTagBody(cursor: Input) -> Result<(String, Bool, Input), TemplateError> do
    let start = cursor.pos
    var cur = cursor
    loop do
      return Error(UnterminatedTag(start)) if cur.peek == None
      return Ok((cur.input.chars.drop(start).take(cur.pos - start).join(""), true, cur.advanceBy(3))) if cur.peek == Just('-') && cur.peekAt(1) == Just('%') && cur.peekAt(2) == Just('>')
      return Ok((cur.input.chars.drop(start).take(cur.pos - start).join(""), false, cur.advanceBy(2))) if cur.peek == Just('%') && cur.peekAt(1) == Just('>')
      cur.advance!
    end
  end

  # The node a tag's kind and trimmed body settle into.
  let tagNode(kind: String, body: String) -> Node do
    if kind == "raw"
      InterpolateRaw(body)
    elif kind == "interpolate"
      Interpolate(body)
    elif kind == "comment"
      Comment(body)
    else
      Control(body)
    end
  end

  # Scans one tag starting at `cursor`, which must sit at a `<%` opener.
  let scanTag(cursor: Input) -> Result<(TagScan, Input), TemplateError> do
    let opened = cursor.advanceBy(2)
    let leftTrim = opened.peek == Just('-')
    let afterTrim = leftTrim then opened.advance else opened
    let (kind, afterKind) = classifyTag(afterTrim)
    let (body, rightTrim, rest) = scanTagBody(afterKind).try
    let scanned = TagScan { node: tagNode(kind, body.trim), leftTrim?: leftTrim, rightTrim?: rightTrim }
    Ok((scanned, rest))
  end

  # Scans the template body (everything after any frontmatter) into nodes.
  #
  # A tag that emits nothing and stands alone on its line takes that line
  # with it, without being asked: `<% end %>` on a line of its own leaves no
  # blank line behind, the same as `<%- end -%>`. That is what a template
  # author means every time, so the trim markers are for the other case — a
  # tag with real content beside it on the line.
  let scanBody(cursor: Input) -> Result<([Node], Input), TemplateError> do
    var cur = cursor
    var nodes: [Node] = []
    var lineStart = true
    loop do
      let (text, afterText) = scanText(cur)
      if afterText.peek == None
        if !text.empty?
          nodes.push!(Text(text))
        end
        return Ok((nodes, afterText))
      end
      let (tag, afterTag) = scanTag(afterText).try
      let alone = silent?(tag.node) && atLineStart?(text, lineStart) && blankToLineEnd?(afterTag)
      let keptText = (tag.leftTrim? || alone) then trimTrailingIndent(text) else text
      if !keptText.empty?
        nodes.push!(Text(keptText))
      end
      nodes.push!(tag.node)
      cur = if alone
        skipBlankLineRest(afterTag)
      elif tag.rightTrim?
        skipOneNewline(afterTag)
      else
        afterTag
      end
      lineStart = alone || tag.rightTrim?
    end
  end
end
