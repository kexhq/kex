# An immutable sequence of bytes, such as a file's contents, an HTTP body or
# a digest.
#
# +Binary+ is the compact storage form; +[Byte]+ is the same bytes as a
# list. On BEAM, +take+ and +drop+ share the original's storage instead of
# copying it.
#
#   let data = Binary.fromHex("00686900").try
#   data.length            # => 4
#   data.at(1)             # => Just(104)
#   data.take(2).hex       # => "0068"
#   data.showValue         # => "#Binary<4 bytes>"
#
# The type is opaque, so string functions cannot be run on bytes by mistake.
# Converting to or from text is always explicit, and +to+ returns an
# optional, since the conversion can fail:
#
#   "árvíz".to(Binary)                  # => Just(#Binary<7 bytes>)
#   Binary.fromBytes([255]).to(String)  # => None
#
# Printing a binary shows only its length. It never shows the bytes, so it
# cannot leak them, and it cannot fail on bytes that are not text. Use
# +hex+, +base64+ or +to(String)+ to see the contents.
type Binary

module Binary do
  # The binary with no bytes.
  #
  # @return [Binary] the zero-length binary
  #
  # @example
  #   Binary.empty.length   # => 0
  empty : Binary
  let empty = Kex.Intrinsic.Binary.fromBytes([])

  # Builds a binary from a list of bytes.
  #
  # It cannot fail, since every +Byte+ is already in +0..255+.
  #
  # @param values [[Byte]] the bytes to store
  # @return [Binary] the bytes as a binary
  #
  # @example
  #   Binary.fromBytes([104, 105])   # => #Binary<2 bytes>
  #   Binary.fromBytes([])           # => #Binary<0 bytes>
  fromBytes : [Byte] -> Binary
  let fromBytes(values) = Kex.Intrinsic.Binary.fromBytes(values)

  # Decodes lowercase hexadecimal text.
  #
  # It accepts exactly what +hex+ produces. Uppercase digits, an odd length,
  # whitespace, a +0x+ prefix or any other character give +None+.
  #
  # @param text [String] the hexadecimal text
  # @return [Binary?] the bytes, or +None+ when the text is not lowercase hex
  #
  # @example
  #   Binary.fromHex("0068")   # => Just(#Binary<2 bytes>)
  #   Binary.fromHex("0x68")   # => None
  #   Binary.fromHex("AB")     # => None
  #   Binary.fromHex("a")      # => None
  #
  # @example Reading an identifier from the environment
  #   let key = ENV.get("CACHE_KEY").into { |text| Binary.fromHex(text) }
  #   let cacheEnabled? = key.present?
  fromHex : String -> Binary?
  let fromHex(text) = Kex.Intrinsic.Binary.fromHex(text)

  # Decodes standard base64 text (RFC 4648).
  #
  # It accepts exactly what +base64+ produces. The URL-safe alphabet,
  # missing or wrong padding, whitespace and any other variant give +None+.
  #
  # @param text [String] the base64 text
  # @return [Binary?] the bytes, or +None+ when the text is not standard,
  #   padded base64
  #
  # @example
  #   Binary.fromBase64("AGhp/w==")   # => Just(#Binary<4 bytes>)
  #   Binary.fromBase64("AGhp_w==")   # => None
  #   Binary.fromBase64("AGhp/w")     # => None
  #
  # @example Loading key material from an environment variable
  #   let signingKey = ENV.get("SIGNING_KEY").into { |text| Binary.fromBase64(text) }
  fromBase64 : String -> Binary?
  let fromBase64(text) = Kex.Intrinsic.Binary.fromBase64(text)
end

make Binary, implement: Showable, Inspectable do
  # Returns the bytes as a list.
  #
  # This copies every byte into a new list. +length+, +at+, +take+ and
  # +drop+ work on the binary directly.
  #
  # @return [[Byte]] every byte, in order
  #
  # @example
  #   Binary.fromHex("0068").try.bytes   # => [0, 104]
  let bytes -> [Byte] = Kex.Intrinsic.Binary.bytes(this)

  # Returns the number of bytes.
  #
  # @return [Integer] the byte count
  #
  # @example
  #   "héllo".to(Binary).try.length   # => 6
  let length -> Integer = Kex.Intrinsic.Binary.length(this)

  # Returns the number of bytes; the same as +length+.
  #
  # @return [Integer] the byte count
  #
  # @example
  #   "héllo".to(Binary).try.count   # => 6
  let count -> Integer = Kex.Intrinsic.Binary.length(this)

  # Returns +true+ when the binary has no bytes.
  #
  # @return [Bool] +true+ when the binary is empty
  #
  # @example
  #   Binary.fromBytes([]).empty?   # => true
  let empty? -> Bool = this.length == 0

  # Returns the byte at +index+, counting from zero, or +None+ when the index
  # is outside the binary.
  #
  # A negative index counts back from the end, as on a list: +-1+ is the last
  # byte.
  #
  # @param index [Integer] the position to read
  # @return [Byte?] the byte, or +None+ when the index is outside the binary
  #
  # @example
  #   let data = Binary.fromBytes([104, 105])
  #   data.at(0)    # => Just(104)
  #   data.at(2)    # => None
  #   data.at(-1)   # => Just(105)
  #   data.at(-3)   # => None
  let at(index: Integer) -> Byte? do
    return Kex.Intrinsic.Binary.at(this, index < 0 then this.length + index else index)
  end

  # Returns the byte at +index+, or +None+ when the index is outside the
  # binary; the same as +at+.
  #
  # @param index [Integer] the position to read
  # @return [Byte?] the byte, or +None+ when the index is outside the binary
  #
  # @example
  #   Binary.fromBytes([104, 105]).get(1)   # => Just(105)
  #   Binary.fromBytes([104, 105]).get(9)   # => None
  get :> Integer -> Byte?
  let get(index) = this.at(index)

  # Returns the byte at +index+, or +default+ when the index is outside the
  # binary.
  #
  # @param index [Integer] the position to read
  # @param default [Byte] the value to use when out of range
  # @return [Byte] the byte, or +default+
  #
  # @example
  #   Binary.fromBytes([104, 105]).get(0, 0)   # => 104
  #   Binary.fromBytes([104, 105]).get(9, 0)   # => 0
  get :> Integer -> Byte -> Byte
  let get(index, default) = this.at(index).or(default)

  # Returns the first +count+ bytes.
  #
  # A +count+ of zero or less gives the empty binary, and one past the end
  # gives the whole binary.
  #
  # @param count [Integer] how many bytes to keep
  # @return [Binary] the leading bytes
  #
  # @example
  #   let data = Binary.fromBytes([104, 105])
  #   data.take(1).bytes     # => [104]
  #   data.take(0).bytes     # => []
  #   data.take(999) == data # => true
  let take(count: Integer) -> Binary = Kex.Intrinsic.Binary.take(this, count)

  # Returns the bytes after the first +count+.
  #
  # A +count+ of zero or less gives the whole binary, and one past the end
  # gives the empty binary, so +take(n) + drop(n)+ is always the original.
  #
  # @param count [Integer] how many bytes to skip
  # @return [Binary] the remaining bytes
  #
  # @example
  #   let data = Binary.fromBytes([104, 105])
  #   data.drop(1).bytes                    # => [105]
  #   (data.take(1) + data.drop(1)) == data # => true
  let drop(count: Integer) -> Binary = Kex.Intrinsic.Binary.drop(this, count)

  # Joins two binaries end to end.
  #
  # @param other [Binary] the bytes to append
  # @return [Binary] the two payloads, in order
  #
  # @example
  #   Binary.fromBytes([104]) + Binary.fromBytes([105])   # => #Binary<2 bytes>
  let +(other: Binary) -> Binary = Kex.Intrinsic.Binary.concat(this, other)

  # Returns the bytes as lowercase hexadecimal text, two digits per byte.
  #
  # @return [String] the hexadecimal encoding
  #
  # @example
  #   Binary.fromBytes([0, 104, 255]).hex   # => "0068ff"
  let hex -> String = Kex.Intrinsic.Binary.hex(this)

  # Returns the bytes as standard, padded base64 text (RFC 4648).
  #
  # @return [String] the base64 encoding
  #
  # @example
  #   Binary.fromBytes([0, 104, 105, 255]).base64   # => "AGhp/w=="
  let base64 -> String = Kex.Intrinsic.Binary.base64(this)

  # Renders the binary as its length, never its contents.
  #
  # @return [String] +#Binary<N bytes>+
  #
  # @example
  #   Binary.fromBytes([104, 105]).showValue   # => "#Binary<2 bytes>"
  let showValue -> String = Kex.Intrinsic.Binary.render(this)

  # Renders the binary as its length, never its contents; the same as
  # +showValue+.
  #
  # @return [String] +#Binary<N bytes>+
  let inspectValue(_: Bool) -> String = Kex.Intrinsic.Binary.render(this)

  # Decodes the bytes as UTF-8, or returns +None+ when they are not valid
  # UTF-8.
  #
  # Unlike +showValue+, this exposes the contents.
  #
  # @return [String?] the decoded text, or +None+ for invalid UTF-8
  #
  # @example Printing a response body that may not be text
  #   match response.body.to(String) do
  #     Just(text) => IO.printLine(text)
  #     None       => IO.printLine("received ${response.body.length} bytes")
  #   end
  let to(String) -> String? = Kex.Intrinsic.Fun.convertTo(this, String)
end
