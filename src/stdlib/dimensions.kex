# Dimension algebra at run time: a dimension maps base dimensions to integer
# exponents.
#
# A base dimension is identified by the type of a marker value, so modules
# that use the same marker type share the dimension. The marker's field
# values play no part.
#
# Multiplying adds exponents, dividing subtracts them, and raising to an
# integer power multiplies them. Zero exponents are dropped, so a dimension
# that cancels out equals +Dimensions.one+.
#
#   using Dimensions
#
#   record Distance do
#   end
#
#   record Span do
#   end
#
#   let speed = Dimensions.base(Distance {}) / Dimensions.base(Span {})
#   speed.exponentOf(Span {})   # => -1
module Dimensions

# A dimension: base dimension types mapped to their non-zero exponents.
#
# Build one with +Dimensions.base+ and combine with +*+, +/+ and +^+. To build
# one from a map, use +Dimensions.fromPowers+, which drops zero exponents.
# This is a run-time value; the type checker does not track it.
record Dimension do
  powers : {Type: Integer}
end

# Returns the dimensionless dimension, the identity for +*+.
#
# @return [Dimension] the multiplicative identity
let one -> Dimension = Dimension { powers: {} }

# Returns the base dimension named by the type of +marker+, to the first
# power.
#
# @param marker [A] a value of a dedicated marker type
# @return [Dimension] that base dimension, raised to the first power
let base(marker: A) -> Dimension = Dimension {
  powers: {}.put(Type.of(marker), 1)
}

# Returns the dimension with the given exponents, dropping any that are zero.
#
# @param powers [Map<Type, Integer>] the dimension's exponents
# @return [Dimension] the same dimension with zero exponents removed
let fromPowers(powers: {Type: Integer}) -> Dimension = Dimension {
  powers: powers.filter { |_, exponent| exponent != 0 }
}

make Dimension do
  # Returns +true+ when every base dimension has cancelled out.
  #
  # @return [Bool] +true+ for a dimensionless quantity
  dimensionless? :> Bool
  let dimensionless? = @powers.values.all? { |exponent| exponent == 0 }

  # Returns the exponent of the base dimension named by +marker+'s type, or
  # 0 when it is absent.
  #
  # @param marker [A] a value of the base marker type
  # @return [Integer] the base's exponent
  exponentOf :> A -> Integer
  let exponentOf(marker) = @powers.get(Type.of(marker), 0)

  # Multiplies two dimensions, adding their exponents.
  #
  # @param other [Dimension] the other factor
  # @return [Dimension] the normalized product
  * :> Dimension -> Dimension
  let *(other) do
    let powers = other.powers.entries.reduce(@powers) do |result, entry|
      let (base, exponent) = entry
      result.put(base, result.get(base, 0) + exponent)
    end
    Dimensions.fromPowers(powers)
  end

  # Divides two dimensions, subtracting +other+'s exponents.
  #
  # @param other [Dimension] the denominator's dimension
  # @return [Dimension] the normalized quotient
  / :> Dimension -> Dimension
  let /(other) = this * (other ^ -1)

  # Raises the dimension to an integer power, which may be zero or negative.
  #
  # @param exponent [Integer] the power
  # @return [Dimension] the normalized powered dimension
  ^ :> Integer -> Dimension
  let ^(exponent) = Dimensions.fromPowers(
    @powers.mapValues { |power| power * exponent }
  )
end
