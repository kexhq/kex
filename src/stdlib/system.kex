# The running process and the machine under it: exiting, and asking what
# platform this is.
#
#   System.OS          # => :macos
#   System.posix?      # => true
#   System.exit(1)     # ends the program with status 1
#
# Deliberately NOT a capability, and `OS`/`BITWIDTH` stay pure. Faking the
# reported OS only exercises a program's branching, not the platform behaviour
# behind it: the file semantics, path rules and process handling that
# actually differ are unaffected by the atom. Testing those means running on
# the platform, which CI does across macOS, Ubuntu and Alpine. `Mock.System`
# existed for this and had exactly one caller: the spec that tested it
# (kexhq/kex#143).
module System do
  # The operating system families a program may be running on.
  #
  # A union of atoms rather than an ADT: these are plain tags, and a +match+
  # over them is still exhaustive. Anything unmodelled is +:unknown+: the
  # union is closed, so callers can cover it.
  #
  # @example Branching on the platform
  #   match System.OS do
  #     :windows => "\\"
  #     :unknown => die("unsupported platform")
  #     _        => "/"
  #   end
  type OperatingSystem = :macos | :linux | :windows | :freebsd
    | :openbsd | :netbsd | :wasm | :unknown

  # Ends the process immediately with exit status +code+.
  #
  # The invoking shell receives the code, so this is how a command-line tool
  # reports success or failure to whatever ran it: 0 means success, anything
  # else means failure.
  #
  # Nothing after the call runs, and no cleanup happens: close what needs
  # closing first.
  #
  # @param code [Integer] the exit status
  # @return [Void]
  #
  # @example Failing with a message
  #   IO.printError("config not found")
  #   System.exit(1)
  #
  # @example Reporting a test run's result
  #   System.exit(failures.empty? then 0 else 1)
  exit : Integer -> Void
  foul exit(code) = Kex.Intrinsic.System.exit(code)

  # The operating system family this program is running on.
  #
  # Both backends answer with the same atom for the same machine. Prefer the
  # +macOS?+ / +linux?+ / +windows?+ / +posix?+ predicates below when you are
  # asking one yes-or-no question; use +OS+ when you need to branch several
  # ways.
  #
  # @return [OperatingSystem] the platform tag
  #
  # @example
  #   System.OS   # => :macos
  #
  # @example Choosing a config location per platform
  #   match System.OS do
  #     :macos => "~/Library/Application Support/app"
  #     :linux => "~/.config/app"
  #     _      => "."
  #   end
  OS : OperatingSystem
  let OS = Kex.Intrinsic.System.os()

  # The machine's pointer width in bits: 64 on anything current, 32 on a
  # small target.
  #
  # Reported by the emulator on BEAM and by the pointer size in the tree
  # walker, so both agree for one machine.
  #
  # @return [Integer] the pointer width in bits
  #
  # @example
  #   System.BITWIDTH   # => 64
  BITWIDTH : Integer
  let BITWIDTH = Kex.Intrinsic.System.bitWidth()

  # Returns +true+ when running on macOS.
  #
  # @return [Bool] +true+ on macOS
  #
  # @example
  #   let opener = System.macOS? then "open" else "xdg-open"
  macOS? : Bool
  let macOS? = System.OS == :macos

  # Returns +true+ when running on Linux.
  #
  # @return [Bool] +true+ on Linux
  #
  # @example
  #   if System.linux?
  #     IO.printLine("using /proc")
  #   end
  linux? : Bool
  let linux? = System.OS == :linux

  # Returns +true+ when running on Windows.
  #
  # @return [Bool] +true+ on Windows
  #
  # @example
  #   let separator = System.windows? then "\\" else "/"
  windows? : Bool
  let windows? = System.OS == :windows

  # Returns +true+ when the platform follows POSIX conventions for paths,
  # separators and shell behaviour.
  #
  # Everything the toolchain runs on except Windows behaves POSIX-ly enough
  # for paths, separators and shell conventions. An unknown system is NOT
  # assumed to be POSIX.
  #
  # @return [Bool] +true+ on a POSIX-like platform
  #
  # @example
  #   System.posix?   # => true on macOS and Linux
  #
  # @example Refusing to guess on an unrecognised platform
  #   if !System.posix?
  #     IO.printError("this tool assumes POSIX paths")
  #     System.exit(1)
  #   end
  posix? : Bool
  let posix? = !System.windows? && System.OS != :wasm && System.OS != :unknown
end

# Ends the program with a fatal error message.
#
# +message+ goes to stderr behind a +"fatal: "+ prefix and the exit status is
# 1. This is an abort, not an exception, so +trying+ / +rescue+ cannot catch it.
# Use it only where there is no recoverable answer. The prelude uses it for
# a negative +repeat+ count, for instance.
#
# Its result type is +Never+, the bottom type: +die+ does not return, so a
# branch that dies takes the other branch's type, and
# +if b == 0 then die("divide by zero") else a end+ is an +Integer+.
#
# +die+ is declared bare, like +assert+, so it is always in scope.
#
# @param message [String] the fatal message; omitted for a generic one
# @return [Never] never returns
#
# @example
#   die("unreachable state")   # stderr: fatal: unreachable state
#
# @example Using it in a branch that must produce a value
#   let denominator = if divisor == 0 then die("divide by zero") else divisor end
die : Never
die : String -> Never
let die() -> Never = Kex.Intrinsic.System.die("program terminated")
let die(message: String) -> Never = Kex.Intrinsic.System.die(message)
