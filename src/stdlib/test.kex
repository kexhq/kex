# The built-in test functions: +describe+, +it+, +before+, +after+ and the
# assertions.
#
# They are always in scope and need no separate runner. Write a test file and
# run it with +kex+:
#
#   describe "arithmetic" do
#     it "adds numbers" do
#       assert(1 + 1 == 2)
#     end
#
#     it "multiplies numbers" do
#       Assert.equal(3 * 4, 12)
#     end
#   end
#
#   $ kex my_test.kex
#   arithmetic
#     ✓ adds numbers
#     ✓ multiplies numbers
#
#   2 passed, 0 failed
#
# Output is indented by +describe+ depth. The first failing assertion ends its
# test and marks it failed; the other tests still run.
#
# A file named +<name>.spec.kex+ loads the declarations of +<name>.kex+ beside
# it, so a spec needs no import.

# Groups related test cases under a label and runs them.
#
# The block runs at once. +describe+ blocks nest, and the output is indented
# to match.
#
# @param label [String] what this group is about
# @param block [Block] the tests, and any nested groups
# @return [Void]
#
# @example
#   describe "String" do
#     describe "count" do
#       it "returns the character count" do
#         assert("hello".count == 5)
#       end
#     end
#   end
describe : String -> Block<Result<Void, Any>> -> Void

# Defines a single test case and runs it.
#
# A failed assertion, or anything else that fails inside the block, marks the
# test failed and the rest of the suite carries on. A +.try+ that fails in
# the block fails the test too, so the body needs no +Ok+ or +rescue+.
#
# @param label [String] what this case establishes, phrased as a claim
# @param block [Block] the case body
# @return [Void]
#
# @example
#   it "returns true for even numbers" do
#     assert(2.even?)
#     assert(!3.even?)
#   end
#
# @example One behaviour per case
#   it "trims leading whitespace" do
#     Assert.equal("  hi".trim, "hi")
#   end
#
#   it "trims trailing whitespace" do
#     Assert.equal("hi  ".trim, "hi")
#   end
it : String -> Block<Result<Void, Any>> -> Void

# Registers setup to run before the current group's tests.
#
# +before { ... }+ and +before(:each) { ... }+ run before every test in the
# group; +before(:all) { ... }+ runs once before the group's first test,
# following RSpec's scope convention.
#
# @param block [Block] the setup to run
# @return [Void]
#
# @example
#   describe "the parser" do
#     before do
#       Mock.FS.File("input.txt", "one\ntwo\n")
#     end
#
#     it "reads two lines" do
#       Assert.equal(FS.File.readLines("input.txt").or([]).count, 2)
#     end
#   end
before : Block<Result<Void, Any>> -> Void

# Registers setup with an explicit scope: +:each+ before every test in the
# group, +:all+ once before the first.
#
# Use +:all+ for expensive setup that the tests do not change, and +:each+ for
# anything a test might change.
#
# @param scope [Atom] +:each+ or +:all+
# @param block [Block] the setup to run
# @return [Void]
#
# @example
#   before(:all) do
#     FS.Directory.create("tmp")
#   end
#
#   before(:each) do
#     Mock.ENV.clear()
#   end
before : Atom -> Block<Result<Void, Any>> -> Void

# Registers cleanup to run after the current group's tests.
#
# Runs after every test, whether it passed or failed. Inner groups' hooks run
# before outer ones.
#
# @param block [Block] the cleanup to run
# @return [Void]
#
# @example
#   after do
#     FS.File.delete("tmp/out.txt")
#   end
after : Block<Result<Void, Any>> -> Void

# Registers cleanup with an explicit scope: +:each+ after every test in the
# group, +:all+ once when the group finishes.
#
# @param scope [Atom] +:each+ or +:all+
# @param block [Block] the cleanup to run
# @return [Void]
#
# @example
#   after(:all) do
#     FS.Directory.deleteAll("tmp")
#   end
after : Atom -> Block<Result<Void, Any>> -> Void

# Fails the enclosing +it+ when +value+ is +false+.
#
# The +Assert+ functions are built on it. Prefer them where one fits, since
# their failure message shows the values involved.
#
# @param value [Bool] the condition that must hold
# @return [Bool] the value, when it held
#
# @example
#   assert(42 == 42)
#   assert("hello".count == 5)
assert : Bool -> Bool

# Fails the enclosing +it+ when +value+ is +false+, showing +message+ in the
# failure output.
#
# Phrase the message as what should have been true.
#
# @param value [Bool] the condition that must hold
# @param message [String] what the failure output should say
# @return [Bool] the value, when it held
#
# @example
#   assert("hello".count == 5, "count should be 5")
#   assert(users.any?(~admin?), "at least one user should be an admin")
assert : Bool -> String -> Bool

# Assertions whose failure message shows what was expected and what arrived.
# They are written in Kex on top of +assert+.
#
#   Assert.equal("hi".upperCase, "HI")
#   Assert.some(users.first)
#   Assert.ok(Integer.parse("42"))
module Assert do
  # Fails unless +actual+ equals +expected+, reporting both.
  #
  # Use it by default for comparisons: unlike +assert(a == b)+, a failure
  # shows both values.
  #
  # @param actual [A] the value produced
  # @param expected [A] the value it should equal
  # @return [Bool] +true+ when they are equal
  #
  # @example
  #   Assert.equal("hi".upperCase, "HI")
  #   Assert.equal([1, 2, 3].sum, 6)
  #   Assert.equal(config.get(:port), Just(8080))
  let equal(actual: A, expected: A) -> Bool = assert(actual == expected, "expected ${expected}, got ${actual}")

  # Fails when +actual+ equals +expected+.
  #
  # @param actual [A] the value produced
  # @param expected [A] the value it should differ from
  # @return [Bool] +true+ when they differ
  #
  # @example
  #   Assert.notEqual(newId, oldId)
  let notEqual(actual: A, expected: A) -> Bool = assert(actual != expected, "expected values to differ, both were ${actual}")

  # Fails unless +value+ is truthy: anything except +false+ and +None+.
  #
  # @param value [Truthyable] the value to test
  # @return [Bool] +true+ when the value is truthy
  #
  # @example
  #   Assert.truthy("hello".contains?("ell"))
  let truthy(value: Truthyable) -> Bool = assert(value.truthy?, "expected a truthy value")

  # Fails unless +value+ is falsy: +false+, +None+ or +()+.
  #
  # @param value [Truthyable] the value to test
  # @return [Bool] +true+ when the value is falsy
  #
  # @example
  #   Assert.falsy([].any? { |x| x > 0 })
  let falsy(value: Truthyable) -> Bool = assert(value.falsy?, "expected a falsy value")

  # Fails unless +value+ is a +Just+.
  #
  # @param value [A?] the optional to test
  # @return [Bool] +true+ when a value is present
  #
  # @example
  #   Assert.some([1, 2].first)
  #   Assert.some(config.get(:host))
  let some(value: A?) -> Bool = assert(value.present?, "expected Just, got ${value}")

  # Fails unless +value+ is +None+.
  #
  # @param value [A?] the optional to test
  # @return [Bool] +true+ when there is no value
  #
  # @example
  #   Assert.none([].first)
  #   Assert.none("abc".to(Integer))
  let none(value: A?) -> Bool = assert(value.none?, "expected None, got ${value}")

  # Fails unless +value+ is an +Ok+.
  #
  # @param value [Result<A, E>] the result to test
  # @return [Bool] +true+ when the result succeeded
  #
  # @example
  #   Assert.ok(Integer.parse("42"))
  let ok(value: Result<A, E>) -> Bool = assert(value.ok?, "expected Ok, got ${value}")

  # Fails unless +value+ is an +Error+.
  #
  # @param value [Result<A, E>] the result to test
  # @return [Bool] +true+ when the result failed
  #
  # @example
  #   Assert.error(Integer.parse("4x"))
  let error(value: Result<A, E>) -> Bool = assert(value.error?, "expected Error, got ${value}")
end
