# Test stand-ins for the filesystem, the environment, the clock and the
# console. Networking mocks are under +Mock.Net+.
#
# There are two kinds. The +Mock.FS+, +Mock.ENV+ and +Mock.IO+ modules change
# global state: +Mock.FS.File(path, content)+ puts a file in a store that the
# real +FS.File+ reads from, and it stays there until +clear()+. That lets a
# test write a file and read it back, but it also lets one test see what
# another left behind, so clear the state in an +after+ hook.
#
# The records +Mock.Files+, +Mock.Env+ and +Mock.Clock+ replace a capability
# for one block, as in +with FS.File = Mock.Files { ... } do ... end+. They
# hold no global state and need no clearing.
#
# Everything here is for tests: it is allowed in spec files and the REPL, and
# needs +--allow-mocks+ anywhere else.

# A read hook for +Mock.Files+: returns a path's content, or +None+ for no
# such file.
type Reader = FS.FilePath -> String?

# A lookup hook for +Mock.Env+: returns a variable's value, or +None+ for
# unset.
type Lookup = String -> String?

# A hook for +Mock.Clock+ that returns the current instant.
type Tick = Block<DateTime>

# A write hook for +Mock.Env+, called with the name and value a program set.
#
# Writes under a +Mock.Env+ never reach the real environment, and the record
# cannot change, so this hook is the only way to see them. An +unset+ arrives
# as the name with an empty value. Without a hook, writes are dropped.
type Writer = String -> String -> Void

module Mock do
  # A read-only stand-in for the +FS.File+ capability, for
  # +with FS.File = ...+.
  #
  # It holds no global state and ends with its block. Every write, delete,
  # copy and open fails, so a test that writes a file and reads it back
  # needs +Mock.FS+.
  #
  #   with FS.File = Mock.Files { files: {"kex.toml": "name = \"demo\""} } do
  #     assert(loadConfig() == "demo")
  #   end
  #
  # Set +onRead+ to compute the answer, for example from the path. When it is
  # set, +files+ is not consulted, and its +None+ means no such file.
  record Files do
    # The fixture: a path to its content. A path not listed reads as absent.
    files  : Map<FS.FilePath, String> = {}

    # A function that handles reads in place of +files+. +None+ from it means
    # no such file.
    onRead : Reader? = None
  end

  # A stand-in for the +ENV+ capability, for +with ENV = ...+.
  #
  # A name not in +vars+ reads as unset. Set +onGet+ to compute values
  # instead, and +onSet+ to see what the program writes.
  #
  #   with ENV = Mock.Env { vars: {"HOME": "/fake"} } do
  #     assert(configHome() == "/fake/.config")
  #   end
  record Env do
    # The fixture: a variable name to its value. A name not listed reads as
    # unset.
    vars  : Map<String, String> = {}

    # A function that handles lookups in place of +vars+.
    onGet : Lookup? = None

    # Called with each write. Without it, writes are dropped.
    onSet : Writer? = None
  end

  # A stand-in for the +Time.Clock+ capability, for +with Time.Clock = ...+.
  # Inside the block, +Time.now+, +Date.today+ and +DateTime.utcNow+ read
  # from it.
  #
  #   with Time.Clock = Mock.Clock { at: DateTime.parse("2026-07-30T14:03:00Z").try } do
  #     assert(Date.today().iso == "2026-07-30")
  #   end
  #
  # The clock is frozen at +at+, zone included, so +Date.today()+ is the date
  # in the zone you wrote, not the zone of the machine running the test.
  #
  # A frozen clock makes every measured interval zero. For a clock that runs,
  # set +onNow+: a block uses the clock of the place it was written, so one
  # written outside the +with+ reads the real clock.
  #
  #   with Time.Clock = Mock.Clock { onNow: Just({ DateTime.now() + 3.day }) } do
  #     let started = DateTime.epochNanos()
  #     runTheThing()
  #     assert(DateTime.epochNanos() > started)
  #   end
  record Clock do
    # The instant every reading returns; the Unix epoch by default.
    at    : DateTime = DateTime.fromEpochSeconds(0)

    # A function that returns the time in place of +at+.
    onNow : Tick? = None
  end

  # A global stand-in for the filesystem: files a test declares here are what
  # the real +FS.File+ reads.
  #
  # The store lasts until +clear+, so clear it in an +after+ hook or the next
  # test sees the same files.
  #
  #   describe "the config loader" do
  #     before do
  #       Mock.FS.files({ "app.conf": "port = 8080\n" })
  #     end
  #
  #     after do
  #       Mock.FS.clear()
  #     end
  #
  #     it "reads the port" do
  #       Assert.equal(loadPort(), 8080)
  #     end
  #   end
  module FS do
    # Declares one file and its content.
    #
    # @param path [FS.FilePath] the path the file appears at
    # @param content [String] its contents
    # @return [Void]
    #
    # @example
    #   Mock.FS.File("app.conf", "port = 8080\n")
    File : FS.FilePath -> String -> Void

    # Declares a directory at +path+.
    #
    # @param path [FS.FilePath] the directory to declare
    # @return [Void]
    #
    # @example
    #   Mock.FS.Directory("src")
    Directory : FS.FilePath -> Void

    # Empties the store, removing every file and directory declared so far.
    #
    # Call it in an +after+ hook, since the store is shared by every test.
    #
    # @return [Void]
    #
    # @example
    #   after do
    #     Mock.FS.clear()
    #   end
    clear : Void

    # Declares several files at once, from a map of paths to contents (the
    # shape +Mock.Files+ takes).
    #
    # @param entries [Map<FS.FilePath, String>] paths to their contents
    # @return [Void]
    #
    # @example
    #   Mock.FS.files({
    #     "app.conf": "port = 8080\n",
    #     "hosts":    "localhost\n"
    #   })
    files : Map<FS.FilePath, String> -> Void

    # Serves reads from +reader+ in place of the declared files.
    #
    # Use it when the content depends on the path. While it is set, files
    # declared with +File+ or +files+ are not read, and +None+ from +reader+
    # means no such file.
    #
    # @param reader [Reader] returns a path's content, or +None+
    # @return [Void]
    #
    # @example Every .txt path has content, nothing else exists
    #   Mock.FS.onRead do |path|
    #     path.endsWith?(".txt") then Just("stub") else None
    #   end
    onRead : Reader -> Void

    foul files(entries: Map<FS.FilePath, String>) -> Void do
      return Kex.Intrinsic.FS.files(entries)
    end

    foul onRead(reader: Reader) -> Void do
      return Kex.Intrinsic.FS.onRead(reader)
    end

    foul File(path: FS.FilePath, content: String) -> Void do
      return Kex.Intrinsic.FS.file(path, content)
    end

    foul Directory(path: FS.FilePath) -> Void do
      return Kex.Intrinsic.FS.directory(path)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.FS.clear()
    end
  end

  # A global overlay on the process environment, so a test decides what
  # +ENV+ holds.
  #
  # The overlay lasts until +clear+, so clear it in an +after+ hook.
  #
  #   Mock.ENV.vars({ "HOME": "/fake", "LOG_LEVEL": "debug" })
  #   assert(configPath() == "/fake/.config")
  #   Mock.ENV.clear()
  module ENV do
    # Sets one variable in the overlay.
    #
    # @param name [String] the variable name
    # @param value [String] its value
    # @return [Void]
    #
    # @example
    #   Mock.ENV.set("LOG_LEVEL", "debug")
    set : String -> String -> Void

    # Makes a variable read as unset, whatever the real environment holds.
    #
    # @param name [String] the variable to remove
    # @return [Void]
    #
    # @example Testing the unset path
    #   Mock.ENV.unset("HOME")
    #   Assert.equal(configPath(), ".")
    unset : String -> Void

    # Removes the whole overlay, restoring the real environment.
    #
    # @return [Void]
    #
    # @example
    #   after do
    #     Mock.ENV.clear()
    #   end
    clear : Void

    # Declares the whole overlay in one call.
    #
    # To compute values per lookup, use +with ENV = Mock.Env { onGet: ... }+.
    #
    # @param entries [Map<String, String>] variable names to their values
    # @return [Void]
    #
    # @example
    #   Mock.ENV.vars({ "HOME": "/fake", "LOG_LEVEL": "debug" })
    vars : Map<String, String> -> Void

    foul vars(entries: Map<String, String>) -> Void do
      return Kex.Intrinsic.Env.mockVars(entries)
    end

    foul set(name: String, value: String) -> Void do
      return Kex.Intrinsic.Env.mockSet(name, value)
    end

    foul unset(name: String) -> Void do
      return Kex.Intrinsic.Env.mockUnset(name)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.Env.mockClear()
    end
  end

  # A global stand-in for the console: it captures what a program prints and
  # feeds it lines as if they had been typed.
  #
  #   Mock.IO.start()
  #   Mock.IO.input("Ada", "42")
  #   greet()
  #   Assert.equal(Mock.IO.output(), "hello, Ada\n")
  #   Mock.IO.stop()
  module IO do
    # Starts capturing output and serving queued input.
    #
    # @return [Void]
    #
    # @example
    #   before do
    #     Mock.IO.start()
    #   end
    foul start() -> Void do
      return Kex.Intrinsic.IO.ioMockStart()
    end

    # Stops capturing, and restores the real console.
    #
    # @return [Void]
    #
    # @example
    #   after do
    #     Mock.IO.stop()
    #   end
    foul stop() -> Void do
      return Kex.Intrinsic.IO.ioMockStop()
    end

    # Returns everything the program has printed since capturing started.
    #
    # Newlines are included, so a single +IO.printLine("hi")+ gives
    # +"hi\n"+.
    #
    # @return [String] the captured output
    #
    # @example
    #   Mock.IO.start()
    #   IO.printLine("hello")
    #   Assert.equal(Mock.IO.output(), "hello\n")
    foul output() -> String do
      return Kex.Intrinsic.IO.ioMockOutput()
    end

    # Discards the output captured so far and keeps capturing.
    #
    # Use it between phases of a test when only the later output matters.
    #
    # @return [Void]
    #
    # @example
    #   setUpNoisily()
    #   Mock.IO.clear()
    #   theThingUnderTest()
    #   Assert.equal(Mock.IO.output(), "done\n")
    foul clear() -> Void do
      return Kex.Intrinsic.IO.ioMockClear()
    end

    # Queues the lines +IO.getLine+ will return, in order.
    #
    # Takes a list, or up to four lines as separate arguments. Calls add to
    # the queue. Once it is empty, +IO.getLine+ returns +None+ and
    # +IO.readLine+ returns +Ok(None)+, as at the end of real input.
    #
    # @param lines [String | [String]] the lines to serve, in order (one line, or a list of them)
    # @return [Void]
    #
    # @example A list of lines
    #   Mock.IO.input(["Ada", "42"])
    #
    # @example The same, as separate arguments
    #   Mock.IO.input("Ada", "42")
    foul input(lines: String | [String]) -> Void do
      return Kex.Intrinsic.IO.ioMockInput(lines)
    end

    foul input(first: String, second: String) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second])
    end

    foul input(first: String, second: String, third: String) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third])
    end

    foul input(first: String, second: String, third: String, fourth: String) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third, fourth])
    end
  end

  make Files, implement: FS.File do
    # Named apart from `read`: `this.read(path)` would bind to the
    # capability's own `read : FilePath -> String?`, not to this function.
    foul cannedRead(path: FS.FilePath) -> String? = match @onRead do
      Just(reader) => reader(path)
      None         => @files.get(path)
    end

    foul read(path) = match this.cannedRead(path) do
      Just(content) => Ok(content)
      None => Error(FS.ReadFailed(path))
    end
    foul readBytes(path) = match this.cannedRead(path) do
      Just(content) => Ok(content.to(Binary).try)
      None => Error(FS.ReadFailed(path))
    end
    foul readLines(path) = match this.cannedRead(path) do
      Just(content) => Ok(content.lines)
      None => Error(FS.ReadFailed(path))
    end
    foul feed(path) = match this.cannedRead(path) do
      Just(content) => Ok(Feed.Elements(content.lines))
      None => Error(FS.ReadFailed(path))
    end
    foul size(path) = match this.cannedRead(path) do
      Just(content) => Ok(content.bytes.count)
      None => Error(FS.ReadFailed(path))
    end
    foul exists?(path) = this.cannedRead(path) != None
    foul file?(path) = this.cannedRead(path) != None
    foul directory?(path) = false
    foul absolute(path) = Ok(path)
    foul canonical(path) = match this.cannedRead(path) do
      Just(_) => Ok(path)
      None => Error(FS.ReadFailed(path))
    end
    foul symlink?(path) = false
    foul info(path) = match this.cannedRead(path) do
      Just(content) => Ok(FS.FileInfo { kind: :file, size: content.bytes.count, modified: DateTime.fromEpochSeconds(0) })
      None => Error(FS.ReadFailed(path))
    end

    # A fake is a value, so there is nowhere for a write to go. Failing lets a
    # test that did not expect a write notice it.
    foul open(path, mode) = Error(FS.OpenFailed(path))
    # The block form fails the same way and never runs the block. FS.File
    # requires it (#793).
    foul open(path, mode, block) = Error(FS.OpenFailed(path))
    foul write(path, content) = Error(FS.WriteFailed(path))
    foul writeBytes(path, content) = Error(FS.WriteFailed(path))
    foul append(path, content) = Error(FS.WriteFailed(path))
    foul delete(path) = Error(FS.DeleteFailed(path))
    foul copy(src, dst) = Error(FS.CopyFailed(src, dst))
    foul rename(src, dst) = Error(FS.RenameFailed(src, dst))
    foul changePermission(path, permissions) = Error(FS.ModeFailed(path))
    foul changeMode(path, mode) = Error(FS.ModeFailed(path))
  end

  make Env, implement: ENV do
    # Named apart from `get`: `this.get(key)` would bind to the capability's
    # own `get`, not to this function.
    foul lookup(key: String) -> String? = match @onGet do
      Just(reader) => reader(key)
      None         => @vars.get(key)
    end

    foul get(key) = this.lookup(key)
    foul get(key, default) = this.lookup(key).or(default)
    foul has?(key) = this.lookup(key) != None
    foul keys = @vars.keys
    foul values = @vars.values
    foul count = @vars.count
    foul each(f) = @vars.each(f)
    foul entries = @vars.entries

    # A write goes to `onSet` or is dropped. It must not reach the real
    # environment, where it would leak into later tests and into every process
    # the suite starts, and `vars` cannot change.
    foul set(name, value) = match @onSet do
      Just(writer) => writer(name, value)
      None         => ()
    end
    foul unset(name) = match @onSet do
      Just(writer) => writer(name, "")
      None         => ()
    end
  end

  make Clock, implement: Time.Clock do
    foul now() = match @onNow do
      Just(rule) => rule()
      None       => @at
    end
  end

  # Scripted inputs for testing HTTP, DNS, sockets and WebSockets.
  module Net do
    # Scripted HTTP responses.
    module HTTP do
      # Responses a scripted transport returns, in order.
      record Transport do
        responses : [Any]
      end
    end

    # Scripted DNS answers.
    module DNS do
      # The addresses each hostname resolves to.
      record ResolverScript do
        answers : {String: [String]}
      end
    end

    # Scripted socket data.
    module Socket do
      # Chunks delivered in order as incoming socket data.
      record Script do
        incoming : [Binary]
      end
    end

    # Scripted WebSocket messages.
    module WebSocket do
      # Messages a scripted connection delivers, in order.
      record Script do
        incoming : [Any]
      end
    end
  end

end
