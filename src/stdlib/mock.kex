# Mock — deterministic stand-ins for the world outside the program: the
# filesystem, the network, the environment, the console.
#
# These are STATEFUL: `Mock.FS.File(path, content)` writes into a store the
# real `FS.File` then reads back, so a test can write and read again, and
# `clear()` undoes it. That state is global and lives until cleared, which is
# what makes hook ordering and write/read round trips testable — and also what
# makes two tests able to interfere.
#
# When a test only needs canned ANSWERS, replacing the capability is the
# better tool: `with FS.File = MyFake { ... } do ... end` swaps the
# implementation for one lexical region, holds no global state, needs no
# clearing, and cannot leak into another test. See spec/capability_stdlib_fs.kex
# for the shape of a stand-in (kexhq/kex#143).
#
# Opt-in on purpose (issue #144): this module used to ride along inside
# http.kex, so `using HTTP` in the prelude made every Mock.* reachable from
# every program without anyone asking for it. Reachable is still not
# callable — the runtime denies the mock intrinsics outside spec files, the
# REPL, and --allow-mocks — but it should also not be in scope by accident.
# A qualified `Mock.FS.File(...)` auto-loads this file like any other
# opt-in module.
#
# All Mock.* sub-modules live in a single `module Mock` block so merged
# compilation units never see duplicate top-level `Mock` modules.
# A stand-in's read hook: a path in, its content or `None` out.
type Reader = FS.FilePath -> String?

# An environment stand-in's lookup hook: a name in, its value or `None` out.
type Lookup = String -> String?

# An environment stand-in's WRITE hook: the name and the value a program set.
# A `Mock.Env` is an immutable record, so a write cannot land in its `vars` —
# and it must not reach the real environment, or a test would leak a variable
# into the next one and into anything the suite starts. The hook is how a test
# observes the write instead: record it, assert on it, or ignore it, which is
# what `None` does.
type Writer = String -> String -> Void

module Mock do
  # A stand-in for the `FS.File` capability, for `with FS.File = ...`. Unlike
  # the `Mock.*` functions below it holds no global state, needs no `clear()`,
  # and cannot leak past its block. What it cannot do is change: `write` then
  # `read` back is not something a value does, so a test needing that round
  # trip still wants `Mock.FS` (kexhq/kex#143).
  #
  #   with FS.File = Mock.Files { files: {"kex.toml": "name = \"demo\""} } do
  #     assert(loadConfig() == "demo")
  #   end
  #
  # `onRead` takes over when a test needs an ANSWER rather than a fixture —
  # content derived from the path, a failure on the third call, a record of
  # what was asked for. It is consulted first and its `None` means "no such
  # file", so a callback can model absence too.
  record Files do
    files  : Map<FS.FilePath, String> = {}
    onRead : Reader? = None
  end

  # A stand-in for the `ENV` capability. A name simply left out of `vars` reads
  # as unset, which is the whole reason `Mock.ENV.unset` exists — absence is an
  # answer programs act on. `onGet` answers instead of the map when a test
  # wants a rule rather than a fixture.
  #
  #   with ENV = Mock.Env { vars: {"HOME": "/fake"} } do
  #     assert(configHome() == "/fake/.config")
  #   end
  record Env do
    vars  : Map<String, String> = {}
    onGet : Lookup? = None
    onSet : Writer? = None
  end

  # A stand-in for the `Http` capability: one canned response for every
  # request, whatever the verb, URL or body. That is what a client test needs,
  # being about what the program does WITH a response.
  #
  # NOT named `Http`: a record of that name is indistinguishable from the
  # capability itself at a call site, and the `make` block binds to the
  # capability rather than the record — every request then reaches the real
  # network while the test looks like it is faking one.
  record Response do
    status  : Integer
    body    : String
    headers : Map<String, String> = {}
  end

  module FS do
    File : FS.FilePath -> String -> Void
    Directory : FS.FilePath -> Void
    clear : Void

    # The whole fixture in one call, the same shape `Mock.Files { files: ... }`
    # takes — one line instead of one per file (kexhq/kex#143).
    files : Map<FS.FilePath, String> -> Void

    # Answer reads by RULE rather than from a fixture: content derived from
    # the path, a failure on the third call, a record of what was asked for.
    # Consulted before the map, and returning `None` means "no such file", so
    # absence is expressible too.
    onRead : Reader -> Void

    foul files(entries: Map<FS.FilePath, String>) -> Void do
      return Kex.Intrinsic.FS.files(entries)
    end

    foul onRead(reader: Reader) -> Void do
      return Kex.Intrinsic.FS.onRead(reader)
    end

    foul File(path: FS.FilePath, content: String) -> Void do
      return Kex.Intrinsic.FS.file(path, content)
    end

    foul Directory(path: FS.FilePath) -> Void do
      return Kex.Intrinsic.FS.directory(path)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.FS.clear()
    end
  end

  module Http do
    start   : Void
    respond : Integer -> String -> Void
    respond : Integer -> String -> Map<String, String> -> Void
    stop    : Void

    foul start() -> Void do
      return Kex.Intrinsic.Http.mockStart()
    end

    foul respond(status: Integer, body: String) -> Void do
      return Kex.Intrinsic.Http.mockRespond(status, body)
    end

    foul respond(status: Integer, body: String, headers: Map<String, String>) -> Void do
      return Kex.Intrinsic.Http.mockRespond(status, body, headers)
    end

    foul stop() -> Void do
      return Kex.Intrinsic.Http.mockStop()
    end
  end

  # Overlays the process environment, so a test can say what `ENV` holds
  # instead of depending on how it was launched. `unset` is separate because
  # a variable being ABSENT is an answer programs act on.
  module ENV do
    set : String -> String -> Void
    unset : String -> Void
    clear : Void

    # The whole overlay in one call, the same shape `Mock.Env { vars: ... }`
    # takes (kexhq/kex#143). There is no `onGet` here: global `ENV` is a
    # materialised Map, so there is nothing for a callback to intercept — use
    # `with ENV = Mock.Env { onGet: ... }` when a rule is what you want.
    vars : Map<String, String> -> Void

    foul vars(entries: Map<String, String>) -> Void do
      return Kex.Intrinsic.Env.mockVars(entries)
    end

    foul set(name: String, value: String) -> Void do
      return Kex.Intrinsic.Env.mockSet(name, value)
    end

    foul unset(name: String) -> Void do
      return Kex.Intrinsic.Env.mockUnset(name)
    end

    foul clear() -> Void do
      return Kex.Intrinsic.Env.mockClear()
    end
  end

  module IO do
    foul start() -> Void do
      return Kex.Intrinsic.IO.ioMockStart()
    end

    foul stop() -> Void do
      return Kex.Intrinsic.IO.ioMockStop()
    end

    foul output() -> String do
      return Kex.Intrinsic.IO.ioMockOutput()
    end

    foul clear() -> Void do
      return Kex.Intrinsic.IO.ioMockClear()
    end

    foul input(lines) -> Void do
      return Kex.Intrinsic.IO.ioMockInput(lines)
    end

    foul input(first, second) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second])
    end

    foul input(first, second, third) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third])
    end

    foul input(first, second, third, fourth) -> Void do
      return Kex.Intrinsic.IO.ioMockInput([first, second, third, fourth])
    end
  end

  make Files, implement: FS.File do
    # Named apart from `read`: `this.read(path)` would bind to the
    # capability's own `read : FilePath -> String?`, not to this method.
    foul cannedRead(path) = match @onRead do
      Just(reader) => reader(path)
      None         => @files.get(path)
    end

    foul read(path) = this.cannedRead(path)
    foul readLines(path) = this.cannedRead(path).map { |content| content.lines }
    foul feed(path) = this.cannedRead(path).map { |content| content.lines }
    foul size(path) = this.cannedRead(path).map { |content| content.bytes.count }
    foul exists?(path) = this.cannedRead(path) != None
    foul file?(path) = this.cannedRead(path) != None
    foul directory?(path) = false
    foul absolute(path) = Just(path)

    # A fake is a value, so there is nowhere for a write to go. Refusing is
    # the honest answer and the useful one: a test that did not expect a
    # write sees it fail rather than silently succeed.
    foul open(path, mode) = Error(OpenFailed(path))
    foul write(path, content) = false
    foul append(path, content) = false
    foul delete(path) = false
    foul copy(src, dst) = false
    foul rename(src, dst) = false
  end

  make Env, implement: ENV do
    # Named apart from `get`: `this.get(key)` would bind to the capability's
    # own `get`, not to this method.
    foul lookup(key) = match @onGet do
      Just(reader) => reader(key)
      None         => @vars.get(key)
    end

    foul get(key) = this.lookup(key)
    foul get(key, default) = this.lookup(key).or(default)
    foul has?(key) = this.lookup(key) != None
    foul keys = @vars.keys
    foul values = @vars.values
    foul count = @vars.count
    foul each(f) = @vars.each(f)
    foul entries = @vars.entries

    # A write goes to `onSet` or nowhere. It must NOT reach the real
    # environment: a substituted ENV is the whole point of the mock, and a
    # test that set a variable would otherwise leak it into the next one and
    # into every process the suite starts. `vars` cannot take it either — a
    # record is immutable — so a test that cares about writes supplies the
    # hook, and one that does not gets a write that goes quietly nowhere.
    foul set(name, value) = match @onSet do
      Just(writer) => writer(name, value)
      None         => ()
    end
    foul unset(name) = match @onSet do
      Just(writer) => writer(name, "")
      None         => ()
    end
  end

  make Response, implement: Http do
    # The one canned response, built once and returned for every request.
    let canned = Ok(HttpResponse {
      status:  @status,
      body:    @body,
      headers: @headers
    })

    foul get(url) = this.canned
    foul get(url, opts) = this.canned
    foul post(url, body) = this.canned
    foul post(url, body, opts) = this.canned
    foul put(url, body) = this.canned
    foul put(url, body, opts) = this.canned
    foul patch(url, body) = this.canned
    foul patch(url, body, opts) = this.canned
    foul delete(url) = this.canned
    foul delete(url, opts) = this.canned
    foul head(url) = this.canned
    foul head(url, opts) = this.canned
    foul options(url) = this.canned
    foul options(url, opts) = this.canned
  end
end
