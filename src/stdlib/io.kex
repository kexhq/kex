# Console input and output.
#
# +IO+ is a capability: its functions act on the outside world, so only
# +foul+ code and +main+ can call them. The exception is +inspect+, which
# writes a debugging view of a value and returns the value, so it can go in
# the middle of a chain.
#
#   main do
#     IO.print("name? ")
#     let name = IO.getLine.or("world")
#     IO.printLine("hello, ${name.trim}")
#   end
capability IO do
  # Writes +msg+ to stdout followed by a newline.
  #
  # Any +Showable+ value prints through its +show+, so numbers, lists, maps
  # and records need no conversion. With no argument it prints an empty line.
  #
  # @param msg [Showable] the value to write
  # @return [Void]
  #
  # @example Printing values of different types
  #   IO.printLine("hello")        # prints: hello
  #   IO.printLine(42)             # prints: 42
  #   IO.printLine([1, 2, 3])      # prints: [1, 2, 3]
  #   IO.printLine                 # prints an empty line
  #
  # @example Interpolating values into the line
  #   let user = "ada"
  #   IO.printLine("logged in as ${user}")   # prints: logged in as ada
  printLine : Showable -> Void
  foul printLine(msg: Showable) = Kex.Intrinsic.IO.printLine(msg.showValue)
  foul printLine = Kex.Intrinsic.IO.printLine("")

  # Writes +msg+ to stdout without a newline.
  #
  # Use it to build a line from several pieces, or to print a prompt that the
  # answer is typed next to.
  #
  # @param msg [Showable] the value to write
  # @return [Void]
  #
  # @example Building one line from several writes
  #   IO.print("hello ")
  #   IO.print("world")
  #   IO.printLine         # stdout: hello world
  #
  # @example A prompt the answer is typed next to
  #   IO.print("continue? [y/N] ")
  #   let answer = IO.getLine.or("n")
  print : Showable -> Void
  foul print(msg: Showable) = Kex.Intrinsic.IO.print(msg.showValue)
  foul print = Kex.Intrinsic.IO.print("")

  # Writes a colored rendering of +val+ and its type to stderr, and returns
  # +val+ unchanged.
  #
  # Since it returns its argument, +inspect+ can be put in the middle of a
  # chain to see what passes through, and taken out again later. It writes to
  # stderr, so a program's piped stdout stays clean. The type checker treats
  # it as pure, so pure functions can call it too.
  #
  # To get the rendering as a +String+, use +inspected+.
  #
  # @param val [A] any inspectable value
  # @return [A] +val+, unchanged
  #
  # @example Watching an intermediate step of a chain
  #   [1, 2, 3, 4]
  #     .map { |n| n * 3 }
  #     .inspect             # stderr: [3, 6, 9, 12] : [Integer]
  #     .filter(~even?)      # => [6, 12]
  #
  # @example The rendering carries the value's type
  #   IO.inspect("hi")     # stderr: "hi" : String
  #   IO.inspect((1..4))   # stderr: 1..4 : Range
  inspect : A -> A
  let inspect(val: Inspectable) do
    Kex.Intrinsic.IO.inspectRendered(
      val,
      val.inspectValue(Console.enabled?)
    )
    return val
  end

  # Reads one line from stdin, without its line ending.
  #
  # Returns +None+ at the end of the input and also when the read fails,
  # which is usually what interactive code wants. Use +IO.readLine+ to tell
  # the two apart. Same as +IO.in.getLine+.
  #
  # @return [String?] the line, or +None+ at end of input or on failure
  #
  # @example Reading an answer with a default
  #   let answer = IO.getLine.or("")
  getLine : String?
  foul getLine do
    match Kex.Intrinsic.FileHandle.readLine(Kex.Intrinsic.IO.stdin) do
      Ok(value) => return value
      Error(_) => return None
    end
  end

  # Reads one line from stdin, without its line ending, and reports a failed
  # read as an error.
  #
  # Returns +Ok(None)+ at the end of the input, and an +Error+ only when the
  # input cannot be read as text. Same as +IO.in.readLine+.
  #
  # @return [Result<String?, ReadError>] the line, +Ok(None)+ at end of input,
  #   or why it could not be read
  #
  # @example Copying stdin to stdout line by line
  #   foul echoAll -> Void do
  #     match IO.readLine do
  #       Ok(Just(line)) => do
  #         IO.printLine(line)
  #         echoAll
  #       end
  #       Ok(None) => ()
  #       Error(e) => IO.printError("cannot read stdin: ${e}")
  #     end
  #   end
  readLine : Result<String?, ReadError>
  foul readLine = Kex.Intrinsic.FileHandle.readLine(Kex.Intrinsic.IO.stdin)

  # Reads one character from stdin, as a one-character +String+.
  #
  # Same as +IO.in.getChar+.
  #
  # @return [String?] the character, or +None+ at end of input or on failure
  #
  # @example
  #   let key = IO.getChar.or("")
  #   IO.printLine("you pressed ${key}")
  getChar : String?
  foul getChar do
    match Kex.Intrinsic.FileHandle.getChar(Kex.Intrinsic.IO.stdin) do
      Ok(value) => return value
      Error(_) => return None
    end
  end

  # Writes +msg+ to stderr followed by a newline.
  #
  # Diagnostics go to stderr so that the program's output on stdout can be
  # piped or redirected on its own. It only prints; the program keeps running.
  #
  # @param msg [Showable] the message to write
  # @return [Void]
  #
  # @example Reporting a problem without exiting
  #   IO.printError("config file not found: using defaults")
  #
  # @example Keeping stdout for the result
  #   IO.printError("scanning ${dir}...")   # progress, on stderr
  #   IO.printLine(results.join("\n"))      # the output, on stdout
  printError : Showable -> Void
  foul printError(msg: Showable) = Kex.Intrinsic.IO.printError(msg.showValue)
  foul printError = Kex.Intrinsic.IO.printError("")

  # Standard output, as a handle.
  #
  # +IO.printLine(x)+ and +IO.out.printLine(x)+ both write to stdout. The
  # handle is for passing to a function that takes a +Writable+, so the caller
  # chooses where it writes. +IO.error+ and +IO.in+ are the other two standard
  # streams.
  #
  # The handle types say what each stream allows: writing to +IO.in+ or
  # reading from +IO.out+ is a compile error, as it is for a file opened
  # +Read+.
  #
  # Getting a handle is pure; reading or writing through it is +foul+.
  # +Mock.IO+ captures writes made through +IO.out+ as well as through
  # +IO.printLine+, but a +with IO = ...+ override replaces only calls to the
  # +IO+ functions.
  #
  # @return [FileHandle<CannotRead, CanWrite>] standard output, as a +Writable+
  #
  # @example Letting the caller choose where a report goes
  #   foul report(out: Writable, lines: [String]) -> Void do
  #     lines.each { |line| out.printLine(line) }
  #   end
  #
  #   report(IO.out, results)
  #   report(IO.error, warnings)
  #   report(FS.File.open("report.txt", FS.Write).try, results)
  out : FileHandle<CannotRead, CanWrite>
  let out = Kex.Intrinsic.IO.stdout

  # Standard error, as a handle: where +IO.printError+ writes.
  #
  # @return [FileHandle<CannotRead, CanWrite>] standard error, as a +Writable+
  #
  # @example
  #   IO.error.printLine("config file not found")
  error : FileHandle<CannotRead, CanWrite>
  let error = Kex.Intrinsic.IO.stderr

  # Standard input, as a handle: where +IO.getLine+, +IO.readLine+ and
  # +IO.getChar+ read from.
  #
  # @return [FileHandle<CanRead, CannotWrite>] standard input, as a +Readable+
  #
  # @example One function for reading a file or a pipe
  #   foul firstLine(source: Readable) -> String do
  #     source.getLine.or("(empty)")
  #   end
  #
  #   firstLine(IO.in)
  in : FileHandle<CanRead, CannotWrite>
  let in = Kex.Intrinsic.IO.stdin
end
