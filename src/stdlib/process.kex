# Processes, tasks and external commands.
#
# Kex's concurrency is the BEAM's: lightweight processes that share nothing
# and talk by sending messages. This file has three parts.
#
# +Task+ runs one piece of work in another process and hands back its result:
#
#   let a = Task.start do expensiveThing(1) end
#   let b = Task.start do expensiveThing(2) end
#   (a.await, b.await)
#
# +serving+ with +Process.spawn+ gives a piece of state its own process, with
# typed calls into it:
#
#   record RateLimiter do
#     remaining : Integer
#   end
#
#   serving RateLimiter do
#     slot allowed? -> Reply<Bool> do
#       let allowed = @remaining > 0
#       new.remaining = allowed then @remaining - 1 else @remaining
#       return { new, reply: allowed }
#     end
#   end
#
#   let api = Process.spawn(RateLimiter { remaining: 2 })
#   api.allowed?()   # => Ok(true)
#
# +Process.run+ and +Process.stream+ run an external program:
#
#   Process.run("git", ["rev-parse", "HEAD"])

# A handle on work running in another process, whose result you can await.
#
# Created by +Task.start+.
type Task<A>

# A monitor reference, returned by +monitor+ and passed back to +demonitor+.
type Reference

# A process: what +spawn+ makes, what +Process.self+ returns, and what
# +Process.whereIs+ finds. +A+ is the type of message it accepts, and sending
# it anything else is a type error. A process obtained without a declared
# message type takes its +A+ from where it is used (`Ping(Process.self)` where
# a +Process<String>+ is expected).
type Process<A>

# Why a process ended. The BEAM allows any term as an exit reason, so this is
# +Any+; the usual ones are `:normal`, `:shutdown` and application error
# values.
type ProcessExitReason = Any

# What a synchronous +slot+ returns: the reply for the caller, and optionally a
# new state and a reason to stop.
#
# `reply` goes back to the caller at once. A slot may leave it out only when it
# answers later with `from.reply(...)`. `new` is the next state; leave it out
# to keep the current one. `stop` ends the server after the transition. Inside
# a `serving X` block the checker narrows `new` from `Any?` to `X?`.
#
#   slot allowed? -> Reply<Bool> do
#     let allowed = @remaining > 0
#     new.remaining = allowed then @remaining - 1 else @remaining
#     return { new, reply: allowed }
#   end
#
#   slot stop -> Reply<Integer> = { stop: :normal, reply: @remaining }
record Reply<A> do
  # The value sent back to the caller.
  reply : A

  # The state the server continues with. Omitted, the current state is kept.
  new : Any? = None

  # A reason to stop the server after this transition. Omitted, it keeps
  # running.
  stop : ProcessExitReason? = None
end

# A caller still waiting for its reply, for a slot that answers later. Call
# +reply+ on it when the answer is ready.
type From<A>

# Why a call into a server failed: it timed out, the process is gone, or it
# crashed while handling the call.
type CallError = Timeout | NoProcess | CallFailed

# A running server and the default timeout for calls into it.
#
# Returned by +Process.spawn+. Each +slot+ in the type's +serving+ block
# becomes a function on this +Server+ that returns a +Result+.
record Server<X> do
  # The underlying typed process handle.
  process : Process<X>

  # How long a call waits for a reply, in milliseconds. +within+ gives a copy
  # of the handle with a different value.
  timeout : Integer = 5000
end

# Spawning servers, running external commands, and operations on the calling
# process.
module Process do
  # Starts a process running the +serving+ block of +state+'s type, with
  # +state+ as its initial state, and returns a handle on it.
  #
  # Each +slot+ in the +serving+ block becomes a function on the returned
  # +Server+. Each returns a +Result+, because a call can time out or find the
  # process gone.
  #
  # @param state [X] the server's initial state
  # @return [Server<X>] a handle on the running server
  #
  # @example
  #   let api = Process.spawn(RateLimiter { remaining: 2 })
  #   api.allowed?()   # => Ok(true)
  #   api.allowed?()   # => Ok(true)
  #   api.allowed?()   # => Ok(false)
  #   api.stop()
  spawn : X -> Server<X>
  foul spawn(state) = Kex.Intrinsic.Process.spawn(state)

  # Runs an executable with a list of arguments and captures its output.
  #
  # No shell is involved: nothing is glob-expanded or split on spaces, and an
  # argument containing spaces needs no quoting. Output is read as UTF-8.
  #
  # A non-zero exit status is still +Ok+; check +exitCode+ on the result.
  # +Error+ means the program could not be started at all.
  #
  # @param command [String] the executable to run
  # @param args [[String]] its arguments, one per element
  # @return [Result<ProcessResult, String>] the captured result, or why it could not start
  #
  # @example
  #   match Process.run("echo", ["hello"]) do
  #     Ok(r)    => IO.printLine(r.stdout.trim)   # prints: hello
  #     Error(e) => IO.printError(e)
  #   end
  #
  # @example A non-zero status is still Ok
  #   Process.run("false", [])   # => Ok(ProcessResult { exitCode: 1, ... })
  #
  # @example A command that does not exist is an Error
  #   Process.run("no-such-command", [])   # => Error("executable not found: no-such-command")
  #
  # @example Reading a command's output as data
  #   Process.run("git", ["rev-parse", "HEAD"])
  #     .map { |r| r.stdout.trim }
  #     .or("unknown")
  run : String -> [String] -> Result<ProcessResult, String>
  foul run(command, args) = Kex.Intrinsic.Process.run(command, args)

  # Runs an executable like +run+, and kills it if it is still running after
  # +timeoutMs+ milliseconds.
  #
  # On timeout the child's process group gets SIGTERM, then SIGKILL after a
  # short grace period, so anything the child forked dies with it. The call
  # then returns +Error("timed out after <n>ms")+ and none of the output.
  #
  # A child that finishes in time gives the same result as +run+, and a missing
  # program fails at once with +executable not found: <command>+.
  #
  # @param command [String] the executable to run
  # @param args [[String]] its arguments, one per element
  # @param timeoutMs [Integer] milliseconds before the child is killed
  # @return [Result<ProcessResult, String>] the captured result, or why it
  #   could not start or that it timed out
  #
  # @example
  #   match Process.run("sleep", ["30"], 300) do
  #     Error(error) => IO.printLine(error)   # prints: timed out after 300ms
  #     Ok(result) => IO.printLine(result.exitCode)
  #   end
  run : String -> [String] -> Integer -> Result<ProcessResult, String>
  foul run(command, args, timeoutMs) = Kex.Intrinsic.Process.run(command, args, timeoutMs)

  # Runs an executable connected to the caller's stdin, stdout and stderr, and
  # returns its exit code.
  #
  # Output appears as the program writes it, and a program that reads the
  # terminal (a REPL, a password prompt) can. Nothing is captured; use +run+
  # when you need the output as a string.
  #
  # @param command [String] the executable to run
  # @param args [[String]] its arguments, one per element
  # @return [Result<Integer, String>] the exit code, or why it could not start
  #
  # @example Watching a build as it runs
  #   match Process.stream("make", ["-j8"]) do
  #     Ok(0)    => IO.printLine("build succeeded")
  #     Ok(code) => IO.printError("build failed with ${code}")
  #     Error(e) => IO.printError(e)
  #   end
  stream : String -> [String] -> Result<Integer, String>
  foul stream(command, args) = Kex.Intrinsic.Process.stream(command, args)

  # Runs an executable and returns its exit code, discarding its output.
  #
  # A command that could not be started gives +127+, the shell's code for
  # "command not found". Use +run+ when you need the output or must tell a
  # failed start from a failed run.
  #
  # @param command [String] the executable to run
  # @param args [[String]] its arguments, one per element
  # @return [Integer] the exit code, or +127+ if it could not start
  #
  # @example
  #   Process.exec("true", [])              # => 0
  #   Process.exec("false", [])             # => 1
  #   Process.exec("no-such-command", [])   # => 127
  #
  # @example Testing for a tool's presence
  #   let haveGit = Process.exec("git", ["--version"]) == 0
  exec : String -> [String] -> Integer
  foul exec(command, args) = match Process.run(command, args) do
    Ok(result) => result.exitCode
    Error(_) => 127
  end

  # Returns the calling process.
  #
  # @return [Process<A>] this process
  #
  # @example Telling another process where to answer
  #   worker.send((Process.self, :ping))
  self : Process<A>
  foul self = Kex.Intrinsic.Process.self

  # Sends an exit signal carrying +reason+ to +pid+.
  #
  # +:normal+ is the usual shutdown reason; +:kill+ cannot be trapped.
  #
  # @param pid [Process<A>] the process to signal
  # @param reason [X] the exit reason
  # @return [Void]
  #
  # @example
  #   Process.exit(worker, :shutdown)
  exit : Process<A> -> X -> Void
  foul exit(pid, reason) = Kex.Intrinsic.Process.exit(pid, reason)

  # Registers +process+ under the atom +name+, so other processes can find it
  # with +whereIs+.
  #
  # @param process [Process<X>] the process to register
  # @param name [Atom] the name to register it under
  # @return [Void]
  #
  # @example
  #   let logger = spawn do logLoop() end
  #   Process.register(logger, :logger)
  #   Process.register(Process.self, :main)
  register : Process<X> -> Atom -> Void
  foul register(process, name) = Kex.Intrinsic.Process.register(process, name)

  # Returns the process registered under +name+, or +None+ when nothing is.
  #
  # @param name [Atom] the registered name
  # @return [Process<A>?] the process, or +None+
  #
  # @example
  #   Process.whereIs(:main)        # => Just(pid)
  #   Process.whereIs(:not_there)   # => None
  #
  # @example Sending to a named process if it is there
  #   Process.whereIs(:logger).map { |pid| pid.send(message) }
  whereIs : Atom -> Process<A>?
  foul whereIs(name) = Kex.Intrinsic.Process.whereIs(name)

  # A named, typed slot that any process can read directly.
  #
  # State kept in a +serving+ process is copied into the caller on every read,
  # which is costly for a large value that every request reads. A +Shared+
  # value is stored once for the whole node (on the BEAM, in
  # +persistent_term+), and reading it copies nothing however large it is.
  #
  # Writing is the expensive part: replacing a value makes the runtime scan
  # every process for references to the old one. Use it for state that is read
  # constantly and written rarely, such as configuration or a loaded site, not
  # for a counter.
  #
  # Get a handle with +Process.Shared.named+. The name alone identifies the
  # slot, so two handles with the same name share it. Nothing checks that
  # they agree on the type parameter, so give every handle on one name the
  # same one.
  #
  # @example Loading once, reading from every request handler
  #   let site : Process.Shared<Site> = Process.Shared.named("site")
  #   site.put(loadSite(root))
  #   ...
  #   let current = site.get.or(emptySite)
  type Shared<X>

  module Shared do
    # Returns the handle on the slot called +name+. Nothing is stored or read
    # until +put+ or +get+.
    #
    # @param name [String] the slot's name
    # @return [Process.Shared<X>] a handle on the slot
    named : String -> Process.Shared<X>
    let named(name) = Kex.Intrinsic.Shared.named(name)
  end

  make Shared<X> do
    # Stores +value+, replacing whatever the slot held.
    #
    # This is expensive; see +Process.Shared+.
    #
    # @param value [X] the value to store
    # @return [Void]
    put :> X -> Void
    foul put(value) = Kex.Intrinsic.Shared.put(this, value)

    # Returns the stored value, or +None+ when nothing has been stored yet.
    #
    # This is cheap whatever the value's size.
    #
    # @return [X?] the stored value
    get :> X?
    foul get = Kex.Intrinsic.Shared.get(this)

    # Empties the slot and returns what it held.
    #
    # @return [X?] the value it held, or +None+ when it held none
    delete :> X?
    foul delete do
      let held = this.get
      Kex.Intrinsic.Shared.delete(this)
      held
    end
  end
end

# The exit status and output of an external command.
#
# +Process.run+ returns it inside +Ok+ whatever the exit status.
record ProcessResult do
  # The command's exit status. Zero conventionally means success.
  exitCode : Integer

  # Everything the command wrote to standard output.
  stdout : String

  # Everything the command wrote to standard error.
  stderr : String
end

# Messaging, linking and monitoring a process.
make Process<X> do
  # Sends +msg+ to the process. +msg+ must be of the type the process accepts.
  #
  # Sending never blocks and never fails, even when the process is gone.
  # Monitor the process when you need to know it is still there.
  #
  # @param msg [X] the message to send
  # @return [Void]
  #
  # @example
  #   worker.send(:stop)
  #   worker.send(("job", 42))
  send :> X -> Void
  let send(msg) = Kex.Intrinsic.Process.send(this, msg)

  # Sends the pair +(Process.self, msg)+, so the receiver knows where to
  # reply.
  #
  # @param msg [X] the message to send
  # @return [Void]
  #
  # @example
  #   server.sendFrom(:status)   # the server receives (sender, :status)
  sendFrom :> X -> Void
  let sendFrom(msg) = Kex.Intrinsic.Process.sendFrom(this, msg)

  # Links the calling process to this one, so that if either exits abnormally
  # the other exits too.
  #
  # Links work in both directions. Use +monitor+ to be told about an exit
  # without exiting yourself.
  #
  # @return [Void]
  #
  # @example
  #   worker.link
  link :> Void
  let link = Kex.Intrinsic.Process.link(this)

  # Removes the link between the calling process and this one.
  #
  # @return [Void]
  #
  # @example
  #   worker.unlink
  unlink :> Void
  let unlink = Kex.Intrinsic.Process.unlink(this)

  # Starts monitoring this process, and returns the reference that identifies
  # the monitor.
  #
  # When the monitored process exits, the caller receives a message about it.
  # Unlike +link+, a monitor works in one direction and the caller does not
  # exit with it. Call +demonitor+ on the reference to stop.
  #
  # @return [Reference] the monitor reference
  #
  # @example
  #   let ref = worker.monitor
  #   ref.demonitor
  monitor :> Reference
  let monitor = Kex.Intrinsic.Process.monitor(this)

  # Returns +true+ when the process is still running.
  #
  # The process may exit right after you ask. Monitor it when you need to
  # know when it goes.
  #
  # @return [Bool] +true+ when the process is alive
  #
  # @example
  #   Process.self.alive?   # => true
  alive? :> Bool
  let alive? = Kex.Intrinsic.Process.alive?(this)
end

make Server<X> do
  # Returns a handle on the same server with a different call timeout, in
  # milliseconds.
  #
  # The server and other handles on it are unchanged, so one slow call can be
  # given longer without affecting anyone else.
  #
  # @param timeout [Integer] the call timeout in milliseconds
  # @return [Server<X>] a view of the server with that timeout
  #
  # @example Giving one call longer to answer
  #   api.within(30000).rebuildIndex()
  within :> Integer -> Server<X>
  let within(timeout) = New { timeout: timeout }

  # Links the calling process to the server. See +Process.link+.
  #
  # @return [Void]
  #
  # @example
  #   api.link
  link :> Void
  let link = @process.link

  # Removes the link between the calling process and the server.
  #
  # @return [Void]
  unlink :> Void
  let unlink = @process.unlink

  # Starts monitoring the server. See +Process.monitor+.
  #
  # @return [Reference] the monitor reference
  monitor :> Reference
  let monitor = @process.monitor

  # Returns +true+ when the server is still running.
  #
  # @return [Bool] +true+ when the server is alive
  #
  # @example
  #   api.alive?   # => true
  alive? :> Bool
  let alive? = @process.alive?
end

make From<X> do
  # Sends +value+ as the reply to the waiting caller.
  #
  # A slot that cannot reply at once, because it is waiting on something
  # else, leaves +reply+ out of its +Reply+ and calls this later.
  #
  # @param value [X] the answer to send
  # @return [Void]
  #
  # @example Answering after the work is done
  #   Task.start do
  #     from.reply(expensiveThing())
  #   end
  reply :> X -> Void
  foul reply(value) = Kex.Intrinsic.Process.replyFrom(this, value)

  # Returns the waiting caller.
  #
  # @return [Process<A>] the caller
  pid :> Process<A>
  let pid = Kex.Intrinsic.Process.fromPid(this)
end

# Running work in another process and collecting the answer.
module Task do
  # Suspends the calling process for +duration+. A negative duration counts as
  # zero.
  #
  # @param duration [Duration] how long to sleep
  # @return [Void]
  #
  # @example
  #   Task.sleep(500.millisecond)
  sleep : Duration -> Void
  foul sleep(duration) = Kex.Intrinsic.Task.sleep(duration)

  # Runs +f+ in a new process and returns a handle on its result.
  #
  # The block starts at once. To run several pieces of work at the same time,
  # start all the tasks first and await them afterwards.
  #
  # @param f [Block<X>] the work to run
  # @return [Task] a handle on the result
  #
  # @example
  #   let t = Task.start do 1 + 1 end
  #   t.await   # => Ok(2)
  #
  # @example Two pieces of work at once
  #   let a = Task.start do slowThing("a") end
  #   let b = Task.start do slowThing("b") end
  #   (a.await, b.await)
  start : Block<X> -> Task<X>
  foul start(f) = Kex.Intrinsic.Task.start(f)

  # Waits for every task in +tasks+ and returns their results in the same
  # order.
  #
  # Each result is a +Result+, as from +await+, so one failed task does not
  # lose the others' results.
  #
  # @param tasks [[Task]] the tasks to wait for
  # @return [[Result<X, Any>]] their results, in order
  #
  # @example
  #   let tasks = [Task.start do 1 end, Task.start do 2 end]
  #   Task.awaitAll(tasks)   # => [Ok(1), Ok(2)]
  #
  # @example Fanning work out over a list
  #   let results = Task.awaitAll(paths.map { |p| Task.start do process(p) end })
  awaitAll : [Task<X>] -> [Result<X, Any>]
  foul awaitAll(tasks) = Kex.Intrinsic.Task.awaitAll(tasks)
end

make Task<X> do
  # Waits for the task's result, with no time limit.
  #
  # @return [Result<X, Any>] the result or failure reason
  #
  # @example
  #   Task.start do 1 + 1 end.await   # => Ok(2)
  await :> Result<X, Any>
  let await = Kex.Intrinsic.Process.await(this, :infinity)

  # Waits for the task's result, giving up after +timeout+ milliseconds.
  #
  # Returns +Error(:timeout)+ if the task has not finished in time. The task
  # keeps running.
  #
  # @param timeout [Integer] how long to wait, in milliseconds
  # @return [Result<X, Any>] the result or failure reason
  #
  # @example
  #   let t = Task.start do Task.sleep(2.second) end
  #   t.await(100)   # => Error(:timeout)
  await :> Integer -> Result<X, Any>
  let await(timeout) = Kex.Intrinsic.Process.await(this, timeout)
end

# Supervision trees: processes that restart the processes under them when
# they crash.
module Supervisor do
  # Starts a supervisor over the children its block lists, one per line:
  # +Supervisor.worker+s and nested +Supervisor.supervisor+s. When a child
  # crashes, +restart+ decides which children restart:
  #
  # - +:only_crashed+: the crashed child
  # - +:crashed_and_newer+: it and the children listed after it
  # - +:all+: every child
  #
  # The interpreter (+kex -R+) supports only +:only_crashed+, and no nested
  # supervisors.
  #
  # @param restart [Atom] the restart strategy
  # @param children [Block<[(Atom, Block<Process<A>>)]>] the block listing the children
  # @return [Result<Process<A>, Any>] the supervisor, or why it failed to start
  #
  # @example
  #   using Supervisor
  #   start(restart: :only_crashed) do
  #     worker { startCache() }
  #     supervisor(restart: :all) do
  #       worker { startPool() }
  #       worker { startListener() }
  #     end
  #   end
  start : Atom -> Block<[(Atom, Block<Process<A>>)]> -> Result<Process<A>, Any>
  foul start(restart, children) = Kex.Intrinsic.Supervisor.start(restart, children)

  # Starts a supervisor over a list of children already built.
  #
  # @param restart [Atom] the restart strategy
  # @param children [[(Atom, Block<Process<A>>)]] the children
  # @return [Result<Process<A>, Any>] the supervisor, or why it failed to start
  #
  # @example
  #   Supervisor.start(restart: :all, [Supervisor.worker { startPool() }])
  start : Atom -> [(Atom, Block<Process<A>>)] -> Result<Process<A>, Any>
  foul start(restart, children) = Kex.Intrinsic.Supervisor.start(restart, children)

  # Returns a child spec whose block is run to start the child and again to
  # restart it. The block must spawn the worker and return it.
  #
  # @param start [Block<Process<A>>] the block that spawns the worker
  # @return [(Atom, Block<Process<A>>)] the worker spec
  #
  # @example
  #   Supervisor.worker { spawn do cacheLoop([]) end }
  worker : Block<Process<A>> -> (Atom, Block<Process<A>>)
  let worker(start) = Kex.Intrinsic.Supervisor.worker(start)

  # Returns a child spec for a supervisor over the children its block lists,
  # one per line.
  #
  # The parent starts it, and restarts it with all its children when the
  # parent's strategy says so. +restart+ takes the same strategies as
  # +Supervisor.start+. It needs the BEAM backend (plain +kex+); +kex -R+
  # does not support it.
  #
  # @param restart [Atom] +:only_crashed+, +:all+ or +:crashed_and_newer+
  # @param children [Block<[(Atom, Block<Process<A>>)]>] the block listing its children
  # @return [(Atom, Block<Process<A>>)] the supervisor spec
  #
  # @example
  #   Supervisor.supervisor(restart: :all) do
  #     Supervisor.worker { startPool() }
  #     Supervisor.worker { startListener() }
  #   end
  supervisor : Atom -> Block<[(Atom, Block<Process<A>>)]> -> (Atom, Block<Process<A>>)
  let supervisor(restart, children) = Kex.Intrinsic.Supervisor.nested(restart, children)

  # Returns a child spec for a supervisor over a list of children already
  # built.
  #
  # @param restart [Atom] the restart strategy
  # @param children [[(Atom, Block<Process<A>>)]] the children
  # @return [(Atom, Block<Process<A>>)] the supervisor spec
  #
  # @example
  #   Supervisor.supervisor(restart: :all, [Supervisor.worker { startPool() }])
  supervisor : Atom -> [(Atom, Block<Process<A>>)] -> (Atom, Block<Process<A>>)
  let supervisor(restart, children) = Kex.Intrinsic.Supervisor.nested(restart, children)
end

make Reference do
  # Stops the monitor this reference identifies.
  #
  # @return [Void]
  #
  # @example
  #   let ref = worker.monitor
  #   ref.demonitor
  demonitor :> Void
  let demonitor = Kex.Intrinsic.Process.demonitor(this)
end
