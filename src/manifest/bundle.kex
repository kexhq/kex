# The vocabulary of a `package.kex` manifest.
#
# A manifest is DATA: Tey reads it, nothing executes it. These definitions
# exist so the rest of the toolchain can read one as ordinary Kex — the
# checker types it, and an editor gets hover and completion instead of
# "undefined function: bundle" on every line. Their bodies are empty for that
# reason, and this file is opt-in: `version`, `target` and `kex` are far too
# common as names to put in the prelude. Checking a file named `package.kex`
# loads these declarations the way a `.spec.kex` loads its base file.

# Opens a manifest. Everything the package declares lives in its block.
#
# @example
#   package "demo" do
#     version("0.1.0")
#   end
let package(name: String, body: Block<Void>) -> Void do
end

# The name the manifest opener had before `package`; older manifests still
# use it.
let bundle(name: String, body: Block<Void>) -> Void do
end

# Makes this package the root of a workspace: several packages developed
# together in one checkout, sharing one `tey.lock`. Its block names the
# member directories with +members+.
#
# @example
#   workspace do
#     members(["examples/*"])
#   end
let workspace(body: Block<Void>) -> Void do
end

# The directories of a workspace's member packages, each a path or a glob
# relative to the workspace root.
let members(patterns: [String]) -> Void do
end

# Adds commands to `tey` itself: `tey NAMESPACE COMMAND`. The block declares
# them with +command+; +tey+ is the Tey version range the plugin works with.
#
# @example
#   plugin(namespace: "docs", tey: ">= 0.4.0") do
#     command("build", run: "script/docs.kex", description: "Build the docs")
#   end
let plugin(namespace: String, tey: String, body: Block<Void>) -> Void do
end

# The package's own version, as `MAJOR.MINOR.PATCH`.
let version(version: String) -> Void do
end

# One sentence about what the package is, shown wherever it is listed.
let description(text: String) -> Void do
end

# The license the package is distributed under, as an SPDX identifier
# (`"MIT"`, `"Apache-2.0"`).
let license(identifier: String) -> Void do
end

# The Kex versions this package builds against, as a requirement:
# `">= 0.3.0"`, `"~> 0.3"`, `"0.3.1"`.
let kex(requirement: String) -> Void do
end

# The source file `tey run` and `tey build` start from.
let entrypoint(path: String) -> Void do
end

# A named build target. `entrypoint:` defaults to the package's own.
let target(name: String, entrypoint: String = "") -> Void do
end

# A project-specific command, run as `tey <name>` and listed by
# `tey help`. A `run:` whose first word ends in `.kex` goes through the
# selected toolchain with the package's source roots in place; anything else
# is a shell line. Trailing arguments are appended, so `tey fmt src` reaches
# it. A name is one word, grouped with a colon (`db:migrate`); a name Tey
# already answers (`test`, `build`, …) is refused.
#
# @example
#   command("fmt", run: "kex --format src", description: "Format the sources")
#   command("db:migrate", run: "script/migrate.kex")
let command(name: String, run: String = "", description: String = "") -> Void do
end

# A dependency, from exactly one source: `git:` (pinned by one of `tag:`,
# `branch:` or `ref:`, and in `subdir:` when the package is not at the
# repository's root), `path:` for a directory on this machine, or
# `workspace: true` for a member of the same workspace.
#
# @example
#   tey("greet", git: "https://github.com/kexhq/greet.git", tag: "v0.1.0")
#   tey("rodolfo", path: "vendor/rodolfo")
#   tey("rodolfo", workspace: true)
let tey(name: String, git: String = "", tag: String = "",
        branch: String = "", ref: String = "", subdir: String = "",
        path: String = "", workspace: Bool = false) -> Void do
end

# Scopes the dependencies in its block to a group, so that
# `tey install --without dev` can leave them out.
#
# @example
#   group :dev do
#     tey("mock", git: "...", tag: "v1.0.0")
#   end
let group(name: Atom, body: Block<Void>) -> Void do
end

# The Erlang/OTP releases this package needs, as a requirement: `">= 26"`.
# Absent means the package has no opinion.
let otp(requirement: String) -> Void do
end

# A toolchain package: a compiler executable plus the runtime and standard
# library it was built with, installed together so the three can never drift
# apart. Kex's own `package.kex` is the one that declares it.
let toolchain(name: String, compiler: String = "", runtime: String = "",
              stdlib: String = "") -> Void do
end
