# kex: no-check
# kex docgen — documentation generator for kex source trees.
#
# Parses every .kex file under --source via Kex.AST,
# extracts doc-comments + signatures + locations, and emits one Markdown
# page per source file (with YAML frontmatter) into --out.
#
# Usage:
#   kex -n tools/docgen/docgen.kex -- build \
#     --source src/stdlib --out <dir> \
#     --version 0.1.0-dev --package prelude --label "Prelude" \
#     --base-url https://docs.kex.run
#
#   kex -n tools/docgen/docgen.kex -- serve --out <dir> --port 4322
#
# Single-file for now; splits into lib/docgen/*.kex once it stabilises.

# ─────────────────────────────────────────────────────────────────────────────
# Small helpers
# ─────────────────────────────────────────────────────────────────────────────

let ifEmpty(s, default) do
  if s.empty?
    default
  else
    s
  end
end

# Returns the value of an Optional, or "" if None. (For String Optionals.)
let orEmpty(opt) do
  match opt do
    Just(s) => s
    None => ""
  end
end

# Append `extra` (a list) to `xs` only when `xs` is non-empty.
let appendedIfNonEmpty(xs, extra) do
  if xs.empty?
    xs
  else
    xs + extra
  end
end

let repeatStr(s, n) do
  if n <= 0
    ""
  else
    s + repeatStr(s, n - 1)
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# CLI parsing
# ─────────────────────────────────────────────────────────────────────────────

let DOCGEN_OPTIONS = OptionParser.define("docgen", "Generate and serve Kex documentation")
  .string("source", None, "Source directory", None, false)
  .string("out", None, "Output directory", None, false)
  .string("version", None, "Version string", Just("dev"), false)
  .string("package", None, "Package name", Just("prelude"), false)
  .string("label", None, "Human-readable package label", None, false)
  .string("base-url", None, "Documentation site base URL", Just("https://docs.kex.run"), false)
  .integer("port", None, "HTTP port", Just("4322"), false)

foul parseArgs(args) do
  match DOCGEN_OPTIONS.parse(args) do
    Error(error) => Error(OptionParser.errorMessage(error))
    Ok(parsed) => Ok(parsed.values.put("command", parsed.arguments.first.or("")))
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# TypeRef → String through Kex.AST's standard conversion.
# ─────────────────────────────────────────────────────────────────────────────

let typeRefToString(ref) = ref.to(String).or("?")

# ─────────────────────────────────────────────────────────────────────────────
# Source-based doc-comment extraction
# ─────────────────────────────────────────────────────────────────────────────

# Returns the raw doc text (with `# ` stripped) for an item at 1-based `line`.
foul extractDocAt(lines, line) do
  return collectDocLines(lines, line - 2, "")
end

foul collectDocLines(lines, idx, accum) do
  if idx < 0
    return trimTrailingNewlines(accum)
  end
  let raw = lines.get(idx)
  let trimmed = raw.trim
  if trimmed.empty?
    if accum.empty?
      return collectDocLines(lines, idx - 1, accum)
    end
    return collectDocLines(lines, idx - 1, "\n" + accum)
  end
  if trimmed.startsWith?("#")
    let content = stripCommentPrefix(trimmed)
    let joined = if accum.empty?
      content
    else
      content + "\n" + accum
    end
    return collectDocLines(lines, idx - 1, joined)
  end
  return trimTrailingNewlines(accum)
end

let stripCommentPrefix(s) do
  if s.count <= 1
    return ""
  end
  if s.get(1).or('?') == ' '
    return s.drop(2)
  end
  return s.drop(1)
end

let trimTrailingNewlines(s) do
  if s.empty?
    return s
  end
  if s.last.or('?') == '\n'
    return trimTrailingNewlines(s.dropLast)
  end
  return s
end

# ─────────────────────────────────────────────────────────────────────────────
# RDoc text → structured DocComment
# ─────────────────────────────────────────────────────────────────────────────

# Returns None for empty input; otherwise a record:
#   { summary, params, returns, examples, deprecated }
# Inline `+code+` is rewritten to `` `code` ``. Description prose currently
# merges into `summary` (emit_md renders it as one block).
foul parseDocComment(text) do
  if text.empty?
    return None
  end
  let rewritten = rewritePlusPairs(text, "")
  let lines = rewritten.split("\n")
  let blocks = splitParagraphs(lines, [], [])
  return classifyBlocks(blocks, "", [], None, [], None)
end

let emptyDoc() do
  return { summary: "", params: [], returns: None, examples: [], deprecated: None }
end

let resolveDoc(parsedDoc) do
  match parsedDoc do
    Just(d) => d
    _ => emptyDoc()
  end
end

let rewritePlusPairs(s, accum) do
  match s.indexOf('+') do
    None => accum + s
    Just(start) => do
      let rest = s.drop(start + 1)
      match rest.indexOf('+') do
        None => accum + s
        Just(endOff) => do
          let inner = rest.take(endOff)
          let tail = rest.drop(endOff + 1)
          let head = s.take(start)
          return rewritePlusPairs(tail, accum + head + "`" + inner + "`")
        end
      end
    end
  end
end

# Splits a list of lines into paragraphs (blocks) separated by blank lines.
foul splitParagraphs(lines, current, accum) do
  if lines.empty?
    if current.empty?
      return accum
    end
    return accum + [current]
  end
  let line = orEmpty(lines.first)
  let rest = lines.drop(1)
  if line.trim.empty?
    if current.empty?
      return splitParagraphs(rest, [], accum)
    end
    return splitParagraphs(rest, [], accum + [current])
  end
  return splitParagraphs(rest, current + [line], accum)
end

foul classifyBlocks(blocks, summary, params, returns, examples, deprecated) do
  if blocks.empty?
    return Just({
      summary: summary,
      params: params,
      returns: returns,
      examples: examples,
      deprecated: deprecated
    })
  end
  let block = blocks.first.or([])
  let rest = blocks.drop(1)
  let first = orEmpty(block.first)
  if first.startsWith?("@param")
    return classifyLoop(rest, summary, params + [parseParamBlock(block)], returns, examples, deprecated)
  end
  if first.startsWith?("@return")
    return classifyLoop(rest, summary, params, parseReturnBlock(block), examples, deprecated)
  end
  if first.startsWith?("@example")
    return classifyLoop(rest, summary, params, returns, examples + [parseExampleBlock(block)], deprecated)
  end
  if first.startsWith?("@deprecated")
    let msg = block.drop(1).join(" ")
    return classifyLoop(rest, summary, params, returns, examples, Just(msg))
  end
  if first.startsWith?("@")
    return classifyLoop(rest, summary, params, returns, examples, deprecated)
  end
  # Prose block: first becomes summary, subsequent merge into summary.
  let joined = block.join(" ")
  let nextSummary = if summary.empty?
    joined
  else
    summary + "\n\n" + joined
  end
  return classifyLoop(rest, nextSummary, params, returns, examples, deprecated)
end

foul classifyLoop(blocks, summary, params, returns, examples, deprecated) do
  return classifyBlocks(blocks, summary, params, returns, examples, deprecated)
end

foul parseParamBlock(lines) do
  let head = orEmpty(lines.first)
  let body = head.drop(7).trim
  match body.indexOf(' ') do
    None => return { name: body, ty: "", desc: "" }
    Just(nameEnd) => do
      let nm = body.take(nameEnd)
      let tail = body.drop(nameEnd + 1).trim
      match parseBracketed(tail) do
        None => return { name: nm, ty: "", desc: tail }
        Just(parsed) => do
          let t = parsed[:content].or("")
          let r = parsed[:rest].or("")
          return { name: nm, ty: t, desc: r.trim }
        end
      end
    end
  end
end

foul parseReturnBlock(lines) do
  let head = orEmpty(lines.first)
  let body = head.drop(8).trim
  match parseBracketed(body) do
    None => return { ty: "", desc: body }
    Just(parsed) => do
      let t = parsed[:content].or("")
      let r = parsed[:rest].or("")
      return { ty: t, desc: r.trim }
    end
  end
end

foul parseExampleBlock(lines) do
  let head = orEmpty(lines.first)
  let caption = head.drop(9).trim
  let code = lines.drop(1).join("\n")
  return { caption: caption, code: code }
end

foul parseBracketed(s) do
  if s.empty?
    return None
  end
  if s.first.or('?') != '['
    return None
  end
  match findClosingBracket(s, 1, 1) do
    None => return None
    Just(endIdx) => do
      let content = s.take(endIdx).drop(1)
      let rest = s.drop(endIdx + 1)
      return Just({ content: content, rest: rest })
    end
  end
end

foul findClosingBracket(s, idx, depth) do
  if idx >= s.count
    return None
  end
  let c = s.get(idx).or('?')
  let nextDepth = if c == '['
    depth + 1
  else
    if c == ']'
      depth - 1
    else
      depth
    end
  end
  if nextDepth == 0
    return Just(idx)
  end
  return findClosingBracket(s, idx + 1, nextDepth)
end

# ─────────────────────────────────────────────────────────────────────────────
# DocComment accessors (work around the no-nested-record-pattern rule)
# ─────────────────────────────────────────────────────────────────────────────

let docSummary(doc) do
  match doc do
    Just(d) => d[:summary].or("")
    { summary: s } => s.or("")
    _ => ""
  end
end

let docReturns(doc) do
  match doc do
    Just(d) => docReturns(d)
    { returns: r } => do
      match r do
        None => None
        _ => Just(r)
      end
    end
    _ => None
  end
end

let docExamples(doc) do
  match doc do
    Just(d) => d[:examples].or([])
    { examples: ex } => ex.or([])
    _ => []
  end
end

let docDeprecated(doc) do
  match doc do
    Just(d) => docDeprecated(d)
    { deprecated: depr } => depr
    _ => None
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# YAML / string emitters
# ─────────────────────────────────────────────────────────────────────────────

let yamlQuote(s) = "\"${escapeYaml(s)}\""

let escapeYaml(s) = s.replace("\\", "\\\\").replace("\"", "\\\"")

foul escapeJson(s) do
  let step1 = s.replace("\\", "\\\\").replace("\"", "\\\"")
  let step2 = step1.replace("\n", "\\n").replace("\r", "\\r")
  return step2.replace("\t", "\\t")
end

# ─────────────────────────────────────────────────────────────────────────────
# Entity walking
# ─────────────────────────────────────────────────────────────────────────────

foul walkItems(items, lines, fileName) do
  return walkLoop(items, lines, fileName, [])
end

foul walkLoop(items, lines, fileName, accum) do
  if items.empty?
    return accum
  end
  let item = items.first.or(None)
  let rest = items.drop(1)
  let nxt = match item do
    TypeDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildTypeEntity(info, doc)]
    end
    RecordDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildRecordEntity(info, doc)]
    end
    TraitDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildTraitEntity(info, doc, lines, fileName)]
    end
    MakeDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildMakeEntity(info, doc, lines, fileName)]
    end
    ModuleDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildModuleEntity(info, doc, lines, fileName)]
    end
    FunctionDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildFunctionEntity(info, doc)]
    end
    ConstantDef(info) => do
      let loc = locationLine(info.location)
      let doc = extractDocAt(lines, loc)
      [buildConstantEntity(info, doc)]
    end
    _ => []
  end
  return walkLoop(rest, lines, fileName, accum + nxt)
end

foul locationLine(loc) do
  match loc do
    { line: l } => return l
    _ => return 0
  end
end

foul buildTypeEntity(info, doc) do
  let parsedDoc = parseDocComment(doc)
  let vs = match info.variants do
    Just(vlist) => vlist.map { |v| variantName(v) }
    None => []
  end
  return {
    kind: "type",
    name: info.name,
    type_params: info.typeParams,
    parents: info.parents.map { |p| typeRefToString(p) },
    variants: vs,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

let variantName(v) do
  match v do
    { name: n } => n
    _ => "?"
  end
end

foul buildRecordEntity(info, doc) do
  let parsedDoc = parseDocComment(doc)
  let flds = info.fields.map { |f| recordFieldInfo(f) }
  return {
    kind: "record",
    name: info.name,
    type_params: info.typeParams,
    fields: flds,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

let recordFieldInfo(f) do
  return { name: f.name, has_default: f.hasDefault }
end

foul buildTraitEntity(info, doc, lines, fileName) do
  let parsedDoc = parseDocComment(doc)
  let functions = walkBody(info.body, lines, fileName)
  return {
    kind: "trait",
    name: info.name,
    type_params: info.typeParams,
    functions: functions,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

foul buildMakeEntity(info, doc, lines, fileName) do
  let parsedDoc = parseDocComment(doc)
  let functions = walkBody(info.body, lines, fileName)
  let impls = info.implements.map { |t| typeRefToString(t) }
  return {
    kind: "make",
    target: typeRefToString(info.target),
    implements: impls,
    functions: functions,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

foul buildModuleEntity(info, doc, lines, fileName) do
  let parsedDoc = parseDocComment(doc)
  let functions = walkBody(info.items, lines, fileName)
  return {
    kind: "module",
    name: info.name,
    functions: functions,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

foul buildFunctionEntity(info, doc) do
  let parsedDoc = parseDocComment(doc)
  return {
    kind: "function",
    name: info.name,
    clauses: info.clauses.count,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

foul buildConstantEntity(info, doc) do
  let parsedDoc = parseDocComment(doc)
  return {
    kind: "constant",
    name: info.name,
    doc: resolveDoc(parsedDoc),
    raw_doc: doc,
    line: locationLine(info.location)
  }
end

# Walks a Make/Module/Trait body: flat interleaved list of TypeAnnotation +
# FunctionDef. Emits one "function" entry per name, accumulating clauses.
foul walkBody(body, lines, fileName) do
  return walkBodyLoop(body, lines, fileName, [])
end

foul walkBodyLoop(body, lines, fileName, accum) do
  if body.empty?
    return accum
  end
  let head = body.first.or(None)
  let rest = body.drop(1)
  match head do
    TypeAnnotation(a) => do
      let nm = a.name
      let loc = locationLine(a.location)
      let doc = extractDocAt(lines, loc)
      let parsedDoc = parseDocComment(doc)
      let sig = readSignatureLine(lines, loc)
      let clauses = collectClausesFor(rest, nm)
      let alreadySeen = accum.any? { |m| m[:name].or("") == nm }
      if alreadySeen
        # Overloaded signature: append to the existing function entry.
        return walkBodyLoop(rest, lines, fileName, appendOverload(accum, nm, sig))
      end
      let func = {
        kind: "function",
        name: nm,
        signatures: [sig],
        doc: resolveDoc(parsedDoc),
        raw_doc: doc,
        clauses: clauses,
        line: loc
      }
      return walkBodyLoop(rest, lines, fileName, accum + [func])
    end
    FunctionDef(f) => do
      let nm = f.name
      let alreadySeen = accum.any? { |m| m[:name].or("") == nm }
      if alreadySeen
        return walkBodyLoop(rest, lines, fileName, accum)
      end
      let loc = locationLine(f.location)
      let doc = extractDocAt(lines, loc)
      let parsedDoc = parseDocComment(doc)
      let clauses = collectClausesFor(body, nm)
      let func = {
        kind: "function",
        name: nm,
        signatures: [],
        doc: resolveDoc(parsedDoc),
        raw_doc: doc,
        clauses: clauses,
        line: loc
      }
      return walkBodyLoop(rest, lines, fileName, accum + [func])
    end
    _ => return walkBodyLoop(rest, lines, fileName, accum)
  end
end

# Adds an additional signature line to an existing function entry (overloads).
foul appendOverload(accum, nm, sig) do
  return accum.map { |m| maybeMerge(m, nm, sig) }
end

foul maybeMerge(m, nm, sig) do
  if m[:name].or("") == nm
    return mergeSig(m, sig)
  end
  return m
end

foul mergeSig(m, sig) do
  return {
    kind: m[:kind].or(""),
    name: m[:name].or(""),
    signatures: m[:signatures].or([]) + [sig],
    doc: m[:doc].or({}),
    raw_doc: m[:raw_doc].or(""),
    clauses: m[:clauses].or([]),
    line: m[:line].or(0)
  }
end

foul collectClausesFor(body, nm) do
  if body.empty?
    return []
  end
  let head = body.first.or(None)
  match head do
    FunctionDef(f) => do
      if f.name != nm
        return []
      end
      let rest = body.drop(1)
      let paramList = clauseParams(f)
      return [paramList] + collectClausesFor(rest, nm)
    end
    _ => return []
  end
end

foul clauseParams(f) do
  if f.clauses.empty?
    return ""
  end
  let c = f.clauses.first.or(None)
  match c do
    { params: ps } => do
      let names = ps.map { |p| paramName(p) }
      return names.join(", ")
    end
  end
end

let paramName(p) do
  match p do
    { name: Just(n) } => n
    { name: None } => "_"
    _ => "_"
  end
end

foul readSignatureLine(lines, line) do
  if line < 1
    return ""
  end
  if line > lines.count
    return ""
  end
  let raw = lines.get(line - 1)
  return raw.trim
end

# ─────────────────────────────────────────────────────────────────────────────
# Markdown page emission (one .md per source file)
# ─────────────────────────────────────────────────────────────────────────────

foul emitFilePage(fileName, entities, opts) do
  let baseName = stripExt(fileName)
  let version = orEmpty(opts.get("version"))
  let pkg = orEmpty(opts.get("package"))
  let fm = emitFrontmatter(baseName, fileName, entities, version, pkg)
  let body = emitFileBody(fileName, entities)
  return fm + "\n\n" + body
end

let stripExt(name) do
  return name.take(name.count - 4) if name.endsWith?(".kex")
  return name
end

foul emitFrontmatter(title, source, entities, version, pkg) do
  let entityLines = entities.map { |e| entityFrontmatterLine(e) }
  let joined = entityLines.join("\n")
  return "---\npackage: ${pkg}\nversion: \"${version}\"\nsource: ${source}\ntitle: ${title}\nentities:\n${joined}\n---"
end

foul entityFrontmatterLine(e) do
  let k = e[:kind].or("")
  let name = e[:name].or("")
  let target = e[:target].or("")
  if k == "type"
    return "  - { kind: type, name: ${yamlQuote(name)} }"
  end
  if k == "record"
    return "  - { kind: record, name: ${yamlQuote(name)} }"
  end
  if k == "trait"
    return "  - { kind: trait, name: ${yamlQuote(name)} }"
  end
  if k == "make"
    return "  - { kind: make, target: ${yamlQuote(target)} }"
  end
  if k == "module"
    return "  - { kind: module, name: ${yamlQuote(name)} }"
  end
  if k == "function"
    return "  - { kind: function, name: ${yamlQuote(name)} }"
  end
  if k == "constant"
    return "  - { kind: constant, name: ${yamlQuote(name)} }"
  end
  return "  - { kind: unknown }"
end

foul emitFileBody(fileName, entities) do
  let baseName = stripExt(fileName)
  let title = titleCase(baseName)
  let body = entities.map { |e| emitEntitySection(e) }.join("\n\n")
  return "# ${title}\n\n" + body + "\n"
end

let titleCase(s) do
  if s.empty?
    return s
  end
  return s.get(0).upperCase + s.drop(1)
end

foul emitEntitySection(e) do
  let k = e[:kind].or("")
  if k == "type"
    return emitTypeSection(e)
  end
  if k == "record"
    return emitRecordSection(e)
  end
  if k == "trait"
    return emitTraitSection(e)
  end
  if k == "make"
    return emitMakeSection(e)
  end
  if k == "module"
    return emitModuleSection(e)
  end
  if k == "function"
    return emitFunctionSection(e)
  end
  if k == "constant"
    return emitConstantSection(e)
  end
  return ""
end

foul emitTypeSection(e) do
  let name = e[:name].or("")
  let typeParams = e[:type_params].or([])
  let parentTypes = e[:parents].or([])
  let variantNames = e[:variants].or([]).filter { |v| !v.empty? }
  let docText = docSummary(e[:doc])
  let params = if typeParams.empty?
    ""
  else
    "<" + typeParams.join(", ") + ">"
  end
  let parents = if parentTypes.empty?
    ""
  else
    " : " + parentTypes.join(", ")
  end
  let variants = if variantNames.empty?
    ""
  else
    let vlist = variantNames.map { |v| "  - \`${v}\`" }.join("\n")
    "\n\n**Variants**\n\n${vlist}"
  end
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  return "## type \`${name}${params}\`${parents}\n\n${docBlock}${variants}"
end

foul emitRecordSection(e) do
  let name = e[:name].or("")
  let docText = docSummary(e[:doc])
  let flds = e[:fields].or([]).map { |f| fieldBullet(f) }.join("\n")
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  return "## record \`${name}\`\n\n${docBlock}**Fields**\n\n${flds}"
end

let fieldBullet(f) do
  let name = f[:name].or("?")
  let suffix = if f[:has_default].or(false)
    " (optional)"
  else
    ""
  end
  return "  - \`${name}\`${suffix}"
end

foul emitTraitSection(e) do
  let name = e[:name].or("")
  let docText = docSummary(e[:doc])
  let functions = e[:functions].or([])
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  let functionNames = functions.map do |f|
    let functionName = f[:name].or("")
    "  - \`${functionName}\`"
  end.join("\n")
  let functionsBlock = if functionNames.empty?
    ""
  else
    "\n\n**Functions**\n\n${functionNames}"
  end
  let details = renderFunctionDetails(functions)
  return "## trait \`${name}\`\n\n${docBlock}${functionsBlock}${details}"
end

foul emitMakeSection(e) do
  let target = e[:target].or("")
  let implements = e[:implements].or([])
  let docText = docSummary(e[:doc])
  let functions = e[:functions].or([])
  let impls = if implements.empty?
    ""
  else
    " implements " + implements.join(", ")
  end
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  let details = renderFunctionDetails(functions)
  return "## make \`${target}\`${impls}\n\n${docBlock}${details}"
end

foul emitModuleSection(e) do
  let name = e[:name].or("")
  let docText = docSummary(e[:doc])
  let functions = e[:functions].or([])
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  let details = renderFunctionDetails(functions)
  return "## module \`${name}\`\n\n${docBlock}${details}"
end

foul emitFunctionSection(e) do
  let name = e[:name].or("")
  let docText = docSummary(e[:doc])
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  return "## function \`${name}\`\n\n${docBlock}"
end

foul emitConstantSection(e) do
  let name = e[:name].or("")
  let docText = docSummary(e[:doc])
  let docBlock = if docText.empty?
    ""
  else
    docText + "\n\n"
  end
  return "## \`${name}\`\n\n${docBlock}"
end

foul renderFunctionDetails(functions) do
  if functions.empty?
    return ""
  end
  let sections = functions.map { |f| renderFunctionDetail(f) }
  return "\n" + sections.join("\n\n")
end

foul renderFunctionDetail(f) do
  let functionName = f[:name].or("")
  let parts = ["#### \`${functionName}\`"]
  let doc = f[:doc]
  let sm = docSummary(doc)
  let parts2 = if sm.empty?
    parts
  else
    parts + ["", sm]
  end
  let parts3 = renderSignatures(parts2, f[:signatures].or([]))
  let parts4 = renderReturns(parts3, doc)
  let parts5 = renderExamplesBlock(parts4, doc)
  return parts5.join("\n")
end

foul renderSignatures(parts, sigs) do
  if sigs.empty?
    return parts
  end
  let block = sigs.map { |s| s }.join("\n")
  return parts + ["", "```kex", block, "```"]
end

foul renderReturns(parts, doc) do
  match docReturns(doc) do
    None => return parts
    Just(r) => do
      let t = r[:ty].or("")
      let d = r[:desc].or("")
      let line = if t.empty?
        d
      else
        if d.empty?
          "\`${t}\`"
        else
          "\`${t}\` — ${d}"
        end
      end
      if line.empty?
        return parts
      end
      return parts + ["", "**Returns**: ${line}"]
    end
  end
end

foul renderExamplesBlock(parts, doc) do
  let exs = docExamples(doc)
  if exs.empty?
    return parts
  end
  return parts + ["", "**Examples**", ""] + flatExamples(exs)
end

foul flatExamples(exs) do
  if exs.empty?
    return []
  end
  let first = exs.first.or({ caption: "", code: "" })
  let rest = exs.drop(1)
  return ["```kex", first[:code].or(""), "```"] + flatExamples(rest)
end

# ─────────────────────────────────────────────────────────────────────────────
# Index emission (manifest / versions / llms / robots / sitemap)
# ─────────────────────────────────────────────────────────────────────────────

let jsonString(s) do
  return "\"" + escapeJson(s) + "\""
end

foul emitManifestJson(pages) do
  let lines = pages.map { |p| emitManifestPage(p) }
  return ["[\n", lines.join(",\n"), "\n]"].join("")
end

foul emitManifestPage(p) do
  let entities = p[:entities].or([]).map { |e| emitManifestEntity(e) }.join(", ")
  return [
    "  { ",
    "\"path\": ", jsonString(p[:path].or("")), ", ",
    "\"title\": ", jsonString(p[:title].or("")), ", ",
    "\"source\": ", jsonString(p[:source].or("")), ", ",
    "\"kind\": ", jsonString(p[:kind].or("")), ", ",
    "\"entities\": [", entities, "], ",
    "\"line\": ", p[:line].or(0).to(String).or("0"),
    " }"
  ].join("")
end

foul emitManifestEntity(e) do
  let rawName = e[:name].or("")
  let name = if rawName.empty? then e[:target].or("") else rawName end
  return [
    "{ ",
    "\"kind\": ", jsonString(e[:kind].or("")), ", ",
    "\"name\": ", jsonString(name), ", ",
    "\"line\": ", e[:line].or(0).to(String).or("0"),
    " }"
  ].join("")
end

foul emitVersionsJson(opts, generatedAt) do
  let pkg = orEmpty(opts.get("package"))
  let ver = orEmpty(opts.get("version"))
  let label = orEmpty(opts.get("label"))
  let displayLabel = if label.empty? then pkg else label end
  return [
    "{\n",
    "  \"versions\": [\n",
    "    { ",
    "\"id\": ", jsonString(ver), ", ",
    "\"label\": ", jsonString(displayLabel), ", ",
    "\"generatedAt\": ", jsonString(generatedAt), ", ",
    "\"package\": ", jsonString(pkg),
    " }\n",
    "  ]\n",
    "}"
  ].join("")
end

let normalizeBaseUrl(url) do
  if url.endsWith?("/") then url.dropLast else url end
end

foul emitLlmsTxt(pages, opts, generatedAt) do
  let baseUrl = normalizeBaseUrl(orEmpty(opts.get("base-url")))
  let pkg = orEmpty(opts.get("package"))
  let ver = orEmpty(opts.get("version"))
  let label = orEmpty(opts.get("label"))
  let title = if label.empty? then pkg else label end
  let header = ["# ", title, " ", ver, "\n\n", "Generated by kex docgen at ", generatedAt, ".\n\n", "## Pages\n\n"].join("")
  let links = pages.map { |p| ["- [", p[:title].or(""), "](", baseUrl, "/", p[:url_path].or(""), ")"].join("") }.join("\n")
  return header + links + "\n"
end

foul emitLlmsFullTxt(pages) do
  return pages.map { |p| p[:content].or("") }.join("\n\n---\n\n") + "\n"
end

foul emitRobotsTxt(baseUrl) do
  if baseUrl.empty?
    return "User-agent: *\nAllow: /\n"
  end
  return ["User-agent: *\nAllow: /\nSitemap: ", normalizeBaseUrl(baseUrl), "/sitemap.xml\n"].join("")
end

foul emitSitemapXml(pages, baseUrl, generatedAt) do
  let root = normalizeBaseUrl(baseUrl)
  let urls = pages.map { |p| ["  <url>\n    <loc>", root, "/", p[:url_path].or(""), "</loc>\n    <lastmod>", generatedAt, "</lastmod>\n  </url>"].join("") }.join("\n")
  return [
    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
    "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n",
    urls,
    "\n</urlset>\n"
  ].join("")
end

# ─────────────────────────────────────────────────────────────────────────────
# JSON model emission (primary artifact; Markdown/HTML/PDF derive from this)
# ─────────────────────────────────────────────────────────────────────────────

foul emitModelJson(model) do
  let pages = model[:pages].or([])
  return [
    "{\n",
    "  \"package\": ", jsonString(model[:package].or("")), ",\n",
    "  \"version\": ", jsonString(model[:version].or("")), ",\n",
    "  \"label\": ", jsonString(model[:label].or("")), ",\n",
    "  \"baseUrl\": ", jsonString(model[:base_url].or("")), ",\n",
    "  \"generatedAt\": ", jsonString(model[:generated_at].or("")), ",\n",
    "  \"pages\": [\n",
    pages.map { |p| emitModelPage(p) }.join(",\n"),
    "\n  ]\n",
    "}"
  ].join("")
end

foul emitModelPage(p) do
  let entities = p[:entities].or([]).map { |e| emitModelEntity(e) }.join(", ")
  return [
    "    { ",
    "\"source\": ", jsonString(p[:source].or("")), ", ",
    "\"path\": ", jsonString(p[:path].or("")), ", ",
    "\"urlPath\": ", jsonString(p[:url_path].or("")), ", ",
    "\"title\": ", jsonString(p[:title].or("")), ", ",
    "\"line\": ", p[:line].or(0).to(String).or("0"), ", ",
    "\"entities\": [", entities, "]",
    " }"
  ].join("")
end

foul emitModelEntity(e) do
  let functions = e[:functions].or([]).map { |f| emitModelEntity(f) }.join(", ")
  let fields = e[:fields].or([]).map { |f| emitModelField(f) }.join(", ")
  return [
    "{ ",
    "\"kind\": ", jsonString(e[:kind].or("")), ", ",
    "\"name\": ", jsonString(e[:name].or("")), ", ",
    "\"target\": ", jsonString(e[:target].or("")), ", ",
    "\"line\": ", e[:line].or(0).to(String).or("0"), ", ",
    "\"doc\": ", emitModelDoc(e[:doc]), ", ",
    "\"rawDoc\": ", jsonString(e[:raw_doc].or("")), ", ",
    "\"typeParams\": ", emitJsonStringList(e[:type_params].or([])), ", ",
    "\"parents\": ", emitJsonStringList(e[:parents].or([])), ", ",
    "\"variants\": ", emitJsonStringList(e[:variants].or([])), ", ",
    "\"implements\": ", emitJsonStringList(e[:implements].or([])), ", ",
    "\"fields\": [", fields, "], ",
    "\"signatures\": ", emitJsonStringList(e[:signatures].or([])), ", ",
    "\"functions\": [", functions, "]",
    " }"
  ].join("")
end

foul emitModelField(f) do
  return [
    "{ ",
    "\"name\": ", jsonString(f[:name].or("?")), ", ",
    "\"hasDefault\": ", f[:has_default].or(false).to(String).or("false"),
    " }"
  ].join("")
end

foul emitModelDoc(doc) do
  let d = match doc do
    Just(r) => r
    None => emptyDoc()
    _ => doc
  end
  let params = d[:params].or([]).map { |p| emitModelParam(p) }.join(", ")
  let returns = match docReturns(d) do
    Just(r) => emitModelReturn(r)
    _ => "null"
  end
  let examples = d[:examples].or([]).map { |ex| emitModelExample(ex) }.join(", ")
  let deprecated = match docDeprecated(d) do
    Just(dep) => jsonString(dep)
    _ => "null"
  end
  return [
    "{ ",
    "\"summary\": ", jsonString(d[:summary].or("")), ", ",
    "\"params\": [", params, "], ",
    "\"returns\": ", returns, ", ",
    "\"examples\": [", examples, "], ",
    "\"deprecated\": ", deprecated,
    " }"
  ].join("")
end

foul emitModelParam(p) do
  return [
    "{ ",
    "\"name\": ", jsonString(p[:name].or("")), ", ",
    "\"type\": ", jsonString(p[:ty].or("")), ", ",
    "\"description\": ", jsonString(p[:desc].or("")),
    " }"
  ].join("")
end

foul emitModelReturn(r) do
  return [
    "{ ",
    "\"type\": ", jsonString(r[:ty].or("")), ", ",
    "\"description\": ", jsonString(r[:desc].or("")),
    " }"
  ].join("")
end

foul emitModelExample(ex) do
  return [
    "{ ",
    "\"caption\": ", jsonString(ex[:caption].or("")), ", ",
    "\"code\": ", jsonString(ex[:code].or("")),
    " }"
  ].join("")
end

let emitJsonStringList(xs) do
  return ["[", xs.map { |s| jsonString(s) }.join(", "), "]"].join("")
end

foul emitIndexes(pages, opts, outRoot, generatedAt) do
  let baseUrl = orEmpty(opts.get("base-url"))
  let manifest = emitManifestJson(pages)
  let versions = emitVersionsJson(opts, generatedAt)
  let llms = emitLlmsTxt(pages, opts, generatedAt)
  let llmsFull = emitLlmsFullTxt(pages)
  let robots = emitRobotsTxt(baseUrl)
  let sitemap = emitSitemapXml(pages, baseUrl, generatedAt)
  let _ = FS.File.write(FS.Path.join(outRoot, "manifest.json"), manifest)
  let _ = FS.File.write(FS.Path.join(outRoot, "versions.json"), versions)
  let _ = FS.File.write(FS.Path.join(outRoot, "llms.txt"), llms)
  let _ = FS.File.write(FS.Path.join(outRoot, "llms-full.txt"), llmsFull)
  let _ = FS.File.write(FS.Path.join(outRoot, "robots.txt"), robots)
  let _ = FS.File.write(FS.Path.join(outRoot, "sitemap.xml"), sitemap)
  IO.printLine("docgen: wrote index files")
end

# ─────────────────────────────────────────────────────────────────────────────
# Build driver
# ─────────────────────────────────────────────────────────────────────────────

foul listSourceFiles(sourceDir) do
  match FS.Directory.files(sourceDir) do
    Just(names) => do
      let kex = names.filter { |n| n.endsWith?(".kex") }
      return kex.sort
    end
    None => return []
  end
end

foul buildCommand(opts) do
  let source = orEmpty(opts.get("source"))
  let out = orEmpty(opts.get("out"))
  let pkg = orEmpty(opts.get("package"))
  let ver = orEmpty(opts.get("version"))
  if source.empty?
    IO.printError("docgen: --source is required")
    return 1
  end
  if out.empty?
    IO.printError("docgen: --out is required")
    return 1
  end
  let outDir = FS.Path.join(out, pkg)
  let versionDir = FS.Path.join(outDir, ver)
  let _ = FS.Directory.create(versionDir)
  let files = listSourceFiles(source)
  if files.empty?
    IO.printError("docgen: no .kex files found in ${source}")
    return 1
  end
  IO.printLine("docgen: ${files.count} file(s) => ${versionDir}")
  let pages = buildPages(files, source, opts, pkg, ver)
  let generatedAt = DateTime.now().iso
  let model = buildModel(pages, opts, generatedAt)
  let modelJson = emitModelJson(model)
  let _ = FS.File.write(FS.Path.join(out, "model.json"), modelJson)
  let written = emitMarkdownPages(pages, versionDir, opts)
  emitIndexes(pages, opts, out, generatedAt)
  IO.printLine("docgen: wrote ${written} page(s) and model.json")
  return 0
end

foul buildPages(files, sourceDir, opts, pkg, ver) do
  return buildPagesLoop(files, sourceDir, opts, pkg, ver, [])
end

foul buildPagesLoop(files, sourceDir, opts, pkg, ver, pages) do
  if files.empty?
    return pages
  end
  let fileName = orEmpty(files.first)
  let rest = files.drop(1)
  let fullPath = FS.Path.join(sourceDir, fileName)
  let content = FS.File.read(fullPath).or("")
  let lines = content.split("\n")
  match Kex.AST.parseFile(fullPath) do
    Ok({ items }) => do
      let entities = walkItems(items, lines, fileName)
      let pageText = emitFilePage(fileName, entities, opts)
      let page = buildPageRecord(fileName, entities, pageText, pkg, ver)
      IO.printLine("  ok ${fileName} (${entities.count} entities)")
      return buildPagesLoop(rest, sourceDir, opts, pkg, ver, pages + [page])
    end
    Error({ message: msg }) => do
      IO.printError("  fail ${fileName}: ${msg}")
      return buildPagesLoop(rest, sourceDir, opts, pkg, ver, pages)
    end
  end
end

foul emitMarkdownPages(pages, versionDir, opts) do
  return pages.reduce(0, { |count, p|
    let outPath = FS.Path.join(versionDir, stripExt(p[:source].or("")) + ".md")
    let _ = FS.File.write(outPath, p[:content].or(""))
    count + 1
  })
end

foul buildPageRecord(fileName, entities, content, pkg, ver) do
  let baseName = stripExt(fileName)
  let title = titleCase(baseName)
  let path = FS.Path.join(pkg, ver, baseName + ".md")
  let urlPath = FS.Path.join(pkg, ver, baseName)
  let firstLine = entities.first.or({ line: 0 })[:line].or(0)
  return {
    path: path,
    url_path: urlPath,
    title: title,
    source: fileName,
    kind: "file",
    entities: entities,
    content: content,
    line: firstLine
  }
end

foul buildModel(pages, opts, generatedAt) do
  return {
    package: orEmpty(opts.get("package")),
    version: orEmpty(opts.get("version")),
    label: orEmpty(opts.get("label")),
    base_url: orEmpty(opts.get("base-url")),
    generated_at: generatedAt,
    pages: pages
  }
end

# ─────────────────────────────────────────────────────────────────────────────
# Serve driver (M3 — placeholder)
# ─────────────────────────────────────────────────────────────────────────────

foul serveCommand(opts) do
  let out = orEmpty(opts.get("out"))
  let portStr = orEmpty(opts.get("port"))
  let port = Integer.parse(portStr).or(4322)
  if out.empty?
    IO.printError("docgen: --out is required")
    return 1
  end
  let files = collectServeFiles(out, "/")
  if files.empty?
    IO.printError("docgen: no files to serve in ${out}")
    return 1
  end
  IO.printLine("docgen: serving ${files.count} file(s) on http://localhost:${port}")
  let server = files.reduce(Web.Server.new(port), { |s, f| s.get(f[:route].or(""), makeFileHandler(f[:path].or(""))) })
  match server.start() do
    Ok(_) => return 0
    Error(msg) => do
      IO.printError("docgen: server failed: ${msg}")
      return 1
    end
  end
end

foul collectServeFiles(dir, prefix) do
  let files = FS.Directory.files(dir).or([])
  let dirs = FS.Directory.directories(dir).or([])
  let fileEntries = files.map { |n| { route: FS.Path.join(prefix, n), path: FS.Path.join(dir, n) } }
  let subEntries = dirs.map { |d| collectServeFiles(FS.Path.join(dir, d), FS.Path.join(prefix, d)) }.flatten
  return fileEntries + subEntries
end

foul makeFileHandler(filePath) do
  let h : Web.Handler = { |req|
    match FS.File.read(filePath) do
      Just(content) => do
        let ct = contentTypeFor(filePath)
        return Web.Response { status: 200, headers: { "Content-Type": ct }, body: content }
      end
      None => return Web.Response.notFound()
    end
  }
  return h
end

let contentTypeFor(path) do
  if path.endsWith?(".md")
    "text/markdown; charset=utf-8"
  else
    if path.endsWith?(".json")
      "application/json"
    else
      if path.endsWith?(".xml")
        "application/xml"
      else
        "text/plain; charset=utf-8"
      end
    end
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Usage
# ─────────────────────────────────────────────────────────────────────────────

foul printUsage() do
  IO.printLine("docgen - kex documentation generator")
  IO.printLine("")
  IO.printLine("Usage:")
  IO.printLine("  kex tools/docgen/docgen.kex -- build --source <dir> --out <dir> [options]")
  IO.printLine("  kex -R tools/docgen/docgen.kex -- serve --out <dir> [--port 4322]")
  IO.printLine("")
  IO.printLine("Build options:")
  IO.printLine("  --source <dir>     source directory containing .kex files")
  IO.printLine("  --out <dir>        output directory root")
  IO.printLine("  --version <v>      version string (default: dev)")
  IO.printLine("  --package <name>   package name (default: prelude)")
  IO.printLine("  --label <text>     human-readable package label")
  IO.printLine("  --base-url <url>   site base URL for sitemap")
  IO.printLine("")
  IO.printLine("Serve options:")
  IO.printLine("  --out <dir>        directory to serve (requires BEAM backend: kex -R)")
  IO.printLine("  --port <n>         port (default: 4322)")
  return 0
end

# ─────────────────────────────────────────────────────────────────────────────
# Entry point
# ─────────────────────────────────────────────────────────────────────────────

main(args) do
  let opts = match parseArgs(args) do
    Error(error) => do
      IO.printError("docgen: ${error}\n\n${DOCGEN_OPTIONS.help}\n")
      return 1
    end
    Ok(parsed) => parsed
  end
  let cmd = orEmpty(opts.get("command"))
  if cmd == "build"
    return buildCommand(opts)
  end
  if cmd == "serve"
    return serveCommand(opts)
  end
  return printUsage()
end
