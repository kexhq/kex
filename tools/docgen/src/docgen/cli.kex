# Command-line interface for docgen: option declarations, dispatch, usage.
#
#   tey docs -- build --source src/stdlib --out <dir> \
#     --package prelude --label "Prelude" --base-url https://docs.kex.run
#
#   tey docs -- serve --out <dir> --port 4322
#
# (Directly, from this directory: kex src/main.kex -- build ..., and
# kex -R src/main.kex -- serve ... — serve needs the BEAM backend.)

module Docgen.Cli do
  # A function rather than a module-level constant: on BEAM, calling a
  # make-method (`.parse`, `.help`) on a module-level constant fails with
  # "Undefined function" — the dispatcher doesn't resolve the constant.
  foul options() -> OptionParser.OptionConfig do
    return OptionParser.define("docgen", "Generate and serve Kex documentation")
      .string("source", None, "Source directory", None, false)
      .string("out", None, "Output directory", None, false)
      .string("version", None, "Version string (default: the compiler's)", None, false)
      .string("package", None, "Package name", Just("prelude"), false)
      .string("label", None, "Human-readable package label", None, false)
      .string("base-url", None, "Documentation site base URL", Just("https://docs.kex.run"), false)
      .integer("port", None, "HTTP port", Just("4322"), false)
  end

  foul dispatch(args: [String]) -> Integer do
    match options().parse(args) do
      Error(error) => do
        let message = OptionParser.errorMessage(error)
        IO.printError("docgen: ${message}\n\n${options().help}\n")
        return 1
      end
      Ok(parsed) => runCommand(parsed)
    end
  end

  foul runCommand(parsed: OptionParser.ParsedOptions) -> Integer do
    let command = parsed.arguments.first.or("")
    if command == "build"
      return Docgen.Index.buildCommand(parsed)
    end
    if command == "serve"
      return Docgen.Serve.serveCommand(parsed)
    end
    return printUsage()
  end

  foul printUsage() -> Integer do
    IO.printLine("docgen - kex documentation generator")
    IO.printLine("")
    IO.printLine("Usage:")
    IO.printLine("  tey docs -- build --source <dir> --out <dir> [options]")
    IO.printLine("  tey docs -- serve --out <dir> [--port 4322]")
    IO.printLine("  (from this package's directory; directly: kex src/main.kex -- <command>,")
    IO.printLine("   kex -R src/main.kex -- serve ...)")
    IO.printLine("")
    IO.printLine("Build options:")
    IO.printLine("  --source <dir>     source directory containing .kex files")
    IO.printLine("  --out <dir>        output directory root")
    IO.printLine("  --version <v>      version string (default: the compiler's version)")
    IO.printLine("  --package <name>   package name (default: prelude)")
    IO.printLine("  --label <text>     human-readable package label")
    IO.printLine("  --base-url <url>   site base URL for sitemap")
    IO.printLine("")
    IO.printLine("Outputs (all derived from the canonical typed model):")
    IO.printLine("  model.json         full documentation model")
    IO.printLine("  search.json        flat search index (name/kind/signature)")
    IO.printLine("  <pkg>/<ver>/*.md   one Markdown page per source file")
    IO.printLine("  manifest.json, versions.json, llms.txt, llms-full.txt,")
    IO.printLine("  robots.txt, sitemap.xml")
    IO.printLine("")
    IO.printLine("Serve options:")
    IO.printLine("  --out <dir>        directory to serve (requires the BEAM backend:")
    IO.printLine("                     `tey docs`, or `kex -R` when run directly)")
    IO.printLine("  --port <n>         port (default: 4322)")
    return 0
  end
end
