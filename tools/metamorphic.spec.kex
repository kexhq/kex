describe("metamorphic") do
  it("emits every relation as two losslessly parsed programs") do
    var seed = 0
    while seed < relationCount * 8 do
      let item = relation(seed)
      assert(syntaxOk(item.original, "Program"), "original seed ${seed}: ${item.name}")
      assert(syntaxOk(item.changed, "Program"), "changed seed ${seed}: ${item.name}")
      seed += 1
    end
  end

  # Each reported bug the relations were written for, by the name of the
  # variant that reproduces it: a change to the variants must keep them.
  it("reaches the shape of every bug it was written for") do
    let names = (0..relationCount * 80 - 1).items.map { |seed| relation(seed).name }.uniq
    let wanted = [
      "make target written from its module",
      "module into its own file (make Tcp.Conn)",
      "argument beside extra: Any = :none",
      "argument beside extra: Any = :none in a make",
      "Integer * Float",
      "Integer == String",
      "String arm in a match on Integer",
      "unary - on String",
      "map of Integer and String",
      "map of Integer and String through put",
      "tuple pattern of two names for three",
      "return Error(7) from a function answering Integer",
      "! function on a receiver of kind 0",
      "make for undeclared Bxo",
      "return as the last expression of a function answering Integer?",
      "or with a captured String function of no parameters",
      "[a].reduce(b) { |x, y| x + y } on a type parameter",
      "count over a Float range",
      "match as a let function's name",
      "next as a foul function's name",
      "private make function called outside",
      "private secret after using",
      "frobnicate on an unannotated parameter given an Integer",
      "block as the capture ~done"
    ]
    wanted.each { |name| assert(names.contains?(name), "no variant named ${name}") }
  end

  it("places the binder inside the generated loop") do
    let item = relation(1)
    let tree = Kex.AST.parseSyntax(item.changed).try
    assert(syntaxHas(tree, "WhileExpr"))
    assert(syntaxHas(tree, "IfExpr"))
    assert(item.changed.contains?("IO.printLine(value)"))
  end

  it("turns a valid annotation into a checker rejection") do
    let item = relation(6)
    assert(item.rejectChanged)
    assert(item.original.contains?("let value: Integer"))
    assert(item.changed.contains?("Just("))
  end

  it("uses an existing spec as a seed") do
    let item = relation(8)
    assert(item.original.contains?("# if let"))
    assert(item.changed.contains?("metamorphicUnused"))
  end

  it("selects a literal node from an existing spec") do
    let item = relation(10)
    assert(item.changed.contains?("let METAMORPHIC_LITERAL = "))
    assert(item.changed.contains?("METAMORPHIC_LITERAL"))
  end

  it("moves a function to a separate source module") do
    let item = relation(9)
    assert(item.moduleSource.contains?("module MetamorphicHelper"))
    assert(item.changed.contains?("MetamorphicHelper.double"))
  end

  it("spells a nested record's make target from its module") do
    let item = relation(11)
    assert(item.original.contains?("make MetamorphicHelper.Tcp.Conn do"))
    assert(item.changed.contains?("make Tcp.Conn do"))
    assert(item.changed.contains?("let getLine -> String? = Just(\"line \${@id}\")"))
  end

  it("moves a module with a make block into its own file, both spellings") do
    let relative = relation(12)
    let qualified = relation(12 + relationCount)
    assert(relative.moduleSource.startsWith?("module MetamorphicHelper\n"))
    assert(relative.moduleSource.contains?("make Tcp.Conn do"))
    assert(qualified.moduleSource.contains?("make MetamorphicHelper.Tcp.Conn do"))
    assert(relative.changed.contains?("using MetamorphicHelper"))
    assert(!relative.changed.contains?("module MetamorphicHelper"))
  end

  it("refuses a wrong argument beside every lenient parameter") do
    let variants = (0..lenientParameters.count * 2 - 1).items.map do |variant|
      relation(13 + variant * relationCount)
    end
    assert(variants.all? { |item| item.rejectChanged })
    assert(variants.map { |item| item.name }.uniq.count == variants.count)
    assert(variants.any? { |item| item.changed.contains?("MetamorphicBox {}.tag(:owner, 2 + 5") })
    assert(variants.any? { |item| item.original.contains?("tag(:owner, true, more: 1)") })
  end

  it("rewrites a plain call with an extra argument or none") do
    assert(extraArgument("add(1, 2)") == ["add(1, 2, 0)"])
    assert(extraArgument("Time.now()") == ["Time.now(0)"])
    assert(extraArgument("items.map { |x| x }") == [])
    assert(droppedArguments("add(1, 2)") == ["add()"])
    assert(droppedArguments("IO.printLine(1)") == [])
  end

  it("wraps, unwraps and retypes literals") do
    assert(wrappedInJust("7") == ["Just(7)"])
    assert(otherLiteral("\"a\"") == ["7"])
    assert(otherLiteral("7") == ["\"kex\""])
    assert(unwrappedJust("Just(x + 1)") == ["x + 1"])
  end

  it("drops one single-line arm of a match at a time") do
    let text = ["match n do", "  0 => \"zero\"", "  1 => \"one\"", "  _ => \"many\"", "end"].join("\n")
    let variants = withoutAnArm(text)
    assert(variants.count == 3)
    assert(!variants.first.or("").contains?("0 =>"))
    assert(variants.first.or("").contains?("_ =>"))
    assert(withoutAnArm(["match n do", "  _ => 1", "end"].join("\n")) == [])
  end

  it("finds runnable specs and a site for every mutation") do
    let files = corpus
    assert(files.count > 100)
    assert(!files.any? { |path| path.contains?("/error_") })
    var seed = 0
    while seed < mutations.count do
      assert(mutationCase(seed, files).set?, "no site for mutation ${seed}")
      seed += 1
    end
  end

  it("leaves known-open relations out without repeating a case") do
    let seeds = (0..43).items.map { |seed| searchedRelation(seed, false) }
    assert(!seeds.any? { |seed| knownOpen.contains?(seed % relationCount) })
    assert(seeds.uniq.count == seeds.count)
    assert(searchedRelation(11, true) == 11)
  end
end
