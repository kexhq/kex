# Metamorphic compiler checks. A rule relates two programs whose observable
# behavior must agree, or turns a valid program into one the checker must
# reject. The runner uses the walker so a BEAM lowering bug cannot break the
# test driver itself.
#
# make test-metamorphic gates the currently passing rules. make
# metamorphic-search runs all rules, including the known open failures in
# expression-position assignment (#614) and Optional type compatibility
# (#611). Every case and its compiler result are saved under the output dir.
# A seed selects a rule modulo eleven and a value from the expression corpus.

using FS
using Kex.AST

record Relation do
  name : String
  original : String
  changed : String
  rejectChanged : Bool
  moduleSource : String = ""
  eligibleSites : Integer = 1
end

let program(body: String) -> String = "main do\n${body}end\n"

let expressions -> [String] = [
  "7",
  "2 + 5",
  "(3 * 4) - 5",
  "[2, 5].at(1).or(0)"
]

let expressionAt(seed: Integer) -> String do
  let values = expressions
  values.at(seed % values.length).or("7")
end

# Pull actual expression nodes from the lossless tree. A literal is eligible
# only when its spelling occurs once in the file, so a source replacement
# cannot accidentally change a comment, another literal or an identifier.
let integerLiterals(node: SyntaxNode) -> [String] do
  if node.kind == "IntLiteral" return [Kex.AST.toSource(node).trim] end
  var found = []
  node.children.each do |element|
    match element do
      NodeElement(child) => found = [...found, ...integerLiterals(child)]
      TokenElement(_) => found = found
    end
  end
  found
end

foul literalBindingRelation(seed: Integer) -> Relation do
  let sourcePath = match seed % 33 do
    10 => "examples/fizzbuzz_simple.kex"
    21 => "examples/fizzbuzz_functional.kex"
    _ => "examples/qsort_part.kex"
  end
  let source = FS.File.read(sourcePath).or("")
  let tree = Kex.AST.parseSyntax(source).try
  let candidates = integerLiterals(tree).filter { |text| text != "" && source.split(text).length == 2 }
  let literal = candidates.at(0).or("")
  let changed = if literal == "" then "" else
    "let METAMORPHIC_LITERAL = ${literal}\n" + source.replace(literal, "METAMORPHIC_LITERAL")
  end
  Relation {
    name: "bind unique literal in ${sourcePath}",
    original: source,
    changed: changed,
    rejectChanged: false,
    eligibleSites: candidates.length
  }
end

foul relation(seed: Integer) -> Relation do
  let value = expressionAt(seed)
  match seed % 11 do
    0 => Relation {
      name: "assignment as value",
      original: program("  var value = 0\n  value = ${value}\n  IO.printLine(value)\n"),
      changed: program("  var value = 0\n  IO.printLine(value = ${value})\n"),
      rejectChanged: false
    }
    1 => Relation {
      name: "if let in one iteration",
      original: program("  if let Ok(value) = Ok(${value})\n    IO.printLine(value)\n  end\n"),
      changed: program("  var once = true\n  while once do\n    if let Ok(value) = Ok(${value})\n      IO.printLine(value)\n    end\n    once = false\n  end\n"),
      rejectChanged: false
    }
    2 => Relation {
      name: "introduce binding",
      original: program("  IO.printLine(${value})\n"),
      changed: program("  let metamorphicValue = ${value}\n  IO.printLine(metamorphicValue)\n"),
      rejectChanged: false
    }
    3 => Relation {
      name: "annotate inferred parameter",
      original: "let increment(value) = value + 1\n" + program("  IO.printLine(increment(${value}))\n"),
      changed: "let increment(value: Integer) = value + 1\n" + program("  IO.printLine(increment(${value}))\n"),
      rejectChanged: false
    }
    4 => Relation {
      name: "supply default explicitly",
      original: "let add(a: Integer, b: Integer = 3) = a + b\n" + program("  IO.printLine(add(${value}))\n"),
      changed: "let add(a: Integer, b: Integer = 3) = a + b\n" + program("  IO.printLine(add(${value}, 3))\n"),
      rejectChanged: false
    }
    5 => Relation {
      name: "reorder independent declarations",
      original: "let first(value: Integer) = value + 1\nlet second(value: Integer) = value * 2\n" + program("  IO.printLine(first(second(${value})))\n"),
      changed: "let second(value: Integer) = value * 2\nlet first(value: Integer) = value + 1\n" + program("  IO.printLine(first(second(${value})))\n"),
      rejectChanged: false
    }
    6 => Relation {
      name: "incompatible optional substitution",
      original: program("  let value: Integer = ${value}\n  IO.printLine(value)\n"),
      changed: program("  let value: Integer = Just(${value})\n  IO.printLine(value)\n"),
      rejectChanged: true
    }
    7 => Relation {
      name: "brace and do block",
      original: program("  [(\"C\", ${value} + 1)].each { |label, number| IO.printLine(number) }\n"),
      changed: program("  [(\"C\", ${value} + 1)].each do |label, number|\n    IO.printLine(number)\n  end\n"),
      rejectChanged: false
    }
    9 => Relation {
      name: "move function into module",
      original: "let double(value: Integer) = value * 2\n" + program("  IO.printLine(double(${value}))\n"),
      changed: "using MetamorphicHelper\n" + program("  IO.printLine(MetamorphicHelper.double(${value}))\n"),
      rejectChanged: false,
      moduleSource: "module MetamorphicHelper\nlet double(value: Integer) = value * 2\n"
    }
    10 => literalBindingRelation(seed)
    _ => do
      let sourcePath = match seed % 33 do
        8 => "spec/if_let.kex"
        19 => "spec/if_let_binding_scope.kex"
        _ => "spec/record_pattern_named.kex"
      end
      let source = FS.File.read(sourcePath).or("")
      let original = Kex.AST.parseSyntax(source).map { |tree| Kex.AST.toSource(tree) }.or("")
      Relation {
        name: "unused declaration in ${sourcePath}",
        original: original,
        changed: "let metamorphicUnused(text: String) = text.contains?(\"x\")\n" + original,
        rejectChanged: false
      }
    end
  end
end

let syntaxHas(node: SyntaxNode, wanted: String) -> Bool do
  if node.kind == wanted then return true end
  node.children.any? { |element| match element do
    NodeElement(child) => syntaxHas(child, wanted)
    TokenElement(_) => false
  end }
end

let syntaxOk(source: String, wanted: String) -> Bool do
  match Kex.AST.parseSyntax(source) do
    Ok(tree) => Kex.AST.toSource(tree) == source && (wanted == "" || syntaxHas(tree, wanted))
    Error(_) => false
  end
end

let outcomeText(result) -> String = match result do
  Ok(value) => "exit=${value.exitCode}\nstdout:\n${value.stdout}\nstderr:\n${value.stderr}"
  Error(error) => "error=${error}"
end

let succeeded(result) -> Bool = match result do
  Ok(value) => value.exitCode == 0
  Error(_) => false
end

let output(result) -> String = match result do
  Ok(value) => value.stdout
  Error(_) => ""
end

foul check(kex: String, path: String, mode: String, budget: Integer,
  root: String) do
  Process.run(kex, [mode, "--no-colors", "--source-root", root, path], budget)
end

foul save(path: String, value: String) -> Bool = FS.File.write(path, value).ok?

foul runRelation(kex: String, outDir: String, seed: Integer,
  budget: Integer) -> Bool do
  let item = relation(seed)
  let root = "${outDir}/case_${seed}"
  if !FS.Directory.exists?(root) && !FS.Directory.create(root)
    IO.printError("metamorphic: cannot create ${root}")
    return false
  end
  let oldFinding = "${root}/finding.txt"
  if FS.File.file?(oldFinding) then FS.File.delete(oldFinding) end
  let before = "${root}/before.kex"
  let after = "${root}/after.kex"
  if !save(before, item.original) || !save(after, item.changed)
    IO.printError("metamorphic: cannot write case ${seed}")
    return false
  end
  if item.moduleSource != "" && !save("${root}/metamorphichelper.kex", item.moduleSource)
    IO.printError("metamorphic: cannot write module for case ${seed}")
    return false
  end
  let moduleSyntax = item.moduleSource == "" || syntaxOk(item.moduleSource, "Program")
  let syntax = syntaxOk(item.original, "Program") && syntaxOk(item.changed, "Program") && moduleSyntax
  let beforeCheck = check(kex, before, "-C", budget, root)
  let afterCheck = check(kex, after, "-C", budget, root)
  let expectedCheck = if item.rejectChanged then !succeeded(afterCheck) else succeeded(afterCheck) end
  let checksPass = syntax && item.eligibleSites > 0 && succeeded(beforeCheck) && expectedCheck
  if item.rejectChanged
    if checksPass
      IO.printLine("PASS seed ${seed}: ${item.name} (${item.eligibleSites} eligible)")
      return true
    end
    let checkDetails = "seed=${seed}\nrule=${item.name}\neligibleSites=${item.eligibleSites}\nsyntax=${syntax}\nbefore check:\n${outcomeText(beforeCheck)}\nafter check:\n${outcomeText(afterCheck)}\n"
    save("${root}/finding.txt", checkDetails)
    IO.printLine("FAIL seed ${seed}: ${item.name} (${root})")
    return false
  end
  let beforeWalker = check(kex, before, "--run-walker", budget, root)
  let beforeBeam = check(kex, before, "--run", budget, root)
  let afterWalker = check(kex, after, "--run-walker", budget, root)
  let afterBeam = check(kex, after, "--run", budget, root)
  let exitsPass = succeeded(beforeWalker) && succeeded(beforeBeam) && succeeded(afterWalker) && succeeded(afterBeam)
  let outputsPass = output(beforeWalker) == output(beforeBeam) && output(beforeWalker) == output(afterWalker) && output(beforeWalker) == output(afterBeam)
  let passed = checksPass && exitsPass && outputsPass
  if passed
    IO.printLine("PASS seed ${seed}: ${item.name} (${item.eligibleSites} eligible)")
    return true
  end
  var details = "seed=${seed}\nrule=${item.name}\neligibleSites=${item.eligibleSites}\nsyntax=${syntax}\n"
  details = details + "before check:\n${outcomeText(beforeCheck)}\nafter check:\n${outcomeText(afterCheck)}\n"
  details = details + "before walker:\n${outcomeText(beforeWalker)}\nbefore beam:\n${outcomeText(beforeBeam)}\n"
  details = details + "after walker:\n${outcomeText(afterWalker)}\nafter beam:\n${outcomeText(afterBeam)}\n"
  save("${root}/finding.txt", details)
  IO.printLine("FAIL seed ${seed}: ${item.name} (${root})")
  false
end

foul drive(kex: String, outDir: String, seed: Integer, count: Integer,
  budget: Integer, gated: Bool) -> Integer do
  if !FS.Directory.exists?(outDir) && !FS.Directory.create(outDir)
    IO.printError("metamorphic: cannot create ${outDir}")
    return 2
  end
  let version = Process.run(kex, ["--version"], budget)
  let mode = if gated then "gate" else "search" end
  let metadata = "seed=${seed}\ncases=${count}\nmode=${mode}\ncompiler=${kex}\n${outcomeText(version)}\n"
  if !succeeded(version) || !save("${outDir}/run.txt", metadata)
    IO.printError("metamorphic: cannot record compiler preflight")
    return 2
  end
  var failed = 0
  var index = 0
  let gateSeeds = [1, 2, 3, 4, 5, 7, 8, 9, 10]
  while index < count do
    let caseSeed = if gated then gateSeeds.at(index).or(-1) else seed + index end
    if !runRelation(kex, outDir, caseSeed, budget)
      failed += 1
    end
    index += 1
  end
  IO.printLine("${count} relations, ${failed} findings")
  if failed == 0 then 0 else 1 end
end

main(args) do
  let seed = Integer.parse(args.at(0).or("2")).or(-1)
  let count = Integer.parse(args.at(1).or("11")).or(0)
  let kex = args.at(2).or("./build/kex")
  let outDir = args.at(3).or("/tmp/kex-metamorphic")
  let budget = Integer.parse(args.at(4).or("15000")).or(0)
  let mode = args.at(5).or("search")
  let badMode = (mode != "search" && mode != "gate") || (mode == "gate" && count > 9)
  if seed < 0 || count < 1 || budget < 1 || args.length > 6 || badMode
    IO.printError("usage: metamorphic [seed] [cases] [kex] [out dir] [timeout ms] [search|gate]")
    return System.exit(2)
  end
  System.exit(drive(kex, outDir, seed, count, budget, mode == "gate"))
end
