# Describes the generated reference to the docs site that frames it.
#
# docgen documents ONE unit per run (the stdlib, Tey) and, with
# `--format fragments`, writes that unit as page bodies under
# `<out>/<package>/<version>/`. The site itself — landing page, guide,
# navigation, theme — is authored in Marqraft in the kexhq/docs repository,
# which mounts this output as generated, read-only pages. This tool is the
# handover: after every docgen run it reads what is on disk and writes
#
#   manifest.json               the mounts Marqraft loads: one per
#                               (package, version); the release a reader
#                               should land on is listed in the site's
#                               collections menu, the others are built and
#                               linkable but unlisted
#   _versions/<package>/        a generated "versions" page per package,
#                               mounted at /<package>/
#
# The site-wide files (llms.txt, sitemap.xml, CNAME) belong to the site and
# are written by kexhq/docs after its build, not here.
#
#   tey run --package docsite -- manifest <generated-dir>

main(args) do
  let command = args.first.or("")
  let site = args.second.or("")
  if command != "manifest" || site.empty?
    IO.printError("docsite: usage: docsite manifest <generated-dir>")
    return System.exit(1)
  end
  if !FS.File.directory?(site)
    IO.printError("docsite: ${site} is not a directory")
    return System.exit(1)
  end
  let units = readUnits(site)
  if units.empty?
    IO.printError("docsite: no <package>/<version>/manifest.json under ${site} — did the docgen builds run?")
    return System.exit(1)
  end
  let listed = listedVersions(units)
  let packages = units.map { |unit| unit.package }.uniq
  packages.each { |package| writeVersionsPage(site, package, units, listed) }
  let mounts = units.map { |unit| mountValue(unit, listed) } + packages.map { |package| versionsMount(package) }
  let manifest: Any = { mounts: mounts }
  let _ = FS.File.write(FS.Path.join(site, "manifest.json"), JSON.stringify(manifest))
  IO.printLine("docsite: ${units.count} unit(s), ${pageCount(units)} page(s); listed ${listed.map { |l| "${l.package} ${l.version}" }.join(", ")}")
  return System.exit(0)
end

foul mountValue(unit: Unit, listed: [Latest]) -> Any do
  let value: Any = {
    dir: "${unit.package}/${unit.version}",
    title: unit.label,
    listed: listed.any? { |l| l.package == unit.package && l.version == unit.version }
  }
  return value
end

foul versionsMount(package: String) -> Any do
  let value: Any = { dir: "_versions/${package}", listed: false }
  return value
end

# The version each package's collection link opens: its newest release, or
# — for a package that has not released anything yet — its newest build.
foul listedVersions(units: [Unit]) -> [Latest] do
  let stable = latestStableVersions(units)
  let packages = units.map { |unit| unit.package }.uniq
  return packages.flatMap { |package|
    match stable.find { |l| l.package == package } do
      Just(found) => [found]
      None => newestBuild(units, package)
    end
  }
end

foul newestBuild(units: [Unit], package: String) -> [Latest] do
  let mine = units.filter { |unit| unit.package == package }
  match mine.first do
    None => []
    Just(first) => do
      let newest = mine.reduce(first, { |best, unit| unit.generatedAt > best.generatedAt then unit else best })
      [Latest { package: package, version: newest.version }]
    end
  end
end

# /<package>/: every published version of one package, newest release
# first. A generated page like the reference itself, so the site frames it.
foul writeVersionsPage(site: String, package: String, units: [Unit], listed: [Latest]) -> () do
  let dir = FS.Path.join(FS.Path.join(site, "_versions"), package)
  let _ = FS.Directory.create(dir)
  let mine = units.filter { |unit| unit.package == package }.sort { |a, b| a.generatedAt > b.generatedAt }
  let label = mine.first.map { |unit| unit.label }.or(package)
  let items = mine.map { |unit|
    let mark = listed.any? { |l| l.package == package && l.version == unit.version } then " <span class=\"tag-prelude\">current</span>" else ""
    "<a class=\"card\" href=\"/${package}/${unit.version}/\"><span class=\"card-title\">${esc(unit.label)} ${esc(unit.version)}${mark}</span><span class=\"card-meta\">generated ${esc(unit.generatedAt.take(10))} · ${unit.pages.count} page(s)</span></a>"
  }.join("\n")
  let body = "<p class=\"lede\">Every published build of the ${esc(label)} reference, newest first. Versions ending in <code>-dev</code> are unreleased snapshots.</p>\n<div class=\"cards\">\n${items}\n</div>\n"
  let _ = FS.File.write(FS.Path.join(dir, "index.html"), body)
  let sidecar: Any = {
    title: "${label} versions",
    description: "Every published version of the ${label} reference.",
    path: "/${package}/",
    template: "page",
    body: "index.html",
    data: { package: package }
  }
  let _ = FS.File.write(FS.Path.join(dir, "index.page.json"), JSON.stringify(sidecar))
  let nav: Any = { title: "${label} versions", path: "/${package}/", children: [] }
  let _ = FS.File.write(FS.Path.join(dir, "nav.json"), JSON.stringify(nav))
  return ()
end

foul esc(s: String) -> String do
  return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
end

# One documented unit, as its own manifest describes it.
record Unit do
  package : String
  version : String
  label : String
  generatedAt : String
  pages : [Page]
end

record Page do
  path : String
  title : String
end

# --- reading what docgen left -------------------------------------------

# `<site>/<package>/<version>/manifest.json`, for every package and version
# present. A directory without one is skipped rather than reported: the site
# root also holds assets/ and the odd stray file.
foul readUnits(site: String) -> [Unit] do
  let packages = FS.Directory.directories(site).or([]).filter { |d| d != "assets" && !d.startsWith?("_") }.sort
  return packages.flatMap { |package| unitsOf(site, package) }
end

foul unitsOf(site: String, package: String) -> [Unit] do
  let packageDir = FS.Path.join(site, package)
  let versions = FS.Directory.directories(packageDir).or([]).sort
  return versions.flatMap { |version| unitOf(packageDir, package, version) }
end

# A list of nought or one, so the caller can flatMap the misses away.
foul unitOf(packageDir: String, package: String, version: String) -> [Unit] do
  let path = FS.Path.join(FS.Path.join(packageDir, version), "manifest.json")
  match FS.File.read(path) do
    Error(_) => []
    Ok(text) => match JSON.parse(text) do
      Error(_) => do
        IO.printError("docsite: skip ${package}/${version} (unreadable manifest.json)")
        return []
      end
      Ok(value) => [unitOfJson(value, package, version)]
    end
  end
end

# Parsed JSON arrives as ordinary Kex values — an object is a Map, an array a
# List — so the fields are read positionally with `[...]` and defaulted, the
# same way docgen reads versions.json.
foul unitOfJson(value: Any, package: String, version: String) -> Unit do
  return Unit {
    package: jsonText(value["package"], package),
    version: jsonText(value["version"], version),
    label: jsonText(value["label"], package),
    generatedAt: jsonText(value["generatedAt"], ""),
    pages: pagesOf(value)
  }
end

foul pagesOf(value: Any) -> [Page] do
  match value["pages"] do
    None => []
    Just(items) => items.map { |item|
      Page { path: jsonText(item["path"], ""), title: jsonText(item["title"], "") }
    }
  end
end

foul jsonText(value: Any?, fallback: String) -> String do
  match value do
    None => fallback
    Just(v) => "${v}"
  end
end

# What readers should cite, per package: its highest released version.
# Snapshots (`-dev`) and versions that do not parse never outrank a release.
record Latest do
  package : String
  version : String
end

record SemVer do
  major : Integer
  minor : Integer
  patch : Integer
  pre : String
end

foul latestStableVersions(units: [Unit]) -> [Latest] do
  return latestLoop(units, [])
end

foul latestLoop(units: [Unit], found: [Latest]) -> [Latest] do
  match units.first do
    None => found
    Just(unit) => do
      let rest = units.drop(1)
      if found.map { |l| l.package }.contains?(unit.package)
        return latestLoop(rest, found)
      end
      return latestLoop(rest, found + latestFor(units, unit.package))
    end
  end
end

foul latestFor(units: [Unit], package: String) -> [Latest] do
  let releases = units
    .filter { |unit| unit.package == package }
    .map { |unit| unit.version }
    .reject { |version| version.endsWith?("-dev") }
  match releases.reduce(None, { |best, version| newerRelease(best, version) }) do
    None => []
    Just(version) => [Latest { package: package, version: version }]
  end
end

foul newerRelease(best: String?, version: String) -> String? do
  match parseRelease(version) do
    None => best
    Just(v) => match best do
      None => Just(version)
      Just(current) => match parseRelease(current) do
        None => Just(version)
        Just(c) => greaterSemVer(v, c) then Just(version) else best
      end
    end
  end
end

foul parseRelease(text: String) -> SemVer? do
  let core = text.split("-").first.or("")
  let pre = text.split("-").drop(1).join("-")
  let parts = core.split(".")
  match Integer.parse(parts.at(0).or("")) do
    Error(_) => None
    Ok(major) => match Integer.parse(parts.at(1).or("0")) do
      Error(_) => None
      Ok(minor) => match Integer.parse(parts.at(2).or("0")) do
        Error(_) => None
        Ok(patch) => Just(SemVer { major: major, minor: minor, patch: patch, pre: pre })
      end
    end
  end
end

foul greaterSemVer(a: SemVer, b: SemVer) -> Bool do
  return true if a.major > b.major
  return false if a.major < b.major
  return true if a.minor > b.minor
  return false if a.minor < b.minor
  return true if a.patch > b.patch
  return false if a.patch < b.patch
  # Same numbers: a release beats any pre-release of it. Two different
  # pre-releases keep whatever came first — precise pre-release ordering is
  # a version-solver's job, not a docs assembler's.
  return false if a.pre == b.pre
  return true if a.pre == ""
  return false
end

foul pageCount(units: [Unit]) -> Integer do
  return units.map { |unit| unit.pages.count }.reduce(0, { |a, b| a + b })
end
