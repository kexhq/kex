# Parser combinators using .try / rescue / trying
# Parses simple arithmetic expressions like "3 + 42 * 5"

type ParseError = Unexpected(String, Int) | NoMatch(Int)

type Expr
  = IntLit(Int)
  | BinOp(String, Expr, Expr)

record Parser do
  input : String
  pos   : Int = 0
end

make Parser do
  let peek = @pos < @input.count then Just(@input.at(@pos)) else None

  let advance = Parser { input: @input, pos: @pos + 1 }

  let remaining = @input.slice(@pos, @input.count)

  let charWhen(pred: Char -> Bool) -> Result<(Char, Parser), ParseError> do
    match this.peek do
      Just(c) when pred(c) -> Ok((c, this.advance))
      Just(c) -> Error(Unexpected("${c}", @pos))
      None    -> Error(Unexpected("EOF", @pos))
    end
  end

  let ws -> Parser do
    var p = this
    while p.peek == Just(' ')
      p = p.advance
    end
    p
  end

  # --- Combinators ---

  let many(f: Parser -> Result<(a, Parser), ParseError>) -> ([a], Parser) do
    var results: [a] = []
    var p = this
    loop
      trying do
        let (v, p2) = f(p).try
        results.push!(v)
        p = p2
      rescue return (results, p)
      end
    end
  end

  let some(f: Parser -> Result<(a, Parser), ParseError>) -> ([a], Parser) or! ParseError do
    let (first, p) = f(this).try
    let (rest, p2) = p.many(f)
    Ok(([first, ...rest], p2))
  end

  let choice(alts: [Parser -> Result<(a, Parser), ParseError>]) -> (a, Parser) or! ParseError do
    var i = 0
    loop
      break if i >= alts.count
      trying do
        let result = alts.at(i)(this).try
        return Ok(result)
      rescue
        _ -> i = i + 1
      end
    end
    Error(NoMatch(@pos))
  end

  # --- Parsers ---

  let integer -> (Expr, Parser) or! ParseError do
    let p = this.ws
    let (digits, p2) = p.some { |p| p.charWhen(&.digit?) }.try
    let n = Integer.parse(digits.join(""))
    match n do
      Just(v) -> Ok((IntLit(v), p2))
      None -> Error(Unexpected("not a number", p.pos))
    end
  end

  let operator -> (String, Parser) or! ParseError do
    let p = this.ws
    p.choice([
      { |p| let (_, p2) = p.charWhen { |c| c == '+' }.try; Ok(("+", p2)) },
      { |p| let (_, p2) = p.charWhen { |c| c == '-' }.try; Ok(("-", p2)) },
      { |p| let (_, p2) = p.charWhen { |c| c == '*' }.try; Ok(("*", p2)) },
    ])
  end

  let expression -> (Expr, Parser) or! ParseError do
    let (left, p) = this.integer.try
    trying do
      let (op, p2) = p.operator.try
      let (right, p3) = p2.expression.try
      Ok((BinOp(op, left, right), p3))
    rescue
      _ -> Ok((left, p))
    end
  end
end

let formatExpr(e: Expr) -> String do
  match e do
    IntLit(n) -> "${n}"
    BinOp(op, l, r) -> "(${formatExpr(l)} ${op} ${formatExpr(r)})"
  end
end

main do
  let inputs = ["42", "3 + 5", "1 + 2 * 3", "10 - 7 + 2"]

  inputs.each do |input|
    let p = Parser { input: input }
    match p.expression do
      Ok((expr, _)) -> IO.printLine("${input} => ${formatExpr(expr)}")
      Error(e) -> IO.printLine("${input} => error: ${e}")
    end
  end
end
