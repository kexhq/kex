# FizzBuzz in Kex — demonstrating pattern matching and functional programming
let fizzBuzz(n: Integer) -> String do
  match (n.dividesBy?(3), n.dividesBy?(5)) do
    (true, true) => "FizzBuzz"
    (true, _) => "Fizz"
    (_, true) => "Buzz"
    (_, _) => n.to(String).or("")
  end
end

main do
  (1..100).map(&.fizzBuzz).each { |s| IO.printLine(s) }
end