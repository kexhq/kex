using FS

foul createTocFor(file_name: String) do
  let lines = FS.File.lines(file_name).or([])
  let heads = lines.filter(&.startsWith?("#"))

  IO.printLine("heads:")
  IO.inspect(heads)
end


main(args) do
  if args.count < 1
    IO.printError("usage: toc file.md")
    return 1
  end

  createTocFor(args.at(0).or(""))
end
