# Mode-safe file handles
#
# The mode passed to FS.File.open determines which methods the returned
# FileHandle exposes. Mock.FS keeps this example self-contained — and since
# Mock.* is test-only, run it as:
#   kex --allow-mocks examples/file_modes.kex

using FS

# Put capability requirements in helper signatures. Any readable handle can
# call readAll; any writable handle can call writeText.
#
# `writeText` names the TRAIT rather than the handle type, so it also accepts
# `IO.out` and anything else that implements `Writable` (kexhq/kex#139).
foul readAll(file: FileHandle<CanRead, W>) -> String do
  file.read().or("")
end

foul writeText(file: Writable, text: String) -> Void do
  file.write(text)
end

# Opening returns Result<FileHandle<...>, FileError>. `.try` unwraps the
# specialized handle, and `trying` supplies a recovery path.
foul readOrMissing(path: String) -> String do
  trying do
    let file = FS.File.open(path, FS.Read).try
    let content = readAll(file)
    file.close()
    content
  rescue
    OpenFailed(_) => "(missing)"
  end
end

main do
  Mock.FS.File("file_modes.txt", "first line\nsecond line\n")

  # Read produces FileHandle<CanRead, CannotWrite>.
  let reader = FS.File.open("file_modes.txt", FS.Read).try
  IO.printLine("read: ${readAll(reader)}")
  reader.close()

  # This would be a compile-time error, both directly and through the helper:
  # reader.write("not allowed")
  # writeText(reader, "not allowed")

  # Write produces FileHandle<CannotRead, CanWrite> and truncates the file.
  let writer = FS.File.open("file_modes.txt", FS.Write).try
  writeText(writer, "rewritten\n")
  writer.close()

  # This would also be a compile-time error:
  # writer.read()
  # readAll(writer)

  # Append is write-only but preserves the existing contents.
  let appender = FS.File.open("file_modes.txt", FS.Append).try
  appender.writeLine("appended")
  appender.close()

  # ReadWrite exposes both sets of operations.
  let editable = FS.File.open("file_modes.txt", FS.ReadWrite).try
  IO.printLine("before edit: ${readAll(editable)}")
  writeText(editable, "written through ReadWrite\n")
  editable.close()

  let finalReader = FS.File.open("file_modes.txt", FS.Read).try
  IO.printLine("final: ${finalReader.read().or("")}")
  finalReader.close()

  IO.printLine(readOrMissing("does-not-exist.txt"))

  # A block form opens, runs, and closes — no `close` to forget. `Ok` carries
  # whatever the block returned.
  let lineCount = FS.File.open("file_modes.txt", FS.Read) do |file|
    readAll(file).lines.length
  end
  IO.printLine("lines: ${lineCount}")

  # The standard streams are handles too, so the same helper serves them.
  writeText(IO.out, "written to stdout through the same helper\n")

  Mock.FS.clear()
end
