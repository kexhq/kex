# .try / rescue / trying — error handling without exceptions

# --- Basic .try on Result ---

let divide(a: Int, b: Int) -> Result<Int, String> do
  if b == 0
    Error("division by zero")
  else
    Ok(a / b)
  end
end

# .try with function-level rescue
let safeDivide(a: Int, b: Int) -> String do
  let result = divide(a, b).try
  "result: ${result}"
rescue
  e => "error: ${e}"
end

# --- .try on Option ---

let getFirst(list: [Int]) -> String do
  let val = trying do
    let head = list.first.try
    "found: ${head * 10}"
  rescue
    _ => "empty"
  end
  val
end

# --- trying do ... rescue ... end ---

let tryDivisions(a: Int, divisors: [Int]) -> [String] do
  var results: [String] = []
  divisors.each do |d|
    trying do
      let r = divide(a, d).try
      results.push!("${a}/${d} = ${r}")
    rescue
      e => results.push!("${a}/${d} failed: ${e}")
    end
  end
  results
end

# --- rescue return (inline shorthand) ---

let safeGetFirst(items: [Int]) -> Int do
  trying do
    items.first.try
  rescue return -1
  end
end

# --- rescue do |e| ... end (catch-all block) ---

let verboseDivide(a: Int, b: Int) -> String do
  let r = divide(a, b).try
  "ok: ${r}"
rescue do |e|
  "caught: ${e}"
end
end

# --- Nested trying ---

let nested(a: Int, b: Int) -> String do
  trying do
    trying do
      divide(a, b).try
      "inner ok"
    rescue
      _ => "inner caught"
    end
  rescue
    _ => "outer caught"
  end
end

main do
  IO.printLine(safeDivide(10, 2))
  IO.printLine(safeDivide(10, 0))

  IO.printLine(getFirst([42]))
  IO.printLine(getFirst([]))

  let results = tryDivisions(100, [5, 0, 10])
  results.each do |r|
    IO.printLine(r)
  end

  IO.printLine("first: ${safeGetFirst([10, 20, 30])}")
  IO.printLine("first: ${safeGetFirst([])}")

  IO.printLine(verboseDivide(10, 2))
  IO.printLine(verboseDivide(10, 0))

  IO.printLine(nested(10, 2))
  IO.printLine(nested(10, 0))
end
