# Declarative command-line parsing through the shared prelude OptionParser.

let OPTIONS = OptionParser.define("myapp", "A sample CLI application")
  .string("name", Just('n'), "Your name", None, true)
  .integer("port", Just('p'), "Port to listen on", Just("3000"), false)
  .flag("verbose", Just('v'), "Enable verbose output")

main(args) do
  match OPTIONS.parse(args) do
    Ok(options) -> do
      IO.printLine("Parsed options:")
      IO.printLine("  name:    ${options.value("name", "")}")
      IO.printLine("  port:    ${options.integerValue("port").or(3000)}")
      IO.printLine("  verbose: ${options.flagEnabled?("verbose")}")
    end
    Error(error) -> IO.printError("Error: ${OptionParser.errorMessage(error)}\n\n${OPTIONS.help}\n")
  end
end
