# Multi-file project: cross-file using with convention-based resolution
# Math.Vec2 → lib/math/vec2.kex
# Math.Shapes → lib/math/shapes.kex

using Math.Vec2, only: [Vec2, add, scaleVec, vecLength, dot]
using Math.Shapes, only: [Circle, Rect, circleArea, rectArea]

main do
  let a = Vec2 { x: 1.0, y: 2.0 }
  let b = Vec2 { x: 3.0, y: 4.0 }
  let sum = add(a, b)
  IO.printLine("add: (" + sum.x.to(String).or("") + ", " + sum.y.to(String).or("") + ")")

  let scaled = scaleVec(a, 3.0)
  IO.printLine("scale: (" + scaled.x.to(String).or("") + ", " + scaled.y.to(String).or("") + ")")

  IO.printLine("length: " + vecLength(b).to(String).or(""))
  IO.printLine("dot: " + dot(a, b).to(String).or(""))

  let c = Circle { radius: 5.0 }
  IO.printLine("circle area: " + circleArea(c).to(String).or(""))

  let r = Rect { width: 4.0, height: 6.0 }
  IO.printLine("rect area: " + rectArea(r).to(String).or(""))
end
