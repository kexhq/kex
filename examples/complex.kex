# Complex numbers: arithmetic, the rectangular and polar views, and functions.
#
# Complex is opt-in, so the file opens with `using Complex`.

using Complex

main do
  let z = Complex.of(3, 4)
  let w = Complex.of(1, -2)
  IO.printLine("z = ${z}")
  IO.printLine("w = ${w}")
  IO.printLine("z + w = ${z + w}")
  IO.printLine("z * w = ${z * w}")
  IO.printLine("conjugate(z) = ${z.conjugate}")

  # One number, two views: rectangular parts, or magnitude and angle.
  let (re, im) = z.rectangular
  IO.printLine("rectangular(z) = ${re}, ${im}")
  let (radius, theta) = z.polar
  IO.printLine("polar(z) = ${radius}, ${theta}")

  # Building from the polar view lands back on z.
  IO.printLine("round-trip error = ${(Complex.fromPolar(radius, theta) - z).abs}")
  IO.printLine("fromPolar(3, 0) = ${Complex.fromPolar(3, 0)}")

  # i squared is -1, and e^(i * pi) + 1 is 0: Euler's identity.
  IO.printLine("i * i = ${Complex.I * Complex.I}")
  let euler = (Complex.I * Math.PI).exp + 1
  IO.printLine("|e^(i * pi) + 1| = ${euler.abs}")
end
