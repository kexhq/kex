# Complex numbers: rectangular arithmetic, polar form, and functions.
#
# Complex is opt-in, so the file opens with `using Complex`.

using Complex

main do
  let z = Rectangular { re: 3, im: 4 }
  let w = Rectangular { re: 1, im: -2 }
  IO.printLine("z = ${z}")
  IO.printLine("w = ${w}")
  IO.printLine("z + w = ${z + w}")
  IO.printLine("z * w = ${z * w}")
  IO.printLine("conjugate(z) = ${z.conjugate}")

  # Magnitude and angle, with a polar round-trip that lands back on z.
  IO.printLine("|z| = ${z.abs}")
  IO.printLine("arg(z) = ${z.arg}")
  let polar = z.polar
  IO.printLine("polar(z) = ${polar}")
  IO.printLine("round-trip error = ${(polar.rectangular - z).abs}")

  # Polar values can be declared directly and converted to rectangular.
  let declared = Polar { radius: 2, theta: 0 }
  IO.printLine("declared = ${declared.rectangular}")
  IO.printLine("fromPolar = ${Complex.fromPolar(3, 0)}")

  # i squared is -1, and e^(i * pi) + 1 is 0: Euler's identity.
  IO.printLine("i * i = ${Complex.I * Complex.I}")
  let euler = (Complex.I * Math.PI).exp + 1
  IO.printLine("|e^(i * pi) + 1| = ${euler.abs}")
end
