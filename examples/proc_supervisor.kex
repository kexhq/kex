# Supervision with a crashing child. Runs on both the BEAM backend (`kex`,
# all restart strategies) and the tree-walking interpreter (`kex -R`,
# :only_crashed only). For a nested tree, see supervision_tree.kex.

foul counter(name: String, n: Int) do
  receive do
    :ping => do
      IO.printLine(name + " ping #" + n.to(String).or(""))
      counter(name, n + 1)
    end
    :boom => IO.printLine(name + " crashing!")
  end
end

foul startCounter(name: String) do
  spawn do
    counter(name, 1)
  end
end

main do
  let result = Supervisor.start(restart: :only_crashed) do
    Supervisor.worker { startCounter("counter-A") }
  end
  match result do
    Ok(pid) => IO.printLine("supervisor started: " + pid.to(String).or(""))
    Error(reason) => IO.printLine("supervisor error: " + reason.to(String).or(""))
  end
end
