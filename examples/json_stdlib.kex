# Standard-library JSON example. The older json_parser.kex remains a language
# syntax demonstration; this file exercises the production opt-in module.
using JSON

main do
  let source = "{ /* profile */ \"name\": \"Kex\", \"active\": true }"
  match JSON.parse(source, options: { allowComments: true }) do
    Ok(value) => IO.printLine(JSON.stringify(value))
    Error(error) => IO.printLine("JSON error: ${error}")
  end
end
