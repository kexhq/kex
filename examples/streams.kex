# Streams (pure, lazy) and Feeds (foul, stateful)

using FS

# Pure streams — infinite lazy sequences
let naturals = Stream.Sequence(from: 0) { |n| n + 1 }
let evens = Stream.Sequence(from: 0) { |n| n + 2 }
let powers = Stream.Sequence(from: 1) { |n| n * 2 }

# Range is Enumerable — finite, lazy until consumed
let oneToTen = 1..10
let doubled = (1..10).map { |x| x * 2 }
let r = 1..100

# Taking from streams materializes elements
let firstTen = naturals.take(10)
let nextFive = naturals.drop(10).take(5)

# Streams are reusable — naturals hasn't changed, and the elements it already
# produced are remembered rather than recomputed
let anotherTen = naturals.take(10)

# Range operations
let sum = (1..100).sum
let squares = (1..10).map { |x| x * x }
let evensInRange = (1..20).filter { |x| x.modulo(2) == 0 }

# Feeds are IO resources, so the functions that read them are foul
module FileReader do
  # A feed is consumed as it is walked, so a file of any size costs the same
  # memory to count through.
  foul processLarge(path: String) -> Result<Int, FS.FileError> do
    let feed = FS.File.feed(path).or(Feed.empty)
    var count = 0

    feed.each do |line|
      count = count + 1 if line.contains?("ERROR")
    end

    return Ok(count)
  end

  # filter and take stay lazy on a feed too: this stops reading at the tenth
  # error rather than at the end of the file.
  foul processWithFeed(path: String) -> Result<[String], FS.FileError> do
    let handle = FS.File.open(path, FS.Read).try
    let errors = handle.feed
      .map { |lines| lines.filter(&.contains?("ERROR")).take(10) }
      .or([])
    return Ok(errors)
  end

  # A small file worth reading more than once becomes a Stream, which
  # remembers what it read.
  foul reusableLines(path: String) -> [String] do
    let lines = FS.File.feed(path).or(Feed.empty).toStream
    let head = lines.take(3)
    return head + lines.take(3)   # the same three lines again
  end
end

# Infinite stream processing
let primes = Stream.Sequence(from: 2) { |n| n + 1 }
  .filter do |n|
    (2..n - 1).all? { |d| n.modulo(d) != 0 }
  end

let first_100_primes = primes.take(100)
