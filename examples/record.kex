record Temperature do
  celsius : Float
end

# Type-level constants live in a MODULE of the same name, which is what makes
# `Temperature.Freezing` an ordinary qualified lookup.
module Temperature do
  let Freezing = Temperature { celsius: 0.0 }
end

main do
  let boiling = Temperature { celsius: 100.0 }
  let freezing = Temperature.Freezing

  IO.printLine(boiling)
  IO.printLine(freezing)
end
