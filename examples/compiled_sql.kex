# Compiled SQL — zero-overhead query builder
#
# The SQL module defines its builder methods inside `compiled do...end`.
# A chain whose arguments are all known at compile time is evaluated during
# compilation and replaced by its result, so no QueryBuilder is ever allocated
# and `emit` never runs — see q1 below.
#
# A chain that depends on a runtime value collapses too: the free variable
# becomes a placeholder, and what is emitted is a static string plus a params
# list holding the runtime reference (q2/q3). All three queries below are
# literals in the generated code — `--collapse-report` says `3 of 3`.

module SQL do
  record Query do
    text   : String
    params : [Any] = []
  end

  record QueryBuilder do
    fields     : [Atom] = []
    table      : Atom = :none
    conditions : [(String, Any)] = []
    order      : String? = None
    limit_val  : Int? = None
  end

  compiled do
    # Two clauses rather than one union-typed parameter: a `match` catch-all
    # over `Atom | [Atom]` binds the whole union, so the arm handling the atom
    # case still has list type and cannot go into `fields : [Atom]`. Type
    # dispatch narrows at the clause boundary instead.
    let select(fields: [Atom]) -> QueryBuilder do
      QueryBuilder { fields: fields }
    end

    let select(field: Atom) -> QueryBuilder do
      QueryBuilder { fields: [field] }
    end

    make QueryBuilder do
      let from(table: Atom) -> QueryBuilder do
        QueryBuilder { fields: @fields, table: table, conditions: @conditions }
      end

      let where(conditions) -> QueryBuilder do
        QueryBuilder {
          fields: @fields,
          table: @table,
          conditions: @conditions + conditions
        }
      end

      let orderBy(col: String, dir: Atom = :asc) -> QueryBuilder do
        QueryBuilder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: Ok("${col} ${dir}")
        }
      end

      let limit(n: Int) -> QueryBuilder do
        QueryBuilder {
          fields: @fields,
          table: @table,
          conditions: @conditions,
          order: @order,
          limit_val: Just(n)
        }
      end

      # .emit() is the usual collapse trigger, though nothing here is special
      # about the name: any method of this block terminating an all-static
      # chain is evaluated at compile time and replaced by its result.
      let emit() -> Query do
        let field_str = match @fields do
          [:all] -> "*"
          fs     -> fs.map(&.to(String).or("")).join(", ")
        end

        var sql = "SELECT ${field_str} FROM ${@table}"
        var params = []
        var idx = 1

        @conditions.each do |col, val|
          let prefix = if idx == 1 then " WHERE " else " AND " end
          sql = sql + "${prefix}${col} = $${idx}"
          params = params + [val]
          idx = idx + 1
        end

        if @order do |o|
          sql = sql + " ORDER BY ${o}"
        end

        if @limit_val do |lim|
          sql = sql + " LIMIT $${idx}"
          params = params + [lim]
        end

        Query { text: sql, params: params }
      end
    end
  end
end

# --- Helpers for conditions ---
let eq(val) = val

# ---------------------------------------------------------------------------
# Usage — these look like normal calls; the static ones collapse at compile
# time. `kex -e` and a look at the emitted Core Erlang is the only way to tell.
# ---------------------------------------------------------------------------

main do
  let userId = "42"
  let userName = "John"

  # Fully static — no free vars, so the whole chain is gone before codegen.
  let q1 = SQL.select(:all).from(:users).emit()
  # Emits the literal Query { text: "SELECT * FROM :users", params: [] }

  IO.printLine(q1.text)

  # Free variable — `userId` only exists at runtime, so it rides through the
  # chain as a placeholder and lands in `params` as a reference. The text is
  # still computed during compilation, with `$1` written where it goes.
  let q2 = SQL.select([:name, :email])
              .from(:users)
              .where([(:id, userId)])
              .emit()
  # Emits Query { text: "SELECT :name, :email FROM :users WHERE :id = $1",
  #               params: [userId] } — string baked, userId still a reference.

  IO.printLine(q2.text)
  IO.inspect(q2.params)

  # Multiple free vars — same story as q2.
  let q3 = SQL.select(:all)
              .from(:users)
              .where([(:name, userName), (:id, userId)])
              .orderBy("name")
              .limit(10)
              .emit()
  # Emits Query { text: "SELECT * FROM :users WHERE :name = $1 AND :id = $2 ORDER BY name :asc LIMIT $3",
  #               params: [userName, userId, 10] }

  IO.printLine(q3.text)
end
