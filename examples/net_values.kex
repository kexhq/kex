using URI
using Net.IP, only: [Address, Network]
using Net.HTTP, only: [Headers]

main do
  let url = URL.parse("https://Example.COM:443/api/../status?verbose").try
  IO.printLine(url.normalize.string)

  let network = Network.parse("10.0.0.0/8").try
  let address = Address.parse("10.20.30.40").try
  IO.printLine("${address.string} private=${address.private?} in-network=${network.contains(address)}")

  let headers = Headers.empty
    .add("Accept", "application/json").try
    .add("X-Trace", "example").try
  IO.printLine("headers=${headers.entries.length}")

  # Generic queries preserve bare keys and encode spaces as %20. HTML form
  # encoding is deliberately separate and uses + for spaces.
  let query = URI.Query.from([("q", Just("kex language")), ("flag", None)])
  let form = URI.Form.from([("name", "Ada Lovelace"), ("role", "author")])
  IO.printLine("query=${query.encode}")
  IO.printLine("form=${form.encode}")
end
