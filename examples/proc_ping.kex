# spawn + send + receive round-trip. Runs on both the tree-walking
# interpreter (`kex`) and the BEAM backend (`kex -R`).
# A child process waits for :ping messages and replies :pong to the sender.

foul pingServer do
  spawn do
    loop do
      receive do |sender|
        :ping => sender.send(:pong)
      end
    end
  end
end

main do
  let server = pingServer()
  server.sendFrom(:ping)
  receive do
    :pong => IO.printLine("pong")
  end
end
