# Regex — how the API reads under the testing DSL. See src/stdlib/regex.kex,
# examples/regexes.kex, and docs/strings-and-tags-plan.md (the tag machinery).
# Backed by PCRE2 (interpreter) / Erlang `re` (BEAM).

using Regex

describe("matching") do
  it("matches returns Just(match) on a hit") do
    match "abc123".matches(regex`\d+`) do
      Just(m) => assert(m.get(0, "") == "123")     # get(0) = whole match
      None    => assert(false)
    end
  end

  it("matches returns None on a miss") do
    assert("abc".matches(regex`\d+`) == None)
  end

  it("matches?/1 is a boolean shortcut") do
    assert("a@b.co".matches?(regex`^\S+@\S+$`))
    assert(!"nope".matches?(regex`^\S+@\S+$`))
  end
end

describe("captures") do
  it("positional groups by index") do
    # get without a default returns String? — Just here, None if the group is absent.
    assert("#4271".matches(regex`#(\d+)`).map { |m| m.get(1) } == Just(Just("4271")))
  end

  it("named groups by atom") do
    let got = "2026-07-27".matches(regex`(?<y>\d{4})-(?<mo>\d{2})-(?<d>\d{2})`)
      .map { |m| (m.get(:y, ""), m.get(:mo, ""), m.get(:d, "")) }
    assert(got == Just(("2026", "07", "27")))
  end

  it("absent optional group is None, not empty") do
    # the group didn't participate -> absent key -> get returns None
    assert("x".matches(regex`x(?<opt>\d+)?`).map { |m| m.get(:opt) } == Just(None))
  end
end

describe("bulk ops") do
  it("scan returns every match") do
    let all = "a1 b2 c3".scan(regex`\w\d`).map { |m| m.get(0, "") }
    assert(all == ["a1", "b2", "c3"])
  end

  it("replace substitutes matches") do
    assert("555-1234".replace(regex`\d`, "#") == "###-####")
  end

  it("split on a pattern") do
    assert("a, b ,c".split(regex`\s*,\s*`) == ["a", "b", "c"])
  end
end

describe("flags and equivalence") do
  it("inline (?i) is caseless") do
    assert("HELLO".matches?(regex`(?i)hello`))
  end

  it("tag form and ordinary call produce equivalent regexes") do
    match regex("\\d") do
      Ok(re)   => assert("x9".matches?(re) == "x9".matches?(regex`\d`))
      Error(_) => assert(false)
    end
  end
end

describe("literal semantics") do
  it("backslash is literal inside a backtick body") do
    # `\d` is two characters handed to the engine, not a lexer escape.
    assert("7".matches?(regex`\d`))
    assert(`\d`.length == 2)
  end

  it("a raw literal never interpolates") do
    # ${ is plain text in a raw body — no escape needed for a price pattern.
    assert("$12.50".matches?(regex`\$\d+\.\d{2}`))
  end

  it("a block literal dedents by its own content") do
    let stripped = `
        a
          b
      `
    assert(stripped == "a\n  b\n")      # the shared margin goes, nesting stays

    # Where the closing backtick sits does not change the value.
    let flush = `
      a
        b
`
    assert(flush == stripped)
  end
end

describe("interpolation") do
  it("values are quote-escaped, not spliced as pattern syntax") do
    let dot = "a.c"
    # `.` from the value is a literal dot, so it must not match "abc".
    assert("a.c".matches?(regex$`^${dot}$`))
    assert(!"abc".matches?(regex$`^${dot}$`))
  end

  it("a doubled dollar escapes a literal interpolation marker") do
    let x = "1"
    assert($`${x}` == "1")           # a hole -> value of x
    assert($`$${x}` == `${x}`)       # escaped: literal ${x} (RHS is a raw backtick literal)
    assert($`$${x}`.length == 4)     # ${x}  is 4 characters, x unused
    assert(`$${x}`.length == 5)      # raw body: $${ is not special -> $${x}, 5 characters
  end
end
