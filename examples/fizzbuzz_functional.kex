# FizzBuzz - Functional Pipeline Solution
# Shows UFCS (Uniform Function Call Syntax) and call chaining

# Elegant pattern matching directly in transformation
let fizzBuzzString(n: Int) -> String do
  match (n.dividesBy?(3), n.dividesBy?(5)) do
    (true, true) => "FizzBuzz"
    (true, _) => "Fizz"
    (_, true) => "Buzz"
    (_, _) => "${n}"
  end
end

main do
  # Showcase UFCS: chained calls on the range itself
  (1..100)
    .map { |n| fizzBuzzString(n) }
    .each { |output| IO.printLine(output) }
end
