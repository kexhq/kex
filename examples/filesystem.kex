# Filesystem module demonstration
# Covers FS.File, FS.Directory, FileHandle, and Mock.FS

using FS

# A simple log writer that appends timestamped entries.
# Declared outside main so the spec can load it.
foul writeLog(path: String, entry: String) -> Bool do
  FS.File.append(path, "[log] ${entry}\n")
end

# Count non-empty lines in a file.
foul countLines(path: String) -> Int do
  match FS.File.readLines(path) do
    None       -> 0
    Just(ls)   -> ls.count { |l| !l.empty? }
    lines      -> lines.count { |l| !l.empty? }
  end
end

main do
  # ── Path utilities ──────────────────────────────────────────────────
  IO.printLine("=== Path utilities ===")

  let p = "/home/user/projects/app/src/main.kex"
  IO.printLine("path:      ${p}")
  IO.printLine("basename:  ${FS.Path.basename(p)}")
  IO.printLine("dirname:   ${FS.Path.dirname(p)}")
  IO.printLine("extension: ${FS.Path.extension(p)}")
  IO.printLine("join:      ${FS.Path.join("src", "utils.kex")}")

  # ── File read/write ─────────────────────────────────────────────────
  IO.printLine("\n=== File read / write ===")

  let tmp = FS.Path.join(FS.Directory.current(), "kex_demo_tmp.txt")
  FS.File.write(tmp, "Hello from Kex!\nLine two.\nLine three.\n")
  IO.printLine("wrote to:  ${tmp}")
  IO.printLine("exists?:   ${FS.File.file?(tmp)}")
  IO.printLine("size:      ${FS.File.size(tmp).or(-1)} bytes")

  match FS.File.read(tmp) do
    None    -> IO.printLine("(could not read)")
    content -> IO.printLine("content:\n${content}")
  end

  # ── Lines and feed ──────────────────────────────────────────────────
  IO.printLine("=== Lines and stream ===")

  let ls = FS.File.readLines(tmp).or([])
  IO.printLine("line count: ${ls.count}")
  ls.each { |l| IO.printLine("  > ${l}") }

  IO.printLine("first 2 via feed:")
  match FS.File.feed(tmp) do
    None -> IO.printLine("  (unavailable)")
    s    -> s.take(2).each { |l| IO.printLine("  > ${l}") }
  end

  # ── Mode-safe handles ───────────────────────────────────────────────
  IO.printLine("\n=== FS.File.open mode capabilities ===")

  # Read exposes read operations, but not write operations.
  let reader = FS.File.open(tmp, FS.Read).try
  let first = reader.readLine
  reader.close()
  IO.printLine("first line via handle: ${first.or("(none)")}")

  # Append exposes write operations, but not read operations.
  let appender = FS.File.open(tmp, FS.Append).try
  appender.writeLine("Appended via handle.")
  appender.close()

  # ReadWrite exposes both sets.
  let editable = FS.File.open(tmp, FS.ReadWrite).try
  IO.printLine("read-write handle sees ${editable.read().or("").count} chars")
  editable.writeLine("Written through ReadWrite.")
  editable.close()

  # These are compile-time errors:
  # reader.write("not allowed")
  # appender.read()

  IO.printLine("after handle writes, lines: ${FS.File.readLines(tmp).or([]).count}")

  # ── Type predicates ─────────────────────────────────────────────────
  IO.printLine("\n=== Type predicates ===")

  IO.printLine("tmp is file?:      ${FS.File.file?(tmp)}")
  IO.printLine("tmp is dir?:       ${FS.File.directory?(tmp)}")
  IO.printLine("/tmp is dir?:      ${FS.Directory.directory?("/tmp")}")
  IO.printLine("/tmp is file?:     ${FS.Directory.file?("/tmp")}")

  # ── Copy, rename, delete ────────────────────────────────────────────
  IO.printLine("\n=== Copy / rename / delete ===")

  let copy = FS.Path.join(FS.Directory.current(), "kex_demo_copy.txt")
  FS.File.copy(tmp, copy)
  IO.printLine("copied, copy exists?: ${FS.File.file?(copy)}")

  let moved = FS.Path.join(FS.Directory.current(), "kex_demo_moved.txt")
  FS.File.rename(copy, moved)
  IO.printLine("renamed — copy gone?: ${!FS.File.file?(copy)}")
  IO.printLine("moved exists?:        ${FS.File.file?(moved)}")

  FS.File.delete(tmp)
  FS.File.delete(moved)
  IO.printLine("cleaned up")

  # ── Directory operations ─────────────────────────────────────────────
  IO.printLine("\n=== Directory operations ===")

  let dir = FS.Path.join(FS.Directory.current(), "kex_demo_dir")
  FS.Directory.create(dir)
  IO.printLine("created dir:  ${FS.Directory.directory?(dir)}")

  FS.File.write(FS.Path.join(dir, "a.txt"), "alpha")
  FS.File.write(FS.Path.join(dir, "b.txt"), "beta")
  IO.printLine("files in dir: ${FS.Directory.files(dir).or([])}")
  IO.printLine("dirs in dir:  ${FS.Directory.directories(dir).or([])}")

  let sub = FS.Path.join(dir, "sub")
  FS.Directory.create(sub)
  IO.printLine("after mkdir sub, dirs: ${FS.Directory.directories(dir).or([])}")
  IO.printLine("current:      ${FS.Directory.current()}")

  FS.Directory.deleteAll(dir)
  IO.printLine("after deleteAll, dir gone?: ${!FS.Directory.directory?(dir)}")

  # ── Mock.FS — in-memory filesystem for tests ─────────────────────────
  IO.printLine("\n=== Mock.FS ===")

  Mock.FS.File("config.txt", "host=localhost\nport=8080\n")
  Mock.FS.Directory("cache")
  Mock.FS.File("cache/entry.bin", "\x00\x01\x02")

  IO.printLine("mock file exists?:  ${FS.File.file?("config.txt")}")
  IO.printLine("real file exists?:  ${FS.File.file?("does_not_exist.txt")}")
  IO.printLine("mock dir exists?:   ${FS.Directory.directory?("cache")}")

  let cfg = FS.File.readLines("config.txt").or([])
  IO.printLine("config lines: ${cfg}")

  writeLog("config.txt", "server started")
  IO.printLine("after append, lines: ${FS.File.readLines("config.txt").or([]).count}")

  IO.printLine("cache files: ${FS.Directory.files("cache").or([])}")

  Mock.FS.clear()
  IO.printLine("after clear, config exists?: ${FS.File.file?("config.txt")}")
end
