# Erlang Interop — calling Erlang/OTP libraries from Kex
#
# The BEAM.* namespace calls any BEAM module, named verbatim:
#   BEAM.lists        → 'lists'
#   BEAM.ets          → 'ets'
#   BEAM.erlang       → 'erlang'  (the 'erlang' module itself)
#   BEAM.net_kernel   → 'net_kernel'
#   BEAM.Elixir.Enum  → 'Elixir.Enum'
#
# What you write after `BEAM.` is the real module name — no casing rules,
# whichever language compiled the module.

# kex: run-beam

main do
  # --- lists module ---
  IO.printLine("lists:reverse →")
  IO.printLine(BEAM.lists.reverse([1, 2, 3, 4, 5]))

  IO.printLine("lists:flatten →")
  IO.printLine(BEAM.lists.flatten([[1, 2], [3, 4], [5]]))

  IO.printLine("lists:nth(3, ...) →")
  IO.printLine(BEAM.lists.nth(3, [10, 20, 30, 40]))

  IO.printLine("lists:last →")
  IO.printLine(BEAM.lists.last([10, 20, 30]))

  # --- erlang module (BIFs) ---
  IO.printLine("erlang:abs(-42) →")
  IO.printLine(BEAM.erlang.abs(-42))

  # --- math module ---
  IO.printLine("math:sqrt(144.0) →")
  IO.printLine(BEAM.math.sqrt(144.0))

  IO.printLine("math:pow(2, 10) →")
  IO.printLine(BEAM.math.pow(2.0, 10.0))

  IO.printLine("math:pi() →")
  IO.printLine(BEAM.math.pi())

  # --- string module ---
  IO.printLine("string:uppercase →")
  IO.printLine(BEAM.string.uppercase("hello kex"))

  IO.printLine("string:lowercase →")
  IO.printLine(BEAM.string.lowercase("HELLO KEX"))

  # --- ETS (in-memory key-value tables) ---
  let tab = BEAM.ets.new(:users, [:set, :public])
  BEAM.ets.insert(tab, (:alice, "Alice", 30))
  BEAM.ets.insert(tab, (:bob, "Bob", 25))
  BEAM.ets.insert(tab, (:carol, "Carol", 28))

  IO.printLine("ets:lookup(:alice) →")
  IO.printLine(BEAM.ets.lookup(tab, :alice))

  IO.printLine("ets:info(size) →")
  IO.printLine(BEAM.ets.info(tab, :size))

  BEAM.ets.delete(tab, :bob)
  IO.printLine("after delete(:bob), size →")
  IO.printLine(BEAM.ets.info(tab, :size))

  BEAM.ets.delete(tab)

  # --- Mnesia (distributed database) ---
  BEAM.mnesia.start()

  BEAM.mnesia.create_table(:kex_demo, [(:attributes, [:id, :name, :score])])

  BEAM.mnesia.transaction do
    BEAM.mnesia.write((:kex_demo, 1, "Player1", 100))
    BEAM.mnesia.write((:kex_demo, 2, "Player2", 200))
  end

  let (_, result) = BEAM.mnesia.transaction do
    BEAM.mnesia.read((:kex_demo, 1))
  end
  IO.printLine("mnesia:read →")
  IO.printLine(result)

  BEAM.mnesia.delete_table(:kex_demo)
  BEAM.mnesia.stop()
end
