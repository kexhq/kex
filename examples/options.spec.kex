let OPTIONS = OptionParser.define("testapp", "A test CLI")
  .string("name", Just('n'), "Your name", None, true)
  .integer("port", Just('p'), "Port number", Just("3000"), false)
  .flag("verbose", Just('v'), "Enable verbose output")

describe("OptionParser.parse") do
  it("parses values, defaults, flags, and positionals") do
    match OPTIONS.parse(["run", "-n", "Alice", "-v"]) do
      Ok(options) -> do
        assert(options.arguments == ["run"])
        assert(options.value("name", "") == "Alice")
        assert(options.integerValue("port") == Just(3000))
        assert(options.flagEnabled?("verbose"))
      end
      Error(_) -> assert(false)
    end
  end

  it("reports invalid input") do
    assert(OPTIONS.parse(["--port", "nope"]) == Error(InvalidInteger("port", "nope")))
  end

  it("renders help") do
    assert(OPTIONS.help.contains?("-n, --name"))
    assert(OPTIONS.help.contains?("[default: 3000]"))
  end
end
