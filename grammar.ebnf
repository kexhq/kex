(* Kex Language Grammar — EBNF *)
(* Conventions: *)
(*   lowercase = rule *)
(*   UPPER     = token/terminal *)
(*   ?         = optional *)
(*   *         = zero or more *)
(*   +         = one or more *)
(*   |         = alternative *)

(* ===== Top-Level ===== *)

program = top_level_item* ;

standalone_module = MODULE type_name NEWLINE top_level_item* ;

top_level_item
  = module_def
  | capability_def
  | type_def
  | record_def
  | make_def
  | function_def
  | compiled_block
  | using_block
  | main_block
  | pragma
  ;

(* ===== Modules ===== *)

module_def = MODULE UPPER_IDENT DO module_body END ;

(* A capability is a module whose implementation may be replaced for a lexical
   region by `with` (see with_expr), and whose presence a compilation target
   may decline to provide. It parses exactly like a module — the public
   function signatures also form the interface an implementation must satisfy,
   and the bodies are what runs outside any `with`. *)
capability_def = CAPABILITY UPPER_IDENT DO module_body END ;

module_body = module_item* ;

module_item
  = module_def
  | capability_def
  | type_def
  | record_def
  | make_def
  | function_def
  | compiled_block
  | visibility_block
  | using_block
  | export_statement
  ;

using_statement = USING type_name ( COMMA using_opts )? ( DO body END )? ;
using_opts = using_opt ( COMMA using_opt )* ;
using_opt = LOWER_IDENT COLON ( UPPER_IDENT | name_list ) ;
name_list = LBRACKET name_entry ( COMMA name_entry )* RBRACKET ;
name_entry = LOWER_IDENT | UPPER_IDENT | LPAREN binary_op RPAREN ;

export_statement = EXPORT type_name ( COMMA using_opts )? ;

visibility_block = ( PUBLIC | PRIVATE ) DO module_item* END ;

(* ===== Types ===== *)

(* The optional leading PIPE forces the sum-type reading of a single bare
   name: `type E = | DivideByZero` declares a one-variant ADT, while
   `type FilePath = String` (no pipe) is a transparent alias. *)
type_def
  = DISTINCT? TYPE UPPER_IDENT type_params? inheritance? EQUALS PIPE? type_expr ( PIPE type_expr )*
  | TYPE UPPER_IDENT type_params? inheritance? DO type_body END
  | TYPE UPPER_IDENT type_params? inheritance?
  ;

type_body = abstract_function* ;

inheritance = LESS_THAN type_name ( COMMA type_name )* ;

type_params = LESS_THAN UPPER_IDENT ( COMMA UPPER_IDENT )* GREATER_THAN ;

type_expr
  = type_name
  | type_name LESS_THAN type_arg ( COMMA type_arg )* GREATER_THAN
  | type_expr ARROW type_expr                     (* function type *)
  | LPAREN type_expr ( COMMA type_expr )* RPAREN  (* tuple type *)
  | LBRACKET type_expr RBRACKET                   (* list type *)
  | LBRACE type_expr COLON type_expr RBRACE       (* map type *)
  | type_expr PIPE type_expr                      (* union type *)
  | type_expr QUESTION                            (* optional sugar: T? = Just(T) | None *)
  | type_expr "or" "!" type_expr                  (* result sugar: T or! E = Result<T, E> *)
  | type_expr "or" type_expr                      (* either sugar: A or B = Either<A, B> *)
  | BLOCK LESS_THAN type_expr GREATER_THAN        (* block type *)
  | atom_literal                                  (* atom in type position *)
  ;

type_arg = type_expr ;

(* A single uppercase LETTER is a type parameter — `T` in
   `let identity(x: T) -> T`. That is the whole rule: anything longer names a
   type. *)
type_name = UPPER_IDENT ( DOT UPPER_IDENT )* ;

abstract_function = LOWER_IDENT ( TYPE_ANNOTATION | COLON ) type_expr ;

(* ===== Records ===== *)

record_def = RECORD UPPER_IDENT type_params? DO record_body END ;

record_body = record_field* ;

record_field = LOWER_IDENT COLON type_expr ( EQUALS expr )? ;

(* ===== Traits ===== *)

trait_def = TRAIT UPPER_IDENT ( LESS_THAN type_params GREATER_THAN )? DO trait_body END ;

trait_body = trait_item* ;

trait_item
  = type_annotation               (* required pure method: `name : type` *)
  | FOUL type_annotation          (* required foul method: `foul name : type` *)
  | function_def                  (* default implementation (optional for implementors) *)
  ;

(* ===== Make Blocks ===== *)

make_def
  = MAKE make_target ( COMMA IMPLEMENT COLON trait_list )? DO make_body END
  | MAKE FINAL COLON make_target DO make_body END
  ;

trait_list = UPPER_IDENT ( COMMA UPPER_IDENT )* ;

make_target = type_expr ;

make_body = make_item* ;

make_item
  = function_def
  | type_annotation
  | visibility_block
  ;

(* ===== Functions ===== *)

function_def
  = ( FOUL | LET ) LOWER_IDENT function_clauses
  | ( FOUL | LET ) LOWER_IDENT QUESTION function_clauses  (* predicate functions *)
  | ( FOUL | LET ) UPPER_IDENT function_clauses           (* type-level constructors declared in a module of the type's name, e.g. `let Polar(...) ... end` *)
  | ( FOUL | LET ) binary_op function_clauses             (* operator overload inside `make`, e.g. `foul +(other) ... end` *)
  ;

function_clauses
  = function_clause
  | function_clause ( function_clause )*
  ;

(* `-> type_expr` may precede any body. A clause with NO parameter list may
   spell that annotation `: type_expr` instead, which is how a binding reads:
   `foul lines : Feed<String> = …`. A clause WITH parameters requires `->`. *)
function_clause
  = LPAREN params RPAREN return_annotation? clause_body
  | return_annotation? clause_body
  | COLON type_expr EQUALS expr                   (* parameterless binding *)
  ;

return_annotation = ARROW type_expr ;

clause_body
  = EQUALS expr
  | DO body END
  | DO PIPE params PIPE body END
  ;

params = param ( COMMA param )* | (* empty *) ;

param
  = pattern
  | LOWER_IDENT COLON type_expr                   (* typed param *)
  | LOWER_IDENT COLON type_expr EQUALS expr       (* typed param with default *)
  | LOWER_IDENT EQUALS expr                       (* param with default *)
  ;

(* Type annotations: *)
(*   :> means implicit This as first param — used inside make blocks *)
(*      e.g. modulo :> This -> This  means  This -> This -> This *)
(*   :  means full explicit signature — used at top level *)
(*      e.g. element : String -> [String] -> Element *)
type_annotation
  = LOWER_IDENT TYPE_ANNOTATION type_expr
  | LOWER_IDENT COLON type_expr
  | binary_op TYPE_ANNOTATION type_expr           (* operator signatures, e.g. == :> This -> Bool *)
  | binary_op COLON type_expr                     (* e.g. == : This -> This -> Bool *)
  ;


(* ===== Main ===== *)

main_block = MAIN ( LPAREN params RPAREN )? DO body END ;

(* ===== Compiled ===== *)

compiled_block = COMPILED DO compiled_body END ;

compiled_body = compiled_item* ;

(* Compile-time constants are ordinary parameterless `let` bindings; there is
   no keyword-less `NAME = expr` form. *)
compiled_item
  = LET LOWER_IDENT EQUALS expr
  | LET UPPER_IDENT EQUALS expr
  | expr DOT EACH DO PIPE LOWER_IDENT PIPE compiled_body END
  | type_def
  | function_def
  | make_def
  | SPLICE_IDENT TYPE_ANNOTATION type_expr
  | SPLICE_IDENT COLON type_expr
  | LET splice_name function_clause             (* generated function *)
  | TYPE splice_name EQUALS type_expr ( PIPE type_expr )*  (* generated type *)
  | SPLICE_IDENT LPAREN params RPAREN DO body END
  ;

(* A declaration name computed at compile time: `%name` splices a variable,
   `%{expr}` any expression. *)
splice_name = SPLICE_IDENT | PERCENT LBRACE expr RBRACE ;

(* ===== Using ===== *)

using_block = USING type_name DO body END ;

(* ===== Pragma ===== *)

pragma = HASH_LBRACKET UPPER_IDENT ( COMMA UPPER_IDENT )* RBRACKET ;

(* ===== Expressions ===== *)

expr
  = literal
  | LOWER_IDENT
  | UPPER_IDENT
  | THIS
  | AT LOWER_IDENT                               (* @field shorthand for this.field, inside make/record functions *)
  | AT LOWER_IDENT LPAREN args RPAREN            (* @method(args) shorthand for this.method(args) *)
  | expr DOT LOWER_IDENT                         (* UFCS method call *)
  | expr DOT LOWER_IDENT LPAREN args RPAREN      (* UFCS method call with args *)
  | expr DOT LOWER_IDENT block                   (* UFCS method call with block *)
  | expr DOT LOWER_IDENT LPAREN args RPAREN block (* UFCS method call with args and block *)
  | expr DOT LOWER_IDENT BANG                    (* mutating call: x.method!() — reassigns var *)
  | expr DOT LOWER_IDENT BANG LPAREN args RPAREN (* mutating call with args *)
  | expr DOT LOWER_IDENT BANG block              (* mutating call with block *)
  | expr DOT LOWER_IDENT BANG LPAREN args RPAREN block (* mutating call with args and block *)
  | LOWER_IDENT LPAREN args RPAREN               (* function call *)
  | LOWER_IDENT ( RAW_STRING | INTERPOLATED_RAW_STRING )
                                                   (* tagged literal; the identifier,
                                                      optional $, and opening ` must
                                                      be byte-adjacent *)
  | LOWER_IDENT block                            (* function call with block *)
  | LOWER_IDENT LPAREN args RPAREN block         (* function call with args and block *)
  | UPPER_IDENT LBRACE record_init RBRACE        (* record construction *)
  | expr binary_op expr                          (* binary operation *)
  | unary_op expr                                (* unary operation *)
  | LPAREN expr ( COMMA expr )+ RPAREN           (* tuple *)
  | LBRACKET list_items? RBRACKET                (* list literal *)
  | LBRACE map_items? RBRACE                     (* map literal *)
  | range_expr
  | if_expr
  | match_expr
  | receive_expr
  | loop_expr
  | while_expr
  | let_expr
  | var_expr
  | assign_expr
  | return_expr
  | spawn_expr
  | with_expr
  | break_expr
  | next_expr
  | lambda
  | shorthand_lambda
  | curry_expr
  | expr IF expr                                 (* trailing conditional *)
  | then_else_expr
  ;

(* Ternary replacement, lowest precedence. Both branches must stay on the
   same line as THEN/ELSE unless the whole expression is parenthesized.
   Nesting another then/else requires parens. *)
then_else_expr = expr THEN expr ELSE expr ;

(* ===== Literals ===== *)

literal
  = INTEGER
  | FLOAT
  | STRING
  | RAW_STRING
  | INTERPOLATED_RAW_STRING
  | TRUE
  | FALSE
  | NONE
  | atom_literal
  ;

atom_literal = COLON LOWER_IDENT ;

(* ===== Operators ===== *)

binary_op
  = PLUS | MINUS | STAR | SLASH | PERCENT
  | EQ_EQ | NOT_EQ | LESS_THAN | GREATER_THAN | LESS_EQ | GREATER_EQ
  | AND_AND | PIPE_PIPE
  | DOT_DOT
  ;

unary_op = MINUS | BANG ;

(* ===== Collections ===== *)

list_items = list_item ( COMMA list_item )* ( PIPE expr )? ;

list_item = expr | spread ;

map_items = map_entry ( COMMA map_entry )* ;

(* Later entries win, so a spread overrides what precedes it. *)
map_entry = expr COLON expr | spread ;

record_init = record_field_init ( COMMA record_field_init )* ;

record_field_init
  = LOWER_IDENT COLON expr
  | LOWER_IDENT                                  (* shorthand for `name: name` *)
  ;

(* ===== Range ===== *)

range_expr = expr DOT_DOT expr ;

(* ===== Control Flow ===== *)

(* Multiline conditions require parens, e.g. `if (a\n && b)`, since
   newlines are only insignificant inside ( ). *)
if_expr
  = IF expr NEWLINE body END
  | IF expr NEWLINE body ELSE NEWLINE body END
  | IF expr NEWLINE body ( ELIF expr NEWLINE body )* ELSE NEWLINE body END
  | IF expr THEN expr END                                              (* single-line *)
  | IF expr THEN expr ELSE expr END                                    (* single-line with else *)
  | IF expr THEN expr ( ELIF expr THEN expr )+ END                    (* single-line multi-branch *)
  | IF expr THEN expr ( ELIF expr THEN expr )+ ELSE expr END          (* single-line multi-branch with else *)
  (* mixed: inline-then bodies, each branch on its own line *)
  | IF expr THEN expr NEWLINE ( ELIF expr THEN expr NEWLINE )* ( ELSE expr NEWLINE )? END
  ;

match_expr = MATCH expr DO ( PIPE LOWER_IDENT PIPE )? match_clause+ END ;

match_clause
  = pattern ( COMMA pattern )* ( WHEN expr )? FAT_ARROW expr
  | WHEN expr FAT_ARROW expr   (* bare when = _ when *)
  ;

receive_expr = RECEIVE DO match_clause* after_clause? END ;

(* The timeout belongs to the branch it governs. A receive with no
   `after` blocks until a message matches; one with no clauses and only an
   `after` is a plain wait. The body is closed by the receive's own `end`. *)
after_clause = AFTER TIMEOUT COLON expr NEWLINE body ;

loop_expr = LOOP DO ( PIPE ( LOWER_IDENT | UNDERSCORE ) PIPE )? NEWLINE body END ;
(* The optional binding is a 0-based iteration counter: loop do |i| ... end *)

while_expr = WHILE expr NEWLINE body END ;

(* ===== Let / Var / Assignment ===== *)

(* The type annotation is optional. *)
let_expr = LET pattern ( COLON type_expr )? EQUALS expr ;

var_expr = VAR LOWER_IDENT ( COLON type_expr )? EQUALS expr ;

assign_expr = LOWER_IDENT EQUALS expr ;

return_expr = RETURN expr ;

(* ===== Spawn ===== *)

spawn_expr = SPAWN DO body END ;

(* ===== Capability substitution ===== *)

(* `with FS.File = FakeFiles { … } do … end` — every call reaching the named
   capability from inside the body, however deep, sees the replacement; the
   functions in between declare nothing and thread nothing. Bindings are
   per-process and are snapshotted at spawn, so a process spawned inside the
   region inherits the replacement and one spawned outside it never sees. *)
with_expr = WITH type_name EQUALS expr DO body END ;

(* break/next apply to the nearest enclosing while/loop only — not to
   each blocks or other closures. Using them inside a closure (a do-block
   passed to a function) or outside a loop is a compile error. *)
break_expr = BREAK ;
next_expr  = NEXT ;

(* ===== Lambdas ===== *)

lambda
  = LBRACE PIPE params PIPE expr RBRACE           (* inline lambda *)
  | LBRACE expr RBRACE                            (* zero-arg lambda *)
  | DO PIPE params PIPE body END                  (* multi-line lambda *)
  ;

(* `&` is receiver shorthand only, and the method is always an identifier.
   Capturing a named function or an operator is spelled with `~` — see
   curry_expr. *)
shorthand_lambda
  = AMP DOT LOWER_IDENT                           (* &.method *)
  | AMP DOT LOWER_IDENT LPAREN args RPAREN        (* &.method(args) *)
  ;

(* `~f` captures a named function; every trailing (args) group partially
   applies it, so `~f` alone is just f. `_` fixes a non-leading argument.
   The name may be module-qualified to any depth: `~Math.Vec2.add`. *)
curry_expr
  = TILDE curry_target { LPAREN curry_args RPAREN }
  ;

curry_target
  = LOWER_IDENT                                   (* ~function *)
  | UPPER_IDENT { DOT UPPER_IDENT } DOT LOWER_IDENT  (* ~Mod.Sub.function *)
  | LPAREN operator RPAREN                        (* ~(+), ~(<=), ~(&&) *)
  | LPAREN BANG RPAREN                            (* ~(!) — the unary one *)
  ;

curry_args = [ curry_arg { COMMA curry_arg } ] ;
curry_arg  = expr | UNDERSCORE ;                  (* _ = placeholder *)

(* Every binary operator can be captured with `~(op)`. *)
operator
  = PLUS | MINUS | STAR | SLASH | PERCENT | CARET
  | EQ_EQ | NOT_EQ | LESS_THAN | LESS_EQ | GREATER_THAN | GREATER_EQ
  | AND_AND | PIPE_PIPE
  ;

(* `...` is a spread, not an operator: it is valid only where a collection is
   being built — a list literal, a map literal, or a statement in a `do` block
   body that a `Block<[A]>` parameter collects. *)
spread = DOT_DOT_DOT expr ;

(* ===== Blocks ===== *)

block
  = DO body END
  | DO PIPE params PIPE body END
  | LBRACE PIPE params PIPE expr RBRACE
  | LBRACE expr RBRACE
  ;

body = ( expr | spread )* ;   (* a spread is collected by a Block<[A]> param *)

(* ===== Patterns ===== *)

pattern
  = literal
  | LOWER_IDENT                                   (* variable binding *)
  | UNDERSCORE                                    (* wildcard *)
  | AT pattern                                    (* match on this *)
  | UPPER_IDENT LPAREN pattern ( COMMA pattern )* RPAREN  (* constructor pattern *)
  | LBRACE field_pattern ( COMMA field_pattern )* RBRACE  (* record/map destructuring *)
  | LBRACKET list_pattern RBRACKET                (* list pattern *)
  | LPAREN pattern ( COMMA pattern )* RPAREN      (* tuple pattern *)
  ;

field_pattern
  = LOWER_IDENT                                   (* shorthand: name binds to field name *)
  | LOWER_IDENT COLON pattern                     (* field: pattern *)
  | STRING COLON pattern                          (* map string key pattern *)
  ;

list_pattern
  = (* empty *)
  | pattern ( COMMA pattern )* ( PIPE pattern )?
  ;

(* ===== Arguments ===== *)

args = arg ( COMMA arg )* ;

arg
  = expr
  | LOWER_IDENT COLON expr                        (* named argument *)
  ;

(* ===== Tokens ===== *)

(* Keywords *)
AFTER    = "after" ;
BLOCK    = "Block" ;
BREAK    = "break" ;
CAPABILITY = "capability" ;
COMPILED = "compiled" ;
DO       = "do" ;
ELIF     = "elif" ;
ELSE     = "else" ;
END      = "end" ;
FALSE    = "false" ;
FINAL    = "final" ;
FOUL     = "foul" ;
IF       = "if" ;
LET      = "let" ;
LOOP     = "loop" ;
MAIN     = "main" ;
MAKE     = "make" ;
MATCH    = "match" ;
MODULE   = "module" ;
NEXT     = "next" ;
NONE     = "None" ;
PRIVATE  = "private" ;
PUBLIC   = "public" ;
RECEIVE  = "receive" ;
RECORD   = "record" ;
RETURN   = "return" ;
SPAWN    = "spawn" ;
THEN     = "then" ;
THIS     = "this" ;
TIMEOUT  = "timeout" ;
TRUE     = "true" ;
TYPE     = "type" ;
USING    = "using" ;
VAR      = "var" ;
WHEN     = "when" ;
WHILE    = "while" ;
WITH     = "with" ;

(* Symbols *)
ARROW        = "->" ;   (* types only: function type, return annotation *)
FAT_ARROW    = "=>" ;   (* arms only: match, bare when, receive, rescue *)
AMP          = "&" ;
AT           = "@" ;
BANG         = "!" ;
CARET        = "^" ;
COLON        = ":" ;
COMMA        = "," ;
DOT          = "." ;
DOT_DOT      = ".." ;
DOT_DOT_DOT  = "..." ;
EQUALS       = "=" ;
EQ_EQ        = "==" ;
GREATER_THAN = ">" ;
GREATER_EQ   = ">=" ;
HASH_LBRACKET = "#[" ;
LBRACE       = "{" ;
LBRACKET     = "[" ;
LESS_THAN    = "<" ;
LESS_EQ      = "<=" ;
LPAREN       = "(" ;
MINUS        = "-" ;
NOT_EQ       = "!=" ;
PERCENT      = "%" ;
PIPE         = "|" ;
PIPE_PIPE    = "||" ;
AND_AND      = "&&" ;
PLUS         = "+" ;
QUESTION     = "?" ;
RBRACE       = "}" ;
RBRACKET     = "]" ;
RPAREN       = ")" ;
SLASH        = "/" ;
STAR         = "*" ;
TILDE        = "~" ;
TYPE_ANNOTATION = ":>" ;
UNDERSCORE   = "_" ;

(* Identifiers *)
LOWER_IDENT  = [a-z] [a-z0-9_]* "?"? ;
UPPER_IDENT  = [A-Z] [A-Za-z0-9]* ;
SPLICE_IDENT = "%" LOWER_IDENT ;

(* Literals *)
(* `_` is a separator anywhere after the first digit (or after the radix
   marker) and carries no meaning. Radix literals are arbitrary precision like
   decimal ones, and the lexer hands every consumer the decimal spelling. *)
INTEGER = DECIMAL | HEX | OCTAL | BINARY ;
DECIMAL = [0-9] [0-9_]* ;
HEX     = "0" ("x" | "X") [0-9A-Fa-f] [0-9A-Fa-f_]* ;
OCTAL   = "0" ("o" | "O") [0-7] [0-7_]* ;
BINARY  = "0" ("b" | "B") [01] [01_]* ;

(* The fraction part is optional when an exponent is present (3e22), and the
   exponent is optional when a fraction part is present (3.14). *)
FLOAT    = DECIMAL "." DECIMAL EXPONENT?
         | DECIMAL EXPONENT ;
EXPONENT = ("e" | "E") ("+" | "-")? DECIMAL ;
STRING  = '"' string_content* '"' ;
string_content = [^"$\\] | escape | interpolation ;
escape = "\\" [nrt\\$"] ;
interpolation = "$" "{" expr "}" ;
RAW_STRING = "`" raw_string_content* "`" ;
raw_string_content = "``" | [^`] ;
INTERPOLATED_RAW_STRING =
  "$`" ( "``" | "$${" | raw_string_interpolation | [^`] )* "`" ;
raw_string_interpolation = "${" expr "}" ;

(* Comments *)
COMMENT = "#" [^\n]* ;

(* Whitespace *)
WS = [ \t\n\r]+ ;
