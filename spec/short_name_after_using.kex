# A `using` loads its module's whole file, so a module or type there is named
# by its last segment: `UnorderedSet` beside `Data.Set`, `Headers` under
# `Net.HTTP`, `Input` from `Parsing` (kexhq/kex#840). Without a `using`, a
# qualified name still reaches an opt-in module, on both backends.
using Data.Set
using Net.HTTP
using Parsing

let remaining(cursor: Input) -> Integer = cursor.input.count - cursor.pos

main do
  IO.printLine(UnorderedSet.from([1, 2, 2]).count.to(String))
  IO.printLine(Headers.empty.inspected)
  IO.printLine(remaining(Input { input: "kex", pos: 1 }).to(String))
  IO.printLine(Data.Queue.empty.enqueue(4).count.to(String))
  IO.printLine(JSON.parse("[1, 2]").map { |value| value.inspected }.or("bad"))
  IO.printLine(FS.File.read("spec/no_such_file.txt").or("missing"))
end
