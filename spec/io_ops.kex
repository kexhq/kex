# Console and file IO
# Expected output:
# hello
# hi
# false
# true
# true
# Just(ab)
# Just(abcd)
# Just([abcd])
# [abcd]
# true
# None

main do
  IO.printLine("hello")
  IO.print("hi")
  IO.printLine("")

  let path = "spec/io_scratch.txt"
  FS.File.delete(path)

  IO.printLine(FS.File.exists?(path))
  IO.printLine(FS.File.write(path, "ab"))
  IO.printLine(FS.File.exists?(path))
  IO.printLine(FS.File.read(path))
  FS.File.append(path, "cd")
  IO.printLine(FS.File.read(path))
  IO.printLine(FS.File.lines(path))
  IO.printLine(FS.File.feed(path).or([]).take(1))
  IO.printLine(FS.File.delete(path))
  IO.printLine(FS.File.read(path))
end
