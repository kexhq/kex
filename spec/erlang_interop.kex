# Erlang interop: calling Erlang stdlib directly via the BEAM.* namespace
# kex: run-beam

main do
  # lists:reverse/1
  IO.printLine(BEAM.lists.reverse([1, 2, 3]).to(String).or(""))

  # lists:flatten/1
  IO.printLine(BEAM.lists.flatten([[10, 20], [30]]).to(String).or(""))

  # lists:nth/2 (1-based)
  IO.printLine(BEAM.lists.nth(2, [10, 20, 30]).to(String).or(""))

  # erlang:abs/1
  IO.printLine(BEAM.erlang.abs(-7).to(String).or(""))

  # math:sqrt/1
  IO.printLine(BEAM.math.sqrt(25.0).to(String).or(""))
end
