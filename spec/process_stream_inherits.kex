# kex: skip-wasm
# Process.stream runs its child on the caller's own stdin, stdout and
# stderr, and answers only the child's exit code. Both backends agree: the
# walker forks and the child inherits its descriptors, and on BEAM the port
# is opened with `nouse_stdio`, so the child writes to the VM's fd 1 itself
# rather than through a pipe Kex relays. What the child prints therefore
# lands in this program's own output, between what the program printed
# before and after it.
#
# Not checked here: that the child reads the caller's stdin and sees a
# terminal (the runners feed no stdin, and capture through pipes), and that
# its stderr stays apart from stdout (the walker suite reads the two merged,
# the BEAM suite one after the other, so no one golden file can say where
# it went). `make test-process-stream-pty` checks both, under a real pty.
#
# Skipped under wasm: there are no child processes there.

main do
  IO.printLine("before")
  match Process.stream("sh", ["-c", "echo from-child; exit 3"]) do
    Error(error) => IO.printLine("error: ${error}")
    Ok(code) => IO.printLine("exit ${code}")
  end

  match Process.stream("sh", ["-c", "true"]) do
    Error(error) => IO.printLine("error: ${error}")
    Ok(code) => IO.printLine("exit ${code}")
  end

  match Process.stream("definitely-not-a-real-program", []) do
    Error(error) => IO.printLine("missing: ${error}")
    Ok(code) => IO.printLine("unexpected exit ${code}")
  end
end
