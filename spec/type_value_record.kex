# A type named as a value is its `Type` record on both backends: it shows as
# its name, a parameter written as a type name matches it, and a type that
# only the declaration narrows (`Byte`) keeps its own name. Showing one
# failed on both backends before (`String.showValue` / `function_clause`).

let describe(String) -> String = "a string type"
let describe(Integer) -> String = "an integer type"

main do
  let t = String
  IO.printLine(describe(t))
  IO.printLine(describe(Integer))
  IO.printLine("${t}")
  IO.printLine(t.name)
  IO.printLine("${(-1).to(Byte).or(0)} ${200.to(Byte).or(0)}")
  # `Type.of` of a type value is that type: the idiom `select(as: T)` with
  # `Type.of(as)` keeps meaning what it did when a type name was a token.
  IO.printLine(Type.of(t).name)
  IO.printLine(Type.of(Integer).name)
end
