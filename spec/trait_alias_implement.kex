# kex: run-beam
# `implement:` through a module alias (`using Geo, as: Geo2` then
# `implement: Geo2.Shape`). The checker resolves the alias; BEAM inherits
# the trait's defaults from the checker's answer instead of re-resolving
# from its pre-pass usings (which know no aliases) and dropping them
# with `Undefined method: describe for Circle`.
# (The walker does not resolve the alias yet — see the plan's step 5
# note — so this spec pins BEAM only.)
module Geo do
  trait Shape do
    area :> Float

    let describe = "area=${this.area}"
  end
end

record Circle do
  radius: Float
end

using Geo, as: Geo2

make Circle, implement: Geo2.Shape do
  let area = 3.0 * @radius
end

main do
  let c = Circle { radius: 2.0 }
  IO.printLine(c.describe)
end
