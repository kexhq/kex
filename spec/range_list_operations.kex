# Range's list-shaped operations carry explicit signatures over the range's
# own element type, so they work on a numeric range and not only on a char one
# (issue #213), and the total accessor is `get(index, fallback)` — the same
# at/get split List, String and Map use (issue #214).

main do
  # indexOf used to bind its argument to Char, so this did not compile.
  IO.printLine((10..20).indexOf(12).inspected)
  IO.printLine(('a'..'e').indexOf('c').inspected)
  IO.printLine((10..20).indexOf(99).inspected)

  # A block over a numeric range's items sees Integers.
  IO.printLine((1..10).partition { |n| n.even? })
  IO.printLine((1..10).items.partition { |n| n.even? })
  IO.printLine((1..5).reject { |n| n.even? })

  # at is the partial accessor; get is partial at arity 1 and total at arity 2.
  IO.printLine((10..20).at(0).inspected)
  IO.printLine((10..20).at(99).inspected)
  IO.printLine((10..20).get(0).inspected)
  IO.printLine((10..20).get(99).inspected)
  IO.printLine((10..20).get(0, 0))
  IO.printLine((10..20).get(99, 0))

  IO.printLine((1..3).zip(["a", "b", "c"]))
  IO.printLine((1..4).sort { |a, b| a > b })
  IO.printLine((1..4).take(2))
  IO.printLine((1..4).drop(2))
  IO.printLine((1..4).push(5))
  IO.printLine((1..4).contains?(3))
  IO.printLine((1..4).join(", "))
end
