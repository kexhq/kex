# Replacing the network for a lexical region (kexhq/kex#143) — the case
# `Mock.Http` exists for, without the global state.
#
# Nothing here performs a real request: the capability is replaced, so the
# code under test cannot reach the network even by accident. `Mock.Http` had
# to be started and stopped around the test, and a forgotten stop leaked into
# whatever ran next.

record FakeHttp do
  body : String
end

make FakeHttp, implement: Http do
  foul get(url) = Ok(HttpResponse { status: 200, body: @body, headers: {} })
  foul get(url, opts) = Ok(HttpResponse { status: 200, body: @body, headers: {} })
  foul post(url, body) = Error(HttpError { kind: NotImplemented, message: "post not stubbed" })
  foul post(url, body, opts) = Error(HttpError { kind: NotImplemented, message: "post not stubbed" })
  foul put(url, body) = Error(HttpError { kind: NotImplemented, message: "put not stubbed" })
  foul put(url, body, opts) = Error(HttpError { kind: NotImplemented, message: "put not stubbed" })
  foul patch(url, body) = Error(HttpError { kind: NotImplemented, message: "patch not stubbed" })
  foul patch(url, body, opts) = Error(HttpError { kind: NotImplemented, message: "patch not stubbed" })
  foul delete(url) = Error(HttpError { kind: NotImplemented, message: "delete not stubbed" })
  foul delete(url, opts) = Error(HttpError { kind: NotImplemented, message: "delete not stubbed" })
  foul head(url) = Error(HttpError { kind: NotImplemented, message: "head not stubbed" })
  foul head(url, opts) = Error(HttpError { kind: NotImplemented, message: "head not stubbed" })
  foul options(url) = Error(HttpError { kind: NotImplemented, message: "options not stubbed" })
  foul options(url, opts) = Error(HttpError { kind: NotImplemented, message: "options not stubbed" })
end

# Declares no dependency and threads nothing.
foul fetch(u: String) -> String = match Http.get(u) do
  Ok(response) => response.body
  Error(_) => "(failed)"
end

main do
  with Http = FakeHttp { body: "canned page" } do
    IO.printLine(fetch("https://example.invalid/"))
  end
end
