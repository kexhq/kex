# kex: run-beam
# An exception raised inside an Erlang call is rescuable, by `trying … rescue`
# and by a function-level `rescue`, like any Kex failure (kexhq/kex#326). An
# Erlang `throw` is too, as the thrown value (kexhq/kex#400).
#
# `binary_to_integer` raises `badarg` on every OTP release. An Erlang function
# that only exists on newer releases (`json:decode`, OTP 27+) would raise
# `undef` on older ones instead, and the output would depend on the CI image.
foul decodeNumber(text: String) -> String do
  trying do
    let value = BEAM.erlang.binary_to_integer(text)
    return "decoded ${Type.of(value).name}"
  rescue
    _ => return "rescued"
  end
end

foul decodeNumberWithRescue(text: String) -> String do
  let value = BEAM.erlang.binary_to_integer(text)
  return "decoded ${Type.of(value).name}"
rescue |error|
  return "rescued ${error}"
end

foul thrown(value: Atom) -> String do
  BEAM.erlang.throw(value)
  return "not thrown"
rescue |error|
  return "rescued thrown ${error}"
end

main do
  IO.printLine(decodeNumber("42"))
  IO.printLine(decodeNumberWithRescue("nope"))
  IO.printLine(decodeNumber("nope"))
  IO.printLine(thrown(:oops))
end
