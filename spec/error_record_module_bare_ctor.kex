# A capitalized constructor declared in `module Temperature` lives only under
# that namespace — reaching it as a bare name is a compile-time error, not a
# silent fallthrough to some other binding.
record Temperature do
  celsius : Float
end

module Temperature do
  let Fahrenheit(value: Float) -> Temperature do
    return Temperature { celsius: (value - 32.0) * 5.0 / 9.0 }
  end
end

main do
  Fahrenheit(0.0)
end
