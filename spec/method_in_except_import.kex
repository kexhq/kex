# kex: check-only
# The other side of error_method_outside_except_import.kex: excepting some
# other child of `Net.HTTP` leaves `Net.HTTP.Server.localAddress` in reach as
# a method (kexhq/kex#570).
using Net.HTTP, except: [Router]

foul address(running: Net.HTTP.Server.Running) = running.localAddress

main do
  IO.printLine("checked")
end
