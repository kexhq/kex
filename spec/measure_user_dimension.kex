# A program adds a dimension of its own as the stdlib adds its own: a record
# for the dimension, a unit, and the products it declares, each saying the
# dimension it answers (docs/typechecker-hm-plan.md §8.1). A `/` on
# `Measure<Currency>` is an overload beside the prelude's `/` on a Duration,
# not a second definition of it (KEXET-0128 compared only the name `Measure`).

record Currency do
end

record Rate do
end

let euro(value: Float) -> Measure<Currency> = Measure {
  canonical: value,
  value: value,
  unit: UnitDefinition { conversionFactor: 1.0, dimension: :currency, notation: "EUR" }
}

make Measure<Currency> do
  let /(other: Measure<Quantity.Time>) -> Measure<Rate> = Measure {
    canonical: @canonical / other.canonical,
    value: @canonical / other.canonical,
    unit: UnitDefinition { conversionFactor: 1.0, dimension: :rate, notation: "EUR/s" }
  }
end

main do
  let pay: Measure<Rate> = euro(3600.0) / 1.hour
  IO.printLine(pay.canonical)
  IO.printLine((euro(1.0) + euro(2.0)).canonical)
end
