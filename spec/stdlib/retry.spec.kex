using Control.Retry
using Net
using Net.HTTP

type RetryTrace = Called | Waited(Duration) | Sampled | Notified(Integer, Integer, Integer, Duration, Duration)
type RetryReply = RetryResponse(Result<Response<Binary>, NetError>)

foul trace() -> [RetryTrace] do
  receive do
    Called => [Called] + trace()
    Waited(delay) => [Waited(delay)] + trace()
    Sampled => [Sampled] + trace()
    Notified(attempt, nextAttempt, remaining, delay, elapsed) =>
      [Notified(attempt, nextAttempt, remaining, delay, elapsed)] + trace()
  after timeout: 0
    []
  end
end

foul recordWait(delay: Duration) -> Void do
  Process.self.send(Waited(delay))
  ()
end
foul recordedError() -> Result<String, String> do
  Process.self.send(Called)
  Error("temporary")
end

foul discardReplies() -> Void do
  receive do
    RetryResponse(_) => discardReplies()
  after timeout: 0
    ()
  end
end

foul scriptedGet() -> Result<Response<Binary>, NetError> do
  Process.self.send(Called)
  receive do
    RetryResponse(result) => result
  after timeout: 0
    assert(false, "unexpected request: script exhausted")
    Error(NetError { kind: MockEmpty, operation: HTTPClient, message: "empty script" })
  end
end

describe "Control.Retry" do
  after do
    trace()
    discardReplies()
  end

  it "returns success immediately without sleeping or sampling randomness" do
    let result = Retry.run(
      sleeper: { |wait| assert(false, "unexpected sleep"); () },
      random: { assert(false, "unexpected randomness"); 0.0 },
      onRetry: { |_info| assert(false, "unexpected retry notice"); () }
    ) do
      Ok(42)
    end
    Assert.equal(result, Ok(42))
  end

  it "counts the initial attempt and returns the final error unchanged" do
    let result = Retry.run(
      attempts: 3, delay: 250.millisecond, backoff: 1.0,
      jitter: 0.0, sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [
      Called, Waited(250.millisecond), Called,
      Waited(250.millisecond), Called
    ])
  end

  it "uses three attempts by default" do
    let result = Retry.run(jitter: 0.0, sleeper: ~recordWait) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [
      Called, Waited(100.millisecond), Called,
      Waited(200.millisecond), Called
    ])
  end

  it "uses the documented exponential schedule" do
    let schedule = Retry.Schedule {
      attempts: 5, delay: 200.millisecond, backoff: 2.0,
      maximumDelay: 5.second, jitter: 0.0
    }
    let result = Retry.run(schedule: schedule, sleeper: ~recordWait) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [
      Waited(200.millisecond), Waited(400.millisecond),
      Waited(800.millisecond), Waited(1600.millisecond)
    ])
  end

  it "continues at the delay cap until attempts run out" do
    let schedule = Retry.Schedule {
      attempts: 6, delay: 500.millisecond, backoff: 2.0,
      maximumDelay: 2.second, jitter: 0.0
    }
    let result = Retry.run(schedule: schedule, sleeper: ~recordWait) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [
      Waited(500.millisecond), Waited(1.second), Waited(2.second),
      Waited(2.second), Waited(2.second)
    ])
  end

  it "caps the initial delay as well as subsequent delays" do
    let result = Retry.run(
      attempts: 2, delay: 10.second, maximumDelay: 1.second,
      jitter: 0.0, sleeper: ~recordWait
    ) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [Waited(1.second)])
  end

  it "caps actual sleep after applying positive jitter" do
    let result = Retry.run(
      attempts: 2, delay: 4.second, maximumDelay: 4.second,
      jitter: 0.25, random: { 1.0 }, sleeper: ~recordWait
    ) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [Waited(4.second)])
  end

  it "does not compound jitter into the exponential sequence" do
    let result = Retry.run(
      attempts: 3, delay: 1.second, maximumDelay: 10.second,
      jitter: 0.5, random: { 0.0 }, sleeper: ~recordWait
    ) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [Waited(500.millisecond), Waited(1.second)])
  end

  it "stops before exceeding total scheduled sleep" do
    let result = Retry.run(
      attempts: 5, delay: 1.second, backoff: 2.0,
      maximumTotalDelay: Just(2.second), jitter: 0.0,
      sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called, Waited(1.second), Called])
  end

  it "allows sleep exactly equal to the remaining budget" do
    let result = Retry.run(
      attempts: 3, delay: 1.second, backoff: 1.0,
      maximumTotalDelay: Just(1.second), jitter: 0.0,
      sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called, Waited(1.second), Called])
  end

  it "counts actual jittered sleep against the budget" do
    let result = Retry.run(
      attempts: 3, delay: 4.second, maximumDelay: 10.second,
      maximumTotalDelay: Just(5.second), jitter: 0.5,
      random: { 1.0 }, sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called])
  end

  it "shares settings without sharing attempt or backoff state" do
    let schedule = Retry.Schedule {
      attempts: 3, delay: 100.millisecond, jitter: 0.0
    }
    let first = Retry.run(schedule: schedule, sleeper: ~recordWait) do
      Error("first")
    end
    let second = Retry.run(schedule: schedule, sleeper: ~recordWait) do
      Error("second")
    end
    Assert.equal(first, Error("first"))
    Assert.equal(second, Error("second"))
    Assert.equal(trace(), [
      Waited(100.millisecond), Waited(200.millisecond),
      Waited(100.millisecond), Waited(200.millisecond)
    ])
  end

  it "overrides schedule settings for one execution only" do
    let schedule = Retry.Schedule { attempts: 5, jitter: 0.0 }
    let result = Retry.run(
      schedule: schedule, attempts: 1, sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(schedule.attempts, 5)
    Assert.equal(trace(), [Called])
  end

  it "normalizes nonpositive attempt counts to one execution" do
    let result = Retry.run(attempts: -5, sleeper: ~recordWait) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called])
  end

  it "keeps HTTP error statuses as successful transport results" do
    let response = Response.text(503, "busy")
    let result = Retry.run(sleeper: ~recordWait) do
      Process.self.send(Called)
      Ok(response)
    end
    Assert.equal(result, Ok(response))
    Assert.equal(trace(), [Called])
  end

  it "distinguishes explicit completion from exhaustion" do
    let completed = Retry.run(attempts: 3, sleeper: ~recordWait) do
      Retry.done("finished")
    end
    Assert.equal(completed, Retry.Done("finished"))
    Assert.equal(trace(), [])
    let exhausted = Retry.run(
      attempts: 2, jitter: 0.0, sleeper: ~recordWait
    ) do
      Retry.again("pending")
    end
    Assert.equal(exhausted, Retry.Again("pending"))
    Assert.equal(trace(), [Waited(100.millisecond)])
  end

  it "can stop immediately with an application error" do
    let result = Retry.run(
      sleeper: ~recordWait,
      onRetry: { |_info| assert(false, "explicit stop must not notify"); () }
    ) do
      Retry.done(Error("invalid credentials"))
    end
    Assert.equal(result, Retry.Done(Error("invalid credentials")))
    Assert.equal(trace(), [])
  end
  it "recovers from a timeout and a 503 without repeating a successful request" do
    let requestError = NetError {
      kind: Timeout, operation: HTTPClient, message: "request timed out"
    }
    let response = Response.text(200, "inventory ready")
    Process.self.send(RetryResponse(Error(requestError)))
    Process.self.send(RetryResponse(Ok(Response.text(503, "busy"))))
    Process.self.send(RetryResponse(Ok(response)))
    let result = Retry.run(
      attempts: 5, delay: 200.millisecond, jitter: 0.0, sleeper: ~recordWait
    ) do
      let responseResult = scriptedGet()
      match responseResult do
        Error(error) => if error.kind == Timeout || error.kind == Connect
          Retry.again(responseResult)
        else
          Retry.done(responseResult)
        end
        Ok(value) => if [429, 502, 503, 504].contains?(value.status.code)
          Retry.again(responseResult)
        else
          Retry.done(responseResult)
        end
      end
    end
    Assert.equal(result, Retry.Done(Ok(response)))
    Assert.equal(trace(), [
      Called, Waited(200.millisecond), Called,
      Waited(400.millisecond), Called
    ])
  end

  it "automatically stops after an error is followed by success" do
    let response = Response.text(200, "ready")
    Process.self.send(RetryResponse(Error(NetError {
      kind: Timeout, operation: HTTPClient, message: "request timed out"
    })))
    Process.self.send(RetryResponse(Ok(response)))
    let result = Retry.run(attempts: 5, jitter: 0.0, sleeper: ~recordWait) do
      scriptedGet()
    end
    Assert.equal(result, Ok(response))
    Assert.equal(trace(), [Called, Waited(100.millisecond), Called])
  end

  it "preserves the final rejected response on explicit exhaustion" do
    let response = Response.text(503, "still busy")
    let result = Retry.run(attempts: 2, jitter: 0.0, sleeper: ~recordWait) do
      Process.self.send(Called)
      Retry.again(Ok(response))
    end
    Assert.equal(result, Retry.Again(Ok(response)))
    Assert.equal(trace(), [Called, Waited(100.millisecond), Called])
  end

  it "supports the no-options call with a trailing block" do
    let result = Retry.run do
      Ok("ready")
    end
    Assert.equal(result, Ok("ready"))
  end

  it "accepts a random override while retaining real zero-duration sleep" do
    let result = Retry.run(attempts: 2, delay: 0.second, random: {
      Process.self.send(Sampled)
      0.5
    }) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called, Sampled, Called])
  end

  it "normalizes negative delays and multipliers below one" do
    let result = Retry.run(
      attempts: 3, delay: (-1).second, backoff: 0.5,
      jitter: 0.0, sleeper: ~recordWait
    ) do
      Error("temporary")
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Waited(0.second), Waited(0.second)])
  end

  it "clamps random samples and jitter fractions" do
    let result = Retry.run(
      attempts: 2, delay: 1.second, jitter: 2.0,
      random: { -1.0 }, sleeper: ~recordWait
    ) do
      Error("temporary")
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Waited(0.second)])
  end

  it "can disable a schedule sleep budget by explicitly passing None" do
    let schedule = Retry.Schedule {
      attempts: 2, maximumTotalDelay: Just(0.second), jitter: 0.0
    }
    let result = Retry.run(
      schedule: schedule, maximumTotalDelay: None, sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called, Waited(100.millisecond), Called])
  end

  it "reports retry progress before sleeping, with the unchanged last result" do
    let result = Retry.run(
      attempts: 3, delay: 200.millisecond, jitter: 0.0,
      sleeper: ~recordWait,
      onRetry: { |info|
        Assert.equal(info.maximumAttempts, 3)
        Assert.equal(info.result, Error("temporary"))
        Process.self.send(Notified(
          info.attempt, info.nextAttempt, info.remainingAttempts,
          info.delay, info.totalDelay
        ))
        ()
      }
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [
      Called, Notified(1, 2, 2, 200.millisecond, 0.second),
      Waited(200.millisecond), Called,
      Notified(2, 3, 1, 400.millisecond, 200.millisecond),
      Waited(400.millisecond), Called
    ])
  end

  it "does not announce retries denied by the total sleep budget" do
    let result = Retry.run(
      maximumTotalDelay: Just(0.second), jitter: 0.0,
      sleeper: ~recordWait,
      onRetry: { |_info| assert(false, "no retry is allowed"); () }
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called])
  end

  it "reports explicit retry decisions through the same progress callback" do
    let result = Retry.run(
      attempts: 2, jitter: 0.0, sleeper: ~recordWait,
      onRetry: { |info| Assert.equal(info.result, Retry.Again("pending")); () }
    ) do
      Retry.again("pending")
    end
    Assert.equal(result, Retry.Again("pending"))
    Assert.equal(trace(), [Waited(100.millisecond)])
  end

  it "reports the actual jittered and capped upcoming delay" do
    let result = Retry.run(
      attempts: 2, delay: 4.second, maximumDelay: 4.second,
      jitter: 0.5, random: { 2.0 }, sleeper: ~recordWait,
      onRetry: { |info|
        Assert.equal(info.delay, 4.second)
        Assert.equal(info.totalDelay, 0.second)
        ()
      }
    ) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [Waited(4.second)])
  end

  it "clamps negative jitter to zero without consulting randomness" do
    let result = Retry.run(
      attempts: 2, delay: 1.second, jitter: -0.5,
      sleeper: ~recordWait,
      random: { assert(false, "zero jitter needs no randomness"); 0.0 }
    ) do
      Error("busy")
    end
    Assert.equal(result, Error("busy"))
    Assert.equal(trace(), [Waited(1.second)])
  end

  it "normalizes a negative total sleep allowance to zero" do
    let result = Retry.run(
      attempts: 5, maximumTotalDelay: Just((-1).second),
      jitter: 0.0, sleeper: ~recordWait
    ) do
      recordedError()
    end
    Assert.equal(result, Error("temporary"))
    Assert.equal(trace(), [Called])
  end

end
