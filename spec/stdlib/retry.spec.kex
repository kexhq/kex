using Control.Retry

describe("Control.Retry") do
  it("stops immediately when the predicate rejects an error") do
    let result = Retry.run(
      Retry.fixed(5, Duration.seconds(0)),
      { |error| assert(error == "permanent"); false },
      do Error("permanent") end
    )

    Assert.equal(result, Error("permanent"))
  end

  it("does not sleep when the next delay exceeds the elapsed bound") do
    let policy = Retry.fixed(
      5,
      Duration.seconds(1)
    ).withMaximumElapsed(Duration.seconds(0))

    let result = Retry.runWith(
      policy,
      { |error| true },
      { |delay| assert(false, "elapsed bound must prevent sleeping") },
      do Error("temporary") end
    )

    Assert.equal(result, Error("temporary"))
  end

  it("applies bounded jitter from an injected random source") do
    let result = Retry.runWithRandom(
      Retry.fixed(2, Duration.seconds(4)).withJitter(0.25),
      { |error| error == "temporary" },
      { |delay| Assert.equal(delay, Duration.seconds(3)) },
      { 0.0 },
      { Error("temporary") }
    )

    Assert.equal(result, Error("temporary"))
  end

  it("counts jittered sleep against maximum elapsed time") do
    let policy = Retry.fixed(2, Duration.seconds(4))
      .withJitter(0.5)
      .withMaximumElapsed(Duration.seconds(5))

    let result = Retry.runWithRandom(
      policy,
      { |error| true },
      { |delay| assert(false, "six-second jittered delay must exceed the bound") },
      { 1.0 },
      { Error("temporary") }
    )

    Assert.equal(result, Error("temporary"))
  end
end
