# kex: no-check

using Kex.AST

describe("Kex.AST.parse") do
  it("parses a function definition") do
    match Kex.AST.parse("let add(x, y) = x + y") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1, "expected 1 item")
        items.each do |item|
          match item do
            FunctionDef(Kex.AST.FunctionInfo { name }) => assert(name == "add")
            _ => assert(false, "expected FunctionDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("parses a record definition") do
    match Kex.AST.parse("record Point do\n  x : Int\n  y : Int\nend") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1)
        items.each do |item|
          match item do
            RecordDef(Kex.AST.RecordInfo { name, fields }) => do
              assert(name == "Point")
              assert(fields.length == 2)
            end
            _ => assert(false, "expected RecordDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("parses a type definition with variants") do
    match Kex.AST.parse("type Color = Red | Green | Blue") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1)
        items.each do |item|
          match item do
            TypeDef(Kex.AST.TypeInfo { name, variants }) => do
              assert(name == "Color")
              assert(variants.map { |v| v.length } == Just(3))
            end
            _ => assert(false, "expected TypeDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("parses a module definition") do
    match Kex.AST.parse("module Foo do\n  let bar = 1\nend") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1)
        items.each do |item|
          match item do
            ModuleDef(Kex.AST.ModuleInfo { name }) => assert(name == "Foo")
            _ => assert(false, "expected ModuleDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("parses a main block") do
    match Kex.AST.parse("main do\n  1 + 2\nend") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1)
        items.each do |item|
          match item do
            MainDef(_) => assert(true)
            _ => assert(false, "expected MainDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("parses top-level let as ConstantDef") do
    match Kex.AST.parse("let x = 42") do
      Ok(Kex.AST.Program { items }) => do
        assert(items.length == 1)
        items.each do |item|
          match item do
            ConstantDef(Kex.AST.ConstantInfo { name }) => assert(name == "x")
            _ => assert(false, "expected ConstantDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("returns empty items for unrecoverable syntax") do
    match Kex.AST.parse("let = =") do
      Ok(Kex.AST.Program { items }) => assert(items.length == 0)
      Error(Kex.AST.ParseError { message }) => assert(message.length > 0)
    end
  end

  it("accepts an optional filename argument") do
    match Kex.AST.parse("let f = 1", "test.kex") do
      Ok(Kex.AST.Program { items }) => do
        items.each do |item|
          match item do
            ConstantDef(Kex.AST.ConstantInfo { location }) => assert(location.file == "test.kex")
            _ => assert(false, "expected ConstantDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end
end

describe("Kex.AST.parseFile") do
  it("parses an existing file") do
    match Kex.AST.parseFile("./examples/records.kex") do
      Ok(Kex.AST.Program { items }) => assert(items.length > 0, "should have items")
      Error(e) => assert(false, "parseFile failed: ${e.message}")
    end
  end

  it("returns Error for missing file") do
    match Kex.AST.parseFile("./nonexistent_file_xyz.kex") do
      Ok(_) => assert(false, "should fail for missing file")
      Error(Kex.AST.ParseError { message }) => assert(message.contains?("not found") || message.contains?("Not found"))
    end
  end
end

describe("Kex.AST.parseType") do
  it("parses a simple type") do
    match Kex.AST.parseType("Int") do
      Ok(ref) => assert(ref.to(String) == Just("Int"))
      Error(_) => assert(false, "should parse Int")
    end
  end

  it("parses a generic type") do
    match Kex.AST.parseType("Result<Int, String>") do
      Ok(ref) => assert(ref.to(String) == Just("Result<Int, String>"))
      Error(_) => assert(false, "should parse generic")
    end
  end

  it("parses a function type") do
    match Kex.AST.parseType("Int -> Bool") do
      Ok(ref) => assert(ref.to(String) == Just("(Int) -> Bool"))
      Error(_) => assert(false, "should parse function type")
    end
  end

  it("parses a list type") do
    match Kex.AST.parseType("[String]") do
      Ok(ref) => assert(ref.to(String) == Just("[String]"))
      Error(_) => assert(false, "should parse list type")
    end
  end

  it("parses a nullable type") do
    match Kex.AST.parseType("Int?") do
      Ok(ref) => assert(ref.to(String) == Just("Int?"))
      Error(_) => assert(false, "should parse nullable type")
    end
  end
end

describe("Doc-comment extraction") do
  it("extracts single-line doc comments") do
    let src = "# Adds two numbers.\nlet add(x, y) = x + y"
    match Kex.AST.parse(src) do
      Ok(Kex.AST.Program { items }) => do
        items.each do |item|
          match item do
            FunctionDef(Kex.AST.FunctionInfo { doc }) => assert(doc == Just("Adds two numbers."))
            _ => assert(false, "expected FunctionDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("preserves paragraph breaks in multi-line docs") do
    let src = "# First paragraph.\n#\n# Second paragraph.\nlet foo = 1"
    match Kex.AST.parse(src) do
      Ok(Kex.AST.Program { items }) => do
        items.each do |item|
          match item do
            ConstantDef(Kex.AST.ConstantInfo { doc }) => do
              assert(doc.try.contains?("First paragraph."))
              assert(doc.try.contains?("Second paragraph."))
            end
            _ => assert(false, "expected ConstantDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end

  it("returns None for undocumented definitions") do
    match Kex.AST.parse("let bare = 1") do
      Ok(Kex.AST.Program { items }) => do
        items.each do |item|
          match item do
            ConstantDef(Kex.AST.ConstantInfo { doc }) => assert(doc == None)
            _ => assert(false, "expected ConstantDef")
          end
        end
      end
      Error(_) => assert(false, "parse should succeed")
    end
  end
end

describe("TypeRef.to(String)") do
  it("renders named types") do
    match Kex.AST.parseType("String") do
      Ok(ref) => assert(ref.to(String) == Just("String"))
      _ => assert(false, "parse failed")
    end
  end

  it("renders map types") do
    match Kex.AST.parseType("{String: Int}") do
      Ok(ref) => assert(ref.to(String) == Just("{String: Int}"))
      _ => assert(false, "parse failed")
    end
  end
end
