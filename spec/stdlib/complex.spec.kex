using Complex

describe("Complex arithmetic") do
  it("adds, subtracts, multiplies and divides") do
    let a = Complex.Complex { n: 3, i: 4 }
    let b = Complex.Complex { n: 1, i: -2 }
    let sum = a + b
    assert(sum.n == 4 && sum.i == 2)
    let difference = a - b
    assert(difference.n == 2 && difference.i == 6)
    let product = a * b
    assert(product.n == 11 && product.i == -2)
    let quotient = a / b
    assert(quotient.n == -1 && quotient.i == 2)
    let half = Complex.Complex { n: 1, i: 1 } / Complex.Complex { n: 2, i: 0 }
    assert(half.n == 0.5 && half.i == 0.5)
  end

  it("provides identities and conjugation") do
    assert((Complex.I * Complex.I).n == -1)
    assert((Complex.I * Complex.NEG_I).n == 1)
    let imaginary = Complex.I
    let conjugated: Complex.Complex = Complex.conjugateOf(imaginary)
    assert(conjugated.i == -1)
    let byMethod: Complex.Complex = imaginary.conjugate
    assert(byMethod.i == -1)
    assert((Complex.ONE + Complex.ZERO).n == 1)
  end

  it("combines complex values with real scalars") do
    let z = Complex.Complex { n: 1, i: 2 }
    let sum = z + 3
    let difference = z - 3
    let product = z * 3
    let quotient = z / 2
    assert(sum.n == 4 && sum.i == 2)
    assert(difference.n == -2 && difference.i == 2)
    assert(product.n == 3 && product.i == 6)
    assert(quotient.n == 0.5 && quotient.i == 1.0)
  end

  it("accepts a real scalar on the left") do
    let z = Complex.Complex { n: 1, i: 2 }
    let sum = 3 + z
    let difference = 3 - z
    let product = 3 * z
    let quotient = 2 / Complex.I
    assert(sum.n == 4 && sum.i == 2)
    assert(difference.n == 2 && difference.i == -2)
    assert(product.n == 3 && product.i == 6)
    assert(quotient.n == 0.0 && quotient.i == -2.0)
    let mixed = 2.5 + z
    assert(mixed.n == 3.5 && mixed.i == 2)
  end

  it("shows rectangular and polar values") do
    let positive = Complex.Complex { n: 3, i: 4 }
    let negative = Complex.Complex { n: 3, i: -4 }
    assert(positive.showValue == "3+4i")
    assert(negative.showValue == "3-4i")
    let polar = Complex.Polar { radius: 2, theta: 0 }
    assert(polar.showValue == "(2, 0)")
  end
end

describe("Complex elementary functions") do
  it("computes roots, powers, exponentials and logarithms") do
    let zero = Complex.ZERO
    let one = Complex.ONE
    assert(zero.exp.n == 1.0 && zero.exp.i == 0.0)
    assert(one.log.n == 0.0 && one.log.i == 0.0)
    assert((Complex.I ^ 2).n == -1.0)
    let root = (Complex.Complex { n: -1, i: 0 }).sqrt
    assert(Math.abs(root.n) < 0.0000001 && Math.abs(root.i - 1.0) < 0.0000001)
    let power = Complex.I ^ Complex.Complex { n: 2, i: 0 }
    assert(Math.abs(power.n + 1.0) < 0.0000001)
  end

  it("computes complex trigonometric functions") do
    let zero = Complex.ZERO
    assert(zero.sin.n == 0.0 && zero.sin.i == 0.0)
    assert(zero.cos.n == 1.0 && zero.cos.i == 0.0)
    assert(zero.tan.n == 0.0 && zero.tan.i == 0.0)
    let imaginary = Complex.I
    assert(imaginary.sin.n == 0.0)
    assert(Math.abs(imaginary.sin.i - Math.sinh(1.0)) < 0.0000001)
  end
end

describe("Complex polar coordinates") do
  it("computes magnitude and argument") do
    let z = Complex.Complex { n: 3, i: 4 }
    assert(z.absSquared == 25)
    assert(z.abs == 5.0)
    assert(Complex.I.arg == Math.PI / 2.0)
    assert(z.polar.radius == 5.0)
  end

  it("converts polar coordinates to rectangular form") do
    let z: Complex.Complex = Complex.fromPolar(2, 0)
    assert(z.n == 2.0 && z.i == 0.0)
    let polar = Complex.Polar { radius: 2, theta: 0 }
    assert(polar.complex.n == 2.0)
    assert(Complex.fromPolarCoordinates(polar).i == 0.0)
  end
end
