using Units.Data

describe("Units.Data") do
  it("constructs data using the shared Measure type") do
    let size = 5.size(MB)
    assert(size.canonical == 5000000.0)
    assert(size.value == 5.0)
    assert(size.kind == :data)
  end

  it("distinguishes decimal and binary units") do
    assert(1.size(KB).canonical == 1000.0)
    assert(1.size(KiB).canonical == 1024.0)
    assert(1.megabytes.canonical == 1000000.0)
    assert(1.mebibytes.canonical == 1048576.0)
  end

  it("constructs every decimal and binary data unit") do
    assert(1.size(B).canonical == 1.0)
    assert(1.size(KB).canonical == 1000.0)
    assert(1.size(MB).canonical == 1000000.0)
    assert(1.size(GB).canonical == 1000000000.0)
    assert(1.size(TB).canonical == 1000000000000.0)
    assert(1.size(KiB).canonical == 1024.0)
    assert(1.size(MiB).canonical == 1048576.0)
    assert(1.size(GiB).canonical == 1073741824.0)
    assert(1.size(TiB).canonical == 1099511627776.0)
    assert(1.byteSize.symbol == "B")
    assert(1.gigabytes.symbol == "GB")
    assert(1.terabytes.symbol == "TB")
    assert(1.kibibytes.symbol == "KiB")
    assert(1.gibibytes.symbol == "GiB")
    assert(1.tebibytes.symbol == "TiB")
  end

  it("converts display units without losing the canonical value") do
    match 10.megabytes.convertTo(MiB) do
      Ok(size) => do
        assert(size.canonical == 10000000.0)
        assert(size.value == 9.5367431640625)
        assert(size.unit.symbol == "MiB")
      end
      Error(_) => assert(false)
    end
  end

  it("formats decimal data prefixes from canonical bytes") do
    let size = 5000000.byteSize
    assert(size.to(String, in: Kilo) == Just("5000.0 KB"))
    assert(size.to(String, in: Mega) == Just("5.0 MB"))
    assert(size.to(String, in: Giga) == Just("0.005 GB"))
    assert(5.megabytes.to(String, in: Mega) == Just("5.0 MB"))
    assert(1.sec.to(String, in: Mega) == None)
  end

  it("adds data measures using canonical bytes") do
    match 1.megabytes + 500.kilobytes do
      Ok(total) => do
        assert(total.canonical == 1500000.0)
        assert(total.value == 1.5)
      end
      Error(_) => assert(false)
    end
  end

  it("rejects converting a non-data measure") do
    match 1.sec.convertTo(KB) do
      Ok(_) => assert(false)
      Error(_) => assert(true)
    end
  end
end
