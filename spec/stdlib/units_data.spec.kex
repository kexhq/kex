using Units.Data

let checkFileSize(file: FS.FileInfo) -> String do
  if file.size > 30.megabyte
    return "FileTooBig"
  end
  return "Accepted"
end

describe("Units.Data") do
  it("constructs data using the shared Measure type") do
    let size = 5.size(MB)
    assert(size.canonical == 5000000.0)
    assert(size.value == 5.0)
    assert(size.kind == :data)
  end

  it("compares byte counts with decimal thresholds at the boundary") do
    assert(30000001 > 30.megabyte)
    assert(!(30000000 > 30.megabyte))
    assert(29999999 < 30.megabyte)
    assert(!(30000000 < 30.megabyte))
    assert(30000000 <= 30.megabyte)
    assert(30000000 >= 30.megabyte)
    assert(!(30000001 <= 30.megabyte))
    assert(!(29999999 >= 30.megabyte))
  end

  it("uses an integer file-size field directly in a conditional") do
    let file = FS.FileInfo {
      kind: :file, size: 30000001,
      modified: DateTime.fromEpochSeconds(0)
    }
    assert(checkFileSize(file) == "FileTooBig")
    assert(checkFileSize(FS.FileInfo { ...file, size: 30000000 }) == "Accepted")
  end

  it("supports reversed comparisons and binary units") do
    assert(1.mebibyte < 1048577)
    assert(1.mebibyte > 1048575)
    assert(1.mebibyte <= 1048576)
    assert(1.mebibyte >= 1048576)
    assert(1048576 > 1.megabyte)
    assert(!(1048576 > 1.mebibyte))
    assert(1025 > 1.kibibyte)
    assert(512 <= 0.5.kibibyte)
  end

  it("compares payload sizes without changing the integer byte count") do
    let payload = Binary.fromBytes([104, 105])
    assert(payload.length == 2)
    assert(payload.length < 1.kibibyte)
    assert("é".count == 1)
    assert("é".bytes.count == 2)
    assert("é".bytes.count > 1.byte)
  end

  it("keeps ordinary numeric comparisons unchanged") do
    assert(5 > 4)
    assert(4 < 5.0)
    assert(5 >= 5.0)
    assert(5 <= 5)
    assert("a" < "b")
    assert('a' < 'b')
  end

  it("distinguishes decimal and binary units") do
    assert(1.size(KB).canonical == 1000.0)
    assert(1.size(KiB).canonical == 1024.0)
    assert(1.megabyte.canonical == 1000000.0)
    assert(1.mebibyte.canonical == 1048576.0)
  end

  it("constructs every decimal and binary data unit") do
    assert(1.size(B).canonical == 1.0)
    assert(1.size(KB).canonical == 1000.0)
    assert(1.size(MB).canonical == 1000000.0)
    assert(1.size(GB).canonical == 1000000000.0)
    assert(1.size(TB).canonical == 1000000000000.0)
    assert(1.size(KiB).canonical == 1024.0)
    assert(1.size(MiB).canonical == 1048576.0)
    assert(1.size(GiB).canonical == 1073741824.0)
    assert(1.size(TiB).canonical == 1099511627776.0)
    assert(1.byteSize.symbol == "B")
    assert(1.gigabyte.symbol == "GB")
    assert(1.terabyte.symbol == "TB")
    assert(1.kibibyte.symbol == "KiB")
    assert(1.gibibyte.symbol == "GiB")
    assert(1.tebibyte.symbol == "TiB")
  end

  it("converts display units without losing the canonical value") do
    match 10.megabyte.convertTo(MiB) do
      Ok(size) => do
        assert(size.canonical == 10000000.0)
        assert(size.value == 9.5367431640625)
        assert(size.unit.symbol == "MiB")
      end
      Error(_) => assert(false)
    end
  end

  it("formats decimal data prefixes from canonical bytes") do
    let size = 5000000.byteSize
    assert(size.to(String, in: Kilo) == Just("5000.0 KB"))
    assert(size.to(String, in: Mega) == Just("5.0 MB"))
    assert(size.to(String, in: Giga) == Just("0.005 GB"))
    assert(5.megabyte.to(String, in: Mega) == Just("5.0 MB"))
    assert(1.second.to(String, in: Mega) == None)
  end

  it("adds data measures using canonical bytes") do
    match 1.megabyte + 500.kilobyte do
      Ok(total) => do
        assert(total.canonical == 1500000.0)
        assert(total.value == 1.5)
      end
      Error(_) => assert(false)
    end
  end

  it("rejects converting a non-data measure") do
    match 1.second.convertTo(KB) do
      Ok(_) => assert(false)
      Error(_) => assert(true)
    end
  end
end
