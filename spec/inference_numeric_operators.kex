# kex: types-only
# Inference is pinned here by dumping every expression's inferred type
# (`-C -t`), so a change in how a type is chosen shows up as a diff rather
# than as a surprise in the REPL months later.
#
# The regression this was written for: `let fact(n) = n * fact(n - 1)`
# inferred `fact : Integer -> Period`. `n - 1` constrains `n` to `N: Number`,
# and a trait-bounded variable was treated as a CONCRETE receiver by operator
# resolution — so `n * ...` was free to match any operator overload whose
# parameter a constrained type satisfies, and `make Period`'s
# `*(factor: Integer) -> Period` (src/stdlib/time.kex) is one of those.
# Nothing in the program mentions time.

# The golden records what inference CURRENTLY concludes, which is not the same
# as what it ideally would: inside a recursive numeric function the recursive
# call is still the constrained variable `N`. A call from outside is not: the
# one `N` the operators share is the signature's generic, so `fact(5)` is an
# `Integer` (it was `N` until generalizing took bound placeholders in).

# Recursive, so the second clause is checked while the function's own result
# type is still being inferred — the case that went wrong.
let fact(0) = 1
let fact(n) = n * fact(n - 1)

# The same shape with `+`, which never had a unit overload to capture it.
let tally(0) = 0
let tally(n) = n + tally(n - 1)

# Non-recursive: both operands are known when the operator is resolved.
let twice(n) = n * 2
let half(n) = n / 2

main do
  let a = fact(5)
  let b = tally(5)
  let c = twice(21)
  let d = half(10)
end
