# kex: run-beam
# `Depot.Store.Store`, the record `Store` in spec/lib/depot/store.kex, is found
# through its module's file. That file's name matching the type's is not a
# misplaced module: Slick's `DB.Store.Store` stopped its build that way.
let describe(store: Depot.Store.Store) -> String = "store ${store.name}"

main do
  IO.printLine(describe(Depot.Store.open("main")))
end
