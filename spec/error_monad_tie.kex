# kex: check-only
# `.tie` binds the rest of its block, so it stands as a `let` (KEXET-0517);
# the block then answers the container again (KEXET-0518); a `return` in it
# would leave only the step flatMap runs (KEXET-0519); and it takes a value
# out of a Monad only (KEXET-0520). `.try` stays for what can fail, so a list
# has none (KEXET-0409).

let inline(xs: [Integer]) -> Integer = xs.tie + 1

let plain(xs: [Integer]) -> [Integer] do
  let x = xs.tie
  x + 1
end

let early(xs: [Integer]) -> [Integer] do
  let x = xs.tie
  return [] if x == 0
  [x]
end

let number(n: Integer) -> [Integer] do
  let x = n.tie
  [x]
end

let failing(xs: [Integer]) -> [Integer] do
  let x = xs.try
  [x]
end

main do
  IO.printLine("${inline([1])} ${plain([1])} ${early([1])} ${number(1)} ${failing([1])}")
end
