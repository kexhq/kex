# `Type.construct` takes a present value for an optional field as that value:
# decoded JSON has no `Just` to write, so `{"endLine": 3}` could not fill an
# `endLine : Integer?` (kexhq/kex#561). A missing field is `None`, as before,
# and so is a JSON `null`.
using JSON

record Finding do
  file    : String
  endLine : Integer?
end

# A parsed value is an `Any` until a type pattern narrows it.
let fieldsOf(text: String) -> {String: Any} = match JSON.parse(text).or({}) do
  fields: {String: Any} => fields
  _ => {}
end

main do
  let finding = Type.named("Finding")
  IO.printLine(finding.construct(fieldsOf("{\"file\": \"a\", \"endLine\": 3}")))
  IO.printLine(finding.construct(fieldsOf("{\"file\": \"b\"}")))
  IO.printLine(finding.construct(fieldsOf("{\"file\": \"c\", \"endLine\": null}")))
  IO.printLine(finding.construct(fieldsOf("{\"file\": \"d\", \"endLine\": \"x\"}")))
end
