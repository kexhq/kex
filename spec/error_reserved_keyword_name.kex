# kex: check-only
# A reserved word used as a name.
#
# `compiled do` owns the word, which is fair — but nothing said so: the parser
# reported "Unexpected token in make body: compiled" and then unwound to the
# top level, so one bad declaration scattered a screenful of errors across
# unrelated lines. Recovery now stays inside the make body.
record Router do
  routes : [String]
end

make Router do
  compiled :> String
  let compiled = "x"

  name :> String
  let name = "router"
end
