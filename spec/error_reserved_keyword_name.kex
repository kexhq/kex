# kex: check-only
# A reserved word used as a name.
#
# `compiled do` owns the word, which is fair — but nothing said so: the parser
# reported an unexpected token and then unwound, so one bad declaration
# scattered a screenful of errors across unrelated lines. Now the one bad
# declaration is reported once, and the rest still checks.
#
# A `make` function is the exception (kexhq/kex#508): it is only reached after
# `.`, where a keyword cannot start anything else, so `router.compiled` is
# unambiguous and the declarations in the make body below are fine.
let compiled = "x"

record Router do
  routes : [String]
end

make Router do
  compiled :> String
  let compiled = "x"

  name :> String
  let name = "router"
end
