# The anonymous `{ x, y }` record pattern is purely STRUCTURAL: it matches any
# record (or map) carrying the listed fields, without asserting a type. This is
# the counterpart to spec/record_pattern_named.kex.
#
# One known gap, on BOTH backends: `match` does not destructure MAPS via
# `{ k }` (the walker's matchPattern RecordPattern case only inspects
# RecordValue; the map branch lives in the let-destructuring path, and BEAM's
# structural test admits tuples only to stay in step). A `let { k } = map` does
# work. Pinned here so a future fix shows up as a spec diff.
#
# BEAM matches the walker here: with no type name it tests the subject against
# every record layout carrying the listed fields and reads each field through
# that tag's own offset.

record Miss do
  value : String
  rest  : String
end

record Alt do
  value : String
  rest  : String
end

main do
  let m1 = Miss { value: "12", rest: "EUR" }
  let a1 = Alt { value: "a", rest: "b" }

  # --- structural: the SAME pattern matches both record types
  match m1 do
    { value, rest } -> IO.printLine("anon miss ${value}/${rest}")
  end
  match a1 do
    { value, rest } -> IO.printLine("anon alt ${value}/${rest}")
  end

  # --- structural in a let destructure
  let { value, rest } = a1
  IO.printLine("anon let ${value}/${rest}")

  # --- gap 1: maps destructure in a `let` but not in a `match`
  let mp = { "value": "mv", "rest": "mr" }
  let { value, rest } = mp
  IO.printLine("map let ${value}/${rest}")
  match mp do
    { value, rest } -> IO.printLine("map match ${value}/${rest}")
    _               -> IO.printLine("map match fell through (known gap)")
  end
end
