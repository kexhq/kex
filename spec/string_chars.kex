# String.chars — CONVERTS a String to a [Char]. The two are distinct types,
# so the result displays as the list it is, and `join("")` converts back.

main do
  IO.printLine("hi".chars)
  IO.printLine("".chars.count)
  IO.printLine("abc".chars.count)
  IO.printLine("abc".chars.first)
  IO.printLine("abc".chars.reverse)
  IO.printLine("abc".chars.join(""))
  IO.printLine("abc".chars.join("") == "abc")
end
