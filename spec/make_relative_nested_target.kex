# A `make` target written from its module names a nested module's record:
# `make Tcp.Conn` inside `module Wire` is `Wire.Tcp.Conn`, as
# `make Wire.Tcp.Conn` is. The walker read the spelling alone, found no such
# record, and answered "Undefined function: getLine for Wire.Tcp.Conn"; imported
# from another file, the checker sent the call to the prelude's other
# `getLine`, FileHandle's (kexhq/kex#620).

module Wire do
  module Tcp do
    record Conn do
      id : Integer = 0
    end

    foul open() -> Conn = Conn {}
  end

  make Tcp.Conn do
    foul getLine -> String? = Just("line from Conn")
  end
end

using Wire

main do
  let c = Wire.Tcp.open()
  IO.printLine(c.getLine.or("none"))
end
