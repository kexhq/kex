# Char ('a', '\n', ...) is its own distinct type — NOT a 1-character String.
# [Char] (a list of Char) is its own type too: a String is NOT a list, and the
# two are converted with `chars` and `join("")` rather than being
# interchangeable. Char still CONCATENATES with String, because `+` asks "what
# text does this contribute", which is a different question from "is this the
# same type". See docs/types.md.
main do
  let c = "hello".at(1)
  IO.printLine(c)
  IO.printLine(c == 'e')
  IO.printLine(c == "e")        # false — Char is not a 1-char String
  IO.printLine('e' == c)
  IO.printLine('0' <= '5')      # Char orders against Char

  IO.printLine('a' + 'b')       # concatenation still produces a String
  IO.printLine("ab" + 'c')
  IO.printLine('a' + "bc")

  let letters = ['h', 'i']
  IO.printLine(letters)         # a list, so it displays as one
  IO.printLine(letters == "hi") # false — a [Char] is not a String
  IO.printLine("hi" == letters)
  IO.printLine(letters.join("") == "hi")   # convert, then compare
  IO.printLine("hi".chars == letters)      # and the other direction

  IO.printLine("abc".at(1) == 'b')
  IO.printLine("abc".at(1) == "b")  # false — Char vs String
  IO.printLine("abc".at(10))        # None — out of range

  match "x" do
    "x" => IO.printLine("string pattern matches string value")
    _ => IO.printLine("no match")
  end

  match "abc".at(0) do
    'a' => IO.printLine("char pattern matches char value")
    _ => IO.printLine("no match")
  end

  IO.printLine('5'.digit?)
  IO.printLine('a'.digit?)
end
