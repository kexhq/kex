using FS

describe("binary I/O") do
  it("round trips invalid text losslessly through whole-file helpers") do
    Mock.FS.File("blob.bin", "")
    let payload = Binary.fromBytes([0, 255, 195, 40, 10])
    assert(FS.File.writeBytes("blob.bin", payload).ok?)
    assert(FS.File.readBytes("blob.bin") == Ok(payload))
    assert(FS.File.read("blob.bin") == Error(InvalidUtf8("blob.bin", 1)))
  end

  it("reads and writes bytes through handles") do
    Mock.FS.File("handle.bin", "")
    let payload = Binary.fromBytes([0, 1, 2, 255])
    let writer = FS.File.open("handle.bin", FS.Write).try
    writer.put(payload).try
    writer.close
    let reader = FS.File.open("handle.bin", FS.Read).try
    assert(reader.readBytes == Ok(payload))
    assert(reader.readBytes == Ok(Binary.fromBytes([])))
    reader.close
  end

  it("uses raw standard-stream writes without showing the value") do
    Mock.IO.start()
    IO.out.put(Binary.fromBytes([0, 65])).try
    assert(Mock.IO.output().bytes == [0, 65])
    Mock.IO.stop()
  end

  it("round trips a real binary file") do
    let path = FS.Path.join(FS.Directory.temporary, "kex_binary_scratch.bin")
    let payload = Binary.fromBytes([0, 255, 1, 254])
    FS.File.delete(path)
    assert(FS.File.writeBytes(path, payload).ok?)
    assert(FS.File.readBytes(path) == Ok(payload))
    assert(FS.File.delete(path).ok?)
  end

  it("reads one complete Unicode scalar and reports malformed UTF-8") do
    Mock.FS.File("unicode.txt", "éx")
    let reader = FS.File.open("unicode.txt", FS.Read).try
    assert(reader.getChar == Just("é"), "complete scalar")
    assert(reader.getChar == Just("x"), "second scalar")
    assert(reader.getChar == None, "character EOF")
    reader.close

    Mock.FS.File("bad.txt", "")
    FS.File.writeBytes("bad.txt", Binary.fromBytes([97, 255, 98]))
    let bad = FS.File.open("bad.txt", FS.Read).try
    let failure = bad.read
    match failure do
      Error(InvalidUtf8(offset)) => assert(offset == 1, "UTF-8 offset")
      _ => assert(false, "expected InvalidUtf8")
    end
    assert(bad.readBytes == Ok(Binary.fromBytes([])), "failed read consumed input")
    bad.close
  end
end

describe("Readable and Writable families") do
  it("reads chunks with get until the end of the file") do
    let path = FS.Path.join(FS.Directory.temporary, "kex_chunk_scratch.txt")
    FS.File.write(path, "abc\ndef")
    let reader = FS.File.open(path, FS.Read).try
    assert(reader.get == Ok(Just(Binary.fromBytes("abc\ndef".bytes))))
    assert(reader.get == Ok(None))
    reader.close
    FS.File.delete(path)
  end

  it("reads mocked chunks with get") do
    Mock.FS.File("chunk.txt", "hello")
    let reader = FS.File.open("chunk.txt", FS.Read).try
    assert(reader.get == Ok(Just(Binary.fromBytes("hello".bytes))))
    assert(reader.get == Ok(None))
    reader.close
  end

  it("answers results from write, writeLine and put") do
    let path = FS.Path.join(FS.Directory.temporary, "kex_write_scratch.txt")
    FS.File.delete(path)
    let writer = FS.File.open(path, FS.Write).try
    assert(writer.write("a").ok?)
    assert(writer.writeLine(1).ok?)
    assert(writer.put(Binary.fromBytes([98])).ok?)
    writer.print("c")
    writer.printLine("d")
    writer.close
    assert(writer.write("late").error?)
    assert(FS.File.read(path) == Ok("a1\nbcd\n"))
    FS.File.delete(path)
  end

  it("splits a line read into readLine and getLine") do
    Mock.FS.File("lines.txt", "one\ntwo")
    let reader = FS.File.open("lines.txt", FS.Read).try
    assert(reader.readLine == Ok(Just("one")))
    assert(reader.getLine == Just("two"))
    assert(reader.readLine == Ok(None))
    assert(reader.getLine == None)
    reader.close
  end
end
