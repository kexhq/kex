# A named argument no clause declares is reported, not dropped. Silently
# ignoring it would run `render` as if the label had never been written and
# hand back a plausible-looking answer to a question nobody asked.
#
# Reported at COMPILE time, by name resolution, against the union of the
# labels every clause of the name declares (plus the imported overloads', so
# `to(String, in: Kilo)` stays legal). Catching it here rather than when the
# line runs is what puts it in front of an editor: a `package.kex` is READ and
# never run, so `command("fmt", runn: ...)` used to reach nobody until Tey
# refused the manifest.
#
# The runtime check remains the backstop for what static resolution cannot
# see — see error_unknown_named_argument_no_check.kex.
let render(text: String) = "[${text}]"
let render(text: String, width: Integer) = "[${text} @${width}]"

main do
  IO.printLine(render("hi", width: 8))
  IO.printLine(render("hi", height: 8))
end
