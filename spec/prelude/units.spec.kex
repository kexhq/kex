describe("time measures") do
  it("creates time measures from integers and floats") do
    assert(2.sec.canonical == 2.0)
    assert(2.5.minute.canonical == 150.0)
    assert(1.hour.canonical == 3600.0)
    assert(1.day.canonical == 86400.0)
    assert(2.sec.kind == :time)
  end

  it("supports sub-second units") do
    assert(1.millisecond.canonical == 0.001)
    assert(1.microsecond.canonical == 0.000001)
    assert(1.nanosecond.canonical == 0.000000001)
  end

  it("is distinct from Duration") do
    let measure = 2.sec
    let duration = Duration { seconds: measure.canonical }
    assert(duration.seconds == 2.0)
  end
end

describe("Measure arithmetic") do
  it("adds and subtracts through the canonical value") do
    match 1.minute + 30.sec do
      Ok(total) -> assert(total.canonical == 90.0)
      Error(_) -> assert(false)
    end

    match 2.minute - 30.sec do
      Ok(total) -> assert(total.canonical == 90.0)
      Error(_) -> assert(false)
    end
  end

  it("scales a measure") do
    let measure = 2.5.sec.scale(4)
    assert(measure.canonical == 10.0)
    assert(measure.to(String) == "10.0 s")
  end
end

describe("time conversion and formatting") do
  it("converts between display units") do
    match 90.minute.convert(Hour) do
      Ok(measure) -> assert(measure.value == 1.5)
      Error(_) -> assert(false)
    end

    match 90.minute.convert(Second) do
      Ok(measure) -> assert(measure.value == 5400.0)
      Error(_) -> assert(false)
    end
  end

  it("formats the selected unit") do
    assert(2.hour.to(String) == "2.0 h")
    match 90.minute.convert(Hour) do
      Ok(measure) -> assert(measure.to(String) == "1.5 h")
      Error(_) -> assert(false)
    end
  end
end
