  it("steps to yesterday and tomorrow from a frozen clock") do
    Time.freeze(DateTime.parse("1956-03-15T10:09:15Z").try).try
    assert(Date.utcToday().iso == "1956-03-15", "Date.utcToday().iso")
    assert(Date.tomorrow().epochDay - Date.today().epochDay == 1, "Date.tomorrow().epochDay - Date.today().epochDay")
    assert(Date.today().epochDay - Date.yesterday().epochDay == 1, "Date.today().epochDay - Date.yesterday().epochDay")
