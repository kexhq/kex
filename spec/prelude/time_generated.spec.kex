describe("time of day (vs Ruby)") do
  it("validates fields") do
    assert(Time.of(0, 0, 0).ok? == true, "Time.of(0, 0, 0).ok?")
    assert(Time.of(23, 59, 59).ok? == true, "Time.of(23, 59, 59).ok?")
    assert(Time.of(24, 0, 0).ok? == false, "Time.of(24, 0, 0).ok?")
    assert(Time.of(0, 60, 0).ok? == false, "Time.of(0, 60, 0).ok?")
    assert(Time.of(0, 0, 60).ok? == false, "Time.of(0, 0, 60).ok?")
    assert(Time.of(-1, 0, 0).ok? == false, "Time.of(-1, 0, 0).ok?")
    assert(Time.of(10, 23, 45).ok? == true, "Time.of(10, 23, 45).ok?")
    assert(Time.of(10, 18, 46).ok? == true, "Time.of(10, 18, 46).ok?")
    assert(Time.of(22, 36, 40).ok? == true, "Time.of(22, 36, 40).ok?")
    assert(Time.of(10, 49, 57).ok? == true, "Time.of(10, 49, 57).ok?")
    assert(Time.of(19, 47, 4).ok? == true, "Time.of(19, 47, 4).ok?")
    assert(Time.of(16, 8, 4).ok? == true, "Time.of(16, 8, 4).ok?")
    assert(Time.of(20, 4, 12).ok? == true, "Time.of(20, 4, 12).ok?")
    assert(Time.of(7, 22, 24).ok? == true, "Time.of(7, 22, 24).ok?")
    assert(Time.of(19, 49, 26).ok? == true, "Time.of(19, 49, 26).ok?")
    assert(Time.of(5, 60, 5).ok? == false, "Time.of(5, 60, 5).ok?")
    assert(Time.of(13, 57, 36).ok? == true, "Time.of(13, 57, 36).ok?")
    assert(Time.of(4, 38, 4).ok? == true, "Time.of(4, 38, 4).ok?")
    assert(Time.of(2, 53, 43).ok? == true, "Time.of(2, 53, 43).ok?")
    assert(Time.of(21, 60, 37).ok? == false, "Time.of(21, 60, 37).ok?")
    assert(Time.of(17, 60, 22).ok? == false, "Time.of(17, 60, 22).ok?")
    assert(Time.of(18, 18, 3).ok? == true, "Time.of(18, 18, 3).ok?")
    assert(Time.of(22, 8, 3).ok? == true, "Time.of(22, 8, 3).ok?")
    assert(Time.of(5, 54, 56).ok? == true, "Time.of(5, 54, 56).ok?")
    assert(Time.of(18, 3, 23).ok? == true, "Time.of(18, 3, 23).ok?")
