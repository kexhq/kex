describe("date operators (vs Ruby)") do
  it("shifts a date by a whole-day Duration") do
    assert((Date.of(1657, 12, 31).try + (386).days).iso == "1659-01-21", "(Date.of(1657, 12, 31).try + (386).days).iso")
    assert((Date.of(1657, 12, 31).try - (-386).days).iso == "1659-01-21", "(Date.of(1657, 12, 31).try - (-386).days).iso")
    assert((Date.of(2284, 11, 25).try + (-1533).days).iso == "2280-09-14", "(Date.of(2284, 11, 25).try + (-1533).days).iso")
    assert((Date.of(2284, 11, 25).try - (1533).days).iso == "2280-09-14", "(Date.of(2284, 11, 25).try - (1533).days).iso")
    assert((Date.of(1676, 2, 3).try + (205).days).iso == "1676-08-26", "(Date.of(1676, 2, 3).try + (205).days).iso")
    assert((Date.of(1676, 2, 3).try - (-205).days).iso == "1676-08-26", "(Date.of(1676, 2, 3).try - (-205).days).iso")
    assert((Date.of(1604, 3, 31).try + (716).days).iso == "1606-03-17", "(Date.of(1604, 3, 31).try + (716).days).iso")
    assert((Date.of(1604, 3, 31).try - (-716).days).iso == "1606-03-17", "(Date.of(1604, 3, 31).try - (-716).days).iso")
    assert((Date.of(1740, 7, 8).try + (-465).days).iso == "1739-03-31", "(Date.of(1740, 7, 8).try + (-465).days).iso")
    assert((Date.of(1740, 7, 8).try - (465).days).iso == "1739-03-31", "(Date.of(1740, 7, 8).try - (465).days).iso")
    assert((Date.of(2007, 11, 13).try + (-818).days).iso == "2005-08-17", "(Date.of(2007, 11, 13).try + (-818).days).iso")
    assert((Date.of(2007, 11, 13).try - (818).days).iso == "2005-08-17", "(Date.of(2007, 11, 13).try - (818).days).iso")
    assert((Date.of(2386, 5, 18).try + (-1536).days).iso == "2382-03-04", "(Date.of(2386, 5, 18).try + (-1536).days).iso")
    assert((Date.of(2386, 5, 18).try - (1536).days).iso == "2382-03-04", "(Date.of(2386, 5, 18).try - (1536).days).iso")
