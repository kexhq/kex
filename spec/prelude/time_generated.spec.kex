  it("renders instants back into civil datetimes") do
    assert(DateTime.fromEpochSeconds(-8043952929, Duration.seconds(45900)).iso == "1715-02-06T05:22:51+12:45", "DateTime.fromEpochSeconds(-8043952929, Duration.seconds(45900)).iso")
    assert(DateTime.fromEpochSeconds(2812086013, Duration.seconds(-14400)).iso == "2059-02-10T03:00:13-04:00", "DateTime.fromEpochSeconds(2812086013, Duration.seconds(-14400)).iso")
    assert(DateTime.fromEpochSeconds(-2974234230, Duration.seconds(-36000)).iso == "1875-10-01T13:49:30-10:00", "DateTime.fromEpochSeconds(-2974234230, Duration.seconds(-36000)).iso")
    assert(DateTime.fromEpochSeconds(408748609, Duration.seconds(-36000)).iso == "1982-12-14T11:16:49-10:00", "DateTime.fromEpochSeconds(408748609, Duration.seconds(-36000)).iso")
