    assert(Time.travellingFrom(DateTime.parse("1826-07-25T05:43:18Z").try, do Date.utcToday().iso end).try == "1826-07-25", "Time.travellingFrom(DateTime.parse(\"1826-07-25T05:43:18Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
    assert(Time.travellingFrom(DateTime.parse("1967-05-08T10:52:55Z").try, do Date.utcToday().iso end).try == "1967-05-08", "Time.travellingFrom(DateTime.parse(\"1967-05-08T10:52:55Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
    assert(Time.travellingFrom(DateTime.parse("1892-12-19T22:34:37Z").try, do Date.utcToday().iso end).try == "1892-12-19", "Time.travellingFrom(DateTime.parse(\"1892-12-19T22:34:37Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
    assert(Time.travellingFrom(DateTime.parse("1928-07-27T22:34:43Z").try, do Date.utcToday().iso end).try == "1928-07-27", "Time.travellingFrom(DateTime.parse(\"1928-07-27T22:34:43Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
  end

  it("never touches the clock for an instant it cannot represent") do
    assert(Time.frozenAt(DateTime.parse("2500-01-01T00:00:00Z").try, do 1 end).ok? == false, "Time.frozenAt(DateTime.parse(\"2500-01-01T00:00:00Z\").try, do 1 end).ok? == false")
    assert(Time.travellingFrom(DateTime.parse("1600-01-01T00:00:00Z").try, do 1 end).ok? == false, "Time.travellingFrom(DateTime.parse(\"1600-01-01T00:00:00Z\").try, do 1 end).ok? == false")
    assert(!Time.controlled?(), "!Time.controlled?()")
    var ran = false
    Time.frozenAt(DateTime.parse("2500-01-01T00:00:00Z").try, do ran = true end)
    assert(!ran, "!ran")
  end

