    assert(DateTime.of(Date.of(1911, 1, 10).try, Time.of(18, 38, 28).try, Duration.seconds(36000)).epochSeconds == -1861111292, "DateTime.of(Date.of(1911, 1, 10).try, Time.of(18, 38, 28).try, Duration.seconds(36000)).epochSeconds")
