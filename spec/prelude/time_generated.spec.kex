  it("renders instants back into civil datetimes") do
    assert(DateTime.fromEpochSeconds(-1168269209, Duration.seconds(43200)).iso == "1932-12-24T20:46:31+12:00", "DateTime.fromEpochSeconds(-1168269209, Duration.seconds(43200)).iso")
    assert(DateTime.fromEpochSeconds(9696351512, Duration.seconds(20700)).iso == "2277-04-07T12:43:32+05:45", "DateTime.fromEpochSeconds(9696351512, Duration.seconds(20700)).iso")
    assert(DateTime.fromEpochSeconds(-8360395003, Duration.seconds(42300)).iso == "1705-01-26T15:48:17+11:45", "DateTime.fromEpochSeconds(-8360395003, Duration.seconds(42300)).iso")
    assert(DateTime.fromEpochSeconds(-3231522615, Duration.seconds(25200)).iso == "1867-08-07T09:49:45+07:00", "DateTime.fromEpochSeconds(-3231522615, Duration.seconds(25200)).iso")
    assert(DateTime.fromEpochSeconds(6548658875, Duration.seconds(25200)).iso == "2177-07-08T22:54:35+07:00", "DateTime.fromEpochSeconds(6548658875, Duration.seconds(25200)).iso")
    assert(DateTime.fromEpochSeconds(346142964, Duration.seconds(-33300)).iso == "1980-12-19T21:34:24-09:15", "DateTime.fromEpochSeconds(346142964, Duration.seconds(-33300)).iso")
    assert(DateTime.fromEpochSeconds(1636611262, Duration.seconds(24300)).iso == "2021-11-11T12:59:22+06:45", "DateTime.fromEpochSeconds(1636611262, Duration.seconds(24300)).iso")
