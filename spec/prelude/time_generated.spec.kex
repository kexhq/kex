  it("builds periods from Integer") do
    assert((-10).months.iso == "P-10M", "(-10).months.iso")
    assert((-10).years.iso == "P-10Y", "(-10).years.iso")
    assert((-4).months.iso == "P-4M", "(-4).months.iso")
    assert((-4).years.iso == "P-4Y", "(-4).years.iso")
    assert((-6).months.iso == "P-6M", "(-6).months.iso")
    assert((-6).years.iso == "P-6Y", "(-6).years.iso")
    assert(13.months.iso == "P13M", "13.months.iso")
    assert(13.years.iso == "P13Y", "13.years.iso")
    assert((-17).months.iso == "P-17M", "(-17).months.iso")
    assert((-17).years.iso == "P-17Y", "(-17).years.iso")
    assert(20.months.iso == "P20M", "20.months.iso")
    assert(20.years.iso == "P20Y", "20.years.iso")
    assert((-22).months.iso == "P-22M", "(-22).months.iso")
    assert((-22).years.iso == "P-22Y", "(-22).years.iso")
    assert(8.months.iso == "P8M", "8.months.iso")
    assert(8.years.iso == "P8Y", "8.years.iso")
    assert(18.months.iso == "P18M", "18.months.iso")
    assert(18.years.iso == "P18Y", "18.years.iso")
    assert(0.months.iso == "P0D", "0.months.iso")
