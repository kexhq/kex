  it("refuses instants the clock cannot represent") do
    assert(Time.freeze(DateTime.parse("2500-01-01T00:00:00Z").try).ok? == false, "Time.freeze(DateTime.parse(\"2500-01-01T00:00:00Z\").try).ok? == false")
    assert(Time.freeze(DateTime.parse("1600-01-01T00:00:00Z").try).ok? == false, "Time.freeze(DateTime.parse(\"1600-01-01T00:00:00Z\").try).ok? == false")
    assert(Time.freeze(DateTime.parse("2026-01-01T00:00:00Z").try).ok?, "Time.freeze(DateTime.parse(\"2026-01-01T00:00:00Z\").try).ok?")
    Time.release()
  end

  it("leaves the clock alone once released") do
    Time.freeze(DateTime.parse("2026-07-30T14:03:00Z").try)
    assert(Time.frozen?(), "Time.frozen?()")
    assert(Time.controlled?(), "Time.controlled?()")
    assert(Date.utcToday().iso == "2026-07-30", "Date.utcToday().iso")
    Time.release()
    assert(!Time.controlled?(), "!Time.controlled?()")
    Time.travel(DateTime.parse("2026-07-30T14:03:00Z").try)
    assert(Time.controlled?(), "Time.controlled?()")
    assert(!Time.frozen?(), "!Time.frozen?()")
    assert(Date.utcToday().iso == "2026-07-30", "Date.utcToday().iso")
    Time.release()
  end

  it("scopes a frozen clock to a block") do
    assert(Time.frozenAt(DateTime.parse("1705-06-01T12:31:58Z").try, do Date.utcToday().iso end).try == "1705-06-01", "Time.frozenAt(DateTime.parse(\"1705-06-01T12:31:58Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
    assert(Time.frozenAt(DateTime.parse("1684-11-25T01:51:35Z").try, do Date.utcToday().iso end).try == "1684-11-25", "Time.frozenAt(DateTime.parse(\"1684-11-25T01:51:35Z\").try, do Date.utcToday().iso end).try")
    assert(!Time.controlled?(), "!Time.controlled?()")
