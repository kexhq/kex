    assert(Time.of(17, 56, 6).try.secondsSinceMidnight == 64566, "Time.of(17, 56, 6).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(64566).iso == "17:56:06", "Time.fromSecondsSinceMidnight(64566).iso")
    assert(Time.of(20, 50, 48).try.secondsSinceMidnight == 75048, "Time.of(20, 50, 48).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(75048).iso == "20:50:48", "Time.fromSecondsSinceMidnight(75048).iso")
    assert(Time.of(3, 2, 54).try.secondsSinceMidnight == 10974, "Time.of(3, 2, 54).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(10974).iso == "03:02:54", "Time.fromSecondsSinceMidnight(10974).iso")
    assert(Time.of(5, 52, 48).try.secondsSinceMidnight == 21168, "Time.of(5, 52, 48).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(21168).iso == "05:52:48", "Time.fromSecondsSinceMidnight(21168).iso")
    assert(Time.of(0, 5, 49).try.secondsSinceMidnight == 349, "Time.of(0, 5, 49).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(349).iso == "00:05:49", "Time.fromSecondsSinceMidnight(349).iso")
    assert(Time.of(10, 37, 27).try.secondsSinceMidnight == 38247, "Time.of(10, 37, 27).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(38247).iso == "10:37:27", "Time.fromSecondsSinceMidnight(38247).iso")
    assert(Time.of(21, 47, 54).try.secondsSinceMidnight == 78474, "Time.of(21, 47, 54).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(78474).iso == "21:47:54", "Time.fromSecondsSinceMidnight(78474).iso")
    assert(Time.of(15, 7, 41).try.secondsSinceMidnight == 54461, "Time.of(15, 7, 41).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(54461).iso == "15:07:41", "Time.fromSecondsSinceMidnight(54461).iso")
  end

