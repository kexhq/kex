describe("time of day arithmetic (vs Ruby)") do
  it("wraps within the day and keeps the nanosecond") do
    assert((Time.of(10, 9, 26, 280000000).try + Duration.seconds(-41375)).iso == "22:39:51.280", "(Time.of(10, 9, 26, 280000000).try + Duration.seconds(-41375)).iso")
    assert((Time.of(10, 9, 26, 280000000).try - Duration.seconds(41375)).iso == "22:39:51.280", "(Time.of(10, 9, 26, 280000000).try - Duration.seconds(41375)).iso")
    assert(Time.of(10, 9, 26, 280000000).try.addSeconds((-41375)).iso == "22:39:51.280", "Time.of(10, 9, 26, 280000000).try.addSeconds((-41375)).iso")
    assert((Time.of(19, 34, 45, 670387030).try + Duration.seconds(-139569)).iso == "04:48:36.670387030", "(Time.of(19, 34, 45, 670387030).try + Duration.seconds(-139569)).iso")
    assert((Time.of(19, 34, 45, 670387030).try - Duration.seconds(139569)).iso == "04:48:36.670387030", "(Time.of(19, 34, 45, 670387030).try - Duration.seconds(139569)).iso")
    assert(Time.of(19, 34, 45, 670387030).try.addSeconds((-139569)).iso == "04:48:36.670387030", "Time.of(19, 34, 45, 670387030).try.addSeconds((-139569)).iso")
    assert((Time.of(0, 42, 26, 862505669).try + Duration.seconds(86464)).iso == "00:43:30.862505669", "(Time.of(0, 42, 26, 862505669).try + Duration.seconds(86464)).iso")
    assert((Time.of(0, 42, 26, 862505669).try - Duration.seconds(-86464)).iso == "00:43:30.862505669", "(Time.of(0, 42, 26, 862505669).try - Duration.seconds(-86464)).iso")
    assert(Time.of(0, 42, 26, 862505669).try.addSeconds(86464).iso == "00:43:30.862505669", "Time.of(0, 42, 26, 862505669).try.addSeconds(86464).iso")
    assert((Time.of(14, 49, 54, 567540000).try + Duration.seconds(22533)).iso == "21:05:27.567540", "(Time.of(14, 49, 54, 567540000).try + Duration.seconds(22533)).iso")
    assert((Time.of(14, 49, 54, 567540000).try - Duration.seconds(-22533)).iso == "21:05:27.567540", "(Time.of(14, 49, 54, 567540000).try - Duration.seconds(-22533)).iso")
    assert(Time.of(14, 49, 54, 567540000).try.addSeconds(22533).iso == "21:05:27.567540", "Time.of(14, 49, 54, 567540000).try.addSeconds(22533).iso")
    assert((Time.of(0, 13, 18, 724523000).try + Duration.seconds(64320)).iso == "18:05:18.724523", "(Time.of(0, 13, 18, 724523000).try + Duration.seconds(64320)).iso")
    assert((Time.of(0, 13, 18, 724523000).try - Duration.seconds(-64320)).iso == "18:05:18.724523", "(Time.of(0, 13, 18, 724523000).try - Duration.seconds(-64320)).iso")
    assert(Time.of(0, 13, 18, 724523000).try.addSeconds(64320).iso == "18:05:18.724523", "Time.of(0, 13, 18, 724523000).try.addSeconds(64320).iso")
    assert((Time.of(3, 55, 35, 804598935).try + Duration.seconds(-43647)).iso == "15:48:08.804598935", "(Time.of(3, 55, 35, 804598935).try + Duration.seconds(-43647)).iso")
    assert((Time.of(3, 55, 35, 804598935).try - Duration.seconds(43647)).iso == "15:48:08.804598935", "(Time.of(3, 55, 35, 804598935).try - Duration.seconds(43647)).iso")
    assert(Time.of(3, 55, 35, 804598935).try.addSeconds((-43647)).iso == "15:48:08.804598935", "Time.of(3, 55, 35, 804598935).try.addSeconds((-43647)).iso")
    assert((Time.of(15, 51, 57, 0).try + Duration.seconds(100531)).iso == "19:47:28", "(Time.of(15, 51, 57, 0).try + Duration.seconds(100531)).iso")
    assert((Time.of(15, 51, 57, 0).try - Duration.seconds(-100531)).iso == "19:47:28", "(Time.of(15, 51, 57, 0).try - Duration.seconds(-100531)).iso")
    assert(Time.of(15, 51, 57, 0).try.addSeconds(100531).iso == "19:47:28", "Time.of(15, 51, 57, 0).try.addSeconds(100531).iso")
    assert((Time.of(2, 24, 45, 895156000).try + Duration.seconds(83486)).iso == "01:36:11.895156", "(Time.of(2, 24, 45, 895156000).try + Duration.seconds(83486)).iso")
