  it("carries fractional seconds through a DateTime") do
    assert(DateTime.of(Date.of(2100, 5, 9).try, Time.of(2, 45, 2, 0).try, Duration.zero()).iso == "2100-05-09T02:45:02Z", "DateTime.of(Date.of(2100, 5, 9).try, Time.of(2, 45, 2, 0).try, Duration.zero()).iso")
    assert(DateTime.parse("2100-05-09T02:45:02Z").try.iso == "2100-05-09T02:45:02Z", "DateTime.parse(\"2100-05-09T02:45:02Z\").try.iso")
    assert(DateTime.of(Date.of(2011, 1, 9).try, Time.of(20, 3, 45, 901524000).try, Duration.zero()).iso == "2011-01-09T20:03:45.901524Z", "DateTime.of(Date.of(2011, 1, 9).try, Time.of(20, 3, 45, 901524000).try, Duration.zero()).iso")
    assert(DateTime.parse("2011-01-09T20:03:45.901524Z").try.iso == "2011-01-09T20:03:45.901524Z", "DateTime.parse(\"2011-01-09T20:03:45.901524Z\").try.iso")
    assert(DateTime.of(Date.of(1940, 10, 15).try, Time.of(5, 13, 29, 0).try, Duration.zero()).iso == "1940-10-15T05:13:29Z", "DateTime.of(Date.of(1940, 10, 15).try, Time.of(5, 13, 29, 0).try, Duration.zero()).iso")
    assert(DateTime.parse("1940-10-15T05:13:29Z").try.iso == "1940-10-15T05:13:29Z", "DateTime.parse(\"1940-10-15T05:13:29Z\").try.iso")
    assert(DateTime.of(Date.of(2189, 10, 1).try, Time.of(16, 39, 11, 933000000).try, Duration.zero()).iso == "2189-10-01T16:39:11.933Z", "DateTime.of(Date.of(2189, 10, 1).try, Time.of(16, 39, 11, 933000000).try, Duration.zero()).iso")
    assert(DateTime.parse("2189-10-01T16:39:11.933Z").try.iso == "2189-10-01T16:39:11.933Z", "DateTime.parse(\"2189-10-01T16:39:11.933Z\").try.iso")
    assert(DateTime.of(Date.of(1911, 8, 16).try, Time.of(18, 15, 0, 375064734).try, Duration.zero()).iso == "1911-08-16T18:15:00.375064734Z", "DateTime.of(Date.of(1911, 8, 16).try, Time.of(18, 15, 0, 375064734).try, Duration.zero()).iso")
    assert(DateTime.parse("1911-08-16T18:15:00.375064734Z").try.iso == "1911-08-16T18:15:00.375064734Z", "DateTime.parse(\"1911-08-16T18:15:00.375064734Z\").try.iso")
    assert(DateTime.of(Date.of(1906, 7, 29).try, Time.of(0, 27, 48, 735000000).try, Duration.zero()).iso == "1906-07-29T00:27:48.735Z", "DateTime.of(Date.of(1906, 7, 29).try, Time.of(0, 27, 48, 735000000).try, Duration.zero()).iso")
    assert(DateTime.parse("1906-07-29T00:27:48.735Z").try.iso == "1906-07-29T00:27:48.735Z", "DateTime.parse(\"1906-07-29T00:27:48.735Z\").try.iso")
    assert(DateTime.of(Date.of(1959, 11, 14).try, Time.of(21, 38, 36, 743891073).try, Duration.zero()).iso == "1959-11-14T21:38:36.743891073Z", "DateTime.of(Date.of(1959, 11, 14).try, Time.of(21, 38, 36, 743891073).try, Duration.zero()).iso")
    assert(DateTime.parse("1959-11-14T21:38:36.743891073Z").try.iso == "1959-11-14T21:38:36.743891073Z", "DateTime.parse(\"1959-11-14T21:38:36.743891073Z\").try.iso")
