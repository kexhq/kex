describe("instants (vs Ruby)") do
  it("converts civil datetimes to epoch seconds") do
    assert(DateTime.of(Date.of(2069, 5, 27).try, Time.of(12, 20, 45).try, Duration.seconds(34200)).epochSeconds == 3136848645, "DateTime.of(Date.of(2069, 5, 27).try, Time.of(12, 20, 45).try, Duration.seconds(34200)).epochSeconds")
    assert(DateTime.of(Date.of(1821, 2, 20).try, Time.of(9, 43, 26).try, Duration.seconds(-3600)).epochSeconds == -4697615794, "DateTime.of(Date.of(1821, 2, 20).try, Time.of(9, 43, 26).try, Duration.seconds(-3600)).epochSeconds")
    assert(DateTime.of(Date.of(1972, 3, 10).try, Time.of(11, 7, 21).try, Duration.seconds(-21600)).epochSeconds == 69095241, "DateTime.of(Date.of(1972, 3, 10).try, Time.of(11, 7, 21).try, Duration.seconds(-21600)).epochSeconds")
    assert(DateTime.of(Date.of(2180, 12, 10).try, Time.of(16, 19, 53).try, Duration.seconds(16200)).epochSeconds == 6656730593, "DateTime.of(Date.of(2180, 12, 10).try, Time.of(16, 19, 53).try, Duration.seconds(16200)).epochSeconds")
    assert(DateTime.of(Date.of(2285, 8, 12).try, Time.of(10, 46, 36).try, Duration.seconds(50400)).epochSeconds == 9959748396, "DateTime.of(Date.of(2285, 8, 12).try, Time.of(10, 46, 36).try, Duration.seconds(50400)).epochSeconds")
    assert(DateTime.of(Date.of(2071, 8, 12).try, Time.of(16, 33, 53).try, Duration.seconds(45000)).epochSeconds == 3206577833, "DateTime.of(Date.of(2071, 8, 12).try, Time.of(16, 33, 53).try, Duration.seconds(45000)).epochSeconds")
    assert(DateTime.of(Date.of(2016, 12, 20).try, Time.of(21, 54, 48).try, Duration.seconds(-3600)).epochSeconds == 1482274488, "DateTime.of(Date.of(2016, 12, 20).try, Time.of(21, 54, 48).try, Duration.seconds(-3600)).epochSeconds")
    assert(DateTime.of(Date.of(2232, 10, 21).try, Time.of(5, 26, 3).try, Duration.seconds(43200)).epochSeconds == 8293253163, "DateTime.of(Date.of(2232, 10, 21).try, Time.of(5, 26, 3).try, Duration.seconds(43200)).epochSeconds")
