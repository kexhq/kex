describe("calendar spans (vs Ruby)") do
  it("adds and subtracts a Period") do
    assert((Date.of(1694, 8, 3).try + Period.of(0, -23, -16)).iso == "1692-08-18", "(Date.of(1694, 8, 3).try + Period.of(0, -23, -16)).iso")
    assert((Date.of(1694, 8, 3).try - Period.of(0, -23, -16)).iso == "1696-07-19", "(Date.of(1694, 8, 3).try - Period.of(0, -23, -16)).iso")
    assert((Date.of(1732, 5, 23).try + Period.of(-1, -29, -28)).iso == "1728-11-25", "(Date.of(1732, 5, 23).try + Period.of(-1, -29, -28)).iso")
    assert((Date.of(1732, 5, 23).try - Period.of(-1, -29, -28)).iso == "1735-11-20", "(Date.of(1732, 5, 23).try - Period.of(-1, -29, -28)).iso")
    assert((Date.of(2082, 10, 21).try + Period.of(-4, -27, 34)).iso == "2076-08-24", "(Date.of(2082, 10, 21).try + Period.of(-4, -27, 34)).iso")
    assert((Date.of(2082, 10, 21).try - Period.of(-4, -27, 34)).iso == "2088-12-18", "(Date.of(2082, 10, 21).try - Period.of(-4, -27, 34)).iso")
    assert((Date.of(1913, 6, 21).try + Period.of(-5, -16, 37)).iso == "1907-03-30", "(Date.of(1913, 6, 21).try + Period.of(-5, -16, 37)).iso")
    assert((Date.of(1913, 6, 21).try - Period.of(-5, -16, 37)).iso == "1919-09-14", "(Date.of(1913, 6, 21).try - Period.of(-5, -16, 37)).iso")
    assert((Date.of(2365, 8, 27).try + Period.of(0, 11, -43)).iso == "2366-06-14", "(Date.of(2365, 8, 27).try + Period.of(0, 11, -43)).iso")
    assert((Date.of(2365, 8, 27).try - Period.of(0, 11, -43)).iso == "2364-11-09", "(Date.of(2365, 8, 27).try - Period.of(0, 11, -43)).iso")
    assert((Date.of(2158, 9, 4).try + Period.of(3, 15, 34)).iso == "2163-01-07", "(Date.of(2158, 9, 4).try + Period.of(3, 15, 34)).iso")
    assert((Date.of(2158, 9, 4).try - Period.of(3, 15, 34)).iso == "2154-05-01", "(Date.of(2158, 9, 4).try - Period.of(3, 15, 34)).iso")
    assert((Date.of(2206, 3, 23).try + Period.of(-2, -16, 31)).iso == "2202-12-24", "(Date.of(2206, 3, 23).try + Period.of(-2, -16, 31)).iso")
    assert((Date.of(2206, 3, 23).try - Period.of(-2, -16, 31)).iso == "2209-06-22", "(Date.of(2206, 3, 23).try - Period.of(-2, -16, 31)).iso")
    assert((Date.of(1848, 1, 19).try + Period.of(-4, 11, 23)).iso == "1845-01-11", "(Date.of(1848, 1, 19).try + Period.of(-4, 11, 23)).iso")
    assert((Date.of(1848, 1, 19).try - Period.of(-4, 11, 23)).iso == "1851-01-27", "(Date.of(1848, 1, 19).try - Period.of(-4, 11, 23)).iso")
    assert((Date.of(1689, 3, 11).try + Period.of(0, -1, -33)).iso == "1689-01-09", "(Date.of(1689, 3, 11).try + Period.of(0, -1, -33)).iso")
    assert((Date.of(1689, 3, 11).try - Period.of(0, -1, -33)).iso == "1689-05-14", "(Date.of(1689, 3, 11).try - Period.of(0, -1, -33)).iso")
    assert((Date.of(2035, 2, 21).try + Period.of(-3, -15, 45)).iso == "2031-01-05", "(Date.of(2035, 2, 21).try + Period.of(-3, -15, 45)).iso")
    assert((Date.of(2035, 2, 21).try - Period.of(-3, -15, 45)).iso == "2039-04-06", "(Date.of(2035, 2, 21).try - Period.of(-3, -15, 45)).iso")
    assert((Date.of(2123, 6, 1).try + Period.of(-3, -1, 39)).iso == "2120-06-09", "(Date.of(2123, 6, 1).try + Period.of(-3, -1, 39)).iso")
    assert((Date.of(2123, 6, 1).try - Period.of(-3, -1, 39)).iso == "2126-05-23", "(Date.of(2123, 6, 1).try - Period.of(-3, -1, 39)).iso")
    assert((Date.of(2289, 11, 24).try + Period.of(-2, 16, 22)).iso == "2289-04-15", "(Date.of(2289, 11, 24).try + Period.of(-2, 16, 22)).iso")
    assert((Date.of(2289, 11, 24).try - Period.of(-2, 16, 22)).iso == "2290-07-02", "(Date.of(2289, 11, 24).try - Period.of(-2, 16, 22)).iso")
    assert((Date.of(1629, 11, 15).try + Period.of(2, 11, 28)).iso == "1632-11-12", "(Date.of(1629, 11, 15).try + Period.of(2, 11, 28)).iso")
    assert((Date.of(1629, 11, 15).try - Period.of(2, 11, 28)).iso == "1626-11-17", "(Date.of(1629, 11, 15).try - Period.of(2, 11, 28)).iso")
    assert((Date.of(1874, 4, 3).try + Period.of(-3, 9, 27)).iso == "1872-01-30", "(Date.of(1874, 4, 3).try + Period.of(-3, 9, 27)).iso")
    assert((Date.of(1874, 4, 3).try - Period.of(-3, 9, 27)).iso == "1876-06-06", "(Date.of(1874, 4, 3).try - Period.of(-3, 9, 27)).iso")
