    assert(DateTime.of(Date.of(1607, 12, 5).try, Time.of(3, 47, 23).try, Duration.seconds(28800)).epochSeconds == -11425983157, "DateTime.of(Date.of(1607, 12, 5).try, Time.of(3, 47, 23).try, Duration.seconds(28800)).epochSeconds")
    assert(DateTime.of(Date.of(2025, 1, 29).try, Time.of(11, 24, 46).try, Duration.seconds(27000)).epochSeconds == 1738122886, "DateTime.of(Date.of(2025, 1, 29).try, Time.of(11, 24, 46).try, Duration.seconds(27000)).epochSeconds")
    assert(DateTime.of(Date.of(1950, 11, 24).try, Time.of(5, 41, 11).try, Duration.seconds(50400)).epochSeconds == -602929129, "DateTime.of(Date.of(1950, 11, 24).try, Time.of(5, 41, 11).try, Duration.seconds(50400)).epochSeconds")
