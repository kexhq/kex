describe("epoch days (vs Ruby)") do
  it("agrees on fixed landmarks") do
    assert(Date.of(1970, 1, 1).try.epochDay == 0, "Date.of(1970, 1, 1).try.epochDay")
    assert(Date.of(1969, 12, 31).try.epochDay == -1, "Date.of(1969, 12, 31).try.epochDay")
    assert(Date.of(2000, 3, 1).try.epochDay == 11017, "Date.of(2000, 3, 1).try.epochDay")
    assert(Date.of(1900, 1, 1).try.epochDay == -25567, "Date.of(1900, 1, 1).try.epochDay")
    assert(Date.of(2026, 8, 2).try.epochDay == 20667, "Date.of(2026, 8, 2).try.epochDay")
