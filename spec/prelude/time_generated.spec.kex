  it("round-trips ISO datetimes") do
    assert(DateTime.parse("2384-08-30T11:36:20+09:00").try.iso == "2384-08-30T11:36:20+09:00", "DateTime.parse(\"2384-08-30T11:36:20+09:00\").try.iso")
    assert(DateTime.parse("2384-08-30T11:36:20+09:00").try.epochSeconds == 13085462180, "DateTime.parse(\"2384-08-30T11:36:20+09:00\").try.epochSeconds")
    assert(DateTime.parse("2173-01-11T16:29:14-08:00").try.iso == "2173-01-11T16:29:14-08:00", "DateTime.parse(\"2173-01-11T16:29:14-08:00\").try.iso")
    assert(DateTime.parse("2173-01-11T16:29:14-08:00").try.epochSeconds == 6407080154, "DateTime.parse(\"2173-01-11T16:29:14-08:00\").try.epochSeconds")
    assert(DateTime.parse("1593-01-09T22:18:30+06:00").try.iso == "1593-01-09T22:18:30+06:00", "DateTime.parse(\"1593-01-09T22:18:30+06:00\").try.iso")
    assert(DateTime.parse("1593-01-09T22:18:30+06:00").try.epochSeconds == -11896184490, "DateTime.parse(\"1593-01-09T22:18:30+06:00\").try.epochSeconds")
