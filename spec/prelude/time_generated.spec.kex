describe("date validation (vs Ruby)") do
  it("rejects exactly the field combinations Ruby rejects") do
    assert(Date.of(2026, 2, 29).ok? == false, "Date.of(2026, 2, 29).ok?")
    assert(Date.of(2028, 2, 29).ok? == true, "Date.of(2028, 2, 29).ok?")
    assert(Date.of(2026, 2, 30).ok? == false, "Date.of(2026, 2, 30).ok?")
    assert(Date.of(2026, 13, 1).ok? == false, "Date.of(2026, 13, 1).ok?")
    assert(Date.of(2026, 0, 1).ok? == false, "Date.of(2026, 0, 1).ok?")
