    assert(DateTime.of(Date.of(2297, 8, 15).try, Time.of(9, 36, 53).try, Duration.seconds(19800)).epochSeconds == 10338725213, "DateTime.of(Date.of(2297, 8, 15).try, Time.of(9, 36, 53).try, Duration.seconds(19800)).epochSeconds")
    assert(DateTime.of(Date.of(1974, 6, 27).try, Time.of(6, 56, 48).try, Duration.seconds(-26100)).epochSeconds == 141574308, "DateTime.of(Date.of(1974, 6, 27).try, Time.of(6, 56, 48).try, Duration.seconds(-26100)).epochSeconds")
