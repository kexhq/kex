    assert(Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 2, 28).try) == 0, "Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 2, 28).try)")
    assert(Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 3, 1).try) == 1, "Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 3, 1).try)")
    assert(Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 3, 1).try) == 0, "Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 3, 1).try)")
    assert(Date.of(2026, 1, 15).try.monthsUntil(Date.of(2026, 2, 15).try) == 1, "Date.of(2026, 1, 15).try.monthsUntil(Date.of(2026, 2, 15).try)")
    assert(Date.of(2026, 1, 15).try.yearsUntil(Date.of(2026, 2, 15).try) == 0, "Date.of(2026, 1, 15).try.yearsUntil(Date.of(2026, 2, 15).try)")
    assert(Date.of(2026, 2, 28).try.monthsUntil(Date.of(2026, 1, 31).try) == -1, "Date.of(2026, 2, 28).try.monthsUntil(Date.of(2026, 1, 31).try)")
    assert(Date.of(2026, 2, 28).try.yearsUntil(Date.of(2026, 1, 31).try) == 0, "Date.of(2026, 2, 28).try.yearsUntil(Date.of(2026, 1, 31).try)")
    assert(Date.of(2026, 1, 1).try.monthsUntil(Date.of(2026, 12, 31).try) == 11, "Date.of(2026, 1, 1).try.monthsUntil(Date.of(2026, 12, 31).try)")
    assert(Date.of(2026, 1, 1).try.yearsUntil(Date.of(2026, 12, 31).try) == 0, "Date.of(2026, 1, 1).try.yearsUntil(Date.of(2026, 12, 31).try)")
    assert(Date.of(2026, 12, 31).try.monthsUntil(Date.of(2026, 1, 1).try) == -11, "Date.of(2026, 12, 31).try.monthsUntil(Date.of(2026, 1, 1).try)")
    assert(Date.of(2026, 12, 31).try.yearsUntil(Date.of(2026, 1, 1).try) == 0, "Date.of(2026, 12, 31).try.yearsUntil(Date.of(2026, 1, 1).try)")
  end

end

describe("fractional seconds (vs Ruby)") do
  it("renders only the digits it needs") do
    assert(Time.of(1, 25, 57, 706513949).try.iso == "01:25:57.706513949", "Time.of(1, 25, 57, 706513949).try.iso")
    assert(Time.of(4, 38, 9, 0).try.iso == "04:38:09", "Time.of(4, 38, 9, 0).try.iso")
    assert(Time.of(7, 2, 26, 201525103).try.iso == "07:02:26.201525103", "Time.of(7, 2, 26, 201525103).try.iso")
