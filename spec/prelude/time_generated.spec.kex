describe("time of day (vs Ruby)") do
  it("validates fields") do
    assert(Time.of(0, 0, 0).ok? == true, "Time.of(0, 0, 0).ok?")
    assert(Time.of(23, 59, 59).ok? == true, "Time.of(23, 59, 59).ok?")
    assert(Time.of(24, 0, 0).ok? == false, "Time.of(24, 0, 0).ok?")
    assert(Time.of(0, 60, 0).ok? == false, "Time.of(0, 60, 0).ok?")
    assert(Time.of(0, 0, 60).ok? == false, "Time.of(0, 0, 60).ok?")
    assert(Time.of(-1, 0, 0).ok? == false, "Time.of(-1, 0, 0).ok?")
    assert(Time.of(17, -1, 14).ok? == false, "Time.of(17, -1, 14).ok?")
    assert(Time.of(4, 24, 9).ok? == true, "Time.of(4, 24, 9).ok?")
    assert(Time.of(24, 10, 3).ok? == false, "Time.of(24, 10, 3).ok?")
    assert(Time.of(22, 35, 51).ok? == true, "Time.of(22, 35, 51).ok?")
    assert(Time.of(6, 14, 59).ok? == true, "Time.of(6, 14, 59).ok?")
    assert(Time.of(9, 12, 37).ok? == true, "Time.of(9, 12, 37).ok?")
    assert(Time.of(19, 53, 41).ok? == true, "Time.of(19, 53, 41).ok?")
    assert(Time.of(3, 27, -1).ok? == false, "Time.of(3, 27, -1).ok?")
    assert(Time.of(7, 23, 59).ok? == true, "Time.of(7, 23, 59).ok?")
    assert(Time.of(20, 35, 50).ok? == true, "Time.of(20, 35, 50).ok?")
    assert(Time.of(13, 16, 50).ok? == true, "Time.of(13, 16, 50).ok?")
    assert(Time.of(-1, 50, 11).ok? == false, "Time.of(-1, 50, 11).ok?")
    assert(Time.of(0, 10, 32).ok? == true, "Time.of(0, 10, 32).ok?")
    assert(Time.of(-1, 27, 27).ok? == false, "Time.of(-1, 27, 27).ok?")
    assert(Time.of(20, 25, 35).ok? == true, "Time.of(20, 25, 35).ok?")
    assert(Time.of(0, 8, 39).ok? == true, "Time.of(0, 8, 39).ok?")
    assert(Time.of(8, 24, 59).ok? == true, "Time.of(8, 24, 59).ok?")
    assert(Time.of(6, 41, 28).ok? == true, "Time.of(6, 41, 28).ok?")
    assert(Time.of(10, 11, 14).ok? == true, "Time.of(10, 11, 14).ok?")
    assert(Time.of(6, 40, 40).ok? == true, "Time.of(6, 40, 40).ok?")
    assert(Time.of(5, 23, 6).ok? == true, "Time.of(5, 23, 6).ok?")
    assert(Time.of(16, 6, 3).ok? == true, "Time.of(16, 6, 3).ok?")
    assert(Time.of(15, 44, 35).ok? == true, "Time.of(15, 44, 35).ok?")
    assert(Time.of(10, 27, 42).ok? == true, "Time.of(10, 27, 42).ok?")
    assert(Time.of(23, 10, 5).ok? == true, "Time.of(23, 10, 5).ok?")
    assert(Time.of(10, 6, 2).ok? == true, "Time.of(10, 6, 2).ok?")
    assert(Time.of(12, 20, 29).ok? == true, "Time.of(12, 20, 29).ok?")
    assert(Time.of(20, 37, 41).ok? == true, "Time.of(20, 37, 41).ok?")
    assert(Time.of(14, 59, 4).ok? == true, "Time.of(14, 59, 4).ok?")
    assert(Time.of(21, 3, 38).ok? == true, "Time.of(21, 3, 38).ok?")
    assert(Time.of(15, -1, 59).ok? == false, "Time.of(15, -1, 59).ok?")
    assert(Time.of(23, 16, 11).ok? == true, "Time.of(23, 16, 11).ok?")
    assert(Time.of(4, -1, 54).ok? == false, "Time.of(4, -1, 54).ok?")
    assert(Time.of(9, 19, 24).ok? == true, "Time.of(9, 19, 24).ok?")
    assert(Time.of(0, 7, 56).ok? == true, "Time.of(0, 7, 56).ok?")
    assert(Time.of(8, 41, 16).ok? == true, "Time.of(8, 41, 16).ok?")
    assert(Time.of(16, 23, 9).ok? == true, "Time.of(16, 23, 9).ok?")
    assert(Time.of(1, 49, 27).ok? == true, "Time.of(1, 49, 27).ok?")
    assert(Time.of(6, 29, 30).ok? == true, "Time.of(6, 29, 30).ok?")
    assert(Time.of(0, 6, 33).ok? == true, "Time.of(0, 6, 33).ok?")
  end

  it("round-trips seconds since midnight") do
    assert(Time.of(2, 24, 54).try.secondsSinceMidnight == 8694, "Time.of(2, 24, 54).try.secondsSinceMidnight")
    assert(Time.fromSecondsSinceMidnight(8694).iso == "02:24:54", "Time.fromSecondsSinceMidnight(8694).iso")
    assert(Time.of(22, 44, 17).try.secondsSinceMidnight == 81857, "Time.of(22, 44, 17).try.secondsSinceMidnight")
