describe("instants (vs Ruby)") do
  it("converts civil datetimes to epoch seconds") do
    assert(DateTime.of(Date.of(1788, 1, 22).try, Time.of(14, 35, 15).try, Duration.zero()).epochSeconds == -5741486685, "DateTime.of(Date.of(1788, 1, 22).try, Time.of(14, 35, 15).try, Duration.zero()).epochSeconds")
    assert(DateTime.of(Date.of(1665, 3, 25).try, Time.of(20, 42, 27).try, Duration.seconds(36000)).epochSeconds == -9617577453, "DateTime.of(Date.of(1665, 3, 25).try, Time.of(20, 42, 27).try, Duration.seconds(36000)).epochSeconds")
    assert(DateTime.of(Date.of(2350, 7, 14).try, Time.of(22, 25, 43).try, Duration.seconds(19800)).epochSeconds == 12008451343, "DateTime.of(Date.of(2350, 7, 14).try, Time.of(22, 25, 43).try, Duration.seconds(19800)).epochSeconds")
    assert(DateTime.of(Date.of(2392, 3, 15).try, Time.of(11, 47, 27).try, Duration.seconds(3600)).epochSeconds == 13323437247, "DateTime.of(Date.of(2392, 3, 15).try, Time.of(11, 47, 27).try, Duration.seconds(3600)).epochSeconds")
    assert(DateTime.of(Date.of(2105, 9, 30).try, Time.of(3, 5, 45).try, Duration.seconds(-7200)).epochSeconds == 4283730345, "DateTime.of(Date.of(2105, 9, 30).try, Time.of(3, 5, 45).try, Duration.seconds(-7200)).epochSeconds")
    assert(DateTime.of(Date.of(2371, 11, 26).try, Time.of(20, 41, 26).try, Duration.seconds(45000)).epochSeconds == 12682771886, "DateTime.of(Date.of(2371, 11, 26).try, Time.of(20, 41, 26).try, Duration.seconds(45000)).epochSeconds")
    assert(DateTime.of(Date.of(1893, 5, 12).try, Time.of(11, 14, 5).try, Duration.seconds(-28800)).epochSeconds == -2418439555, "DateTime.of(Date.of(1893, 5, 12).try, Time.of(11, 14, 5).try, Duration.seconds(-28800)).epochSeconds")
