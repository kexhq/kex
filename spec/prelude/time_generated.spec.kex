    assert(DateTime.fromEpochSeconds(7314344543, Duration.seconds(39600)).iso == "2201-10-14T05:22:23+11:00", "DateTime.fromEpochSeconds(7314344543, Duration.seconds(39600)).iso")
    assert(DateTime.fromEpochSeconds(2167596158, Duration.seconds(-21600)).iso == "2038-09-08T16:02:38-06:00", "DateTime.fromEpochSeconds(2167596158, Duration.seconds(-21600)).iso")
