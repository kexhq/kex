    assert(Date.of(2006, 9, 6).try.dayOfYear == 249, "Date.of(2006, 9, 6).try.dayOfYear")
    assert(Date.of(1934, 11, 8).try.dayOfYear == 312, "Date.of(1934, 11, 8).try.dayOfYear")
  end

end

