describe("calendar boundaries (vs Ruby)") do
  it("finds the start and end of month, year, and week") do
    assert(Date.of(1872, 2, 10).try.startOfMonth.iso == "1872-02-01", "Date.of(1872, 2, 10).try.startOfMonth.iso")
    assert(Date.of(1872, 2, 10).try.endOfMonth.iso == "1872-02-29", "Date.of(1872, 2, 10).try.endOfMonth.iso")
    assert(Date.of(1872, 2, 10).try.startOfYear.iso == "1872-01-01", "Date.of(1872, 2, 10).try.startOfYear.iso")
    assert(Date.of(1872, 2, 10).try.endOfYear.iso == "1872-12-31", "Date.of(1872, 2, 10).try.endOfYear.iso")
    assert(Date.of(1872, 2, 10).try.startOfWeek.iso == "1872-02-05", "Date.of(1872, 2, 10).try.startOfWeek.iso")
    assert(Date.of(1872, 2, 10).try.endOfWeek.iso == "1872-02-11", "Date.of(1872, 2, 10).try.endOfWeek.iso")
    assert(Date.of(2220, 11, 14).try.startOfMonth.iso == "2220-11-01", "Date.of(2220, 11, 14).try.startOfMonth.iso")
    assert(Date.of(2220, 11, 14).try.endOfMonth.iso == "2220-11-30", "Date.of(2220, 11, 14).try.endOfMonth.iso")
    assert(Date.of(2220, 11, 14).try.startOfYear.iso == "2220-01-01", "Date.of(2220, 11, 14).try.startOfYear.iso")
    assert(Date.of(2220, 11, 14).try.endOfYear.iso == "2220-12-31", "Date.of(2220, 11, 14).try.endOfYear.iso")
    assert(Date.of(2220, 11, 14).try.startOfWeek.iso == "2220-11-13", "Date.of(2220, 11, 14).try.startOfWeek.iso")
    assert(Date.of(2220, 11, 14).try.endOfWeek.iso == "2220-11-19", "Date.of(2220, 11, 14).try.endOfWeek.iso")
    assert(Date.of(1815, 1, 18).try.startOfMonth.iso == "1815-01-01", "Date.of(1815, 1, 18).try.startOfMonth.iso")
    assert(Date.of(1815, 1, 18).try.endOfMonth.iso == "1815-01-31", "Date.of(1815, 1, 18).try.endOfMonth.iso")
    assert(Date.of(1815, 1, 18).try.startOfYear.iso == "1815-01-01", "Date.of(1815, 1, 18).try.startOfYear.iso")
    assert(Date.of(1815, 1, 18).try.endOfYear.iso == "1815-12-31", "Date.of(1815, 1, 18).try.endOfYear.iso")
    assert(Date.of(1815, 1, 18).try.startOfWeek.iso == "1815-01-16", "Date.of(1815, 1, 18).try.startOfWeek.iso")
    assert(Date.of(1815, 1, 18).try.endOfWeek.iso == "1815-01-22", "Date.of(1815, 1, 18).try.endOfWeek.iso")
    assert(Date.of(2058, 5, 20).try.startOfMonth.iso == "2058-05-01", "Date.of(2058, 5, 20).try.startOfMonth.iso")
    assert(Date.of(2058, 5, 20).try.endOfMonth.iso == "2058-05-31", "Date.of(2058, 5, 20).try.endOfMonth.iso")
    assert(Date.of(2058, 5, 20).try.startOfYear.iso == "2058-01-01", "Date.of(2058, 5, 20).try.startOfYear.iso")
    assert(Date.of(2058, 5, 20).try.endOfYear.iso == "2058-12-31", "Date.of(2058, 5, 20).try.endOfYear.iso")
    assert(Date.of(2058, 5, 20).try.startOfWeek.iso == "2058-05-20", "Date.of(2058, 5, 20).try.startOfWeek.iso")
    assert(Date.of(2058, 5, 20).try.endOfWeek.iso == "2058-05-26", "Date.of(2058, 5, 20).try.endOfWeek.iso")
    assert(Date.of(1754, 6, 17).try.startOfMonth.iso == "1754-06-01", "Date.of(1754, 6, 17).try.startOfMonth.iso")
    assert(Date.of(1754, 6, 17).try.endOfMonth.iso == "1754-06-30", "Date.of(1754, 6, 17).try.endOfMonth.iso")
    assert(Date.of(1754, 6, 17).try.startOfYear.iso == "1754-01-01", "Date.of(1754, 6, 17).try.startOfYear.iso")
    assert(Date.of(1754, 6, 17).try.endOfYear.iso == "1754-12-31", "Date.of(1754, 6, 17).try.endOfYear.iso")
    assert(Date.of(1754, 6, 17).try.startOfWeek.iso == "1754-06-17", "Date.of(1754, 6, 17).try.startOfWeek.iso")
    assert(Date.of(1754, 6, 17).try.endOfWeek.iso == "1754-06-23", "Date.of(1754, 6, 17).try.endOfWeek.iso")
    assert(Date.of(1646, 8, 20).try.startOfMonth.iso == "1646-08-01", "Date.of(1646, 8, 20).try.startOfMonth.iso")
    assert(Date.of(1646, 8, 20).try.endOfMonth.iso == "1646-08-31", "Date.of(1646, 8, 20).try.endOfMonth.iso")
    assert(Date.of(1646, 8, 20).try.startOfYear.iso == "1646-01-01", "Date.of(1646, 8, 20).try.startOfYear.iso")
    assert(Date.of(1646, 8, 20).try.endOfYear.iso == "1646-12-31", "Date.of(1646, 8, 20).try.endOfYear.iso")
    assert(Date.of(1646, 8, 20).try.startOfWeek.iso == "1646-08-20", "Date.of(1646, 8, 20).try.startOfWeek.iso")
    assert(Date.of(1646, 8, 20).try.endOfWeek.iso == "1646-08-26", "Date.of(1646, 8, 20).try.endOfWeek.iso")
    assert(Date.of(2137, 12, 18).try.startOfMonth.iso == "2137-12-01", "Date.of(2137, 12, 18).try.startOfMonth.iso")
