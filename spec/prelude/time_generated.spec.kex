  it("adds whole hours and minutes") do
    assert(Time.of(2, 20, 15).try.addHours(46).iso == "00:20:15", "Time.of(2, 20, 15).try.addHours(46).iso")
    assert(Time.of(2, 20, 15).try.addMinutes(14).iso == "02:34:15", "Time.of(2, 20, 15).try.addMinutes(14).iso")
    assert(Time.of(3, 8, 2).try.addHours(15).iso == "18:08:02", "Time.of(3, 8, 2).try.addHours(15).iso")
    assert(Time.of(3, 8, 2).try.addMinutes(430).iso == "10:18:02", "Time.of(3, 8, 2).try.addMinutes(430).iso")
    assert(Time.of(4, 7, 5).try.addHours((-11)).iso == "17:07:05", "Time.of(4, 7, 5).try.addHours((-11)).iso")
    assert(Time.of(4, 7, 5).try.addMinutes(276).iso == "08:43:05", "Time.of(4, 7, 5).try.addMinutes(276).iso")
    assert(Time.of(11, 43, 48).try.addHours((-40)).iso == "19:43:48", "Time.of(11, 43, 48).try.addHours((-40)).iso")
    assert(Time.of(11, 43, 48).try.addMinutes(220).iso == "15:23:48", "Time.of(11, 43, 48).try.addMinutes(220).iso")
    assert(Time.of(11, 18, 54).try.addHours(21).iso == "08:18:54", "Time.of(11, 18, 54).try.addHours(21).iso")
    assert(Time.of(11, 18, 54).try.addMinutes(73).iso == "12:31:54", "Time.of(11, 18, 54).try.addMinutes(73).iso")
    assert(Time.of(17, 23, 59).try.addHours((-38)).iso == "03:23:59", "Time.of(17, 23, 59).try.addHours((-38)).iso")
    assert(Time.of(17, 23, 59).try.addMinutes(361).iso == "23:24:59", "Time.of(17, 23, 59).try.addMinutes(361).iso")
    assert(Time.of(13, 45, 20).try.addHours((-12)).iso == "01:45:20", "Time.of(13, 45, 20).try.addHours((-12)).iso")
