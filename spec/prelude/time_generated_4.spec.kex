  it("scales, negates, and compares (part 1/3)") do
    assert((40983.second * (-10)).wholeSeconds == -409830, "(40983.second * (-10)).wholeSeconds")
    assert((40983.second / 4).wholeSeconds == 10245, "(40983.second / 4).wholeSeconds")
    assert(40983.second.abs.wholeSeconds == 40983, "40983.second.abs.wholeSeconds")
    assert(40983.second.negated.wholeSeconds == -40983, "40983.second.negated.wholeSeconds")
    assert(40983.second.negative? == false, "40983.second.negative?")
    assert(40983.second.positive? == true, "40983.second.positive?")
    assert(40983.second.zero? == false, "40983.second.zero?")
    assert(((-38428).second * (-4)).wholeSeconds == 153712, "((-38428).second * (-4)).wholeSeconds")
    assert(((-38428).second / 1).wholeSeconds == -38428, "((-38428).second / 1).wholeSeconds")
    assert((-38428).second.abs.wholeSeconds == 38428, "(-38428).second.abs.wholeSeconds")
    assert((-38428).second.negated.wholeSeconds == 38428, "(-38428).second.negated.wholeSeconds")
    assert((-38428).second.negative? == true, "(-38428).second.negative?")
    assert((-38428).second.positive? == false, "(-38428).second.positive?")
    assert((-38428).second.zero? == false, "(-38428).second.zero?")
    assert((50337.second * 0).wholeSeconds == 0, "(50337.second * 0).wholeSeconds")
    assert((50337.second / (-2)).wholeSeconds == -25168, "(50337.second / (-2)).wholeSeconds")
    assert(50337.second.abs.wholeSeconds == 50337, "50337.second.abs.wholeSeconds")
    assert(50337.second.negated.wholeSeconds == -50337, "50337.second.negated.wholeSeconds")
    assert(50337.second.negative? == false, "50337.second.negative?")
    assert(50337.second.positive? == true, "50337.second.positive?")
    assert(50337.second.zero? == false, "50337.second.zero?")
    assert(((-55708).second * 4).wholeSeconds == -222832, "((-55708).second * 4).wholeSeconds")
