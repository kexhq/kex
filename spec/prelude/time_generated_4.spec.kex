  it("builds the same span from every spelling (part 1/8)") do
    assert(642.millisecond.wholeSeconds == 0, "642.millisecond.wholeSeconds")
    assert(642.millisecond.wholeSeconds == 0, "642.millisecond.wholeSeconds")
    assert(642.0.millisecond.wholeSeconds == 0, "642.0.millisecond.wholeSeconds")
