describe("Time") do
  it("reaches the Date inside the Result before using it") do
    # `Date.of(...)` is a Result: `.iso` belongs to Date, and calling it on the
    # Result is a type error (spec/error_method_on_wrong_receiver.kex).
    assert(Date.of(2026, 2, 22).try.iso == "2026-02-22")
    match Date.of(2026, 2, 22) do
      Ok(date) -> assert(date.iso == "2026-02-22")
      Error(_) -> assert(false)
    end
  end

  it("builds and validates dates") do
    let date = Date.of(2026, 7, 30).try
    assert(date.year == 2026)
    assert(date.month == 7)
    assert(date.day == 30)
    assert(date.iso == "2026-07-30")
    assert(Date.of(2026, 2, 30).ok? == false)
    assert(Date.of(2026, 13, 1).ok? == false)
    assert(Date.of(2028, 2, 29).ok?)
  end

  it("builds and validates times of day") do
    let time = Time.of(14, 3, 9).try
    assert(time.iso == "14:03:09")
    assert(time.secondsSinceMidnight == 50589)
    assert(Time.of(24, 0, 0).ok? == false)
    assert(Time.of(0, 60, 0).ok? == false)
    assert(Time.of(0, 0, 60).ok? == false)
    assert(Time.midnight().iso == "00:00:00")
    # Nanoseconds are kept on the value AND rendered, in the shortest of the
    # 3/6/9-digit groupings that loses nothing.
    assert(Time.of(1, 2, 3, 400000000).try.iso == "01:02:03.400")
    assert(Time.of(1, 2, 3, 400000000).try.nanosecond == 400000000)
    assert(Time.of(1, 2, 3, 400000).try.iso == "01:02:03.000400")
    assert(Time.of(1, 2, 3, 400).try.iso == "01:02:03.000000400")
    # A whole second renders no fraction at all.
    assert(Time.of(1, 2, 3, 0).try.iso == "01:02:03")
  end

  it("converts between civil dates and epoch days") do
    assert(Date.of(1970, 1, 1).try.epochDay == 0)
    assert(Date.of(2026, 7, 30).try.epochDay == 20664)
    assert(Date.fromEpochDay(0).iso == "1970-01-01")
    assert(Date.fromEpochDay(20664).iso == "2026-07-30")
    # Before the epoch, where truncating division needs the floor correction.
    assert(Date.of(1969, 12, 31).try.epochDay == -1)
    assert(Date.fromEpochDay(-1).iso == "1969-12-31")
    # The shift constant lands on the algorithm's era boundary, 0000-03-01.
    assert(Date.fromEpochDay(-719468).iso == "0000-03-01")
  end

  it("knows weekdays") do
    # 1970-01-01 was a Thursday.
    assert(Date.fromEpochDay(0).weekday.name == "Thursday")
    assert(Date.of(2026, 7, 30).try.weekday.name == "Thursday")
    assert(Date.of(2026, 8, 1).try.weekday.name == "Saturday")
    assert(Date.of(2026, 8, 1).try.weekday.weekend?)
    assert(Date.of(2026, 7, 30).try.weekday.weekend? == false)
    assert(Date.of(2026, 8, 2).try.weekday.number == 7)
  end

  it("does calendar arithmetic") do
    let date = Date.of(2026, 7, 30).try
    assert(date.addDays(10).iso == "2026-08-09")
    assert(date.addWeeks(1).iso == "2026-08-06")
    assert((date + 10.days).iso == "2026-08-09")
    assert((date - 1.weeks).iso == "2026-07-23")
    # A sub-day span truncates: whole days only.
    assert((date + 36.hours).iso == "2026-07-31")
    assert(date.daysUntil(date.addDays(45)) == 45)
    assert(date.dayOfYear == 211)
    assert(Date.of(2026, 1, 1).try.dayOfYear == 1)
  end

  it("clamps month arithmetic into the target month") do
    assert(Date.of(2026, 1, 31).try.addMonths(1).iso == "2026-02-28")
    assert(Date.of(2028, 1, 31).try.addMonths(1).iso == "2028-02-29")
    assert(Date.of(2026, 7, 30).try.addMonths(7).iso == "2027-02-28")
    assert(Date.of(2026, 3, 15).try.addMonths(-3).iso == "2025-12-15")
    assert(Date.of(2026, 7, 30).try.addYears(2).iso == "2028-07-30")
  end

  it("identifies leap years") do
    assert(Time.leapYear?(2028))
    assert(Time.leapYear?(2026) == false)
    assert(Time.leapYear?(2100) == false)
    assert(Time.leapYear?(2000))
  end

  it("renders instants with their offset") do
    let moment = DateTime.parse("2026-07-30T14:03:00+02:00").try
    assert(moment.iso == "2026-07-30T14:03:00+02:00")
    assert(moment.utc.iso == "2026-07-30T12:03:00Z")
    assert(moment.epochSeconds == 1785412980)
    assert(moment.at(Duration.utcOffset(-5, 0)).iso == "2026-07-30T07:03:00-05:00")
    assert(DateTime.fromEpochSeconds(0).iso == "1970-01-01T00:00:00Z")
    assert(DateTime.fromEpochSeconds(-86400).iso == "1969-12-31T00:00:00Z")
    assert(DateTime.fromEpochSeconds(1785412980, Duration.utcOffset(2, 0)).iso ==
           "2026-07-30T14:03:00+02:00")
  end

  it("orders instants by the moment, not by the rendering") do
    let local = DateTime.parse("2026-07-30T14:03:00+02:00").try
    let utc = DateTime.parse("2026-07-30T12:03:00Z").try
    assert(local.compareTo(utc) == Equal)
    assert(local.before?(local + 1.hours))
    assert((local + 1.hours).after?(local))
    assert(local.compareTo(local + 1.seconds) == Less)
  end

  it("adds and subtracts durations from instants") do
    let moment = DateTime.parse("2026-07-30T14:03:00+02:00").try
    assert((moment + 90.minutes).iso == "2026-07-30T15:33:00+02:00")
    assert((moment - 3.hours).iso == "2026-07-30T11:03:00+02:00")
    # Crossing midnight rolls the date.
    assert((moment + 12.hours).iso == "2026-07-31T02:03:00+02:00")
    assert(moment.until(moment + 2.hours).wholeMinutes == 120)
    assert(moment.until(moment - 1.hours).wholeMinutes == -60)
  end

  it("parses ISO 8601 text") do
    assert(Date.parse("2026-07-30").try.iso == "2026-07-30")
    assert(Time.parse("14:03").try.iso == "14:03:00")
    assert(Time.parse("14:03:09").try.iso == "14:03:09")
    # Sub-second precision survives the round trip; it used to be parsed,
    # stored, and then silently dropped on the way back out.
    assert(Time.parse("14:03:09.5").try.iso == "14:03:09.500")
    assert(Time.parse("14:03:09.5").try.nanosecond == 500000000)
    assert(Time.parse("14:03:09.123456789").try.iso == "14:03:09.123456789")
    assert(DateTime.parse("2026-07-30T14:03:00.25Z").try.iso ==
           "2026-07-30T14:03:00.250Z")
    assert(DateTime.parse("2026-07-30T14:03:00Z").try.iso == "2026-07-30T14:03:00Z")
    # A bare civil datetime reads as UTC.
    assert(DateTime.parse("2026-07-30T14:03:00").try.iso == "2026-07-30T14:03:00Z")
    assert(Time.parseOffset("Z").try.wholeSeconds == 0)
    assert(Time.parseOffset("+02:00").try.wholeSeconds == 7200)
    assert(Time.parseOffset("-05:30").try.wholeSeconds == -19800)
  end

  it("reports a parse failure against the whole input") do
    # Not against the fragment that failed: "2:03 pm" complains about
    # "2:03 pm", not about "03 pm".
    match Time.parse("2:03 pm") do
      Ok(_) -> assert(false)
      Error(error) -> assert(Time.errorMessage(error) ==
                             "cannot parse as a date/time: 2:03 pm")
    end
    match Date.parse("20x6-07-30") do
      Ok(_) -> assert(false)
      Error(error) -> assert(Time.errorMessage(error) ==
                             "cannot parse as a date/time: 20x6-07-30")
    end
    match DateTime.parse("2026-07-30T14:03:00+0z:00") do
      Ok(_) -> assert(false)
      Error(error) -> assert(Time.errorMessage(error) ==
                             "cannot parse as a date/time: 2026-07-30T14:03:00+0z:00")
    end
  end

  it("rejects text that is not a date or time") do
    assert(Date.parse("2026-02-30").ok? == false)
    assert(Date.parse("nope").ok? == false)
    assert(Date.parse("2026-07").ok? == false)
    assert(Time.parse("14").ok? == false)
    assert(DateTime.parse("2026-07-30 14:03:00").ok? == false)
    assert(Time.parseOffset("+2").ok? == false)
  end

  it("describes what went wrong") do
    match Date.of(2026, 2, 30) do
      Ok(_) -> assert(false)
      Error(error) -> assert(Time.errorMessage(error) == "not a calendar date: 2026-2-30")
    end
    match Date.parse("nope") do
      Ok(_) -> assert(false)
      Error(error) -> assert(Time.errorMessage(error) == "cannot parse as a date/time: nope")
    end
  end

  it("builds durations from plural spellings") do
    assert(1.seconds.seconds == 1.0)
    assert(2.minutes.wholeSeconds == 120)
    assert(3.hours.wholeMinutes == 180)
    assert(2.days.wholeHours == 48)
    assert(1.weeks.wholeDays == 7)
    assert(500.milliseconds.seconds == 0.5)
    assert(1.5.hours.wholeMinutes == 90)
    # Truncation is toward zero, both ways.
    assert(90.minutes.wholeHours == 1)
    assert((0 - 90).minutes.wholeHours == -1)
  end

  it("combines and orders durations") do
    assert((1.hours + 30.minutes).wholeMinutes == 90)
    assert((1.hours - 30.minutes).wholeMinutes == 30)
    assert(1.hours.negated.wholeMinutes == -60)
    assert(30.minutes.compareTo(1.hours) == Less)
    assert(1.hours.compareTo(60.minutes) == Equal)
    assert(Duration.zero().wholeSeconds == 0)
    assert(Duration.utcOffset(-5, 30).wholeSeconds == -19800)
  end

  it("answers `now` for every type") do
    let moment = DateTime.now()
    let date = Date.now()
    let clock = Time.now()
    # All three read the same clock, so the date and time components of the
    # instant agree with the standalone readings (barring a midnight tick).
    assert(date.compareTo(moment.date) == Equal)
    assert(clock.hour == moment.time.hour)
    assert(Date.today().compareTo(Date.now()) == Equal)
    assert(Date.utcNow().compareTo(DateTime.utcNow().date) == Equal)
    assert(Time.utcNow().hour == DateTime.utcNow().time.hour)
  end

  it("reads the host clock consistently across both backends") do
    let now = DateTime.now()
    let utc = DateTime.utcNow()
    # Same instant rendered two ways, so the civil days can differ but the
    # epoch seconds cannot drift by more than the time between the calls.
    assert(now.compareTo(now.utc) == Equal)
    assert(utc.offset.wholeSeconds == 0)
    assert(now.until(utc).wholeSeconds.abs <= 5)
    assert(Date.today().compareTo(DateTime.now().date) == Equal)
    assert(DateTime.epochNanos() > 1750000000000000000)
  end

  # The distinction the two span types exist to draw. A Duration is a fixed
  # number of seconds; a Period asks the calendar. They deliberately disagree.
  it("keeps calendar spans and elapsed spans apart") do
    let jan31 = Date.of(2026, 1, 31).try
    assert((jan31 + 1.months).iso == "2026-02-28")
    assert((jan31 + 31.days).iso == "2026-03-03")
    # Four weeks is exactly 28 days; one month is however long the month is.
    assert((jan31 + 4.weeks).iso == "2026-02-28")
    assert((Date.of(2026, 2, 1).try + 4.weeks).iso == "2026-03-01")
    assert((Date.of(2026, 2, 1).try + 1.months).iso == "2026-03-01")
    assert((Date.of(2026, 3, 1).try + 1.months).iso == "2026-04-01")
    # A leap day survives only where the target year has one.
    assert((Date.of(2024, 2, 29).try + 1.years).iso == "2025-02-28")
    assert((Date.of(2024, 2, 29).try + 4.years).iso == "2028-02-29")
  end

  it("builds and renders periods") do
    assert(Period.of(1, 2, 3).iso == "P1Y2M3D")
    assert(Period.zero().iso == "P0D")
    assert(3.months.iso == "P3M")
    assert(2.years.iso == "P2Y")
    assert(Period.weeks(2).iso == "P14D")
    assert((1.years + 2.months).iso == "P1Y2M")
    assert((1.years - 2.months).iso == "P1Y-2M")
    assert(Period.of(0, 14, 3).normalized.iso == "P1Y2M3D")
    assert(Period.of(0, 14, 3).totalMonths == 14)
    assert(Period.of(1, 2, 3).negated.iso == "P-1Y-2M-3D")
    assert((Period.of(1, 2, 3) * 2).iso == "P2Y4M6D")
    assert(Period.zero().zero?)
  end

  it("steps a DateTime by calendar without moving the wall clock") do
    let moment = DateTime.parse("2026-01-31T09:30:00+02:00").try
    assert((moment + 1.months).iso == "2026-02-28T09:30:00+02:00")
    assert(moment.addMonths(1).iso == "2026-02-28T09:30:00+02:00")
    assert(moment.addDays(1).iso == "2026-02-01T09:30:00+02:00")
    assert(moment.addYears(1).iso == "2027-01-31T09:30:00+02:00")
    assert(moment.addWeeks(1).iso == "2026-02-07T09:30:00+02:00")
  end

  it("wraps wall-clock arithmetic within the day") do
    let late = Time.of(23, 0, 0).try
    assert((late + 2.hours).iso == "01:00:00")
    assert((Time.midnight() - 1.seconds).iso == "23:59:59")
    assert(late.addHours(25).iso == "00:00:00")
    assert(late.addMinutes(-90).iso == "21:30:00")
    # The nanosecond field rides along untouched.
    assert((Time.of(23, 0, 0, 250000000).try + 2.hours).iso == "01:00:00.250")
    assert(Time.of(1, 0, 0).try.until(Time.of(2, 30, 0).try).wholeMinutes == 90)
  end

  it("finds calendar boundaries") do
    let date = Date.of(2026, 7, 30).try
    assert(date.startOfMonth.iso == "2026-07-01")
    assert(date.endOfMonth.iso == "2026-07-31")
    assert(date.startOfYear.iso == "2026-01-01")
    assert(date.endOfYear.iso == "2026-12-31")
    # 2026-07-30 is a Thursday, so the ISO week runs Mon 27th to Sun 2nd.
    assert(date.weekday.name == "Thursday")
    assert(date.startOfWeek.iso == "2026-07-27")
    assert(date.endOfWeek.iso == "2026-08-02")
    assert(Date.of(2024, 2, 10).try.endOfMonth.iso == "2024-02-29")
  end

  # monthsUntil is the exact inverse of addMonths, which is what makes the
  # January 31st case 1 rather than 0: `jan31 + 1.months` IS February 28th.
  it("counts whole months and years between dates") do
    let jan31 = Date.of(2026, 1, 31).try
    assert(jan31.monthsUntil(Date.of(2026, 2, 28).try) == 1)
    assert(jan31.monthsUntil(Date.of(2026, 2, 27).try) == 0)
    assert(jan31.monthsUntil(Date.of(2026, 1, 31).try) == 0)
    assert(jan31.monthsUntil(Date.of(2027, 1, 31).try) == 12)
    assert(jan31.yearsUntil(Date.of(2027, 1, 30).try) == 0)
    assert(jan31.yearsUntil(Date.of(2027, 1, 31).try) == 1)
    # Antisymmetric: reversing the two dates negates the answer.
    assert(Date.of(2026, 2, 28).try.monthsUntil(jan31) == -1)
    assert(Date.of(2027, 1, 31).try.yearsUntil(jan31) == -1)
  end

  it("scales and compares durations") do
    assert((1.days * 3).wholeHours == 72)
    assert((1.hours / 4).wholeMinutes == 15)
    assert(90.minutes.wholeHours == 1)
    assert(90.minutes.wholeSeconds == 5400)
    assert(1500.milliseconds.wholeMilliseconds == 1500)
    assert(21.days.wholeWeeks == 3)
    assert(2.5.hours.wholeMinutes == 150)
    assert(1.5.weeks.wholeDays == 10)
    assert((0 - 90).minutes.abs.wholeMinutes == 90)
    assert((0 - 1).seconds.negative?)
    assert(1.seconds.positive?)
    assert(Duration.zero().zero?)
    assert(1.hours.longerThan?(59.minutes))
    assert(59.minutes.shorterThan?(1.hours))
  end

  # The scoped form is what makes clock-reading code testable without leaving
  # a frozen clock behind for every spec that runs after this one.
  it("scopes a mocked clock to a block") do
    let instant = DateTime.parse("2026-07-30T14:03:00Z").try
    let seen = Time.frozenAt(instant, do Date.utcToday().iso end).try
    assert(seen == "2026-07-30")
    assert(!Time.controlled?())

    # Frozen means frozen: two readings inside the block are the same instant.
    let stable = Time.frozenAt(instant) do
      DateTime.utcNow().epochSeconds == DateTime.utcNow().epochSeconds
    end
    assert(stable.try)

    # Travelling starts there and keeps running.
    assert(Time.travellingFrom(instant, do Date.utcToday().iso end).try ==
           "2026-07-30")
    assert(!Time.controlled?())
  end

  it("refuses instants the int64 nanosecond clock cannot name") do
    let tooLate = DateTime.parse("2500-01-01T00:00:00Z").try
    let tooEarly = DateTime.parse("1600-01-01T00:00:00Z").try
    assert(!Time.settable?(tooLate))
    assert(!Time.settable?(tooEarly))
    assert(Time.settable?(DateTime.parse("2026-01-01T00:00:00Z").try))
    assert(Time.freeze(tooLate).ok? == false)
    assert(Time.travel(tooEarly).ok? == false)
    # The clock is untouched and the body never runs.
    var ran = false
    assert(Time.frozenAt(tooLate, do ran = true end).ok? == false)
    assert(!ran)
    assert(!Time.controlled?())
  end
end
