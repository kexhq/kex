# kex: no-check

describe("String — length and emptiness") do
  it("count returns the number of characters") do
    assert("hello".count == 5)
    assert("".count == 0)
    assert("kex lang".count == 8)
  end

  it("empty? is true only for the empty string") do
    assert("".empty?)
    assert(!"hello".empty?)
    assert(!" ".empty?)
  end

  it("graphemeCount agrees with count when every grapheme is one codepoint") do
    assert("hello".graphemeCount == 5)
    assert("".graphemeCount == 0)
    assert("kex lang".graphemeCount == 8)
  end

  it("graphemeCount counts a CRLF pair as one character, unlike count") do
    assert("\r\n".count == 2)
    assert("\r\n".graphemeCount == 1)
    assert("a\r\nb".count == 4)
    assert("a\r\nb".graphemeCount == 3)
  end

  it("graphemeCount counts a base character plus a combining mark as one") do
    let acute = String.fromCodepoint(0x301).or("")
    let e = "e" + acute
    assert(e.count == 2)
    assert(e.graphemeCount == 1)
  end
end

describe("String — indexing") do
  it("at wraps the character for valid indices") do
    assert("hello".at(0) == Just('h'))
    assert("hello".at(4) == Just('o'))
  end

  it("at counts a negative index from the end, None past either end") do
    assert("hello".at(5) == None)
    assert("hello".at(-1) == Just('o'))
    assert("hello".at(-6) == None)
    assert("".at(0) == None)
  end
end

describe("String — chars") do
  it("chars returns a list of characters") do
    assert("hi".chars == ['h', 'i'])
    assert("".chars == [])
    assert("a".chars == ['a'])
  end
end

describe("String — split") do
  it("split with separator splits on every occurrence") do
    assert("a,b,c".split(",") == ["a", "b", "c"])
    assert("hello world".split(" ") == ["hello", "world"])
  end

  it("split preserves empty segments") do
    assert("a,,b".split(",") == ["a", "", "b"])
  end

end

describe("String — trim") do
  it("trim removes leading and trailing whitespace") do
    assert("  hello  ".trim == "hello")
    assert("hello".trim == "hello")
    assert("  ".trim == "")
  end
end

describe("String — case conversion") do
  it("upperCase converts all characters to upper case") do
    assert("hello".upperCase == "HELLO")
    assert("Hello World".upperCase == "HELLO WORLD")
    assert("".upperCase == "")
  end

  it("lowerCase converts all characters to lower case") do
    assert("HELLO".lowerCase == "hello")
    assert("Hello World".lowerCase == "hello world")
    assert("".lowerCase == "")
  end
end

describe("String — reverse") do
  it("reverse reverses the string") do
    assert("hello".reverse == "olleh")
    assert("a".reverse == "a")
    assert("".reverse == "")
    assert("abcde".reverse == "edcba")
  end
end

describe("String — searching") do
  it("contains? finds a substring") do
    assert("hello world".contains?("world"))
    assert("hello world".contains?("hello"))
    assert(!"hello world".contains?("xyz"))
    assert("hello".contains?(""))
  end

  it("startsWith? checks the prefix") do
    assert("hello".startsWith?("hel"))
    assert("hello".startsWith?("hello"))
    assert(!"hello".startsWith?("llo"))
    assert("hello".startsWith?(""))
  end

  it("endsWith? checks the suffix") do
    assert("hello".endsWith?("llo"))
    assert("hello".endsWith?("hello"))
    assert(!"hello".endsWith?("hel"))
    assert("hello".endsWith?(""))
  end
end

describe("String — conversion") do
  it("to(Integer) parses a numeric string") do
    assert("42".to(Integer) == Just(42))
    assert("-7".to(Integer) == Just(-7))
  end

  it("to(Integer) returns None for non-numeric strings") do
    assert("abc".to(Integer) == None)
  end

  it("to(Float) parses a float string") do
    assert("3.14".to(Float) == Just(3.14))
  end

  it("to(Float) returns None for non-numeric strings") do
    assert("xyz".to(Float) == None)
  end
end

describe("String — fromCodepoint") do
  it("constructs a one-codepoint UTF-8 string") do
    assert(String.fromCodepoint(65) == Just("A"))
    assert(String.fromCodepoint(955) == Just("λ"))
    assert(String.fromCodepoint(128640) == Just("🚀"))
  end

  it("rejects values outside the Unicode scalar range") do
    assert(String.fromCodepoint(-1) == None)
    assert(String.fromCodepoint(55296) == None)
    assert(String.fromCodepoint(1114112) == None)
  end
end

describe("String — second and third") do
  it("second returns the second character") do
    assert("abc".second == Just('b'))
    assert("a".second == None)
    assert("".second == None)
  end

  it("third returns the third character") do
    assert("abc".third == Just('c'))
    assert("ab".third == None)
  end
end

describe("String — join from list") do
  it("join concatenates string lists with separator") do
    assert(["hello", "world"].join(", ") == "hello, world")
    assert(["a", "b", "c"].join("-") == "a-b-c")
  end

  it("join single element") do
    assert(["only"].join(", ") == "only")
  end
end

describe("String — substitute") do
  it("replaces every key with its value") do
    assert("Hello, $WHO$!".substitute({"$WHO$": "world"}) == "Hello, world!")
    assert("$A$ and $B$".substitute({"$A$": "x", "$B$": "y"}) == "x and y")
  end

  it("replaces every occurrence of a key, not just the first") do
    assert("$X$-$X$-$X$".substitute({"$X$": "a"}) == "a-a-a")
  end

  it("imposes no placeholder syntax") do
    # The keys are literal, so a template picks its own convention.
    assert("__A__".substitute({"__A__": "one"}) == "one")
    assert("{{a}}".substitute({"{{a}}": "two"}) == "two")
    assert("%a%".substitute({"%a%": "three"}) == "three")
  end

  it("leaves the string alone when nothing matches") do
    assert("untouched".substitute({"$NOPE$": "x"}) == "untouched")
    assert("untouched".substitute({}) == "untouched")
  end

  it("applies each substitution to the result of the last") do
    # Documented behaviour rather than an accident: substitutions run in the
    # map's canonical key order, so a value containing a later key is still
    # rewritten. `$A$` sorts before `$B$`.
    assert("$A$".substitute({"$A$": "<$B$>", "$B$": "done"}) == "<done>")
  end
end

describe("String — indentRest") do
  it("indents every line but the first") do
    assert("a\nb\nc".indentRest("  ") == "a\n  b\n  c")
  end

  it("leaves a single line alone") do
    assert("a".indentRest("  ") == "a")
    assert("".indentRest("  ") == "")
  end

  it("drops one trailing newline, so a block does not open a gap") do
    assert("a\nb\n".indentRest("  ") == "a\n  b")
  end

  it("keeps blank lines blank rather than filling them with the prefix") do
    assert("a\n\nb\n".indentRest("  ") == "a\n\n  b")
  end
end

describe("String — identifier case conversion") do
  it("splits words at separators and at case boundaries") do
    assert("userId".snakeCase == "user_id")
    assert("show-nickname".snakeCase == "show_nickname")
    assert("  spaced  out ".snakeCase == "spaced_out")
    assert("user2Id".snakeCase == "user2_id")
  end

  it("keeps a run of capitals together, up to the word it starts") do
    assert("HTTPServer".snakeCase == "http_server")
    assert("XMLHttpRequest".kebabCase == "xml-http-request")
  end

  it("spells the words in each convention") do
    assert("show_nickname".camelCase == "showNickname")
    assert("show_nickname".pascalCase == "ShowNickname")
    assert("userId".kebabCase == "user-id")
    assert("PascalCase".camelCase == "pascalCase")
  end

  it("leaves other characters in their word") do
    assert("empty?".snakeCase == "empty?")
    assert("".camelCase == "")
  end
end

describe("String — slice") do
  it("slice(start, length) extracts a substring") do
    assert("hello".slice(1, 3) == "ell")
    assert("hello".slice(0, 5) == "hello")
    assert("hello".slice(0, 0) == "")
    assert("hello".slice(4, 1) == "o")
  end

  it("slice(start, length) clamps, and counts a negative start from the end") do
    assert("hello".slice(1, 99) == "ello")
    assert("hello".slice(9, 3) == "")
    assert("hello".slice(-3, 2) == "ll")
    assert("hello".slice(-9, 2) == "")
    assert("hello".slice(1, -1) == "")
    assert("".slice(0, 5) == "")
  end

  it("slice counts characters, not bytes") do
    assert("héllo".slice(1, 2) == "él")
  end

  it("slice(range) extracts an inclusive range") do
    assert("hello".slice(1..3) == "ell")
    assert("hello".slice(0..4) == "hello")
    assert("hello".slice(2..2) == "l")
  end

  it("slice(range) clamps, and counts negative ends from the end") do
    assert("hello".slice(3..99) == "lo")
    assert("hello".slice(9..20) == "")
    assert("hello".slice(3..1) == "")
    assert("hello".slice(-3..1) == "")
    assert("hello".slice(1..-1) == "ello")
    assert("hello"[-3..-1] == "llo")
  end

  it("get accepts a range, so brackets index a substring") do
    assert("hello".get(1..3) == "ell")
    assert("hello"[1..3] == "ell")
    assert("hello"[0..4] == "hello")
    assert("hello"[2..2] == "l")
  end
end

describe("String padding") do
  it("pads on the left and the right") do
    assert("7".padLeft(3) == "  7")
    assert("7".padLeft(3, "0") == "007")
    assert("abc".padLeft(8, "12") == "12121abc")
    assert("ab".padRight(5, ".") == "ab...")
    assert("long".padLeft(2) == "long")
    assert("x".padLeft(3, "") == "x")
  end

  it("centers with the extra character on the right") do
    assert("ab".center(6) == "  ab  ")
    assert("ab".center(5) == " ab  ")
    assert("ab".center(6, "*") == "**ab**")
  end
end

describe("String searching by substring") do
  it("indexOf finds a substring by character index") do
    assert("hello world".indexOf("o w") == Just(4))
    assert("héllo".indexOf("llo") == Just(2))
    assert("hello".indexOf("xyz") == None)
    assert("hello".indexOf('l') == Just(2))
  end

  it("occurrences counts substrings, count counts by predicate") do
    assert("hello".occurrences("l") == 2)
    assert("aaaa".occurrences("aa") == 2)
    assert("hello".occurrences("") == 0)
    assert("hello".count { |c| c == 'l' } == 2)
    assert("hello".count == 5)
  end

  it("replaceFirst replaces only the first match") do
    assert("a-b-c".replaceFirst("-", "+") == "a+b-c")
    assert("abc".replaceFirst("x", "y") == "abc")
  end
end

describe("String trimming and affixes") do
  it("trims Unicode whitespace, the same set space? accepts") do
    assert("\u{A0} x y\u{2028}\t".trim == "x y")
    assert("  hi  ".trimStart == "hi  ")
    assert("  hi  ".trimEnd == "  hi")
    assert("line\r\n".trimEnd == "line")
  end

  it("removes a prefix or a suffix only when present") do
    assert("v1.2".removePrefix("v") == "1.2")
    assert("1.2".removePrefix("v") == "1.2")
    assert("notes.txt".removeSuffix(".txt") == "notes")
  end

  it("repeats, takes and drops while") do
    assert("ab".repeat(3) == "ababab")
    assert("ab".repeat(0) == "")
    assert("123abc".takeWhile(~digit?) == "123")
    assert("123abc".dropWhile(~digit?) == "abc")
    assert("hello".take(-2) == "")
  end
end

describe("String.lines and line endings") do
  it("reads CRLF as one line ending") do
    assert("a\r\nb\r\n".lines == ["a", "b"])
    assert("a\nb".lines == ["a", "b"])
    assert("a\r".lines == ["a"])
  end
end
