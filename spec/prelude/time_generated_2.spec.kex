describe("instants (vs Ruby)") do
  it("converts civil datetimes to epoch seconds") do
    assert(DateTime.of(Date.of(1788, 1, 22).try, Time.of(14, 35, 15).try, Duration.zero()).epochSeconds == -5741486685, "DateTime.of(Date.of(1788, 1, 22).try, Time.of(14, 35, 15).try, Duration.zero()).epochSeconds")
    assert(DateTime.of(Date.of(1665, 3, 25).try, Time.of(20, 42, 27).try, Duration.seconds(36000)).epochSeconds == -9617577453, "DateTime.of(Date.of(1665, 3, 25).try, Time.of(20, 42, 27).try, Duration.seconds(36000)).epochSeconds")
    assert(DateTime.of(Date.of(2350, 7, 14).try, Time.of(22, 25, 43).try, Duration.seconds(19800)).epochSeconds == 12008451343, "DateTime.of(Date.of(2350, 7, 14).try, Time.of(22, 25, 43).try, Duration.seconds(19800)).epochSeconds")
    assert(DateTime.of(Date.of(2392, 3, 15).try, Time.of(11, 47, 27).try, Duration.seconds(3600)).epochSeconds == 13323437247, "DateTime.of(Date.of(2392, 3, 15).try, Time.of(11, 47, 27).try, Duration.seconds(3600)).epochSeconds")
    assert(DateTime.of(Date.of(2105, 9, 30).try, Time.of(3, 5, 45).try, Duration.seconds(-7200)).epochSeconds == 4283730345, "DateTime.of(Date.of(2105, 9, 30).try, Time.of(3, 5, 45).try, Duration.seconds(-7200)).epochSeconds")
    assert(DateTime.of(Date.of(2371, 11, 26).try, Time.of(20, 41, 26).try, Duration.seconds(45000)).epochSeconds == 12682771886, "DateTime.of(Date.of(2371, 11, 26).try, Time.of(20, 41, 26).try, Duration.seconds(45000)).epochSeconds")
    assert(DateTime.of(Date.of(1893, 5, 12).try, Time.of(11, 14, 5).try, Duration.seconds(-28800)).epochSeconds == -2418439555, "DateTime.of(Date.of(1893, 5, 12).try, Time.of(11, 14, 5).try, Duration.seconds(-28800)).epochSeconds")
    assert(DateTime.of(Date.of(1705, 7, 11).try, Time.of(2, 37, 13).try, Duration.seconds(-36900)).epochSeconds == -8346020867, "DateTime.of(Date.of(1705, 7, 11).try, Time.of(2, 37, 13).try, Duration.seconds(-36900)).epochSeconds")
    assert(DateTime.of(Date.of(2295, 6, 30).try, Time.of(7, 46, 17).try, Duration.seconds(10800)).epochSeconds == 10271594777, "DateTime.of(Date.of(2295, 6, 30).try, Time.of(7, 46, 17).try, Duration.seconds(10800)).epochSeconds")
    assert(DateTime.of(Date.of(2217, 12, 11).try, Time.of(16, 21, 14).try, Duration.seconds(21600)).epochSeconds == 7824334874, "DateTime.of(Date.of(2217, 12, 11).try, Time.of(16, 21, 14).try, Duration.seconds(21600)).epochSeconds")
    assert(DateTime.of(Date.of(1674, 3, 3).try, Time.of(20, 16, 18).try, Duration.seconds(7200)).epochSeconds == -9335454222, "DateTime.of(Date.of(1674, 3, 3).try, Time.of(20, 16, 18).try, Duration.seconds(7200)).epochSeconds")
    assert(DateTime.of(Date.of(2330, 12, 22).try, Time.of(18, 23, 21).try, Duration.seconds(-14400)).epochSeconds == 11391229401, "DateTime.of(Date.of(2330, 12, 22).try, Time.of(18, 23, 21).try, Duration.seconds(-14400)).epochSeconds")
    assert(DateTime.of(Date.of(1645, 11, 25).try, Time.of(0, 57, 16).try, Duration.zero()).epochSeconds == -10227596564, "DateTime.of(Date.of(1645, 11, 25).try, Time.of(0, 57, 16).try, Duration.zero()).epochSeconds")
    assert(DateTime.of(Date.of(2210, 10, 8).try, Time.of(1, 45, 27).try, Duration.seconds(-900)).epochSeconds == 7597850427, "DateTime.of(Date.of(2210, 10, 8).try, Time.of(1, 45, 27).try, Duration.seconds(-900)).epochSeconds")
    assert(DateTime.of(Date.of(1755, 6, 18).try, Time.of(22, 52, 16).try, Duration.seconds(-19800)).epochSeconds == -6770115464, "DateTime.of(Date.of(1755, 6, 18).try, Time.of(22, 52, 16).try, Duration.seconds(-19800)).epochSeconds")
    assert(DateTime.of(Date.of(1735, 8, 11).try, Time.of(2, 49, 34).try, Duration.seconds(28800)).epochSeconds == -7396722626, "DateTime.of(Date.of(1735, 8, 11).try, Time.of(2, 49, 34).try, Duration.seconds(28800)).epochSeconds")
