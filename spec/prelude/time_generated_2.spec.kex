  it("renders instants back into civil datetimes") do
    assert(DateTime.fromEpochSeconds(-1168269209, Duration.seconds(43200)).iso == "1932-12-24T20:46:31+12:00", "DateTime.fromEpochSeconds(-1168269209, Duration.seconds(43200)).iso")
    assert(DateTime.fromEpochSeconds(9696351512, Duration.seconds(20700)).iso == "2277-04-07T12:43:32+05:45", "DateTime.fromEpochSeconds(9696351512, Duration.seconds(20700)).iso")
