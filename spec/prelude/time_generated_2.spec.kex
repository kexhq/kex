    assert((-23).months.iso == "P-23M", "(-23).months.iso")
    assert((-23).years.iso == "P-23Y", "(-23).years.iso")
    assert(19.months.iso == "P19M", "19.months.iso")
    assert(19.years.iso == "P19Y", "19.years.iso")
    assert((-19).months.iso == "P-19M", "(-19).months.iso")
    assert((-19).years.iso == "P-19Y", "(-19).years.iso")
    assert((-18).months.iso == "P-18M", "(-18).months.iso")
    assert((-18).years.iso == "P-18Y", "(-18).years.iso")
    assert((-13).months.iso == "P-13M", "(-13).months.iso")
    assert((-13).years.iso == "P-13Y", "(-13).years.iso")
    assert(8.months.iso == "P8M", "8.months.iso")
    assert(8.years.iso == "P8Y", "8.years.iso")
    assert(12.months.iso == "P12M", "12.months.iso")
    assert(12.years.iso == "P12Y", "12.years.iso")
    assert(20.months.iso == "P20M", "20.months.iso")
    assert(20.years.iso == "P20Y", "20.years.iso")
    assert(18.months.iso == "P18M", "18.months.iso")
    assert(18.years.iso == "P18Y", "18.years.iso")
    assert(9.months.iso == "P9M", "9.months.iso")
    assert(9.years.iso == "P9Y", "9.years.iso")
    assert(23.months.iso == "P23M", "23.months.iso")
    assert(23.years.iso == "P23Y", "23.years.iso")
    assert(8.months.iso == "P8M", "8.months.iso")
    assert(8.years.iso == "P8Y", "8.years.iso")
    assert((-5).months.iso == "P-5M", "(-5).months.iso")
    assert((-5).years.iso == "P-5Y", "(-5).years.iso")
    assert(22.months.iso == "P22M", "22.months.iso")
    assert(22.years.iso == "P22Y", "22.years.iso")
  end

