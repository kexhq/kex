  it("builds periods from Integer") do
    assert((-10).months.iso == "P-10M", "(-10).months.iso")
    assert((-10).years.iso == "P-10Y", "(-10).years.iso")
    assert((-4).months.iso == "P-4M", "(-4).months.iso")
    assert((-4).years.iso == "P-4Y", "(-4).years.iso")
