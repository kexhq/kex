  it("adds and subtracts a Period") do
    assert((Date.of(1694, 8, 3).try + Period.of(0, -23, -16)).iso == "1692-08-18", "(Date.of(1694, 8, 3).try + Period.of(0, -23, -16)).iso")
    assert((Date.of(1694, 8, 3).try - Period.of(0, -23, -16)).iso == "1696-07-19", "(Date.of(1694, 8, 3).try - Period.of(0, -23, -16)).iso")
    assert((Date.of(1732, 5, 23).try + Period.of(-1, -29, -28)).iso == "1728-11-25", "(Date.of(1732, 5, 23).try + Period.of(-1, -29, -28)).iso")
    assert((Date.of(1732, 5, 23).try - Period.of(-1, -29, -28)).iso == "1735-11-20", "(Date.of(1732, 5, 23).try - Period.of(-1, -29, -28)).iso")
    assert((Date.of(2082, 10, 21).try + Period.of(-4, -27, 34)).iso == "2076-08-24", "(Date.of(2082, 10, 21).try + Period.of(-4, -27, 34)).iso")
    assert((Date.of(2082, 10, 21).try - Period.of(-4, -27, 34)).iso == "2088-12-18", "(Date.of(2082, 10, 21).try - Period.of(-4, -27, 34)).iso")
