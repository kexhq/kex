    assert(Date.of(1804, 10, 28).try.monthsUntil(Date.of(2095, 12, 4).try) == 3493, "Date.of(1804, 10, 28).try.monthsUntil(Date.of(2095, 12, 4).try)")
    assert(Date.of(1804, 10, 28).try.yearsUntil(Date.of(2095, 12, 4).try) == 291, "Date.of(1804, 10, 28).try.yearsUntil(Date.of(2095, 12, 4).try)")
  end

  it("does not count a partial month") do
    assert(Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 2, 28).try) == 1, "Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 2, 28).try)")
    assert(Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 2, 28).try) == 0, "Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 2, 28).try)")
    assert(Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 3, 1).try) == 1, "Date.of(2026, 1, 31).try.monthsUntil(Date.of(2026, 3, 1).try)")
    assert(Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 3, 1).try) == 0, "Date.of(2026, 1, 31).try.yearsUntil(Date.of(2026, 3, 1).try)")
    assert(Date.of(2026, 1, 15).try.monthsUntil(Date.of(2026, 2, 15).try) == 1, "Date.of(2026, 1, 15).try.monthsUntil(Date.of(2026, 2, 15).try)")
    assert(Date.of(2026, 1, 15).try.yearsUntil(Date.of(2026, 2, 15).try) == 0, "Date.of(2026, 1, 15).try.yearsUntil(Date.of(2026, 2, 15).try)")
    assert(Date.of(2026, 2, 28).try.monthsUntil(Date.of(2026, 1, 31).try) == -1, "Date.of(2026, 2, 28).try.monthsUntil(Date.of(2026, 1, 31).try)")
    assert(Date.of(2026, 2, 28).try.yearsUntil(Date.of(2026, 1, 31).try) == 0, "Date.of(2026, 2, 28).try.yearsUntil(Date.of(2026, 1, 31).try)")
    assert(Date.of(2026, 1, 1).try.monthsUntil(Date.of(2026, 12, 31).try) == 11, "Date.of(2026, 1, 1).try.monthsUntil(Date.of(2026, 12, 31).try)")
    assert(Date.of(2026, 1, 1).try.yearsUntil(Date.of(2026, 12, 31).try) == 0, "Date.of(2026, 1, 1).try.yearsUntil(Date.of(2026, 12, 31).try)")
    assert(Date.of(2026, 12, 31).try.monthsUntil(Date.of(2026, 1, 1).try) == -11, "Date.of(2026, 12, 31).try.monthsUntil(Date.of(2026, 1, 1).try)")
    assert(Date.of(2026, 12, 31).try.yearsUntil(Date.of(2026, 1, 1).try) == 0, "Date.of(2026, 12, 31).try.yearsUntil(Date.of(2026, 1, 1).try)")
  end

end

describe("fractional seconds (vs Ruby)") do
  it("renders only the digits it needs") do
    assert(Time.of(1, 25, 57, 706513949).try.iso == "01:25:57.706513949", "Time.of(1, 25, 57, 706513949).try.iso")
    assert(Time.of(4, 38, 9, 0).try.iso == "04:38:09", "Time.of(4, 38, 9, 0).try.iso")
    assert(Time.of(7, 2, 26, 201525103).try.iso == "07:02:26.201525103", "Time.of(7, 2, 26, 201525103).try.iso")
    assert(Time.of(13, 40, 52, 502912000).try.iso == "13:40:52.502912", "Time.of(13, 40, 52, 502912000).try.iso")
    assert(Time.of(16, 18, 23, 0).try.iso == "16:18:23", "Time.of(16, 18, 23, 0).try.iso")
    assert(Time.of(13, 14, 45, 598309340).try.iso == "13:14:45.598309340", "Time.of(13, 14, 45, 598309340).try.iso")
    assert(Time.of(8, 17, 42, 955000000).try.iso == "08:17:42.955", "Time.of(8, 17, 42, 955000000).try.iso")
    assert(Time.of(11, 17, 55, 155348742).try.iso == "11:17:55.155348742", "Time.of(11, 17, 55, 155348742).try.iso")
    assert(Time.of(10, 3, 38, 311518000).try.iso == "10:03:38.311518", "Time.of(10, 3, 38, 311518000).try.iso")
    assert(Time.of(4, 4, 33, 400142000).try.iso == "04:04:33.400142", "Time.of(4, 4, 33, 400142000).try.iso")
    assert(Time.of(13, 7, 20, 338000000).try.iso == "13:07:20.338", "Time.of(13, 7, 20, 338000000).try.iso")
    assert(Time.of(13, 53, 51, 50102506).try.iso == "13:53:51.050102506", "Time.of(13, 53, 51, 50102506).try.iso")
    assert(Time.of(15, 10, 24, 443305000).try.iso == "15:10:24.443305", "Time.of(15, 10, 24, 443305000).try.iso")
    assert(Time.of(2, 59, 44, 540674000).try.iso == "02:59:44.540674", "Time.of(2, 59, 44, 540674000).try.iso")
    assert(Time.of(12, 37, 32, 273923000).try.iso == "12:37:32.273923", "Time.of(12, 37, 32, 273923000).try.iso")
    assert(Time.of(12, 50, 0, 939467000).try.iso == "12:50:00.939467", "Time.of(12, 50, 0, 939467000).try.iso")
    assert(Time.of(16, 42, 44, 801977000).try.iso == "16:42:44.801977", "Time.of(16, 42, 44, 801977000).try.iso")
    assert(Time.of(20, 28, 50, 33146091).try.iso == "20:28:50.033146091", "Time.of(20, 28, 50, 33146091).try.iso")
    assert(Time.of(18, 5, 28, 363000000).try.iso == "18:05:28.363", "Time.of(18, 5, 28, 363000000).try.iso")
    assert(Time.of(21, 35, 57, 0).try.iso == "21:35:57", "Time.of(21, 35, 57, 0).try.iso")
    assert(Time.of(19, 16, 19, 317000000).try.iso == "19:16:19.317", "Time.of(19, 16, 19, 317000000).try.iso")
    assert(Time.of(3, 0, 36, 589379266).try.iso == "03:00:36.589379266", "Time.of(3, 0, 36, 589379266).try.iso")
    assert(Time.of(12, 36, 50, 0).try.iso == "12:36:50", "Time.of(12, 36, 50, 0).try.iso")
    assert(Time.of(13, 59, 30, 977584261).try.iso == "13:59:30.977584261", "Time.of(13, 59, 30, 977584261).try.iso")
    assert(Time.of(3, 35, 45, 267389000).try.iso == "03:35:45.267389", "Time.of(3, 35, 45, 267389000).try.iso")
    assert(Time.of(13, 36, 11, 878048805).try.iso == "13:36:11.878048805", "Time.of(13, 36, 11, 878048805).try.iso")
    assert(Time.of(22, 25, 28, 317332192).try.iso == "22:25:28.317332192", "Time.of(22, 25, 28, 317332192).try.iso")
    assert(Time.of(18, 12, 59, 521000000).try.iso == "18:12:59.521", "Time.of(18, 12, 59, 521000000).try.iso")
    assert(Time.of(3, 56, 8, 248617000).try.iso == "03:56:08.248617", "Time.of(3, 56, 8, 248617000).try.iso")
    assert(Time.of(3, 46, 51, 0).try.iso == "03:46:51", "Time.of(3, 46, 51, 0).try.iso")
    assert(Time.of(1, 12, 58, 853127134).try.iso == "01:12:58.853127134", "Time.of(1, 12, 58, 853127134).try.iso")
    assert(Time.of(22, 32, 0, 972676000).try.iso == "22:32:00.972676", "Time.of(22, 32, 0, 972676000).try.iso")
    assert(Time.of(12, 22, 35, 456560031).try.iso == "12:22:35.456560031", "Time.of(12, 22, 35, 456560031).try.iso")
    assert(Time.of(13, 7, 38, 765013591).try.iso == "13:07:38.765013591", "Time.of(13, 7, 38, 765013591).try.iso")
    assert(Time.of(17, 57, 49, 178464000).try.iso == "17:57:49.178464", "Time.of(17, 57, 49, 178464000).try.iso")
    assert(Time.of(3, 45, 29, 0).try.iso == "03:45:29", "Time.of(3, 45, 29, 0).try.iso")
    assert(Time.of(22, 3, 54, 975457974).try.iso == "22:03:54.975457974", "Time.of(22, 3, 54, 975457974).try.iso")
    assert(Time.of(6, 50, 15, 0).try.iso == "06:50:15", "Time.of(6, 50, 15, 0).try.iso")
    assert(Time.of(1, 46, 5, 166584000).try.iso == "01:46:05.166584", "Time.of(1, 46, 5, 166584000).try.iso")
    assert(Time.of(2, 21, 9, 0).try.iso == "02:21:09", "Time.of(2, 21, 9, 0).try.iso")
  end

  it("round-trips through parse") do
    assert(Time.parse("14:34:26.959189").try.iso == "14:34:26.959189", "Time.parse(\"14:34:26.959189\").try.iso")
    assert(Time.parse("14:34:26.959189").try.nanosecond == 959189000, "Time.parse(\"14:34:26.959189\").try.nanosecond")
