    assert(Date.of(2068, 12, 6).try.monthsUntil(Date.of(2135, 12, 9).try) == 804, "Date.of(2068, 12, 6).try.monthsUntil(Date.of(2135, 12, 9).try)")
    assert(Date.of(2068, 12, 6).try.yearsUntil(Date.of(2135, 12, 9).try) == 67, "Date.of(2068, 12, 6).try.yearsUntil(Date.of(2135, 12, 9).try)")
