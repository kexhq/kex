  it("wraps within the day and keeps the nanosecond (part 2/2)") do
    assert((Time.of(16, 4, 34, 179984191).try - Duration.seconds(-73813)).iso == "12:34:47.179984191", "(Time.of(16, 4, 34, 179984191).try - Duration.seconds(-73813)).iso")
    assert(Time.of(16, 4, 34, 179984191).try.addSeconds(73813).iso == "12:34:47.179984191", "Time.of(16, 4, 34, 179984191).try.addSeconds(73813).iso")
    assert((Time.of(0, 7, 34, 971919998).try + Duration.seconds(144506)).iso == "16:16:00.971919998", "(Time.of(0, 7, 34, 971919998).try + Duration.seconds(144506)).iso")
    assert((Time.of(0, 7, 34, 971919998).try - Duration.seconds(-144506)).iso == "16:16:00.971919998", "(Time.of(0, 7, 34, 971919998).try - Duration.seconds(-144506)).iso")
    assert(Time.of(0, 7, 34, 971919998).try.addSeconds(144506).iso == "16:16:00.971919998", "Time.of(0, 7, 34, 971919998).try.addSeconds(144506).iso")
    assert((Time.of(10, 58, 49, 211186586).try + Duration.seconds(-80211)).iso == "12:41:58.211186586", "(Time.of(10, 58, 49, 211186586).try + Duration.seconds(-80211)).iso")
    assert((Time.of(10, 58, 49, 211186586).try - Duration.seconds(80211)).iso == "12:41:58.211186586", "(Time.of(10, 58, 49, 211186586).try - Duration.seconds(80211)).iso")
    assert(Time.of(10, 58, 49, 211186586).try.addSeconds((-80211)).iso == "12:41:58.211186586", "Time.of(10, 58, 49, 211186586).try.addSeconds((-80211)).iso")
    assert((Time.of(17, 1, 33, 608000000).try + Duration.seconds(-155269)).iso == "21:53:44.608", "(Time.of(17, 1, 33, 608000000).try + Duration.seconds(-155269)).iso")
    assert((Time.of(17, 1, 33, 608000000).try - Duration.seconds(155269)).iso == "21:53:44.608", "(Time.of(17, 1, 33, 608000000).try - Duration.seconds(155269)).iso")
    assert(Time.of(17, 1, 33, 608000000).try.addSeconds((-155269)).iso == "21:53:44.608", "Time.of(17, 1, 33, 608000000).try.addSeconds((-155269)).iso")
    assert((Time.of(16, 25, 25, 0).try + Duration.seconds(154006)).iso == "11:12:11", "(Time.of(16, 25, 25, 0).try + Duration.seconds(154006)).iso")
    assert((Time.of(16, 25, 25, 0).try - Duration.seconds(-154006)).iso == "11:12:11", "(Time.of(16, 25, 25, 0).try - Duration.seconds(-154006)).iso")
    assert(Time.of(16, 25, 25, 0).try.addSeconds(154006).iso == "11:12:11", "Time.of(16, 25, 25, 0).try.addSeconds(154006).iso")
    assert((Time.of(5, 4, 12, 0).try + Duration.seconds(-125174)).iso == "18:17:58", "(Time.of(5, 4, 12, 0).try + Duration.seconds(-125174)).iso")
    assert((Time.of(5, 4, 12, 0).try - Duration.seconds(125174)).iso == "18:17:58", "(Time.of(5, 4, 12, 0).try - Duration.seconds(125174)).iso")
    assert(Time.of(5, 4, 12, 0).try.addSeconds((-125174)).iso == "18:17:58", "Time.of(5, 4, 12, 0).try.addSeconds((-125174)).iso")
