describe("calendar distance (vs Ruby)") do
  it("counts whole months and years between dates") do
    assert(Date.of(2384, 10, 7).try.monthsUntil(Date.of(2185, 4, 14).try) == -2393, "Date.of(2384, 10, 7).try.monthsUntil(Date.of(2185, 4, 14).try)")
    assert(Date.of(2384, 10, 7).try.yearsUntil(Date.of(2185, 4, 14).try) == -199, "Date.of(2384, 10, 7).try.yearsUntil(Date.of(2185, 4, 14).try)")
    assert(Date.of(2335, 10, 30).try.monthsUntil(Date.of(1837, 3, 16).try) == -5983, "Date.of(2335, 10, 30).try.monthsUntil(Date.of(1837, 3, 16).try)")
    assert(Date.of(2335, 10, 30).try.yearsUntil(Date.of(1837, 3, 16).try) == -498, "Date.of(2335, 10, 30).try.yearsUntil(Date.of(1837, 3, 16).try)")
    assert(Date.of(2345, 3, 23).try.monthsUntil(Date.of(2381, 2, 23).try) == 431, "Date.of(2345, 3, 23).try.monthsUntil(Date.of(2381, 2, 23).try)")
    assert(Date.of(2345, 3, 23).try.yearsUntil(Date.of(2381, 2, 23).try) == 35, "Date.of(2345, 3, 23).try.yearsUntil(Date.of(2381, 2, 23).try)")
    assert(Date.of(1674, 11, 17).try.monthsUntil(Date.of(1855, 6, 4).try) == 2166, "Date.of(1674, 11, 17).try.monthsUntil(Date.of(1855, 6, 4).try)")
    assert(Date.of(1674, 11, 17).try.yearsUntil(Date.of(1855, 6, 4).try) == 180, "Date.of(1674, 11, 17).try.yearsUntil(Date.of(1855, 6, 4).try)")
    assert(Date.of(2237, 12, 10).try.monthsUntil(Date.of(2170, 1, 13).try) == -814, "Date.of(2237, 12, 10).try.monthsUntil(Date.of(2170, 1, 13).try)")
