describe("time of day arithmetic (vs Ruby)") do
  it("wraps within the day and keeps the nanosecond (part 1/2)") do
    assert((Time.of(10, 9, 26, 280000000).try + Duration.seconds(-41375)).iso == "22:39:51.280", "(Time.of(10, 9, 26, 280000000).try + Duration.seconds(-41375)).iso")
    assert((Time.of(10, 9, 26, 280000000).try - Duration.seconds(41375)).iso == "22:39:51.280", "(Time.of(10, 9, 26, 280000000).try - Duration.seconds(41375)).iso")
