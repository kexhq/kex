# kex: no-check

describe("Integer — predicates") do
  it("even? returns true for even numbers") do
    assert(0.even?)
    assert(2.even?)
    assert(4.even?)
    assert(!1.even?)
    assert(!3.even?)
  end

  it("odd? returns true for odd numbers") do
    assert(1.odd?)
    assert(3.odd?)
    assert(!0.odd?)
    assert(!2.odd?)
  end
end

describe("Integer — abs") do
  it("abs returns the absolute value") do
    assert(5.abs == 5)
    assert((-5).abs == 5)
    assert(0.abs == 0)
  end
end

describe("Integer — sqrt") do
  it("sqrt returns the square root as a Float") do
    assert(16.sqrt == 4.0)
    assert(0.sqrt == 0.0)
    assert(1.sqrt == 1.0)
  end
end

describe("Integer — modulo") do
  it("modulo returns the remainder") do
    assert(7.modulo(3) == 1)
    assert(10.modulo(5) == 0)
    assert(1.modulo(2) == 1)
  end
end

describe("Integer — in?") do
  it("in? checks membership in a range") do
    assert(5.in?(1..10))
    assert(1.in?(1..10))
    assert(10.in?(1..10))
    assert(!11.in?(1..10))
    assert(!0.in?(1..10))
  end
end

describe("Integer — times") do
  it("times calls the block n times") do
    var total = 0
    3.times { |i| total = total + i }
    assert(total == 3)
  end

  it("0.times does not call the block") do
    var called = false
    0.times { |_| called = true }
    assert(!called)
  end
end

describe("Integer — to") do
  it("to(Float) converts an integer") do
    assert(42.to(Float) == Just(42.0))
  end

  it("to(String) converts an integer") do
    assert(42.to(String) == Just("42"))
  end
end

describe("Float — abs") do
  it("abs returns the absolute value") do
    assert((-3.14).abs == 3.14)
    assert(3.14.abs == 3.14)
    assert(0.0.abs == 0.0)
  end
end

describe("Float — sqrt") do
  it("sqrt returns the square root") do
    assert(25.0.sqrt == 5.0)
    assert(0.0.sqrt == 0.0)
  end
end

describe("Float — to") do
  it("to(Integer) converts a float") do
    assert(3.9.to(Integer) == Just(3))
  end

  it("to(String) converts a float") do
    assert(3.14.to(String) == Just("3.14"))
  end
end

describe("Integer.parse and Float.parse") do
  it("Integer.parse succeeds on valid input") do
    assert(Integer.parse("42") == Ok(42))
    assert(Integer.parse("42").ok?)
    assert(Integer.parse("42").or(0) == 42)
  end

  it("Integer.parse fails on non-numeric input") do
    assert(Integer.parse("abc").error?)
    # The payload is a ParseError record, so match it to reach the message.
    match Integer.parse("abc") do
      Error(e) => assert(e.message == "invalid integer")
      Ok(v) => assert(false, "expected Error, got ${v}")
    end
    # `none?` is Optional's; a Result crosses over with optional.
    assert(Integer.parse("abc").optional.none?)
  end

  it("Integer.parse works in if let") do
    if let Ok(i) = Integer.parse("42")
      assert(i == 42)
    else
      assert(false, "expected Ok")
    end

    if let Error(_) = Integer.parse("not a number")
      assert(true)
    else
      assert(false, "expected Error")
    end
  end

  it("Float.parse succeeds on valid input") do
    assert(Float.parse("1134.11") == Ok(1134.11))
    assert(Float.parse("3.14").ok?)
    assert(Float.parse("3.14").or(0.0) == 3.14)
  end

  it("Float.parse works in if let") do
    if let Ok(f) = Float.parse("2.718")
      assert(f == 2.718)
    else
      assert(false, "expected Ok")
    end

    if let Error(_) = Float.parse("not a number")
      assert(true)
    else
      assert(false, "expected Error")
    end
  end

  it("Float.parse fails on non-numeric input") do
    assert(Float.parse("xyz").error?)
  end

  it("to(String) shows what a parse result carries, not the wrapper") do
    # `to(String)` goes through Showable, and Result implements it the way
    # Optional does: showing a result shows its payload. What `parse` RETURNS
    # is unchanged — the wrapper is still there to match on, as below.
    assert(Integer.parse("42").to(String) == Just("42"))
    assert(Float.parse("3.5").to(String) == Just("3.5"))

    # Still a Result, so the failure is still matchable and still carries its
    # reason. This is why `parse` exists next to `to`.
    match Float.parse("xyz") do
      Error(e) => assert(e.message == "invalid float")
      Ok(v) => assert(false, "expected Error, got ${v}")
    end
  end

  it("to(String) converts the parsed number itself") do
    assert(Integer.parse("42").or(0).to(String) == Just("42"))
    assert(Float.parse("3.5").or(0.0).to(String) == Just("3.5"))
    assert(255.to(String, radix: 16) == Just("ff"))
  end

  it("Integer.parsePrefix parses leading integer") do
    match Integer.parsePrefix("42abc") do
      Just((n, rest)) => do
        assert(n == 42)
        assert(rest == "abc")
      end
      None => assert(false, "expected Just")
    end
  end

  it("Integer.parsePrefix returns None when no digits") do
    assert(Integer.parsePrefix("abc") == None)
  end
end

describe("Number.parse") do
  it("keeps integer input as an Integer") do
    assert(Number.parse("42").or(0) == 42)
  end

  it("falls back to Float input") do
    assert(Number.parse("3.14").or(0.0) == 3.14)
  end

  it("fails on non-numeric input") do
    assert(Number.parse("nope").error?)
  end
end

describe("Integer — floor, ceil, round") do
  it("floor is identity on integers") do
    assert(5.floor == 5)
    assert((-3).floor == -3)
    assert(0.floor == 0)
  end

  it("ceil is identity on integers") do
    assert(5.ceil == 5)
    assert((-3).ceil == -3)
  end

  it("round is identity on integers") do
    assert(5.round == 5)
    assert((-3).round == -3)
  end
end

describe("Integer — negative modulo") do
  it("modulo with negative dividend yields positive result") do
    assert((-7).modulo(3) == 2)
    assert((-1).modulo(5) == 4)
  end
end

describe("Float — floor, ceil, round") do
  it("floor returns greatest integer <= self") do
    assert(3.7.floor == 3)
    assert(3.0.floor == 3)
    assert((-1.5).floor == -2)
  end

  it("ceil returns smallest integer >= self") do
    assert(3.2.ceil == 4)
    assert(3.0.ceil == 3)
    assert((-1.5).ceil == -1)
  end

  it("round rounds to nearest integer") do
    assert(3.7.round == 4)
    assert(3.2.round == 3)
    assert((-1.5).round == -2)
  end
end

describe("Float.parsePrefix") do
  it("Float.parsePrefix parses leading float") do
    match Float.parsePrefix("3.14abc") do
      Just((f, rest)) => do
        assert(f == 3.14)
        assert(rest == "abc")
      end
      None => assert(false, "expected Just")
    end
  end

  it("Float.parsePrefix returns None when no digits") do
    assert(Float.parsePrefix("abc") == None)
  end
end
