# kex: no-check

describe("Char — predicates") do
  it("digit? returns true for digits") do
    assert('0'.digit?)
    assert('5'.digit?)
    assert('9'.digit?)
    assert(!'a'.digit?)
    assert(!' '.digit?)
  end

  it("alpha? returns true for letters") do
    assert('a'.alpha?)
    assert('Z'.alpha?)
    assert(!'3'.alpha?)
    assert(!' '.alpha?)
  end

  it("space? returns true for whitespace") do
    assert(' '.space?)
    assert(!('a'.space?))
    assert(!('1'.space?))
  end
end

describe("Char — case conversion") do
  it("upperCase and lowerCase preserve Char") do
    assert('a'.upperCase == 'A')
    assert('Z'.lowerCase == 'z')
  end

  it("case conversion works as a String mapping callback") do
    assert("aBc".mapChars(&.upperCase) == "ABC")
    assert("AbC".mapChars(&.lowerCase) == "abc")
  end

  it("map collects into a list, mapChars keeps the String") do
    assert("aBc".map(&.upperCase) == ['A', 'B', 'C'])
    assert("aBc".mapChars(&.upperCase) == "ABC")
  end
end

describe("Char — in?") do
  it("in? checks membership in a char range") do
    assert('b'.in?('a'..'z'))
    assert('a'.in?('a'..'z'))
    assert('z'.in?('a'..'z'))
    assert(!('B'.in?('a'..'z')))
    assert(!('0'.in?('a'..'z')))
  end
end

describe("Char — codepoint") do
  it("returns the Unicode codepoint") do
    assert('A'.codepoint == 65)
    assert('0'.codepoint == 48)
    assert('\n'.codepoint == 10)
  end
end
