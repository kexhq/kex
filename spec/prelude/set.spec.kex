describe("Set — construction") do
  it("from discards duplicates") do
    assert(Set.from([3, 1, 2, 3, 1]).count == 3)
  end

  it("from sorts the elements") do
    assert(Set.from([3, 1, 2]).items == [1, 2, 3])
  end

  it("from accepts an empty list") do
    assert(Set.from([]).empty?)
  end

  it("empty is the empty set") do
    assert(Set.empty.empty?)
    assert(Set.empty.count == 0)
  end

  it("works for strings and chars, not just numbers") do
    assert(Set.from(["pear", "apple", "pear"]).items == ["apple", "pear"])
    assert(Set.from("hello".chars).items == ['e', 'h', 'l', 'o'])
  end

  it("compares elements structurally, like map keys") do
    assert(Set.from([(1, 2), (1, 2), (3, 4)]).count == 2)
  end
end

describe("Set — membership and size") do
  it("contains? finds a member") do
    assert(Set.from([1, 2, 3]).contains?(2))
  end

  it("contains? rejects a non-member") do
    assert(!Set.from([1, 2, 3]).contains?(9))
  end

  it("empty? is true only for the empty set") do
    assert(Set.from([]).empty?)
    assert(!Set.from([1]).empty?)
  end

  it("blank? follows empty?") do
    assert(Set.from([]).blank?)
    assert(!Set.from([1]).blank?)
  end
end

describe("Set — add and delete") do
  it("add inserts a new element in sorted position") do
    assert(Set.from([1, 3]).add(2).items == [1, 2, 3])
  end

  it("add is a no-op for an existing element") do
    assert(Set.from([1, 2]).add(2).items == [1, 2])
  end

  it("delete removes a member") do
    assert(Set.from([1, 2, 3]).delete(2).items == [1, 3])
  end

  it("delete is a no-op for a non-member") do
    assert(Set.from([1, 2]).delete(9).items == [1, 2])
  end

  it("add leaves the receiver alone") do
    let s = Set.from([1])
    let bigger = s.add(2)
    assert(s.items == [1])
    assert(bigger.items == [1, 2])
  end
end

describe("Set — algebra") do
  it("union keeps every element of either side") do
    assert(Set.from([1, 2]).union(Set.from([2, 3])).items == [1, 2, 3])
  end

  it("intersect keeps only shared elements") do
    assert(Set.from([1, 2, 3]).intersect(Set.from([2, 3, 4])).items == [2, 3])
  end

  it("intersect of disjoint sets is empty") do
    assert(Set.from([1]).intersect(Set.from([2])).empty?)
  end

  it("difference drops what the other side has") do
    assert(Set.from([1, 2, 3]).difference(Set.from([2])).items == [1, 3])
  end

  it("symmetricDifference keeps what exactly one side has") do
    let d = Set.from([1, 2]).symmetricDifference(Set.from([2, 3]))
    assert(d.items == [1, 3])
  end

  it("subset? and superset? are duals") do
    let small = Set.from([1, 2])
    let big = Set.from([1, 2, 3])
    assert(small.subset?(big))
    assert(big.superset?(small))
    assert(!big.subset?(small))
  end

  it("a set is its own subset and superset") do
    let s = Set.from([1, 2])
    assert(s.subset?(s))
    assert(s.superset?(s))
  end

  it("disjoint? is true only with no shared element") do
    assert(Set.from([1, 2]).disjoint?(Set.from([3, 4])))
    assert(!Set.from([1, 2]).disjoint?(Set.from([2, 3])))
  end
end

describe("Set — operators") do
  it("+ unions two sets") do
    assert((Set.from([1, 2]) + Set.from([2, 3])).items == [1, 2, 3])
  end

  it("+ takes a plain list") do
    assert((Set.from([1, 2]) + [3, 3]).items == [1, 2, 3])
  end

  it("- removes another set") do
    assert((Set.from([1, 2, 3]) - Set.from([2])).items == [1, 3])
  end

  it("- takes a plain list") do
    assert((Set.from([1, 2, 3]) - [2, 9]).items == [1, 3])
  end

  it("== is membership, not construction order") do
    assert(Set.from([1, 2, 3]) == Set.from([3, 2, 1, 3]))
    assert(!(Set.from([1, 2]) == Set.from([1, 2, 3])))
  end
end

describe("Set — higher-order operations") do
  it("map answers with a set") do
    assert(Set.from([1, 2, 3]).map { |x| x * 2 }.items == [2, 4, 6])
  end

  it("map collapses elements that collide") do
    assert(Set.from([1, -1, 2]).map { |x| x.abs }.items == [1, 2])
  end

  it("filter keeps what the predicate accepts") do
    assert(Set.from([1, 2, 3]).filter { |x| x > 1 }.items == [2, 3])
  end

  it("reject drops what the predicate accepts") do
    assert(Set.from([1, 2, 3]).reject { |x| x > 1 }.items == [1])
  end

  it("reduce folds in ascending order") do
    assert(Set.from([3, 1, 2]).reduce("") { |acc, x| "${acc}${x}" } == "123")
  end

  it("Foldable queries come for free") do
    let s = Set.from([1, 2, 3])
    assert(s.any? { |x| x > 2 })
    assert(s.all? { |x| x > 0 })
  end

  it("combine is union, and identity is the empty set") do
    let s = Set.from([1, 2])
    assert(s.combine(Set.from([3])).items == [1, 2, 3])
    assert(s.combine(Set.empty) == s)
  end
end

describe("Set — display") do
  it("shows as Set(...) in element order") do
    assert("${Set.from([3, 1, 2])}" == "Set(1, 2, 3)")
  end

  it("shows the empty set with no elements") do
    assert("${Set.empty}" == "Set()")
  end
end

describe("UnorderedSet — construction and membership") do
  it("from discards duplicates") do
    assert(UnorderedSet.from([3, 1, 2, 3, 1]).count == 3)
  end

  it("empty is the empty set") do
    assert(UnorderedSet.empty.empty?)
  end

  it("contains? finds a member") do
    assert(UnorderedSet.from([1, 2, 3]).contains?(2))
    assert(!UnorderedSet.from([1, 2, 3]).contains?(9))
  end

  # Iteration order is deliberately unspecified, so every test that looks at
  # the elements sorts them first.
  it("items holds every element") do
    assert(UnorderedSet.from([3, 1, 2]).items.sort == [1, 2, 3])
  end

  it("blank? follows empty?") do
    assert(UnorderedSet.from([]).blank?)
    assert(!UnorderedSet.from([1]).blank?)
  end
end

describe("UnorderedSet — add and delete") do
  it("add inserts a new element") do
    assert(UnorderedSet.from([1]).add(2).items.sort == [1, 2])
  end

  it("add is a no-op for an existing element") do
    assert(UnorderedSet.from([1, 2]).add(2).count == 2)
  end

  it("delete removes a member") do
    assert(UnorderedSet.from([1, 2, 3]).delete(2).items.sort == [1, 3])
  end

  it("delete is a no-op for a non-member") do
    assert(UnorderedSet.from([1, 2]).delete(9).count == 2)
  end
end

describe("UnorderedSet — algebra") do
  it("union keeps every element of either side") do
    let u = UnorderedSet.from([1, 2]).union(UnorderedSet.from([2, 3]))
    assert(u.items.sort == [1, 2, 3])
  end

  it("intersect keeps only shared elements") do
    let u = UnorderedSet.from([1, 2, 3]).intersect(UnorderedSet.from([2, 3, 4]))
    assert(u.items.sort == [2, 3])
  end

  it("difference drops what the other side has") do
    let u = UnorderedSet.from([1, 2, 3]).difference(UnorderedSet.from([2]))
    assert(u.items.sort == [1, 3])
  end

  it("symmetricDifference keeps what exactly one side has") do
    let u = UnorderedSet.from([1, 2]).symmetricDifference(UnorderedSet.from([2, 3]))
    assert(u.items.sort == [1, 3])
  end

  it("subset?, superset? and disjoint?") do
    let small = UnorderedSet.from([1, 2])
    let big = UnorderedSet.from([1, 2, 3])
    assert(small.subset?(big))
    assert(big.superset?(small))
    assert(small.disjoint?(UnorderedSet.from([9])))
    assert(!small.disjoint?(big))
  end
end

describe("UnorderedSet — operators and equality") do
  it("+ unions with a set or a list") do
    assert((UnorderedSet.from([1]) + UnorderedSet.from([2])).items.sort == [1, 2])
    assert((UnorderedSet.from([1]) + [2, 2]).items.sort == [1, 2])
  end

  it("- removes a set or a list") do
    assert((UnorderedSet.from([1, 2, 3]) - UnorderedSet.from([2])).items.sort == [1, 3])
    assert((UnorderedSet.from([1, 2, 3]) - [2]).items.sort == [1, 3])
  end

  it("== is membership, not insertion order") do
    assert(UnorderedSet.from([1, 2, 3]) == UnorderedSet.from([3, 2, 1]))
    assert(!(UnorderedSet.from([1, 2]) == UnorderedSet.from([1, 2, 3])))
  end
end

describe("UnorderedSet — higher-order operations") do
  it("map answers with a set") do
    assert(UnorderedSet.from([1, 2, 3]).map { |x| x * 2 }.items.sort == [2, 4, 6])
  end

  it("map collapses elements that collide") do
    assert(UnorderedSet.from([1, -1, 2]).map { |x| x.abs }.count == 2)
  end

  it("filter and reject") do
    assert(UnorderedSet.from([1, 2, 3]).filter { |x| x > 1 }.items.sort == [2, 3])
    assert(UnorderedSet.from([1, 2, 3]).reject { |x| x > 1 }.items.sort == [1])
  end

  it("combine is union, and identity is the empty set") do
    let u = UnorderedSet.from([1, 2])
    assert(u.combine(UnorderedSet.from([3])).items.sort == [1, 2, 3])
    assert(u.combine(UnorderedSet.empty) == u)
  end

  it("shows as UnorderedSet(...) in sorted order") do
    assert("${UnorderedSet.from([3, 1, 2])}" == "UnorderedSet(1, 2, 3)")
  end
end
