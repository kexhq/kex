# kex: interpreter-only
# These assert what the TREE-WALKER reports about itself — `Kex.BACKEND`,
# `Kex.interpreted?`, and which features it has. Running them through `-R`
# would assert the walker's answers against BEAM's, so `spec-prelude-beam`
# skips this file; spec/backend_predicates_beam.kex is its BEAM counterpart.
describe("Kex.BACKEND") do
  it("returns Interpreter on the tree-walk backend") do
    assert(Kex.BACKEND == Kex.Interpreter)
  end

  it("reports the backend through predicates") do
    assert(Kex.interpreted?)
    assert(Kex.underBeam? == false)
  end
end

describe("Kex.Feature.has?") do
  it("returns true for FS") do
    assert(Kex.Feature.has?(Kex.FS))
  end

  it("returns false for Process on interpreter") do
    assert(Kex.Feature.has?(Kex.Process) == false)
  end

end

describe("Kex.Feature.list") do
  it("returns a list of available features") do
    let features = Kex.Feature.list()
    assert(features.length() >= 1)
  end

  it("includes FS on interpreter") do
    assert(Kex.Feature.list().contains?(Kex.FS))
  end

end
