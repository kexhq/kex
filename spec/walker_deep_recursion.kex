# kex: interpreter-only
# kex: skip-beam
# kex: skip-wasm
# The tree-walker runs each process on a fixed stack: recursion deep enough
# to reach its end is a runtime error, not a crash. (The BEAM grows its
# process stacks, so this recursion simply finishes there. Under wasm the
# engine's own call stack runs out before the fiber's does, and Node aborts
# before the guard can see it.)

let down(n: Integer) -> Integer = n == 0 then 0 else 1 + down(n - 1)

main do
  IO.printLine(down(1000))
  IO.printLine(down(10_000_000))
end
