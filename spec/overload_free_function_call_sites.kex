# Dispatch has to hold wherever the call is written, not just at a literal
# argument in `main`: through a variable, a nested call, a UFCS receiver, a
# lambda, and from inside another function of the same file.
#
# The original defect picked the target from DECLARATION order, so every one of
# these reached `speak(Cat)` (docs/issue-free-function-overloads.md).
record Cat do
  name : String
end

record Dog do
  name : String
end

speak : Cat -> String
let speak(c) = "meow ${c.name}"

speak : Dog -> String
let speak(d) = "woof ${d.name}"

announce : Cat -> String
let announce(c) = "cat: ${speak(c)}"

announce : Dog -> String
let announce(d) = "dog: ${speak(d)}"

let adopt(name) = Dog { name: name }

main do
  let pet = Dog { name: "rex" }
  IO.printLine(speak(pet))
  IO.printLine(speak(adopt("fido")))
  IO.printLine(pet.speak)
  IO.printLine(announce(Cat { name: "tom" }))
  IO.printLine(announce(pet))
  let describe = { |d| speak(d) }
  IO.printLine(describe(pet))
  IO.printLine([Cat { name: "a" }].map({ |c| speak(c) }).first.or("none"))
end
