let add(a, b) = a + b
let multiply(a, b) = a * b
let greet(greeting, name) = "${greeting}, ${name}!"
let triple(n) = n * 3
let describe(name: String, loud: Bool) -> String do
  return "HI ${name}!" if loud
  return "hi ${name}"
end
let banner() -> String do
  "hi"
end

module Outer do
  module Inner do
    module Deep do
      let shout(s) = s.upperCase
      let add(a, b) = a + b
    end
  end
end

main do
  # partial application of named functions
  let inc = ~add(1)
  IO.printLine(inc(5))
  IO.printLine(inc(10))

  let double = ~multiply(2)
  IO.printLine(double(7))
  IO.printLine([1, 2, 3].map(~multiply(10)))

  # placeholder for explicit arg positioning
  let sub5 = ~(-)(_, 5)
  IO.printLine(sub5(20))

  let div2 = ~(/)(_, 2)
  IO.printLine(div2(10))

  # operators as binary functions
  let sum = [1, 2, 3, 4, 5].reduce(0, ~(+))
  IO.printLine(sum)

  let product = [1, 2, 3, 4, 5].reduce(1, ~(*))
  IO.printLine(product)

  # chained — fully applied inline
  IO.printLine(~(+)(2)(3))
  IO.printLine(~add(3)(4))

  # strings
  let hello = ~greet("Hello")
  IO.printLine(hello("Alice"))
  IO.printLine(hello("Bob"))

  # bare capture — `~f` with no argument group is just `f`
  IO.printLine([1, 2, 3, 4].filter(~even?))
  IO.printLine([1, 2, 3].map(~triple))

  # comparison and logical operators
  IO.printLine([3, 1, 2].filter(~(<=)(_, 2)))
  IO.printLine([1, 2, 2].filter(~(==)(2)))
  IO.printLine([true, true, true].reduce(true, ~(&&)))
  IO.printLine([false, false, true].reduce(false, ~(||)))

  # `!` is the unary capture — `-` in this position stays binary subtraction
  IO.printLine([true, false].map(~(!)))
  IO.printLine(~(!)(false))

  # module-qualified capture
  IO.printLine(["x", "y"].map(~String.upperCase))
  ["a", "b"].each(~IO.printLine)

  # nested submodules, bare and partially applied
  IO.printLine(["hi"].map(~Outer.Inner.Deep.shout))
  IO.printLine([1, 2].map(~Outer.Inner.Deep.add(10)))
  IO.printLine(~Outer.Inner.Deep.add(3)(4))

  # named-arg call through a bare `~name` capture must match by NAME, not by
  # the call site's written order (kexhq/kex#309)
  let f = ~describe
  IO.printLine(f(name: "Ada", loud: true))
  IO.printLine(f(loud: false, name: "Bea"))

  # a bare `~name` on a zero-arg function is the function VALUE, never an
  # auto-call of it (kexhq/kex#312)
  let thunk = ~banner
  IO.printLine(thunk())
end
