# kex: check-only
# A trait's function names vouch for a call only on a receiver that may
# implement the trait (kexhq/kex#738). `message` is Errorable's, and the
# prelude's ParseError implements it; a Result is neither, so `r.message` is
# refused.
# It checked clean, then died with `if_clause` on BEAM.

main do
  let r : Result<Integer, String> = Ok(1)
  let m : Integer = r.message
  IO.print(m)
end
