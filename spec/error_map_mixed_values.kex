# kex: check-only
# A map literal of values of several types is a map of their union, as a
# list of several types is: `{ "ada": 36, "bob": "old" }` is a
# `{String: Integer | String}`, so reading `"bob"` as an Integer is an error
# (docs/typechecker-hm-plan.md, decision 3). It took the type of its first
# entry, so it was a `{String: Integer}` holding a String, and then a map of
# `Any`, which still let the read through. And the functions on a map
# (declared in `make Map<K, V>`) bound neither `K` nor `V` from a `{K: V}`
# receiver, so any key or value went in (kexhq/kex#771).

main do
  let ages = { "ada": 36, "bob": "old" }
  let bob: Integer = ages.get("bob").or(0)
  IO.printLine(bob)
  let m: {String: Integer} = { "a": 1 }
  IO.printLine(m.put("bob", "old"))
  IO.printLine(m.get(7))
  IO.printLine(m.has?(7))
  IO.printLine(m.merge({ "b": "x" }))
  IO.printLine(m.put("b", 2))
  IO.printLine(m.merge({ "c": 3 }))
  IO.printLine({ "a": 1, "b": 2 })
end
