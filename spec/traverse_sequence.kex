# `Algebra.traverse` and `Algebra.sequence`, written once over Applicable: every result
# gathered, or what the container makes of the failures (None, the first
# Error, every Validation failure). A generic function of the program's own
# takes its container from what the call answers, as the stdlib's does.

let checked(n: Integer) -> Validation<Integer, String> do
  return n > 0 then Valid(n) else Invalid(["${n} is not positive"])
end

let gather(F is Applicable => xs: [A], f: A -> F<B>) -> F<[B]> do
  return xs.reduce(F.wrap([])) do |gathered, x|
    gathered.with(f(x)) { |done, item| done + [item] }
  end
end

main do
  IO.printLine(Algebra.traverse(["1", "2"]) { |s| s.to(Integer) }.inspected)
  IO.printLine(Algebra.traverse(["1", "x"]) { |s| s.to(Integer) }.inspected)
  IO.printLine(Algebra.sequence([Ok(1), Ok(2)]).inspected)
  IO.printLine(Algebra.sequence([Ok(1), Error("no")]).inspected)
  IO.printLine(Algebra.traverse([1, -2, -3]) { |n| checked(n) }.inspected)
  IO.printLine(Algebra.traverse([1, 2]) { |n| checked(n) }.inspected)
  IO.printLine(gather(["3", "4"]) { |s| s.to(Integer) }.inspected)
  IO.printLine(gather([1, -1]) { |n| checked(n) }.inspected)
end
