# Constructors/constants for a record live in a MODULE of the same name:
# `Temperature.Fahrenheit(...)` is an ordinary qualified call, and instance
# methods still come from `make`.
# The namespacing half (bare `Fahrenheit` is not in scope) is asserted in
# spec/error_record_module_bare_ctor.kex.
record Temperature do
  celsius : Float
end

module Temperature do
  let Fahrenheit(value: Float) -> Temperature do
    return Temperature { celsius: (value - 32.0) * 5.0 / 9.0 }
  end

  let Freezing = Temperature { celsius: 0.0 }
end

make Temperature do
  let to(String) -> String? do
    return Just("${@celsius}C")
  end
end

main do
  IO.printLine(Temperature.Fahrenheit(212.0).to(String).or(""))
  IO.printLine(Temperature.Freezing.to(String).or(""))
end
