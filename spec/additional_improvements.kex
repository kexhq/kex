# Spec: parse answers Result<T, ParseError<T>>, one case per reason.
#
# Run: ./build/kex spec/additional_improvements.kex

# full match one-liner
let Ok(n) = Integer.parse("42")
assert(n == 42, "parse full match")

# trailing: the number read, and what follows it as written
match Integer.parse("12ab") do
  Error(Trailing(value, rest)) => do
    assert(value == 12, "parse trailing value")
    assert(rest == "ab", "parse trailing rest")
  end
  _ => assert(false, "parse trailing — expected Trailing")
end

# a number off the front of the text
match Integer.parse("6 USD") do
  Error(Trailing(value, unit)) => do
    assert(value == 6, "Trailing value")
    assert(unit.trim == "USD", "Trailing rest")
  end
  _ => assert(false, "expected Trailing")
end

# invalid: where a digit was expected
assert(Integer.parse("abc") == Error(NoDigits(0)), "parse invalid")
assert(Integer.parse("-x") == Error(NoDigits(1)), "parse invalid after a sign")

# Float
let Ok(f) = Float.parse("3.14")
assert(f > 3.13, "Float.parse Ok")
assert(Float.parse("xyz") == Error(NoDigits(0)), "Float.parse invalid")

# Number.parse — int-first, float fallback
let Ok(ni) = Number.parse("42")
assert(ni == 42, "Number.parse int")

let Ok(nf) = Number.parse("3.14")
assert(nf > 3.13, "Number.parse float")

main do
  IO.printLine("passed")
end
