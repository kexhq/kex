# kex: check-only
# A record is built with braces. Called like a function, it was accepted with
# any arguments, and neither backend could run it.
record Point do
  x : Integer
  y : Integer
end

main do
  let p = Point(x: 1, y: 2)
  let q = Point(z: "no")
  IO.printLine(Point { x: 1, y: 2 }.x)
end
