# `Mock.Env` and `Mock.Response` — ready-made stand-ins for the `ENV` and
# `Http` capabilities (kexhq/kex#143). `Mock.Files` is spec'd separately.
#
# The functions under test declare no dependency and thread nothing: their
# `ENV.get` and `Http.get` calls are written exactly as in production.

foul configHome() -> String = ENV.get("XDG_CONFIG_HOME", "${ENV.get("HOME", "?")}/.config")
foul fetchBody(url: String) -> String = match Http.get(url) do
  Ok(response) => response.body
  Error(_)     => "(failed)"
end

main do
  with ENV = Mock.Env { vars: {"HOME": "/fake/home"} } do
    IO.printLine(configHome())
    IO.printLine(ENV.get("HOME"))
    IO.printLine(ENV.count)
    IO.printLine(ENV.keys.sort.join(","))

    # PATH is always set in a real process. Absence is an answer programs act
    # on, so a stand-in has to be able to produce it.
    IO.printLine(ENV.has?("PATH"))
    IO.printLine(ENV.get("PATH", "absent"))
  end

  # `onGet` answers by rule rather than from a fixture, and `None` still means
  # unset — so a callback can model absence too.
  with ENV = Mock.Env { onGet: Just({ |name| name.startsWith?("KEX_") then Just("on") else None }) } do
    IO.printLine(ENV.get("KEX_FEATURE", "off"))
    IO.printLine(ENV.get("OTHER", "off"))
    IO.printLine(ENV.has?("KEX_FEATURE"))
  end

  # One canned response answers every verb, with and without options.
  with Http = Mock.Response { status: 201, body: "created" } do
    IO.printLine(fetchBody("https://example.invalid/ping"))
    IO.printLine(Http.post("u", "b").map { |r| r.status })
    IO.printLine(Http.put("u", "b").map { |r| r.status })
    IO.printLine(Http.delete("u").map { |r| r.status })
    IO.printLine(Http.head("u").map { |r| r.status })
    IO.printLine(Http.get("u", HttpOptions { timeout: 1 }).map { |r| r.status })
    IO.printLine(Http.get("u").map { |r| r.headers.count })
  end

  with Http = Mock.Response { status: 200, body: "", headers: {"ETag": "abc"} } do
    IO.printLine(Http.get("u").map { |r| r.headers.get("ETag") })
  end

  # Outside the region the real environment is back, and a Map method whose
  # name a stand-in also uses still behaves (`get`, `put`, `count`).
  IO.printLine(ENV.has?("NOTHING_IS_SET_TO_THIS"))
  IO.printLine({"a": 1}.put("b", 2).count)
end
