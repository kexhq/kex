# Kex modules calling Erlang modules and vice versa
# kex: run-beam
# kex: no-check

module MyList do
  let double_all(xs) = xs.map { |x| x * 2 }

  let sorted(xs) = BEAM.lists.sort(xs)

  let reversed(xs) = BEAM.lists.reverse(xs)

  let sum(xs) = BEAM.lists.foldl({ |x, acc| acc + x }, 0, xs)
end

module MyMath do
  let hypotenuse(a, b) = BEAM.math.sqrt(a * a + b * b)

  let clamp(x, lo, hi) = BEAM.erlang.min(BEAM.erlang.max(x, lo), hi)
end

main do
  let xs = [5, 3, 1, 4, 2]

  IO.printLine(MyList.double_all(xs).to(String).or(""))
  IO.printLine(MyList.sorted(xs).to(String).or(""))
  IO.printLine(MyList.reversed(xs).to(String).or(""))
  IO.printLine(MyList.sum(xs).to(String).or(""))

  IO.printLine(MyMath.hypotenuse(3.0, 4.0).to(String).or(""))
  IO.printLine(MyMath.clamp(15, 0, 10).to(String).or(""))
  IO.printLine(MyMath.clamp(-5, 0, 10).to(String).or(""))
  IO.printLine(MyMath.clamp(5, 0, 10).to(String).or(""))
end
