# `using M do ... end` at top level runs its body
# with the imports scoped to it. Bodies run first, in file order —
# elaboration-time code, before any main-phase steps — on both
# backends. BEAM used to drop these bodies while the walker ran them. The
# file has no `main`: beside one, a top-level body is a second entry point.
# In a module body one is an error (error_using_body_in_module).
module M do
  let answer() = 42
end

IO.printLine("bare before")

using M do
  IO.printLine("top using body")
  IO.printLine(answer())
end

IO.printLine("bare after")
