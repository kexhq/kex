# A pure function may not capture a foul one with `~`: whatever it is handed
# to runs it, so `quiet` printed `a` (#640). A direct call was refused already.
foul shout(s: String) -> String do
  IO.printLine(s)
  s
end

let quiet(xs: [String]) -> [String] = xs.map(~shout)

main do
  IO.printLine("${quiet(["a"])}")
end
