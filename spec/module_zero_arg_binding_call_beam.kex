# kex: run-beam
# A module-scoped `let name = <closure>` — a plain value binding, not a
# `let name(params) = ...` function definition — called with arguments both
# from WITHIN its own module and QUALIFIED from outside it. Found via
# kexhq/rodolfo's report of a follow-up to kexhq/kex#385:
# `Template.html(Kex.embed(...))` bound to a separate name and called from a
# sibling function compiled fine but failed to link — `undefined function
# 'M.render'/1` — because `zeroArgFns`/`topLevelConstants` (which drive the
# "evaluate the thunk, then apply" call shape) only ever collect from a
# file's own top level; the identical declaration one level down, inside
# `module M do ... end`, was invisible to that check and fell through to an
# ordinary direct call at the wrong arity, since only the thunk itself
# (arity 0) was ever emitted. The qualified `M.render(x)` spelling from
# OUTSIDE the module hit the identical gap in a separate code path (the
# "user module function" branch of `lowerMethodCall`, not
# `lowerFunctionCall`). The interpreter never hit either shape — it resolves
# calls dynamically rather than by declared arity — so both are BEAM-only.
module Greet do
  let hello = do |name| "Hello, ${name}!" end

  greetBoth : String -> String -> String
  let greetBoth(a, b) = "${hello(a)} ${hello(b)}"
end

main do
  IO.printLine(Greet.greetBoth("Ada", "Grace"))
  IO.printLine(Greet.hello("Marie"))
end
