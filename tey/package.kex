package "tey" do
  description("Yet another manager, Kex's default package manager.")
  version("0.2.0")
  kex(">= 0.3.0")
  license("MIT")
  entrypoint("src/main.kex")
  target("tey")

  # Tey's own command, which is also the working example of the feature.
  command("check", run: "make check",
          description: "Type-check the sources without running them")
end
