KEX ?= ../build/kex
PREFIX ?= /usr/local
BINDIR ?= $(PREFIX)/bin
LIBDIR ?= $(PREFIX)/lib/kex/tey
EBIN := ebin

# The .beam files below are produced by whichever `erlc` kex finds on PATH, and
# a BEAM file cannot be loaded by an older runtime than the one that built it.
# Bake the sibling `erl` into bin/tey so the launcher can never end up on a
# different OTP than the compiler was (see the comment in bin/tey).
ERL ?= $(shell dir=$$(dirname "$$(command -v erlc 2>/dev/null || echo erlc)"); \
         if [ -x "$$dir/erl" ]; then echo "$$dir/erl"; else command -v erl; fi)

# Tey's own version, declared once in package.kex and read back out here. The
# alternative is a second copy in the source that `tey --version` prints, and a
# second copy is a copy that goes stale — 0.1.1 was already two hand-kept
# numbers before this. The generated module below is what carries it into the
# compiled binary; the release workflow greps this same line for the archive
# name, so the manifest is the one place the number lives.
TEY_VERSION := $(shell sed -n 's/^ *version("\([^"]*\)").*/\1/p' package.kex)
VERSION_SOURCE := src/tey/version.kex

.PHONY: build install clean

# Regenerated whenever package.kex changes, and written only when the contents
# would differ so an unchanged version does not force a recompile.
$(VERSION_SOURCE): package.kex Makefile
	@printf '%s\n' \
	  '# GENERATED by tey/Makefile from tey/package.kex — do not edit.' \
	  'module Tey.Version' \
	  '' \
	  "# Tey's own version, as declared by package.kex's version(...) line." \
	  'let number -> String do' \
	  '  return "$(TEY_VERSION)"' \
	  'end' > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

build: $(VERSION_SOURCE)
	mkdir -p $(EBIN)
	$(KEX) --compile -o $(EBIN) src/main.kex

install: build
	install -d $(DESTDIR)$(LIBDIR)/ebin $(DESTDIR)$(BINDIR)
	install -m 644 $(EBIN)/*.beam $(DESTDIR)$(LIBDIR)/ebin/
	sed 's|@ERL@|$(ERL)|' bin/tey > $(EBIN)/tey.launcher
	install -m 755 $(EBIN)/tey.launcher $(DESTDIR)$(BINDIR)/tey
	# The `kex` command ships with Tey and dispatches to the toolchain Tey
	# selected, so `kex` works wherever `tey` does — see bin/kex.
	install -m 755 bin/kex $(DESTDIR)$(BINDIR)/kex

clean:
	rm -rf $(EBIN) $(VERSION_SOURCE)
