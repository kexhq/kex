module Tey.Manifest

using Kex.AST

type DependencySource =
  | WorkspaceSource
  | GitSource(String, String, String, String)
  | PathSource(String)

record Dependency do
  manifestName : String
  manifestSource : DependencySource
  manifestGroups : [String] = []
end

record ManifestWorkspace do
  memberPatterns : [String] = []
end

record LocalOverride do
  localName : String
  localPath : String
end

record Target do
  name : String
  entrypoint : String
end

record PluginCapability do
  capabilityKind : String
  capabilityValues : [String] = []
end

record PluginOption do
  optionName : String
  optionType : String
end

record PluginOperation do
  operationName : String
  operationEntrypoint : String
  operationOptions : [PluginOption] = []
end

record Plugin do
  pluginNamespace : String
  pluginTeyRequirement : String
  pluginCapabilities : [PluginCapability] = []
  pluginCommands : [PluginOperation] = []
  pluginGenerators : [PluginOperation] = []
end

# A project-specific command, run as `tey <name>`. Without these every package
# grows a Makefile or a bin/ script beside package.kex for "the way you run the
# linter", which the manifest — the one file a newcomer reads — says nothing
# about.
#
# A name is one word, grouped with a colon: `db:migrate`, `assets:build`.
record Command do
  # Prefixed, like Dependency's fields, because a bare `run` field is read as
  # OptionConfig's `run` method at every call site that has not pinned the
  # receiver's type — `command.run` typechecked as "`run` expects 2 arguments,
  # got 1" — and a bare `name` loses the same way to Weekday's.
  commandName : String
  # The command line. A first word ending in `.kex` is run through the selected
  # toolchain with this package's source roots already in place; anything else
  # is handed to `sh -c`, so a pipeline or an `&&` works.
  commandRun : String
  commandDescription : String = ""
end

# A toolchain package: the compiler executable plus the runtime and standard
# library it was built with, installed together so the three can never drift
# apart. Kex's own `package.kex` is the one that declares it — and a reader
# that did not know the declaration could not run any tey command from the
# compiler's own checkout, which is where it is most used.
#
# Fields are prefixed like Command's: a bare `compiler` would be read as a
# method on an unpinned receiver before it is read as a field here.
record Toolchain do
  toolchainName : String
  toolchainCompiler : String = ""
  toolchainRuntime : String = ""
  toolchainStdlib : String = ""
end

record ManifestPackage do
  name : String
  version : String = "0.1.0"
  # One line saying what the package is for. Optional, because a manifest that
  # cannot be written until its author has phrased the sentence is a manifest
  # nobody writes — but it is what a package index or a `tey list` has to show,
  # and a name alone never says enough.
  description : String = ""
  license : String = ""
  packageKexRequirement : String = ">= 0.3.0"
  # The Erlang/OTP a package needs. Optional — absent means "no opinion" —
  # and worth setting when the package reaches for `Erlang.*` interop that
  # arrived in a particular release. The floor actually enforced is the higher
  # of this and the toolchain's own (see Tey.Toolchain.runtimeOtpFloor): a
  # package cannot ask for an OTP older than the one that compiled the runtime
  # beams it is about to load.
  packageOtpRequirement : String = ""
  entrypoint : String = "src/main.kex"
  manifestDependencies : [Dependency] = []
  targets : [Target] = []
  commands : [Command] = []
  manifestToolchain : Toolchain? = None
  manifestWorkspace : ManifestWorkspace? = None
  plugins : [Plugin] = []
end

# The command names Tey answers itself. A `command(...)` may not take one of
# them: `tey test` must mean the same thing in every checkout, so a manifest
# that tries to redefine it is an error at read time rather than a silent
# shadow. Kept here because the READER is what enforces it, and Tey.Cli cannot
# be asked: it is built on this module, so reading the list off its declared
# commands would be a cycle. The two have to be kept in step by hand — one
# `.command(...)` in Tey.Cli, one name here (the first word is enough: `kex`
# covers every `kex ...` subcommand).
let reservedCommands -> [String] do
  return ["add", "build", "clean", "docs", "help", "init", "install", "kex",
          "list", "local", "new", "run", "setup", "test", "update"]
end

# Reads a `package.kex`.
#
# The compiler parses the manifest. Tey only interprets the resulting Kex AST,
# so comments, multiline calls, strings, and future grammar fixes cannot drift
# from the language that actually compiles package.kex.
let read(text: String) -> ManifestPackage or! String do
  var name = ""
  var version = "0.1.0"
  var description = ""
  var license = ""
  var kexRequirement = ">= 0.3.0"
  var otpRequirement = ""
  var entrypoint = "src/main.kex"
  var dependencies: [Dependency] = []
  var targets: [Target] = []
  var commands: [Command] = []
  var toolchain: Toolchain? = None
  var workspace: ManifestWorkspace? = None
  var plugins: [Plugin] = []
  var failures: [String] = []

  let program = match Kex.AST.parse(text, "package.kex") do
    Ok(parsed) => parsed
    Error(error) => return Error(error.message)
  end
  let package = match Tey.Manifest.packageDeclaration(program) do
    Just(value) => value
    None => return Error("package.kex must declare package \"name\"")
  end
  let (packageName, packageBody) = package
  name = packageName

  Tey.Manifest.declarations(packageBody, "").each do |entry|
    let (expression, group) = entry
    match Tey.Manifest.call(expression) do
      Just(call) => do
      let (declaration, arguments, named, block) = call
      if declaration == "version"
        version = Tey.Manifest.argument(arguments).or(version)
      elif declaration == "description"
        description = Tey.Manifest.argument(arguments).or(description)
      elif declaration == "license"
        license = Tey.Manifest.argument(arguments).or(license)
      elif declaration == "kex"
        kexRequirement = Tey.Manifest.argument(arguments).or(kexRequirement)
      elif declaration == "otp"
        otpRequirement = Tey.Manifest.argument(arguments).or(otpRequirement)
      elif declaration == "entrypoint"
        entrypoint = Tey.Manifest.argument(arguments).or(entrypoint)
      elif declaration == "target"
      targets.push!(Target {
        name: Tey.Manifest.argument(arguments).or("default"),
        entrypoint: Tey.Manifest.named(named, "entrypoint").or(entrypoint)
      })
      ()
      elif declaration == "command"
      let commandName = Tey.Manifest.argument(arguments).or("")
      let commandRun = Tey.Manifest.named(named, "run").or("")
      if commandName == ""
        failures.push!("every command must be named")
        ()
      elif commandName.contains?(" ")
        # A name is ONE word on the command line. Grouping is spelled with a
        # colon — `db:migrate`, `assets:build` — the separator every other
        # package manager already taught people, and the one that survives a
        # shell without quoting.
        failures.push!("command `${commandName}` cannot contain a space; group with a colon, as in `db:migrate`")
        ()
      elif Tey.Manifest.reservedCommands.contains?(commandName)
        # Loud, because the alternative is `tey test` meaning something
        # different depending on which directory you are standing in.
        failures.push!("`${commandName}` is a built-in command and cannot be redeclared")
        ()
      elif commandRun == ""
        failures.push!("command `${commandName}` must declare run:")
        ()
      elif commands.any? { |existing| existing.commandName == commandName }
        failures.push!("command `${commandName}` is declared twice")
        ()
      else
        commands.push!(Command {
          commandName: commandName,
          commandRun: commandRun,
          commandDescription: Tey.Manifest.named(named, "description").or("")
        })
        ()
      end
      ()
      elif declaration == "tey"
      let dependencyName = Tey.Manifest.argument(arguments).or("")
      let dependencyGit = Tey.Manifest.named(named, "git").or("")
      let dependencyPath = Tey.Manifest.named(named, "path").or("")
      let dependencySubdir = Tey.Manifest.named(named, "subdir").or("")
      let dependencyWorkspace = Tey.Manifest.namedBool(named, "workspace")
      let sources = [dependencyGit != "", dependencyPath != "",
                     dependencyWorkspace == Just(true)]
        .filter { |present| present }.count
      if dependencyName == ""
        failures.push!("every dependency must be named")
        ()
      elif dependencyWorkspace == Just(false)
        failures.push!("workspace: must be true when present")
        ()
      elif sources != 1
        failures.push!("dependency `${dependencyName}` must choose exactly one of workspace: true, git:, or path:")
        ()
      end
      let selectors = ["tag", "branch", "ref"].filter do |name|
        Tey.Manifest.named(named, name).set?
      end
      if dependencyGit != "" && selectors.count != 1
        failures.push!("git dependency `${dependencyName}` must choose exactly one of tag:, branch:, or ref:")
        ()
      end
      if dependencyGit == "" && !selectors.empty?
        failures.push!("dependency `${dependencyName}` has a Git selector without git:")
        ()
      end
      if dependencyGit == "" && dependencySubdir != ""
        failures.push!("dependency `${dependencyName}` has subdir: without git:")
        ()
      end
      let selector = if selectors.contains?("tag")
        "tag"
      elif selectors.contains?("branch")
        "branch"
      else
        "ref"
      end
      let requested = Tey.Manifest.named(named, selector).or("")
      let groups = group == "" then [] else [group]
      let source = if dependencyWorkspace == Just(true)
        WorkspaceSource
      elif dependencyPath != ""
        PathSource(dependencyPath)
      else
        GitSource(dependencyGit, selector, requested,
                  dependencySubdir)
      end
      dependencies.push!(Dependency {
        manifestName: dependencyName,
        manifestSource: source,
        manifestGroups: groups
      })
      ()
      elif declaration == "workspace"
      workspace = match Tey.Manifest.workspaceFromBlock(block) do
        Error(error) => do
          failures.push!(error)
          None
        end
        Ok(value) => Just(value)
      end
      ()
      elif declaration == "toolchain"
      toolchain = Just(Toolchain {
        toolchainName: Tey.Manifest.argument(arguments).or("kex"),
        toolchainCompiler: Tey.Manifest.named(named, "compiler").or(""),
        toolchainRuntime: Tey.Manifest.named(named, "runtime").or(""),
        toolchainStdlib: Tey.Manifest.named(named, "stdlib").or("")
      })
      ()
      elif declaration == "plugin"
      match Tey.Manifest.pluginFrom(arguments, named, block) do
        Error(error) => do failures.push!(error) () end
        Ok(plugin) => do
          if plugins.any? { |existing| existing.pluginNamespace == plugin.pluginNamespace }
            failures.push!("plugin namespace `${plugin.pluginNamespace}` is declared twice")
            ()
          else
            plugins.push!(plugin)
            ()
          end
          ()
          ()
        end
      end
      ()
      else
      failures.push!("unknown declaration `${declaration}`")
      ()
      end
      end
      _ => do
        failures.push!("unknown declaration")
        ()
      end
    end
  end
  return Error(failures.first.try) if !failures.empty?
  return Error("package.kex must declare package \"name\"") if name == ""
  Ok(ManifestPackage { name: name, version: version, description: description, license: license,
                     packageKexRequirement: kexRequirement,
                     packageOtpRequirement: otpRequirement,
                     entrypoint: entrypoint, manifestDependencies: dependencies, targets: targets,
                     commands: commands, manifestToolchain: toolchain,
                     manifestWorkspace: workspace, plugins: plugins })
end

# Reads a virtual-workspace manifest: a package.kex whose root is `workspace`
# rather than a publishable package. Package-root workspaces are returned on
# ManifestPackage.manifestWorkspace by `read` above.
let readWorkspace(text: String) -> ManifestWorkspace or! String do
  let program = match Kex.AST.parse(text, "package.kex") do
    Ok(parsed) => parsed
    Error(error) => return Error(error.message)
  end
  match Tey.Manifest.rootCall(program) do
    Just(call) => do
      let (name, _, block) = call
      return Tey.Manifest.workspaceFromBlock(block) if name == "workspace"
      return Error("package.kex must declare package \"name\" or workspace")
    end
    _ => return Error("package.kex must declare package \"name\" or workspace")
  end
end

let readLocal(text: String) -> [LocalOverride] or! String do
  let program = match Kex.AST.parse(text, "package.local.kex") do
    Ok(parsed) => parsed
    Error(error) => return Error(error.message)
  end
  let bodies: [[Expression]] = program.items.map do |item|
    match item do
      MainDef(info) => info.body
      _ => []
    end
  end
  let empty: [Expression] = []
  let expressions = bodies.reduce(empty) { |all, body| [...all, ...body] }
  return Error("package.local.kex may only declare local overrides") if expressions.empty? && !text.trim.empty?
  var overrides: [LocalOverride] = []
  expressions.each do |expression|
    match Tey.Manifest.call(expression) do
      Just(("local", arguments, named, block)) => do
        if arguments.count != 1 || block.set?
          return Error("local overrides require exactly one package name and no block")
        end
        match Tey.Manifest.validateNamed(named, ["path"], "local override") do
          Error(error) => return Error(error)
          Ok(_) => ()
        end
        let name = Tey.Manifest.argument(arguments).or("")
        let path = Tey.Manifest.named(named, "path").or("")
        if name == "" || path == ""
          return Error("local overrides require a package name and path:")
        end
        if overrides.any? { |override| override.localName == name }
          return Error("local override `${name}` is declared twice")
        end
        overrides.push!(LocalOverride { localName: name, localPath: path })
        ()
      end
      Just((name, _, _, _)) =>
        return Error("unknown local declaration `${name}`")
      None => return Error("unknown local declaration")
    end
  end
  return Ok(overrides)
end

private do
  let packageDeclaration(program: Program) -> (String, [Expression])? do
    match program.items do
      [MainDef(info)] => if info.body.count == 1
        match info.body.first.try do
          Call(target, arguments, _, block) => match (target, block) do
            (Identifier(name), Just(Lambda(_, body, _, _))) => if name == "package"
              match Tey.Manifest.argument(arguments) do
                Just(packageName) => Just((packageName, body))
                None => None
              end
            else
              None
            end
            _ => None
          end
          _ => None
        end
      else
        None
      end
      _ => None
    end
  end

  let rootCall(program: Program) -> (String, [Expression], Expression?)? do
    match program.items do
      [MainDef(info)] => if info.body.count == 1
        match info.body.first.try do
          Call(target, arguments, _, block) => match target do
            Identifier(name) => Just((name, arguments, block))
            _ => None
          end
          _ => None
        end
      else
        None
      end
      _ => None
    end
  end

  let workspaceFromBlock(None) -> ManifestWorkspace or! String = Error("workspace requires a block")
  let workspaceFromBlock(Just(expression)) -> ManifestWorkspace or! String do
    let body = match expression do
      Lambda(_, expressions, _, _) => expressions
      _ => return Error("workspace requires a block")
    end
    return Ok(ManifestWorkspace {}) if body.empty?
    return Error("workspace declares members more than once") if body.count > 1
    let entry = body.first.try
    let call = match Tey.Manifest.call(entry) do
      Just(value) => value
      None => return Error("unknown workspace declaration")
    end
    let (name, arguments, _, _) = call
    return Error("unknown workspace declaration `${name}`") if name != "members"
    let values = match arguments do
      [list] => match list do
        ListLit(items, _) => items
        _ => return Error("members expects a list of paths")
      end
      _ => return Error("members expects a list of paths")
    end
    let patterns = values.map { |value| Tey.Manifest.stringValue(value).or("") }
    return Error("workspace members must be strings") if patterns.any? { |pattern| pattern == "" }
    return Ok(ManifestWorkspace { memberPatterns: patterns })
  end

  let pluginFrom(arguments: [Expression], named: [NamedArgument],
                 block: Expression?) -> Plugin or! String do
    return Error("plugin accepts only namespace: and tey:") if !arguments.empty?
    Tey.Manifest.validateNamed(named, ["namespace", "tey"], "plugin").try
    let namespace = Tey.Manifest.named(named, "namespace").or("")
    let requirement = Tey.Manifest.named(named, "tey").or("")
    return Error("plugin requires namespace:") if namespace == ""
    return Error("plugin `${namespace}` requires tey:") if requirement == ""
    return Error("plugin namespace `${namespace}` must be one command word") if namespace.contains?(" ") || namespace.contains?(":")
    let body = match block do
      Just(Lambda(_, expressions, _, _)) => expressions
      _ => return Error("plugin `${namespace}` requires a block")
    end
    let parsed = Tey.Manifest.pluginEntries(body, namespace, [], [], []).try
    let (capabilities, commands, generators) = parsed
    return Ok(Plugin { pluginNamespace: namespace,
                       pluginTeyRequirement: requirement,
                       pluginCapabilities: capabilities,
                       pluginCommands: commands,
                       pluginGenerators: generators })
  end

  let pluginEntries(expressions: [Expression], namespace: String,
                    capabilities: [PluginCapability], commands: [PluginOperation],
                    generators: [PluginOperation]) -> ([PluginCapability], [PluginOperation], [PluginOperation]) or! String do
    return Ok((capabilities, commands, generators)) if expressions.empty?
    let declaration = match Tey.Manifest.call(expressions.first.try) do
      Just(value) => value
      None => return Error("unknown plugin declaration in `${namespace}`")
    end
    let (name, arguments, operationNamed, operationBlock) = declaration
    if name == "capabilities"
      if !operationNamed.empty? || operationBlock.set?
        return Error("plugin `${namespace}` capabilities accepts only a list")
      end
      return Error("plugin `${namespace}` declares capabilities more than once") if !capabilities.empty?
      let values = match arguments do
        [ListLit(items, None)] => items
        _ => return Error("plugin `${namespace}` capabilities expects a list")
      end
      let parsedCapabilities = Tey.Manifest.capabilitiesFrom(values).try
      return Tey.Manifest.pluginEntries(expressions.drop(1), namespace,
                                        parsedCapabilities, commands, generators)
    end
    if name == "command" || name == "generator"
      let operation = Tey.Manifest.operationFrom(name, arguments, operationNamed,
                                                 operationBlock).try
      let existing = name == "command" then commands else generators
      return Error("plugin ${name} `${operation.operationName}` is declared twice") if existing.any? { |item| item.operationName == operation.operationName }
      let nextCommands = name == "command" then [...commands, operation] else commands
      let nextGenerators = name == "generator" then [...generators, operation] else generators
      return Tey.Manifest.pluginEntries(expressions.drop(1), namespace,
                                        capabilities, nextCommands, nextGenerators)
    end
    return Error("unknown plugin declaration `${name}` in `${namespace}`")
  end

  let capabilityFrom(expression: Expression) -> PluginCapability or! String do
    match expression do
      MethodCall(target, name, arguments, named, None, _, _, _) => do
        let prefix = Tey.Manifest.qualifiedName(target).or("")
        let kind = prefix == "" then name else "${prefix}.${name}"
        if !named.empty?
          return Error("capability `${kind}` does not accept named arguments")
        end
        let values = if arguments.empty?
          []
        else
          match arguments do
            [ListLit(items, None)] => do
              let strings = items.map { |item| Tey.Manifest.stringValue(item).or("") }
              return Error("capability `${kind}` expects string resources") if strings.any? { |value| value == "" }
              strings
            end
            _ => return Error("capability `${kind}` expects a list of string resources")
          end
        end
        let supported = ["FS.Read.package", "FS.Write.workspace",
                         "Process.Run", "Net.Connect"]
        return Error("unsupported plugin capability `${kind}`") if !supported.contains?(kind)
        let allowlisted = kind == "Process.Run" || kind == "Net.Connect"
        if allowlisted && values.empty?
          return Error("capability `${kind}` requires a non-empty resource list")
        end
        if !allowlisted && !values.empty?
          return Error("capability `${kind}` does not accept resource names")
        end
        return Ok(PluginCapability { capabilityKind: kind,
                                     capabilityValues: values })
      end
      _ => return Error("plugin capabilities must be qualified resource names")
    end
  end

  let capabilitiesFrom(expressions: [Expression]) -> [PluginCapability] or! String do
    return Ok([]) if expressions.empty?
    let first = Tey.Manifest.capabilityFrom(expressions.first.try).try
    let rest = Tey.Manifest.capabilitiesFrom(expressions.drop(1)).try
    return Ok([first, ...rest])
  end

  let operationFrom(kind: String, arguments: [Expression], named: [NamedArgument],
                    block: Expression?) -> PluginOperation or! String do
    Tey.Manifest.validateNamed(named, ["entrypoint"],
                               "plugin ${kind}").try
    if arguments.count != 1
      return Error("plugin ${kind} requires exactly one name")
    end
    let name = Tey.Manifest.argument(arguments).or("")
    let entrypoint = Tey.Manifest.named(named, "entrypoint").or("")
    return Error("plugin ${kind} must be named") if name == ""
    return Error("plugin ${kind} `${name}` must be one command word") if name.contains?(" ") || name.contains?(":")
    return Error("plugin ${kind} `${name}` requires entrypoint:") if entrypoint == ""
    if FS.Path.absolute?(entrypoint) || FS.Path.segments(entrypoint).contains?("..")
      return Error("plugin ${kind} `${name}` entrypoint must remain inside its package")
    end
    let body = match block do
      None => []
      Just(Lambda(_, expressions, _, _)) => expressions
      _ => return Error("plugin ${kind} `${name}` has an invalid block")
    end
    let options = Tey.Manifest.optionsFrom(body, kind, name, []).try
    return Ok(PluginOperation { operationName: name,
                                operationEntrypoint: entrypoint,
                                operationOptions: options })
  end

  let optionsFrom(expressions: [Expression], kind: String, operationName: String,
                  options: [PluginOption]) -> [PluginOption] or! String do
    return Ok(options) if expressions.empty?
    let call = match Tey.Manifest.call(expressions.first.try) do
      Just(value) => value
      None => return Error("plugin ${kind} `${operationName}` may only declare options")
    end
    let (declaration, optionArguments, optionNamed, optionBlock) = call
    return Error("plugin ${kind} `${operationName}` may only declare options") if declaration != "option" || optionBlock.set?
    Tey.Manifest.validateNamed(optionNamed, ["type"],
                               "plugin ${kind} `${operationName}` option").try
    if optionArguments.count != 1
      return Error("plugin ${kind} `${operationName}` option requires exactly one name")
    end
    let optionName = Tey.Manifest.argument(optionArguments).or("")
    let optionType = Tey.Manifest.namedIdentifier(optionNamed, "type").or("")
    return Error("plugin ${kind} `${operationName}` option requires a name and type:") if optionName == "" || optionType == ""
    let supportedTypes = ["String", "Integer", "Float", "Bool"]
    return Error("plugin ${kind} `${operationName}` option `${optionName}` has unsupported type `${optionType}`") if !supportedTypes.contains?(optionType)
    return Error("plugin ${kind} `${operationName}` option `${optionName}` is declared twice") if options.any? { |option| option.optionName == optionName }
    let option = PluginOption { optionName: optionName, optionType: optionType }
    return Tey.Manifest.optionsFrom(expressions.drop(1), kind, operationName,
                                    [...options, option])
  end

  let qualifiedName(Identifier(name)) -> String? = Just(name)
  let qualifiedName(MethodCall(target, name, [], [], None, _, _, _)) -> String? do
    let prefix = Tey.Manifest.qualifiedName(target).or("")
    return None if prefix == ""
    return Just("${prefix}.${name}")
  end
  let qualifiedName(_) -> String? = None

  let declarations(expressions: [Expression], group: String) -> [(Expression, String)] do
    var found: [(Expression, String)] = []
    expressions.each do |expression|
      match Tey.Manifest.call(expression) do
        Just(call) => do
          let (name, arguments, _, block) = call
          if name == "group"
            let groupName = match arguments do
              [LitAtom(value)] => Just(value)
              _ => None
            end
            let groupBody = match block do
              Just(value) => match value do
                Lambda(_, body, _, _) => Just(body)
                _ => None
              end
              None => None
            end
            match (groupName, groupBody) do
              (Just(value), Just(body)) => do
                let groupName = value
                found = found + Tey.Manifest.declarations(body, groupName)
                ()
              end
              _ => do
                found.push!((expression, group))
                ()
              end
            end
          else
            found.push!((expression, group))
            ()
          end
          ()
        end
        None => do
          found.push!((expression, group))
          ()
        end
      end
      ()
    end
    return found
  end

  let call(expression: Expression) -> (String, [Expression], [NamedArgument], Expression?)? do
    match expression do
      Call(target, arguments, named, block) => match target do
        Identifier(name) => Just((name, arguments, named, block))
        _ => None
      end
      _ => None
    end
  end

  let argument(arguments: [Expression]) -> String? do
    return None if arguments.empty?
    return Tey.Manifest.stringValue(arguments.first.try)
  end

  let named(arguments: [NamedArgument], name: String) -> String? do
    var found: String? = None
    arguments.each do |argument|
      found = Tey.Manifest.stringValue(argument.value) if argument.name == name
      ()
    end
    return found
  end

  let namedBool(arguments: [NamedArgument], name: String) -> Bool? do
    var found: Bool? = None
    arguments.each do |argument|
      if argument.name == name
        found = match argument.value do
          LitBool(value) => Just(value)
          _ => None
        end
      end
      ()
    end
    return found
  end


  let namedIdentifier(arguments: [NamedArgument], name: String) -> String? do
    var found: String? = None
    arguments.each do |argument|
      if argument.name == name
        found = match argument.value do
          Identifier(value) => Just(value)
          _ => None
        end
      end
      ()
    end
    return found
  end

  let validateNamed(arguments: [NamedArgument], allowed: [String],
                    context: String) -> Void or! String do
    let unknown = arguments.find { |argument| !allowed.contains?(argument.name) }
    match unknown do
      Just(argument) => return Error("${context} does not accept ${argument.name}:")
      None => ()
    end
    let duplicate = arguments.find do |argument|
      arguments.filter { |candidate| candidate.name == argument.name }.count > 1
    end
    match duplicate do
      Just(argument) => return Error("${context} declares ${argument.name}: more than once")
      None => return Ok(())
    end
  end

  let stringValue(expression: Expression) -> String? = match expression do
    LitString(value) => Just(value)
    InterpolatedString([value], []) => Just(value)
    _ => None
  end
end
