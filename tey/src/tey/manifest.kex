module Tey.Manifest

record Dependency do
  manifestName : String
  manifestGit : String
  manifestSelector : String
  manifestRequested : String
  manifestGroups : [String] = []
end

record Target do
  name : String
  entrypoint : String
end

record ManifestPackage do
  name : String
  version : String = "0.1.0"
  # One line saying what the package is for. Optional, because a manifest that
  # cannot be written until its author has phrased the sentence is a manifest
  # nobody writes — but it is what a package index or a `tey list` has to show,
  # and a name alone never says enough.
  description : String = ""
  license : String = ""
  packageKexRequirement : String = ">= 0.3.0"
  # The Erlang/OTP a package needs. Optional — absent means "no opinion" —
  # and worth setting when the package reaches for `Erlang.*` interop that
  # arrived in a particular release. The floor actually enforced is the higher
  # of this and the toolchain's own (see Tey.Toolchain.runtimeOtpFloor): a
  # package cannot ask for an OTP older than the one that compiled the runtime
  # beams it is about to load.
  packageOtpRequirement : String = ""
  entrypoint : String = "src/main.kex"
  manifestDependencies : [Dependency] = []
  targets : [Target] = []
end

# Reads a `package.kex`.
#
# Still a line reader rather than a grammar — see docs/tey-limitations.md —
# but a strict one: it knows which line each declaration came from, joins a
# declaration whose arguments span several lines, and refuses a declaration
# it does not recognize instead of skipping it.
let read(text: String) -> ManifestPackage or! String do
  var name = ""
  var version = "0.1.0"
  var description = ""
  var license = ""
  var kexRequirement = ">= 0.3.0"
  var otpRequirement = ""
  var entrypoint = "src/main.kex"
  var dependencies: [Dependency] = []
  var targets: [Target] = []
  var group = ""
  var failure = ""

  Tey.Manifest.statements(text).each do |statement|
    let (number, line) = statement
    if line.startsWith?("bundle ")
      name = Tey.Manifest.quoted(line).or("")
    elif line.startsWith?("version(")
      version = Tey.Manifest.quoted(line).or(version)
    elif line.startsWith?("description(")
      description = Tey.Manifest.quoted(line).or(description)
    elif line.startsWith?("license(")
      license = Tey.Manifest.quoted(line).or(license)
    elif line.startsWith?("kex(")
      kexRequirement = Tey.Manifest.quoted(line).or(kexRequirement)
    elif line.startsWith?("otp(")
      otpRequirement = Tey.Manifest.quoted(line).or(otpRequirement)
    elif line.startsWith?("entrypoint(")
      entrypoint = Tey.Manifest.quoted(line).or(entrypoint)
    elif line.startsWith?("group ")
      group = line.split(":").second.or("").split(" ").first.or("")
    elif line == "end"
      # Closes the group it is in, or the bundle itself.
      group = ""
    elif line.startsWith?("target(")
      targets.push!(Target {
        name: Tey.Manifest.quoted(line).or("default"),
        entrypoint: Tey.Manifest.attribute(line, "entrypoint").or(entrypoint)
      })
      ()
    elif line.startsWith?("tey(")
      var selector = "ref"
      if line.contains?("tag:")
        selector = "tag"
      elif line.contains?("branch:")
        selector = "branch"
      end
      let requested = Tey.Manifest.attribute(line, selector).or("HEAD")
      let groups = group == "" then [] else [group]
      dependencies.push!(Dependency {
        manifestName: Tey.Manifest.quoted(line).or(""),
        manifestGit: Tey.Manifest.attribute(line, "git").or(""),
        manifestSelector: selector,
        manifestRequested: requested,
        manifestGroups: groups
      })
      ()
    else
      # A line nobody recognizes is a mistake, not a comment. Reporting the
      # FIRST one keeps the message about the manifest rather than about the
      # cascade a typo causes.
      if failure == ""
        failure = "line ${number}: unknown declaration `${Tey.Manifest.head(line)}`"
      end
    end
  end
  return Error(failure) if failure != ""
  return Error("package.kex must declare bundle \"name\"") if name == ""
  return Error("every dependency must declare a git URL") if dependencies.any? { |dep| dep.manifestGit == "" || dep.manifestName == "" }
  Ok(ManifestPackage { name: name, version: version, description: description, license: license,
                    packageKexRequirement: kexRequirement,
                    packageOtpRequirement: otpRequirement,
                    entrypoint: entrypoint, manifestDependencies: dependencies, targets: targets })
end

private do
  # The declarations to read, each with the line it started on. Blank lines
  # and comments are dropped; a declaration whose parentheses are still open
  # continues onto the next line, so an argument list may be written across
  # several.
  let statements(text: String) -> [(Integer, String)] do
    var found: [(Integer, String)] = []
    var pending = ""
    var startedAt = 0
    var number = 0
    text.lines.each do |raw|
      number = number + 1
      # Comments come off BEFORE anything counts parentheses or looks for a
      # keyword. A manifest is Kex rather than JSON precisely so it can carry
      # comments, and they have to be allowed everywhere a reader would put
      # one — including after a declaration, and inside one spread over
      # several lines. Leaving them in made `version("0.1.0")  # (see docs`
      # unbalanced, so the reader swallowed every following declaration and
      # reported nothing: the manifest simply lost its dependencies.
      let line = Tey.Manifest.stripComment(raw).trim
      if pending == ""
        if !line.empty?
          pending = line
          startedAt = number
        end
      else
        pending = "${pending} ${line}"
      end
      if pending != "" && Tey.Manifest.balanced?(pending)
        found.push!((startedAt, pending))
        pending = ""
      end
      ()
    end
    # An unclosed declaration is still worth reporting, and the reader below
    # will reject it by name rather than lose it silently.
    if pending != ""
      found.push!((startedAt, pending))
      ()
    end
    return found
  end

  # Everything before the first unquoted `#`. A `#` INSIDE a string is part of
  # the string — `description("C# on the BEAM")` is a description, not a
  # truncated one — so this tracks quoting rather than searching for the
  # character.
  let stripComment(line: String) -> String do
    var kept: [Char] = []
    var quoted? = false
    var done? = false
    line.chars.each do |c|
      if !done?
        if c == '#' && !quoted?
          done? = true
        else
          quoted? = !quoted? if c == '"'
          kept.push!(c)
          ()
        end
      end
      ()
    end
    return kept.join("")
  end

  let balanced?(line: String) -> Bool do
    var depth = 0
    var quoted? = false
    line.chars.each do |c|
      if c == '"'
        quoted? = !quoted?
      elif !quoted?
        depth = depth + 1 if c == '('
        depth = depth - 1 if c == ')'
      end
      ()
    end
    return depth <= 0
  end

  # The leading word of a declaration, for naming it in an error.
  let head(line: String) -> String do
    let letters = line.chars.takeWhile { |c| c.letter? || c == '_' }
    return letters.empty? then line else letters.join("")
  end

  let quoted(line: String) -> String? = line.split("\"").second

  let attribute(line: String, key: String) -> String? do
    let parts = line.split("${key}: \"")
    match parts.second do
      Just(rest) => rest.split("\"").first
      None => None
    end
  end
end