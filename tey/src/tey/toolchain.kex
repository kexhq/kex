module Tey.Toolchain

using Tey.Cache, only: [root]
using Tey.Git, only: [execute]

# What the selected compiler reports about itself through +kex --info+.
#
# The version here can differ from +Kex.VERSION+, which names the compiler
# that built Tey itself: a project may select a newer or older compiler.
record ToolchainInfo do
  version : String
  reportedRuntimeOtpFloor : Integer? = None
end

foul home -> String do
  let userHome = ENV.get("HOME", ".")
  ENV.get("TEY_HOME", "${userHome}/.local/share/tey")
end

# Returns the Git repository Tey reads Kex releases from. +TEY_KEX_REPO+
# overrides it, for a fork or a mirror.
foul repository -> String do
  return ENV.get("TEY_KEX_REPO", "https://github.com/kexhq/kex.git")
end

# Returns the directory holding the +kex+ shim. A user puts it on PATH once,
# and +tey kex use+ repoints the shim inside it.
foul binDirectory -> String do
  return "${Tey.Toolchain.home}/bin"
end

foul shimPath -> String do
  return "${Tey.Toolchain.binDirectory}/kex"
end

# Returns the version +tey kex use+ last selected, or +None+.
foul selected -> String? do
  match FS.File.read("${Tey.Toolchain.home}/current") do
    Error(_) => return None
    Ok(text) => do
      let name = text.trim
      return name.empty? then None else Just(name)
    end
  end
end

# Returns the versions installed under the Tey home, newest first.
#
# Leftover staging directories and directories without a +bin/kex+ are not
# listed.
foul installedVersions -> [String] do
  let entries = FS.Directory.directories("${Tey.Toolchain.home}/toolchains").or([])
  let names = entries.filter do |name|
    (!name.endsWith?(".partial") && !name.endsWith?(".previous")
      && !name.endsWith?(".unpacked") && Tey.Toolchain.installed?(name))
  end
  return Tey.Toolchain.newestFirst(names)
end

# Returns the path of an installed version's +bin/kex+.
foul binaryOf(version: String) -> String do
  return "${Tey.Toolchain.home}/toolchains/${version}/bin/kex"
end

foul installed?(version: String) -> Bool do
  return FS.File.file?(Tey.Toolchain.binaryOf(version))
end

# Returns the +ebin+ directory of the Tey released with a Kex version, the
# same path +bin/tey+ reads.
#
# It sits beside the toolchain, not inside it, because reinstalling a Kex
# replaces the toolchain's whole directory and a Tey running from there would
# lose its modules.
foul pairedTeyEbin(version: String) -> String do
  return "${Tey.Toolchain.home}/tey/${version}/ebin"
end

# Returns the released versions, newest first, read from the repository's
# tags. Tags that are not versions are skipped.
foul availableVersions -> [String] or! String do
  match Tey.Git.tags(Tey.Toolchain.repository) do
    Error(error) => return Error(error)
    Ok(names) => do
      let versions = names.collect do |tag|
        Tey.Toolchain.versionOf(tag)
      end
      return Ok(Tey.Toolchain.newestFirst(versions))
    end
  end
end

let newestFirst(versions: [String]) -> [String] do
  return Tey.Semver.newestFirst(versions)
end

# Returns the newest stable release, which +tey kex install+ picks when no
# version is given. Pre-releases are left out.
foul latestStable -> String or! String do
  let available = Tey.Toolchain.availableVersions.try
  match available.filter { |version| Tey.Semver.stable?(version) }.first do
    Just(version) => return Ok(version)
    None => return Error("no released Kex version is available")
  end
end

# Returns the newest release including pre-releases, which
# +tey kex install --pre+ picks. Before a stable release exists, this may be
# the only way to get one without knowing its number.
foul latestIncludingPreReleases -> String or! String do
  let available = Tey.Toolchain.availableVersions.try
  match available.first do
    Just(version) => return Ok(version)
    None => return Error("no Kex version is available")
  end
end

foul installedKex -> String? do
  match ENV.get("TEY_KEX") do
    Just(path) => Just(path)
    None => do
      match FS.File.read("${Tey.Toolchain.home}/current") do
        Ok(version) => Just(Tey.Toolchain.binaryOf(version.trim))
        Error(_) => None
      end
    end
  end
end

# Returns the Kex bundled beside Tey, named by +TEY_BUNDLED_KEX+, or +None+
# when there is none.
#
# A package manager installs it so the first +tey+ command has a compiler
# without a long build. It is not an installation in the Tey home: +resolved+
# runs it where it lies, and +tey kex use <its version>+ copies it into the
# home, after which Tey manages it like any other version.
foul bundled -> String? do
  match ENV.get("TEY_BUNDLED_KEX") do
    None => return None
    Just(path) => return FS.File.file?(path) then Just(path) else None
  end
end

# Returns the version of the bundled Kex, or +None+.
#
# The only way to find out is to run it, so avoid calling this in a loop.
foul bundledVersion -> String? do
  match Tey.Toolchain.bundled do
    None => return None
    Just(binary) => do
      match Tey.Toolchain.versionOfBinary(binary) do
        Error(_) => return None
        Ok(version) => return Just(version)
      end
    end
  end
end

# A Kex that +tey kex use+ can select: its version, the binary that runs it,
# and whether it is the bundled one beside Tey and not an installation in the
# Tey home.
record Toolchain do
  version : String
  binary : String
  bundled? : Bool = false
end

# Returns every toolchain +tey kex use+ can select, newest first: the ones in
# the Tey home and the bundled one, each with the binary that runs it.
#
# +tey kex list --installed --json+ prints this. The bundled Kex is included
# although it is not installed, because on a fresh install it is the one a
# bare +kex+ runs, and +tey kex use+ must be able to select it.
foul selectableToolchains -> [Toolchain] do
  let installed = Tey.Toolchain.installedVersions
  match Tey.Toolchain.bundledVersion do
    None => return installed.map { |version| Tey.Toolchain.installedToolchain(version) }
    Just(bundledVersion) => do
      return installed.map { |version| Tey.Toolchain.installedToolchain(version) } if installed.contains?(bundledVersion)
      let seed = Tey.Toolchain.bundledToolchain(bundledVersion)
      return Tey.Toolchain.newestFirst([...installed, bundledVersion]).map do |version|
        version == bundledVersion then seed else Tey.Toolchain.installedToolchain(version)
      end
    end
  end
end

# Returns every version +tey kex use+ can select, newest first.
foul selectableVersions -> [String] do
  Tey.Toolchain.selectableToolchains.map { |toolchain| toolchain.version }
end

# Turns the argument of +tey kex use+ into a version number.
#
# +latest+ means the newest version already on this machine, not the newest
# release: +use+ never downloads anything. +tey kex install+ does that.
foul resolveSelector(selector: String) -> String? do
  return Just(selector) if selector != "latest"
  return Tey.Toolchain.selectableVersions.first
end

# Returns the compiler every Tey command runs.
#
# It is +resolved+'s answer (+TEY_KEX+, then the selected toolchain, then the
# bundled Kex where it lies), or else a bare +kex+ from PATH. That last one is
# a fallback for a source checkout: Tey cannot update it, and it may not be
# the version +tey kex list+ reports.
foul kex -> String do
  return Tey.Toolchain.resolved.or("kex")
end

# Reads +kex --info+ from the selected compiler.
#
# Callers that need several facts read them from one call, so they cannot
# come from two different binaries if the selection changes in between.
foul activeInfo -> ToolchainInfo or! String do
  match Process.run(Tey.Toolchain.kex, ["--info"]) do
    Error(error) => return Error("could not inspect selected Kex: ${error}")
    Ok(result) => do
      return Error("selected Kex could not report its toolchain information: ${result.stderr}") if result.exitCode != 0
      match JSON.parse(result.stdout) do
        Error(_) => return Error("selected Kex returned invalid --info JSON")
        Ok(info) => do
          let version = match JSON.fields(info)["version"] do
            None => ""
            Just(value) => "${value}"
          end
          return Error("selected Kex --info is missing its version") if version == ""
          let floor = match JSON.fields(info)["runtime_otp_floor"] do
            None => None
            Just(value) => match Integer.parse("${value}") do
              Ok(number) => Just(number)
              Error(_) => None
            end
          end
          return Ok(ToolchainInfo { version: version,
                                    reportedRuntimeOtpFloor: floor })
        end
      end
    end
  end
end

# Returns the OTP release that compiled the selected toolchain's runtime
# beams, which is the oldest Erlang that can load them.
#
# It comes from +kex --info+. It is +None+ when the toolchain is too old to
# have +--info+, when the field is missing, or when it is +null+ because the
# compiler was built without +erlc+. A caller should not treat any of these as
# an error.
foul runtimeOtpFloor -> Integer? do
  match Tey.Toolchain.activeInfo do
    Error(_) => None
    Ok(info) => info.reportedRuntimeOtpFloor
  end
end

# Returns the OTP release of the +erl+ that will run, by asking it.
foul runningOtpRelease -> Integer? do
  match Process.run(Tey.Toolchain.erl, ["-noshell", "-eval",
                                        "io:format(\"~s\", [erlang:system_info(otp_release)]), halt()."]) do
    Error(_) => return None
    Ok(result) => do
      return None if result.exitCode != 0
      match Integer.parse(result.stdout.trim) do
        Error(_) => return None
        Ok(release) => return Just(release)
      end
    end
  end
end

# Returns the +erl+ that Tey and Kex will run. +KEX_ERL+ overrides it for
# both, as it does for the compiler.
foul erl -> String do
  return ENV.get("KEX_ERL", "erl")
end

# Returns the compiler Tey would run, or +None+ when there is none.
#
# It tries +TEY_KEX+, then the selected toolchain, then the bundled Kex. The
# bundled one is run where it lies, not copied into the Tey home: nothing is
# installed until the user asks, and Homebrew's post-install sandbox could not
# write to the home anyway. A selected version always wins over it.
#
# Unlike +kex+, this has no fallback to a bare +kex+ from PATH, because that
# +kex+ is Tey's own dispatcher and would call itself.
foul resolved -> String? do
  match Tey.Toolchain.installedKex do
    Just(path) => return Just(path)
    None => return Tey.Toolchain.bundled
  end
end

# Copies the bundled Kex into the Tey home and selects it, so Tey manages it
# like any other version. This only happens when the user selects the bundled
# version with +tey kex use+.
foul installBundled -> String or! String do
  match Tey.Toolchain.bundled do
    None => return Error("no Kex is bundled with this install")
    Just(binary) => return Tey.Toolchain.adopt(binary)
  end
end

# Returns +false+ when the selected version is no longer installed, so a
# caller can report a missing Kex instead of failing on a path that does not
# exist.
foul selectionHealthy? -> Bool do
  match Tey.Toolchain.selected do
    None => return true
    Just(version) => return Tey.Toolchain.installed?(version)
  end
end

# Returns why the toolchain installed at +prefix+ cannot start, or +None+
# when +kex --version+ runs.
#
# A release archive is a prebuilt binary that loads readline, GMP, PCRE2 and
# OpenSSL from the system, and on Linux needs glibc 2.38 or later. This finds
# a missing library right after the install, not on the first real command.
foul startupProblem(prefix: String) -> String? do
  match Process.run("${prefix}/bin/kex", ["--version"]) do
    Error(error) => return Just(error)
    Ok(result) => do
      return None if result.exitCode == 0
      let said = result.stderr.trim
      return Just(said.empty? then "`kex --version` exited with status ${result.exitCode}" else said)
    end
  end
end

# Installs a released version and selects it, returning its prefix.
#
# It uses the published archive for this machine when there is one, which
# takes seconds and needs no C++ compiler. When there is no archive for this
# machine it builds from source. A corrupt archive, or a release that cannot be
# looked up at all, is an error and does not fall back to a build.
foul installRelease(version: String) -> String or! String do
  match Tey.Toolchain.installArchive(version) do
    Ok(prefix) => return Ok(prefix)
    # An archive that is not there is a platform Kex does not publish for, or
    # a release still uploading; building is a reasonable answer to both.
    Error(Unavailable(reason)) => do
      IO.printError("tey: no archive for this machine (${reason}); building Kex ${version} from source")
      let source = Tey.Toolchain.fetchRelease(version).try
      return Tey.Toolchain.installSource(source, version)
    end
    # An archive that is there and WRONG is a different thing entirely. It
    # could be a truncated download or a tampered mirror, and neither is
    # something to shrug off by quietly compiling instead.
    Error(Corrupt(reason)) => return Error(reason)
    # Not even the release's tag could be looked up — no git, no network.
    # Building from source needs that same lookup, so falling back would only
    # repeat the failure under a misleading "no archive for this machine".
    Error(Unreachable(reason)) => return Error(reason)
  end
end

# Why a published archive could not be installed.
#
# +Unavailable+ means there is no usable archive for this machine, and a source
# build may follow. +Corrupt+ means the archive did not match its checksum or
# did not unpack. +Unreachable+ means the release's tag could not be looked up.
type ArchiveFailure =
  | Unavailable(String)
  | Corrupt(String)
  | Unreachable(String)

# Returns the base URL of the release archives.
#
# It is derived from +repository+, so a fork only has to set +TEY_KEX_REPO+.
# +TEY_KEX_RELEASES+ overrides it for a mirror.
foul releaseBase -> String do
  match ENV.get("TEY_KEX_RELEASES") do
    Just(base) => return base
    None => do
      let repository = Tey.Toolchain.repository
      let trimmed = repository.endsWith?(".git") then repository.take(repository.count - 4) else repository
      return "${trimmed}/releases/download"
    end
  end
end

# Returns this machine's part of a release archive name, such as
# +macos-arm64+ in +kex-0.4.0-macos-arm64.tar.gz+.
foul releaseTarget -> String or! String do
  let arch = Tey.Toolchain.machineArchitecture.try
  match System.OS do
    :macos => return Ok("macos-${arch}")
    :linux => return Ok("linux-${arch}")
    other => return Error("no Kex archives are published for ${other}")
  end
end

# Builds the Kex source tree at +source+ with CMake, installs it as +version+
# and selects it, returning its prefix.
#
# The compiler, runtime BEAM modules and stdlib sources are installed
# together, in the CMake install layout that every Tey toolchain has.
foul installSource(source: String, version: String) -> String or! String do
  let home = Tey.Toolchain.home
  let prefix = "${home}/toolchains/${version}"
  let build = "${Tey.Cache.root}/build/kex-${version}"
  return Error("could not create Tey home") if !FS.Directory.create(home).ok?
  return Error("could not create Tey toolchain directory") if !FS.Directory.create("${home}/toolchains").ok?
  return Error("could not create Tey build cache") if !FS.Directory.create(Tey.Cache.root).ok?
  return Error("could not create Tey build cache") if !FS.Directory.create("${Tey.Cache.root}/build").ok?
  # CMake installs into a staging prefix, and only a COMPLETE installation is
  # renamed to the real one. Installing straight into `prefix` would publish
  # the compiler binary before the runtime and stdlib beside it, and a build
  # that failed in between left a toolchain that `use` would happily select.
  # Nothing bakes the prefix into the artifacts — the binary finds its stdlib
  # relative to itself — so moving a finished tree is safe.
  let staging = "${prefix}.partial"
  FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
  let configured = match Process.run("cmake", ["-S", source, "-B", build, "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_PREFIX=${staging}"]) do
    Error(error) => return Error(error)
    Ok(result) => result
  end
  if configured.exitCode != 0
    FS.Directory.deleteAll(staging)
    return Error(configured.stderr + configured.stdout)
  end
  let installed = match Process.run("cmake", ["--build", build, "--target", "install", "--parallel"]) do
    Error(error) => return Error(error)
    Ok(result) => result
  end
  if installed.exitCode != 0
    FS.Directory.deleteAll(staging)
    return Error(installed.stderr + installed.stdout)
  end
  # `.try` propagates a failed publish as this function's Error.
  let installedPrefix = Tey.Toolchain.publish(staging, prefix).try
  return Error("installed Kex but could not select it") if FS.File.write("${home}/current", "${version}\n").error?
  Tey.Toolchain.link(version)
  Ok(installedPrefix)
end

# Removes an installed toolchain and returns its former prefix.
#
# Removing the selected version also clears the selection and removes the
# shim, so the caller should ask the user to select another.
foul uninstall(version: String) -> String or! String do
  let prefix = "${Tey.Toolchain.home}/toolchains/${version}"
  return Error("Kex ${version} is not installed") if !FS.Directory.directory?(prefix)
  return Error("could not remove ${prefix}") if !FS.Directory.deleteAll(prefix).ok?
  # Its Tey goes too — unless it is the one running this, whose modules still
  # load from there. Nothing runs an orphan: `bin/tey` only picks it up while
  # its Kex is selected, and a reinstall reuses it.
  let paired = Tey.Toolchain.pairedTeyEbin(version)
  if ENV.get("TEY_EBIN", "") != paired
    FS.Directory.deleteAll("${Tey.Toolchain.home}/tey/${version}")
  end
  if Tey.Toolchain.selected == Just(version)
    FS.File.delete("${Tey.Toolchain.home}/current")
    FS.File.delete(Tey.Toolchain.shimPath)
  end
  return Ok(prefix)
end

# Selects an installed version, or the bundled one, and points the shim at it.
foul use(version: String) -> Void or! String do
  let home = Tey.Toolchain.home
  # Naming the bundled Kex selects it, taking the copy into the Tey
  # home on the way — the one place an install happens without being typed as
  # one. It is not a download and not a build: the files are already on the
  # disk, this is a copy of what the user is pointing at. The alternative was
  # refusing a version that is demonstrably present, which is how someone who
  # installed a second Kex lost the one their package manager gave them.
  if !Tey.Toolchain.installed?(version)
    return Error("Kex ${version} is not installed") if Tey.Toolchain.bundledVersion != Just(version)
    # installBundled writes `current` and relinks itself, so there is nothing
    # left to do here.
    match Tey.Toolchain.installBundled do
      Error(error) => return Error(error)
      Ok(_) => return Ok(())
    end
  end
  return Error("could not write ${home}/current") if FS.File.write("${home}/current", "${version}\n").error?
  # Best effort: the selection is recorded either way, and `tey` itself reads
  # the record rather than the shim. Only a user's bare `kex` needs the link.
  Tey.Toolchain.link(version)
  return Ok(())
end

# Downloads +url+ to +path+ with curl, or with wget when curl is missing.
#
# The file appears at +path+ only once the download is complete. This and the
# helpers below are public because +Tey.SelfUpdate+ (+tey upgrade+) uses them
# for Tey's own archives.
foul download(url: String, path: String) -> Void or! String do
  let partial = "${path}.partial"
  FS.File.delete(partial)
  let fetched = match Process.run("curl", ["-fsSL", "-o", partial, url]) do
    Ok(result) => result.exitCode == 0
    Error(_) => match Process.run("wget", ["-q", "-O", partial, url]) do
      Ok(result) => result.exitCode == 0
      Error(_) => return Error("neither curl nor wget is available to download ${url}")
    end
  end
  if !fetched
    FS.File.delete(partial)
    return Error("could not download ${url}")
  end
  return FS.File.rename(partial, path).ok? then Ok(()) else Error("could not move the download into ${path}")
end

# Downloads the checksum at +checksumUrl+ and checks +archive+ against it.
#
# The file is in the +<hash>  <filename>+ format that sha256sum and shasum
# write.
foul verifyArchive(archive: String, checksumUrl: String) -> Void or! String do
  let checksums = "${archive}.sha256"
  Tey.Toolchain.download(checksumUrl, checksums).try
  let expected = match FS.File.read(checksums) do
    Error(_) => return Error("could not read ${checksums}")
    Ok(text) => text.trim.split(" ").first.or("")
  end
  return Error("${checksumUrl} does not contain a checksum") if expected.empty?
  let actual = Tey.Toolchain.checksumOf(archive).try
  return Error("checksum mismatch for ${archive}: expected ${expected}, got ${actual}") if actual != expected
  return Ok(())
end

# Returns the SHA-256 of the file at +path+, computed by sha256sum or shasum
# so the file is never read into memory.
foul checksumOf(path: String) -> String or! String do
  let output = match Process.run("sha256sum", [path]) do
    Ok(result) => result.exitCode == 0 then Just(result.stdout) else None
    Error(_) => match Process.run("shasum", ["-a", "256", path]) do
      Ok(result) => result.exitCode == 0 then Just(result.stdout) else None
      Error(_) => return Error("neither sha256sum nor shasum is available to verify ${path}")
    end
  end
  match output do
    None => return Error("could not hash ${path}")
    Just(text) => return Ok(text.trim.split(" ").first.or(""))
  end
end

# Returns the repository tag for +version+, either +0.3.0+ or +v0.3.0+.
foul releaseTag(version: String) -> String or! String do
  let tags = Tey.Git.tags(Tey.Toolchain.repository).try
  return Ok(version) if tags.contains?(version)
  return Ok("v${version}") if tags.contains?("v${version}")
  return Error("Kex ${version} is not a released version")
end

# Returns the version a tag names, without a leading +v+, or +None+ when the
# tag is not a version.
#
# @example
#   Tey.Toolchain.versionOf("v0.3.0")    # => Just("0.3.0")
#   Tey.Toolchain.versionOf("nightly")   # => None
let versionOf(tag: String) -> String? do
  let version = tag.startsWith?("v") then tag.drop(1) else tag
  return None if Tey.Semver.parseVersion(version) == None
  return Just(version)
end

# Moves a finished staging tree to +prefix+, and returns +prefix+.
#
# When +prefix+ already holds a toolchain, the old tree is kept until the new
# one is in place and put back if the move fails, so a failed reinstall leaves
# the previous toolchain working.
foul publish(staging: String, prefix: String) -> String or! String do
  let previous = "${prefix}.previous"
  FS.Directory.deleteAll(previous) if FS.Directory.directory?(previous)
  let replacing = FS.Directory.directory?(prefix)
  if replacing && !FS.File.rename(prefix, previous).ok?
    FS.Directory.deleteAll(staging)
    return Error("could not move the installed toolchain at ${prefix} aside")
  end
  if !FS.File.rename(staging, prefix).ok?
    FS.File.rename(previous, prefix) if replacing
    FS.Directory.deleteAll(staging)
    return Error("could not move the new toolchain into ${prefix}")
  end
  FS.Directory.deleteAll(previous)
  return Ok(prefix)
end

private do
  # Returns the +Toolchain+ for a version installed in the Tey home.
  foul installedToolchain(version: String) -> Toolchain do
    Toolchain { version: version, binary: Tey.Toolchain.binaryOf(version) }
  end

  # Returns the +Toolchain+ for the bundled Kex, run where it lies.
  foul bundledToolchain(version: String) -> Toolchain do
    Toolchain { version: version, binary: Tey.Toolchain.bundled.or(""), bundled?: true }
  end

  # Downloads and verifies the published archive for this machine, installs
  # it and selects it. The archive holds one directory, the same CMake install
  # tree +installSource+ produces.
  foul installArchive(version: String) -> String or! ArchiveFailure do
    let target = match Tey.Toolchain.releaseTarget do
      Error(error) => return Error(Unavailable(error))
      Ok(value) => value
    end
    let tag = match Tey.Toolchain.releaseTag(version) do
      Error(error) => return Error(Unreachable(error))
      Ok(value) => value
    end
    let name = "kex-${version}-${target}"
    let downloads = "${Tey.Cache.root}/downloads"
    return Error(Unavailable("could not create the download cache")) if !FS.Directory.create(downloads).ok?

    let archive = "${downloads}/${name}.tar.gz"
    let url = "${Tey.Toolchain.releaseBase}/${tag}/${name}.tar.gz"
    match Tey.Toolchain.download(url, archive) do
      Error(error) => return Error(Unavailable(error))
      Ok(_) => ()
    end
    # The checksum is published beside the archive, so a mismatch means the
    # bytes are not the release's. That is Corrupt, not Unavailable: the
    # caller must not answer it by building something else instead.
    match Tey.Toolchain.verifyArchive(archive, "${url}.sha256") do
      Error(error) => return Error(Corrupt(error))
      Ok(_) => ()
    end

    let home = Tey.Toolchain.home
    let prefix = "${home}/toolchains/${version}"
    return Error(Unavailable("could not create Tey home")) if !FS.Directory.create("${home}/toolchains").ok?
    # Unpacked beside its destination, not in the download cache: the tree is
    # renamed into place below, and a rename cannot cross filesystems. The
    # cache under ~/.cache and a Tey home on another one (a tmpfs /tmp, a
    # separate /home) failed with "could not move the unpacked toolchain".
    let unpacked = "${prefix}.unpacked"
    FS.Directory.deleteAll(unpacked) if FS.Directory.directory?(unpacked)
    return Error(Unavailable("could not create ${unpacked}")) if !FS.Directory.create(unpacked).ok?
    let extracted = match Process.run("tar", ["-xzf", archive, "-C", unpacked]) do
      Error(error) => return Error(Corrupt(error))
      Ok(value) => value
    end
    if extracted.exitCode != 0
      FS.Directory.deleteAll(unpacked)
      return Error(Corrupt("could not unpack ${archive}: ${extracted.stderr}"))
    end

    # `--strip-components` is not portable across every tar, so the single
    # top-level directory is moved rather than stripped.
    let tree = "${unpacked}/${name}"
    if !FS.File.file?("${tree}/bin/kex")
      FS.Directory.deleteAll(unpacked)
      return Error(Corrupt("${name}.tar.gz does not contain ${name}/bin/kex"))
    end
    let staging = "${prefix}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    if !FS.File.rename(tree, staging).ok?
      FS.Directory.deleteAll(unpacked)
      return Error(Unavailable("could not move the unpacked toolchain into place"))
    end
    FS.Directory.deleteAll(unpacked)

    let installedPrefix = match Tey.Toolchain.publish(staging, prefix) do
      Error(error) => return Error(Unavailable(error))
      Ok(value) => value
    end
    return Error(Unavailable("installed Kex ${version} but could not select it")) if FS.File.write("${home}/current", "${version}\n").error?
    Tey.Toolchain.link(version)
    return Ok(installedPrefix)
  end

  # Returns this machine's architecture as the release archives spell it,
  # +arm64+ or +x86_64+, accepting the aliases +uname+ may print.
  foul machineArchitecture -> String or! String do
    let result = Process.run("uname", ["-m"]).try
    return Error("could not determine this machine's architecture") if result.exitCode != 0
    let machine = result.stdout.trim
    return Ok("arm64") if machine == "arm64" || machine == "aarch64"
    return Ok("x86_64") if machine == "x86_64" || machine == "amd64"
    return Error("no Kex archives are published for ${machine}")
  end

  # Copies the Kex install tree whose +bin/kex+ is +binary+ into the Tey home
  # and selects it. The stdlib and runtime beside the binary come along.
  #
  # It copies, because the package manager that installed the bundled Kex will
  # replace it; a symlink would leave a directory named for one version running
  # another after the next +brew upgrade+.
  foul adopt(binary: String) -> String or! String do
    return Error("${binary} is not an executable Kex") if !FS.File.file?(binary)
    let version = Tey.Toolchain.versionOfBinary(binary).try
    let source = FS.Path.dirname(FS.Path.dirname(binary))
    let home = Tey.Toolchain.home
    let prefix = "${home}/toolchains/${version}"
    return Ok(prefix) if Tey.Toolchain.installed?(version)

    return Error("could not create Tey home") if !FS.Directory.create("${home}/toolchains").ok?
    let staging = "${prefix}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    let copied = match Process.run("cp", ["-R", source, staging]) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(result) => result
    end
    if copied.exitCode != 0
      FS.Directory.deleteAll(staging)
      return Error("could not copy ${source} into the Tey home: ${copied.stderr}")
    end
    let installedPrefix = Tey.Toolchain.publish(staging, prefix).try
    return Error("adopted Kex ${version} but could not select it") if FS.File.write("${home}/current", "${version}\n").error?
    Tey.Toolchain.link(version)
    return Ok(installedPrefix)
  end

  # Returns the version a Kex binary reports. +kex --version+ prints
  # +kex 0.3.0-beta (abc1234, built 2026-08-15)+, and the version is the second
  # word.
  foul versionOfBinary(binary: String) -> String or! String do
    match Process.run(binary, ["--version"]) do
      Error(error) => return Error(error)
      Ok(result) => do
        return Error("${binary} --version failed: ${result.stderr}") if result.exitCode != 0
        match result.stdout.trim.split(" ").drop(1).first do
          None => return Error("could not read a version out of `${binary} --version`")
          Just(version) => do
            return Error("`${binary} --version` reported '${version}', which is not a version") if Tey.Semver.parseVersion(version) == None
            return Ok(version)
          end
        end
      end
    end
  end

  # Clones the repository at +version+'s tag into the build cache and returns
  # the checkout. The tag may be spelled with or without a leading +v+.
  foul fetchRelease(version: String) -> String or! String do
    return Error("could not create Tey build cache") if !FS.Directory.create(Tey.Cache.root).ok?
    return Error("could not create Tey build cache") if !FS.Directory.create("${Tey.Cache.root}/src").ok?
    let checkout = "${Tey.Cache.root}/src/kex-${version}"
    return Ok(checkout) if FS.Directory.directory?(checkout)
    let staging = "${checkout}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    let tag = Tey.Toolchain.releaseTag(version).try
    match Tey.Git.execute(["clone", "--depth", "1", "--branch", tag,
                           Tey.Toolchain.repository, staging]) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(_) => do
        return Ok(checkout) if FS.File.rename(staging, checkout).ok?
        FS.Directory.deleteAll(staging)
        return Error("could not move the Kex ${version} checkout into place")
      end
    end
  end

  # Points the shim at a version's binary, creating the bin directory if
  # needed. It is a symlink, because +kex+ finds its stdlib and runtime
  # relative to the path the link resolves to.
  foul link(version: String) -> Void or! String do
    return Error("could not create ${Tey.Toolchain.binDirectory}") if !FS.Directory.create(Tey.Toolchain.binDirectory).ok?
    let target = Tey.Toolchain.binaryOf(version)
    return Error("Kex ${version} has no binary at ${target}") if !FS.File.file?(target)
    match Process.run("ln", ["-sfn", target, Tey.Toolchain.shimPath]) do
      Error(_) => return Error("could not run ln")
      Ok(result) => return result.exitCode == 0 then Ok(()) else Error("could not link ${Tey.Toolchain.shimPath}")
    end
  end

end
