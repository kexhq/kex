module Tey.Toolchain

using Tey.Cache, only: [root]
using Tey.Git, only: [execute]

foul home -> String do
  let userHome = ENV.get("HOME", ".")
  ENV.get("TEY_HOME", "${userHome}/.local/share/tey")
end

# Where `tey kex list` looks for releases. Overridable so a fork or a mirror
# can be used without patching Tey.
foul repository -> String do
  return ENV.get("TEY_KEX_REPO", "https://github.com/kexhq/kex.git")
end

# The directory holding the `kex` shim. It is what a user puts on PATH once;
# selecting a version repoints the shim rather than asking them to edit PATH
# again.
foul binDirectory -> String do
  return "${Tey.Toolchain.home}/bin"
end

foul shimPath -> String do
  return "${Tey.Toolchain.binDirectory}/kex"
end

# The version `tey kex use` last selected, if any.
foul selected -> String? do
  match FS.File.read("${Tey.Toolchain.home}/current") do
    None => return None
    Just(text) => do
      let name = text.trim
      return name.empty? then None else Just(name)
    end
  end
end

# Versions installed under this Tey home, newest first. Staging leftovers are
# not installations, and neither is a directory whose `bin/kex` is gone — a
# half-removed toolchain must not be offered as one somebody can run.
foul installedVersions -> [String] do
  let entries = FS.Directory.directories("${Tey.Toolchain.home}/toolchains").or([])
  let names = entries.filter do |name|
    !name.endsWith?(".partial") && !name.endsWith?(".previous") && Tey.Toolchain.installed?(name)
  end
  return Tey.Toolchain.newestFirst(names)
end

# The `bin/kex` naming an installed version — the toolchain layout every
# consumer (the shim, `resolved`, the listings) agrees on, in one place.
foul binaryOf(version: String) -> String do
  return "${Tey.Toolchain.home}/toolchains/${version}/bin/kex"
end

foul installed?(version: String) -> Bool do
  return FS.File.file?(Tey.Toolchain.binaryOf(version))
end

# Released versions, newest first, read from the repository's tags. Tags that
# are not versions are skipped rather than reported as junk.
foul availableVersions -> [String] or! String do
  match Tey.Git.tags(Tey.Toolchain.repository) do
    Error(error) => return Error(error)
    Ok(names) => do
      let versions = names.collect do |tag|
        Tey.Toolchain.versionOf(tag)
      end
      return Ok(Tey.Toolchain.newestFirst(versions))
    end
  end
end

let newestFirst(versions: [String]) -> [String] do
  return Tey.Semver.newestFirst(versions)
end

# The newest RELEASED version — what `tey kex install` picks when asked for
# no version in particular, and what a download page means by "the current
# Kex". Pre-releases are opt-in by name.
foul latestStable -> String or! String do
  let available = Tey.Toolchain.availableVersions.try
  match available.filter { |version| Tey.Semver.stable?(version) }.first do
    Just(version) => return Ok(version)
    None => return Error("no released Kex version is available")
  end
end

# The newest version of ANY channel — what `tey kex install --pre` picks. This
# is how you get onto a beta or an rc without knowing its number: during a
# pre-stability run there may be nothing else published at all.
foul latestIncludingPreReleases -> String or! String do
  let available = Tey.Toolchain.availableVersions.try
  match available.first do
    Just(version) => return Ok(version)
    None => return Error("no Kex version is available")
  end
end

foul installedKex -> String? do
  match ENV.get("TEY_KEX") do
    Just(path) => Just(path)
    None => do
      match FS.File.read("${Tey.Toolchain.home}/current") do
        Just(version) => Just(Tey.Toolchain.binaryOf(version.trim))
        None => None
      end
    end
  end
end

# The Kex bundled beside Tey — what a package manager lays down so the first
# `tey` command has a compiler without a ten-minute build. It is a SEED, not
# an installation: `kex` below adopts it into the Tey home on first use, and
# from then on Tey manages that copy like any other version. Nothing outside
# the Tey home is ever put on PATH, which is the whole point — two `kex`
# binaries under two managers drift apart.
foul bundled -> String? do
  match ENV.get("TEY_BUNDLED_KEX") do
    None => return None
    Just(path) => return FS.File.file?(path) then Just(path) else None
  end
end

# Which version the bundled Kex is. Answering means RUNNING it, so this is
# not something to ask inside a loop — but it is the only way to know: the
# seed is a plain install tree with no version recorded beside it.
foul bundledVersion -> String? do
  match Tey.Toolchain.bundled do
    None => return None
    Just(binary) => do
      match Tey.Toolchain.versionOfBinary(binary) do
        Error(_) => return None
        Ok(version) => return Just(version)
      end
    end
  end
end

# One selectable Kex: the version `tey kex use` names it by, the binary that
# runs it, and whether it is the bundled seed lying beside Tey rather than an
# installation in the Tey home.
record Toolchain do
  version : String
  binary : String
  bundled? : Bool = false
end

# Every version `tey kex use` can select, newest first: the ones in the Tey
# home, plus the bundled one — each carrying the binary that runs it, which
# is what a listing meant for tools (`kex list --installed --json`) needs.
#
# The seed belongs here even though it is not installed. It is a real compiler
# already on the disk, and on a fresh keg it is the one a bare `kex` runs — so
# leaving it out made `tey kex use <that version>` refuse a version the user
# had just watched run, with no way back to it short of downloading a second
# copy of what was already there.
foul selectableToolchains -> [Toolchain] do
  let installed = Tey.Toolchain.installedVersions
  match Tey.Toolchain.bundledVersion do
    None => return installed.map { |version| Tey.Toolchain.installedToolchain(version) }
    Just(bundledVersion) => do
      return installed.map { |version| Tey.Toolchain.installedToolchain(version) } if installed.contains?(bundledVersion)
      let seed = Tey.Toolchain.bundledToolchain(bundledVersion)
      return Tey.Toolchain.newestFirst([...installed, bundledVersion]).map do |version|
        version == bundledVersion then seed else Tey.Toolchain.installedToolchain(version)
      end
    end
  end
end

# Every version `tey kex use` can select, newest first.
foul selectableVersions -> [String] do
  Tey.Toolchain.selectableToolchains.map { |toolchain| toolchain.version }
end

# Turns what someone typed after `tey kex use` into a version number.
#
# `latest` means the newest Kex this machine can select — NOT the newest
# released one. `use` selects among what is already here; reaching for
# something unreleased-and-undownloaded is what `tey kex install` is for, and
# quietly downloading from a command that reads like "switch to" would be a
# surprise.
foul resolveSelector(selector: String) -> String? do
  return Just(selector) if selector != "latest"
  return Tey.Toolchain.selectableVersions.first
end

# The compiler every Tey command shells out to.
#
# In order: an explicit TEY_KEX, the selected toolchain, the bundled seed
# (adopted on the spot), and only then a bare `kex` from PATH. That last one
# is a fallback for a source checkout, not a supported installation — a `kex`
# somebody else installed is a `kex` Tey cannot update, and it silently
# becomes a different version from the one `tey kex list` reports.
foul kex -> String do
  return Tey.Toolchain.resolved.or("kex")
end

# The OTP release that compiled the selected toolchain's runtime beams — the
# oldest Erlang that can load them, since a `.beam` cannot be read by a runtime
# older than the `erlc` that produced it.
#
# Read from `kex --info` rather than guessed: the number is a build-time
# constant inside the binary (KEX_RUNTIME_OTP_FLOOR) and Tey has no other way
# to see it. `--version` is prose and may be reworded; `--info` is the contract
# (tests/info_cli_test.cxx pins it).
#
# `None` when the toolchain is too old to have `--info`, when the field is
# absent, or when it is `null` because the compiler was built without erlc. All
# three mean the same thing to a caller — "this toolchain does not say" — and
# none of them is an error worth stopping a build for.
foul runtimeOtpFloor -> Integer? do
  match Process.run(Tey.Toolchain.kex, ["--info"]) do
    Error(_) => return None
    Ok(result) => do
      return None if result.exitCode != 0
      match JSON.parse(result.stdout) do
        Error(_) => return None
        Ok(info) => match info["runtime_otp_floor"] do
          None => return None
          Just(value) => match Integer.parse("${value}") do
            Error(_) => return None
            Ok(floor) => return Just(floor)
          end
        end
      end
    end
  end
end

# The OTP actually about to run, asked of `erl` itself.
foul runningOtpRelease -> Integer? do
  match Process.run(Tey.Toolchain.erl, ["-noshell", "-eval",
                                        "io:format(\"~s\", [erlang:system_info(otp_release)]), halt()."]) do
    Error(_) => return None
    Ok(result) => do
      return None if result.exitCode != 0
      match Integer.parse(result.stdout.trim) do
        Error(_) => return None
        Ok(release) => return Just(release)
      end
    end
  end
end

# The `erl` Tey and Kex will spawn. KEX_ERL mirrors what the compiler itself
# honours, so overriding it moves both rather than half of the pair.
foul erl -> String do
  return ENV.get("KEX_ERL", "erl")
end

# The compiler Tey would run, or None when there is none to run.
#
# The bundled Kex is used WHERE IT LIES rather than copied into the Tey home
# first. Copying is an install, and an install is not something to do behind
# someone's back on their first command — it is also impossible where it would
# be most useful, since Homebrew's post-install sandbox cannot write to the
# user's home at all. So a fresh Homebrew keg is runnable immediately, nothing
# is written until `tey kex install` is typed, and a selected version always
# wins over the bundled one.
#
# Without the last-resort fallback to a bare `kex` from PATH that `kex` above
# keeps: `kex` on PATH is Tey's own dispatcher, and answering it with its own
# name would send it round in a circle.
foul resolved -> String? do
  match Tey.Toolchain.installedKex do
    Just(path) => return Just(path)
    None => return Tey.Toolchain.bundled
  end
end

# Takes the bundled Kex into the Tey home so Tey manages it like any other
# version: `tey kex list` shows it, `tey kex use` can come back to it, and
# uninstalling whatever replaces it leaves something behind. Only ever done
# when asked — see `resolved`.
foul installBundled -> String or! String do
  match Tey.Toolchain.bundled do
    None => return Error("no Kex is bundled with this install")
    Just(binary) => return Tey.Toolchain.adopt(binary)
  end
end

# Whether the selected toolchain is actually there. A `current` naming a
# version somebody deleted leaves every command failing on a path that does
# not exist, which reads like a broken Tey rather than a missing Kex.
foul selectionHealthy? -> Bool do
  match Tey.Toolchain.selected do
    None => return true
    Just(version) => return Tey.Toolchain.installed?(version)
  end
end

# Installs a released version by name. The published archive for this machine
# is the fast path — unpacking one takes seconds where building takes minutes,
# and it needs no compiler, which is the point: whatever installs Tey should
# not also have to be able to build Kex.
#
# Falling back to a source build rather than failing keeps the platforms
# without a published archive working, and covers a release whose upload is
# incomplete.
foul installRelease(version: String) -> String or! String do
  match Tey.Toolchain.installArchive(version) do
    Ok(prefix) => return Ok(prefix)
    # An archive that is not there is a platform Kex does not publish for, or
    # a release still uploading; building is a reasonable answer to both.
    Error(Unavailable(reason)) => do
      IO.printError("tey: no archive for this machine (${reason}); building Kex ${version} from source\n")
      let source = Tey.Toolchain.fetchRelease(version).try
      return Tey.Toolchain.installSource(source, version)
    end
    # An archive that is there and WRONG is a different thing entirely. It
    # could be a truncated download or a tampered mirror, and neither is
    # something to shrug off by quietly compiling instead.
    Error(Corrupt(reason)) => return Error(reason)
  end
end

# Why a published archive could not be installed. The distinction is the
# point: one of these is routine and one of them is not.
type ArchiveFailure =
  | Unavailable(String)
  | Corrupt(String)

# Where the release archives live. Derived from the repository so a fork only
# has to set TEY_KEX_REPO, and overridable on its own for a mirror.
foul releaseBase -> String do
  match ENV.get("TEY_KEX_RELEASES") do
    Just(base) => return base
    None => do
      let repository = Tey.Toolchain.repository
      let trimmed = repository.endsWith?(".git") then repository.take(repository.count - 4) else repository
      return "${trimmed}/releases/download"
    end
  end
end

# The archive naming this machine, matching what the release workflow builds:
# `kex-0.4.0-macos-arm64.tar.gz`.
foul releaseTarget -> String or! String do
  let arch = Tey.Toolchain.machineArchitecture.try
  match System.OS do
    :macos => return Ok("macos-${arch}")
    :linux => return Ok("linux-${arch}")
    other => return Error("no Kex archives are published for ${other}")
  end
end

# Installs compiler, runtime BEAM modules and stdlib sources together. The
# source tree's CMake install layout is the toolchain ABI Tey manages.
foul installSource(source: String, version: String) -> String or! String do
  let home = Tey.Toolchain.home
  let prefix = "${home}/toolchains/${version}"
  let build = "${Tey.Cache.root}/build/kex-${version}"
  return Error("could not create Tey home") if !FS.Directory.create(home)
  return Error("could not create Tey toolchain directory") if !FS.Directory.create("${home}/toolchains")
  return Error("could not create Tey build cache") if !FS.Directory.create(Tey.Cache.root)
  return Error("could not create Tey build cache") if !FS.Directory.create("${Tey.Cache.root}/build")
  # CMake installs into a staging prefix, and only a COMPLETE installation is
  # renamed to the real one. Installing straight into `prefix` would publish
  # the compiler binary before the runtime and stdlib beside it, and a build
  # that failed in between left a toolchain that `use` would happily select.
  # Nothing bakes the prefix into the artifacts — the binary finds its stdlib
  # relative to itself — so moving a finished tree is safe.
  let staging = "${prefix}.partial"
  FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
  let configured = match Process.run("cmake", ["-S", source, "-B", build, "-DCMAKE_BUILD_TYPE=Release", "-DCMAKE_INSTALL_PREFIX=${staging}"]) do
    Error(error) => return Error(error)
    Ok(result) => result
  end
  if configured.exitCode != 0
    FS.Directory.deleteAll(staging)
    return Error(configured.stderr + configured.stdout)
  end
  let installed = match Process.run("cmake", ["--build", build, "--target", "install", "--parallel"]) do
    Error(error) => return Error(error)
    Ok(result) => result
  end
  if installed.exitCode != 0
    FS.Directory.deleteAll(staging)
    return Error(installed.stderr + installed.stdout)
  end
  # `.try` propagates a failed publish as this function's Error.
  let installedPrefix = Tey.Toolchain.publish(staging, prefix).try
  return Error("installed Kex but could not select it") if !FS.File.write("${home}/current", "${version}\n")
  Tey.Toolchain.link(version)
  Ok(installedPrefix)
end

# Removes an installed toolchain. Refuses to leave the shim pointing at
# nothing: removing the SELECTED version also clears the selection, and the
# caller is told to pick another.
foul uninstall(version: String) -> String or! String do
  let prefix = "${Tey.Toolchain.home}/toolchains/${version}"
  return Error("Kex ${version} is not installed") if !FS.Directory.directory?(prefix)
  return Error("could not remove ${prefix}") if !FS.Directory.deleteAll(prefix)
  if Tey.Toolchain.selected == Just(version)
    FS.File.delete("${Tey.Toolchain.home}/current")
    FS.File.delete(Tey.Toolchain.shimPath)
  end
  return Ok(prefix)
end

foul use(version: String) -> Bool do
  let home = Tey.Toolchain.home
  # Naming the bundled Kex selects it, taking the copy into the Tey
  # home on the way — the one place an install happens without being typed as
  # one. It is not a download and not a build: the files are already on the
  # disk, this is a copy of what the user is pointing at. The alternative was
  # refusing a version that is demonstrably present, which is how someone who
  # installed a second Kex lost the one their package manager gave them.
  if !Tey.Toolchain.installed?(version)
    return false if Tey.Toolchain.bundledVersion != Just(version)
    # installBundled writes `current` and relinks itself, so there is nothing
    # left to do here.
    match Tey.Toolchain.installBundled do
      Error(_) => return false
      Ok(_) => return true
    end
  end
  return false if !FS.File.write("${home}/current", "${version}\n")
  # Best effort: the selection is recorded either way, and `tey` itself reads
  # the record rather than the shim. Only a user's bare `kex` needs the link.
  Tey.Toolchain.link(version)
  return true
end

private do
  # The two shapes a selectable Kex has: an installation in the Tey home,
  # named by its version, and the seed, run where it lies.
  foul installedToolchain(version: String) -> Toolchain do
    Toolchain { version: version, binary: Tey.Toolchain.binaryOf(version) }
  end

  foul bundledToolchain(version: String) -> Toolchain do
    Toolchain { version: version, binary: Tey.Toolchain.bundled.or(""), bundled?: true }
  end

  # Downloads the published archive for this machine and installs it. The
  # archive holds one directory — the same CMake install tree `installSource`
  # produces — so unpacking and publishing it is the whole job.
  foul installArchive(version: String) -> String or! ArchiveFailure do
    let target = match Tey.Toolchain.releaseTarget do
      Error(error) => return Error(Unavailable(error))
      Ok(value) => value
    end
    let tag = match Tey.Toolchain.releaseTag(version) do
      Error(error) => return Error(Unavailable(error))
      Ok(value) => value
    end
    let name = "kex-${version}-${target}"
    let downloads = "${Tey.Cache.root}/downloads"
    return Error(Unavailable("could not create the download cache")) if !FS.Directory.create(downloads)

    let archive = "${downloads}/${name}.tar.gz"
    let url = "${Tey.Toolchain.releaseBase}/${tag}/${name}.tar.gz"
    match Tey.Toolchain.download(url, archive) do
      Error(error) => return Error(Unavailable(error))
      Ok(_) => ()
    end
    # The checksum is published beside the archive, so a mismatch means the
    # bytes are not the release's. That is Corrupt, not Unavailable: the
    # caller must not answer it by building something else instead.
    match Tey.Toolchain.verifyArchive(archive, "${url}.sha256") do
      Error(error) => return Error(Corrupt(error))
      Ok(_) => ()
    end

    let home = Tey.Toolchain.home
    let prefix = "${home}/toolchains/${version}"
    return Error(Unavailable("could not create Tey home")) if !FS.Directory.create("${home}/toolchains")
    let unpacked = "${downloads}/${name}.unpacked"
    FS.Directory.deleteAll(unpacked) if FS.Directory.directory?(unpacked)
    return Error(Unavailable("could not create ${unpacked}")) if !FS.Directory.create(unpacked)
    let extracted = match Process.run("tar", ["-xzf", archive, "-C", unpacked]) do
      Error(error) => return Error(Corrupt(error))
      Ok(value) => value
    end
    if extracted.exitCode != 0
      FS.Directory.deleteAll(unpacked)
      return Error(Corrupt("could not unpack ${archive}: ${extracted.stderr}"))
    end

    # `--strip-components` is not portable across every tar, so the single
    # top-level directory is moved rather than stripped.
    let tree = "${unpacked}/${name}"
    if !FS.File.file?("${tree}/bin/kex")
      FS.Directory.deleteAll(unpacked)
      return Error(Corrupt("${name}.tar.gz does not contain ${name}/bin/kex"))
    end
    let staging = "${prefix}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    if !FS.File.rename(tree, staging)
      FS.Directory.deleteAll(unpacked)
      return Error(Unavailable("could not move the unpacked toolchain into place"))
    end
    FS.Directory.deleteAll(unpacked)

    let installedPrefix = match Tey.Toolchain.publish(staging, prefix) do
      Error(error) => return Error(Unavailable(error))
      Ok(value) => value
    end
    return Error(Unavailable("installed Kex ${version} but could not select it")) if !FS.File.write("${home}/current", "${version}\n")
    Tey.Toolchain.link(version)
    return Ok(installedPrefix)
  end

  # curl, then wget: one of the two is on essentially every machine that can
  # reach a release, and this way Tey needs neither an HTTP library nor a
  # compiler to fetch one.
  foul download(url: String, path: String) -> Void or! String do
    let partial = "${path}.partial"
    FS.File.delete(partial)
    let fetched = match Process.run("curl", ["-fsSL", "-o", partial, url]) do
      Ok(result) => result.exitCode == 0
      Error(_) => match Process.run("wget", ["-q", "-O", partial, url]) do
        Ok(result) => result.exitCode == 0
        Error(_) => return Error("neither curl nor wget is available to download ${url}")
      end
    end
    if !fetched
      FS.File.delete(partial)
      return Error("could not download ${url}")
    end
    return FS.File.rename(partial, path) then Ok(()) else Error("could not move the download into ${path}")
  end

  # The published `.sha256` is `<hash>  <filename>`, the format both
  # sha256sum and shasum write and read.
  foul verifyArchive(archive: String, checksumUrl: String) -> Void or! String do
    let checksums = "${archive}.sha256"
    Tey.Toolchain.download(checksumUrl, checksums).try
    let expected = match FS.File.read(checksums) do
      None => return Error("could not read ${checksums}")
      Just(text) => text.trim.split(" ").first.or("")
    end
    return Error("${checksumUrl} does not contain a checksum") if expected.empty?
    let actual = Tey.Toolchain.checksumOf(archive).try
    return Error("checksum mismatch for ${archive}: expected ${expected}, got ${actual}") if actual != expected
    return Ok(())
  end

  # Hashed with an external tool rather than read in: the archive is tens of
  # megabytes of binary, and this keeps all of it out of the process.
  foul checksumOf(path: String) -> String or! String do
    let output = match Process.run("sha256sum", [path]) do
      Ok(result) => result.exitCode == 0 then Just(result.stdout) else None
      Error(_) => match Process.run("shasum", ["-a", "256", path]) do
        Ok(result) => result.exitCode == 0 then Just(result.stdout) else None
        Error(_) => return Error("neither sha256sum nor shasum is available to verify ${path}")
      end
    end
    match output do
      None => return Error("could not hash ${path}")
      Just(text) => return Ok(text.trim.split(" ").first.or(""))
    end
  end

  # `arm64` and `x86_64` are the spellings the release archives use; uname
  # answers with those or with their aliases depending on the system.
  foul machineArchitecture -> String or! String do
    let result = Process.run("uname", ["-m"]).try
    return Error("could not determine this machine's architecture") if result.exitCode != 0
    let machine = result.stdout.trim
    return Ok("arm64") if machine == "arm64" || machine == "aarch64"
    return Ok("x86_64") if machine == "x86_64" || machine == "amd64"
    return Error("no Kex archives are published for ${machine}")
  end

  # Takes an installed Kex tree into the Tey home and selects it. `binary` is
  # the `bin/kex` of a complete CMake install tree — its stdlib and runtime sit
  # beside it and come along.
  #
  # A copy rather than a symlink: the seed belongs to whatever installed Tey,
  # and that installer will replace it on its own schedule. A link would leave a
  # toolchain directory named for one version quietly serving another after the
  # next `brew upgrade`.
  foul adopt(binary: String) -> String or! String do
    return Error("${binary} is not an executable Kex") if !FS.File.file?(binary)
    let version = Tey.Toolchain.versionOfBinary(binary).try
    let source = FS.Path.dirname(FS.Path.dirname(binary))
    let home = Tey.Toolchain.home
    let prefix = "${home}/toolchains/${version}"
    return Ok(prefix) if Tey.Toolchain.installed?(version)

    return Error("could not create Tey home") if !FS.Directory.create("${home}/toolchains")
    let staging = "${prefix}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    let copied = match Process.run("cp", ["-R", source, staging]) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(result) => result
    end
    if copied.exitCode != 0
      FS.Directory.deleteAll(staging)
      return Error("could not copy ${source} into the Tey home: ${copied.stderr}")
    end
    let installedPrefix = Tey.Toolchain.publish(staging, prefix).try
    return Error("adopted Kex ${version} but could not select it") if !FS.File.write("${home}/current", "${version}\n")
    Tey.Toolchain.link(version)
    return Ok(installedPrefix)
  end

  # `kex --version` prints "kex 0.3.0-beta (abc1234, built 2026-08-15)"; the
  # version is the second word. Asking the binary rather than reading a file
  # beside it keeps this honest about what will actually run.
  foul versionOfBinary(binary: String) -> String or! String do
    match Process.run(binary, ["--version"]) do
      Error(error) => return Error(error)
      Ok(result) => do
        return Error("${binary} --version failed: ${result.stderr}") if result.exitCode != 0
        match result.stdout.trim.split(" ").drop(1).first do
          None => return Error("could not read a version out of `${binary} --version`")
          Just(version) => do
            return Error("`${binary} --version` reported '${version}', which is not a version") if Tey.Semver.parseVersion(version) == None
            return Ok(version)
          end
        end
      end
    end
  end

  # Clones the repository at `version`'s tag into the build cache and returns
  # the checkout. Tags are tried as written and with a leading `v`, since
  # both spellings are common.
  foul fetchRelease(version: String) -> String or! String do
    return Error("could not create Tey build cache") if !FS.Directory.create(Tey.Cache.root)
    return Error("could not create Tey build cache") if !FS.Directory.create("${Tey.Cache.root}/src")
    let checkout = "${Tey.Cache.root}/src/kex-${version}"
    return Ok(checkout) if FS.Directory.directory?(checkout)
    let staging = "${checkout}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    let tag = Tey.Toolchain.releaseTag(version).try
    match Tey.Git.execute(["clone", "--depth", "1", "--branch", tag,
                           Tey.Toolchain.repository, staging]) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(_) => do
        return Ok(checkout) if FS.File.rename(staging, checkout)
        FS.Directory.deleteAll(staging)
        return Error("could not move the Kex ${version} checkout into place")
      end
    end
  end

  # The tag naming this version in the repository — `0.3.0` or `v0.3.0`.
  foul releaseTag(version: String) -> String or! String do
    let tags = Tey.Git.tags(Tey.Toolchain.repository).try
    return Ok(version) if tags.contains?(version)
    return Ok("v${version}") if tags.contains?("v${version}")
    return Error("Kex ${version} is not a released version")
  end

  # Points the shim at a version's binary, creating the bin directory the
  # first time. A symlink rather than a copy: `kex` finds its stdlib and
  # runtime relative to the REAL path, which the link preserves.
  foul link(version: String) -> Bool do
    return false if !FS.Directory.create(Tey.Toolchain.binDirectory)
    let target = Tey.Toolchain.binaryOf(version)
    return false if !FS.File.file?(target)
    match Process.run("ln", ["-sfn", target, Tey.Toolchain.shimPath]) do
      Error(_) => return false
      Ok(result) => return result.exitCode == 0
    end
  end

  # `v0.3.0` → Just("0.3.0"). A tag that is not a version is None, which
  # `collect` drops: a toolchain is named by its version, not by a label.
  let versionOf(tag: String) -> String? do
    let version = tag.startsWith?("v") then tag.drop(1) else tag
    return None if Tey.Semver.parseVersion(version) == None
    return Just(version)
  end

  # Swaps a finished staging tree in for `prefix`. A reinstall keeps the old
  # tree until the new one is in place and puts it back if the move fails, so
  # a failed upgrade leaves the previous toolchain working rather than none.
  foul publish(staging: String, prefix: String) -> String or! String do
    let previous = "${prefix}.previous"
    FS.Directory.deleteAll(previous) if FS.Directory.directory?(previous)
    let replacing = FS.Directory.directory?(prefix)
    if replacing && !FS.File.rename(prefix, previous)
      FS.Directory.deleteAll(staging)
      return Error("could not move the installed toolchain at ${prefix} aside")
    end
    if !FS.File.rename(staging, prefix)
      FS.File.rename(previous, prefix) if replacing
      FS.Directory.deleteAll(staging)
      return Error("could not move the new toolchain into ${prefix}")
    end
    FS.Directory.deleteAll(previous)
    return Ok(prefix)
  end
end
