module Tey.Sandbox

# What a plugin process may do besides reading files and computing.
#
# A plugin is code from a dependency, run on the user's machine. When the
# user approves what a plugin asks for, Tey runs it inside the operating
# system's sandbox so it can do no more:
#
# - it can write only under +writable+, plus the temporary directories and
#   the Kex cache that compiling and running it need;
# - it can use the network only when +network?+ is true;
# - it cannot read the usual places credentials are kept, such as +~/.ssh+.
#
# Every process the plugin starts has the same limits.
#
# Two permissions are coarser than they look. +Process.Run([...])+ is not
# enforced: the plugin can start any program, though that program has the
# same limits. +Net.Connect([...])+ opens the whole network, not just the
# listed hosts, because the sandbox filters by address and not by name.
record Limits do
  writable : [String] = []
  network? : Bool = false
end

# The path of macOS's +sandbox-exec+, the only sandbox supported so far. On
# other systems +available?+ is false, and a plugin runs only with
# +--unconfined+.
let TOOL = "/usr/bin/sandbox-exec"

# Returns +true+ when this system has the sandbox Tey uses.
foul available? -> Bool do
  return FS.File.exists?(Tey.Sandbox.TOOL)
end

# Returns the directories a Kex child process always needs to write to: the
# temporary directories and the Kex cache.
foul scratch -> [String] do
  let home = ENV.get("HOME").or("")
  let cache = match ENV.get("KEX_CACHE") do
    Just(configured) => configured
    None => match ENV.get("XDG_CACHE_HOME") do
      Just(xdg) => FS.Path.join(xdg, "kex")
      None => FS.Path.join(home, ".cache/kex")
    end
  end
  let named = ["/tmp", "/var/folders", ENV.get("TMPDIR").or("/tmp"), cache, "/dev"]
  return named.map { |path| Tey.Sandbox.real(path) }.uniq
end

# Returns the sandbox profile for +limits+. Later rules win, so the profile
# allows everything, denies network access and file writes, allows writes
# back under the writable paths, then denies reading credentials.
let profile(limits: Limits, home: String) -> String do
  let writable = limits.writable.map { |path| "(subpath ${Tey.Sandbox.quoted(path)})" }.join(" ")
  let secrets = [".ssh", ".aws", ".gnupg", ".config/gh", ".docker", "Library/Keychains"].map { |path|
    "(subpath ${Tey.Sandbox.quoted(FS.Path.join(home, path))})"
  }.join(" ")
  let network = limits.network? then "" else "(deny network*)"
  let lines = [
    "(version 1)",
    "(allow default)",
    network,
    "(deny file-write*)",
    "(allow file-write* ${writable})",
    "(deny file-read* ${secrets} (literal ${Tey.Sandbox.quoted(FS.Path.join(home, ".netrc"))}))"
  ]
  return lines.reject { |line| line == "" }.join("\n") + "\n"
end

# Returns the words to put in front of a command line to run it under
# +limits+, +sandbox-exec -f <profile>+, and the profile's path. The caller
# deletes the profile once the child has exited. Fails when no sandbox is
# available or the profile cannot be written.
foul prefix(limits: Limits) -> ([String], String) or! String do
  if !Tey.Sandbox.available?
    return Error("this system has no sandbox Tey can use (macOS `sandbox-exec`), so the plugin cannot be confined; pass --unconfined to run it with your full access")
  end
  let confined = Limits { writable: [...Tey.Sandbox.scratch, ...limits.writable.map { |path| Tey.Sandbox.real(path) }],
                          network?: limits.network? }
  let file = FS.Path.join(ENV.get("TMPDIR").or("/tmp"), "tey-sandbox-${DateTime.now().iso.replace(":", "-")}.sb")
  let text = Tey.Sandbox.profile(confined, ENV.get("HOME").or(""))
  return Error("could not write the sandbox profile to `${file}`") if FS.File.write(file, text).error?
  return Ok(([Tey.Sandbox.TOOL, "-f", file], file))
end

private do
  let quoted(path: String) -> String do
    return "\"${path.replace("\\", "\\\\").replace("\"", "\\\"")}\""
  end

  # The path with every symlink resolved: the sandbox matches real paths, and
  # /tmp and /var are links on macOS. A path that does not exist is kept.
  foul real(path: String) -> String do
    match Process.run("realpath", ["--", path]) do
      Ok(result) => do
        let resolved = result.stdout.trim
        return result.exitCode == 0 && resolved != "" then resolved else path
      end
      Error(_) => return path
    end
  end
end
