module Tey.Snapshot

using Tey.Manifest, only: [ManifestPackage]
using Tey.Plugin, only: [approved?]

# Turns a path dependency into an immutable, content-addressed cache entry.
# The declared path remains in the lockfile for explanation; builds use the
# snapshot identified by `sha256`, never the live directory.
foul create(name: String, declaredPath: String,
            declaringRoot: String) -> Tey.Lockfile.Dependency or! String do
  let source = if FS.Path.absolute?(declaredPath)
    FS.Path.normalize(declaredPath)
  else
    FS.Path.join(declaringRoot, declaredPath)
  end
  return Error("path dependency `${name}` does not exist at ${source}") if !FS.Directory.directory?(source)
  Tey.Snapshot.validateSymlinks(source).try
  let sourceManifest = match FS.File.read(FS.Path.join(source, "package.kex")) do
    Error(_) => return Error("path dependency `${name}` has no package.kex")
    Ok(text) => match Tey.Manifest.read(text) do
      Error(error) => return Error("path dependency `${name}` has an unreadable package.kex: ${error}")
      Ok(package) => package
    end
  end
  return Error("path dependency `${name}` declares package `${sourceManifest.name}`") if sourceManifest.name != name
  let files = Tey.Snapshot.includedFiles(source)
  let (sha, destination) = Tey.Snapshot.publishSnapshot(source, files).try
  let manifest = match FS.File.read(FS.Path.join(destination, "package.kex")) do
    Error(_) => return Error("staged path dependency `${name}` has no package.kex")
    Ok(text) => match Tey.Manifest.read(text) do
      Error(error) => return Error("staged path dependency `${name}` has an unreadable package.kex: ${error}")
      Ok(package) => package
    end
  end
  return Error("staged path dependency `${name}` declares package `${manifest.name}`") if manifest.name != name
  let dependencyNames = manifest.manifestDependencies.map do |dependency|
    dependency.manifestName
  end
  let snapshot = Tey.Lockfile.Dependency {
    name: name, version: manifest.version, source: "path",
    path: declaredPath, sha256: sha, dependencies: dependencyNames,
    pluginFingerprints: Tey.Plugin.fingerprints(manifest.plugins)
  }
  return Ok(snapshot)
end

foul cachedPath(dependency: Tey.Lockfile.Dependency) -> String do
  return FS.Path.join(Tey.Cache.root, "snapshots", dependency.sha256)
end

foul verify(dependency: Tey.Lockfile.Dependency) -> String or! String do
  let path = Tey.Snapshot.cachedPath(dependency)
  return Error("${dependency.name} is not present in the snapshot cache") if !FS.Directory.directory?(path)
  let actual = Tey.Snapshot.digest(path).try
  return Ok(path) if actual == dependency.sha256
  return Error("content hash mismatch for ${dependency.name}: expected ${dependency.sha256}, got ${actual}")
end

private do
  let excludedNames = [".git", ".hg", ".svn", ".tey", ".cache", ".DS_Store",
                       "build", "build-wasm", "_build", "dist", "ebin",
                       "node_modules", "erl_crash.dump", "package.local.kex",
                       "tey.lock"]

  foul ignorePatterns(root: String) -> [String] do
    match FS.File.read(FS.Path.join(root, ".teyignore")) do
      Error(_) => return []
      Ok(text) => return text.lines.map { |line| line.trim }
        .filter { |line| !line.empty? && !line.startsWith?("#") }
    end
  end

  foul includedFiles(root: String) -> [String] do
    return Tey.Snapshot.files(root, root, Tey.Snapshot.ignorePatterns(root)).sort
  end

  foul digest(root: String) -> String or! String do
    let fingerprints = Tey.Snapshot.includedFiles(root).map do |relative|
      match Tey.Snapshot.entryFingerprint(root, relative) do
        Error(error) => return Error(error)
        Ok(value) => value
      end
    end
    return Ok(Digest.sha256(fingerprints.join("\n--\n")))
  end

  foul entryFingerprint(root: String, relative: String) -> String or! String do
    let path = FS.Path.join(root, relative)
    match Process.run("readlink", ["--", path]) do
      Ok(result) when result.exitCode == 0 => do
        return Ok("${relative}\nlink\n${result.stdout.trim}")
      end
      _ => do
        let bytes = FS.File.readBytes(path).try
        return Ok("${relative}\nfile\n${Digest.sha256(bytes).hex}")
      end
    end
  end

  foul files(root: String, directory: String, ignores: [String]) -> [String] do
    let fileNames = FS.Directory.files(directory).or([]).filter do |name|
      let relative = FS.Path.relativeTo(FS.Path.join(directory, name), root)
      let includedName = !Tey.Snapshot.excludedNames.contains?(name)
      includedName && !Tey.Snapshot.ignored?(relative, ignores)
    end
    let directoryCandidates = FS.Directory.directories(directory).or([])
      .filter do |name|
        let relative = FS.Path.relativeTo(FS.Path.join(directory, name), root)
        let includedName = !Tey.Snapshot.excludedNames.contains?(name)
        includedName && !Tey.Snapshot.ignored?(relative, ignores)
      end
    let linkNames = directoryCandidates.filter do |name|
      Tey.Snapshot.symlink?(FS.Path.join(directory, name))
    end
    let here = [...fileNames, ...linkNames].uniq.map do |name|
      FS.Path.relativeTo(FS.Path.join(directory, name), root)
    end
    let directoryNames = directoryCandidates.filter do |name|
      !linkNames.contains?(name)
    end
    let groups: [[String]] = directoryNames.map do |name|
      Tey.Snapshot.files(root, FS.Path.join(directory, name), ignores)
    end
    let empty: [String] = []
    return [...here, ...groups.reduce(empty) { |all, group| [...all, ...group] }]
  end

  foul symlink?(path: String) -> Bool do
    match Process.run("readlink", ["--", path]) do
      Ok(result) => return result.exitCode == 0
      Error(_) => return false
    end
  end

  let ignored?(path: String, patterns: [String]) -> Bool do
    return patterns.any? do |raw|
      let anchored = raw.startsWith?("/")
      let withoutRoot = raw.startsWith?("/") then raw.drop(1) else raw
      let pattern = if withoutRoot.endsWith?("/")
        withoutRoot.take(withoutRoot.count - 1)
      else
        withoutRoot
      end
      let nested = path.startsWith?("${pattern}/")
      let glob = Tey.Snapshot.matches(FS.Path.segments(path),
                                      FS.Path.segments(pattern))
      let basename = (!anchored && !pattern.contains?("/") &&
                      FS.Path.segments(path).any? do |segment|
                        Tey.Snapshot.segmentMatches(segment.chars, pattern.chars)
                      end)
      path == pattern || nested || glob || basename
    end
  end

  let matches([], []) -> Bool = true
  let matches(path, ["**"]) -> Bool = true
  let matches(_, []) -> Bool = false
  let matches([], _) -> Bool = false
  let matches(path: [String], pattern: [String]) -> Bool do
    let wanted = pattern.first.try
    if wanted == "**"
      return true if Tey.Snapshot.matches(path, pattern.drop(1))
      return Tey.Snapshot.matches(path.drop(1), pattern)
    end
    return false if !Tey.Snapshot.segmentMatches(path.first.try.chars,
                                                  wanted.chars)
    return Tey.Snapshot.matches(path.drop(1), pattern.drop(1))
  end

  let segmentMatches([], []) -> Bool = true
  let segmentMatches(_, []) -> Bool = false
  let segmentMatches([], pattern: [Char]) -> Bool do
    return pattern.all? { |character| character == '*' }
  end
  let segmentMatches(text: [Char], pattern: [Char]) -> Bool do
    if pattern.first.try == '*'
      return true if Tey.Snapshot.segmentMatches(text, pattern.drop(1))
      return Tey.Snapshot.segmentMatches(text.drop(1), pattern)
    end
    return false if text.first.try != pattern.first.try
    return Tey.Snapshot.segmentMatches(text.drop(1), pattern.drop(1))
  end

  foul publishSnapshot(source: String,
                       files: [String]) -> (String, String) or! String do
    let snapshots = FS.Path.join(Tey.Cache.root, "snapshots")
    return Error("could not create snapshot cache") if !FS.Directory.create(Tey.Cache.root)
    return Error("could not create snapshot cache") if !FS.Directory.create(snapshots)
    let nonce = Digest.sha256("${source}:${DateTime.epochNanos()}")
    let staging = FS.Path.join(snapshots, ".partial.${nonce}")
    return Error("could not stage path dependency") if !FS.Directory.create(staging)
    files.each do |relative|
      let target = FS.Path.join(staging, relative)
      let directoryReady = FS.Directory.create(FS.Path.dirname(target))
      let copied = match Process.run("cp", ["-a", "--", FS.Path.join(source, relative), target]) do
        Ok(result) => result.exitCode == 0
        Error(_) => false
      end
      if !directoryReady || !copied
        FS.Directory.deleteAll(staging)
        return Error("could not snapshot ${relative}")
      end
    end
    match Tey.Snapshot.validateSymlinks(staging) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(_) => ()
    end
    let sha = match Tey.Snapshot.digest(staging) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(value) => value
    end
    let destination = FS.Path.join(snapshots, sha)
    if FS.Directory.directory?(destination)
      FS.Directory.deleteAll(staging)
      let actual = Tey.Snapshot.digest(destination).try
      if actual != sha
        return Error("cached path dependency snapshot `${sha}` is corrupted")
      end
      return Ok((sha, destination))
    end
    return Ok((sha, destination)) if FS.File.rename(staging, destination)
    # A concurrent resolver may have published the same content-addressed
    # snapshot first. Its directory is exactly our result; discard only our
    # unpublished sibling rather than moving it inside the winner.
    FS.Directory.deleteAll(staging)
    if FS.Directory.directory?(destination)
      let winningDigest = Tey.Snapshot.digest(destination).try
      if winningDigest == sha
        return Ok((sha, destination))
      end
      return Error("cached path dependency snapshot `${sha}` is corrupted")
    end
    return Error("could not publish path dependency snapshot")
  end


  foul validateSymlinks(root: String) -> Void or! String do
    let canonicalRoot = match Process.run("realpath", ["--", root]) do
      Ok(result) => if result.exitCode == 0
        result.stdout.trim
      else
        return Error("could not resolve path dependency root ${root}")
      end
      Error(error) => return Error(error)
    end
    let links = match Process.run("find", [root, "-type", "l", "-print"]) do
      Ok(result) => do
        return Error("could not inspect path dependency symlinks") if result.exitCode != 0
        result.stdout.lines
      end
      Error(error) => return Error(error)
    end
    return Tey.Snapshot.validateLinkTargets(links, canonicalRoot)
  end

  foul validateLinkTargets(links: [String], canonicalRoot: String) -> Void or! String do
    return Ok(()) if links.empty?
    let link = links.first.try
    let target = match Process.run("realpath", ["--", link]) do
      Ok(result) => if result.exitCode == 0
        result.stdout.trim
      else
        return Error("path snapshot contains a broken symlink `${link}`")
      end
      Error(error) => return Error(error)
    end
    if target != canonicalRoot && !target.startsWith?("${canonicalRoot}/")
      return Error("path snapshot symlink `${link}` escapes the package directory")
    end
    return Tey.Snapshot.validateLinkTargets(links.drop(1), canonicalRoot)
  end
end
