module Tey.Snapshot

using Tey.Lockfile, only: [Dependency]
using Tey.Manifest, only: [ManifestPackage]

# Turns a path dependency into an immutable, content-addressed cache entry.
# The declared path remains in the lockfile for explanation; builds use the
# snapshot identified by `sha256`, never the live directory.
foul create(name: String, declaredPath: String,
            declaringRoot: String) -> Dependency or! String do
  let source = if FS.Path.absolute?(declaredPath)
    FS.Path.normalize(declaredPath)
  else
    FS.Path.join(declaringRoot, declaredPath)
  end
  return Error("path dependency `${name}` does not exist at ${source}") if !FS.Directory.directory?(source)
  let manifest = match FS.File.read(FS.Path.join(source, "package.kex")) do
    Error(_) => return Error("path dependency `${name}` has no package.kex")
    Ok(text) => match Tey.Manifest.read(text) do
      Error(error) => return Error("path dependency `${name}` has an unreadable package.kex: ${error}")
      Ok(package) => package
    end
  end
  return Error("path dependency `${name}` declares package `${manifest.name}`") if manifest.name != name
  let ignores = Tey.Snapshot.ignorePatterns(source)
  let files = Tey.Snapshot.files(source, source, ignores).sort
  let fingerprints = files.map do |relative|
    let digest = Digest.fileSha256(FS.Path.join(source, relative)).try
    "${relative}\n${digest}"
  end
  let sha = Digest.sha256(fingerprints.join("\n--\n"))
  let destination = FS.Path.join(Tey.Cache.root, "snapshots", sha)
  if !FS.Directory.directory?(destination)
    Tey.Snapshot.publish(source, files, destination).try
  end
  return Ok(Dependency { name: name, version: manifest.version, source: "path",
                         path: declaredPath, sha256: sha,
                         dependencies: manifest.manifestDependencies.map do |dep|
                           dep.manifestName
                         end })
end

foul cachedPath(dependency: Dependency) -> String do
  return FS.Path.join(Tey.Cache.root, "snapshots", dependency.sha256)
end

private do
  let excludedNames = [".git", ".tey", "build", "ebin", "erl_crash.dump",
                       "package.local.kex", "tey.lock"]

  foul ignorePatterns(root: String) -> [String] do
    match FS.File.read(FS.Path.join(root, ".teyignore")) do
      Error(_) => return []
      Ok(text) => return text.lines.map { |line| line.trim }
        .filter { |line| !line.empty? && !line.startsWith?("#") }
    end
  end

  foul files(root: String, directory: String, ignores: [String]) -> [String] do
    let fileNames = FS.Directory.files(directory).or([]).filter do |name|
      let relative = FS.Path.relativeTo(FS.Path.join(directory, name), root)
      let includedName = !Tey.Snapshot.excludedNames.contains?(name)
      includedName && !Tey.Snapshot.ignored?(relative, ignores)
    end
    let here = fileNames.map do |name|
      FS.Path.relativeTo(FS.Path.join(directory, name), root)
    end
    let directoryNames = FS.Directory.directories(directory).or([]).filter do |name|
      let relative = FS.Path.relativeTo(FS.Path.join(directory, name), root)
      let includedName = !Tey.Snapshot.excludedNames.contains?(name)
      includedName && !Tey.Snapshot.ignored?(relative, ignores)
    end
    let groups: [[String]] = directoryNames.map do |name|
      Tey.Snapshot.files(root, FS.Path.join(directory, name), ignores)
    end
    let empty: [String] = []
    return [...here, ...groups.reduce(empty) { |all, group| [...all, ...group] }]
  end

  let ignored?(path: String, patterns: [String]) -> Bool do
    return patterns.any? do |raw|
      let withoutRoot = raw.startsWith?("/") then raw.drop(1) else raw
      let pattern = if withoutRoot.endsWith?("/")
        withoutRoot.take(withoutRoot.count - 1)
      else
        withoutRoot
      end
      let nested = path.startsWith?("${pattern}/")
      let glob = Tey.Snapshot.matches(FS.Path.segments(path),
                                      FS.Path.segments(pattern))
      path == pattern || nested || glob
    end
  end

  let matches([], []) -> Bool = true
  let matches(_, []) -> Bool = false
  let matches([], _) -> Bool = false
  let matches(path: [String], pattern: [String]) -> Bool do
    let wanted = pattern.first.try
    return Tey.Snapshot.matches(path.drop(1), pattern.drop(1)) if wanted == "*"
    return false if wanted != path.first.try
    return Tey.Snapshot.matches(path.drop(1), pattern.drop(1))
  end

  foul publish(source: String, files: [String], destination: String) -> String or! String do
    let snapshots = FS.Path.dirname(destination)
    return Error("could not create snapshot cache") if !FS.Directory.create(Tey.Cache.root)
    return Error("could not create snapshot cache") if !FS.Directory.create(snapshots)
    let staging = "${destination}.partial"
    FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)
    return Error("could not stage path dependency") if !FS.Directory.create(staging)
    files.each do |relative|
      let target = FS.Path.join(staging, relative)
      let directoryReady = FS.Directory.create(FS.Path.dirname(target))
      let copied = FS.File.copy(FS.Path.join(source, relative), target)
      if !directoryReady || !copied
        FS.Directory.deleteAll(staging)
        return Error("could not snapshot ${relative}")
      end
    end
    return Ok(destination) if FS.File.rename(staging, destination)
    FS.Directory.deleteAll(staging)
    return Ok(destination) if FS.Directory.directory?(destination)
    return Error("could not publish path dependency snapshot")
  end
end
