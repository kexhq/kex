# Records what Tey has installed in +${TEY_HOME}/bin+, and which package
# owns each file there.
#
# Every package whose targets Tey installs gets a receipt at
# +${TEY_HOME}/programs/<name>/receipt.json+. Ownership is decided by the
# receipts alone: a file in the bin directory that no receipt lists is not
# Tey's to overwrite or delete, and a second package declaring a target name
# that another package installed is refused unless +--force+ is given.
#
# Receipts are kept per package, not per program: one package can install
# several targets, and reinstalling or removing it acts on all of them.
module Tey.Programs

using JSON

record Receipt do
  name : String
  version : String = ""
  # Where the program was built from: +"path"+ for a checkout on this
  # machine, +"git"+ for a repository. +sourcePath+ holds the directory or
  # the repository URL.
  sourceKind : String = "path"
  sourcePath : String = ""
  # The content digest of the tree the program was built from (see
  # +Tey.Snapshot.contentDigest+), so reinstalling an unchanged path can say
  # there is nothing to do. Empty for a project's own +tey install+, which
  # builds in place.
  sourceDigest : String = ""
  # A Git source's pin: the selector (+tag+, +branch+ or +ref+), the name
  # that was asked for, and the commit it resolved to. Empty for a path.
  sourceSelector : String = ""
  sourceRequested : String = ""
  sourceCommit : String = ""
  # The targets +--target+ limited the install to, so an update installs the
  # same ones. Empty when every target was installed.
  selectedTargets : [String] = []
  targets : [String] = []
  kex : String = ""
  otp : String = ""
  installedAt : String = ""
end

# The options +tey install <argument>+ was given: the workspace member
# (+--package+), the Git pin (+--tag+, +--branch+ or +--ref+; a +ref+ of
# +HEAD+ when none is given), the targets (+--target+; all of them when
# empty), whether to take over names other packages own (+--force+), and
# whether to resolve dependencies again instead of using the program's
# committed lock (+--fresh+).
#
# +pinned?+ is true when any pin was given; reinstalling by name keeps the
# receipt's pin otherwise. +rebuild?+ forces a rebuild even when nothing has
# changed.
record InstallOptions do
  packageName : String = ""
  force? : Bool = false
  selector : String = "ref"
  requested : String = "HEAD"
  pinned? : Bool = false
  targets : [String] = []
  fresh? : Bool = false
  rebuild? : Bool = false
  # +--approve-plugins+: approves the program's plugins without asking.
  approvePlugins? : Bool = false
end

# Returns the message explaining why reinstalling +receipt+ by name has
# nothing to do, or +None+ when it has to be rebuilt.
#
# A program pinned to a tag or an exact commit stays where the user put it,
# and the message says how to move it. A branch, or +HEAD+, is rebuilt.
let pinnedReason(receipt: Receipt, options: InstallOptions) -> String? do
  return None if options.rebuild? || options.pinned? || receipt.sourceKind != "git"
  let exact = receipt.sourceSelector == "ref" && receipt.sourceRequested != "HEAD"
  return None if receipt.sourceSelector != "tag" && !exact
  return Just("${receipt.name} is pinned at ${Tey.Programs.pinText(receipt)}; pass --tag, --branch or --ref to move it")
end

# What the argument to +tey install+ names: a path, a Git URL or the name of
# an installed program. It always names a program; dependencies are added
# with +tey add+.
type ProgramSource =
  | PathSource(String)
  | GitSource(String)
  | InstalledName(String)

# What installing one target name would do to the bin directory: the name is
# free, already this package's, an old Tey-built file to adopt, reserved for
# Tey, owned by another package, or a file Tey did not install.
type Claim =
  | Free
  | Mine
  | Adopt
  | Reserved
  | OwnedBy(String)
  | Foreign

# Returns the target names no package may take. The +kex+ shim lives in the
# bin directory, and replacing it would change which compiler every shell
# runs.
let reservedNames -> [String] = ["kex"]

foul directory -> String do
  return "${Tey.Toolchain.home}/programs"
end

# Decides what +argument+ names: a path when it starts with +.+, +/+ or +~+,
# a Git URL when it has a scheme or looks like +git@host:owner/repo+, and
# otherwise the name of an installed program.
let classify(argument: String) -> ProgramSource do
  let pathLike = [".", "/", "~"].any? { |prefix| argument.startsWith?(prefix) }
  return PathSource(argument) if pathLike
  let scpLike = argument.contains?("@") && argument.contains?(":")
  return GitSource(argument) if argument.contains?("://") || scpLike
  return InstalledName(argument)
end

# Returns the directory that holds a program's build tree once it is
# installed.
foul buildDirectory(name: String) -> String do
  return FS.Path.join(Tey.Programs.directory, name, "build")
end

# Creates a new, empty directory to build a program in before it is
# installed.
#
# It sits beside +programs/+, so a half-built tree is never listed as a
# program, and on the same filesystem, so installing it is a rename.
foul stagingDirectory -> String or! String do
  let root = FS.Path.join(Tey.Toolchain.home, "staging")
  return Error("could not create ${root}") if !FS.Directory.create(root).ok?
  let nonce = Digest.sha256("${DateTime.epochNanos()}").take(16)
  let path = FS.Path.join(root, nonce)
  return Error("could not create ${path}") if !FS.Directory.create(path).ok?
  return Ok(path)
end

# Copies the tree at +root+ into +destination+: the files a snapshot would
# hold, plus a committed +tey.lock+, which a snapshot leaves out. The lock
# holds the dependency versions the program's author tested.
foul stage(root: String, destination: String) -> Void or! String do
  let lock = FS.File.file?(FS.Path.join(root, "tey.lock")) then ["tey.lock"] else []
  let files = [...Tey.Snapshot.sourceFiles(root), ...lock]
  let failed = files.find do |relative|
    Tey.Programs.copyInto(root, relative, destination).error?
  end
  match failed do
    Just(relative) => return Error("could not copy ${relative} from ${root}")
    None => return Ok(())
  end
end

foul copyInto(root: String, relative: String, destination: String) -> Void or! String do
  let target = FS.Path.join(destination, relative)
  return Error("could not create ${FS.Path.dirname(target)}") if !FS.Directory.create(FS.Path.dirname(target)).ok?
  match Process.run("cp", ["-a", "--", FS.Path.join(root, relative), target]) do
    Ok(result) => return result.exitCode == 0 then Ok(()) else Error("could not copy ${relative} from ${root}")
    Error(_) => return Error("could not run cp")
  end
end

# Replaces a program's build tree with the staged one it was just built in.
#
# The old tree is moved aside first and deleted last, so if a step fails,
# one of the two trees is still in place.
foul publishBuild(name: String, staged: String) -> Void or! String do
  let destination = Tey.Programs.buildDirectory(name)
  return Error("could not create ${FS.Path.dirname(destination)}") if !FS.Directory.create(FS.Path.dirname(destination)).ok?
  let previous = "${destination}.old"
  FS.Directory.deleteAll(previous)
  if FS.Directory.directory?(destination) && !FS.File.rename(destination, previous).ok?
    return Error("could not replace ${destination}")
  end
  if !FS.File.rename(staged, destination).ok?
    FS.File.rename(previous, destination)
    return Error("could not publish ${destination}")
  end
  FS.Directory.deleteAll(previous)
  return Ok(())
end

foul receiptPath(name: String) -> String do
  return FS.Path.join(Tey.Programs.directory, name, "receipt.json")
end

let encode(receipt: Receipt) -> String do
  return JSON.stringify({
    name: receipt.name,
    version: receipt.version,
    source: { kind: receipt.sourceKind, path: receipt.sourcePath,
              sha256: receipt.sourceDigest, selector: receipt.sourceSelector,
              requested: receipt.sourceRequested, commit: receipt.sourceCommit },
    targets: receipt.targets,
    selected: receipt.selectedTargets,
    kex: receipt.kex,
    otp: receipt.otp,
    installedAt: receipt.installedAt
  }) + "\n"
end

let decode(text: String) -> Receipt or! String do
  let root = match JSON.parse(text) do
    Error(_) => return Error("invalid receipt JSON")
    Ok(value) => JSON.fields(value)
  end
  let name = Tey.Programs.text(root["name"])
  return Error("receipt has no package name") if name == ""
  let source = root["source"]
  return Ok(Receipt {
    name: name,
    version: Tey.Programs.text(root["version"]),
    sourceKind: Tey.Programs.text(Tey.Programs.field(source, "kind")),
    sourcePath: Tey.Programs.text(Tey.Programs.field(source, "path")),
    sourceDigest: Tey.Programs.text(Tey.Programs.field(source, "sha256")),
    sourceSelector: Tey.Programs.text(Tey.Programs.field(source, "selector")),
    sourceRequested: Tey.Programs.text(Tey.Programs.field(source, "requested")),
    sourceCommit: Tey.Programs.text(Tey.Programs.field(source, "commit")),
    targets: Tey.Programs.strings(root["targets"]),
    selectedTargets: Tey.Programs.strings(root["selected"]),
    kex: Tey.Programs.text(root["kex"]),
    otp: Tey.Programs.text(root["otp"]),
    installedAt: Tey.Programs.text(root["installedAt"])
  })
end

# Decides what installing +target+ for +packageName+ would do, given every
# receipt and whether a file of that name already exists.
#
# +teyBuilt?+ covers programs that a project's own +tey install+ put in the
# bin directory before receipts existed. Tey wrote those itself, so they are
# adopted into the receipt; refusing them would make every such installation
# need +--force+ on its next reinstall.
let claim(target: String, packageName: String, receipts: [Receipt],
          exists?: Bool, teyBuilt?: Bool) -> Claim do
  return Reserved if Tey.Programs.reservedNames.contains?(target)
  let owner = receipts.find do |receipt|
    receipt.targets.contains?(target)
  end
  match owner do
    Just(receipt) => do
      return Mine if receipt.name == packageName
      return OwnedBy(receipt.name)
    end
    None => ()
  end
  return Free if !exists?
  return Adopt if teyBuilt?
  return Foreign
end

# Returns the message explaining why +claim+ stops the install, or +None+
# when it can go ahead.
#
# +--force+ takes a name over from another package or from a file Tey did
# not install, but never a name reserved for Tey.
let refusal(target: String, claim: Claim, path: String, force?: Bool) -> String? do
  match claim do
    Reserved => Just("`${target}` is reserved for Tey's own launcher; rename the target")
    OwnedBy(owner) when !force? => Just("`${target}` is already installed by `${owner}`; pass --force to take it over")
    Foreign when !force? => Just("${path} already exists and was not installed by Tey; pass --force to replace it")
    _ => None
  end
end

foul load(name: String) -> Receipt? do
  match FS.File.read(Tey.Programs.receiptPath(name)) do
    Error(_) => None
    Ok(text) => match Tey.Programs.decode(text) do
      Error(_) => None
      Ok(receipt) => Just(receipt)
    end
  end
end

# Returns every receipt, sorted by package name.
#
# A receipt that cannot be parsed is skipped with a warning on stderr, since
# skipping it quietly would make the files it owns look unowned. A receipt
# file that cannot be read at all is skipped without one.
foul all -> [Receipt] do
  let names = FS.Directory.directories(Tey.Programs.directory).or([]).sort
  return names.into do |name|
    let path = Tey.Programs.receiptPath(name)
    match FS.File.read(path) do
      Error(_) => []
      Ok(text) => match Tey.Programs.decode(text) do
        Ok(receipt) => [receipt]
        Error(error) => do
          IO.printError("${Console.YELLOW}warning:${Console.RESET} ignoring ${path}: ${error}")
          []
        end
      end
    end
  end
end

# Writes +receipt+ to its file.
#
# The receipt is written to a file beside it and renamed into place, so a
# reader never sees half a receipt and a failed write leaves the old one
# intact.
foul save(receipt: Receipt) -> Void or! String do
  let path = Tey.Programs.receiptPath(receipt.name)
  let staging = "${path}.new"
  return Error("could not create ${FS.Path.dirname(path)}") if !FS.Directory.create(FS.Path.dirname(path)).ok?
  return Error("could not write ${staging}") if FS.File.write(staging, Tey.Programs.encode(receipt)).error?
  return Error("could not write ${path}") if !FS.File.rename(staging, path).ok?
  return Ok(())
end

foul remove(name: String) -> Void or! String do
  let path = FS.Path.join(Tey.Programs.directory, name)
  return FS.Directory.deleteAll(path).ok? then Ok(()) else Error("could not remove ${path}")
end

# Returns whether +path+ is an escript that Tey's target build wrote: its
# emulator line starts Kex's escript launcher, or names +kex_main+ directly,
# as escripts built before the launcher existed do.
foul teyBuilt?(path: String) -> Bool do
  match Process.run("head", ["-n", "2", "--", path]) do
    Error(_) => false
    Ok(result) => do
      let header = result.stdout
      # `kex_escript` is the runtime's launcher every escript starts in since
      # kexhq/kex#406; `kex_main` is what one written before it names.
      let entry = header.contains?("-escript main kex_escript") || header.contains?("-escript main kex_main")
      result.exitCode == 0 && header.startsWith?("#!") && entry
    end
  end
end

# Returns the line +tey list+ prints for one installed program.
let listLine(receipt: Receipt) -> String do
  let version = receipt.version == "" then "" else " ${receipt.version}"
  let pin = receipt.sourceKind != "git" then "" else " @ ${Tey.Programs.pinText(receipt)}"
  return "${receipt.name}${version} (${receipt.targets.join(", ")}) from ${receipt.sourcePath}${pin}"
end

# Returns what a Git install is pinned to, as +tey list+ shows it: a tag
# such as +v0.4.0+, a branch or ref with its commit such as
# +main (3f9c1a2)+, or a short commit id when an exact commit was asked for.
let pinText(receipt: Receipt) -> String do
  let short = receipt.sourceCommit.take(7)
  return receipt.sourceRequested if receipt.sourceSelector == "tag"
  return short if receipt.sourceRequested == receipt.sourceCommit
  return "${receipt.sourceRequested} (${short})"
end

private do
  let text(None) -> String = ""
  let text(Just(value)) -> String = "${value}"

  let field(None, _) = None
  let field(Just(block), key: String) = block[key]

  let strings(None) -> [String] = []
  let strings(Just(values)) -> [String] = values.map { |value| "${value}" }
end
