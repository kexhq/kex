# What Tey has put in `${TEY_HOME}/bin`, and who owns each file there.
#
# Every package whose targets Tey installs gets a receipt at
# `${TEY_HOME}/programs/<name>/receipt.json`. The receipt is the only
# authority for ownership: a file in the bin directory that no receipt lists
# is not Tey's to overwrite or delete. Without one, a second package declaring
# the same target name silently replaced the first package's program, and
# nothing could say what a file in there was or where it had come from.
#
# Keyed by PACKAGE, not by binary: one package may install several targets,
# and reinstalling or removing it acts on all of them together.
module Tey.Programs

using JSON

record Receipt do
  name : String
  version : String = ""
  # Where the program was built from. Only "path" (a checkout on this
  # machine) for now; Git sources add their URL, selector and commit here.
  sourceKind : String = "path"
  sourcePath : String = ""
  # The content digest of the tree the program was built from (see
  # Tey.Snapshot.contentDigest), so reinstalling an unchanged path can say
  # so. Empty for a project's own `tey install`, which builds in place.
  sourceDigest : String = ""
  # A Git source's pin, as `--tag`, `--branch` or `--ref` asked for it, and
  # the commit that resolved to. Empty for a path.
  sourceSelector : String = ""
  sourceRequested : String = ""
  sourceCommit : String = ""
  # The targets `--target` limited the install to, so updating it installs
  # the same ones; empty when every target was installed.
  selectedTargets : [String] = []
  targets : [String] = []
  kex : String = ""
  otp : String = ""
  installedAt : String = ""
end

# How `tey install <argument>` was asked to install a program: the workspace
# member (`--package`), the Git pin (`--tag`/`--branch`/`--ref`, "ref" of
# "HEAD" when none), which targets (`--target`, all when empty), whether to
# take over others' programs (`--force`), and whether to re-resolve rather
# than use the program's committed lock (`--fresh`).
#
# `pinned?` says a pin was given at all — reinstalling by name keeps the
# receipt's unless one is. `rebuild?` rebuilds even when nothing moved.
record InstallOptions do
  packageName : String = ""
  force? : Bool = false
  selector : String = "ref"
  requested : String = "HEAD"
  pinned? : Bool = false
  targets : [String] = []
  fresh? : Bool = false
  rebuild? : Bool = false
end

# Why reinstalling `receipt` by name has nothing to do, or None when it must
# be rebuilt. A tag or an exact commit is a pin the user chose: it stays,
# with a pointer at moving it. Pure, so the whole rule is testable.
let pinnedReason(receipt: Receipt, options: InstallOptions) -> String? do
  return None if options.rebuild? || options.pinned? || receipt.sourceKind != "git"
  let exact = receipt.sourceSelector == "ref" && receipt.sourceRequested != "HEAD"
  return None if receipt.sourceSelector != "tag" && !exact
  return Just("${receipt.name} is pinned at ${Tey.Programs.pinText(receipt)}; pass --tag, --branch or --ref to move it")
end

# What `tey install <argument>` names. `tey add` is how a dependency is added,
# so an argument to `tey install` always means a program.
type ProgramSource =
  | PathSource(String)
  | GitSource(String)
  | InstalledName(String)

# What installing one target name would do to the bin directory.
type Claim =
  | Free
  | Mine
  | Adopt
  | Reserved
  | OwnedBy(String)
  | Foreign

# Names that are Tey's own and never a package's to take: the `kex` shim
# lives in this directory, and replacing it would change which compiler every
# shell runs.
let reservedNames -> [String] = ["kex"]

foul directory -> String do
  return "${Tey.Toolchain.home}/programs"
end

# A path when it starts like one (`.`, `/`, `~`), a Git URL when it has a
# scheme or is scp-like (`git@host:owner/repo`), and otherwise the name of an
# installed program.
let classify(argument: String) -> ProgramSource do
  let pathLike = [".", "/", "~"].any? { |prefix| argument.startsWith?(prefix) }
  return PathSource(argument) if pathLike
  let scpLike = argument.contains?("@") && argument.contains?(":")
  return GitSource(argument) if argument.contains?("://") || scpLike
  return InstalledName(argument)
end

# Where a program's staged build tree ends up once it is installed.
foul buildDirectory(name: String) -> String do
  return FS.Path.join(Tey.Programs.directory, name, "build")
end

# A fresh directory to build a program in before it is installed. Beside
# `programs/` rather than in it, so a half-built tree is never listed as a
# program, and on the same filesystem, so publishing it is a rename.
foul stagingDirectory -> String or! String do
  let root = FS.Path.join(Tey.Toolchain.home, "staging")
  return Error("could not create ${root}") if !FS.Directory.create(root)
  let nonce = Digest.sha256("${DateTime.epochNanos()}").take(16)
  let path = FS.Path.join(root, nonce)
  return Error("could not create ${path}") if !FS.Directory.create(path)
  return Ok(path)
end

# Copies the tree at `root` into `destination`: what a snapshot would hold,
# plus a committed `tey.lock` — the dependency versions the program's author
# tested, which a snapshot leaves out.
foul stage(root: String, destination: String) -> Void or! String do
  let lock = FS.File.file?(FS.Path.join(root, "tey.lock")) then ["tey.lock"] else []
  let files = [...Tey.Snapshot.sourceFiles(root), ...lock]
  let failed = files.find do |relative|
    !Tey.Programs.copyInto(root, relative, destination)
  end
  match failed do
    Just(relative) => return Error("could not copy ${relative} from ${root}")
    None => return Ok(())
  end
end

foul copyInto(root: String, relative: String, destination: String) -> Bool do
  let target = FS.Path.join(destination, relative)
  return false if !FS.Directory.create(FS.Path.dirname(target))
  match Process.run("cp", ["-a", "--", FS.Path.join(root, relative), target]) do
    Ok(result) => return result.exitCode == 0
    Error(_) => return false
  end
end

# Replaces a program's build tree with the one it was just installed from.
# The old tree is moved aside first and removed last, so a failure part way
# leaves one of the two in place.
foul publishBuild(name: String, staged: String) -> Void or! String do
  let destination = Tey.Programs.buildDirectory(name)
  return Error("could not create ${FS.Path.dirname(destination)}") if !FS.Directory.create(FS.Path.dirname(destination))
  let previous = "${destination}.old"
  FS.Directory.deleteAll(previous)
  if FS.Directory.directory?(destination) && !FS.File.rename(destination, previous)
    return Error("could not replace ${destination}")
  end
  if !FS.File.rename(staged, destination)
    FS.File.rename(previous, destination)
    return Error("could not publish ${destination}")
  end
  FS.Directory.deleteAll(previous)
  return Ok(())
end

foul receiptPath(name: String) -> String do
  return FS.Path.join(Tey.Programs.directory, name, "receipt.json")
end

let encode(receipt: Receipt) -> String do
  return JSON.stringify({
    name: receipt.name,
    version: receipt.version,
    source: { kind: receipt.sourceKind, path: receipt.sourcePath,
              sha256: receipt.sourceDigest, selector: receipt.sourceSelector,
              requested: receipt.sourceRequested, commit: receipt.sourceCommit },
    targets: receipt.targets,
    selected: receipt.selectedTargets,
    kex: receipt.kex,
    otp: receipt.otp,
    installedAt: receipt.installedAt
  }) + "\n"
end

let decode(text: String) -> Receipt or! String do
  let root = match JSON.parse(text) do
    Error(_) => return Error("invalid receipt JSON")
    Ok(value) => value
  end
  let name = Tey.Programs.text(root["name"])
  return Error("receipt has no package name") if name == ""
  let source = root["source"]
  return Ok(Receipt {
    name: name,
    version: Tey.Programs.text(root["version"]),
    sourceKind: Tey.Programs.text(Tey.Programs.field(source, "kind")),
    sourcePath: Tey.Programs.text(Tey.Programs.field(source, "path")),
    sourceDigest: Tey.Programs.text(Tey.Programs.field(source, "sha256")),
    sourceSelector: Tey.Programs.text(Tey.Programs.field(source, "selector")),
    sourceRequested: Tey.Programs.text(Tey.Programs.field(source, "requested")),
    sourceCommit: Tey.Programs.text(Tey.Programs.field(source, "commit")),
    targets: Tey.Programs.strings(root["targets"]),
    selectedTargets: Tey.Programs.strings(root["selected"]),
    kex: Tey.Programs.text(root["kex"]),
    otp: Tey.Programs.text(root["otp"]),
    installedAt: Tey.Programs.text(root["installedAt"])
  })
end

# The decision for one target name, given every receipt and what is on disk.
# Pure, so the whole rule is testable without a bin directory.
#
# `teyBuilt?` covers the programs a project-local `tey install` put here
# before receipts existed: they are escripts Tey itself wrote, so taking them
# into a receipt loses nothing, where refusing would make every existing
# installation demand `--force` on its next reinstall.
let claim(target: String, packageName: String, receipts: [Receipt],
          exists?: Bool, teyBuilt?: Bool) -> Claim do
  return Reserved if Tey.Programs.reservedNames.contains?(target)
  let owner = receipts.find do |receipt|
    receipt.targets.contains?(target)
  end
  match owner do
    Just(receipt) => do
      return Mine if receipt.name == packageName
      return OwnedBy(receipt.name)
    end
    None => ()
  end
  return Free if !exists?
  return Adopt if teyBuilt?
  return Foreign
end

# Why a claim stops the install, or None when it may go ahead. `--force`
# takes a name over from another package or from an unowned file, but never
# from Tey itself.
let refusal(target: String, claim: Claim, path: String, force?: Bool) -> String? do
  match claim do
    Reserved => Just("`${target}` is reserved for Tey's own launcher; rename the target")
    OwnedBy(owner) when !force? => Just("`${target}` is already installed by `${owner}`; pass --force to take it over")
    Foreign when !force? => Just("${path} already exists and was not installed by Tey; pass --force to replace it")
    _ => None
  end
end

foul load(name: String) -> Receipt? do
  match FS.File.read(Tey.Programs.receiptPath(name)) do
    Error(_) => None
    Ok(text) => match Tey.Programs.decode(text) do
      Error(_) => None
      Ok(receipt) => Just(receipt)
    end
  end
end

# Every receipt, by package name. An unreadable one is reported rather than
# skipped silently: skipping it would make the files it owns look unowned.
foul all -> [Receipt] do
  let names = FS.Directory.directories(Tey.Programs.directory).or([]).sort
  return names.flatMap do |name|
    let path = Tey.Programs.receiptPath(name)
    match FS.File.read(path) do
      Error(_) => []
      Ok(text) => match Tey.Programs.decode(text) do
        Ok(receipt) => [receipt]
        Error(error) => do
          IO.printError("warning: ignoring ${path}: ${error}\n")
          []
        end
      end
    end
  end
end

# Written beside the final file and renamed into place, so a reader never
# sees half a receipt and a failed write leaves the previous one intact.
foul save(receipt: Receipt) -> Void or! String do
  let path = Tey.Programs.receiptPath(receipt.name)
  let staging = "${path}.new"
  return Error("could not create ${FS.Path.dirname(path)}") if !FS.Directory.create(FS.Path.dirname(path))
  return Error("could not write ${staging}") if !FS.File.write(staging, Tey.Programs.encode(receipt))
  return Error("could not write ${path}") if !FS.File.rename(staging, path)
  return Ok(())
end

foul remove(name: String) -> Bool do
  return FS.Directory.deleteAll(FS.Path.join(Tey.Programs.directory, name))
end

# Whether `path` is an escript Tey's own target build wrote: its emulator
# line starts Kex's escript launcher, or names `kex_main` directly as an escript
# built before the launcher did.
foul teyBuilt?(path: String) -> Bool do
  match Process.run("head", ["-n", "2", "--", path]) do
    Error(_) => false
    Ok(result) => do
      let header = result.stdout
      # `kex_escript` is the runtime's launcher every escript starts in since
      # kexhq/kex#406; `kex_main` is what one written before it names.
      let entry = header.contains?("-escript main kex_escript") || header.contains?("-escript main kex_main")
      result.exitCode == 0 && header.startsWith?("#!") && entry
    end
  end
end

# The line `tey list` prints for one installed program.
let listLine(receipt: Receipt) -> String do
  let version = receipt.version == "" then "" else " ${receipt.version}"
  let pin = receipt.sourceKind != "git" then "" else " @ ${Tey.Programs.pinText(receipt)}"
  return "${receipt.name}${version} (${receipt.targets.join(", ")}) from ${receipt.sourcePath}${pin}"
end

# `v0.4.0`, `main (3f9c1a2)`, or a short commit — what a Git install is pinned
# to, as `tey list` shows it.
let pinText(receipt: Receipt) -> String do
  let short = receipt.sourceCommit.take(7)
  return receipt.sourceRequested if receipt.sourceSelector == "tag"
  return short if receipt.sourceRequested == receipt.sourceCommit
  return "${receipt.sourceRequested} (${short})"
end

private do
  let text(None) -> String = ""
  let text(Just(value)) -> String = "${value}"

  let field(None, _) = None
  let field(Just(block), key: String) = block[key]

  let strings(None) -> [String] = []
  let strings(Just(values)) -> [String] = values.map { |value| "${value}" }
end
