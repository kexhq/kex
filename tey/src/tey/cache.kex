module Tey.Cache

using Tey.Git, only: [execute]

foul root -> String do
  match ENV.get("TEY_CACHE") do
    Just(path) => path
    None => match ENV.get("HOME") do
      Just(home) => "${home}/.cache/tey"
      None => ".tey-cache"
    end
  end
end

# Include the source URL in the cache identity: two packages with the same
# display name must never share a checkout.
foul packagePath(dep: Tey.Lockfile.Dependency) -> String do
  return Tey.Snapshot.cachedPath(dep) if dep.source == "path"
  let checkout = Tey.Cache.repositoryPath(dep)
  return checkout if dep.subdir == ""
  return FS.Path.join(checkout, dep.subdir)
end

foul repositoryPath(dep: Tey.Lockfile.Dependency) -> String do
  return "${sourceRoot(dep)}/${Tey.Lockfile.dependencyCommit(dep)}"
end

foul fetch(dep: Tey.Lockfile.Dependency) -> String or! String do
  return Tey.Snapshot.verify(dep) if dep.source == "path"
  return Error("workspace package `${dep.name}` is not fetched into the cache") if dep.source == "workspace"
  let path = Tey.Cache.packagePath(dep)
  let checkout = Tey.Cache.repositoryPath(dep)

  return Ok(path) if FS.Directory.directory?(path)

  return Error("cannot create Tey cache at ${Tey.Cache.root}") if !FS.Directory.create(Tey.Cache.root)
  return Error("cannot create Tey cache at ${Tey.Cache.root}") if !FS.Directory.create("${Tey.Cache.root}/src")

  if !FS.Directory.create(sourceRoot(dep))
    return Error("cannot create Tey cache at ${Tey.Cache.root}")
  end

  # Clone into a staging directory and move it into place only once the
  # checkout is complete: the presence of `path` is what every other command
  # reads as "this dependency is cached", so a half-finished clone must never
  # be reachable under that name. The staging directory is a sibling, which
  # keeps the move within one filesystem and therefore atomic.
  let staging = stagingPath(dep)
  FS.Directory.deleteAll(staging) if FS.Directory.directory?(staging)

  match Tey.Git.execute(["clone", "--filter=blob:none", "--no-checkout", Tey.Lockfile.dependencyGit(dep), staging]) do
    Error(error) => do
      FS.Directory.deleteAll(staging)
      return Error(error)
    end
    Ok(_) => match Tey.Git.execute(["-C", staging, "checkout", "--detach", Tey.Lockfile.dependencyCommit(dep)]) do
      Error(error) => do
        FS.Directory.deleteAll(staging)
        return Error(error)
      end
      Ok(_) => do
        return Ok(path) if FS.File.rename(staging, checkout) && FS.Directory.directory?(path)
        # Another run may have finished the same checkout first. Its result
        # is this one's result — the path is content-addressed by commit.
        FS.Directory.deleteAll(staging)
        return Ok(path) if FS.Directory.directory?(path)
        if FS.Directory.directory?(checkout)
          return Error("Git dependency `${dep.name}` has no package directory `${dep.subdir}`")
        end
        return Error("could not move the ${Tey.Lockfile.dependencyName(dep)} checkout into ${path}")
      end
    end
  end
end

foul verify(dep: Tey.Lockfile.Dependency) -> String or! String do
  return Tey.Snapshot.verify(dep) if dep.source == "path"
  return Error("workspace package `${dep.name}` is not verified through the cache") if dep.source == "workspace"
  let path = Tey.Cache.packagePath(dep)

  if !FS.Directory.directory?(path)
    return Error("${Tey.Lockfile.dependencyName(dep)} is not present in the Tey cache")
  end

  match Tey.Git.execute(["-C", Tey.Cache.repositoryPath(dep), "archive", "--format=tar", Tey.Lockfile.dependencyCommit(dep)]) do
    Error(error) => Error(error)
    Ok(archive) => do
      let actual = Digest.sha256(archive.stdout)
      return actual == Tey.Lockfile.dependencySha256(dep) then Ok(path) else Error("content hash mismatch for ${Tey.Lockfile.dependencyName(dep)}: expected ${Tey.Lockfile.dependencySha256(dep)}, got ${actual}")
    end
  end
end

private do
  foul sourceRoot(dep: Tey.Lockfile.Dependency) -> String do
    return "${Tey.Cache.root}/src/${Digest.sha256(Tey.Lockfile.dependencyGit(dep))}"
  end

  # Sibling of the final path so the move that publishes it stays on one
  # filesystem, and named so a leftover from a killed run is recognizable.
  foul stagingPath(dep: Tey.Lockfile.Dependency) -> String do
    return "${Tey.Cache.repositoryPath(dep)}.partial"
  end
end
