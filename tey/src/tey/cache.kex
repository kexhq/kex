foul module Tey.Cache
using Tey.Git, only: [execute]
using Tey.Lockfile, only: [LockedDependency]
  let root -> String do
    match ENV.get("TEY_CACHE") do
      Just(path) -> path
      None -> match ENV.get("HOME") do
        Just(home) -> "${home}/.cache/tey"
        None -> ".tey-cache"
      end
    end
  end

  # Include the source URL in the cache identity: two packages with the same
  # display name must never share a checkout.
  let packagePath(dep: LockedDependency) -> String do
    "${Tey.Cache.root}/src/${Digest.sha256(dep.git)}/${dep.commit}"
  end

  let fetch(dep: LockedDependency) -> Result<String, String> do
    let path = Tey.Cache.packagePath(dep)
    return Ok(path) if FS.Directory.directory?(path)
    return Error("cannot create Tey cache at ${Tey.Cache.root}") if !FS.Directory.create(Tey.Cache.root)
    return Error("cannot create Tey cache at ${Tey.Cache.root}") if !FS.Directory.create("${Tey.Cache.root}/src")
    let sourceRoot = "${Tey.Cache.root}/src/${Digest.sha256(dep.git)}"
    if !FS.Directory.create(sourceRoot)
      return Error("cannot create Tey cache at ${Tey.Cache.root}")
    end
    match Tey.Git.execute(["clone", "--filter=blob:none", "--no-checkout", dep.git, path]) do
      Error(error) -> Error(error)
      Ok(_) -> match Tey.Git.execute(["-C", path, "checkout", "--detach", dep.commit]) do
        Error(error) -> Error(error)
        Ok(_) -> Ok(path)
      end
    end
  end

  let verify(dep: LockedDependency) -> Result<String, String> do
    let path = Tey.Cache.packagePath(dep)
    return Error("${dep.name} is not present in the Tey cache") if !FS.Directory.directory?(path)
    match Tey.Git.execute(["-C", path, "archive", "--format=tar", dep.commit]) do
      Error(error) -> Error(error)
      Ok(archive) -> do
        let actual = Digest.sha256(archive.stdout)
        actual == dep.sha256 then Ok(path) else Error("content hash mismatch for ${dep.name}: expected ${dep.sha256}, got ${actual}")
      end
    end
  end
