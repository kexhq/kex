module Tey.Semver

# A parsed version number: +major.minor.patch+ and an optional pre-release.
record SemanticVersion do
  major : Integer
  minor : Integer
  patch : Integer
  # Empty for a release, otherwise the channel and its number, such as
  # "rc.1", "beta" or "prealpha.2". A release ranks above its own
  # pre-releases.
  preRelease : String = ""
end

# Orders versions by number, then by pre-release: a release ranks above its
# pre-releases, and pre-releases are ordered by channel (+prealpha+, +alpha+,
# +beta+, +rc+) and then by number.
make SemanticVersion, implement: Comparable do
  let compare(other: SemanticVersion) -> Ordering do
    return Less if this.major < other.major
    return Greater if this.major > other.major
    return Less if this.minor < other.minor
    return Greater if this.minor > other.minor
    return Less if this.patch < other.patch
    return Greater if this.patch > other.patch
    # Same numbers: a release beats any pre-release of it.
    return Equal if this.preRelease == other.preRelease
    return Greater if this.preRelease == ""
    return Less if other.preRelease == ""
    return Tey.Semver.comparePreRelease(this.preRelease, other.preRelease)
  end
end

# Parses a version such as +0.4.0+, +v0.4.0-rc.1+ or +1.2+, or returns
# +None+. A leading +v+ and build metadata after a plus sign are ignored, and a
# missing minor or patch number counts as 0.
let parseVersion(text: String) -> SemanticVersion? do
  let unprefixed = text.startsWith?("v") then text.drop(1) else text
  # Build metadata (`+deadbeef`) says nothing about precedence, so it is
  # dropped before anything else looks at the string.
  let withoutBuild = unprefixed.split("+").first.or(unprefixed)
  let core = withoutBuild.split("-").first.or(withoutBuild).trim
  let preRelease = withoutBuild.split("-").drop(1).join("-").trim
  let parts = core.split(".")
  let major = match parts.first do Just(x) => Integer.parse(x) _ => Integer.parse(core) end
  let minor = match parts.second do Just(x) => Integer.parse(x) _ => Ok(0) end
  let patch = match parts.third do Just(x) => Integer.parse(x.split(" ").first.or("0")) _ => Ok(0) end
  match (major, minor, patch) do
    (Ok(a), Ok(b), Ok(c)) => Just(SemanticVersion { major: a, minor: b, patch: c, preRelease: preRelease })
    _ => None
  end
end

# Returns the release a version belongs to, so +0.4.0-rc.1+ gives +0.4.0+.
# Text that is not a version is returned unchanged.
let release(text: String) -> String do
  match Tey.Semver.parseVersion(text) do
    Just(version) => return "${version.major}.${version.minor}.${version.patch}"
    None => return text
  end
end

# Returns +true+ when the text is a version without a pre-release part.
let stable?(text: String) -> Bool do
  match Tey.Semver.parseVersion(text) do
    Just(version) => return version.preRelease == ""
    None => return false
  end
end

# Returns +true+ when the version meets every space- or comma-separated
# clause of +requirement+ (+>=+, +<=+, +>+, +<+, +=+, +^+, +~>+ or a bare
# version). An empty requirement or +*+ accepts any version.
#
# +~> 0.3+ accepts +0.3.x+ and +^0.3+ accepts +0.x+ from +0.3+ on. A
# pre-release meets a requirement only when some clause names a pre-release,
# so +~> 0.4+ does not accept +0.4.0-rc.1+.
let satisfies?(versionText: String, requirement: String) -> Bool do
  let parsed = Tey.Semver.parseVersion(versionText)
  return false if parsed == None
  let Just(version) = parsed
  let req = requirement.trim
    .replace(",", " ")
    .replace(">= ", ">=")
    .replace("<= ", "<=")
    .replace("~> ", "~>")
    .replace("^ ", "^")
    .replace("> ", ">")
    .replace("< ", "<")
    .replace("= ", "=")
  return true if req == "" || req == "*"
  let clauses = req.split(" ").filter { |part| part != "" }
  # A pre-release meets a range only when the range asks for one, so nobody
  # gets an untested pre-release without opting in.
  if version.preRelease != "" && !clauses.any? { |clause| clause.contains?("-") }
    return false
  end
  clauses.all? { |clause| satisfiesClause?(version, clause) }
end

# Returns a requirement met only by versions that meet both +a+ and +b+, for
# when two packages in one graph depend on the same package.
#
# The result joins the two with a space, since +satisfies?+ requires every
# clause to hold: +~> 0.1+ and +>= 0.1.5+ give +~> 0.1 >= 0.1.5+. An empty or
# +*+ side is dropped.
#
# A requirement that nothing can meet, such as +~> 0.1 ~> 0.2+, is not
# detected here. +highest+ finds it, by returning +None+.
let intersect(a: String, b: String) -> String do
  let left = a.trim
  let right = b.trim
  return right if left == "" || left == "*"
  return left if right == "" || right == "*"
  return left if left == right
  return "${left} ${right}"
end

# Returns the intersection of all the requirements, as +intersect+ does for
# two. +[]+ and +[""]+ both give +""+, which accepts any version.
let intersectAll(requirements: [String]) -> String do
  return requirements.reduce("") do |combined, requirement|
    Tey.Semver.intersect(combined, requirement)
  end
end

# Returns the version tag inside a resolved ref: +refs/tags/v0.1.1+,
# +v0.1.1+ and +pkg-v0.1.1+ all give +v0.1.1+.
#
# A ref without a version, such as a branch name or a commit, gives +""+,
# which meets no requirement.
let versionOf(ref: String) -> String do
  let last = ref.split("/").last.or(ref)
  return last if Tey.Semver.parseVersion(last).set?
  let scoped = last.split("-v").last.or("")
  return Tey.Semver.parseVersion(scoped).set? then "v${scoped}" else ""
end

# Returns the rank of a pre-release channel: +prealpha+ 1, +alpha+ 2, +beta+ 3,
# +rc+ 4, and 0 for any other name.
#
# Plain semver would order the channels alphabetically, putting +beta+ before
# +prealpha+.
channelRank : String -> Integer
let channelRank("prealpha") = 1
let channelRank("alpha")    = 2
let channelRank("beta")     = 3
let channelRank("rc")       = 4
let channelRank(_)          = 0

# Returns +true+ when a requested tag is a version range, such as +~> 1.2+,
# and +false+ for an exact tag such as +v1.2.0+.
let range?(requested: String) -> Bool do
  let text = requested.trim
  return true if text == "*" || text.contains?(" ")
  return ["<=", ">=", "~>", "^", "<", ">", "="].any? { |op| text.startsWith?(op) }
end

# Returns +true+ when +a+ is a newer version than +b+. A tag that is not a
# version counts as older than any that is, so a stray +nightly+ never wins.
let newer?(a: String, b: String) -> Bool do
  match (Tey.Semver.parseVersion(a), Tey.Semver.parseVersion(b)) do
    (Just(left), Just(right)) => return left.compare(right) == Greater
    (Just(_), None) => return true
    (None, Just(_)) => return false
    _ => return false
  end
end

# Returns the versions without duplicates, newest first, with tags that are
# not versions at the end.
let newestFirst(versions: [String]) -> [String] do
  return versions.uniq.sort do |a, b|
    Tey.Semver.newer?(a, b)
  end
end

# Returns the newest tag that meets the requirement, or +None+ when none
# does.
let highest(tags: [String], requirement: String) -> String? do
  let matching = tags.filter { |tag| Tey.Semver.satisfies?(tag, requirement) }
  return None if matching.empty?
  return Tey.Semver.newestFirst(matching).first
end

private do
  # Two pre-releases of the same version: channel first, then its number, so
  # `rc.2` beats `rc.1` beats `beta.9`.
  let comparePreRelease(a: String, b: String) -> Ordering do
    # `channelRank` stays an Integer — it is a rank, not a comparison — so the
    # two pairs are ordered through Number.compare (algebra.kex).
    let rank = Tey.Semver.channelRank(Tey.Semver.channelOf(a))
      .compare(Tey.Semver.channelRank(Tey.Semver.channelOf(b)))
    return rank if rank != Equal
    return Tey.Semver.channelNumber(a).compare(Tey.Semver.channelNumber(b))
  end

  # "rc.1" and "rc1" both name the rc channel; anything else is its own name.
  let channelOf(preRelease: String) -> String do
    let head = preRelease.split(".").first.or(preRelease)
    return head.chars.takeWhile { |c| c.letter? }.join("")
  end

  let channelNumber(preRelease: String) -> Integer do
    let digits = preRelease.chars.filter { |c| c.digit? }.join("")
    return 0 if digits.empty?
    match Integer.parse(digits) do
      Ok(number) => return number
      Error(_) => return 0
    end
  end

  let satisfiesClause?(version: SemanticVersion, clause: String) -> Bool do
    var op = "="
    if clause.startsWith?(">=")
      op = ">="
    elif clause.startsWith?("<=")
      op = "<="
    elif clause.startsWith?("~>")
      op = "~>"
    elif clause.startsWith?("^")
      op = "^"
    elif clause.startsWith?(">")
      op = ">"
    elif clause.startsWith?("<")
      op = "<"
    end
    # Only strip an operator that is actually there. `op` starts as "=" to
    # give the match below a default, but a bare `1.2.3` carries no prefix:
    # dropping one character anyway left `.2.3`, which parses as nothing, so a
    # bare exact requirement was satisfied by no version at all — including
    # itself. Masked in the main path because `range?` sends a bare version to
    # be looked up as a tag name rather than matched.
    let raw = clause.startsWith?(op) then clause.drop(op.count) else clause
    let wanted = Tey.Semver.parseVersion(raw)
    return false if wanted == None
    let Just(target) = wanted
    let order = version.compare(target)
    match op do
      ">=" => order != Less
      "<=" => order != Greater
      ">" => order == Greater
      "<" => order == Less
      "=" => order == Equal
      "^" => order != Less && version.major == target.major
      "~>" => order != Less && version.major == target.major && version.minor == target.minor
      _ => false
    end
  end
end
