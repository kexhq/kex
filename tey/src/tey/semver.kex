module Tey.Semver

record SemanticVersion do
  major : Integer
  minor : Integer
  patch : Integer
  # "" for a release, otherwise the channel and its number: "rc.1", "beta",
  # "prealpha.2". A release always outranks its own pre-releases.
  preRelease : String = ""
end

let parseVersion(text: String) -> SemanticVersion? do
  let unprefixed = text.startsWith?("v") then text.drop(1) else text
  # Build metadata (`+deadbeef`) says nothing about precedence, so it is
  # dropped before anything else looks at the string.
  let withoutBuild = unprefixed.split("+").first.or(unprefixed)
  let core = withoutBuild.split("-").first.or(withoutBuild).trim
  let preRelease = withoutBuild.split("-").drop(1).join("-").trim
  let parts = core.split(".")
  let major = match parts.first do Just(x) => Integer.parse(x) _ => Error(ParseError { value: core, rest: core }) end
  let minor = match parts.second do Just(x) => Integer.parse(x) _ => Ok(0) end
  let patch = match parts.third do Just(x) => Integer.parse(x.split(" ").first.or("0")) _ => Ok(0) end
  match (major, minor, patch) do
    (Ok(a), Ok(b), Ok(c)) => Just(SemanticVersion { major: a, minor: b, patch: c, preRelease: preRelease })
    _ => None
  end
end

# The release a version belongs to: `0.4.0-rc.1` → `0.4.0`. Used where a
# pre-release should count as its eventual release.
let release(text: String) -> String do
  match Tey.Semver.parseVersion(text) do
    Just(version) => return "${version.major}.${version.minor}.${version.patch}"
    None => return text
  end
end

# Whether a version is a full release rather than a pre-release. This is the
# question a download page asks: "what is the current stable Kex?".
let stable?(text: String) -> Bool do
  match Tey.Semver.parseVersion(text) do
    Just(version) => return version.preRelease == ""
    None => return false
  end
end

let compareVersions(a: SemanticVersion, b: SemanticVersion) -> Integer do
  return -1 if a.major < b.major
  return 1 if a.major > b.major
  return -1 if a.minor < b.minor
  return 1 if a.minor > b.minor
  return -1 if a.patch < b.patch
  return 1 if a.patch > b.patch
  # Same numbers: a release beats any pre-release of it.
  return 0 if a.preRelease == b.preRelease
  return 1 if a.preRelease == ""
  return -1 if b.preRelease == ""
  return Tey.Semver.comparePreRelease(a.preRelease, b.preRelease)
end

let satisfies(versionText: String, requirement: String) -> Bool do
  let version = Tey.Semver.parseVersion(versionText)
  return false if version == None
  let req = requirement.trim
    .replace(">= ", ">=")
    .replace("<= ", "<=")
    .replace("~> ", "~>")
    .replace("^ ", "^")
    .replace("> ", ">")
    .replace("< ", "<")
    .replace("= ", "=")
  return true if req == "" || req == "*"
  let clauses = req.split(" ").filter { |part| part != "" }
  # A pre-release answers a range only when the range asks for one. `~> 0.3`
  # means "a released 0.3.x", and resolving it to `0.4.0-rc.1` because the
  # numbers fit is how a package manager ships an untested compiler to
  # someone who never opted in.
  if version.try.preRelease != "" && !clauses.any? { |clause| clause.contains?("-") }
    return false
  end
  clauses.all? { |clause| satisfiesClause(version.try, clause) }
end

# The requirement satisfied only by versions satisfying BOTH, for when two
# packages in one graph each ask for the same dependency.
#
# Concatenation, because `satisfies` already reads a requirement as a list of
# space-separated clauses that must ALL hold: `~> 0.1` and `>= 0.1.5` intersect
# to `~> 0.1 >= 0.1.5`, which is exactly the question "satisfies both". No
# interval arithmetic, no second implementation of the operators to keep in
# step with the first.
#
# An empty intersection is not detected here, and deliberately: `~> 0.1 ~> 0.2`
# is perfectly well formed and simply matches nothing. Emptiness is a fact
# about the versions a repository actually publishes, so it is discovered where
# the tags are (`highest`), where the error can also say what WAS available.
let intersect(a: String, b: String) -> String do
  let left = a.trim
  let right = b.trim
  return right if left == "" || left == "*"
  return left if right == "" || right == "*"
  return left if left == right
  return "${left} ${right}"
end

# Every constraint at once. `[]` and `[""]` both mean "no opinion", which is
# what a package with no version requirement expresses.
let intersectAll(requirements: [String]) -> String do
  return requirements.reduce("") do |combined, requirement|
    Tey.Semver.intersect(combined, requirement)
  end
end

# The version inside a resolved ref: `refs/tags/v0.1.1` and `v0.1.1` both
# give `0.1.1`. A ref that carries no version (a branch name, a bare commit)
# gives "", which satisfies nothing and so never claims to meet a range.
let versionOf(ref: String) -> String do
  let last = ref.split("/").last.or(ref)
  return Tey.Semver.parseVersion(last) == None then "" else last
end

# Channel precedence, lowest first: prealpha < alpha < beta < rc < release.
# Plain semver would order these alphabetically — putting `beta` BEFORE
# `prealpha` — which is not what the words mean, so the ranking is explicit.
let channelRank(channel: String) -> Integer do
  return 1 if channel == "prealpha"
  return 2 if channel == "alpha"
  return 3 if channel == "beta"
  return 4 if channel == "rc"
  return 0
end

# Whether a requested tag is a RANGE rather than one exact tag. `v1.2.0` is a
# name to look up; `~> 1.2` is a question to answer against everything the
# repository has.
let range?(requested: String) -> Bool do
  let text = requested.trim
  return true if text == "*" || text.contains?(" ")
  return ["<=", ">=", "~>", "^", "<", ">", "="].any? { |op| text.startsWith?(op) }
end

# Descending semantic order, for picking the newest of anything. A tag that is
# not a version sorts after every tag that is, so a stray `nightly` can never
# displace a release.
let newer?(a: String, b: String) -> Bool do
  match (Tey.Semver.parseVersion(a), Tey.Semver.parseVersion(b)) do
    (Just(left), Just(right)) => return Tey.Semver.compareVersions(left, right) > 0
    (Just(_), None) => return true
    (None, Just(_)) => return false
    _ => return false
  end
end

let newestFirst(versions: [String]) -> [String] do
  return versions.uniq.sort do |a, b|
    Tey.Semver.newer?(a, b)
  end
end

# The highest tag that satisfies the requirement — the whole point of writing
# a range instead of a version. None when nothing does.
let highest(tags: [String], requirement: String) -> String? do
  let matching = tags.filter { |tag| Tey.Semver.satisfies(tag, requirement) }
  return None if matching.empty?
  return Tey.Semver.newestFirst(matching).first
end

private do
  # Two pre-releases of the same version: channel first, then its number, so
  # `rc.2` beats `rc.1` beats `beta.9`.
  let comparePreRelease(a: String, b: String) -> Integer do
    let leftRank = Tey.Semver.channelRank(Tey.Semver.channelOf(a))
    let rightRank = Tey.Semver.channelRank(Tey.Semver.channelOf(b))
    return -1 if leftRank < rightRank
    return 1 if leftRank > rightRank
    let leftNumber = Tey.Semver.channelNumber(a)
    let rightNumber = Tey.Semver.channelNumber(b)
    return -1 if leftNumber < rightNumber
    return 1 if leftNumber > rightNumber
    return 0
  end

  # "rc.1" and "rc1" both name the rc channel; anything else is its own name.
  let channelOf(preRelease: String) -> String do
    let head = preRelease.split(".").first.or(preRelease)
    return head.chars.takeWhile { |c| c.letter? }.join("")
  end

  let channelNumber(preRelease: String) -> Integer do
    let digits = preRelease.chars.filter { |c| c.digit? }.join("")
    return 0 if digits.empty?
    match Integer.parse(digits) do
      Ok(number) => return number
      Error(_) => return 0
    end
  end

  let satisfiesClause(version: SemanticVersion, clause: String) -> Bool do
    var op = "="
    if clause.startsWith?(">=")
      op = ">="
    elif clause.startsWith?("<=")
      op = "<="
    elif clause.startsWith?("~>")
      op = "~>"
    elif clause.startsWith?("^")
      op = "^"
    elif clause.startsWith?(">")
      op = ">"
    elif clause.startsWith?("<")
      op = "<"
    end
    # Only strip an operator that is actually there. `op` starts as "=" to
    # give the match below a default, but a bare `1.2.3` carries no prefix:
    # dropping one character anyway left `.2.3`, which parses as nothing, so a
    # bare exact requirement was satisfied by no version at all — including
    # itself. Masked in the main path because `range?` sends a bare version to
    # be looked up as a tag name rather than matched.
    let raw = clause.startsWith?(op) then clause.drop(op.count) else clause
    let wanted = Tey.Semver.parseVersion(raw)
    return false if wanted == None
    let order = Tey.Semver.compareVersions(version, wanted.try)
    match op do
      ">=" => order >= 0
      "<=" => order <= 0
      ">" => order > 0
      "<" => order < 0
      "=" => order == 0
      "^" => order >= 0 && version.major == wanted.try.major
      "~>" => order >= 0 && version.major == wanted.try.major && version.minor == wanted.try.minor
      _ => false
    end
  end
end
