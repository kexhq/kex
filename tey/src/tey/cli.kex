module Tey.Cli

using Tey.Docgen.Cli, only: [dispatch]
using Tey.Commands, only: [add, build, clean, init, install, list, lock, runCommand, runPackage, setupMergeDriver, test]
using Tey.Manifest, only: [Command]
using Tey.Toolchain, only: [installSource, use]

# Options AND commands in one declaration: OptionParser matches the command
# words, strips them, and hands the handler what is left. Tey keeps no
# dispatcher of its own, so the help text and what actually runs cannot drift
# apart — they are read off the same list.
#
# `foul` because the handlers do things.
foul parser -> OptionConfig do
  OptionParser.define("tey", "Package and Kex toolchain manager")
    .flag("help", Just('h'), "Show this help")
    .flag("version", Just('V'), "Show Tey and active Kex versions")
    .flag("lib", None, "Create a library package, without being asked")
    .flag("app", None, "Create an application package, without being asked")
    .string("git", None, "Git URL for `tey add`", None, false)
    .string("tag", None, "Git tag or tag requirement", None, false)
    .string("branch", None, "Git branch", None, false)
    .string("ref", None, "Git ref or commit", None, false)
    .string("without", None, "Dependency group to omit", None, false)
    .flag("cache", None, "Remove the complete cache with `tey clean`")
    .flag("remove", None, "Remove configuration installed by `tey setup`")
    .flag("merge-driver", None, "Run `tey lock` as a Git merge driver")
    .flag("pre", None, "Include pre-releases in `tey kex list` and `tey kex install`")
    .flag("installed", None, "Restrict `tey kex list` to toolchains on this machine")
    .flag("json", None, "Print `tey kex list`, `tey commands`, or `tey test` as JSON")
    .flag("list", None, "List `tey test` cases as JSON without running any of them")
    .string("only", None, "Run one `tey test` case, or one describe, by name", None, false)
    .flag("interpret", None, "Run `tey run`, `tey test` and package commands on the interpreter, not the BEAM")
    .command("new", "<name>", "create a Kex package in a new directory") do |options|
      Tey.Cli.newPackage(options)
    end
    # Bare `tey init` names the package after the directory it is standing in;
    # an argument overrides that, for a checkout whose directory name is not
    # the package name.
    .command("init", "[<name>]", "create a Kex package in this directory") do |options|
      Tey.Commands.init(options.arguments.first.or(""), Tey.Cli.libraryChoice(options))
    end
    .command("add", "<name> --git <url>", "add a Git dependency and update tey.lock") do |options|
      match options.arguments.first do
        None => Tey.Cli.incomplete("add", "<name>")
        Just(name) => Tey.Commands.add(name, options)
      end
    end
    .command("install", "", "fetch dependencies, and install this package's targets") do |options|
      Tey.Commands.install(options.value("without", ""))
    end
    .command("update", "[<name>]", "re-resolve dependencies") do |_|
      Tey.Commands.lock
    end
    # Git hands a merge driver three files (`%O %A %B`), so the command has
    # arguments in that mode and none otherwise.
    .command("lock", "", "resolve and write tey.lock") do |options|
      Tey.Cli.lockCommand(options)
    end
    .command("list", "", "show locked dependencies") do |_|
      Tey.Commands.list
    end
    .command("run", "[args...]", "run the package entrypoint on the BEAM") do |options|
      Tey.Commands.runPackage(options.arguments, options.flagEnabled?("interpret"))
    end
    .command("build", "", "compile the package, and each target(...) into an executable") do |_|
      Tey.Commands.build
    end
    # A named spec runs alone; with none named the whole `spec/` directory
    # runs, which is what `tey test` has always meant. `--json`/`--list`/
    # `--only` are the machine-readable half an editor's test tree drives
    # (kexhq/kex#199) — Tey is the one that knows the package's source roots,
    # so it is what a tool should call rather than `kex` directly.
    .command("test", "[<spec>...] [--json] [--list] [--only <name>]",
             "run spec/*.spec.kex on the BEAM") do |options|
      Tey.Commands.test(options.arguments, options.flagEnabled?("interpret"),
                        options.flagEnabled?("json"), options.flagEnabled?("list"),
                        options.value("only", ""))
    end
    # Docgen is part of Tey rather than a package: `tey test` and `tey docs`
    # are the same kind of thing — commands that must mean the same thing in
    # every checkout, run against whatever toolchain is selected. What follows
    # the command word is docgen's own vocabulary (build / serve and the
    # options they take): OptionParser passes a command's own options through,
    # so no `--` is needed — though the `--` spelling still works.
    .command("docs", "<build|serve> [options]",
             "generate or serve documentation for a source tree") do |options|
      Tey.Docgen.Cli.dispatch(options.arguments)
    end
    .command("clean", "[--cache]", "inspect or remove the global cache") do |options|
      Tey.Commands.clean(options.flagEnabled?("cache"))
    end
    .command("setup merge-driver", "", "configure Git's tey.lock merge driver") do |options|
      Tey.Commands.setupMergeDriver(options.flagEnabled?("remove"))
    end
    .command("help", "[--json]", "show this help") do |options|
      Tey.Cli.help(options.flagEnabled?("json"))
    end
    # Bare `tey kex` lists, rather than reporting the group name as an
    # unknown command. A group with subcommands is still a word somebody
    # types on its own, and the useful answer to "tey kex" is the same one
    # `tey kex list` gives. Declaring both is what `commandFor`'s
    # longest-match rule is for: `kex install` still reaches its own handler.
    .command("kex", "", "show Kex versions, newest first") do |options|
      Tey.Cli.kexList(options)
    end
    .command("kex list", "[--pre] [--installed] [--json]", "the same listing, spelled out") do |options|
      Tey.Cli.kexList(options)
    end
    # One handler for every `kex install` spelling: bare, `latest`, a version,
    # and a source checkout with a version. They differ only in what follows
    # the two command words, which is exactly what the handler receives.
    .command("kex install", "[<version> | latest | <src> <version>]", "install a Kex toolchain") do |options|
      Tey.Cli.kexInstall(options)
    end
    .command("kex uninstall", "<version>", "remove an installed Kex") do |options|
      match options.arguments.first do
        None => Tey.Cli.incomplete("kex uninstall", "<version>")
        Just(version) => Tey.Cli.kexUninstall(version)
      end
    end
    # `latest` selects the newest Kex this machine already has, so the way back
    # to the current one is not "remember which number it was".
    .command("kex use", "<version> | latest", "select an installed Kex toolchain") do |options|
      match options.arguments.first do
        None => Tey.Cli.incomplete("kex use", "<version>")
        Just(selector) => Tey.Cli.kexUse(selector)
      end
    end
    .command("kex which", "", "print the compiler the kex command runs") do |_|
      Tey.Cli.kexWhich()
    end
end

# The parser Tey actually runs: the declared commands, plus one for every
# `command(...)` this package's manifest declares. Registering them here
# rather than in a fallback is what gets them into `tey help`, into the
# unknown-command message, and into argument stripping, for free.
#
# A package command can never shadow a built-in: the manifest reader refuses
# those names outright (Tey.Manifest.reservedCommands). They are listed under
# their own help heading regardless — "unknown command" should send a reader to
# package.kex or to Tey, and the two lists are written by different people.
foul cli -> OptionConfig do
  return Tey.Cli.packageCommands.reduce(Tey.Cli.parser) do |config, command|
    let summary = command.commandDescription != "" then command.commandDescription else command.commandRun
    config.command(command.commandName, "[args...]", summary, section: "Package commands") do |options|
      Tey.Commands.runCommand(command, options.arguments, options.flagEnabled?("interpret"))
    end
  end
end

# The line is parsed once here to answer the two questions `run` cannot — is
# this `--version`, and does it name a command Tey already answers — and then
# handed to `run`, which parses it again and dispatches. A parse ERROR is left
# to `run` as well: reporting it with the help text is the one policy every
# tool built on OptionParser shares.
foul dispatch(args: [String]) -> Integer do
  Tey.Cli.announceToolchain
  match Tey.Cli.parser.parse(args) do
    Error(_) => Tey.Cli.cli.run(args)
    Ok(options) => Tey.Cli.dispatchParsed(args, options)
  end
end

# Tells the rest of the process which compiler Tey selected.
#
# `Kex.AST` — which is how a `package.kex` is read at all — shells out to the
# compiler named by `$KEX`, falling back to whatever `kex` PATH happens to
# hold. Tey is started by `erl`, not by `kex`, so nothing had set that: a
# manifest was parsed by an unrelated compiler if one was on PATH, and by none
# at all otherwise — which is why a package's commands silently vanished from
# `tey help` on a machine where `kex` was installed only inside the Tey home.
#
# An explicit `$KEX` is left alone: someone who set it means it, and that is
# the documented override the compiler itself honours.
foul announceToolchain -> Void do
  return () if ENV.get("KEX", "") != ""
  let compiler = Tey.Toolchain.kex
  # "kex" is the resolver's own last resort, meaning "hope PATH has one".
  # Passing that on says nothing PATH does not already say.
  return () if compiler == "kex"
  ENV.set("KEX", compiler)
end

private do
  foul installKex(version: String) -> Integer do
    match Tey.Toolchain.installRelease(version) do
      Ok(prefix) => do
        IO.printLine("${Console.GREEN}Installed${Console.RESET} and selected Kex ${Console.BOLD}${version}${Console.RESET} ${Console.DIM}at ${prefix}${Console.RESET}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        1
      end
    end
  end

  # Re-downloading a version already on the disk to arrive where you already
  # are is waste, so `install latest` that finds nothing to do selects it and
  # says so rather than reporting an install that did not happen.
  foul alreadyCurrent(version: String) -> Integer do
    Tey.Toolchain.use(version)
    IO.printLine("Kex ${version} is the newest release and already installed; selected it")
    Tey.Cli.reportShim(version)
    return 0
  end

  # "* 0.3.0  installed, selected" — the marker is the selected one, so the
  # active version is findable by eye in a long list.
  # The selected toolchain is the one answer a reader is usually looking for,
  # so it carries the marker AND the colour; the notes beside a version are
  # metadata and stay dim.
  let versionLine(version: String, installed: [String], selected: String) -> String do
    let current = version == selected
    let marker = current then "${Console.GREEN}*${Console.RESET}" else " "
    let shown = current then "${Console.BOLD}${version}${Console.RESET}" else version
    let channel = Tey.Semver.stable?(version) then [] else ["pre-release"]
    let notes = installed.contains?(version) then [...channel, "installed"] else channel
    let all = current then [...notes, "selected"] else notes
    return "${marker} ${shown}" if all.empty?
    return "${marker} ${shown}  ${Console.DIM}${all.join(", ")}${Console.RESET}"
  end

  # The offline listing: what is on this machine, newest first, in the same
  # dress as the full one. Every entry is installed except possibly the
  # bundled seed, so "installed" is not spelled out per line — only the seed
  # gets a note, saying why `tey kex use` accepts it anyway.
  foul listInstalled -> Integer do
    let toolchains = Tey.Toolchain.selectableToolchains
    if toolchains.empty?
      IO.printLine("${Console.DIM}No Kex toolchains installed${Console.RESET}")
      return 0
    end
    let selected = Tey.Toolchain.selected.or("")
    toolchains.each do |toolchain|
      let current = toolchain.version == selected
      let marker = current then "${Console.GREEN}*${Console.RESET}" else " "
      let shown = current then "${Console.BOLD}${toolchain.version}${Console.RESET}" else toolchain.version
      let notes = toolchain.bundled? then ["bundled, not installed"] else []
      let line = notes.empty? then "${marker} ${shown}" else "${marker} ${shown}  ${Console.DIM}${notes.join(", ")}${Console.RESET}"
      IO.printLine(line)
    end
    if !Tey.Toolchain.selectionHealthy?
      IO.printError("${Console.RED}error:${Console.RESET} Kex ${selected} is selected but not installed; pick another with `tey kex use <version>`\n")
    end
    Tey.Cli.reportShim(selected)
    0
  end

  # `tey kex list --installed --json` — the same listing as `listInstalled`,
  # as one JSON document for a tool (an editor's toolchain picker) to read.
  # Nothing here touches the network: an editor asks on its own schedule, and
  # a picker that stalled on a release list would be worse than one that
  # listed nothing. Nothing installed is an empty array rather than an error
  # for the same reason — an empty picker is a state, not a failure.
  foul listInstalledJson -> Integer do
    let selected = Tey.Toolchain.selected
    let toolchains = Tey.Toolchain.selectableToolchains.map do |toolchain|
      {
        version: toolchain.version,
        binary: toolchain.binary,
        selected: selected == Just(toolchain.version),
        bundled: toolchain.bundled?
      }
    end
    # Just(...) unwrapped rather than stringified: an optional prints as
    # `Just("0.4.0")`, and the document wants "0.4.0" — or null, for no
    # selection, which is what None already stringifies to.
    let selectedText = match selected do
      Just(version) => version
      None => None
    end
    IO.printLine(JSON.stringify({ home: Tey.Toolchain.home, selected: selectedText, toolchains: toolchains }))
    0
  end

  # Whether a `kex` is reachable as a command. Installed beside `tey` — which
  # is how brew and the release tarball put it there — it already is, and
  # telling someone to edit PATH when their shell can run `kex` would be
  # noise about a problem they do not have.
  foul kexOnPath? -> Bool do
    return ENV.get("PATH", "").split(":").any? do |directory|
      !directory.empty? && FS.File.file?("${directory}/kex")
    end
  end

  # The Tey home's own `kex` only takes effect if that directory is on PATH,
  # and that is the one part Tey cannot do for the user. Say so exactly once,
  # when it matters — which is when nothing else has put a `kex` there.
  foul reportShim(selected: String) -> Void do
    if !selected.empty? && !Tey.Cli.kexOnPath?
      IO.printLine("")
      IO.printLine("Add ${Tey.Toolchain.binDirectory} to PATH so `kex` runs the selected version.")
    end
  end

  foul showVersion -> Integer do
    # `.number` already parenthesizes the revision, and nesting that inside
    # another pair reads badly: "tey 0.1.0 (Kex 0.3.0-beta (abc1234))".
    let kex = match Kex.Kernel.VERSION.revision do
      Just(revision) => "${Kex.Kernel.VERSION.release}, ${revision}"
      None => Kex.Kernel.VERSION.release
    end
    IO.printLine("${Console.BOLD}tey${Console.RESET} ${Tey.Version.number} ${Console.DIM}(Kex ${kex})${Console.RESET}")
    return 0
  end


  # Whether to scaffold a library, when the command line did not say. `--lib`
  # and `--app` both answer it without asking.
  #
  # The two scaffolds differ in what they produce and in what the README then
  # tells a visitor to do, so guessing "application" silently was a choice
  # made FOR the author on the one command where they are most likely to have
  # an opinion.
  #
  # End-of-input answers "application": a pipe, a CI job or `tey new x
  # </dev/null` cannot answer, and a question nobody is there to read must not
  # hang or fail the command.
  foul libraryChoice(options: ParsedOptions) -> Bool do
    return true if options.flagEnabled?("lib")
    return false if options.flagEnabled?("app")
    return Tey.Cli.askLibrary
  end

  foul askLibrary -> Bool do
    IO.print("Create a ${Console.BOLD}library${Console.RESET}? [y/${Console.CYAN}N${Console.RESET}] ")
    # `.or("")` rather than a match on the Optional: end-of-input and a bare
    # Enter both mean "the default", so the two need no telling apart — which
    # is just as well, because `IO.getLine` answers a line as an UNTAGGED
    # string on both backends despite being declared `String?`, so `Just(x)`
    # matches nothing anywhere (kexhq/kex#197).
    let choice = IO.getLine.or("").trim.lowerCase
    # The prompt carried no newline, so close its line before the scaffold
    # prints underneath.
    IO.printLine("") if choice == ""
    return true if choice == "y" || choice == "yes"
    return false if choice == "" || choice == "n" || choice == "no"
    Tey.Cli.askLibrary
  end

  foul newPackage(options: ParsedOptions) -> Integer do
    match options.arguments.first do
      None => Tey.Cli.incomplete("new", "<name>")
      Just(name) => Tey.Commands.new(name, Tey.Cli.libraryChoice(options))
    end
  end

  # Bare, this writes tey.lock. Git hands a merge driver three files
  # (`%O %A %B`) and `--merge-driver` says so, which is the only spelling that
  # takes arguments at all.
  foul lockCommand(options: ParsedOptions) -> Integer do
    return Tey.Commands.lock if options.arguments.empty?
    return Tey.Commands.lock if options.arguments.count == 3 && options.flagEnabled?("merge-driver")
    Tey.Cli.unknown("lock")
  end

  foul kexList(options: ParsedOptions) -> Integer do
    # JSON is the offline half only, for now: `--json` over released versions
    # would have to touch the network and decide a shape for entries no tool
    # has asked to consume. Saying so beats half-doing it.
    if options.flagEnabled?("json")
      if !options.flagEnabled?("installed")
        IO.printError("${Console.RED}error:${Console.RESET} --json needs --installed; released versions have no JSON form\n")
        return 1
      end
      return Tey.Cli.listInstalledJson()
    end
    return Tey.Cli.listInstalled() if options.flagEnabled?("installed")
    let available = match Tey.Toolchain.availableVersions do
      Error(error) => do
        # A release list needs the network; the installed ones do not, and
        # they are the half a user can still act on.
        IO.printError("${Console.RED}error:${Console.RESET} could not read released versions: ${error}\n")
        []
      end
      Ok(versions) => versions
    end
    let installed = Tey.Toolchain.installedVersions
    let all = Tey.Toolchain.newestFirst([...available, ...installed])
    # Pre-releases are opt-in: someone reading this list is usually choosing
    # what to install, and `0.4.0-rc.1` sitting above `0.3.9` is an invitation
    # to install an rc by accident. An INSTALLED pre-release is always shown —
    # hiding a version the machine already has would be a lie about the
    # machine, and it is how you would find the one to uninstall.
    var versions = all
    if !options.flagEnabled?("pre")
      versions = all.filter { |version| Tey.Semver.stable?(version) || installed.contains?(version) }
    end
    if versions.empty?
      IO.printLine("${Console.DIM}No Kex versions found${Console.RESET}")
      return 0
    end
    let selected = Tey.Toolchain.selected.or("")
    versions.each do |version|
      IO.printLine(Tey.Cli.versionLine(version, installed, selected))
    end
    if !Tey.Toolchain.selectionHealthy?
      IO.printError("${Console.RED}error:${Console.RESET} Kex ${selected} is selected but not installed; pick another with `tey kex use <version>`\n")
    end
    let hidden = all.count - versions.count
    IO.printLine("") if hidden > 0
    IO.printLine("${Console.DIM}${hidden} pre-release(s) hidden; pass --pre to see them${Console.RESET}") if hidden > 0
    Tey.Cli.reportShim(selected)
    0
  end

  # Every `kex install` spelling, told apart by what follows the command
  # words:
  #
  #   (nothing)          the current Kex — the newest STABLE one, since an rc
  #                      is not what someone who named no version is asking
  #                      for. `--pre` says they are. On a machine with nothing
  #                      installed the bundled Kex IS that Kex: already on the
  #                      disk, the version this Tey shipped with, and no
  #                      network. Once something is installed this means the
  #                      newest release again, or the first upgrade would keep
  #                      reinstalling what the package manager shipped.
  #   latest             the same, by name — because "install the newest one"
  #                      is a thing people type, and having to know that the
  #                      way to say it is to say nothing is a poor answer. It
  #                      also gets past the bundled-seed shortcut above.
  #   <version>          exactly that one.
  #   <src> <version>    build and install from a source checkout.
  foul kexInstall(options: ParsedOptions) -> Integer do
    match options.arguments do
      [] => Tey.Cli.kexInstallCurrent(options)
      ["latest"] => Tey.Cli.kexInstallLatest(options)
      [version] => Tey.Cli.installKex(version)
      [source, version] => Tey.Cli.kexInstallSource(source, version)
      _ => Tey.Cli.unknown("kex install")
    end
  end

  foul kexInstallCurrent(options: ParsedOptions) -> Integer do
    if Tey.Toolchain.installedVersions.empty? && Tey.Toolchain.bundled != None
      match Tey.Toolchain.installBundled do
        Ok(prefix) => do
          IO.printLine("${Console.GREEN}Installed${Console.RESET} and selected the bundled Kex, ${Console.DIM}at ${prefix}${Console.RESET}")
          Tey.Cli.reportShim(Tey.Toolchain.selected.or(""))
          return 0
        end
        Error(error) => do
          IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
          return 1
        end
      end
    end
    match Tey.Cli.newestVersion(options) do
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        1
      end
      Ok(version) => Tey.Cli.installKex(version)
    end
  end

  foul kexInstallLatest(options: ParsedOptions) -> Integer do
    match Tey.Cli.newestVersion(options) do
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        1
      end
      Ok(version) => do
        return Tey.Cli.alreadyCurrent(version) if Tey.Toolchain.installed?(version)
        Tey.Cli.installKex(version)
      end
    end
  end

  foul newestVersion(options: ParsedOptions) -> String or! String do
    options.flagEnabled?("pre") then Tey.Toolchain.latestIncludingPreReleases else Tey.Toolchain.latestStable
  end

  foul kexInstallSource(source: String, version: String) -> Integer do
    match Tey.Toolchain.installSource(source, version) do
      Ok(prefix) => do
        IO.printLine("${Console.GREEN}Installed${Console.RESET} and selected Kex ${Console.BOLD}${version}${Console.RESET} ${Console.DIM}at ${prefix}${Console.RESET}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        1
      end
    end
  end

  foul kexUninstall(version: String) -> Integer do
    match Tey.Toolchain.uninstall(version) do
      Ok(prefix) => do
        IO.printLine("${Console.GREEN}Removed${Console.RESET} Kex ${Console.BOLD}${version}${Console.RESET} ${Console.DIM}from ${prefix}${Console.RESET}")
        IO.printLine("No Kex is selected; pick one with `tey kex use <version>`") if Tey.Toolchain.selected == None
        0
      end
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        1
      end
    end
  end

  # Prints the compiler `kex` would run, installing the bundled one if that has
  # not happened yet. The dispatcher in bin/kex calls this when nothing is
  # selected, which is what makes a fresh install runnable without a `tey`
  # command being typed first.
  foul kexWhich -> Integer do
    match Tey.Toolchain.resolved do
      Just(path) => do
        IO.printLine(path)
        0
      end
      None => do
        IO.printError("${Console.RED}error:${Console.RESET} no Kex is installed\n")
        1
      end
    end
  end

  foul kexUse(selector: String) -> Integer do
    match Tey.Toolchain.resolveSelector(selector) do
      None => do
        IO.printError("${Console.RED}error:${Console.RESET} no Kex is installed; install one with `tey kex install`\n")
        1
      end
      Just(version) => do
        # Asked BEFORE selecting, because selecting the bundled Kex installs
        # it — and a line that said only "Using Kex 0.3.2" would hide that a
        # copy had just been made.
        let alreadyInstalled = Tey.Toolchain.installed?(version)
        if Tey.Toolchain.use(version)
          if alreadyInstalled
            IO.printLine("Using Kex ${version}")
          else
            IO.printLine("Using Kex ${version} — installed from the bundled copy")
          end
          Tey.Cli.reportShim(version)
          0
        else
          IO.printError("${Console.RED}error:${Console.RESET} Kex ${version} is not installed\n")
          1
        end
      end
    end
  end

  foul dispatchParsed(args: [String], options: ParsedOptions) -> Integer do
    return Tey.Cli.showVersion() if options.flagEnabled?("version")
    # `--help`, and a line with no command at all, are both `run`'s job — but
    # its exits for them call `this.printHelp`, which the BEAM backend emits at
    # the wrong arity, so the compiled `tey` answers `undef` (kexhq/kex#192).
    # The text is the same from here; drop this once that call lowers right.
    return Tey.Cli.cli.printHelp if options.flagEnabled?("help") || options.arguments.empty?
    # A built-in needs no manifest, and reading one costs a `kex --emit-ast`
    # per invocation — a price `bin/kex` would pay on every single `kex` call,
    # since it asks `tey kex which` where the compiler is. So a package's own
    # commands are resolved only for a line that names none of Tey's.
    return Tey.Cli.parser.run(args) if Tey.Cli.builtin?(options.arguments)
    return Tey.Cli.cli.run(args)
  end

  # Whether the line opens with a command Tey answers itself.
  foul builtin?(arguments: [String]) -> Bool do
    match OptionParser.commandFor(Tey.Cli.parser.commands, arguments) do
      Just(_) => true
      None => false
    end
  end

  # The `command(...)` declarations of the package in this directory, or none
  # outside a package. A manifest that does not READ is reported here rather
  # than swallowed: the alternative is `tey fmt` answering "unknown command"
  # while the real problem is a typo three lines up in package.kex.
  foul packageCommands -> [Command] do
    return [] if !FS.File.file?("package.kex")
    match Tey.Commands.manifest do
      Error(error) => do
        IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
        []
      end
      Ok(package) => package.commands
    end
  end

  # `tey help`, and `tey help --json` for a tool rather than a person.
  #
  # The JSON is the same list the help text renders — built-ins and this
  # package's own, each carrying the `section` that separates them — so an
  # editor offering commands as tasks reads Tey's answer instead of parsing
  # package.kex with a second manifest reader of its own. Outside a package it
  # is the built-ins alone: no package.kex is a state, not a failure, and an
  # editor asks in every workspace it opens.
  foul help(asJson: Bool) -> Integer do
    return Tey.Cli.cli.printHelp if !asJson
    let entries = Tey.Cli.cli.commands.map do |command|
      { name: command.name, usage: command.usage,
        description: command.description, section: command.section }
    end
    IO.printLine(JSON.stringify({ commands: entries }))
    0
  end


  foul incomplete(command: String, missing: String) -> Integer do
    IO.printError("${Console.RED}error:${Console.RESET} `tey ${command}` needs ${missing}\n")
    1
  end

  foul unknown(command: String) -> Integer do
    IO.printError("${Console.RED}error:${Console.RESET} unknown or incomplete command '${command}'\n")
    1
  end
end
