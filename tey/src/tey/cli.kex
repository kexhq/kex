module Tey.Cli

using Tey.Commands, only: [add, build, clean, init, install, list, lock, runPackage, setupMergeDriver, test]
using Tey.Toolchain, only: [installSource, use]

let parser -> OptionConfig do
  OptionParser.define("tey", "Package and Kex toolchain manager")
    .flag("help", Just('h'), "Show this help")
    .flag("version", Just('V'), "Show Tey and active Kex versions")
    .flag("lib", None, "Create a library package with `tey init`")
    .string("git", None, "Git URL for `tey add`", None, false)
    .string("tag", None, "Git tag or tag requirement", None, false)
    .string("branch", None, "Git branch", None, false)
    .string("ref", None, "Git ref or commit", None, false)
    .string("without", None, "Dependency group to omit", None, false)
    .flag("cache", None, "Remove the complete cache with `tey clean`")
    .flag("remove", None, "Remove configuration installed by `tey setup`")
    .flag("merge-driver", None, "Run `tey lock` as a Git merge driver")
    .flag("pre", None, "Include pre-releases in `tey kex list` and `tey kex install`")
    .flag("installed", None, "Restrict `tey kex list` to toolchains on this machine")
    .flag("json", None, "Print `tey kex list` as one JSON document (needs --installed)")
end

foul dispatch(args: [String]) -> Integer do
  match Tey.Cli.parser.parse(args) do
    Error(error) => do
      IO.printError("tey: ${OptionParser.errorMessage(error)}\n\n${Tey.Cli.parser.help}\n")
      1
    end
    Ok(options) => do
      return Tey.Cli.showVersion() if options.flagEnabled?("version")

      return Tey.Cli.showHelp() if options.flagEnabled?("help") || options.arguments.empty?

      Tey.Cli.dispatchCommand(options.arguments, options)
    end
  end
end

private do
  foul installKex(version: String) -> Integer do
    match Tey.Toolchain.installRelease(version) do
      Ok(prefix) => do
        IO.printLine("Installed and selected Kex ${version} at ${prefix}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) => do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  # Re-downloading a version already on the disk to arrive where you already
  # are is waste, so `install latest` that finds nothing to do selects it and
  # says so rather than reporting an install that did not happen.
  foul alreadyCurrent(version: String) -> Integer do
    Tey.Toolchain.use(version)
    IO.printLine("Kex ${version} is the newest release and already installed; selected it")
    Tey.Cli.reportShim(version)
    return 0
  end

  # "* 0.3.0  installed, selected" — the marker is the selected one, so the
  # active version is findable by eye in a long list.
  let versionLine(version: String, installed: [String], selected: String) -> String do
    let marker = version == selected then "*" else " "
    let channel = Tey.Semver.stable?(version) then [] else ["pre-release"]
    let notes = installed.contains?(version) then [...channel, "installed"] else channel
    let all = version == selected then [...notes, "selected"] else notes
    return "${marker} ${version}" if all.empty?
    return "${marker} ${version}  ${all.join(", ")}"
  end

  # The offline listing: what is on this machine, newest first, in the same
  # dress as the full one. Every entry is installed except possibly the
  # bundled seed, so "installed" is not spelled out per line — only the seed
  # gets a note, saying why `tey kex use` accepts it anyway.
  foul listInstalled -> Integer do
    let toolchains = Tey.Toolchain.selectableToolchains
    if toolchains.empty?
      IO.printLine("No Kex toolchains installed")
      return 0
    end
    let selected = Tey.Toolchain.selected.or("")
    toolchains.each do |toolchain|
      let marker = toolchain.version == selected then "*" else " "
      let notes = toolchain.bundled? then ["bundled, not installed"] else []
      let line = notes.empty? then "${marker} ${toolchain.version}" else "${marker} ${toolchain.version}  ${notes.join(", ")}"
      IO.printLine(line)
    end
    if !Tey.Toolchain.selectionHealthy?
      IO.printError("tey: Kex ${selected} is selected but not installed; pick another with `tey kex use <version>`\n")
    end
    Tey.Cli.reportShim(selected)
    0
  end

  # `tey kex list --installed --json` — the same listing as `listInstalled`,
  # as one JSON document for a tool (an editor's toolchain picker) to read.
  # Nothing here touches the network: an editor asks on its own schedule, and
  # a picker that stalled on a release list would be worse than one that
  # listed nothing. Nothing installed is an empty array rather than an error
  # for the same reason — an empty picker is a state, not a failure.
  foul listInstalledJson -> Integer do
    let selected = Tey.Toolchain.selected
    let toolchains = Tey.Toolchain.selectableToolchains.map do |toolchain|
      {
        version: toolchain.version,
        binary: toolchain.binary,
        selected: selected == Just(toolchain.version),
        bundled: toolchain.bundled?
      }
    end
    # Just(...) unwrapped rather than stringified: an optional prints as
    # `Just("0.4.0")`, and the document wants "0.4.0" — or null, for no
    # selection, which is what None already stringifies to.
    let selectedText = match selected do
      Just(version) => version
      None => None
    end
    IO.printLine(JSON.stringify({ home: Tey.Toolchain.home, selected: selectedText, toolchains: toolchains }))
    0
  end

  # Whether a `kex` is reachable as a command. Installed beside `tey` — which
  # is how brew and the release tarball put it there — it already is, and
  # telling someone to edit PATH when their shell can run `kex` would be
  # noise about a problem they do not have.
  foul kexOnPath? -> Bool do
    return ENV.get("PATH", "").split(":").any? do |directory|
      !directory.empty? && FS.File.file?("${directory}/kex")
    end
  end

  # The Tey home's own `kex` only takes effect if that directory is on PATH,
  # and that is the one part Tey cannot do for the user. Say so exactly once,
  # when it matters — which is when nothing else has put a `kex` there.
  foul reportShim(selected: String) -> Void do
    if !selected.empty? && !Tey.Cli.kexOnPath?
      IO.printLine("")
      IO.printLine("Add ${Tey.Toolchain.binDirectory} to PATH so `kex` runs the selected version.")
    end
  end

  foul showVersion -> Integer do
    # `.number` already parenthesizes the revision, and nesting that inside
    # another pair reads badly: "tey 0.1.0 (Kex 0.3.0-beta (abc1234))".
    let kex = match Kex.Kernel.VERSION.revision do
      Just(revision) => "${Kex.Kernel.VERSION.release}, ${revision}"
      None => Kex.Kernel.VERSION.release
    end
    IO.printLine("tey ${Tey.Version.number} (Kex ${kex})")
    return 0
  end

  foul showHelp -> Integer do
    IO.printLine(Tey.Cli.parser.help)
    # Raw string: these lines are the OUTPUT, so they stay flush with the
    # left margin rather than with the code around them.
    IO.printLine(`
Commands:
  new <name> [--lib]       create a Kex package in a new directory
  init [<name>] [--lib]    create a Kex package in this directory
  add <name>               add a Git dependency and update tey.lock
  install                  fetch dependencies, and install this package's targets
  update [name]            re-resolve dependencies
  lock                     resolve and write tey.lock
  list                     show locked dependencies
  run [args...]            run the package entrypoint
  build                    compile the package, and each target(...) into an executable
  test                     run spec/*.spec.kex
  clean [--cache]          inspect or remove the global cache
  setup merge-driver      configure Git's tey.lock merge driver
  kex list [--pre]         show Kex versions, newest first
  kex list --installed     show only the Kex toolchains on this machine
  kex list --installed --json
                            print them as one JSON document, offline
  kex install [<version>]  install a Kex (newest release by default)
  kex install latest       install the newest release by name
  kex install --pre        install the newest Kex of any channel
  kex install <src> <version>
                           build and install from a source checkout
  kex uninstall <version>  remove an installed Kex
  kex use <version>        select an installed Kex toolchain
  kex use latest           select the newest Kex already on this machine
  kex which                print the compiler the kex command runs
`)
    return 0
  end

  foul dispatchCommand(["new", name], options: ParsedOptions) -> Integer do
    Tey.Commands.new(name, options.flagEnabled?("lib"))
  end
  # Bare `tey init` names the package after the directory it is standing in;
  # an argument overrides that, for a checkout whose directory name is not the
  # package name.
  foul dispatchCommand(["init"], options: ParsedOptions) -> Integer do
    Tey.Commands.init("", options.flagEnabled?("lib"))
  end
  foul dispatchCommand(["init", name], options: ParsedOptions) -> Integer do
    Tey.Commands.init(name, options.flagEnabled?("lib"))
  end
  foul dispatchCommand(["install"], options: ParsedOptions) -> Integer do
    Tey.Commands.install(options.value("without", ""))
  end
  foul dispatchCommand(["lock"], _) -> Integer = Tey.Commands.lock
  foul dispatchCommand(["lock", _, _, _], options: ParsedOptions) -> Integer do
    options.flagEnabled?("merge-driver") then Tey.Commands.lock else Tey.Cli.unknown("lock")
  end
  foul dispatchCommand(["add", name], options: ParsedOptions) -> Integer = Tey.Commands.add(name, options)
  foul dispatchCommand(["update"], _) -> Integer = Tey.Commands.lock
  foul dispatchCommand(["update", _], _) -> Integer = Tey.Commands.lock
  foul dispatchCommand(["list"], _) -> Integer = Tey.Commands.list
  foul dispatchCommand(["build"], _) -> Integer = Tey.Commands.build
  foul dispatchCommand(["run" | arguments], _) -> Integer = Tey.Commands.runPackage(arguments)
  foul dispatchCommand(["test"], _) -> Integer = Tey.Commands.test
  foul dispatchCommand(["clean"], options: ParsedOptions) -> Integer do
    Tey.Commands.clean(options.flagEnabled?("cache"))
  end
  foul dispatchCommand(["setup", "merge-driver"], options: ParsedOptions) -> Integer do
    Tey.Commands.setupMergeDriver(options.flagEnabled?("remove"))
  end

  foul dispatchCommand(["kex", "list"], options: ParsedOptions) -> Integer do
    # JSON is the offline half only, for now: `--json` over released versions
    # would have to touch the network and decide a shape for entries no tool
    # has asked to consume. Saying so beats half-doing it.
    if options.flagEnabled?("json")
      if !options.flagEnabled?("installed")
        IO.printError("tey: --json needs --installed; released versions have no JSON form\n")
        return 1
      end
      return Tey.Cli.listInstalledJson()
    end
    return Tey.Cli.listInstalled() if options.flagEnabled?("installed")
    let available = match Tey.Toolchain.availableVersions do
      Error(error) => do
        # A release list needs the network; the installed ones do not, and
        # they are the half a user can still act on.
        IO.printError("tey: could not read released versions: ${error}\n")
        []
      end
      Ok(versions) => versions
    end
    let installed = Tey.Toolchain.installedVersions
    let all = Tey.Toolchain.newestFirst([...available, ...installed])
    # Pre-releases are opt-in: someone reading this list is usually choosing
    # what to install, and `0.4.0-rc.1` sitting above `0.3.9` is an invitation
    # to install an rc by accident. An INSTALLED pre-release is always shown —
    # hiding a version the machine already has would be a lie about the
    # machine, and it is how you would find the one to uninstall.
    var versions = all
    if !options.flagEnabled?("pre")
      versions = all.filter { |version| Tey.Semver.stable?(version) || installed.contains?(version) }
    end
    if versions.empty?
      IO.printLine("No Kex versions found")
      return 0
    end
    let selected = Tey.Toolchain.selected.or("")
    versions.each do |version|
      IO.printLine(Tey.Cli.versionLine(version, installed, selected))
    end
    if !Tey.Toolchain.selectionHealthy?
      IO.printError("tey: Kex ${selected} is selected but not installed; pick another with `tey kex use <version>`\n")
    end
    let hidden = all.count - versions.count
    IO.printLine("") if hidden > 0
    IO.printLine("${hidden} pre-release(s) hidden; pass --pre to see them") if hidden > 0
    Tey.Cli.reportShim(selected)
    0
  end

  # Bare `tey kex install` means "the current Kex", which is the newest
  # STABLE one — an rc is not what someone who named no version is asking
  # for. `--pre` says they are: it takes the newest of any channel, which
  # during a pre-stability run may be the only thing published.
  #
  # On a machine with nothing installed, the bundled Kex is that
  # Kex: it is already on the disk, it is the version this Tey was shipped
  # with, and taking it needs no network. Once something IS installed, this
  # means the newest release again — otherwise the first upgrade would keep
  # reinstalling the version the package manager shipped.
  foul dispatchCommand(["kex", "install"], options: ParsedOptions) -> Integer do
    if Tey.Toolchain.installedVersions.empty? && Tey.Toolchain.bundled != None
      match Tey.Toolchain.installBundled do
        Ok(prefix) => do
          IO.printLine("Installed and selected the bundled Kex, at ${prefix}")
          Tey.Cli.reportShim(Tey.Toolchain.selected.or(""))
          return 0
        end
        Error(error) => do
          IO.printError("tey: ${error}\n")
          return 1
        end
      end
    end

    let newest = options.flagEnabled?("pre") then Tey.Toolchain.latestIncludingPreReleases else Tey.Toolchain.latestStable
    match newest do
      Error(error) => do
        IO.printError("tey: ${error}\n")
        1
      end
      Ok(version) => Tey.Cli.installKex(version)
    end
  end

  # `latest` is the same thing a bare `tey kex install` means — the newest
  # RELEASE, or the newest of any channel with `--pre`. It exists because
  # "install the newest one" is a thing people type, and having to know that
  # the way to say it is to say nothing is a poor answer. Naming it also gets
  # past the bundled-seed shortcut a bare install takes on an empty machine:
  # `tey kex install latest` fetches the newest release even when a bundled
  # copy is sitting there unused.
  foul dispatchCommand(["kex", "install", "latest"], options: ParsedOptions) -> Integer do
    let newest = options.flagEnabled?("pre") then Tey.Toolchain.latestIncludingPreReleases else Tey.Toolchain.latestStable
    match newest do
      Error(error) => do
        IO.printError("tey: ${error}\n")
        1
      end
      Ok(version) => do
        return Tey.Cli.alreadyCurrent(version) if Tey.Toolchain.installed?(version)
        Tey.Cli.installKex(version)
      end
    end
  end

  foul dispatchCommand(["kex", "install", version], _) -> Integer do
    Tey.Cli.installKex(version)
  end

  foul dispatchCommand(["kex", "uninstall", version], _) -> Integer do
    match Tey.Toolchain.uninstall(version) do
      Ok(prefix) => do
        IO.printLine("Removed Kex ${version} from ${prefix}")
        IO.printLine("No Kex is selected; pick one with `tey kex use <version>`") if Tey.Toolchain.selected == None
        0
      end
      Error(error) => do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  foul dispatchCommand(["kex", "install", source, version], _) -> Integer do
    match Tey.Toolchain.installSource(source, version) do
      Ok(prefix) => do
        IO.printLine("Installed and selected Kex ${version} at ${prefix}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) => do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  # Prints the compiler `kex` would run, installing the bundled one
  # if that has not happened yet. The dispatcher in bin/kex calls this when
  # nothing is selected, which is what makes a fresh install runnable without
  # a `tey` command being typed first.
  foul dispatchCommand(["kex", "which"], _) -> Integer do
    match Tey.Toolchain.resolved do
      Just(path) => do
        IO.printLine(path)
        0
      end
      None => do
        IO.printError("tey: no Kex is installed\n")
        1
      end
    end
  end

  # `latest` selects the newest Kex this machine already has, so the way back
  # to the current one is not "remember which number it was".
  foul dispatchCommand(["kex", "use", selector], _) -> Integer do
    match Tey.Toolchain.resolveSelector(selector) do
      None => do
        IO.printError("tey: no Kex is installed; install one with `tey kex install`\n")
        1
      end
      Just(version) => do
        # Asked BEFORE selecting, because selecting the bundled Kex
        # installs it — and a line that said only "Using Kex 0.3.2" would hide
        # that a copy had just been made.
        let alreadyInstalled = Tey.Toolchain.installed?(version)
        if Tey.Toolchain.use(version)
          if alreadyInstalled
            IO.printLine("Using Kex ${version}")
          else
            IO.printLine("Using Kex ${version} — installed from the bundled copy")
          end
          Tey.Cli.reportShim(version)
          0
        else
          IO.printError("tey: Kex ${version} is not installed\n")
          1
        end
      end
    end
  end

  foul dispatchCommand([command | _], _) -> Integer do
    Tey.Cli.unknown(command)
  end
  foul dispatchCommand([], _) -> Integer = Tey.Cli.showHelp()

  foul unknown(command: String) -> Integer do
    IO.printError("tey: unknown or incomplete command '${command}'\n")
    1
  end
end
