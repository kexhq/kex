foul module Tey.Cli

using Tey.Commands, only: [add, build, clean, init, install, list, lock, runPackage, setupMergeDriver, test]
using Tey.Toolchain, only: [installSource, use]

let parser -> OptionConfig do
  OptionParser.define("tey", "Package and Kex toolchain manager")
    .flag("help", Just('h'), "Show this help")
    .flag("version", Just('V'), "Show Tey and active Kex versions")
    .flag("lib", None, "Create a library package with `tey init`")
    .string("git", None, "Git URL for `tey add`", None, false)
    .string("tag", None, "Git tag or tag requirement", None, false)
    .string("branch", None, "Git branch", None, false)
    .string("ref", None, "Git ref or commit", None, false)
    .string("without", None, "Dependency group to omit", None, false)
    .flag("cache", None, "Remove the complete cache with `tey clean`")
    .flag("remove", None, "Remove configuration installed by `tey setup`")
    .flag("merge-driver", None, "Run `tey lock` as a Git merge driver")
    .flag("pre", None, "Include pre-releases in `tey kex list` and `tey kex install`")
end

let dispatch(args: [String]) -> Integer do
  match Tey.Cli.parser.parse(args) do
    Error(error) -> do
      IO.printError("tey: ${OptionParser.errorMessage(error)}\n\n${Tey.Cli.parser.help}\n")
      1
    end
    Ok(options) -> do
      return Tey.Cli.showVersion() if options.flagEnabled?("version")

      return Tey.Cli.showHelp() if options.flagEnabled?("help") || options.arguments.empty?

      Tey.Cli.dispatchCommand(options.arguments, options)
    end
  end
end

private do
  let installKex(version: String) -> Integer do
    match Tey.Toolchain.installRelease(version) do
      Ok(prefix) -> do
        IO.printLine("Installed and selected Kex ${version} at ${prefix}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) -> do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  # "* 0.3.0  installed, selected" — the marker is the selected one, so the
  # active version is findable by eye in a long list.
  let versionLine(version: String, installed: [String], selected: String) -> String do
    let marker = version == selected then "*" else " "
    let channel = Tey.Semver.stable?(version) then [] else ["pre-release"]
    let notes = installed.contains?(version) then [...channel, "installed"] else channel
    let all = version == selected then [...notes, "selected"] else notes
    return "${marker} ${version}" if all.empty?
    return "${marker} ${version}  ${all.join(", ")}"
  end

  # The shim only takes effect if its directory is on PATH, and that is the
  # one part Tey cannot do for the user. Say so exactly once, when it matters.
  let reportShim(selected: String) -> Void do
    if !selected.empty? && !ENV.get("PATH", "").split(":").contains?(Tey.Toolchain.binDirectory)
      IO.printLine("")
      IO.printLine("Add ${Tey.Toolchain.binDirectory} to PATH so `kex` runs the selected version.")
    end
  end

  let showVersion -> Integer do
    # `.number` already parenthesizes the revision, and nesting that inside
    # another pair reads badly: "tey 0.1.0 (Kex 0.3.0-beta (abc1234))".
    let kex = match Kex.Kernel.VERSION.revision do
      Just(revision) -> "${Kex.Kernel.VERSION.release}, ${revision}"
      None -> Kex.Kernel.VERSION.release
    end
    IO.printLine("tey 0.1.0 (Kex ${kex})")
    return 0
  end

  let showHelp -> Integer do
    IO.printLine(Tey.Cli.parser.help)
    # Raw string: these lines are the OUTPUT, so they stay flush with the
    # left margin rather than with the code around them.
    IO.printLine(`
Commands:
  init <name>              create a Kex package
  add <name>               add a Git dependency and update tey.lock
  install                  resolve, fetch and write tey.lock
  update [name]            re-resolve dependencies
  lock                     resolve and write tey.lock
  list                     show locked dependencies
  run [args...]            run the package entrypoint
  build                    compile the package entrypoint
  test                     run spec/*.spec.kex
  clean [--cache]          inspect or remove the global cache
  setup merge-driver      configure Git's tey.lock merge driver
  kex list [--pre]         show Kex versions, newest first
  kex install [<version>]  install a Kex (newest release by default)
  kex install --pre        install the newest Kex of any channel
  kex install <src> <version>
                           build and install from a source checkout
  kex uninstall <version>  remove an installed Kex
  kex use <version>        select an installed Kex toolchain
`)
    return 0
  end

  let dispatchCommand(["init", name], options: ParsedOptions) -> Integer do
    Tey.Commands.init(name, options.flagEnabled?("lib"))
  end
  let dispatchCommand(["install"], options: ParsedOptions) -> Integer do
    Tey.Commands.install(options.value("without", ""))
  end
  let dispatchCommand(["lock"], _) -> Integer = Tey.Commands.lock
  let dispatchCommand(["lock", _, _, _], options: ParsedOptions) -> Integer do
    options.flagEnabled?("merge-driver") then Tey.Commands.lock else Tey.Cli.unknown("lock")
  end
  let dispatchCommand(["add", name], options: ParsedOptions) -> Integer = Tey.Commands.add(name, options)
  let dispatchCommand(["update"], _) -> Integer = Tey.Commands.lock
  let dispatchCommand(["update", _], _) -> Integer = Tey.Commands.lock
  let dispatchCommand(["list"], _) -> Integer = Tey.Commands.list
  let dispatchCommand(["build"], _) -> Integer = Tey.Commands.build
  let dispatchCommand(["run" | arguments], _) -> Integer = Tey.Commands.runPackage(arguments)
  let dispatchCommand(["test"], _) -> Integer = Tey.Commands.test
  let dispatchCommand(["clean"], options: ParsedOptions) -> Integer do
    Tey.Commands.clean(options.flagEnabled?("cache"))
  end
  let dispatchCommand(["setup", "merge-driver"], options: ParsedOptions) -> Integer do
    Tey.Commands.setupMergeDriver(options.flagEnabled?("remove"))
  end

  let dispatchCommand(["kex", "list"], options: ParsedOptions) -> Integer do
    let available = match Tey.Toolchain.availableVersions do
      Error(error) -> do
        # A release list needs the network; the installed ones do not, and
        # they are the half a user can still act on.
        IO.printError("tey: could not read released versions: ${error}\n")
        []
      end
      Ok(versions) -> versions
    end
    let installed = Tey.Toolchain.installedVersions
    let all = Tey.Toolchain.newestFirst([...available, ...installed])
    # Pre-releases are opt-in: someone reading this list is usually choosing
    # what to install, and `0.4.0-rc.1` sitting above `0.3.9` is an invitation
    # to install an rc by accident. An INSTALLED pre-release is always shown —
    # hiding a version the machine already has would be a lie about the
    # machine, and it is how you would find the one to uninstall.
    var versions = all
    if !options.flagEnabled?("pre")
      versions = all.filter { |version| Tey.Semver.stable?(version) || installed.contains?(version) }
    end
    if versions.empty?
      IO.printLine("No Kex versions found")
      return 0
    end
    let selected = Tey.Toolchain.selected.or("")
    versions.each do |version|
      IO.printLine(Tey.Cli.versionLine(version, installed, selected))
    end
    if !Tey.Toolchain.selectionHealthy?
      IO.printError("tey: Kex ${selected} is selected but not installed; pick another with `tey kex use <version>`\n")
    end
    let hidden = all.count - versions.count
    IO.printLine("") if hidden > 0
    IO.printLine("${hidden} pre-release(s) hidden; pass --pre to see them") if hidden > 0
    Tey.Cli.reportShim(selected)
    0
  end

  # Bare `tey kex install` means "the current Kex", which is the newest
  # STABLE one — an rc is not what someone who named no version is asking
  # for. `--pre` says they are: it takes the newest of any channel, which
  # during a pre-stability run may be the only thing published.
  let dispatchCommand(["kex", "install"], options: ParsedOptions) -> Integer do
    let newest = options.flagEnabled?("pre") then Tey.Toolchain.latestIncludingPreReleases else Tey.Toolchain.latestStable
    match newest do
      Error(error) -> do
        IO.printError("tey: ${error}\n")
        1
      end
      Ok(version) -> Tey.Cli.installKex(version)
    end
  end

  let dispatchCommand(["kex", "install", version], _) -> Integer do
    Tey.Cli.installKex(version)
  end

  let dispatchCommand(["kex", "uninstall", version], _) -> Integer do
    match Tey.Toolchain.uninstall(version) do
      Ok(prefix) -> do
        IO.printLine("Removed Kex ${version} from ${prefix}")
        IO.printLine("No Kex is selected; pick one with `tey kex use <version>`") if Tey.Toolchain.selected == None
        0
      end
      Error(error) -> do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  let dispatchCommand(["kex", "install", source, version], _) -> Integer do
    match Tey.Toolchain.installSource(source, version) do
      Ok(prefix) -> do
        IO.printLine("Installed and selected Kex ${version} at ${prefix}")
        Tey.Cli.reportShim(version)
        0
      end
      Error(error) -> do
        IO.printError("tey: ${error}\n")
        1
      end
    end
  end

  let dispatchCommand(["kex", "use", version], _) -> Integer do
    if Tey.Toolchain.use(version)
      IO.printLine("Using Kex ${version}")
      Tey.Cli.reportShim(version)
      0
    else
      IO.printError("tey: Kex ${version} is not installed\n")
      1
    end
  end

  let dispatchCommand([command | _], _) -> Integer do
    Tey.Cli.unknown(command)
  end
  let dispatchCommand([], _) -> Integer = Tey.Cli.showHelp()

  let unknown(command: String) -> Integer do
    IO.printError("tey: unknown or incomplete command '${command}'\n")
    1
  end
end
