foul module Tey.Commands

using Tey.Cache, only: [fetch, root, verify]
using Tey.Lockfile, only: [LockState, decode, encode]
using Tey.Manifest, only: [ManifestPackage, read]
using Tey.Resolver, only: [resolvePackage]
using Tey.Toolchain, only: [kex]

let manifest -> Result<ManifestPackage, String> do
  match FS.File.read("package.kex") do
    Just(text) -> Tey.Manifest.read(text)
    None -> Error("package.kex not found")
  end
end

let lock -> Integer do
  let package = match Tey.Commands.manifest do Error(error) -> return Tey.Commands.fail(error) Ok(value) -> value end
  let resolved = match Tey.Resolver.resolvePackage(package) do Error(error) -> return Tey.Commands.fail(error) Ok(value) -> value end
  if FS.File.write("tey.lock", Tey.Lockfile.encode(resolved))
    IO.printLine("Locked ${resolved.lockedDependencies.count} package(s) with Kex ${resolved.kexVersion}")
    0
  else
    Tey.Commands.fail("could not write tey.lock")
  end
end

let add(name: String, options: ParsedOptions) -> Integer do
  let git = options.value("git", "")
  return Tey.Commands.fail("tey add requires --git URL") if git == ""
  let selected = ["tag", "branch", "ref"].filter { |key| options.value(key).present? }
  return Tey.Commands.fail("choose only one of --tag, --branch, or --ref") if selected.count > 1
  let selector = selected.first.or("ref")
  let requested = options.value(selector, "HEAD")
  let text = match FS.File.read("package.kex") do
    Just(value) -> value.trim
    None -> return Tey.Commands.fail("package.kex not found")
  end
  return Tey.Commands.fail("package.kex must end with 'end'") if !text.endsWith?("end")
  let body = text.chars.take(text.count - 3).join("")
  let updated = `__BODY__  tey("__NAME__", git: "__GIT__", __SELECTOR__: "__REQUESTED__")
end
`.replace("__BODY__", body)
.replace("__NAME__", name)
.replace("__GIT__", git)
.replace("__SELECTOR__", selector)
.replace("__REQUESTED__", requested)
  return Tey.Commands.fail("could not update package.kex") if !FS.File.write("package.kex", updated)
  Tey.Commands.lock
end

let install -> Integer do
  let state = match FS.File.read("tey.lock") do
    None -> do
      let status = Tey.Commands.lock
      return status if status != 0
      match FS.File.read("tey.lock") do
        Just(text) -> match Tey.Lockfile.decode(text) do
          Ok(value) -> value
          Error(error) -> return Tey.Commands.fail(error)
        end
        None -> return Tey.Commands.fail("could not read generated tey.lock")
      end
    end
    Just(text) -> match Tey.Lockfile.decode(text) do
      Ok(value) -> value
      Error(error) -> return Tey.Commands.fail(error)
    end
  end
  state.lockedDependencies.each do |dependency|
    let path = match Tey.Cache.fetch(dependency) do
      Error(error) -> return Tey.Commands.fail(error)
      Ok(value) -> value
    end
    match Tey.Cache.verify(dependency) do
      Error(error) -> return Tey.Commands.fail(error)
      Ok(_) -> IO.printLine("Installed ${Tey.Lockfile.dependencyName(dependency)} at ${path}")
    end
  end
  IO.printLine("Installed ${state.lockedDependencies.count} package(s)")
  0
end

let runPackage(extra: [String]) -> Integer do
  let package = match Tey.Commands.manifest do Error(error) -> return Tey.Commands.fail(error) Ok(value) -> value end
  match Process.run(Tey.Toolchain.kex, [package.entrypoint, ...extra]) do
    Error(error) -> Tey.Commands.fail(error)
    Ok(result) -> do
      if result.stdout != ""
        IO.print(result.stdout)
      end
      if result.stderr != ""
        IO.printError(result.stderr)
      end
      result.exitCode
    end
  end
end

let list -> Integer do
  let state = match Tey.Commands.readLock do
    Error(error) -> return Tey.Commands.fail(error)
    Ok(value) -> value
  end
  state.lockedDependencies.each do |dependency|
    IO.printLine(Tey.Lockfile.dependencyListLine(dependency))
  end
  0
end

let build -> Integer do
  let package = match Tey.Commands.manifest do Error(error) -> return Tey.Commands.fail(error) Ok(value) -> value end
  match Process.run(Tey.Toolchain.kex, ["--compile", package.entrypoint]) do
    Error(error) -> Tey.Commands.fail(error)
    Ok(result) -> do
      if result.stdout != ""
        IO.print(result.stdout)
      end
      if result.stderr != ""
        IO.printError(result.stderr)
      end
      result.exitCode
    end
  end
end

let test -> Integer do
  let specs = FS.Directory.files("spec").or([])
    .filter { |path| path.endsWith?(".spec.kex") }
    .sort
  if specs.empty?
    IO.printLine("No specs found")
    return 0
  end
  var status = 0
  specs.each do |spec|
    let result = match Process.run(Tey.Toolchain.kex, ["spec/${spec}"]) do
      Error(error) -> return Tey.Commands.fail(error)
      Ok(value) -> value
    end
    if result.stdout != ""
      IO.print(result.stdout)
    end
    if result.stderr != ""
      IO.printError(result.stderr)
    end
    status = result.exitCode if result.exitCode != 0
  end
  status
end

let clean(all?: Bool) -> Integer do
  if !all?
    IO.printLine("Cache is at ${Tey.Cache.root}; pass --cache to remove it")
    return 0
  end
  if FS.Directory.deleteAll(Tey.Cache.root)
    IO.printLine("Removed ${Tey.Cache.root}")
    0
  else
    Tey.Commands.fail("could not remove ${Tey.Cache.root}")
  end
end

let setupMergeDriver(remove?: Bool) -> Integer do
  let key = "merge.tey.driver"
  let arguments = remove? then ["config", "--global", "--unset-all", key] else ["config", "--global", key, "tey lock --merge-driver %O %A %B"]
  match Tey.Commands.runStatus("git", arguments) do
    0 -> do
      IO.printLine(remove? then "Removed Tey merge driver" else "Configured Tey merge driver")
      0
    end
    _ -> Tey.Commands.fail("could not update global Git configuration")
  end
end

let init(name: String, library: Bool) -> Integer do
  if !FS.Directory.create(name) || !FS.Directory.create("${name}/src") || !FS.Directory.create("${name}/spec")
    return Tey.Commands.fail("could not create project '${name}'")
  end
  # Backtick strings are raw: every line below lands verbatim in the
  # generated file, so the indentation here is the GENERATED file's, not
  # this function's.
  let entry = library then "" else `  entrypoint("src/main.kex")

  target("__NAME__", entrypoint: "src/main.kex")
`.replace("__NAME__", name)
  let source = library then `module __MODULE__ do
end
`.replace("__MODULE__", name.capitalize) else `main(args) do
  IO.printLine("Hello from __NAME__!")
end
`.replace("__NAME__", name)
  let manifestText = `bundle "__NAME__" do
  version("0.1.0")
  kex(">= 0.3.0")
__ENTRY__end
`.replace("__NAME__", name).replace("__ENTRY__", entry)
  let sourcePath = library then "${name}/src/${name}.kex" else "${name}/src/main.kex"
  if !FS.File.write("${name}/package.kex", manifestText) || !FS.File.write(sourcePath, source)
    return Tey.Commands.fail("could not write project '${name}'")
  end
  FS.File.write("${name}/.gitattributes", "tey.lock merge=tey\n")
  IO.printLine("Created ${name}")
  0
end

private do
  let readLock -> Result<LockState, String> do
    match FS.File.read("tey.lock") do
      None -> Error("tey.lock not found; run `tey lock`")
      Just(text) -> Tey.Lockfile.decode(text)
    end
  end

  let runStatus(command: String, arguments: [String]) -> Integer do
    match Process.run(command, arguments) do
      Error(_) -> 127
      Ok(result) -> result.exitCode
    end
  end

  let fail(message: String) -> Integer do
    IO.printError("tey: ${message}\n")
    1
  end
end
