module Tey.Commands

using Tey.Cache, only: [fetch, packagePath, root, verify]
using Tey.Generator, only: [Operation]
using Tey.Lockfile, only: [LockState, decode, encode]
using Tey.Local, only: [Override, load, remove, set, validateAgainstLock]
using Tey.Manifest, only: [Command, ManifestPackage, Plugin, read]
using Tey.Resolver, only: [resolvePackage, resolveWorkspace]
using Tey.Plugin, only: [approved?, Binding]
using Tey.PluginHost, only: [Invocation]
using Tey.Toolchain, only: [kex]
using Tey.Workspace, only: [Context, Member, discover, select]

record WorkspaceRunState do
  runStatus : Integer = 0
  failedMembers : [String] = []
end

foul manifest -> ManifestPackage or! String do
  let context = Tey.Workspace.discover(FS.Directory.current).try
  match context.currentMember do
    Just(member) => Ok(member.memberManifest)
    None => Error("this workspace directory is not inside a package")
  end
end

foul lock -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  context.warnings.each { |warning| IO.printError("warning: ${warning}\n") }
  let resolved = match Tey.Resolver.resolveWorkspace(context) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let path = FS.Path.join(context.workspaceRoot, "tey.lock")
  if Tey.Commands.publishLock(path, resolved).ok?
    IO.printLine("${Console.GREEN}Locked${Console.RESET} ${resolved.lockedDependencies.count} package(s) with Kex ${resolved.kexVersion}")
    0
  else
    Tey.Commands.fail("could not write tey.lock")
  end
end

foul add(name: String, options: ParsedOptions) -> Integer do
  let git = options.value("git", "")
  return Tey.Commands.fail("tey add requires --git URL") if git == ""
  let selected = ["tag", "branch", "ref"].filter { |key| options.value(key).present? }
  return Tey.Commands.fail("choose only one of --tag, --branch, or --ref") if selected.count > 1
  let selector = selected.first.or("ref")
  let requested = options.value(selector, "HEAD")
  let text = match FS.File.read("package.kex") do
    Ok(value) => value.trim
    Error(_) => return Tey.Commands.fail("package.kex not found")
  end
  return Tey.Commands.fail("package.kex must end with 'end'") if !text.endsWith?("end")
  let body = text.chars.take(text.count - 3).join("")
  let updated = `
    $BODY$  tey("$NAME$", git: "$GIT$", $SELECTOR$: "$REQUESTED$")
    end
  `.substitute({"$BODY$": body, "$NAME$": name, "$GIT$": git,
                "$SELECTOR$": selector, "$REQUESTED$": requested})
  return Tey.Commands.fail("could not update package.kex") if !FS.File.write("package.kex", updated)
  Tey.Commands.updateDependencies(name)
end

foul localOverride(name: String, path: String, remove?: Bool,
                   list?: Bool) -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  if list?
    let overrides = match Tey.Local.load(context) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(value) => value
    end
    overrides.each do |override|
      IO.printLine("${override.overrideName} ${override.overridePath}")
    end
    return 0
  end
  if remove?
    return Tey.Commands.fail("tey local --remove needs a package name") if name == ""
    match Tey.Local.remove(context, name) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(_) => do IO.printLine("Removed local override ${name}") return 0 end
    end
  end
  return Tey.Commands.fail("tey local needs a package name and path") if name == "" || path == ""
  match Tey.Local.set(context, name, path) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(_) => do IO.printLine("Using local ${name} at ${path}") return 0 end
  end
end

# `--without dev` leaves a group's dependencies out of this install. The
# LOCKFILE still lists them — what is omitted is the fetching, so switching
# the flag off later needs no re-resolve.
foul install(without: String, packageName: String = "") -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let state = match Tey.Commands.installLock(context) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let wanted = state.lockedDependencies.filter do |dependency|
    let external = dependency.source != "workspace"
    let excluded = Tey.Lockfile.dependencyGroups(dependency).contains?(without)
    let included = without == "" || !excluded
    external && included
  end
  wanted.each do |dependency|
    let path = match Tey.Cache.fetch(dependency) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(value) => value
    end
    match Tey.Cache.verify(dependency) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(_) => IO.printLine("${Console.GREEN}Installed${Console.RESET} ${Tey.Lockfile.dependencyName(dependency)} ${Console.DIM}at ${path}${Console.RESET}")
    end
  end
  let approvedState = match Tey.Commands.approvePlugins(context, state) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let lockPath = FS.Path.join(context.workspaceRoot, "tey.lock")
  match Tey.Commands.publishLock(lockPath, approvedState) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(_) => ()
  end
  let externalCount = state.lockedDependencies.filter do |dependency|
    dependency.source != "workspace"
  end.count
  let omitted = externalCount - wanted.count
  IO.printLine("${Console.GREEN}Installed${Console.RESET} ${wanted.count} package(s)") if omitted == 0
  IO.printLine("${Console.GREEN}Installed${Console.RESET} ${wanted.count} package(s), ${omitted} omitted by --without ${without}") if omitted > 0
  Tey.Commands.installTargetsSelected(context, packageName)
end

foul updateDependencies(name: String = "") -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  if name != ""
    match Tey.Commands.validateUpdateName(
      Tey.Commands.updateScopeMembers(context), name
    ) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(_) => ()
    end
  end
  let fresh = match Tey.Resolver.resolveWorkspace(context) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let previous = match Tey.Commands.readLock do
    Ok(value) => Just(value)
    Error(_) => None
  end
  let wholeWorkspace = name == "" && match context.currentMember do
    None => true
    Just(member) => member.memberRoot == context.workspaceRoot
  end
  let roots = if name != ""
    [name]
  else
    match context.currentMember do
      Just(member) => member.memberManifest.manifestDependencies.map do |dependency|
        dependency.manifestName
      end
      None => []
    end
  end
  let state = match previous do
    None => fresh
    Just(old) => Tey.Commands.mergeUpdate(old, fresh, roots, wholeWorkspace)
  end
  let noPrevious = match previous do None => true Just(_) => false end
  let fetchAll = wholeWorkspace || noPrevious
  let changed = fetchAll then [] else Tey.Commands.dependencyClosure(fresh, roots)
  let externals = state.lockedDependencies.filter do |dependency|
    dependency.source != "workspace" && (fetchAll || changed.contains?(dependency.name))
  end
  externals.each do |dependency|
    match Tey.Cache.fetch(dependency) do
      Error(error) => return Tey.Commands.fail(error)
      Ok(_) => match Tey.Cache.verify(dependency) do
        Error(error) => return Tey.Commands.fail(error)
        Ok(_) => ()
      end
    end
  end
  let approved = match Tey.Commands.approvePlugins(context, state) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  match Tey.Commands.publishLock(FS.Path.join(context.workspaceRoot, "tey.lock"),
                                 approved) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(_) => do
      IO.printLine("${Console.GREEN}Updated${Console.RESET} ${externals.count} package(s)")
      return 0
    end
  end
end

# Names affected by a member-local or named update, including transitive
# dependency edges recorded in the newly resolved graph.
let dependencyClosure(state: LockState, roots: [String]) -> [String] do
  return Tey.Commands.collectClosure(state, roots, [])
end

# Publishes fresh workspace metadata and selected resolutions while retaining
# unrelated external pins. Existing approvals are carried forward here and
# subsequently filtered against the visible declarations by approvePlugins.
let mergeUpdate(previous: LockState, fresh: LockState, roots: [String],
                wholeWorkspace?: Bool) -> LockState do
  return LockState { ...fresh, pluginApprovals: previous.pluginApprovals } if wholeWorkspace?
  let selected = Tey.Commands.dependencyClosure(fresh, roots)
  let dependencies = fresh.lockedDependencies.map do |dependency|
    let replace = dependency.source == "workspace" || selected.contains?(dependency.name)
    if replace
      dependency
    else
      previous.lockedDependencies.find { |old| old.name == dependency.name }.or(dependency)
    end
  end
  return LockState { ...fresh, lockedDependencies: dependencies,
                     pluginApprovals: previous.pluginApprovals }
end

let lockReusable?(state: LockState, manifestFingerprint: String,
                  toolchain: Tey.Toolchain.ToolchainInfo) -> Bool do
  return (state.manifestFingerprint == manifestFingerprint &&
          state.kexVersion == Tey.Semver.release(toolchain.version) &&
          state.otpRelease == toolchain.reportedRuntimeOtpFloor.or(0))
end

let validateUpdateName(members: [Member], name: String) -> Void or! String do
  return Error("workspace has no direct dependency named `${name}`") if members.empty?
  let manifest: ManifestPackage = members.first.try.memberManifest
  return Ok(()) if manifest.manifestDependencies.any? do |dependency|
    dependency.manifestName == name
  end
  return Tey.Commands.validateUpdateName(members.drop(1), name)
end

let updateScopeMembers(context: Context) -> [Member] do
  match context.currentMember do
    Just(member) when member.memberRoot != context.workspaceRoot => [member]
    _ => context.members
  end
end

# Puts this package's `target(...)` executables where they can be run by name.
#
# `${TEY_HOME}/bin` is a directory Tey already owns and already asks people to
# put on PATH — it is how the `kex` shim gets there — so a package's programs
# land beside it rather than needing a second directory and a second
# instruction.
#
# Only packages that DECLARE a target are affected. A library has none, so
# `tey install` in one still means exactly what it meant before: fetch the
# dependencies.
foul installTargets -> Integer do
  let package = match Tey.Commands.manifest do
    Error(_) => return 0
    Ok(value) => value
  end
  return 0 if package.targets.empty?
  let status = Tey.Commands.build
  return status if status != 0
  let binDirectory = Tey.Toolchain.binDirectory
  if !FS.Directory.create(binDirectory)
    return Tey.Commands.fail("could not create ${binDirectory}")
  end
  var failures = 0
  package.targets.each do |target|
    let built = "${Tey.Commands.outputDirectory}/${target.name}"
    let installed = "${binDirectory}/${target.name}"
    if FS.File.copy(built, installed) && Tey.Commands.runStatus("chmod", ["+x", installed]) == 0
      IO.printLine("${Console.GREEN}Installed${Console.RESET} ${target.name} ${Console.DIM}to ${installed}${Console.RESET}")
    else
      failures = Tey.Commands.fail("could not install ${target.name} to ${installed}")
    end
    ()
  end
  return failures if failures != 0
  # Said only when it matters: a keg or tarball install already has this
  # directory on PATH, and telling someone to fix a problem they do not have
  # is noise.
  let reachable = ENV.get("PATH", "").split(":").any? { |directory| directory == binDirectory }
  IO.printLine("Add ${binDirectory} to PATH to run them by name.") if !reachable
  0
end

foul installTargetsSelected(context: Context, packageName: String) -> Integer do
  let members = match Tey.Workspace.select(context, packageName, false) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  var failures = 0
  members.each do |member|
    let outcome = Tey.Commands.installMemberTargets(member)
    failures = outcome if outcome != 0
    ()
  end
  return failures
end

foul installMemberTargets(member: Member) -> Integer do
  let package: ManifestPackage = member.memberManifest
  return 0 if package.targets.empty?
  let status = Tey.Commands.buildMember(member)
  return status if status != 0
  let binDirectory = Tey.Toolchain.binDirectory
  return Tey.Commands.fail("could not create ${binDirectory}") if !FS.Directory.create(binDirectory)
  var failures = 0
  package.targets.each do |target|
    let built = FS.Path.join(member.memberRoot, Tey.Commands.outputDirectory,
                             target.name)
    let installed = FS.Path.join(binDirectory, target.name)
    if FS.File.copy(built, installed) && Tey.Commands.runStatus("chmod", ["+x", installed]) == 0
      IO.printLine("${Console.GREEN}Installed${Console.RESET} ${target.name} ${Console.DIM}to ${installed}${Console.RESET}")
    else
      failures = Tey.Commands.fail("could not install ${target.name} to ${installed}")
    end
    ()
  end
  return failures
end

# `--source-root` for every fetched dependency. Without these a dependency is
# just bytes in the cache: `using Greet` cannot find it, and the package that
# declared it does not compile. A dependency the lockfile names but the cache
# does not have is reported rather than quietly dropped — the answer is
# `tey install`, and silence would look like a broken `using`.
foul dependencyRoots -> [String] do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(_) => return []
    Ok(value) => value
  end
  let state = match Tey.Commands.readLock do
    Error(_) => do
      # No lockfile at all. Only worth saying when the package actually
      # declares dependencies — a package with none needs nothing.
      match Tey.Commands.manifest do
        Ok(package) => IO.printError("${Console.RED}error:${Console.RESET} no tey.lock; run `tey install`\n") if !package.manifestDependencies.empty?
        Error(_) => ()
      end
      return []
    end
    Ok(value) => value
  end
  let overrides = match Tey.Local.load(context) do
    Error(error) => do
      IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
      return []
    end
    Ok(value) => value
  end
  match Tey.Local.validateAgainstLock(overrides, state) do
    Error(error) => do
      IO.printError("${Console.RED}error:${Console.RESET} ${error}\n")
      return []
    end
    Ok(_) => ()
  end
  var roots: [String] = []
  var missing: [String] = []
  state.lockedDependencies.each do |dependency|
    let local = overrides.find do |override|
      override.overrideName == dependency.name
    end
    let packageRoot = match local do
      Just(override) => override.overridePath
      None => if dependency.source == "workspace"
      FS.Path.join(context.workspaceRoot, dependency.path)
      else
        Tey.Cache.packagePath(dependency)
      end
    end
    let source = FS.Path.join(packageRoot, "src")
    if FS.Directory.directory?(source)
      roots.push!("--source-root")
      roots.push!(source)
    else
      missing.push!(Tey.Lockfile.dependencyName(dependency))
    end
    ()
  end
  if !missing.empty?
    IO.printError("${Console.RED}error:${Console.RESET} ${missing.join(", ")} not in the cache; run `tey install`\n")
  end
  return roots
end

# Every `--source-root` a compile of THIS package needs: its own `src/` first,
# then each dependency's. Own-first is deliberate — a package that shadows a
# dependency's module name means its own, the same way `--source-root` order
# already decides that for dependencies among themselves.
foul sourceRoots -> [String] do
  let own = FS.Directory.directory?("src") then ["--source-root", "src"] else []
  return [...own, ...Tey.Commands.dependencyRoots]
end

foul sourceRootsAt(packageRoot: String) -> [String] do
  let source = FS.Path.join(packageRoot, "src")
  let own = FS.Directory.directory?(source) then ["--source-root", source] else []
  return [...own, ...Tey.Commands.dependencyRoots]
end

# A library's compilable units: every `.kex` directly under `src/`. Not a
# recursive walk — a nested module is reached by the file that declares it,
# and compiling it twice by name is how you get a duplicate-module error out
# of a perfectly good package.
foul librarySources -> [String] do
  return FS.Directory.files("src").or([])
    .filter { |path| path.endsWith?(".kex") }
    .sort
    .map { |path| "src/${path}" }
end

# Returns units relative to `packageRoot`, not absolute: the compiler
# double-registers a module's declarations when the entry file it is asked to
# compile is an absolute path that also falls under an explicit
# `--source-root` (kexhq/kex#?, surfaced by `tey build`ing Rodolfo — a
# `private do` function building a record literal of a type carrying earlier
# `make` methods reported that type's method "defined twice"). A relative
# unit, resolved through the working directory `streamAt`/`runAt` `cd` into,
# does not collide with the source-root the same way. Callers must invoke the
# compiler with `packageRoot` as the working directory.
foul librarySourcesAt(packageRoot: String) -> [String] do
  let source = FS.Path.join(packageRoot, "src")
  return FS.Directory.files(source).or([])
    .filter { |path| path.endsWith?(".kex") }
    .sort
    .map { |path| "src/${path}" }
end

# What `tey build` produces is what ships, so what `tey run` and `tey test`
# exercise has to be the same thing. `-R` compiles and runs on the BEAM;
# without it the toolchain tree-walks the source, and processes, `Erlang.*`
# interop and the String/Char representation differ enough between the two
# that a green interpreter run says nothing about the built package.
#
# `--interpret` is the way back, for a backend gap or a debugging session.
let backendFlags(interpret?: Bool) -> [String] do
  return interpret? then [] else ["-R"]
end

foul runPackage(extra: [String], interpret?: Bool,
                packageName: String = "") -> Integer do
  let member = match Tey.Commands.selectedMember(packageName) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let package: ManifestPackage = member.memberManifest
  # The literal `--` stops kex's own option parsing: without it, program
  # arguments that look like flags (`--source`, `--out`) are permuted into
  # kex's options and rejected as unrecognized.
  #
  # `package.entrypoint` is passed relative to `member.memberRoot` (which
  # `streamAt` below `cd`s into), not joined into an absolute path — an
  # absolute entry file that also falls under one of its own `--source-root`s
  # makes the compiler double-register that module's declarations (see the
  # comment on `librarySourcesAt`).
  Tey.Commands.report(Tey.Commands.streamAt(
    member.memberRoot, Tey.Toolchain.kex,
    [...Tey.Commands.backendFlags(interpret?),
     ...Tey.Commands.sourceRootsAt(member.memberRoot),
     package.entrypoint, "--", ...extra]
  ))
end

# `tey <name>` for a `command(...)` the manifest declares.
#
# A `.kex` script is run through the SELECTED toolchain with this package's
# source roots already in place — the same environment `tey run` gives, so a
# release script can `using` the package it is releasing. Anything else is a
# shell line: `sh -c` is what makes `command("fmt", run: "kex --format src")`
# behave the way the same line behaves in a terminal, pipes and `&&` included.
# Trailing arguments are passed as "$@" rather than pasted into the string, so
# `tey fmt --check` cannot be re-split by the shell.
#
# The `--` before the arguments plays the same role as in runPackage.
foul runCommand(command: Command, extra: [String], interpret?: Bool) -> Integer do
  let member = match Tey.Commands.selectedMember("") do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let words = command.commandRun.split(" ").filter { |word| word != "" }
  let entry = words.first.or("")
  if entry.endsWith?(".kex")
    # `entry` stays relative to `member.memberRoot` — see the comment on
    # `librarySourcesAt` for why an absolute entry file breaks the compiler.
    return Tey.Commands.report(Tey.Commands.streamAt(
      member.memberRoot, Tey.Toolchain.kex,
      [...Tey.Commands.backendFlags(interpret?),
       ...Tey.Commands.sourceRootsAt(member.memberRoot), entry, "--",
       ...words.drop(1), ...extra]
    ))
  end
  # Tey's own bin directory goes FIRST on the command's PATH, so a `kex` in a
  # shell line means the toolchain this package selected rather than whatever
  # else the machine has installed — the same promise `tey run` makes. "tey"
  # names $0, which is what a shell error message quotes.
  let line = "cd \"$1\" || exit 1; shift; PATH=\"${Tey.Toolchain.binDirectory}:$PATH\"; ${command.commandRun} \"$@\""
  Tey.Commands.report(Process.stream("sh", ["-c", line, "tey",
                                             member.memberRoot, ...extra]))
end

foul list -> Integer do
  let state = match Tey.Commands.readLock do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  state.lockedDependencies.each do |dependency|
    IO.printLine(Tey.Lockfile.dependencyListLine(dependency))
  end
  0
end

foul build -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let member = match context.currentMember do
    None => return Tey.Commands.fail("this workspace directory is not inside a package")
    Just(value) => value
  end
  return Tey.Commands.buildMember(member)
end

foul buildSelected(packageName: String, workspace?: Bool,
                   requestedJobs: String = "") -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let members = match Tey.Workspace.select(context, packageName, workspace?) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  context.warnings.each { |warning| IO.printError("warning: ${warning}\n") }
  let jobs = match Tey.Commands.concurrency(requestedJobs) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  return Tey.Commands.buildLayers(
    Tey.Workspace.dependencyLayers(members), jobs, WorkspaceRunState {}
  ).runStatus
end

foul buildMember(member: Member) -> Integer do
  let package: ManifestPackage = member.memberManifest
  let packageRoot = member.memberRoot
  # A library declares no entrypoint, so there is no `src/main.kex` to reach
  # its modules from — every one of them is a root. Compiling them by name is
  # what makes `tey build` mean something in a library, which until now
  # reported `could not open file: src/main.kex` and left the author to guess
  # that the command was for applications only.
  let entrypointAbsolute = FS.Path.join(packageRoot, package.entrypoint)
  let units = FS.File.file?(entrypointAbsolute) then [package.entrypoint] else Tey.Commands.librarySourcesAt(packageRoot)
  if units.empty?
    return Tey.Commands.fail("nothing to build: no ${package.entrypoint} and no modules under src/")
  end
  # Compiling the entry module also emits a companion for every module it
  # reaches — the prelude and runtime included — so a build left ~80 `.beam`
  # files sitting next to package.kex. They go under `ebin/` instead, which
  # is both the BEAM convention and where a package's launcher expects its
  # code path to point.
  let output = FS.Path.join(packageRoot, Tey.Commands.outputDirectory)
  if !FS.Directory.create(output)
    return Tey.Commands.fail("could not create ${output}")
  end
  let status = Tey.Commands.report(
    Tey.Commands.streamAt(packageRoot, Tey.Toolchain.kex,
      ["--compile", "-o", output,
       ...Tey.Commands.sourceRootsAt(packageRoot), ...units]))
  return status if status != 0
  Tey.Commands.buildTargetsAt(package, packageRoot)
end

# How `tey test` should REPORT, as compiler flags (kexhq/kex#199).
#
# `--json` and `--list` are for a tool reading the run rather than a person
# watching it: one JSON record per case, carrying the file and line of the `it`
# and of the failure, and — with `--list` — the cases discovered without any of
# them being run. `--only <name>` narrows the run to one case or one group.
#
# Tey does not interpret any of it: the flags are the compiler's, the records
# are the compiler's, and this is the mapping from what a person typed to what
# the compiler is asked. Which is the point — an editor drives `tey test`
# because Tey knows the package's source roots, not because it wants Tey to
# reformat the answer (docs/testing.md).
let testReportingFlags(json?: Bool, list?: Bool, only: String) -> [String] do
  # `--list` wins over `--json`: discovery IS a JSON mode, and asking for both
  # is asking for the one that runs nothing.
  let mode = list? then ["--test-list"] else (json? then ["--test-json"] else [])
  let filter = only == "" then [] else ["--test-only", only]
  return [...mode, ...filter]
end

# The spec files to run: the ones named on the line, or every `spec/*.spec.kex`
# when none were. Naming one is what an editor's per-file ▶ needs — and what
# anyone debugging a single suite in a package with thirty of them wants.
foul testSpecs(requested: [String]) -> [String] do
  return requested if !requested.empty?
  return FS.Directory.files("spec").or([])
    .filter { |path| path.endsWith?(".spec.kex") }
    .sort
    .map { |path| "spec/${path}" }
end

foul test(requested: [String], interpret?: Bool, json?: Bool, list?: Bool,
          only: String) -> Integer do
  return Tey.Commands.testAt(FS.Directory.current, requested, interpret?,
                             json?, list?, only)
end

foul testSelected(requested: [String], packageName: String, workspace?: Bool,
                  interpret?: Bool, json?: Bool, list?: Bool,
                  only: String, requestedJobs: String = "") -> Integer do
  let context = match Tey.Workspace.discover(FS.Directory.current) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  let members = match Tey.Workspace.select(context, packageName, workspace?) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  context.warnings.each { |warning| IO.printError("warning: ${warning}\n") }
  let jobs = match Tey.Commands.concurrency(requestedJobs) do
    Error(error) => return Tey.Commands.fail(error)
    Ok(value) => value
  end
  return Tey.Commands.testLayers(
    Tey.Workspace.dependencyLayers(members), jobs, requested, interpret?,
    json?, list?, only, WorkspaceRunState {}
  ).runStatus
end

foul testAt(packageRoot: String, requested: [String], interpret?: Bool,
            json?: Bool, list?: Bool, only: String) -> Integer do
  let specs = if requested.empty?
    FS.Directory.files(FS.Path.join(packageRoot, "spec")).or([])
      .filter { |path| path.endsWith?(".spec.kex") }
      .sort
      .map { |path| FS.Path.join(FS.Path.join(packageRoot, "spec"), path) }
  else
    requested.map do |path|
      FS.Path.absolute?(path) then path else FS.Path.join(packageRoot, path)
    end
  end
  let machineReadable? = json? || list?
  if specs.empty?
    # Silent in the machine-readable modes: their output is records, and a
    # sentence in the middle of them is something a reader has to be taught to
    # skip. An empty run reports itself by having no records.
    IO.printLine("${Console.DIM}No specs found${Console.RESET}") if !machineReadable?
    return 0
  end
  var status = 0
  # The package's OWN `src/` belongs on the source path as much as any
  # dependency's does. Without it a library's specs could not see the library:
  # `spec/greet.spec.kex` calling `Greet.greeting` died with `Undefined
  # function`, which reads like a bug in the package rather than a missing
  # compiler flag.
  let roots = [...Tey.Commands.backendFlags(interpret?), ...Tey.Commands.sourceRootsAt(packageRoot),
               ...Tey.Commands.testReportingFlags(json?, list?, only)]
  specs.each do |spec|
    # A spec that could not even be STARTED is reported and counted as a
    # failure like any other, rather than abandoning the files after it: a
    # suite that stops at the first problem tells you about one problem.
    let outcome = Tey.Commands.report(Process.stream(Tey.Toolchain.kex, [...roots, spec]))
    status = outcome if outcome != 0
    ()
  end
  status
end

foul clean(all?: Bool) -> Integer do
  if !all?
    IO.printLine("Cache is at ${Tey.Cache.root}; pass --cache to remove it")
    return 0
  end
  if FS.Directory.deleteAll(Tey.Cache.root)
    IO.printLine("${Console.GREEN}Removed${Console.RESET} ${Tey.Cache.root}")
    0
  else
    Tey.Commands.fail("could not remove ${Tey.Cache.root}")
  end
end

foul setupMergeDriver(remove?: Bool) -> Integer do
  let key = "merge.tey.driver"
  let arguments = remove? then ["config", "--global", "--unset-all", key] else ["config", "--global", key, "tey install --merge-driver %O %A %B"]
  match Tey.Commands.runStatus("git", arguments) do
    0 => do
      IO.printLine(remove? then "Removed Tey merge driver" else "Configured Tey merge driver")
      0
    end
    _ => Tey.Commands.fail("could not update global Git configuration")
  end
end

# `tey new <name>` — a package in a directory of its own, which the command
# creates. The pair with `init` below follows what `git init` and `cargo new`
# already taught everyone: `new` makes the directory, `init` adopts the one
# you are standing in.
foul new(directory: String, library: Bool) -> Integer do
  # The argument is a DIRECTORY, and the package is named after its last
  # component: `tey new /tmp/ooo` makes `ooo` in `/tmp/ooo`.
  let name = Tey.Commands.packageNameIn(directory)
  if name == ""
    return Tey.Commands.fail("'${directory}' names no package; pass a directory with a name in it")
  end
  if FS.File.file?("${directory}/package.kex")
    return Tey.Commands.fail("'${directory}' already holds a package.kex")
  end
  if !FS.Directory.create(directory)
    return Tey.Commands.fail("could not create project '${name}'")
  end
  IO.printLine(Tey.Commands.creating(name, library, directory))
  let status = Tey.Commands.scaffold(directory, name, library)
  return status if status != 0
  0
end

# `tey init` — a package in the CURRENT directory, named after it. This is the
# half that was missing: a repository someone had already made and cloned had
# no way to become a package except `tey new` in a temp directory and moving
# the files over by hand.
#
# The name is overridable because a directory name is not always the package
# name — `kexhq/greet` checked out as `greet-main` is still `greet`.
foul init(name: String, library: Bool) -> Integer do
  if FS.File.file?("package.kex")
    return Tey.Commands.fail("this directory already holds a package.kex")
  end
  let chosen = name != "" then name else Tey.Commands.currentDirectoryName
  if chosen == ""
    return Tey.Commands.fail("could not name the package after this directory; pass a name")
  end
  IO.printLine(Tey.Commands.creating(chosen, library, "."))
  let status = Tey.Commands.scaffold(".", chosen, library)
  return status if status != 0
  0
end

private do
  foul streamAt(directory: String, command: String,
                arguments: [String]) -> Integer or! String do
    return Process.stream("sh", ["-c",
      "cd \"$1\" || exit 1; shift; exec \"$@\"", "tey", directory,
      command, ...arguments])
  end

  # Same working-directory change as `streamAt`, but buffered — for a caller
  # that wants the child's captured stdout/stderr rather than its output
  # streamed live.
  foul runAt(directory: String, command: String,
            arguments: [String]) -> Process.ProcessResult or! String do
    return Process.run("sh", ["-c",
      "cd \"$1\" || exit 1; shift; exec \"$@\"", "tey", directory,
      command, ...arguments])
  end

  foul selectedMember(packageName: String) -> Member or! String do
    let context = Tey.Workspace.discover(FS.Directory.current).try
    if packageName != ""
      return Ok(Tey.Workspace.select(context, packageName, false).try.first.try)
    end
    match context.currentMember do
      Just(member) => return Ok(member)
      None => return Error("this workspace directory is not inside a package")
    end
  end

  let collectClosure(state: LockState, pending: [String],
                     found: [String]) -> [String] do
    return found if pending.empty?
    let name = pending.first.try
    return Tey.Commands.collectClosure(state, pending.drop(1), found) if found.contains?(name)
    let edges = match state.lockedDependencies.find { |dependency| dependency.name == name } do
      Just(dependency) => dependency.dependencies
      None => []
    end
    return Tey.Commands.collectClosure(state, [...pending.drop(1), ...edges],
                                       [...found, name])
  end

  foul concurrency(requested: String) -> Integer or! String do
    if requested != ""
      return match Integer.parse(requested) do
        Ok(value) => value > 0 then Ok(value) else Error("--jobs must be a positive integer")
        Error(_) => Error("--jobs must be a positive integer")
      end
    end
    let detected = match Process.run("getconf", ["_NPROCESSORS_ONLN"]) do
      Ok(result) => Integer.parse(result.stdout.trim).or(1)
      Error(_) => 1
    end
    return Ok(detected > 0 then detected else 1)
  end

  foul buildLayers(layers: [[Member]], jobs: Integer,
                   state: WorkspaceRunState) -> WorkspaceRunState do
    return state if layers.empty?
    let (ready, prepared) = Tey.Commands.readyMembers(layers.first.try, state)
    let layerState = Tey.Commands.buildChunks(ready, jobs, prepared)
    return Tey.Commands.buildLayers(layers.drop(1), jobs, layerState)
  end

  foul buildChunks(members: [Member], jobs: Integer,
                   state: WorkspaceRunState) -> WorkspaceRunState do
    return state if members.empty?
    let batch = members.take(jobs)
    let tasks = batch.map do |member|
      (member, Task.start { Tey.Commands.buildMember(member) })
    end
    let nextState = tasks.reduce(state) do |current, item|
      let (member, task) = item
      match task.await do
        Ok(0) => current
        Ok(code) => WorkspaceRunState {
          runStatus: code,
          failedMembers: [...current.failedMembers,
                          Tey.Workspace.memberName(member)]
        }
        Error(_) => WorkspaceRunState {
          runStatus: 1,
          failedMembers: [...current.failedMembers,
                          Tey.Workspace.memberName(member)]
        }
      end
    end
    return Tey.Commands.buildChunks(members.drop(jobs), jobs, nextState)
  end

  foul testLayers(layers: [[Member]], jobs: Integer, requested: [String],
                  interpret?: Bool, json?: Bool, list?: Bool, only: String,
                  state: WorkspaceRunState) -> WorkspaceRunState do
    return state if layers.empty?
    let (ready, prepared) = Tey.Commands.readyMembers(layers.first.try, state)
    let layerState = Tey.Commands.testChunks(ready, jobs, requested,
                                             interpret?, json?, list?, only,
                                             prepared)
    return Tey.Commands.testLayers(layers.drop(1), jobs, requested, interpret?,
                                   json?, list?, only, layerState)
  end

  foul testChunks(members: [Member], jobs: Integer, requested: [String],
                  interpret?: Bool, json?: Bool, list?: Bool, only: String,
                  state: WorkspaceRunState) -> WorkspaceRunState do
    return state if members.empty?
    let batch = members.take(jobs)
    let tasks = batch.map do |member|
      (member, Task.start do
        Tey.Commands.testAt(member.memberRoot, requested, interpret?, json?,
                            list?, only)
      end)
    end
    let nextState = tasks.reduce(state) do |current, item|
      let (member, task) = item
      match task.await do
        Ok(0) => current
        Ok(code) => WorkspaceRunState {
          runStatus: code,
          failedMembers: [...current.failedMembers,
                          Tey.Workspace.memberName(member)]
        }
        Error(_) => WorkspaceRunState {
          runStatus: 1,
          failedMembers: [...current.failedMembers,
                          Tey.Workspace.memberName(member)]
        }
      end
    end
    return Tey.Commands.testChunks(members.drop(jobs), jobs, requested,
                                   interpret?, json?, list?, only, nextState)
  end

  foul readyMembers(members: [Member],
                    state: WorkspaceRunState) -> ([Member], WorkspaceRunState) do
    let blocked = members.filter do |member|
      Tey.Workspace.memberDependencies(member).any? do |dependency|
        state.failedMembers.contains?(dependency)
      end
    end
    blocked.each do |member|
      let dependencies = Tey.Workspace.memberDependencies(member).filter do |name|
        state.failedMembers.contains?(name)
      end
      IO.printError("Skipping ${Tey.Workspace.memberName(member)} because ${dependencies.join(", ")} failed\n")
    end
    let ready = members.filter { |member| !blocked.contains?(member) }
    let failed = [...state.failedMembers,
                  ...blocked.map { |member| Tey.Workspace.memberName(member) }]
    let status = blocked.empty? then state.runStatus else 1
    return (ready, WorkspaceRunState {
      runStatus: status, failedMembers: failed
    })
  end

  foul installLock(context: Context) -> LockState or! String do
    let toolchain = Tey.Toolchain.activeInfo.try
    let path = FS.Path.join(context.workspaceRoot, "tey.lock")
    match FS.File.read(path) do
      Error(_) => return Tey.Resolver.resolveWorkspaceWithInfo(context, toolchain)
      Ok(text) => match Tey.Lockfile.decode(text) do
        Error(error) => return Error(error)
        Ok(state) => do
          let current = Tey.Resolver.fingerprint(context)
          return Ok(state) if Tey.Commands.lockReusable?(state, current,
                                                         toolchain)
          return Tey.Resolver.resolveWorkspaceWithInfo(context, toolchain)
        end
      end
    end
  end

  foul publishLock(path: String, state: LockState) -> Void or! String do
    let nonce = Digest.sha256("${path}:${DateTime.epochNanos()}")
    let staging = "${path}.partial.${nonce}"
    return Error("could not stage tey.lock") if !FS.File.write(staging, Tey.Lockfile.encode(state))
    match Process.run("mv", ["--", staging, path]) do
      Ok(result) => return Ok(()) if result.exitCode == 0
      Error(_) => ()
    end
    FS.File.delete(staging)
    return Error("could not publish tey.lock")
  end

  foul approvePlugins(context: Context, state: LockState) -> LockState or! String do
    let bindings = Tey.Commands.directPluginBindings(context, state).try
    let incompatible = bindings.filter do |binding|
      !Tey.Semver.satisfies(Tey.Version.number,
                           binding.declaration.pluginTeyRequirement)
    end
    if !incompatible.empty?
      let details = incompatible.map do |binding|
        let declaration = binding.declaration
        "${binding.approvalKey} requires Tey ${declaration.pluginTeyRequirement}"
      end
      return Error("plugin interfaces are incompatible with Tey ${Tey.Version.number}: ${details.join(", ")}")
    end
    let valid = Tey.Plugin.validBindingApprovals(bindings,
                                                 state.pluginApprovals)
    let missing = Tey.Plugin.missingBindingApprovals(bindings, valid)
    let approvals = Tey.Commands.requestApprovals(missing, valid).try
    return Ok(LockState { ...state, pluginApprovals: approvals })
  end

  foul requestApprovals(bindings: [Binding], approvals: {String: String}) -> {String: String} or! String do
    return Ok(approvals) if bindings.empty?
    let binding = bindings.first.try
    let declaration = binding.declaration
    let resources = declaration.pluginCapabilities.map do |resource|
      let detail = resource.capabilityValues.empty? then "" else " [${resource.capabilityValues.join(", ")}]"
      "${resource.capabilityKind}${detail}"
    end
    IO.print("Approve plugin `${binding.approvalKey}` with resources ${resources.join(", ")}? [y/N] ")
    let answer = IO.getLine.or("").trim.lowerCase
    return Error("plugin `${binding.approvalKey}` was not approved") if answer != "y" && answer != "yes"
    let updated = approvals.put(binding.approvalKey,
                                Tey.Plugin.fingerprint(declaration))
    return Tey.Commands.requestApprovals(bindings.drop(1), updated)
  end

  foul directPluginBindings(context: Context,
                            state: LockState) -> [Binding] or! String do
    let root = context.members.find do |member|
      member.memberRoot == context.workspaceRoot
    end
    let globals = match root do
      None => []
      Just(member) => Tey.Commands.bindPlugins(member, "", context,
                                                state).try
    end
    let locals = Tey.Commands.bindMemberPlugins(context.members, root,
                                                context, state).try
    Tey.Plugin.validateScopes(globals, locals).try
    return Ok([...globals, ...locals])
  end

  foul bindMemberPlugins(members: [Member], root: Member?, context: Context,
                         state: LockState) -> [Binding] or! String do
    return Ok([]) if members.empty?
    let member = members.first.try
    let isRoot = match root do
      Just(value) => value.memberRoot == member.memberRoot
      None => false
    end
    let manifest: ManifestPackage = member.memberManifest
    let here = isRoot then [] else Tey.Commands.bindPlugins(
      member, manifest.name, context, state
    ).try
    let rest = Tey.Commands.bindMemberPlugins(members.drop(1), root, context,
                                              state).try
    return Ok([...here, ...rest])
  end

  foul bindPlugins(member: Member, scopeName: String, context: Context,
                   state: LockState) -> [Binding] or! String do
    let manifest: ManifestPackage = member.memberManifest
    let names = manifest.manifestDependencies.map { |dependency| dependency.manifestName }
    let declarations = Tey.Commands.pluginsForNames(names, context, state).try
    return declarations.map do |declaration|
      let key = scopeName == "" then declaration.pluginNamespace else "${scopeName}:${declaration.pluginNamespace}"
      Binding { approvalKey: key, scopeName: scopeName,
                declaration: declaration }
    end
  end

  foul pluginsForNames(names: [String], context: Context,
                       state: LockState) -> [Plugin] or! String do
    return Ok([]) if names.empty?
    let name = names.first.try
    let member = context.members.find do |candidate|
      let manifest: ManifestPackage = candidate.memberManifest
      manifest.name == name
    end
    let manifest = match member do
      Just(value) => value.memberManifest
      None => do
        let dependency = match state.lockedDependencies.find { |entry| entry.name == name } do
          None => return Error("direct plugin dependency `${name}` is absent from tey.lock")
          Just(value) => value
        end
        let text = FS.File.read(FS.Path.join(Tey.Cache.packagePath(dependency), "package.kex")).try
        Tey.Manifest.read(text).try
      end
    end
    let rest = Tey.Commands.pluginsForNames(names.drop(1), context, state).try
    return Ok([...manifest.plugins, ...rest])
  end

  # Where `tey build` puts compiled artifacts, and what `tey init` tells Git
  # to ignore.
  let outputDirectory -> String do
    return "ebin"
  end

  # An executable per `target(...)`, written next to the beams.
  #
  # `target` was parsed and then ignored by everything, so declaring one did
  # nothing at all. It now names a real file you can run, hand to someone, or
  # put on PATH with `tey install`.
  #
  # Each target is compiled into its OWN directory before being archived,
  # because the compiler names every entry module `kex_main`: archiving one
  # shared `ebin/` would give every target the same program under a different
  # name.
  foul buildTargets(package: ManifestPackage) -> Integer do
    return 0 if package.targets.empty?
    var status = 0
    package.targets.each do |target|
      let staging = "${Tey.Commands.outputDirectory}/.${target.name}"
      if !FS.Directory.create(staging)
        status = Tey.Commands.fail("could not create ${staging}")
      end
      let outcome = match Process.run(Tey.Toolchain.kex,
                                       ["--compile", "-o", staging,
                                        ...Tey.Commands.sourceRoots, target.entrypoint]) do
        Error(error) => Tey.Commands.fail(error)
        Ok(result) => do
          IO.printError(result.stderr) if result.stderr != ""
          result.exitCode
        end
      end
      status = outcome if outcome != 0
      let output = "${Tey.Commands.outputDirectory}/${target.name}"
      if outcome == 0
        if Tey.Commands.writeEscript(staging, output)
          IO.printLine("  Target  ${output}")
        else
          status = Tey.Commands.fail("could not write ${output}")
        end
      end
      ()
    end
    return status
  end

  foul buildTargetsAt(package: ManifestPackage, packageRoot: String) -> Integer do
    return 0 if package.targets.empty?
    let outputDirectory = FS.Path.join(packageRoot, Tey.Commands.outputDirectory)
    var status = 0
    package.targets.each do |target|
      let staging = "${outputDirectory}/.${target.name}"
      if !FS.Directory.create(staging)
        status = Tey.Commands.fail("could not create ${staging}")
      end
      # `target.entrypoint` stays relative to `packageRoot`, which `runAt`
      # below `cd`s into — see the comment on `librarySourcesAt`.
      let outcome = match Tey.Commands.runAt(packageRoot, Tey.Toolchain.kex,
                                       ["--compile", "-o", staging,
                                        ...Tey.Commands.sourceRootsAt(packageRoot), target.entrypoint]) do
        Error(error) => Tey.Commands.fail(error)
        Ok(result) => do
          IO.printError(result.stderr) if result.stderr != ""
          result.exitCode
        end
      end
      status = outcome if outcome != 0
      let output = "${outputDirectory}/${target.name}"
      if outcome == 0
        if Tey.Commands.writeEscript(staging, output)
          IO.printLine("  Target  ${output}")
        else
          status = Tey.Commands.fail("could not write ${output}")
        end
      end
      ()
    end
    return status
  end

  # An escript: the BEAM's single-file executable. A shebang, the emulator
  # flags naming the entry module, and a zip of every beam the program needs —
  # the runtime and the prelude included, which is what makes the result
  # runnable on a machine that has Erlang and nothing else.
  #
  # Built by `escript:create/2` rather than by assembling the archive here,
  # because the header format is OTP's to define.
  #
  # The result carries the same OTP floor as any other beam: it cannot be run
  # by an Erlang older than the one that compiled it, and that failure reads
  # as `corrupt atom table`.
  foul writeEscript(from: String, output: String) -> Bool do
    let script = "{ok,Fs}=file:list_dir(\"${from}\"), B=[{F, element(2, file:read_file(\"${from}/\"++F))} || F <- Fs, lists:suffix(\".beam\",F)], ok=escript:create(\"${output}\", [shebang, {emu_args,\"-escript main kex_main\"}, {archive,B,[]}]), halt()."
    match Process.run(Tey.Toolchain.erl, ["-noshell", "-eval", script]) do
      Error(_) => return false
      Ok(result) => do
        return false if result.exitCode != 0
        return Tey.Commands.runStatus("chmod", ["+x", output]) == 0
      end
    end
  end

  # The package name inside a path: `tey new /tmp/ooo` makes `ooo` in
  # `/tmp/ooo`, the way every other scaffolder reads its argument.
  #
  # Without this the whole path WAS the name: it reached the manifest as
  # `package "/tmp/ooo"`, and for a library it reached the module name too, so
  # the source file was written to `/tmp/ooo/src//tmp/ooo.kex` — a path whose
  # parent does not exist. The scaffold failed halfway, after having created
  # the directories and the manifest.
  let packageNameIn(path: String) -> String do
    return path.split("/").filter { |part| part != "" }.last.or("")
  end

  # The last component of the working directory — the package name `tey init`
  # picks when nobody names one. A trailing separator would otherwise make
  # this empty, and `/` has no last component at all.
  foul currentDirectoryName -> String do
    let trimmed = FS.Directory.current.split("/").filter { |part| part != "" }
    return trimmed.last.or("")
  end

  # The module name for a package name. Package names are kebab-case by
  # convention and module names are PascalCase, so `hello-world` has to become
  # `HelloWorld` — capitalizing the string whole produced `module Hello-world`,
  # a file that does not parse, in a package that had just been created.
  let moduleNameFor(name: String) -> String do
    let words = name.split("-").flatMap { |part| part.split("_") }
    return words.filter { |word| word != "" }.map { |word| word.capitalize }.join("")
  end

  # The starter README. A library's shows how to DEPEND on it — the thing its
  # readers actually need and the thing an author is least likely to write
  # from memory, since it means knowing both the manifest line and the tag
  # convention. An application's shows how to run it.
  let readme(fields: {String: String}, library: Bool) -> String do
    # $T$ stands in for a backtick. A raw string is delimited by backticks,
    # so a Markdown code fence cannot be written inside one — and Markdown
    # without fences is not much of a README.

    # What a visitor to the repository page needs first: how to get this
    # package into THEIR package. Shared by both variants — an application is
    # still a package somebody can depend on, and a README that only says how
    # to run it locally leaves the reader to guess the manifest line.
    let dependency = `
      ## Add it to your project

      In your own package's $T$package.kex$T$:

      $T$$T$$T$kex
      tey("$NAME$", git: "https://github.com/you/$NAME$", tag: "~> 0.1")
      $T$$T$$T$

      Then $T$tey install$T$. The tag is the release, and $T$~> 0.1$T$ takes the
      newest $T$0.1.x$T$ — Tey resolves it against this repository's tags.
    `
    let libraryUsage = `
      ## Use it

      $T$$T$$T$kex
      using $MODULE$

      main(args) do
        IO.printLine($MODULE$.greeting("world"))
      end
      $T$$T$$T$

      ## Release it

      $T$$T$$T$sh
      git tag v0.1.0 && git push origin v0.1.0
      $T$$T$$T$

      Keep the tag in step with $T$version$T$ in $T$package.kex$T$.
    `
    let applicationUsage = `
      ## Run it

      $T$$T$$T$sh
      tey install
      tey run
      $T$$T$$T$
    `
    # A library is USED by depending on it, so the manifest line comes first
    # and the `using` example follows it. An application is run, so its own
    # instructions lead and the dependency line is the footnote.
    let usage = library then "${dependency}${libraryUsage}" else "${applicationUsage}${dependency}"
    let body = `
      # $NAME$

      A Kex package.

      ## Develop

      $T$$T$$T$sh
      tey install   # fetch dependencies
      tey build     # compile into ebin/
      tey test      # run spec/*.spec.kex
      $T$$T$$T$

      $USAGE$
      ## Your own commands

      A package can add commands to Tey. Declare them in $T$package.kex$T$:

      $T$$T$$T$kex
      command("bench", run: "script/bench.kex", description: "Run the benchmarks")
      command("fmt", run: "kex --format src", description: "Format the sources")
      $T$$T$$T$

      They run as $T$tey bench$T$ and $T$tey fmt$T$ from anywhere in the package, are
      listed under **Package commands** in $T$tey help$T$, and show up as tasks in
      editors that ask Tey what this project can do. A $T$run:$T$ whose first word
      ends in $T$.kex$T$ is run by Kex; anything else is a shell command line.

      Built-in names ($T$build$T$, $T$test$T$, $T$run$T$, ...) cannot be redeclared, so
      $T$tey test$T$ means the same thing in every package.`
    # Two passes, and they cannot be one: substitution runs in sorted key
    # order, so `$USAGE$` would be spliced in LAST — after the placeholders
    # it contains had already been looked for — and the usage section would
    # reach the file still full of `$NAME$` and `$T$`. Splice first, fill
    # second.
    return body.substitute({"$USAGE$": usage})
               .substitute(fields.merge({"$T$": "`"}))
  end

  # The line above the file list: what is being made, and where. `tey new`
  # printed nothing until it had finished, so six files appeared as one line
  # of output after the fact.
  let creating(name: String, library: Bool, directory: String) -> String do
    let kind = library then "a library" else "an application"
    let place = directory == "." then "this directory" else directory
    return "${Console.BOLD}Creating${Console.RESET} ${kind} package ${Console.CYAN}${name}${Console.RESET} in ${place}"
  end

  # One scaffolded path: the verb, then the path as it looks from inside the
  # package. Right-aligned in a narrow column the way a generator log is, so
  # the verbs line up and the paths all start at the same place — the list is
  # then scannable without being read.
  #
  # Six wide, which is `create`, and every other verb is shorter. Green for
  # what was written, yellow for what was left alone because something was
  # already there, dim for what was already exactly right.
  foul report(verb: String, directory: String, path: String) -> Void do
    let inside = path.startsWith?("${directory}/")
    let shown = inside then path.drop(directory.count + 1) else path
    let color = match verb do
      "create" => Console.GREEN
      "skip" => Console.YELLOW
      _ => Console.DIM
    end
    let padding = " ".repeat(6 - verb.count)
    IO.printLine("  ${padding}${color}${verb}${Console.RESET}  ${shown}")
  end

  # Writes a scaffolded file and says so, in one step.
  #
  # One step deliberately: a separate list of "what was created" printed
  # beside the code that creates it is a list that goes stale the first time a
  # template is added. What the user is told is what actually happened.
  #
  # A file already there is never overwritten. `tey init` exists FOR a
  # directory somebody already has — a checkout with its own README.md and
  # .gitignore is the normal case, not the exception — and it used to replace
  # both with the scaffold's, silently, with no way to get them back. Keeping
  # the file and saying so is the only safe default; the scaffold's version is
  # a starting point, and the one on disk is somebody's work.
  foul writeCreated(directory: String, path: String, contents: String) -> Bool do
    match FS.File.read(path) do
      Ok(existing) => do
        Tey.Commands.report(existing == contents then "exist" else "skip", directory, path)
        return true
      end
      Error(_) => ()
    end
    return false if !FS.File.write(path, contents)
    Tey.Commands.report("create", directory, path)
    true
  end

  # The same for a directory, so the tree appears in the order it is built
  # rather than as a set of files whose parents were never mentioned. An
  # existing directory is not a collision: a scaffold writing INTO `src/` is
  # exactly what `tey init` on a source tree should do.
  foul createDirectory(directory: String, path: String) -> Bool do
    if FS.Directory.directory?(path)
      Tey.Commands.report("exist", directory, path)
      return true
    end
    return false if !FS.Directory.create(path)
    Tey.Commands.report("create", directory, path)
    true
  end

  # Writes a package into `directory`. Shared by `new` and `init` so the two
  # cannot drift into producing different packages — the bug that shape of
  # duplication always ends in.
  foul scaffold(directory: String, name: String, library: Bool) -> Integer do
    let sources = Tey.Commands.createDirectory(directory, "${directory}/src")
    let specs = Tey.Commands.createDirectory(directory, "${directory}/spec")
    if !sources || !specs
      return Tey.Commands.fail("could not create project '${name}'")
    end
    let moduleName = Tey.Commands.moduleNameFor(name)
    # This fragment is spliced INTO the generated `package` block, so its
    # two-space indent belongs to the generated file and has to survive.
    # Block-shaped, it would be dedented away — every line shares it.
    let entry = library then "" else `  entrypoint("src/main.kex")

  target("$NAME$", entrypoint: "src/main.kex")
`
    # One substitution table for every template below, rather than a `.replace`
    # chain per template. Substitution runs in sorted key order, so `$ENTRY$`
    # lands before `$NAME$` is looked for and the placeholder INSIDE the
    # inserted entry is filled by the same pass.
    let fields = {"$NAME$": name, "$MODULE$": moduleName, "$ENTRY$": entry}
    let libraryModule = `
      module $MODULE$

      foul greeting(name: String) = "Hello, ${name}!"
    `
    let application = `
      main(args) do
        IO.printLine("Hello from $NAME$!")
      end
    `
    # A library ships one function that works and one spec that proves it.
    # An empty `module X do end` with an empty spec/ meant a new package's
    # first `tey test` said "No specs found" — the on-ramp taught nothing and
    # left the author to discover the spec layout from a doc.
    let source = (library then libraryModule else application).substitute(fields)
    # The commented `command(...)` is the one line of this file that teaches
    # something the author would otherwise never learn was possible: the
    # scripts a project needs belong in the manifest, not in a Makefile beside
    # it. Commented, because a scaffold must not ship a command that does not
    # run.
    let manifestText = `
      package "$NAME$" do
        version("0.1.0")
        description("A Kex package")
        kex(">= 0.3.0")

        # Project commands, run as "tey NAME" and listed by "tey help":
        # command("bench", run: "script/bench.kex", description: "Run the benchmarks")

      $ENTRY$end
    `.substitute(fields)
    # The resolver finds a module by lowercasing its name and looking for that
    # file (see sourcePath in src/module/resolver.cxx), so the file has to be
    # named after the MODULE, not after the package: `hello-world` produces
    # `HelloWorld` in `helloworld.kex`. Naming it `hello-world.kex` left a
    # package whose own spec could not see it.
    let moduleFile = moduleName.lowerCase
    let sourcePath = library then "${directory}/src/${moduleFile}.kex" else "${directory}/src/main.kex"
    let wroteManifest = Tey.Commands.writeCreated(directory, "${directory}/package.kex", manifestText)
    let wroteSource = Tey.Commands.writeCreated(directory, sourcePath, source)
    if !wroteManifest || !wroteSource
      return Tey.Commands.fail("could not write project '${name}'")
    end
    if library
      let spec = `
        describe "$MODULE$" do
          it "greets by name" do
            Assert.equal($MODULE$.greeting("Kex"), "Hello, Kex!")
          end
        end
      `.substitute(fields)
      if !Tey.Commands.writeCreated(directory, "${directory}/spec/${moduleFile}.spec.kex", spec)
        return Tey.Commands.fail("could not write project '${name}'")
      end
    end
    # A README, because a package without one is a package nobody can tell
    # anything about from its repository page — and for a library, that page
    # IS the distribution: there is no registry rendering a description
    # somewhere else. Generated with the manifest's own description so the two
    # start out saying the same thing.
    if !Tey.Commands.writeCreated(directory, "${directory}/README.md",
                                  Tey.Commands.readme(fields, library))
      return Tey.Commands.fail("could not write project '${name}'")
    end
    Tey.Commands.writeCreated(directory, "${directory}/.gitattributes", "tey.lock merge=tey\n")
    # tey.lock IS committed — only build output is ignored. erl_crash.dump is
    # not build output but it lands in the project root the same way: the BEAM
    # writes one wherever it died, and nobody wants it in a commit.
    Tey.Commands.writeCreated(directory, "${directory}/.gitignore",
                              "${Tey.Commands.outputDirectory}/\nerl_crash.dump\n")
    0
  end

  foul readLock -> LockState or! String do
    let context = Tey.Workspace.discover(FS.Directory.current).try
    match FS.File.read(FS.Path.join(context.workspaceRoot, "tey.lock")) do
      Error(_) => Error("tey.lock not found; run `tey install`")
      Ok(text) => Tey.Lockfile.decode(text)
    end
  end

  # A child's output, and its status as this command's status.
  #
  # `Process.stream`, not `Process.run`: the child writes through to this
  # terminal as it goes, so a `tey test` that takes two minutes shows its
  # progress for two minutes instead of a blank screen and then everything at
  # once. Nothing is captured, which is right for every caller here — these
  # are commands a person is watching, not output to be read back
  # (kexhq/kex#187).
  foul report(outcome: Integer or! String) -> Integer do
    match outcome do
      Error(error) => Tey.Commands.fail(error)
      Ok(code) => code
    end
  end

  foul runStatus(command: String, arguments: [String]) -> Integer do
    match Process.run(command, arguments) do
      Error(_) => 127
      Ok(result) => result.exitCode
    end
  end

  # Failures are red and say `error:` rather than just `tey:` — a message on
  # stderr competing with a compiler's own output has to be findable at a
  # glance, and `tey:` alone reads like a prefix rather than a problem.
  foul fail(message: String) -> Integer do
    IO.printError("${Console.RED}error:${Console.RESET} ${message}\n")
    1
  end
end
