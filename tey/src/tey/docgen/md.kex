# A Markdown reader: parses a document into blocks and renders them as HTML,
# so hand-written pages get the same layout as the generated reference.
#
# (+Tey.Docgen.Markdown+ goes the other way, writing Markdown from the model.)
#
# It reads the subset the kex.run guide pages use: simple +key: value+
# frontmatter, +#+ headings, paragraphs, fenced code (+kex+ code is
# highlighted), blockquotes, nested ordered and unordered lists, GFM tables,
# horizontal rules, and inline code, bold, italics and links. It is not
# CommonMark: there is no inline HTML, no reference links and no underlined
# headings. Anything it does not recognise is a paragraph, never an error.

module Tey.Docgen.Md do

  # The frontmatter keys this reader uses. Other keys are ignored, so a page
  # may carry metadata for something else.
  record Frontmatter do
    title : String = ""
    description : String = ""
    order : Integer = 0
  end

  # One item of a list: its own inline text, plus any blocks nested under it.
  record ListItem do
    text : String
    children : [MdBlock]
  end

  # A block of a Markdown document.
  type MdBlock =
    | Heading(Integer, String)
    | Paragraph(String)
    | Code(String, String)
    | Quote([MdBlock])
    | Bullets([ListItem])
    | Numbers([ListItem])
    | Table([String], [[String]])
    | Rule

  # A parsed document: its frontmatter and its blocks.
  record Document do
    frontmatter : Frontmatter
    blocks : [MdBlock]
  end

  # Parses a Markdown document. Windows line endings are accepted.
  let parseDocument(text: String) -> Document do
    let (front, body) = splitFrontmatter(text.replace("\r\n", "\n").split("\n"))
    return Document { frontmatter: front, blocks: parseBlocks(body) }
  end

  # Returns the HTML for a document's body, ignoring its frontmatter.
  let toHtml(text: String) -> String do
    return render(parseDocument(text).blocks)
  end

  # --- frontmatter -------------------------------------------------------

  # A leading `---` fence delimits frontmatter. Without one the document is
  # all body, and every field takes its default.
  let splitFrontmatter(lines: [String]) -> (Frontmatter, [String]) do
    if lines.first.or("").trim != "---"
      return (Frontmatter {}, lines)
    end
    let rest = lines.drop(1)
    match closingFence(rest, 0) do
      None => (Frontmatter {}, lines)
      Just(at) => do
        let front = frontmatterOf(rest.take(at), Frontmatter {})
        return (front, rest.drop(at + 1))
      end
    end
  end

  let closingFence(lines: [String], index: Integer) -> Integer? do
    return None if index >= lines.count
    return Just(index) if lines.at(index).or("").trim == "---"
    return closingFence(lines, index + 1)
  end

  let frontmatterOf(lines: [String], accum: Frontmatter) -> Frontmatter do
    if lines.empty?
      return accum
    end
    let line = lines.first.or("")
    let rest = lines.drop(1)
    match line.indexOf(':') do
      None => frontmatterOf(rest, accum)
      Just(at) => do
        let key = line.take(at).trim
        let value = unquote(line.drop(at + 1).trim)
        return frontmatterOf(rest, assign(accum, key, value))
      end
    end
  end

  let assign(front: Frontmatter, key: String, value: String) -> Frontmatter do
    return Frontmatter { ...front, title: value } if key == "title"
    return Frontmatter { ...front, description: value } if key == "description"
    return Frontmatter { ...front, order: Integer.parse(value).or(0) } if key == "order"
    return front
  end

  let unquote(value: String) -> String do
    return trimEnds(value) if quoted?(value, "\"")
    return trimEnds(value) if quoted?(value, "'")
    return value
  end

  # Drops the first and last character, the quotes +quoted?+ matched.
  let trimEnds(value: String) -> String do
    return value.drop(1).take(value.count - 2)
  end

  let quoted?(value: String, mark: String) -> Bool do
    return value.count >= 2 && value.startsWith?(mark) && value.endsWith?(mark)
  end

  # --- block structure ---------------------------------------------------

  let parseBlocks(lines: [String]) -> [MdBlock] do
    return blockLoop(lines, [])
  end

  # One pass over the lines, each branch consuming the whole construct it
  # recognises and returning the lines it did not take.
  let blockLoop(lines: [String], accum: [MdBlock]) -> [MdBlock] do
    if lines.empty?
      return accum
    end
    let line = lines.first.or("")
    if line.trim.empty?
      return blockLoop(lines.drop(1), accum)
    end
    if fence?(line)
      let (codeBlock, afterCode) = takeCode(lines)
      return blockLoop(afterCode, accum + [codeBlock])
    end
    if rule?(line)
      return blockLoop(lines.drop(1), accum + [Rule])
    end
    if headingLevel(line) > 0
      let level = headingLevel(line)
      return blockLoop(lines.drop(1), accum + [Heading(level, line.trim.drop(level).trim)])
    end
    if line.trim.startsWith?("> ") || line.trim == ">"
      let (quoteBlock, afterQuote) = takeQuote(lines)
      return blockLoop(afterQuote, accum + [quoteBlock])
    end
    if tableStart?(lines)
      let (tableBlock, afterTable) = takeTable(lines)
      return blockLoop(afterTable, accum + [tableBlock])
    end
    if bulletMarker(line) != "" || numberMarker(line) != ""
      let (listBlock, afterList) = takeList(lines)
      return blockLoop(afterList, accum + [listBlock])
    end
    let (paragraph, afterParagraph) = takeParagraph(lines)
    return blockLoop(afterParagraph, accum + [paragraph])
  end

  let fence?(line: String) -> Bool do
    return line.trim.startsWith?("```")
  end

  # Returns +true+ for a horizontal rule: three or more of +-+, +*+ or +_+ and
  # nothing else on the line. Frontmatter is removed before this runs.
  let rule?(line: String) -> Bool do
    let t = line.trim
    return false if t.count < 3
    return ruleOf?(t, "-") || ruleOf?(t, "*") || ruleOf?(t, "_")
  end

  let ruleOf?(text: String, mark: String) -> Bool do
    return text.chars.all? { |c| c.string == mark }
  end

  # Returns a heading's level, so +##+ gives 2, or 0 when the line is not a
  # heading. +#hashtag+ is not one.
  let headingLevel(line: String) -> Integer do
    let t = line.trim
    let hashes = countHashes(t, 0)
    return 0 if hashes == 0 || hashes > 6
    return 0 if !t.drop(hashes).startsWith?(" ")
    return hashes
  end

  let countHashes(text: String, seen: Integer) -> Integer do
    return seen if !text.startsWith?("#")
    return countHashes(text.drop(1), seen + 1)
  end

  # --- fenced code -------------------------------------------------------

  # Takes a fenced code block. The word after the fence is the language. A
  # fence that is never closed runs to the end of the document.
  let takeCode(lines: [String]) -> (MdBlock, [String]) do
    let language = lines.first.or("").trim.drop(3).trim
    let rest = lines.drop(1)
    let end? = closingCodeFence(rest, 0)
    let body = rest.take(end?)
    return (Code(language, body.join("\n")), rest.drop(end? + 1))
  end

  let closingCodeFence(lines: [String], index: Integer) -> Integer do
    return index if index >= lines.count
    return index if fence?(lines.at(index).or(""))
    return closingCodeFence(lines, index + 1)
  end

  # --- blockquotes -------------------------------------------------------

  # Takes a blockquote. The +>+ is stripped from each line and the rest is
  # parsed as blocks, so a quote can hold anything a document can.
  let takeQuote(lines: [String]) -> (MdBlock, [String]) do
    let taken = lines.takeWhile { |line| quoteLine?(line) }
    let inner = taken.map { |line| stripQuote(line) }
    return (Quote(parseBlocks(inner)), lines.drop(taken.count))
  end

  let quoteLine?(line: String) -> Bool do
    let t = line.trim
    return t.startsWith?("> ") || t == ">"
  end

  let stripQuote(line: String) -> String do
    let t = line.trim
    return "" if t == ">"
    return t.drop(2)
  end

  # --- lists -------------------------------------------------------------

  # Takes a list. A line indented past the first item's marker belongs to the
  # item above it and is parsed as blocks, so an item can hold paragraphs, code
  # and nested lists.
  let takeList(lines: [String]) -> (MdBlock, [String]) do
    let ordered? = numberMarker(lines.first.or("")) != ""
    let taken = lines.takeWhile { |line| listLine?(line) }
    let items = listItems(taken, indentOf(lines.first.or("")), [], [])
    return (ordered? then Numbers(items) else Bullets(items), lines.drop(taken.count))
  end

  # Returns +true+ for a line that can continue a list: an item, an indented
  # line or a blank line. The first other line ends the list.
  let listLine?(line: String) -> Bool do
    return true if line.trim.empty?
    return true if bulletMarker(line) != "" || numberMarker(line) != ""
    return indentOf(line) > 0
  end

  let listItems(lines: [String], indent: Integer, current: [String],
                 accum: [ListItem]) -> [ListItem] do
    if lines.empty?
      return flushItem(current, accum)
    end
    let line = lines.first.or("")
    let rest = lines.drop(1)
    let marker = itemMarker(line)
    if marker != "" && indentOf(line) <= indent
      let body = line.trim.drop(marker.count).trim
      return listItems(rest, indent, [body], flushItem(current, accum))
    end
    return listItems(rest, indent, current + [line], accum)
  end

  # Adds the collected item to +accum+. The first line is the item's text; the
  # lines below it are dedented and parsed as nested blocks.
  let flushItem(current: [String], accum: [ListItem]) -> [ListItem] do
    if current.empty?
      return accum
    end
    let text = current.first.or("")
    let nested = dedent(current.drop(1))
    let trimmed = dropTrailingBlanks(nested)
    return accum + [ListItem { text: text, children: parseBlocks(trimmed) }]
  end

  let dropTrailingBlanks(lines: [String]) -> [String] do
    return lines if lines.empty?
    return lines if !lines.last.or("").trim.empty?
    return dropTrailingBlanks(lines.take(lines.count - 1))
  end

  # Removes the common indent, so nested content is parsed at column zero.
  let dedent(lines: [String]) -> [String] do
    let content = lines.reject { |line| line.trim.empty? }
    return lines if content.empty?
    let least = content.map { |line| indentOf(line) }.reduce(9999, { |a, b| a < b then a else b })
    return lines.map { |line| line.trim.empty? then "" else line.drop(least) }
  end

  let indentOf(line: String) -> Integer do
    return line.chars.takeWhile { |c| c == ' ' || c == '\t' }.count
  end

  let itemMarker(line: String) -> String do
    let bullet = bulletMarker(line)
    return bullet if bullet != ""
    return numberMarker(line)
  end

  let bulletMarker(line: String) -> String do
    let t = line.trim
    return "-" if t.startsWith?("- ")
    return "*" if t.startsWith?("* ")
    return "+" if t.startsWith?("+ ")
    return ""
  end

  # Returns a numbered-list marker, so +"12. "+ gives +"12."+, or +""+
  # when the line has none.
  let numberMarker(line: String) -> String do
    let t = line.trim
    let digits = t.chars.takeWhile { |c| c.digit? }.map { |c| c.string }.join("")
    return "" if digits.empty?
    return "" if !t.drop(digits.count).startsWith?(". ")
    return digits + "."
  end

  # --- tables ------------------------------------------------------------

  # Returns +true+ when the lines start a GFM table: a header row followed by
  # a row of dashes. Without that row the lines are a paragraph.
  let tableStart?(lines: [String]) -> Bool do
    return false if lines.count < 2
    return false if !lines.first.or("").contains?("|")
    return delimiterRow?(lines.at(1).or(""))
  end

  let delimiterRow?(line: String) -> Bool do
    let t = line.trim
    return false if !t.contains?("-")
    return t.chars.all? { |c| delimiterChar?(c.string) }
  end

  let delimiterChar?(c: String) -> Bool do
    return c == "-" || c == "|" || c == ":" || c == " "
  end

  let takeTable(lines: [String]) -> (MdBlock, [String]) do
    let header = cellsOf(lines.first.or(""))
    let rest = lines.drop(2)
    let bodyLines = rest.takeWhile { |line| line.contains?("|") && !line.trim.empty? }
    let rows = bodyLines.map { |line| cellsOf(line) }
    return (Table(header, rows), rest.drop(bodyLines.count))
  end

  # Returns the cells of a table row. Leading and trailing pipes are
  # optional.
  let cellsOf(line: String) -> [String] do
    let t = line.trim
    let inner = t.startsWith?("|") then t.drop(1) else t
    let core = inner.endsWith?("|") then inner.take(inner.count - 1) else inner
    return core.split("|").map { |cell| cell.trim }
  end

  # --- paragraphs --------------------------------------------------------

  # Takes a paragraph, which ends at a blank line or where another block
  # starts, so a list or code fence right under prose is not swallowed.
  let takeParagraph(lines: [String]) -> (MdBlock, [String]) do
    let taken = lines.takeWhile { |line| paragraphLine?(line) }
    let body = taken.map { |line| line.trim }.join(" ")
    return (Paragraph(body), lines.drop(taken.count))
  end

  let paragraphLine?(line: String) -> Bool do
    return false if line.trim.empty?
    return false if fence?(line) || rule?(line)
    return false if headingLevel(line) > 0
    return false if quoteLine?(line)
    return false if bulletMarker(line) != "" || numberMarker(line) != ""
    return true
  end

  # --- rendering ---------------------------------------------------------

  let render(items: [MdBlock]) -> String do
    return items.map { |block| renderBlock(block) }.join("\n")
  end

  let renderBlock(block: MdBlock) -> String do
    match block do
      Heading(level, text) => do
        let tag = "h${level}"
        return "<${tag} id=\"${anchor(text)}\">${inline(text)}</${tag}>"
      end
      Paragraph(text) => "<p>${inline(text)}</p>"
      Code(language, body) => renderCode(language, body)
      Quote(inner) => "<blockquote>\n${render(inner)}\n</blockquote>"
      Bullets(items) => "<ul>\n${renderItems(items)}\n</ul>"
      Numbers(items) => "<ol>\n${renderItems(items)}\n</ol>"
      Table(header, rows) => renderTable(header, rows)
      Rule => "<hr>"
    end
  end

  # Renders a code block. Kex code goes through the reference pages'
  # highlighter; other languages are escaped and left plain.
  let renderCode(language: String, body: String) -> String do
    if language == "kex" || language == ""
      return "<pre class=\"code\"><code>${Tey.Docgen.Highlight.highlight(body)}</code></pre>"
    end
    return "<pre class=\"code\"><code class=\"language-${esc(language)}\">${esc(body)}</code></pre>"
  end

  let renderItems(items: [ListItem]) -> String do
    return items.map { |item| renderItem(item) }.join("\n")
  end

  let renderItem(item: ListItem) -> String do
    if item.children.empty?
      return "<li>${inline(item.text)}</li>"
    end
    return "<li>${inline(item.text)}\n${render(item.children)}\n</li>"
  end

  let renderTable(header: [String], rows: [[String]]) -> String do
    let head = header.map { |cell| "<th>${inline(cell)}</th>" }.join("")
    let body = rows.map { |row| renderRow(row) }.join("\n")
    return "<div class=\"table-scroll\">\n<table>\n<thead><tr>${head}</tr></thead>\n<tbody>\n${body}\n</tbody>\n</table>\n</div>"
  end

  let renderRow(row: [String]) -> String do
    let cells = row.map { |cell| "<td>${inline(cell)}</td>" }.join("")
    return "<tr>${cells}</tr>"
  end

  # Returns a heading's id: lower case, with each run of characters other than
  # letters and digits turned into one dash.
  let anchor(text: String) -> String do
    let lowered = stripInline(text).lowerCase
    let mapped = lowered.chars.map { |c| anchorChar(c) }.join("")
    return trimDashes(squeezeDashes(mapped, ""))
  end

  # Removes dashes from both ends, which +anchor+ can leave: +(try)+ becomes
  # +-try-+ before this.
  let trimDashes(text: String) -> String do
    return text if text.empty?
    return trimDashes(text.drop(1)) if text.startsWith?("-")
    return trimDashes(text.take(text.count - 1)) if text.endsWith?("-")
    return text
  end

  let anchorChar(c: Char) -> String do
    return c.string if c.letter? || c.digit?
    return "-"
  end

  let squeezeDashes(text: String, accum: String) -> String do
    return accum if text.empty?
    let head = text.take(1)
    if head == "-" && accum.endsWith?("-")
      return squeezeDashes(text.drop(1), accum)
    end
    return squeezeDashes(text.drop(1), accum + head)
  end

  # Returns the text with the inline markers (backticks, +*+ and +_+)
  # removed.
  let stripInline(text: String) -> String do
    return text.replace("`", "").replace("**", "").replace("*", "").replace("_", "")
  end

  # --- inline ------------------------------------------------------------

  # Renders inline Markdown. Code spans are handled first: their content is
  # escaped but not scanned for emphasis, so +a*b*c+ in backticks stays as
  # written.
  let inline(text: String) -> String do
    return inlineLoop(text, "")
  end

  let inlineLoop(text: String, accum: String) -> String do
    return accum if text.empty?
    match text.indexOf('`') do
      None => accum + emphasis(text)
      Just(start) => do
        let before = text.take(start)
        let rest = text.drop(start + 1)
        match rest.indexOf('`') do
          None => accum + emphasis(text)
          Just(stop) => do
            let code = rest.take(stop)
            return inlineLoop(rest.drop(stop + 1),
                              accum + emphasis(before) + "<code>${esc(code)}</code>")
          end
        end
      end
    end
  end

  # Renders links, then bold and italics, so a +*+ inside a URL is not read
  # as a marker.
  let emphasis(text: String) -> String do
    return links(text, "")
  end

  let links(text: String, accum: String) -> String do
    return accum if text.empty?
    match text.indexOf('[') do
      None => accum + marks(text)
      Just(start) => do
        let before = text.take(start)
        let rest = text.drop(start + 1)
        match linkParts(rest) do
          None => accum + marks(text)
          Just(parts) => do
            let (label, href, tail) = parts
            return links(tail, accum + marks(before) +
                         "<a href=\"${esc(href)}\">${marks(label)}</a>")
          end
        end
      end
    end
  end

  # Splits +label](href)+ and what follows it into +(label, href, rest)+, or
  # returns +None+ when it is not a link, and the +[+ is plain text.
  let linkParts(rest: String) -> (String, String, String)? do
    match rest.indexOf(']') do
      None => None
      Just(close) => do
        let label = rest.take(close)
        let after = rest.drop(close + 1)
        return None if !after.startsWith?("(")
        match after.indexOf(')') do
          None => None
          Just(paren) => do
            let stop: Integer = paren
            return Just((label, after.drop(1).take(stop - 1), after.drop(stop + 1)))
          end
        end
      end
    end
  end

  # Renders bold before italics, or the opening +**+ would be read as empty
  # italics. The remaining text is escaped here.
  let marks(text: String) -> String do
    return wrap(esc(text), "**", "strong", "*", "em")
  end

  let wrap(text: String, strongMark: String, strongTag: String,
            emMark: String, emTag: String) -> String do
    let bolded = pairs(text, strongMark, strongTag, "")
    return pairs(bolded, emMark, emTag, "")
  end

  # Replaces each pair of markers with a tag. A marker without a partner is
  # left as written.
  let pairs(text: String, mark: String, tag: String, accum: String) -> String do
    match indexOfText(text, mark, 0) do
      None => accum + text
      Just(start) => do
        let before = text.take(start)
        let rest = text.drop(start + mark.count)
        match indexOfText(rest, mark, 0) do
          None => accum + text
          Just(stop) => do
            let inner = rest.take(stop)
            let tail = rest.drop(stop + mark.count)
            return pairs(tail, mark, tag, accum + before + "<${tag}>${inner}</${tag}>")
          end
        end
      end
    end
  end

  # Returns where +needle+ first occurs in +haystack+ from +at+ on, or
  # +None+. +String.indexOf+ only finds a +Char+, and +**+ is two characters.
  let indexOfText(haystack: String, needle: String, at: Integer) -> Integer? do
    return None if at + needle.count > haystack.count
    return Just(at) if haystack.drop(at).startsWith?(needle)
    return indexOfText(haystack, needle, at + 1)
  end

  let esc(s: String) -> String do
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
  end
end
