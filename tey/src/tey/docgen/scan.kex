# Finds the files a docs build reads by walking a source tree.
#
# Paths come back relative to the root, sorted within each directory. +spec/+
# directories and +.spec.kex+ files are skipped: specs cover the same
# declarations as the file they test, so pages for them would repeat every
# entry.

module Tey.Docgen.Scan do
  foul sourceFiles(sourceDir: String) -> [String] do
    return filesWithSuffix(sourceDir, ".kex")
  end

  # Returns the +.md+ files under +sourceDir+ that +tey docs prose+ reads,
  # found by the same walk as the +.kex+ sources.
  foul proseFiles(sourceDir: String) -> [String] do
    return filesWithSuffix(sourceDir, ".md")
  end

  foul filesWithSuffix(sourceDir: String, suffix: String) -> [String] do
    match FS.Directory.files(sourceDir) do
      Ok(names) => do
        let matched = names.filter { |n| n.endsWith?(suffix) && !n.endsWith?(".spec.kex") }
        let sorted = matched.sort
        let nestedDirs = subdirectories(sourceDir)
        return sorted + nested(nestedDirs, sourceDir, suffix)
      end
      Error(_) => []
    end
  end

  foul subdirectories(sourceDir: String) -> [String] do
    return (FS.Directory.directories(sourceDir).or([])).filter { |d| d != "spec" }.sort
  end

  foul nested(dirs: [String], sourceDir: String, suffix: String) -> [String] do
    if dirs.empty?
      return []
    end
    let head = dirs.first.or("")
    let rest = dirs.drop(1)
    let inner = filesWithSuffix(FS.Path.join(sourceDir, head), suffix)
    return inner.map { |name| FS.Path.join(head, name) } + nested(rest, sourceDir, suffix)
  end
end
