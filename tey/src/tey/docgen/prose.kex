# +tey docs prose+: renders a tree of Markdown files as a site, with the same
# layout as the generated reference.
#
# A prose site belongs to a named, versioned unit, as a reference build does,
# so the two can sit side by side in one site and share +versions.json+, the
# stylesheet and the layout. +build+ derives its pages from +.kex+ sources;
# +prose+ renders them from +.md+ files.
#
# The command does not care what the prose is: a guide, a book and a
# package's handbook are all treated the same. Naming the units and putting
# several of them together into one site is left to the caller.

module Tey.Docgen.Prose do
  using Tey.Docgen.Model, only: [PackageModel, SourcePage]

  foul proseCommand(parsed: ParsedOptions) -> Integer do
    let out = Tey.Docgen.Index.optString(parsed.values.get("out"))
    if out.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --out is required")
      return 1
    end
    let source = Tey.Docgen.Index.optString(parsed.values.get("source"))
    if source.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --source is required (the directory of .md files)")
      return 1
    end
    # A prose tree is never a package, so neither identity can be discovered
    # the way `build` discovers a package.kex — both are required here.
    let pkg = Tey.Docgen.Index.optString(parsed.values.get("package"))
    let version = Tey.Docgen.Index.optString(parsed.values.get("release"))
    if pkg.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --package is required")
      return 1
    end
    if version.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --release is required")
      return 1
    end

    let files = Tey.Docgen.Scan.proseFiles(source)
    if files.empty?
      IO.printError("${Console.RED}error:${Console.RESET} no .md files found in ${source}")
      return 1
    end
    let versionDir = FS.Path.join(FS.Path.join(out, pkg), version)
    Tey.Docgen.Index.ensureDirectory(versionDir)
    IO.printLine("${Console.BOLD}Documenting${Console.RESET} ${files.count} prose file(s) ${Console.DIM}into ${versionDir}${Console.RESET}")

    let read = readPages(files, source, [])
    if read.empty?
      IO.printError("${Console.RED}error:${Console.RESET} no .md files could be read")
      return 1
    end
    # Frontmatter `order` is the author's running order; ties keep the
    # scan's alphabetical order, so a tree with no `order` at all is still
    # deterministic rather than arbitrary.
    let ordered = read.sort { |a, b| a.order < b.order }
    let model = PackageModel {
      package: pkg,
      version: version,
      label: Tey.Docgen.Index.optString(parsed.values.get("label")),
      baseUrl: Tey.Docgen.Index.optString(parsed.values.get("base-url")),
      generatedAt: DateTime.now().iso,
      pages: ordered.map { |p| p.page },
      modules: [],
      links: [],
      preludeModules: [],
      preludeSource: "",
      preludeDoc: ""
    }
    writeProse(ordered, versionDir, out, model)
    Tey.Docgen.Index.writeIndexFiles(model.pages, model, out)
    IO.printLine("${Console.GREEN}Wrote${Console.RESET} ${ordered.count} prose page(s)")
    return 0
  end

  # One Markdown page, read and rendered: its place in the site, its sort
  # order and description from the frontmatter, its HTML, and the Markdown
  # without frontmatter that is served as its +.md+ version.
  record ProsePage do
    page : SourcePage
    order : Integer
    body : String
    description : String
    markdown : String
  end

  foul readPages(files: [String], source: String, accum: [ProsePage]) -> [ProsePage] do
    if files.empty?
      return accum
    end
    let fileName = files.first.or("")
    let rest = files.drop(1)
    match FS.File.read(FS.Path.join(source, fileName)) do
      Error(_) => do
        IO.printError("  ${Console.RED}fail${Console.RESET} ${fileName}: cannot read")
        return readPages(rest, source, accum)
      end
      Ok(text) => do
        IO.printLine("  ${Console.GREEN}ok${Console.RESET} ${fileName}")
        return readPages(rest, source, accum + [pageOf(fileName, text)])
      end
    end
  end

  let pageOf(fileName: String, text: String) -> ProsePage do
    let document = Tey.Docgen.Md.parseDocument(text)
    let urlPath = stripSuffix(fileName, ".md")
    # A page with no `title:` is titled by its file, so an untitled draft
    # still appears in the sidebar under something a reader can recognise.
    let title = document.frontmatter.title.empty? then urlPath else document.frontmatter.title
    # The raw `.md` rendering is the source as authored, minus its
    # frontmatter — the same split the parser read, rejoined.
    let (_, bodyLines) = Tey.Docgen.Md.splitFrontmatter(text.replace("\r\n", "\n").split("\n"))
    return ProsePage {
      page: SourcePage { source: fileName, urlPath: urlPath, title: title, entities: [] },
      order: document.frontmatter.order,
      body: Tey.Docgen.Md.render(document.blocks),
      description: document.frontmatter.description,
      markdown: bodyLines.join("\n") + "\n"
    }
  end

  let stripSuffix(name: String, suffix: String) -> String do
    return name.take(name.count - suffix.count) if name.endsWith?(suffix)
    return name
  end

  # Writes each page as HTML and as Markdown side by side, as reference
  # builds do, plus the index page and the shared assets.
  foul writeProse(pages: [ProsePage], versionDir: String, out: String,
                  model: PackageModel) -> () do
    writeProseLoop(pages, 0, versionDir, model)
    let _ = FS.File.write(FS.Path.join(versionDir, "index.html"),
                          proseIndexHtml(pages, model))
    Tey.Docgen.Index.ensureDirectory(FS.Path.join(out, "assets"))
    let _ = FS.File.write(FS.Path.join(out, "assets/style.css"), Tey.Docgen.Css.siteCss())
    let _ = FS.File.write(FS.Path.join(out, "assets/site.js"), Tey.Docgen.Assets.siteJs())
    return ()
  end

  foul writeProseLoop(pages: [ProsePage], index: Integer, versionDir: String,
                      model: PackageModel) -> () do
    match pages.at(index) do
      None => ()
      Just(prose) => do
        let page = prose.page
        Tey.Docgen.Index.ensureDirectory(
          FS.Path.join(versionDir, Tey.Docgen.Index.dirNameOf(page.urlPath)))
        let heading = "<h1>${Tey.Docgen.Html.esc(page.title)}</h1>"
        let html = Tey.Docgen.Html.layout(page.title, page.urlPath,
          "${heading}\n${prose.body}\n${prevNextHtml(pages, index)}", model)
        let _ = FS.File.write(FS.Path.join(versionDir, page.urlPath + ".html"), html)
        let _ = FS.File.write(FS.Path.join(versionDir, page.urlPath + ".md"), prose.markdown)
        writeProseLoop(pages, index + 1, versionDir, model)
      end
    end
  end

  # Renders the index page: the chapters in the author's order, each with
  # its description. Reference builds use +versionIndexHtml+, a grid of
  # modules, instead; the two are kept separate so book layout never reaches
  # +tey docs build+.
  let proseIndexHtml(pages: [ProsePage], model: PackageModel) -> String do
    let label = Tey.Docgen.Index.labelOrPackage(model)
    let heading = "<h1>${Tey.Docgen.Html.esc(label)} <span class=\"ver\">${Tey.Docgen.Html.esc(model.version)}</span></h1>"
    let lede = "<p class=\"lede\">${Tey.Docgen.Html.esc(label)} — read cover to cover, or jump in anywhere.</p>"
    let items = pages.map { |prose| chapterItem(prose) }.join("\n")
    return Tey.Docgen.Html.layout(label, "", "${heading}\n${lede}\n<ol class=\"chapters\">\n${items}\n</ol>", model)
  end

  let chapterItem(prose: ProsePage) -> String do
    let title = "<a href=\"${prose.page.urlPath}.html\">${Tey.Docgen.Html.esc(prose.page.title)}</a>"
    if prose.description.empty?
      return "<li>${title}</li>"
    end
    return "<li>${title}<br><span class=\"prelude-note\">${Tey.Docgen.Html.esc(prose.description)}</span></li>"
  end

  # Renders a chapter's footer: links to the previous and next chapters. The
  # first and last chapters get only one link.
  let prevNextHtml(pages: [ProsePage], index: Integer) -> String do
    match pages.at(index) do
      None => ""
      Just(prose) => do
        let up = Tey.Docgen.Nav.upsToVersionDir(prose.page.urlPath)
        return chapterNav(prevLink(pages, index, up), nextLink(pages, index, up))
      end
    end
  end

  let prevLink(pages: [ProsePage], index: Integer, up: String) -> String do
    return "" if index <= 0
    match pages.at(index - 1) do
      None => ""
      Just(sibling) => "<a class=\"prev\" href=\"${up}${sibling.page.urlPath}.html\">← ${Tey.Docgen.Html.esc(sibling.page.title)}</a>"
    end
  end

  let nextLink(pages: [ProsePage], index: Integer, up: String) -> String do
    match pages.at(index + 1) do
      None => ""
      Just(sibling) => "<a class=\"next\" href=\"${up}${sibling.page.urlPath}.html\">${Tey.Docgen.Html.esc(sibling.page.title)} →</a>"
    end
  end

  let chapterNav(prev: String, nextHtml: String) -> String do
    if prev.empty?
      return "" if nextHtml.empty?
      return "<nav class=\"prevnext\">${nextHtml}</nav>"
    end
    return "<nav class=\"prevnext\">${prev}</nav>" if nextHtml.empty?
    return "<nav class=\"prevnext\">${prev} <span class=\"sep\">·</span> ${nextHtml}</nav>"
  end
end
