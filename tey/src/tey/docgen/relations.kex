# Relations across files: which make blocks extend which type, which traits a
# type implements, and which types implement each trait.
#
# Extraction works one file at a time, but readers look things up by type. The
# functions on +Integer+ are spread over number.kex, period.kex, units.kex and
# algebra.kex, and that a +List+ is +Enumerable+, and so has +map+, +filter+
# and +find+, is written on a make block rather than on the type. These
# indexes let the List page say where its functions come from, and the
# Enumerable page list its implementors.

module Tey.Docgen.Relations do
  using Tey.Docgen.Model, only: [Entity, TraitDecl, MakeDecl, ModuleDecl, FuncDecl, TypeDecl, RecordDecl, ConstDecl, TraitEntry, MakeEntry, FunctionEntry, SourcePage, PackageModel, Extension, TypeFacts, TraitFacts, anchorOf, baseTypeOf]

  let build(pages: [SourcePage]) -> ([TypeFacts], [TraitFacts]) do
    let traitNames = pages.into { |page| traitEntries(page.entities) }.into { |t| [t.name, t.qualifiedName] }
    let extensions = pages.into { |page| pageExtensions(page, page.entities) }
    # `make Inspectable do` gives every Inspectable a default function: it
    # belongs to the trait (traitMethods), not to a type of that name.
    let bases = extensions.map { |e| baseTypeOf(e.target) }.uniq.reject { |b| traitNames.contains?(b) }
    let types = bases.map { |base| typeFacts(base, extensions, pages) }
    let traits = pages.into { |page| pageTraits(page, page.entities, extensions) }
    return (types, traits)
  end

  # Returns +pages+ with each untyped make member that implements a trait
  # function given the trait's signature.
  #
  # For +let identity = 0+ under +make Integer, implement: Monoid+, that is
  # the signature +Monoid+ declares, with +This+ read as +Integer+. It runs on
  # the pages before anything renders them, so every output shows the same
  # signature.
  let withTraitSignatures(pages: [SourcePage]) -> [SourcePage] do
    let traits = pages.into { |p| traitEntries(p.entities) }
    return pages.map { |p| SourcePage { ...p, entities: p.entities.map { |e| typedByTraits(e, traits) } } }
  end

  let typedByTraits(e: Entity, traits: [TraitEntry]) -> Entity do
    match e do
      MakeDecl(m) => MakeDecl(MakeEntry { ...m, functions: m.functions.map { |f| typedByTrait(f, m, traits) } })
      ModuleDecl(m) => ModuleDecl(Tey.Docgen.Model.ModuleEntry { ...m, children: m.children.map { |c| typedByTraits(c, traits) } })
      _ => e
    end
  end

  let typedByTrait(f: FunctionEntry, m: MakeEntry, traits: [TraitEntry]) -> FunctionEntry do
    return f if !f.signatures.all? { |s| s == f.name }
    let implemented = m.implements.map { |i| baseTypeOf(i) }
    let declared = traits.filter { |t| implemented.contains?(t.name) || implemented.contains?(t.qualifiedName) }.into { |t| t.functions }
    let signatures = declared.filter { |g| g.name == f.name }.into { |g| g.signatures }.map { |s| asImplementor(s, m.target) }.uniq
    return signatures.empty? then f else FunctionEntry { ...f, signatures: signatures }
  end

  let asImplementor(signature: String, target: String) -> String do
    return Tey.Docgen.Nav.segmentsOf(signature).map { |seg| seg == "This" then target else seg }.join("")
  end

  let pageExtensions(page: SourcePage, entities: [Entity]) -> [Extension] do
    return entities.into { |e|
      match e do
        MakeDecl(entry) => [extensionOf(page, e, entry)]
        ModuleDecl(entry) => pageExtensions(page, entry.children)
        _ => []
      end
    }
  end

  let extensionOf(page: SourcePage, entity: Entity, entry: MakeEntry) -> Extension do
    return Extension {
      target: entry.target,
      urlPath: page.urlPath,
      pageTitle: page.title,
      anchor: anchorOf(entity),
      implements: entry.implements,
      names: entry.functions.map { |f| f.name }.uniq
    }
  end

  let typeFacts(base: String, extensions: [Extension], pages: [SourcePage]) -> TypeFacts do
    let mine = extensions.filter { |e| baseTypeOf(e.target) == base }
    let home = homePathOf(base, mine, pages)
    return TypeFacts {
      name: base,
      homePath: home,
      homeAnchor: homeAnchorOf(base, home, mine, pages),
      extensions: mine,
      traits: mine.into { |e| e.implements }.uniq
    }
  end

  # Returns the page a type's links should go to.
  #
  # That is the page declaring the type; failing that, the page titled after
  # it (string.kex for the built-in String); then a page with both the type's
  # companion module and a make block for it; and last the page whose make
  # block adds the most functions, so number.kex for Integer rather than
  # algebra.kex, which only makes it a Monoid.
  let homePathOf(base: String, mine: [Extension], pages: [SourcePage]) -> String do
    match pages.find { |p| declares?(p.entities, base) } do
      Just(page) => return page.urlPath
      None => ()
    end
    match pages.find { |p| p.title == base } do
      Just(page) => return page.urlPath
      None => ()
    end
    # number.kex declares `module Float` (parsing, bounds) beside its
    # `make Float`: the page with the type's companion module is its home.
    match pages.find { |p| companionModule?(p.entities, base) && mine.any? { |e| e.urlPath == p.urlPath } } do
      Just(page) => return page.urlPath
      None => ()
    end
    match mine.first do
      Just(first) => return mine.reduce(first, { |best, e| e.names.count > best.names.count then e else best }).urlPath
      None => return ""
    end
  end

  let homeAnchorOf(base: String, home: String, mine: [Extension], pages: [SourcePage]) -> String do
    let declared = pages.filter { |p| p.urlPath == home }.into { |p| declarationAnchors(p.entities, base) }
    match declared.first do
      Just(anchor) => return anchor
      None => ()
    end
    match mine.find { |e| e.urlPath == home } do
      Just(e) => return e.anchor
      None => return ""
    end
  end

  let declarationAnchors(entities: [Entity], base: String) -> [String] do
    return entities.into { |e|
      match e do
        TypeDecl(entry) => entry.name == base then [anchorOf(e)] else []
        RecordDecl(entry) => entry.name == base then [anchorOf(e)] else []
        ModuleDecl(entry) => declarationAnchors(entry.children, base)
        _ => []
      end
    }
  end

  let companionModule?(entities: [Entity], base: String) -> Bool do
    return entities.any? { |e|
      match e do
        ModuleDecl(entry) => entry.qualifiedName == base || companionModule?(entry.children, base)
        _ => false
      end
    }
  end

  let declares?(entities: [Entity], base: String) -> Bool do
    return entities.any? { |e|
      match e do
        TypeDecl(entry) => entry.name == base || entry.qualifiedName == base
        RecordDecl(entry) => entry.name == base || entry.qualifiedName == base
        ModuleDecl(entry) => declares?(entry.children, base)
        _ => false
      end
    }
  end

  let pageTraits(page: SourcePage, entities: [Entity], extensions: [Extension]) -> [TraitFacts] do
    return entities.into { |e|
      match e do
        TraitDecl(entry) => [TraitFacts {
          name: entry.name,
          qualifiedName: entry.qualifiedName,
          urlPath: page.urlPath,
          anchor: anchorOf(e),
          implementors: extensions.filter { |x| x.implements.any? { |i| namesTrait?(i, entry.name, entry.qualifiedName) } }
        }]
        ModuleDecl(entry) => pageTraits(page, entry.children, extensions)
        _ => []
      end
    }
  end

  # Returns whether +written+, as it appears in an +implement:+ list, names the
  # trait +name+. +implement: Enumerable+ and +implement: Kex.Enumerable+ both
  # name the trait declared as +Enumerable+ inside +module Kex+.
  let namesTrait?(written: String, name: String, qualifiedName: String) -> Bool do
    let spelled = (written.split("<").first.or(written)).trim
    return spelled == qualifiedName || spelled == name || qualifiedName.endsWith?(".${spelled}")
  end

  # Returns the facts for the type that make target +base+ extends, or +None+
  # when no make block extends it.
  let typeFactsFor(model: PackageModel, base: String) -> TypeFacts? do
    return model.types.find { |t| t.name == base }
  end

  let traitFactsFor(model: PackageModel, written: String) -> TraitFacts? do
    return model.traits.find { |t| namesTrait?(written, t.name, t.qualifiedName) }
  end

  # Returns the declaration of a trait, for its list of functions.
  let traitEntryFor(model: PackageModel, facts: TraitFacts) -> TraitEntry? do
    let found = model.pages.into { |p| traitEntries(p.entities) }
    return found.find { |t| t.qualifiedName == facts.qualifiedName }
  end

  let traitEntries(entities: [Entity]) -> [TraitEntry] do
    return entities.into { |e|
      match e do
        TraitDecl(entry) => [entry]
        ModuleDecl(entry) => traitEntries(entry.children)
        _ => []
      end
    }
  end

  # Returns a trait's functions as an implementor sees them: the required ones
  # and the provided ones.
  #
  # A function is required when the trait gives it no body and no
  # +make <Trait>+ block in any file gives it a default. The provided ones
  # are the rest, plus any functions such a block adds that the trait does not
  # declare.
  let traitMethods(model: PackageModel, entry: TraitEntry) -> ([FunctionEntry], [FunctionEntry]) do
    let defaults = model.pages.into { |p| traitDefaults(p.entities, entry) }
    let defaultNames = defaults.map { |f| f.name }
    let declaredNames = entry.functions.map { |f| f.name }
    let required = entry.functions.filter { |f| required?(f) && !defaultNames.contains?(f.name) }
    let provided = entry.functions.reject { |f| required?(f) && !defaultNames.contains?(f.name) }
    return (required, provided + defaults.reject { |f| declaredNames.contains?(f.name) })
  end

  let traitDefaults(entities: [Entity], entry: TraitEntry) -> [FunctionEntry] do
    return entities.into { |e|
      match e do
        MakeDecl(m) => do
          let base = baseTypeOf(m.target)
          (base == entry.name || base == entry.qualifiedName) then m.functions else []
        end
        ModuleDecl(m) => traitDefaults(m.children, entry)
        _ => []
      end
    }
  end

  # Returns whether a make target names a trait of this package.
  let traitTarget?(model: PackageModel, target: String) -> Bool do
    let base = baseTypeOf(target)
    return model.traits.any? { |t| t.name == base || t.qualifiedName == base }
  end

  # Returns every function documented in +entities+: top-level and module
  # functions, trait functions and make members.
  let allFunctions(entities: [Entity]) -> [FunctionEntry] do
    return entities.into { |e|
      match e do
        FuncDecl(entry) => [entry]
        TraitDecl(entry) => entry.functions
        MakeDecl(entry) => entry.functions
        ModuleDecl(entry) => allFunctions(entry.children)
        _ => []
      end
    }
  end

  # Returns whether a trait function has no body, so an implementor must
  # write it.
  let required?(f: FunctionEntry) -> Bool do
    return f.clauseCount == 0
  end
end
