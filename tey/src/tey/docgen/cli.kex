# Command-line interface for docgen: option declarations, dispatch, usage.
#
# Inside a package (a directory with a package.kex), most of the line is
# already implied — `tey docs build --out <site>` is the whole command:
#
#   cd tey && tey docs build --out ../kdocs
#
#   tey docs build --source src/stdlib --out <dir> \
#     --package prelude --label "Prelude" --base-url https://docs.kex.run
#
#   tey docs serve --out <dir> --port 4322
#
# A built-in Tey command. Everything after the command word is docgen's own
# vocabulary — OptionParser passes a command's options through — so no `--`
# is needed, though `tey docs -- build ...` works too (the `--` is stripped).

module Tey.Docgen.Cli do
  # A function rather than a module-level constant: on BEAM, calling a
  # make-method (`.parse`, `.help`) on a module-level constant fails with
  # "Undefined function" — the dispatcher doesn't resolve the constant.
  foul options() -> OptionParser.OptionConfig do
    return OptionParser.define("docgen", "Generate and serve Kex documentation")
      .string("source", None, "Source directory (default: src/ of this package)", None, false)
      .string("out", None, "Site root; this package lands at <out>/<package>/<version>", None, false)
      # "release", not "version": Tey's own --version flag would otherwise
      # swallow this one on the way in (OptionParser passes a command's
      # UNKNOWN options through, not its known ones).
      .string("release", None, "Release being documented (default: package.kex's)", None, false)
      .string("package", None, "Package name (default: package.kex's, else prelude)", None, false)
      .string("label", None, "Human-readable package label", None, false)
      .string("base-url", None, "Documentation site base URL", Just("https://docs.kex.run"), false)
      .integer("port", None, "HTTP port", Just("4322"), false)
  end

  foul dispatch(args: [String]) -> Integer do
    match options().parse(args) do
      Error(error) => do
        let message = OptionParser.errorMessage(error)
        IO.printError("docgen: ${message}\n\n${options().help}\n")
        return 1
      end
      Ok(parsed) => runCommand(parsed)
    end
  end

  foul runCommand(parsed: OptionParser.ParsedOptions) -> Integer do
    let command = parsed.arguments.first.or("")
    if command == "build"
      return Tey.Docgen.Index.buildCommand(parsed)
    end
    if command == "serve"
      return Tey.Docgen.Serve.serveCommand(parsed)
    end
    return printUsage()
  end

  foul printUsage() -> Integer do
    IO.printLine("docgen - kex documentation generator")
    IO.printLine("")
    IO.printLine("Usage:")
    IO.printLine("  tey docs build --source <dir> --out <dir> [options]")
    IO.printLine("  tey docs serve --out <dir> [--port 4322]")
    IO.printLine("")
    IO.printLine("Build options:")
    IO.printLine("  --source <dir>     source directory with .kex files (default: src/)")
    IO.printLine("  --out <dir>        site root; pages land at <out>/<package>/<version>")
    IO.printLine("  --release <v>      release being documented (default: package.kex's)")
    IO.printLine("  --package <name>   package name (default: package.kex's, else prelude)")
    IO.printLine("  --label <text>     human-readable package label (default: the name)")
    IO.printLine("  --base-url <url>   site base URL for sitemap")
    IO.printLine("")
    IO.printLine("Outputs (all derived from the canonical typed model):")
    IO.printLine("  model.json         full documentation model")
    IO.printLine("  search.json        flat search index (name/kind/signature)")
    IO.printLine("  <pkg>/<ver>/*.md   one Markdown page per source file")
    IO.printLine("  <pkg>/<ver>/*.html the same pages as a styled static site")
    IO.printLine("  assets/style.css   the site's stylesheet (kex.run design tokens)")
    IO.printLine("  manifest.json, versions.json, llms.txt, llms-full.txt,")
    IO.printLine("  robots.txt, sitemap.xml")
    IO.printLine("")
    IO.printLine("Serve options:")
    IO.printLine("  --out <dir>        directory to serve")
    IO.printLine("  --port <n>         port (default: 4322)")
    return 0
  end
end
