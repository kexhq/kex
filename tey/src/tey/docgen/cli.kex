# Command-line interface for docgen: option declarations, dispatch, usage.
#
# Inside a package (a directory with a package.kex), most of the line is
# already implied — `tey docs build --out <site>` is the whole command:
#
#   cd tey && tey docs build --out ../kdocs
#
#   tey docs build --source src/stdlib --out <dir> \
#     --package prelude --label "Prelude" --base-url https://docs.kex.run
#
#   tey docs serve --out <dir> --port 4322
#
# A built-in Tey command. Everything after the command word is docgen's own
# vocabulary — OptionParser passes a command's options through — so no `--`
# is needed, though `tey docs -- build ...` works too (the `--` is stripped).

module Tey.Docgen.Cli do
  # A function rather than a module-level constant: on BEAM, calling a
  # make-method (`.parse`, `.help`) on a module-level constant fails with
  # "Undefined function" — the dispatcher doesn't resolve the constant.
  #
  # The three subcommands are declared here, the way Tey declares its own, so
  # `tey docs` help is generated from the same definitions that parse the
  # line and reads like `tey help` does.
  foul options() -> OptionParser.OptionConfig do
    return OptionParser.define("tey docs", "Generate and serve Kex documentation")
      .flag("help", Just('h'), "Show this help")
      .string("source", None, "Source directory: .kex files for build (default: this package's src/), .md files for prose", None, false)
      .string("out", None, "Site root; this package lands at <out>/<package>/<version>", None, false)
      # "release", not "version": Tey's own --version flag would otherwise
      # swallow this one on the way in (OptionParser passes a command's
      # UNKNOWN options through, not its known ones).
      .string("release", None, "Release being documented (default: package.kex's)", None, false)
      .string("package", None, "Package name (default: package.kex's, else prelude)", None, false)
      .string("label", None, "Human-readable package label (default: the name)", None, false)
      .string("base-url", None, "Documentation site base URL, for the sitemap", Just("https://docs.kex.run"), false)
      .string("format", None, "site (a standalone site) or fragments (page bodies for a host site)", Just("site"), false)
      .string("link-model", None, "Another unit's model.json to link names into (comma-separated)", None, false)
      .integer("port", None, "HTTP port for serve", Just("4322"), false)
      .command("build", "--out <dir> [--source <dir>] [options]",
               "generate a package's reference from its .kex sources") do |parsed|
        strict(parsed) then Tey.Docgen.Index.buildCommand(parsed) else 1
      end
      .command("prose", "--source <md-dir> --out <dir> --package <name> --release <v>",
               "render a tree of Markdown pages into the same site") do |parsed|
        strict(parsed) then Tey.Docgen.Prose.proseCommand(parsed) else 1
      end
      .command("serve", "--out <dir> [--port <n>]", "serve a generated site locally") do |parsed|
        strict(parsed) then Tey.Docgen.Serve.serveCommand(parsed) else 1
      end
  end

  foul dispatch(args: [String]) -> Integer do
    return printUsage() if args.empty? || args.contains?("--help") || args.contains?("-h")
    options().run(args)
  end

  # After a command word, OptionParser hands an option it does not know on to
  # the command as an argument, for commands with a vocabulary of their own.
  # These three have none beyond the options above, so one left over is a
  # typo — and `--sorce src` silently documenting the wrong directory is
  # worse than an error.
  foul strict(parsed: OptionParser.ParsedOptions) -> Bool do
    match parsed.arguments.find { |argument| argument.startsWith?("-") } do
      None => true
      Just(option) => do
        let message = OptionParser.errorMessage(UnknownOption(option))
        IO.printError("${Console.RED}error:${Console.RESET} ${message}\n\n${options().help}")
        false
      end
    end
  end

  # The generated help, then what a build leaves behind — the one part of
  # this command's story that no option or subcommand declares.
  foul printUsage() -> Integer do
    IO.printLine("${options().help}\n\n${outputsHelp()}")
    return 0
  end

  # Styled like OptionParser's own blocks: a bold heading, then one aligned
  # row per entry, padded on the unstyled name.
  foul outputsHelp() -> String do
    let outputs = [
      ("<pkg>/<ver>/*.html", "one styled page per source file"),
      ("<pkg>/<ver>/*.md", "the same pages as Markdown"),
      ("assets/style.css, assets/site.js", "the site's stylesheet and script"),
      ("model.json", "the full documentation model every page is derived from"),
      ("search.json", "flat search index (name, kind, signature)"),
      ("manifest.json, versions.json", "what was built, and every published version"),
      ("llms.txt, llms-full.txt", "the documentation as plain text for language models"),
      ("robots.txt, sitemap.xml", "for crawlers")
    ]
    let names = outputs.map do |output|
      let (name, _) = output
      name
    end
    let width = names.map { |name| name.count }.max.or(0)
    let rows = outputs.map do |output|
      let (name, description) = output
      let padding = " ".repeat(width - name.count)
      "  ${Console.CYAN}${name}${Console.RESET}${padding}  ${description}"
    end
    return "${Console.BOLD}Outputs:${Console.RESET}\n${rows.join("\n")}"
  end
end
