# RDoc-style doc-comment text → structured documentation (typed).
#
# A doc comment is free prose followed by directive paragraphs:
#
#   # Sums all elements. Returns +0+ for an empty list.
#   #
#   # @param f [X -> Number] maps each element
#   # @return [Number]
#   # @example
#   #   [1, 2].sum   # => 3
#
# Inline `+code+` pairs are rewritten to `` `code` ``. The result is a
# Tey.Docgen.Model.Doc record.

module Tey.Docgen.Rdoc do
  using Tey.Docgen.Model, only: [Doc, Param, Return, Example, emptyDoc]

  record Bracketed do
    content : String
    rest : String
  end

  foul parseDoc(text: String) -> Doc? do
    if text.empty?
      return None
    end
    let lines = rewritePlusPairs(text, "").split("\n")
    let blocks = mergeVerbatim(splitParagraphs(lines, [], []), [])
    return classifyBlocks(blocks, "", [], None, [], None)
  end

  foul parseOrEmpty(text: String) -> Doc do
    match parseDoc(text) do
      Just(doc) => doc
      None => emptyDoc()
    end
  end

  foul rewritePlusPairs(s: String, accum: String) -> String do
    match s.indexOf('+') do
      None => accum + s
      Just(start) => do
        let rest = s.drop(start + 1)
        match rest.indexOf('+') do
          None => accum + s
          Just(endOffset) => do
            let inner = rest.take(endOffset)
            let tail = rest.drop(endOffset + 1)
            let head = s.take(start)
            return rewritePlusPairs(tail, accum + head + "`" + inner + "`")
          end
        end
      end
    end
  end

  # Splits lines into paragraphs (blocks). Prose groups until a blank line;
  # directives are LINE-based, so each `@param`/`@return`/`@example` line
  # begins its own paragraph — consecutive `@param a` / `@param b` lines must
  # not merge into one block, or only the first would be parsed. An
  # `@example`'s indented code lines follow it and stay in its block (they
  # do not open with `@`).
  foul splitParagraphs(lines: [String], current: [String], accum: [[String]]) -> [[String]] do
    if lines.empty?
      if current.empty?
        return accum
      end
      return accum + [current]
    end
    let line = lines.first.or("")
    let rest = lines.drop(1)
    if line.trim.empty?
      if current.empty?
        return splitParagraphs(rest, [], accum)
      end
      # A blank line inside an `@example`'s code is part of the example — a
      # `describe` with a `before` block and an `it` block has one. Indented
      # code on the far side of it means the directive has not ended.
      if directiveBlock?(current) && indented?(rest.first.or(""))
        return splitParagraphs(rest, current + [""], accum)
      end
      return splitParagraphs(rest, [], accum + [current])
    end
    if line.trim.startsWith?("@")
      let flushed = if current.empty? then accum else accum + [current] end
      return splitParagraphs(rest, [line], flushed)
    end
    # A directive's continuation lines are indented — an `@example`'s code is
    # what they usually are. An unindented line therefore ends the directive
    # even without a blank line between them, so an implementation note
    # written straight under the last example does not become part of it.
    if directiveBlock?(current) && indentWidth(line) == 0
      return splitParagraphs(rest, [line], accum + [current])
    end
    return splitParagraphs(rest, current + [line], accum)
  end

  foul directiveBlock?(current: [String]) -> Bool do
    return (current.first.or("")).trim.startsWith?("@")
  end

  foul indented?(line: String) -> Bool do
    return !line.trim.empty? && indentWidth(line) >= 2
  end

  # RDoc's verbatim marker is indentation: a prose block whose every line is
  # indented is code — or a hand-laid-out table — that the author positioned
  # deliberately. Reflowing it into a paragraph loses both the line breaks and
  # the highlighting, so it is carried through the summary as a fenced block
  # instead, which both renderers turn back into a highlighted `<pre>`.

  # Leading-space count of a line.
  foul indentWidth(s: String) -> Integer do
    return s.chars.takeWhile { |c| c == ' ' }.count
  end

  foul verbatim?(lines: [String]) -> Bool do
    let content = lines.reject { |l| l.trim.empty? }
    if content.empty?
      return false
    end
    return content.all? { |l| indentWidth(l) >= 2 }
  end

  # Strips the common indentation shared by every non-blank line, so a block
  # written at two spaces (or nested deeper) renders flush left.
  foul dedent(lines: [String]) -> [String] do
    let content = lines.reject { |l| l.trim.empty? }
    if content.empty?
      return lines
    end
    let margin = content.map { |l| indentWidth(l) }.min.or(0)
    if margin <= 0
      return lines
    end
    return lines.map { |l| l.trim.empty? then "" else l.drop(margin) }
  end

  foul fenceVerbatim(lines: [String]) -> String do
    return (["```kex"] + dedent(lines) + ["```"]).join("\n")
  end

  # A blank line inside a verbatim block ends a paragraph but not the block,
  # so adjacent verbatim blocks are re-joined with the blank line between them.
  foul mergeVerbatim(blocks: [[String]], accum: [[String]]) -> [[String]] do
    if blocks.empty?
      return accum
    end
    let block = blocks.first.or([])
    let rest = blocks.drop(1)
    let previous = accum.last.or([])
    if verbatim?(block) && verbatim?(previous)
      return mergeVerbatim(rest, accum.take(accum.count - 1) + [previous + [""] + block])
    end
    return mergeVerbatim(rest, accum + [block])
  end

  foul classifyBlocks(blocks: [[String]], summary: String, params: [Param],
                      returns: Return?, examples: [Example],
                      deprecated: String?) -> Doc? do
    if blocks.empty?
      return Just(Doc {
        summary: summary,
        params: params,
        returns: returns,
        examples: examples,
        deprecated: deprecated
      })
    end
    let block = blocks.first.or([])
    let rest = blocks.drop(1)
    let first = block.first.or("")
    if first.startsWith?("@param")
      return classifyBlocks(rest, summary, params + [parseParam(block)], returns, examples, deprecated)
    end
    if first.startsWith?("@return")
      return classifyBlocks(rest, summary, params, Just(parseReturn(block)), examples, deprecated)
    end
    if first.startsWith?("@example")
      return classifyBlocks(rest, summary, params, returns, examples + [parseExample(block)], deprecated)
    end
    if first.startsWith?("@deprecated")
      return classifyBlocks(rest, summary, params, returns, examples, Just(block.drop(1).join(" ")))
    end
    if first.startsWith?("@")
      return classifyBlocks(rest, summary, params, returns, examples, deprecated)
    end
    # Prose block: the first becomes the summary, later ones join it as
    # further paragraphs. Verbatim blocks keep their layout.
    let joined = verbatim?(block) then fenceVerbatim(block) else block.join(" ")
    let nextSummary = if summary.empty?
      joined
    else
      summary + "\n\n" + joined
    end
    return classifyBlocks(rest, nextSummary, params, returns, examples, deprecated)
  end

  # @param name [Type] description
  foul parseParam(lines: [String]) -> Param do
    let body = (lines.first.or("")).drop(7).trim
    match body.indexOf(' ') do
      None => Param { name: body, typeName: "", description: "" }
      Just(nameEnd) => do
        let name = body.take(nameEnd)
        let tail = body.drop(nameEnd + 1).trim
        match parseBracketed(tail) do
          None => Param { name: name, typeName: "", description: tail }
          Just(parsed) => do
            let description = parsed.rest.trim
            return Param { name: name, typeName: parsed.content, description: description }
          end
        end
      end
    end
  end

  # @return [Type] description
  foul parseReturn(lines: [String]) -> Return do
    let body = (lines.first.or("")).drop(8).trim
    match parseBracketed(body) do
      None => Return { typeName: "", description: body }
      Just(parsed) => Return { typeName: parsed.content, description: parsed.rest.trim }
    end
  end

  foul parseExample(lines: [String]) -> Example do
    let caption = (lines.first.or("")).drop(9).trim
    let code = dedent(lines.drop(1)).join("\n")
    return Example { caption: caption, code: code }
  end

  # "[...]" prefix → Bracketed. None when the text does not open with a
  # bracketed group.
  foul parseBracketed(s: String) -> Bracketed? do
    if s.empty?
      return None
    end
    if s.first.or('?') != '['
      return None
    end
    match findClosingBracket(s, 1, 1) do
      None => None
      Just(endIndex) => do
        let content = s.take(endIndex).drop(1)
        let rest = s.drop(endIndex + 1)
        return Just(Bracketed { content: content, rest: rest })
      end
    end
  end

  foul findClosingBracket(s: String, index: Integer, depth: Integer) -> Integer? do
    if index >= s.count
      return None
    end
    let c = s.get(index).or('?')
    let nextDepth = match c do
      '[' => depth + 1
      ']' => depth - 1
      _ => depth
    end
    if nextDepth == 0
      return Just(index)
    end
    return findClosingBracket(s, index + 1, nextDepth)
  end
end
