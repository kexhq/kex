# The docs site stylesheet, ported by hand from kex-run-site's design tokens
# (src/styles/global.css): the warm honey/cream palette from the kex logo,
# Plus Jakarta Sans / Fraunces / JetBrains Mono, dark warm code surface with
# tok-* syntax classes. Plain CSS with custom properties — no Tailwind build,
# so the output stays host-anywhere static files.
#
# The stylesheet itself is assets/style.css, embedded at compile time so the
# build stays self-contained: Tey.Docgen.Index writes it to
# <out>/assets/style.css.

module Tey.Docgen.Css do
  foul siteCss() -> String do
    return Kex.embed("assets/style.css")
  end
end
