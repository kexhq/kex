---
params: [title: String, label: String, version: String, package: String, root: String, page: String, home: String, sidebar: String, body: String, generatedAt: String, markdownLink: String]
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | <%= label %> <%= version %> | kex docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Plus+Jakarta+Sans:wght@400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%== root %>assets/style.css">
    <link rel="icon" type="image/png" href="<%== root %>icon.png">
    <script src="<%== root %>assets/site.js" defer></script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="<%== root %>index.html">kex</a>
        <span class="brand-sub">docs</span>
        <span class="spacer"></span>
        <button class="search-trigger" id="search" aria-label="Search documentation"
            data-root="<%== root %>" data-package="<%= package %>" data-version="<%= version %>"
            data-page="<%= page %>">
          <span>Search</span><kbd>/</kbd>
        </button>
        <span class="pkg-badge" id="version-badge" data-root="<%== root %>" data-package="<%= package %>" data-version="<%= version %>" data-page="<%= page %>"><%= label %> <%= version %></span>
        <a class="back" href="https://kex.run/docs">kex.run ↗</a>
      </div>
    </header>
    <div class="wrap layout">
      <%== sidebar %>
      <main class="content">
        <nav class="crumbs"><a href="<%== home %>index.html"><%= label %></a> <span class="sep">/</span> <span><%= title %></span></nav>
        <article class="prose">
          <%== body %>
        </article>
      </main>
    </div>
    <footer class="foot">
      <div class="wrap">Generated by kex docgen at <%= generatedAt %> · <a href="<%== root %>llms.txt">llms.txt</a> · <a href="<%== root %>search.json">search.json</a><%== markdownLink %></div>
    </footer>
  </body>
</html>
