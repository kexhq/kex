# The +tey docs build+ driver. It scans and extracts the sources into a
# +PackageModel+, then writes everything derived from it: model.json,
# search.json, the Markdown pages, and either the HTML site (with its
# manifests, versions.json, llms.txt, llms-full.txt, robots.txt and
# sitemap.xml) or, with +--format fragments+, HTML fragments for a host site.

module Tey.Docgen.Index do
  using Tey.Docgen.Model, only: [PackageModel, SourcePage, VersionEntry, LinkEntry, kindOf, nameOf, lineOf]

  foul buildCommand(parsed: ParsedOptions) -> Integer do
    let out = optString(parsed.values.get("out"))
    if out.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --out is required")
      return 1
    end
    # What docgen documents is a NAMED, VERSIONED unit. A package.kex in the
    # CWD answers both, which is why `tey docs build --out <site>` inside a
    # package needs nothing else. Nothing here guesses beyond that: a source
    # tree that is not a package — the compiler's own src/stdlib is the
    # standing example — says who it is with --package and --release, and a
    # missing answer is an error rather than a default that files the output
    # under the wrong name.
    let source = defaultSource(optString(parsed.values.get("source")))
    let pkg = defaultPackage(optString(parsed.values.get("package")))
    let version = defaultVersion(optString(parsed.values.get("release")))
    if pkg.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --package is required (no package.kex in ${FS.Directory.current} to take a name from)")
      return 1
    end
    if version.empty?
      IO.printError("${Console.RED}error:${Console.RESET} --release is required (no package.kex in ${FS.Directory.current} to take a version from)")
      return 1
    end
    let files = Tey.Docgen.Scan.sourceFiles(source)
    if files.empty?
      IO.printError("${Console.RED}error:${Console.RESET} no .kex files found in ${source}")
      return 1
    end
    let versionDir = FS.Path.join(FS.Path.join(out, pkg), version)
    let _ = FS.Directory.create(versionDir)
    IO.printLine("${Console.BOLD}Documenting${Console.RESET} ${files.count} file(s) ${Console.DIM}into ${versionDir}${Console.RESET}")
    let pages = Tey.Docgen.Relations.withTraitSignatures(buildPages(files, source))
    if pages.empty?
      IO.printError("${Console.RED}error:${Console.RESET} no files parsed successfully")
      return 1
    end
    let (preludeFile, preludeNames, preludeText) = preludeInfo(source)
    let (typeFacts, traitFacts) = Tey.Docgen.Relations.build(pages)
    let model = PackageModel {
      package: pkg,
      version: version,
      label: optString(parsed.values.get("label")),
      baseUrl: optString(parsed.values.get("base-url")),
      generatedAt: DateTime.now().iso,
      pages: pages,
      modules: Tey.Docgen.Nav.buildModules(pages),
      # This unit's own names first: `resolve` takes the first hit, so a
      # name defined here never links away to another unit.
      links: Tey.Docgen.Nav.withTypeHomes(Tey.Docgen.Nav.buildLinks(pages), typeFacts) + externalLinks(optString(parsed.values.get("link-model"))),
      preludeModules: preludeNames,
      preludeSource: preludeFile,
      preludeDoc: preludeText,
      types: typeFacts,
      traits: traitFacts
    }
    reportDocDrift(pages)
    let _ = FS.File.write(FS.Path.join(out, "model.json"), Tey.Docgen.Json.modelJson(model))
    let _ = FS.File.write(FS.Path.join(out, "search.json"), Tey.Docgen.Json.searchJson(model))
    # Per-version copies: the root files describe the last build, these stay
    # true for their own version directory no matter what builds afterwards.
    let _ = FS.File.write(FS.Path.join(versionDir, "model.json"), Tey.Docgen.Json.modelJson(model))
    let _ = FS.File.write(FS.Path.join(versionDir, "search.json"), Tey.Docgen.Json.searchJson(model))
    let written = writePages(pages, versionDir, model)
    let format = optString(parsed.values.get("format"))
    if format == "fragments"
      let fragments = Tey.Docgen.Fragments.write(pages, versionDir, model)
      writeUnitIndexFiles(pages, model, out)
      IO.printLine("${Console.GREEN}Wrote${Console.RESET} ${fragments} fragment(s), ${written} Markdown page(s), nav.json")
      return 0
    end
    if format != "site" && !format.empty?
      IO.printError("${Console.RED}error:${Console.RESET} unknown --format ${format} (site or fragments)")
      return 1
    end
    writeHtml(pages, versionDir, out, model)
    writeIndexFiles(pages, model, out)
    IO.printLine("${Console.GREEN}Wrote${Console.RESET} ${written} page(s), model.json and search.json")
    return 0
  end

  # Returns the names documented by other units, read from the comma-separated
  # model.json files in +paths+, so this unit's signatures and prose can link
  # to them.
  #
  # The Tey reference uses this to link +String+ and +FS.Path+ to the standard
  # library. Each model.json names its package and version, and its pages are
  # linked at ../../<package>/<version>/ from this unit's version directory. A
  # file that cannot be read or is not JSON is reported as a warning and
  # skipped.
  foul externalLinks(paths: String) -> [LinkEntry] do
    return paths.split(",").map { |p| p.trim }.reject { |p| p.empty? }.into { |path|
      match FS.File.read(path) do
        Error(_) => do
          IO.printError("${Console.YELLOW}warning:${Console.RESET} cannot read --link-model ${path}; skipped")
          []
        end
        Ok(text) => match JSON.parse(text) do
          Error(_) => do
            IO.printError("${Console.YELLOW}warning:${Console.RESET} --link-model ${path} is not JSON; skipped")
            []
          end
          Ok(document) => do
            let root = JSON.fields(document)
            let prefix = "../../${jsonText(root["package"])}/${jsonText(root["version"])}/"
            match root["links"] do
              Just(list) => JSON.items(list).map(~JSON.fields).map { |l| LinkEntry {
                name: jsonText(l["name"]),
                urlPath: prefix + jsonText(l["urlPath"]),
                anchor: jsonText(l["anchor"]),
                kind: jsonText(l["kind"])
              } }
              None => []
            end
          end
        end
      end
    }
  end

  # Writes this unit's version manifest and the shared versions.json, but none
  # of the site-wide files (landing pages, llms.txt, sitemap), which belong to
  # the host site that embeds the fragments.
  foul writeUnitIndexFiles(pages: [SourcePage], model: PackageModel, out: String) -> () do
    let versions = accumulateVersions(out, model)
    let versionDir = FS.Path.join(FS.Path.join(out, model.package), model.version)
    let _ = FS.File.write(FS.Path.join(versionDir, "manifest.json"), versionManifestJson(pages, model))
    let _ = FS.File.write(FS.Path.join(out, "versions.json"), versionsJson(versions))
    return ()
  end

  # Prints a note for each +@return+ tag whose type differs from the
  # signature's, such as +min : X?+ documented as returning +Number?+.
  #
  # The page shows the signature's type either way; the note says which
  # comment has fallen behind its code.
  foul reportDocDrift(pages: [SourcePage]) -> () do
    let drifts = pages.into { |page|
      Tey.Docgen.Relations.allFunctions(page.entities).into { |f|
        let documented = match f.doc.returns do
          Just(r) => r.typeName
          None => ""
        end
        let same = normalizeType(documented) == normalizeType(f.returnType)
        (documented.empty? || f.returnType.empty? || same) then [] else ["  ${Console.CYAN}note:${Console.RESET} ${page.source}:${f.line} ${f.name}: @return [${documented}] but the signature returns ${f.returnType}"]
      }
    }
    drifts.each { |line| IO.printError(line) }
    IO.printLine("${Console.YELLOW}warning:${Console.RESET} ${drifts.count} @return tag(s) disagree with their signature") if !drifts.empty?
    return ()
  end

  let normalizeType(text: String) -> String do
    return text.replace(" ", "")
  end

  let optString(value: String?) -> String do
    return value.or("")
  end

  # Returns the prelude of the source tree at +source+: the file name, the
  # modules it makes visible, and its opening comment.
  #
  # A +prelude.kex+ is an opening comment followed by one bare
  # +using <Module>+ per line, so reading the lines is enough. Without one the
  # result is +("", [], "")+ and the output never mentions a prelude.
  foul preludeInfo(source: String) -> (String, [String], String) do
    match FS.File.readLines(FS.Path.join(source, "prelude.kex")) do
      Error(_) => ("", [], "")
      Ok(lines) => do
        let names = lines.map { |line| usingName(line.trim) }.reject { |name| name.empty? }
        return ("prelude.kex", names, leadingComment(lines))
      end
    end
  end

  # Returns the comment lines at the top of +lines+ with their +#+ markers
  # removed, ready for the same parse as any other doc comment.
  let leadingComment(lines: [String]) -> String do
    return lines.takeWhile { |line| line.startsWith?("#") }.map { |line| commentBody(line) }.join("\n")
  end

  let commentBody(line: String) -> String do
    return line.drop(2) if line.startsWith?("# ")
    return line.drop(1)
  end

  # Returns the file's opening comment when a blank line follows it, and +""+
  # otherwise.
  #
  # A comment that runs straight into a declaration is that declaration's doc,
  # and the page gets no introduction. A +#!+ line does not count as a
  # comment.
  let fileHeader(lines: [String]) -> String do
    let comment = lines.takeWhile { |line| line.trim.startsWith?("#") && !line.startsWith?("#!") }
    return "" if comment.empty?
    let after = lines.drop(comment.count).first.or("x")
    return "" if !after.trim.empty?
    return comment.map { |line| commentBody(line.trim) }.join("\n")
  end

  # Returns the module a +using+ line names (+"using List"+ gives +"List"+),
  # or +""+ for any other line.
  let usingName(line: String) -> String do
    return "" if !line.startsWith?("using ")
    return line.drop(6).split(",").first.or("").trim
  end

  # Returns +given+ when it is not empty, else +"src"+ when the current
  # directory has one, else +""+, which the scan reports as having no .kex
  # files.
  foul defaultSource(given: String) -> String do
    return given if !given.empty?
    return "src" if FS.File.directory?("src")
    return ""
  end

  # Returns +given+ when it is not empty, else the name in the current
  # directory's package.kex, else +""+.
  #
  # With +""+, +buildCommand+ stops with an error and asks for +--package+;
  # it does not invent a name (kexhq/kex#287).
  foul defaultPackage(given: String) -> String do
    return given if !given.empty?
    match manifestVersion() do
      Just(pair) => do
        let (name, _) = pair
        return name
      end
      None => ""
    end
  end

  # Returns +given+ when it is not empty, else the version in the current
  # directory's package.kex, else +""+.
  #
  # Outside a package the caller must pass +--release+: what a version means
  # differs between units, such as a library's releases and the standard
  # library's Kex releases.
  foul defaultVersion(given: String) -> String do
    return given if !given.empty?
    match manifestVersion() do
      Just(pair) => do
        let (_, version) = pair
        return version
      end
      None => ""
    end
  end

  # Returns the name and version from the current directory's package.kex,
  # or +None+ when there is none or it does not parse.
  foul manifestVersion() -> (String, String)? do
    match FS.File.read("package.kex") do
      Error(_) => None
      Ok(text) => match Tey.Manifest.read(text) do
        Ok(package) => Just((package.name, package.version))
        Error(_) => None
      end
    end
  end

  foul buildPages(files: [String], sourceDir: String) -> [SourcePage] do
    return buildPagesLoop(files, sourceDir, [])
  end

  foul buildPagesLoop(files: [String], sourceDir: String, pages: [SourcePage]) -> [SourcePage] do
    if files.empty?
      return pages
    end
    let fileName = files.first.or("")
    let rest = files.drop(1)
    let fullPath = FS.Path.join(sourceDir, fileName)
    match Kex.AST.parseFile(fullPath) do
      Ok(Kex.AST.Program { items }) => do
        let header = fileHeader(FS.File.readLines(fullPath).or([]))
        let page = Tey.Docgen.Extract.pageFor(fileName, items, header)
        IO.printLine("  ${Console.GREEN}ok${Console.RESET} ${fileName} ${Console.DIM}(${page.entities.count} entities)${Console.RESET}")
        return buildPagesLoop(rest, sourceDir, pages + [page])
      end
      Error(Kex.AST.ParseError { message: msg }) => do
        IO.printError("  ${Console.RED}fail${Console.RESET} ${fileName}: ${msg}")
        return buildPagesLoop(rest, sourceDir, pages)
      end
    end
  end

  foul writePages(pages: [SourcePage], versionDir: String, model: PackageModel) -> Integer do
    let count = pages.reduce(0, { |n, page|
      let outPath = FS.Path.join(versionDir, page.urlPath + ".md")
      ensureDirectory(FS.Path.join(versionDir, dirNameOf(page.urlPath)))
      let _ = FS.File.write(outPath, Tey.Docgen.Markdown.pageMarkdown(page, model))
      n + 1
    })
    return count
  end

  # Writes the HTML site for one version: a page per source file, the
  # version's index.html and search.html, and the shared assets/style.css and
  # assets/site.js.
  foul writeHtml(pages: [SourcePage], versionDir: String, out: String, model: PackageModel) -> () do
    let _ = pages.reduce(0, { |n, page|
      let outPath = FS.Path.join(versionDir, page.urlPath + ".html")
      ensureDirectory(FS.Path.join(versionDir, dirNameOf(page.urlPath)))
      let _ = FS.File.write(outPath, Tey.Docgen.Html.pageHtml(page, model))
      n + 1
    })
    let _ = FS.File.write(FS.Path.join(versionDir, "index.html"), Tey.Docgen.Html.versionIndexHtml(model))
    let _ = FS.File.write(FS.Path.join(versionDir, "search.html"), Tey.Docgen.Html.searchPageHtml(model))
    ensureDirectory(FS.Path.join(out, "assets"))
    let _ = FS.File.write(FS.Path.join(out, "assets/style.css"), Tey.Docgen.Css.siteCss())
    let _ = FS.File.write(FS.Path.join(out, "assets/site.js"), Tey.Docgen.Assets.siteJs())
    IO.printLine("${Console.GREEN}Wrote${Console.RESET} HTML pages and assets/style.css")
    return ()
  end

  # Returns the directory part of a page's URL path: +"kex/ast"+ gives
  # +"kex"+, and +"fs"+ gives +""+.
  let dirNameOf(urlPath: String) -> String do
    let parts = urlPath.split("/")
    if parts.count <= 1
      return ""
    end
    return parts.take(parts.count - 1).join("/")
  end

  foul ensureDirectory(path: String) -> () do
    return () if path.empty?
    let _ = FS.Directory.create(path)
    return ()
  end

  foul writeIndexFiles(pages: [SourcePage], model: PackageModel, out: String) -> () do
    let versions = accumulateVersions(out, model)
    let _ = FS.File.write(FS.Path.join(out, "manifest.json"), manifestJson(pages))
    # The same listing, but inside the version's own directory and carrying
    # the identity the root copy cannot: the root manifest describes only
    # whichever build ran last, so anything assembling a whole site out of
    # several units reads these instead.
    let versionDir = FS.Path.join(FS.Path.join(out, model.package), model.version)
    ensureDirectory(versionDir)
    let _ = FS.File.write(FS.Path.join(versionDir, "manifest.json"),
                          versionManifestJson(pages, model))
    let _ = FS.File.write(FS.Path.join(out, "versions.json"), versionsJson(versions))
    # The browsing spine: the site root lists packages, each package's
    # directory lists its versions. What a version IS differs per package —
    # a library's own releases, the stdlib's Kex releases — but the shape
    # (package → versions → pages) is the same, so the pages are too.
    let _ = FS.File.write(FS.Path.join(out, "index.html"), Tey.Docgen.Html.rootIndexHtml(versions))
    let packageDir = FS.Path.join(out, model.package)
    ensureDirectory(packageDir)
    let _ = FS.File.write(FS.Path.join(packageDir, "index.html"),
                          Tey.Docgen.Html.packageRedirectHtml(model.package, versions))
    let _ = FS.File.write(FS.Path.join(packageDir, "versions.html"),
                          Tey.Docgen.Html.packageVersionsHtml(model.package, versions))
    let _ = FS.File.write(FS.Path.join(out, "llms.txt"), llmsTxt(pages, model))
    let _ = FS.File.write(FS.Path.join(out, "llms-full.txt"), llmsFullTxt(pages, model))
    let _ = FS.File.write(FS.Path.join(out, "robots.txt"), robotsTxt(model.baseUrl))
    let _ = FS.File.write(FS.Path.join(out, "sitemap.xml"), sitemapXml(pages, model))
    IO.printLine("${Console.GREEN}Wrote${Console.RESET} index files")
    return ()
  end

  # Returns the manifest.json for one version: its package, version, label,
  # build time and pages.
  #
  # Page paths are relative to the version directory, +<package>/<version>/+;
  # whoever assembles the site adds the site root.
  let versionManifestJson(pages: [SourcePage], model: PackageModel) -> String do
    return JSON.stringify({
      package: model.package,
      version: model.version,
      label: labelOrPackage(model),
      generatedAt: model.generatedAt,
      pages: pages.map { |p| { path: p.urlPath, title: p.title, source: p.source } }
    })
  end

  let manifestJson(pages: [SourcePage]) -> String do
    return JSON.stringify(pages.map { |p|
      {
        path: p.urlPath,
        title: p.title,
        source: p.source,
        entities: p.entities.map { |e| { kind: kindOf(e), name: nameOf(e), line: lineOf(e) } }
      }
    })
  end

  # Returns the versions.json entries with this build's added.
  #
  # The output directory is the published site, so other builds' versions are
  # kept: the existing entries are read, this package and version replaces
  # any earlier entry for it, and this build comes first.
  foul accumulateVersions(out: String, model: PackageModel) -> [VersionEntry] do
    let current = VersionEntry {
      id: model.version,
      label: labelOrPackage(model),
      generatedAt: model.generatedAt,
      package: model.package
    }
    return upsertVersion(current, readVersionEntries(out))
  end

  # Returns +existing+ with any entry for the same package and version
  # removed and +current+ put first.
  let upsertVersion(current: VersionEntry, existing: [VersionEntry]) -> [VersionEntry] do
    let kept = existing.filter { |e|
      !(e.package == current.package && e.id == current.id)
    }
    return [current] + kept
  end

  foul readVersionEntries(out: String) -> [VersionEntry] do
    match FS.File.read(FS.Path.join(out, "versions.json")) do
      Error(_) => []
      Ok(text) => do
        match JSON.parse(text) do
          Error(_) => []
          Ok(root) => do
            match JSON.fields(root)["versions"] do
              Just(list) => JSON.items(list).map { |v| parseVersionEntry(v) }
              None => []
            end
          end
        end
      end
    end
  end

  let parseVersionEntry(value: Any) -> VersionEntry do
    let v = JSON.fields(value)
    return VersionEntry {
      id: jsonText(v["id"]),
      label: jsonText(v["label"]),
      generatedAt: jsonText(v["generatedAt"]),
      package: jsonText(v["package"])
    }
  end

  let jsonText(value: Any?) -> String do
    match value do
      Just(v) => "${v}"
      None => ""
    end
  end

  let labelOrPackage(model: PackageModel) -> String do
    if model.label.empty?
      return model.package
    end
    return model.label
  end

  let versionsJson(entries: [VersionEntry]) -> String do
    return JSON.stringify({ versions: entries.map { |e| versionEntryValue(e) } })
  end

  let versionEntryValue(e: VersionEntry) -> Any do
    let value: Any = { id: e.id, label: e.label, generatedAt: e.generatedAt, package: e.package }
    return value
  end

  let llmsTxt(pages: [SourcePage], model: PackageModel) -> String do
    let label = if model.label.empty? then model.package else model.label end
    let root = normalizeBaseUrl(model.baseUrl)
    let home = "${root}/${model.package}/${model.version}"
    let header = [
      "# ${label} ${model.version}",
      "",
      "Generated by kex docgen at ${model.generatedAt}.",
      "",
      "How to read this with an LLM: start with the Guide, then the Standard",
      "Library tour, then this reference. Every page below also exists as raw",
      "Markdown — the same address with `.html` swapped for `.md` — and the",
      "whole corpus concatenated is `llms-full.txt`. Machine indexes sit",
      "beside this file: `model.json` (the full typed model) and `search.json`",
      "(a flat name index). A version ending in `-dev` is an unreleased",
      "snapshot; plain numbers are releases.",
      "",
      "## Pages",
      ""
    ].join("\n")
    let links = pages.map { |p| "- [${p.title}](${home}/${p.urlPath}.html)" }.join("\n")
    return header + links + "\n"
  end

  let llmsFullTxt(pages: [SourcePage], model: PackageModel) -> String do
    let texts = pages.map { |p| Tey.Docgen.Markdown.pageMarkdown(p, model) }
    return texts.join("\n\n---\n\n") + "\n"
  end

  let robotsTxt(baseUrl: String) -> String do
    if baseUrl.empty?
      return "User-agent: *\nAllow: /\n"
    end
    return "User-agent: *\nAllow: /\nSitemap: ${normalizeBaseUrl(baseUrl)}/sitemap.xml\n"
  end

  let sitemapXml(pages: [SourcePage], model: PackageModel) -> String do
    let root = normalizeBaseUrl(model.baseUrl)
    let urls = pages.map { |p|
      "  <url>\n    <loc>${root}/${p.urlPath}</loc>\n    <lastmod>${model.generatedAt}</lastmod>\n  </url>"
    }.join("\n")
    return [
      "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n",
      "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n",
      urls,
      "\n</urlset>\n"
    ].join("")
  end

  let normalizeBaseUrl(url: String) -> String do
    if url.endsWith?("/")
      return url.take(url.count - 1)
    end
    return url
  end
end
