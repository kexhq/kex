# Model records → Markdown pages (LLM-friendly: stable headings, fenced
# kex signatures, frontmatter with the entity index).

module Tey.Docgen.Markdown do
  using Tey.Docgen.Model, only: [Entity, TypeEntry, RecordEntry, TraitEntry, MakeEntry, ModuleEntry, FunctionEntry, ConstantEntry, Doc, Return, Example, SourcePage, PackageModel, kindOf, nameOf]

  foul pageMarkdown(page: SourcePage, model: PackageModel) -> String do
    let frontmatter = pageFrontmatter(page, model)
    let body = pageBody(page, model)
    return frontmatter + "\n\n" + body
  end

  foul pageFrontmatter(page: SourcePage, model: PackageModel) -> String do
    let entityLines = page.entities.map { |e| entityFrontmatterLine(e) }.join("\n")
    return [
      "---",
      "package: ${model.package}",
      "version: \"${model.version}\"",
      "source: ${page.source}",
      "title: ${page.title}",
      "entities:",
      entityLines,
      "---"
    ].join("\n")
  end

  foul entityFrontmatterLine(e: Entity) -> String do
    let name = nameOf(e)
    return "  - { kind: ${kindOf(e)}, name: \"${name}\" }"
  end

  foul pageBody(page: SourcePage, model: PackageModel) -> String do
    let sections = page.entities.map { |e| entitySection(e, page, model) }.join("\n\n")
    return "# ${page.title}\n\n${sections}\n"
  end

  # ── Entity sections ──────────────────────────────────────────────────────

  foul entitySection(e: Entity, page: SourcePage, model: PackageModel) -> String do
    match e do
      TypeDecl(entry) => typeSection(entry, page, model)
      RecordDecl(entry) => recordSection(entry, page, model)
      TraitDecl(entry) => Tey.Docgen.Markdown.traitSection(entry)
      MakeDecl(entry) => makeSection(entry, page, model)
      ModuleDecl(entry) => moduleSection(entry, page, model)
      FuncDecl(entry) => Tey.Docgen.Markdown.functionSection(entry)
      ConstDecl(entry) => constantSection(entry)
    end
  end

  # Cross-links in Markdown resolve against the same package index the HTML
  # renderer uses — one resolution rule, two renderings. Targets are the .md
  # siblings of this page.
  foul linkMd(model: PackageModel, fromPath: String, name: String) -> String do
    match Tey.Docgen.Nav.resolve(model.links, name) do
      Just(entry) => do
        if fromPath == entry.urlPath
          return "[${name}](#${entry.anchor})"
        end
        let prefix = Tey.Docgen.Nav.upsToVersionDir(fromPath)
        return "[${name}](${prefix}${entry.urlPath}.md#${entry.anchor})"
      end
      None => name
    end
  end

  foul linkTypeMd(model: PackageModel, fromPath: String, text: String) -> String do
    return Tey.Docgen.Nav.segmentsOf(text).map { |seg|
      if seg != "" && Tey.Docgen.Nav.isIdentChar?(seg.take(1))
        linkMd(model, fromPath, seg)
      else
        seg
      end
    }.join("")
  end

  foul typeSection(e: TypeEntry, page: SourcePage, model: PackageModel) -> String do
    let params = typeParamSuffix(e.typeParams)
    let parents = if e.parents.empty?
      ""
    else
      " : " + e.parents.map { |p| linkTypeMd(model, page.urlPath, p) }.join(", ")
    end
    let variantLines = match e.variants do
      Just(vs) => do
        let bullets = vs.map { |v| variantBullet(v.name, v.fields) }.join("\n")
        "\n\n**Variants**\n\n${bullets}"
      end
      None => ""
    end
    return "## type \`${e.name}${params}\`${parents}\n\n${docBlock(e.doc)}${variantLines}"
  end

  foul variantBullet(name: String, fields: [String]) -> String do
    if name.empty?
      return "  - _(abstract)_"
    end
    if fields.empty?
      return "  - \`${name}\`"
    end
    return "  - \`${name}(${fields.join(", ")})\`"
  end

  foul recordSection(e: RecordEntry, page: SourcePage, model: PackageModel) -> String do
    let params = typeParamSuffix(e.typeParams)
    let bullets = e.fields.map { |f|
      let typeName = linkTypeMd(model, page.urlPath, f.typeName)
      let suffix = if f.hasDefault then " (optional)" else "" end
      "  - \`${f.name}\` : ${typeName}${suffix}"
    }.join("\n")
    return "## record \`${e.name}${params}\`\n\n${docBlock(e.doc)}**Fields**\n\n${bullets}"
  end

  foul traitSection(e: TraitEntry) -> String do
    let params = typeParamSuffix(e.typeParams)
    let details = renderFunctions(e.functions)
    return "## trait \`${e.name}${params}\`\n\n${docBlock(e.doc)}${details}"
  end

  foul makeSection(e: MakeEntry, page: SourcePage, model: PackageModel) -> String do
    let impls = if e.implements.empty?
      ""
    else
      " implements " + e.implements.map { |i| linkTypeMd(model, page.urlPath, i) }.join(", ")
    end
    let details = renderFunctions(e.functions)
    return "## make \`${e.target}\`${impls}\n\n${docBlock(e.doc)}${details}"
  end

  foul moduleSection(e: ModuleEntry, page: SourcePage, model: PackageModel) -> String do
    let details = e.children.map { |c| entitySection(c, page, model) }.join("\n\n")
    return "## module \`${e.qualifiedName}\`\n\n${docBlock(e.doc)}${details}"
  end

  foul functionSection(e: FunctionEntry) -> String do
    return "## function \`${e.name}\`\n\n${docBlock(e.doc)}${signatureBlock(e)}"
  end

  foul signatureBlock(f: FunctionEntry) -> String do
    if f.signatures.empty?
      return ""
    end
    return "\n```kex\n${f.signatures.join("\n")}\n```\n"
  end

  foul constantSection(e: ConstantEntry) -> String do
    return "## constant \`${e.name}\`\n\n${docBlock(e.doc)}"
  end

  # ── Function details (inside traits, makes, modules) ────────────────────

  foul renderFunctions(functions: [FunctionEntry]) -> String do
    if functions.empty?
      return ""
    end
    let sections = functions.map { |f| functionBlock(f) }
    return "\n" + sections.join("\n\n")
  end

  foul functionBlock(f: FunctionEntry) -> String do
    let parts = ["#### \`${f.name}\`"]
    let withSummary = if f.doc.summary.empty?
      parts
    else
      parts + ["", f.doc.summary]
    end
    let withSigs = signatureParts(withSummary, f)
    let withReturns = returnParts(withSigs, f.doc)
    let withExamples = exampleParts(withReturns, f.doc)
    return withExamples.join("\n")
  end

  foul signatureParts(parts: [String], f: FunctionEntry) -> [String] do
    if f.signatures.empty?
      return parts
    end
    return parts + ["", "```kex"] + f.signatures + ["```"]
  end

  foul returnParts(parts: [String], doc: Doc) -> [String] do
    match doc.returns do
      Just(r) => do
        let line = returnLine(r)
        if line.empty?
          return parts
        end
        return parts + ["", "**Returns**: ${line}"]
      end
      None => parts
    end
  end

  foul returnLine(r: Return) -> String do
    if r.typeName.empty?
      return r.description
    end
    if r.description.empty?
      return "\`${r.typeName}\`"
    end
    return "\`${r.typeName}\` — ${r.description}"
  end

  foul exampleParts(parts: [String], doc: Doc) -> [String] do
    if doc.examples.empty?
      return parts
    end
    return parts + ["", "**Examples**", ""] + exampleBlocks(doc.examples)
  end

  foul exampleBlocks(examples: [Example]) -> [String] do
    return examples.map { |ex| exampleBlock(ex) }.flatten
  end

  foul exampleBlock(ex: Example) -> [String] do
    let caption = if ex.caption.empty?
      []
    else
      ["_${ex.caption}_", ""]
    end
    return caption + ["```kex", ex.code, "```"]
  end

  # ── Shared fragments ─────────────────────────────────────────────────────

  foul docBlock(doc: Doc) -> String do
    if doc.summary.empty?
      return ""
    end
    return doc.summary + "\n\n"
  end

  foul typeParamSuffix(typeParams: [String]) -> String do
    if typeParams.empty?
      return ""
    end
    return "<" + typeParams.join(", ") + ">"
  end
end
