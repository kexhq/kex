# The docs site's script, which adds the version switcher and search.
#
# Pages work without it: the version badge stays a plain badge and there is
# no search box. Each page names its package and version in +data-+
# attributes, so one script serves every version.
#
# The script is assets/site.js, embedded at compile time.

module Tey.Docgen.Assets do
  let siteJs() -> String do
    return Kex.embed("assets/site.js")
  end
end
