# Navigation and cross-linking: the two indexes every renderer uses, built
# once from the extracted pages.
#
#   modules: one ModuleIndexEntry per module, for the sidebar
#   links:   one LinkEntry per linkable name
#
# Building them in one place means the HTML, the Markdown and model.json
# always agree on where a name links to.

module Tey.Docgen.Nav do
  using Tey.Docgen.Model, only: [Entity, TypeDecl, RecordDecl, TraitDecl, MakeDecl, ModuleDecl, FuncDecl, ConstDecl, ModuleEntry, SourcePage, ModuleIndexEntry, MemberEntry, LinkEntry, kindOf, nameOf, anchorOf]

  # Returns an entry for every module in the package, in declaration order,
  # with the page it is on. Nested modules get entries of their own.
  let buildModules(pages: [SourcePage]) -> [ModuleIndexEntry] do
    return pages.into { |p| modulesOnPage(p.entities, p.urlPath) }
  end

  let modulesOnPage(entities: [Entity], urlPath: String) -> [ModuleIndexEntry] do
    return entities.into { |e|
      match e do
        ModuleDecl(entry) => [moduleEntry(entry, urlPath)] + modulesOnPage(entry.children, urlPath)
        _ => []
      end
    }
  end

  let moduleEntry(entry: ModuleEntry, urlPath: String) -> ModuleIndexEntry do
    return ModuleIndexEntry {
      qualifiedName: entry.qualifiedName,
      summary: firstLine(entry.doc.summary),
      urlPath: urlPath,
      members: entry.children.map { |c| MemberEntry { name: nameOf(c), anchor: anchorOf(c) } }
    }
  end

  let firstLine(summary: String) -> String do
    return summary.split("\n").first.or("")
  end

  # Returns the title of the page that +page+ nests under, or +None+ for a
  # top-level page.
  #
  # The parent is found from titles, not paths: "Net.DNS" nests under "Net",
  # and "Net.HTTP.WebSocket" under "Net.HTTP". The longest prefix that has a
  # page wins. When no prefix has a page ("Control" for "Control.Retry"), the
  # page is top-level.
  let parentTitleOf(pages: [SourcePage], page: SourcePage) -> String? do
    return parentLoop(page.title.split("."), pages, page)
  end

  let parentLoop(parts: [String], pages: [SourcePage], page: SourcePage) -> String? do
    return None if parts.count <= 1
    let candidate = parts.take(parts.count - 1).join(".")
    if claimedByAnother?(pages, page, candidate)
      return Just(candidate)
    end
    return parentLoop(parts.take(parts.count - 1), pages, page)
  end

  let claimedByAnother?(pages: [SourcePage], page: SourcePage, title: String) -> Bool do
    return pages.any? { |p| p.title == title && p.urlPath != page.urlPath }
  end

  # Returns the pages with no parent, sorted by title, for the sidebar's top
  # level.
  let topLevelPages(pages: [SourcePage]) -> [SourcePage] do
    return sortedByTitle(pages.filter { |p| parentTitleOf(pages, p) == None })
  end

  # Returns the pages nested directly under +title+, sorted by title.
  let childPages(pages: [SourcePage], title: String) -> [SourcePage] do
    return sortedByTitle(pages.filter { |p| parentTitleOf(pages, p) == Just(title) })
  end

  # Returns every page nested under +page+ at any depth, sorted by title. A
  # module page lists these as its submodules.
  let descendantPages(pages: [SourcePage], page: SourcePage) -> [SourcePage] do
    return sortedByTitle(pages.filter { |p|
      p.urlPath != page.urlPath && p.title.startsWith?(page.title + ".")
    })
  end

  let sortedByTitle(pages: [SourcePage]) -> [SourcePage] do
    return pages.sort { |a, b| a.title.lowerCase < b.title.lowerCase }
  end

  # Returns the names that can be linked, each with its page and anchor.
  #
  # A name links only while exactly one place answers to it. A qualified name
  # ("FS.Path") is usually unique; a simple one ("Path") stops linking as soon
  # as two different entities share it, and then only the qualified names
  # link.
  let buildLinks(pages: [SourcePage]) -> [LinkEntry] do
    let entries = pages.into { |p| linkEntriesOnPage(p.entities, p.urlPath) }
    return entries.filter { |e| uniqueTarget?(entries, e) }
  end

  # Returns +links+ plus a link to the home page of each type that make
  # blocks extend and that does not link yet.
  #
  # A name such as +Integer+ is claimed by a module and by several make
  # blocks, so +buildLinks+ drops it. In a signature it means the type, which
  # has a home page (+Relations.homePathOf+), so this adds that link. A name
  # that already links keeps its link.
  let withTypeHomes(links: [LinkEntry], types: [Tey.Docgen.Model.TypeFacts]) -> [LinkEntry] do
    let homes = types.filter { |t| !t.homePath.empty? && resolve(links, t.name) == None }.map { |t|
      LinkEntry { name: t.name, urlPath: t.homePath, anchor: t.homeAnchor, kind: "type" }
    }
    return links + homes
  end

  let linkEntriesOnPage(entities: [Entity], urlPath: String) -> [LinkEntry] do
    return entities.into { |e|
      let own = linkableNames(e).map { |n|
        LinkEntry { name: n, urlPath: urlPath, anchor: anchorOf(e), kind: kindOf(e) }
      }
      let nested = match e do
        ModuleDecl(entry) => linkEntriesOnPage(entry.children, urlPath)
        TraitDecl(entry) => memberLinks(entry.qualifiedName, entry.qualifiedName, entry.functions, urlPath)
        MakeDecl(entry) => memberLinks(Tey.Docgen.Model.baseTypeOf(entry.target), entry.target, entry.functions, urlPath)
        _ => []
      end
      own + nested
    }
  end

  # Returns links for the functions of a trait or make block under their
  # owner's name, so prose that writes +List.map+ links to that function.
  let memberLinks(ownerName: String, owner: String, functions: [Tey.Docgen.Model.FunctionEntry], urlPath: String) -> [LinkEntry] do
    return functions.map { |f| f.name }.uniq.map { |n|
      LinkEntry { name: "${ownerName}.${n}", urlPath: urlPath, anchor: Tey.Docgen.Model.memberAnchorOf(owner, n), kind: "function" }
    }
  end

  # Returns the names an entity can be linked under: its qualified name and
  # its simple name. Functions have none of their own. A make block links
  # under its target's base name, so "Map<K, V>" links as "Map"; a list
  # target such as "[X]" does not link.
  let linkableNames(e: Entity) -> [String] do
    match e do
      FuncDecl(_) => []
      MakeDecl(entry) => do
        let base = entry.target.split("<").first.or("")
        return [] if base.empty? || base.startsWith?("[")
        return [base.trim]
      end
      _ => do
        let qualified = Tey.Docgen.Model.qualifiedNameOf(e)
        if qualified == nameOf(e)
          return [qualified]
        end
        return [qualified, nameOf(e)]
      end
    end
  end

  # Returns +true+ when every entry with +candidate+'s name points at the
  # same page and anchor.
  let uniqueTarget?(entries: [LinkEntry], candidate: LinkEntry) -> Bool do
    return entries.filter { |e|
      e.name == candidate.name && differentTarget?(e, candidate)
    }.empty?
  end

  let differentTarget?(a: LinkEntry, b: LinkEntry) -> Bool do
    return a.urlPath != b.urlPath || a.anchor != b.anchor
  end

  let resolve(links: [LinkEntry], name: String) -> LinkEntry? do
    return links.find { |l| l.name == name }
  end

  # Splits a type reference into identifiers and the separators between
  # them, so a renderer can link the identifiers: "Map<String, FS.Path>"
  # gives ["Map", "<", "String", ", ", "FS.Path", ">"].
  let segmentsOf(typeText: String) -> [String] do
    return splitLoop(typeText, "", "", [])
  end

  # `ident` is the identifier being read, `sep` the separator run since it;
  # only one is non-empty at a time, and whichever it is goes out in order.
  let splitLoop(rest: String, ident: String, sep: String, out: [String]) -> [String] do
    if rest.empty?
      return flushIdent(ident, flushSep(sep, out))
    end
    let ch = rest.take(1)
    if isIdentChar?(ch)
      return splitLoop(rest.drop(1), ident + ch, "", flushSep(sep, out))
    end
    return splitLoop(rest.drop(1), "", sep + ch, flushIdent(ident, out))
  end

  let flushIdent(ident: String, out: [String]) -> [String] do
    if ident.empty?
      return out
    end
    return out + [ident]
  end

  let flushSep(sep: String, out: [String]) -> [String] do
    if sep.empty?
      return out
    end
    return out + [sep]
  end

  let isIdentChar?(ch: String) -> Bool do
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.".contains?(ch)
  end

  # Returns the relative href from one page of the package to an anchor on
  # another: "#anchor" on the same page, otherwise a path up to the version
  # directory and down to the target.
  let hrefFrom(fromPath: String, toPath: String, anchor: String) -> String do
    if fromPath == toPath
      return "#${anchor}"
    end
    return "${upsToVersionDir(fromPath)}${toPath}.html#${anchor}"
  end

  let upsToVersionDir(urlPath: String) -> String do
    return ups(urlPath.split("/").count - 1)
  end

  let ups(n: Integer) -> String do
    if n <= 0
      return ""
    end
    return "../" + ups(n - 1)
  end
end
