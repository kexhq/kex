# Model records → static HTML pages, styled after kex.run's docs section
# (warm honey/cream palette, Fraunces/Plus Jakarta Sans/JetBrains Mono,
# dark code surface with tok-* syntax classes). The stylesheet lives in
# Tey.Docgen.Css and is written to assets/style.css by the build driver.
#
# HTML is a sibling renderer of the Markdown one: both walk the typed
# PackageModel, so nothing here parses Markdown or JSON.

module Tey.Docgen.Html do
  using Tey.Docgen.Model, only: [Entity, TypeDecl, RecordDecl, TraitDecl, MakeDecl, ModuleDecl, FuncDecl, ConstDecl, TypeEntry, RecordEntry, TraitEntry, MakeEntry, ModuleEntry, FunctionEntry, ConstantEntry, VariantEntry, Doc, SourcePage, PackageModel, VersionEntry, LinkEntry, kindOf, nameOf, anchorOf, memberAnchorOf, ownerSlugOf, baseTypeOf]

  foul pageHtml(page: SourcePage, model: PackageModel) -> String do
    return layout(page.title, page.urlPath, pageBodyHtml(page, model, true), model)
  end

  # A page's content without the chrome — what `pageHtml` wraps in the
  # layout, and what a host site (the fragments output) wraps in its own.
  # `heading` is false when the host renders the title itself.
  foul pageBodyHtml(page: SourcePage, model: PackageModel, heading: Bool) -> String do
    if preludePage?(page, model)
      return preludeBodyHtml(page, model, heading)
    end
    let sections = entitiesHtml(page.entities, page, model)
    let tag = preludeTag(preludePaths(model).contains?(page.urlPath))
    let intro = page.intro.empty? then "" else "<div class=\"intro\">\n${docHtml(Tey.Docgen.Rdoc.parseOrEmpty(page.intro), page, model)}</div>\n"
    let h1 = heading then "<h1>${esc(page.title)}${tag}</h1>\n" else ""
    return "${h1}${intro}${sections}\n${submodulesHtml(page, model)}"
  end

  # A module family spread over several files ("Net" + net/dns.kex,
  # net/http.kex, ...) gets one page per file, and the parent page says
  # nothing about the rest — a reader on "Net" has no reason to believe
  # Net.DNS or Net.Socket are documented at all. This section is the
  # signpost: every descendant page, with the summary its module declares.
  foul submodulesHtml(page: SourcePage, model: PackageModel) -> String do
    let children = Tey.Docgen.Nav.descendantPages(model.pages, page)
    return "" if children.empty?
    let items = children.map { |c| submoduleItem(c, page, model) }.join("\n")
    return "<h2 class=\"group\">Submodules</h2>\n<ul class=\"prelude-list\">\n${items}\n</ul>\n"
  end

  foul submoduleItem(child: SourcePage, page: SourcePage, model: PackageModel) -> String do
    let href = "${Tey.Docgen.Nav.upsToVersionDir(page.urlPath)}${child.urlPath}.html"
    let summary = moduleSummary(model, child.title)
    let note = summary.empty? then "" else " <span class=\"prelude-note\">${inlineCode(summary)}</span>"
    return "<li><code><a class=\"xref\" href=\"${href}\">${esc(child.title)}</a></code>${note}</li>"
  end

  foul preludePage?(page: SourcePage, model: PackageModel) -> Bool do
    return !model.preludeSource.empty? && page.source == model.preludeSource
  end

  # The prelude declares nothing, so the generic page renderer leaves it
  # blank. What it HAS is a list of imports and a comment explaining them —
  # which is exactly the page a reader wants: what am I given for free, and
  # where does each of those live.
  foul preludeBodyHtml(page: SourcePage, model: PackageModel, heading: Bool) -> String do
    let doc = Tey.Docgen.Rdoc.parseOrEmpty(model.preludeDoc)
    let items = model.preludeModules.map { |name| preludeItem(model, page.urlPath, name) }.join("\n")
    return [
      heading then "<h1>${esc(page.title)}</h1>" else "",
      plainDocHtml(doc),
      "<h2 class=\"group\">Modules in the prelude</h2>",
      "<p class=\"group-note\">${model.preludeModules.count} module(s), visible in every file with no import.</p>",
      "<ul class=\"prelude-list\">\n${items}\n</ul>"
    ].join("\n")
  end

  foul preludeItem(model: PackageModel, fromPath: String, name: String) -> String do
    let summary = moduleSummary(model, name)
    let note = summary.empty? then "" else " <span class=\"prelude-note\">${inlineCode(summary)}</span>"
    return "<li><code>${preludeLink(model, fromPath, name)}</code>${note}</li>"
  end

  # A `using X` in prelude.kex names a sibling SOURCE FILE, so the page for
  # that file is the exact target. Going through the link index instead would
  # lose half the list: `Map`, `Set` and `Range` are ambiguous as bare names —
  # a module and a type both claim them — and resolve to nothing.
  #
  # The file is what matches, not the title: `using Test` is test.kex, whose
  # page is titled "Assert", and `using Env` is env.kex, titled "ENV".
  foul preludeLink(model: PackageModel, fromPath: String, name: String) -> String do
    match pageNamed(model, name) do
      Just(page) => do
        let href = "${Tey.Docgen.Nav.upsToVersionDir(fromPath)}${page.urlPath}.html"
        return "<a class=\"xref\" href=\"${href}\">${esc(name)}</a>"
      end
      None => linkType(model.links, fromPath, name)
    end
  end

  foul pageNamed(model: PackageModel, name: String) -> SourcePage? do
    match model.pages.find { |p| p.title == name } do
      Just(page) => Just(page)
      None => model.pages.find { |p| pageStem(p.urlPath) == name.lowerCase }
    end
  end

  foul pageStem(urlPath: String) -> String do
    return (urlPath.split("/").last.or(urlPath)).lowerCase
  end

  foul moduleSummary(model: PackageModel, name: String) -> String do
    match model.modules.find { |m| m.qualifiedName == name } do
      Just(entry) => entry.summary
      None => ""
    end
  end

  # Landing page for <pkg>/<version>/index.html: every module as a card. When
  # the package has a prelude, the cards are split by how a reader REACHES
  # them — visible everywhere, or one `using` away — because that is the first
  # question anyone has about a standard library.
  foul versionIndexHtml(model: PackageModel) -> String do
    return layout(labelOf(model), "", versionIndexBodyHtml(model, true), model)
  end

  foul versionIndexBodyHtml(model: PackageModel, heading: Bool) -> String do
    let label = labelOf(model)
    let top = firstModulesOfPages(model.pages)
    let lede = "<p class=\"lede\">Reference documentation for the <strong>${esc(label)}</strong> package, generated from source at ${esc(model.generatedAt.take(10))}.</p>"
    let h1 = heading then "<h1>${esc(label)} <span class=\"ver\">${esc(model.version)}</span></h1>\n" else ""
    return "${h1}${lede}\n${indexSections(model, top)}"
  end

  # The modules worth a card. `Int8`, `Float32` and friends are modules
  # holding two constants each, declared in number.kex beside Integer and
  # Float: listing them beside `Net` and `FS` made the index read as if the
  # stdlib had a dozen integer libraries. They are on their file's page.
  foul cardModules(model: PackageModel) -> [Tey.Docgen.Model.ModuleIndexEntry] do
    return model.modules.reject { |m|
      let declarations = model.modules.count { |other|
        other.qualifiedName == m.qualifiedName
      }
      constantsOnly?(model, m) || declarations > 1
    }
  end

  foul constantsOnly?(model: PackageModel, m: Tey.Docgen.Model.ModuleIndexEntry) -> Bool do
    return false if m.members.empty?
    match model.pages.find { |p| p.urlPath == m.urlPath } do
      None => false
      Just(page) => page.title != m.qualifiedName && m.members.all? { |mem| mem.anchor.startsWith?("constant-") }
    end
  end

  foul indexSections(model: PackageModel, top: [String]) -> String do
    if model.preludeModules.empty?
      return cardGrid(cardModules(model), top)
    end
    let paths = preludePaths(model)
    let (included, optIn) = cardModules(model).partition { |m| paths.contains?(m.urlPath) }
    return [
      "<h2 class=\"group\">In the prelude</h2>",
      "<p class=\"group-note\">Visible in every file, with no import. ${included.count} module(s).</p>",
      cardGrid(included, top),
      "<h2 class=\"group\">Opt-in</h2>",
      "<p class=\"group-note\">Available after an explicit <code>using</code> — <code>using FS</code> before <code>FS.File.read</code>.</p>",
      cardGrid(optIn, top)
    ].join("\n")
  end

  # The prelude imports FILES, and everything a listed file declares comes
  # with it: `using Time` is what puts `Date`, `Duration` and `Time.Period` in
  # scope, none of which prelude.kex names. So the split is by page, not by
  # module name.
  foul preludePaths(model: PackageModel) -> [String] do
    return model.preludeModules.flatMap { |name| preludePath(model, name) }
  end

  foul preludePath(model: PackageModel, name: String) -> [String] do
    match pageNamed(model, name) do
      Just(page) => [page.urlPath]
      None => []
    end
  end

  foul cardGrid(modules: [Tey.Docgen.Model.ModuleIndexEntry], top: [String]) -> String do
    let cards = modules.map { |m| moduleCard(m, top.contains?(m.qualifiedName)) }.join("\n")
    return "<div class=\"cards\">\n${cards}\n</div>"
  end

  # The version a reader gets by default: the highest release by semantic
  # version, never an unreleased `-dev` build while a release exists.
  # versions.json is in BUILD order, newest build first, and
  # tools/build-docs.sh builds the working tree last, so its first entry is
  # usually the -dev build rather than the latest release.
  foul latestVersion(packageName: String, versions: [VersionEntry]) -> VersionEntry? do
    let mine = versions.filter { |v| v.package == packageName }
    let released = mine.filter { |v| !v.id.endsWith?("-dev") }
    let pool = released.empty? then mine else released
    match Tey.Semver.newestFirst(pool.map { |v| v.id }).first do
      Just(id) => return pool.find { |v| v.id == id }
      None => return None
    end
  end

  # One package's versions, highest first by semantic version.
  foul versionsNewestFirst(packageName: String, versions: [VersionEntry]) -> [VersionEntry] do
    let mine = versions.filter { |v| v.package == packageName }
    return Tey.Semver.newestFirst(mine.map { |v| v.id }).flatMap { |id|
      mine.filter { |v| v.id == id }
    }
  end

  # <pkg>/index.html: straight on to the latest version, so a link to a
  # package lands on its reference rather than on a list of builds. Every
  # other version stays one click away, at versions.html.
  foul packageRedirectHtml(packageName: String, versions: [VersionEntry]) -> String do
    match latestVersion(packageName, versions) do
      None => return packageVersionsHtml(packageName, versions)
      Just(latest) => do
        let render = Template.html(Kex.embed("templates/package_redirect.html.ket"))
        return render(packageName, latest.id, latest.label)
      end
    end
  end

  # <pkg>/versions.html: the versions of one package, newest first — the page
  # a reader lands on when they want a different release of what they are
  # reading. What the ids MEAN is the package's own story: a library's own
  # releases, the stdlib's Kex releases. The page does not need to know.
  foul packageVersionsHtml(packageName: String, versions: [VersionEntry]) -> String do
    let mine = versionsNewestFirst(packageName, versions)
    let cards = mine.map { |v| versionCard(v) }.join("\n")
    let content = Template.html(Kex.embed("templates/package_versions.html.ket"))
    let nav = backLink("../index.html", "all packages")
    let title = "${packageName} versions | kex docs"
    return chrome(title, "../", false, nav, content(packageName, cards))
  end

  foul versionCard(v: VersionEntry) -> String do
    return "<a class=\"card\" href=\"${esc(v.id)}/index.html\"><span class=\"card-title\">${esc(v.label)} ${esc(v.id)}</span><span class=\"card-meta\">generated ${esc(v.generatedAt.take(10))}</span></a>"
  end

  # <pkg>/<version>/search.html: the shareable full-page search. The modal on
  # every page links here with ?q=<term>, so a results page is a URL rather
  # than a state — the page reads the term back from the query string.
  foul searchPageHtml(model: PackageModel) -> String do
    let label = labelOf(model)
    let content = Template.html(Kex.embed("templates/search.html.ket"))
    let version = model.version
    let nav = backLink("index.html", "${label} ${version}")
    let title = "Search | ${label} ${version} | kex docs"
    return chrome(title, "../../", true, nav, content(label, version))
  end

  # Site root index.html: one card per PACKAGE (its newest build), not per
  # build — a reader arrives at "the docs" for a thing, and the thing is a
  # package; its versions are one click down. Built from the accumulated
  # versions.json entries, not just this build's model.
  foul rootIndexHtml(versions: [VersionEntry]) -> String do
    let packages = packageNames(versions)
    let cards = packages.map { |name| packageCard(name, versions) }.join("\n")
    let content = Template.html(Kex.embed("templates/root_index.html.ket"))
    let nav = backLink("https://kex.run/docs", "kex.run ↗")
    return chrome("kex docs", "", false, nav, content(cards))
  end

  # Package names in first-seen order of their newest entry: versions arrive
  # newest-first from accumulateVersions, so the first entry of each package
  # is that package's newest build.
  foul packageNames(versions: [VersionEntry]) -> [String] do
    let names = versions.map { |v| v.package }
    return names.uniq
  end

  foul packageCard(name: String, versions: [VersionEntry]) -> String do
    let count = versions.filter { |v| v.package == name }.count
    return match latestVersion(name, versions) do
      Just(v) => "<a class=\"card\" href=\"${esc(name)}/${esc(v.id)}/index.html\"><span class=\"card-title\">${esc(v.label)}</span><span class=\"card-meta\">${esc(name)} · latest ${esc(v.id)} · ${count} version(s)</span></a>"
      None => ""
    end
  end

  # What every full page shares: the <head>, and the top bar with the brand on
  # the left and `nav` on the right. `root` is the relative path back to the
  # site root, and `script` says whether the page loads assets/site.js.
  foul chrome(title: String, root: String, script: Bool, nav: String, content: String) -> String do
    let render = Template.html(Kex.embed("templates/layout.html.ket"))
    return render(title, root, script, nav, content)
  end

  foul backLink(href: String, text: String) -> String do
    return "<a class=\"back\" href=\"${esc(href)}\">${esc(text)}</a>"
  end

  foul layout(title: String, current: String, bodyContent: String, model: PackageModel) -> String do
    let label = labelOf(model)
    let root = rootPrefix(current)
    let version = model.version
    let nav = Template.html(Kex.embed("templates/page_nav.html.ket"))
    let content = Template.html(Kex.embed("templates/page.html.ket"))
    return chrome(
      "${title} | ${label} ${version} | kex docs",
      root,
      true,
      nav(label, version, model.package, root, pageTarget(current)),
      content(
        title,
        label,
        root,
        versionPrefix(current),
        sidebar(model, current),
        bodyContent,
        model.generatedAt,
        markdownLink(current)
      )
    )
  end

  # The sidebar lists one entry per source FILE, nested by module family:
  # a page whose title is a dotted child of another page's title nests
  # under it ("Net.DNS" under "Net", "Net.HTTP.WebSocket" under
  # "Net.HTTP"), so a multi-file module reads as one branch instead of
  # trailing the list in directory-walk order. The active file expands to
  # its top-level declarations so a reader can jump straight to one. The
  # label is the page's title (the module it declares), not the raw file
  # name.
  # The heading is a link: it is the package's name, and the obvious thing to
  # want from it is the list of what the package contains — which is the
  # version index, where the prelude split lives.
  foul sidebar(model: PackageModel, current: String) -> String do
    let vpre = versionPrefix(current)
    let entries = Tey.Docgen.Nav.topLevelPages(model.pages).map { |p|
      sidebarEntry(p, current, vpre, model.pages)
    }.join("\n")
    let heading = "<p class=\"side-heading\"><a href=\"${vpre}index.html\">${esc(labelOf(model))}</a></p>"
    return "<aside class=\"side\"><nav aria-label=\"Modules\">${heading}<ul class=\"side-list\">\n${entries}\n</ul></nav></aside>"
  end

  foul sidebarEntry(page: SourcePage, current: String, vpre: String, pages: [SourcePage]) -> String do
    let href = "${vpre}${page.urlPath}.html"
    let active = page.urlPath == current
    let klass = active then " class=\"active\"" else ""
    # The active page expands to its own declarations — but only when it HAS
    # any. A prose page declares nothing, and an empty <ul> is not markup
    # worth emitting.
    let entityLinks = if active && !page.entities.empty?
      "<ul class=\"side-sub\">\n" + sectionEntities(page.entities).map { |e| "<li><a href=\"#${anchorOf(e)}\">${esc(nameOf(e))}</a></li>" }.join("\n") + "\n</ul>"
    else
      ""
    end
    let children = Tey.Docgen.Nav.childPages(pages, page.title).map { |c|
      sidebarEntry(c, current, vpre, pages)
    }.join("\n")
    let nest = children.empty? then "" else "<ul class=\"side-nest\">\n${children}\n</ul>"
    return "<li><a${klass} href=\"${href}\">${esc(page.title)}</a>${entityLinks}${nest}</li>"
  end

  # The page's own heading carries it — the sidebar is a list to scan, and a
  # chip on 32 of 41 rows is noise rather than an answer.
  foul preludeTag(inPrelude: Bool) -> String do
    return inPrelude then "<span class=\"tag-prelude\" title=\"In the prelude: no import needed\">prelude</span>" else ""
  end

  # The modules that OPEN a page — their section sits at the very top, so a
  # card for one links to the page itself rather than to an anchor that lands
  # where the page already starts. A page whose first declaration is a type or
  # record has no such module.
  foul firstModulesOfPages(pages: [SourcePage]) -> [String] do
    return pages.flatMap { |p|
      match p.entities.first do
        Just(ModuleDecl(entry)) => [entry.qualifiedName]
        _ => []
      end
    }
  end

  foul moduleCard(m: Tey.Docgen.Model.ModuleIndexEntry, top: Bool) -> String do
    let href = if top
      "${m.urlPath}.html"
    else
      "${m.urlPath}.html#module-${slug(m.qualifiedName)}"
    end
    let summary = if m.summary.empty?
      ""
    else
      "<span class=\"card-meta\">${inlineCode(m.summary)}</span>"
    end
    return "<a class=\"card\" href=\"${href}\"><span class=\"card-title\">${esc(m.qualifiedName)}</span>${summary}</a>"
  end

  # A page's declarations in source order — except that a type's `make`
  # blocks on the same page are pulled into the type's own section, so
  # `List` reads as one thing (the type, then its functions, grouped by the
  # receiver they need) rather than a type followed by three loose "make"
  # sections.
  foul entitiesHtml(entities: [Entity], page: SourcePage, model: PackageModel) -> String do
    let owners = declaredTypeNames(entities) + declaredTraitNames(entities)
    return entities.map { |e|
      match e do
        MakeDecl(entry) => owners.contains?(baseTypeOf(entry.target)) then "" else makeSection(entry, page, model)
        TypeDecl(entry) => typeSection(entry, makesFor(entities, entry.name), page, model)
        RecordDecl(entry) => recordSection(entry, makesFor(entities, entry.name), page, model)
        _ => entitySection(e, page, model)
      end
    }.reject { |html| html.empty? }.join("\n")
  end

  # The declarations that get a section of their own: everything except the
  # make blocks folded into a type or trait on the same page.
  foul sectionEntities(entities: [Entity]) -> [Entity] do
    let owners = declaredTypeNames(entities) + declaredTraitNames(entities)
    return entities.reject { |e|
      match e do
        MakeDecl(entry) => owners.contains?(baseTypeOf(entry.target))
        _ => false
      end
    }
  end

  foul declaredTypeNames(entities: [Entity]) -> [String] do
    return entities.flatMap { |e|
      match e do
        TypeDecl(entry) => [entry.name]
        RecordDecl(entry) => [entry.name]
        _ => []
      end
    }
  end

  # A `make <Trait>` beside its trait is the trait's defaults, rendered in
  # the trait's own section (Relations.traitMethods).
  foul declaredTraitNames(entities: [Entity]) -> [String] do
    return entities.flatMap { |e|
      match e do
        TraitDecl(entry) => [entry.name]
        _ => []
      end
    }
  end

  foul makesFor(entities: [Entity], name: String) -> [MakeEntry] do
    return entities.flatMap { |e|
      match e do
        MakeDecl(entry) => baseTypeOf(entry.target) == name then [entry] else []
        _ => []
      end
    }
  end

  foul entitySection(e: Entity, page: SourcePage, model: PackageModel) -> String do
    match e do
      TypeDecl(entry) => typeSection(entry, [], page, model)
      RecordDecl(entry) => recordSection(entry, [], page, model)
      TraitDecl(entry) => traitSection(entry, page, model)
      MakeDecl(entry) => makeSection(entry, page, model)
      ModuleDecl(entry) => moduleSection(entry, page, model)
      FuncDecl(entry) => functionSection(entry, page, model)
      ConstDecl(entry) => constantSection(entry, page, model)
    end
  end

  # A reference resolver scoped to one page: links resolve against the whole
  # package index, but the href is relative to the page doing the referring.
  foul linker(page: SourcePage, model: PackageModel) -> (String -> String) do
    return { |name| linkType(model.links, page.urlPath, name) }
  end

  # The bare href for a name, or "" — what linked highlighting and linked
  # prose both need.
  foul hrefer(page: SourcePage, model: PackageModel) -> (String -> String) do
    return { |name|
      match Tey.Docgen.Nav.resolve(model.links, name) do
        Just(entry) => Tey.Docgen.Nav.hrefFrom(page.urlPath, entry.urlPath, entry.anchor)
        None => ""
      end
    }
  end

  foul typeSection(e: TypeEntry, makes: [MakeEntry], page: SourcePage, model: PackageModel) -> String do
    let link = Tey.Docgen.Html.linker(page, model)
    let parents = if e.parents.empty?
      ""
    else
      " : " + e.parents.map { |p| "<code>${linkTypeText(link, p)}</code>" }.join(", ")
    end
    let head = "<h2><span class=\"kind kind-type\">type</span> <code>${esc(e.name)}${esc(typeParamSuffix(e.typeParams))}</code>${parents} ${permalinkHtml(anchorOf(TypeDecl(e)))}</h2>"
    let body = "${entityDocHtml(e.doc, page, model)}${variantsHtml(e.variants)}${typeBodyHtml(e.name, makes, page, model)}"
    return "<section class=\"entity\" id=\"${anchorOf(TypeDecl(e))}\">\n${head}\n${body}\n</section>"
  end

  # Only real constructors: an abstract type (`type List<X>`) has none, and a
  # "Variants: (abstract)" heading told the reader nothing.
  foul variantsHtml(variants: [VariantEntry]?) -> String do
    let real = variants.or([]).reject { |v| v.name.empty? }
    return "" if real.empty?
    let items = real.map { |v| variantItem(v) }.join("\n")
    return "<h3>Variants</h3>\n<ul class=\"variants\">\n${items}\n</ul>\n"
  end

  foul variantItem(v: VariantEntry) -> String do
    if v.fields.empty?
      return "<li><code>${esc(v.name)}</code></li>"
    end
    return "<li><code>${esc(v.name)}(${esc(v.fields.join(", "))})</code></li>"
  end

  foul recordSection(e: RecordEntry, makes: [MakeEntry], page: SourcePage, model: PackageModel) -> String do
    let link = Tey.Docgen.Html.linker(page, model)
    let rows = e.fields.map { |f| fieldRow(f, link) }.join("\n")
    let fields = e.fields.empty? then "" else "<h3>Fields</h3>\n<dl class=\"fields\">\n${rows}\n</dl>\n"
    let head = "<h2><span class=\"kind kind-record\">record</span> <code>${esc(e.name)}${esc(typeParamSuffix(e.typeParams))}</code> ${permalinkHtml(anchorOf(RecordDecl(e)))}</h2>"
    return "<section class=\"entity\" id=\"${anchorOf(RecordDecl(e))}\">\n${head}\n${entityDocHtml(e.doc, page, model)}${fields}${typeBodyHtml(e.name, makes, page, model)}\n</section>"
  end

  # Everything about a type beyond its declaration: the traits it
  # implements (from every file), its functions grouped by receiver, the
  # functions it gets from those traits for free, and the other modules that
  # add functions to it.
  foul typeBodyHtml(name: String, makes: [MakeEntry], page: SourcePage, model: PackageModel) -> String do
    # The plain receiver's functions first; `[Number]`-only extras after.
    let ordered = receiverOrder(makes, name)
    let groups = ordered.map { |m| makeGroupHtml(m, name, page, model) }.join("\n")
    let related = "${providedHtml(name, page, model)}${elsewhereHtml(name, page, model)}"
    if !indexed?(ordered.flatMap { |m| m.functions })
      return "${implementsHtml(name, page, model)}${groups}${related}"
    end
    let indexes = ordered.map { |m| makeIndexHtml(m, name) }.join("")
    return "${implementsHtml(name, page, model)}${summaryHtml(companionIndexHtml(name, page) + indexes + related)}${groups}"
  end

  # `Set.from` and `Set.empty` belong to the module that shares the type's
  # name, which is a section of its own further down the page — after every
  # function of every type the file declares. They are how a reader gets a
  # `Set` in the first place, so the type's summary lists them first.
  foul companionIndexHtml(name: String, page: SourcePage) -> String do
    match modulesIn(page.entities).find { |m| m.qualifiedName.split(".").last.or("") == name } do
      None => return ""
      Just(m) => do
        let rows = memberIndexRows(m.children.filter { |c| memberEntity?(c) }, "${name}.")
        return "" if rows.empty?
        return "<h3><a href=\"#${anchorOf(ModuleDecl(m))}\">On the <code>${esc(name)}</code> module</a></h3>\n${indexHtml(rows, "index")}"
      end
    end
  end

  foul modulesIn(entities: [Entity]) -> [ModuleEntry] do
    return entities.flatMap { |e| moduleAndNested(e) }
  end

  foul moduleAndNested(e: Entity) -> [ModuleEntry] do
    match e do
      ModuleDecl(entry) => [entry] + modulesIn(entry.children)
      _ => []
    end
  end

  foul receiverOrder(makes: [MakeEntry], name: String) -> [MakeEntry] do
    let (plain, special) = makes.partition { |m| genericReceiver?(m.target, name) }
    return plain + special
  end

  # "Functions" for the plain receiver, "On `[Number]`" for a specialised one.
  foul makeGroupTitle(m: MakeEntry, base: String) -> String do
    return genericReceiver?(m.target, base) then "Functions" else "On <code>${esc(m.target)}</code>"
  end

  foul makeGroupHtml(m: MakeEntry, base: String, page: SourcePage, model: PackageModel) -> String do
    # The traits are on the type's own "Implements" line; each member that
    # fulfils one carries the trait's tag.
    let fns = functionsHtml(m.functions, m.target, 4, m.implements, page, model)
    return "<section class=\"members\" id=\"${anchorOf(MakeDecl(m))}\">\n<h3>${makeGroupTitle(m, base)}</h3>\n${entityDocHtml(m.doc, page, model)}${fns}\n</section>"
  end

  # A long member list is read twice: first to find out what there is, then
  # to learn one function. Fifty full entries answer only the second, a
  # screen at a time, so a group this long opens with its index — every name
  # with the first sentence of its doc, linked to the entry below. A short
  # group is its own index.
  foul indexed?(functions: [FunctionEntry]) -> Bool do
    return functions.map { |f| f.name }.uniq.count >= 6
  end

  record IndexRow do
    name : String
    href : String
    summary : String
    isFoul : Bool = false
  end

  foul indexRowsOf(functions: [FunctionEntry], owner: String) -> [IndexRow] do
    return functions.map { |f| f.name }.uniq.map { |n| indexRowOf(functions.filter { |f| f.name == n }, "#${memberAnchorOf(owner, n)}", n) }
  end

  # Overloads share a row; the first of them with something to say says it.
  foul indexRowOf(overloads: [FunctionEntry], href: String, name: String) -> IndexRow do
    let summary = overloads.map { |f| firstSentence(f.doc.summary) }.find { |t| !t.empty? }.or("")
    return IndexRow { name: name, href: href, summary: summary, isFoul: overloads.any? { |f| f.isFoul } }
  end

  foul indexHtml(rows: [IndexRow], klass: String) -> String do
    let items = rows.map { |r| "<div class=\"param\"><dt><a class=\"xref\" href=\"${esc(r.href)}\"><code>${esc(r.name)}</code></a>${foulTag(r.isFoul)}</dt><dd>${inlineCode(r.summary)}</dd></div>" }
    return "<dl class=\"params ${klass}\">\n${items.join("\n")}\n</dl>\n"
  end

  foul makeIndexHtml(m: MakeEntry, base: String) -> String do
    return "" if m.functions.empty?
    return "<h3><a href=\"#${anchorOf(MakeDecl(m))}\">${makeGroupTitle(m, base)}</a></h3>\n${indexHtml(indexRowsOf(m.functions, m.target), "index")}"
  end

  # Everything a declaration offers before any of it in full: its own
  # members, what its traits give it, what other modules add.
  foul summaryHtml(lists: String) -> String do
    return lists.empty? then "" else "<section class=\"summary\">\n${lists}</section>\n"
  end

  # `[X]` and `FileHandle<R, W>` are the type itself; `[Number]` is not.
  foul genericReceiver?(target: String, base: String) -> Bool do
    return ownerSlugOf(target) == ownerSlugOf(base)
  end

  # Every trait the type implements, wherever the implementing make block
  # lives — algebra.kex is what makes Integer a Monoid, and number.kex's
  # reader should still learn that.
  foul implementsHtml(name: String, page: SourcePage, model: PackageModel) -> String do
    match Tey.Docgen.Relations.typeFactsFor(model, name) do
      Just(facts) => facts.traits.empty? then "" else "<p class=\"implements\">Implements ${traitLinks(facts.traits, page, model)}.</p>\n"
      None => ""
    end
  end

  foul traitLinks(traits: [String], page: SourcePage, model: PackageModel) -> String do
    let links = traits.map { |t|
      match Tey.Docgen.Relations.traitFactsFor(model, t) do
        Just(facts) => "<a class=\"xref\" href=\"${Tey.Docgen.Nav.hrefFrom(page.urlPath, facts.urlPath, facts.anchor)}\"><code>${esc(t)}</code></a>"
        None => "<code>${esc(t)}</code>"
      end
    }
    return links.join(", ")
  end

  # The trait functions a type gets without writing them: a trait's provided
  # functions, minus any the type defines itself somewhere. This is the
  # answer to "where does `List.eachIndexed` come from?".
  foul providedHtml(name: String, page: SourcePage, model: PackageModel) -> String do
    match Tey.Docgen.Relations.typeFactsFor(model, name) do
      None => return ""
      Just(facts) => do
        let own = facts.extensions.flatMap { |x| x.names }
        return facts.traits.map { |t| providedFromHtml(t, own, page, model) }.join("")
      end
    end
  end

  foul providedFromHtml(written: String, own: [String], page: SourcePage, model: PackageModel) -> String do
    match Tey.Docgen.Relations.traitFactsFor(model, written) do
      None => return ""
      Just(facts) => match Tey.Docgen.Relations.traitEntryFor(model, facts) do
        None => return ""
        Just(entry) => do
          let (_, provided) = Tey.Docgen.Relations.traitMethods(model, entry)
          let inherited = provided.reject { |f| own.contains?(f.name) }
          let names = inherited.map { |f| f.name }.uniq
          return "" if names.empty?
          let rows = names.map { |n| indexRowOf(inherited.filter { |f| f.name == n }, Tey.Docgen.Nav.hrefFrom(page.urlPath, facts.urlPath, memberAnchorOf(facts.qualifiedName, n)), n) }
          let traitHref = Tey.Docgen.Nav.hrefFrom(page.urlPath, facts.urlPath, facts.anchor)
          return "<h3>From <a class=\"xref\" href=\"${traitHref}\"><code>${esc(facts.name)}</code></a></h3>\n${indexHtml(rows, "inherited")}"
        end
      end
    end
  end

  # Other modules that add functions to this type: `make Integer` in
  # time.kex is where `5.seconds` comes from.
  foul elsewhereHtml(name: String, page: SourcePage, model: PackageModel) -> String do
    match Tey.Docgen.Relations.typeFactsFor(model, name) do
      None => return ""
      Just(facts) => do
        let others = facts.extensions.reject { |x| x.urlPath == page.urlPath || x.names.empty? }
        return "" if others.empty?
        let rows = others.map { |x|
          let pageHref = Tey.Docgen.Nav.hrefFrom(page.urlPath, x.urlPath, x.anchor)
          let names = x.names.map { |n|
            "<a class=\"xref\" href=\"${Tey.Docgen.Nav.hrefFrom(page.urlPath, x.urlPath, memberAnchorOf(x.target, n))}\"><code>${esc(n)}</code></a>"
          }.join(", ")
          "<div class=\"param\"><dt><a class=\"xref\" href=\"${pageHref}\">${esc(x.pageTitle)}</a></dt><dd>${names}</dd></div>"
        }.join("\n")
        return "<h3>Defined in other modules</h3>\n<dl class=\"params elsewhere\">\n${rows}\n</dl>\n"
      end
    end
  end

  foul fieldRow(f: Tey.Docgen.Model.FieldEntry, link: (String -> String)) -> String do
    let opt = if f.hasDefault then " <span class=\"opt\">optional</span>" else "" end
    return "<div class=\"field\"><dt><code>${esc(f.name)}</code></dt><dd><code>${linkTypeText(link, f.typeName)}</code>${opt}</dd></div>"
  end

  # A type text is code with links inside it: split into identifier and
  # punctuation segments, link the identifiers that resolve, escape the rest.
  foul linkTypeText(link: (String -> String), text: String) -> String do
    return Tey.Docgen.Nav.segmentsOf(text).map { |seg|
      if seg != "" && Tey.Docgen.Nav.isIdentChar?(seg.take(1))
        link(seg)
      else
        esc(seg)
      end
    }.join("")
  end

  # The whole-package resolution one segment goes through: an exact name hit
  # links (display text escaped); anything else is plain escaped code.
  foul linkType(links: [LinkEntry], fromPath: String, name: String) -> String do
    match Tey.Docgen.Nav.resolve(links, name) do
      Just(entry) => do
        let href = Tey.Docgen.Nav.hrefFrom(fromPath, entry.urlPath, entry.anchor)
        return "<a class=\"xref\" href=\"${href}\">${esc(name)}</a>"
      end
      None => esc(name)
    end
  end

  # A trait: what an implementor must write, what it then gets for free,
  # and who implements it.
  foul traitSection(e: TraitEntry, page: SourcePage, model: PackageModel) -> String do
    let owner = e.qualifiedName
    let (required, provided) = Tey.Docgen.Relations.traitMethods(model, e)
    let requiredHtml = if required.empty?
      ""
    else
      "<h3>Required functions</h3>\n<p class=\"group-note\">An implementor writes these.</p>\n${functionsHtml(required, owner, 4, [], page, model)}\n"
    end
    let providedHtml = if provided.empty?
      ""
    else
      let note = required.empty? then "" else "<p class=\"group-note\">Every implementor gets these, written in terms of the required functions.</p>\n"
      "<h3>Provided functions</h3>\n${note}${functionsHtml(provided, owner, 4, [], page, model)}\n"
    end
    let head = "<h2><span class=\"kind kind-trait\">trait</span> <code>${esc(e.name)}${esc(typeParamSuffix(e.typeParams))}</code> ${permalinkHtml(anchorOf(TraitDecl(e)))}</h2>"
    let summary = indexed?(required + provided) then summaryHtml(traitIndexHtml("Required functions", required, owner) + traitIndexHtml("Provided functions", provided, owner)) else ""
    return "<section class=\"entity\" id=\"${anchorOf(TraitDecl(e))}\">\n${head}\n${entityDocHtml(e.doc, page, model)}${implementedByHtml(e, page, model)}${summary}${requiredHtml}${providedHtml}\n</section>"
  end

  foul traitIndexHtml(title: String, functions: [FunctionEntry], owner: String) -> String do
    return functions.empty? then "" else "<h3>${title}</h3>\n${indexHtml(indexRowsOf(functions, owner), "index")}"
  end

  foul implementedByHtml(e: TraitEntry, page: SourcePage, model: PackageModel) -> String do
    match model.traits.find { |t| t.qualifiedName == e.qualifiedName } do
      None => return ""
      Just(facts) => do
        return "" if facts.implementors.empty?
        let items = facts.implementors.map { |x|
          let href = Tey.Docgen.Nav.hrefFrom(page.urlPath, x.urlPath, x.anchor)
          "<a class=\"xref\" href=\"${href}\"><code>${esc(x.target)}</code></a>"
        }.join(", ")
        return "<p class=\"implements\">Implemented by ${items}.</p>\n"
      end
    end
  end

  # A make block with no type declaration on its page. On the type's home
  # page (string.kex for String) it carries everything the type section
  # would; elsewhere it points home.
  foul makeSection(e: MakeEntry, page: SourcePage, model: PackageModel) -> String do
    let base = baseTypeOf(e.target)
    let facts = Tey.Docgen.Relations.typeFactsFor(model, base)
    let home = match facts do
      Just(f) => f.homePath == page.urlPath && firstMakeOnPage?(f, e, page)
      None => false
    end
    # On its home page a builtin's make block IS the type's documentation
    # (String has no `type` declaration); anywhere else it extends a type
    # documented elsewhere.
    let head = if home
      "<h2><span class=\"kind kind-type\">type</span> <code>${esc(e.target)}</code> ${permalinkHtml(anchorOf(MakeDecl(e)))}</h2>"
    else
      "<h2><span class=\"kind kind-make\">extends</span> <code>${esc(e.target)}</code> ${permalinkHtml(anchorOf(MakeDecl(e)))}</h2>"
    end
    let fns = functionsHtml(e.functions, e.target, 3, e.implements, page, model)
    let index = indexed?(e.functions) then indexHtml(indexRowsOf(e.functions, e.target), "index") else ""
    let body = if home
      let related = "${providedHtml(base, page, model)}${elsewhereHtml(base, page, model)}"
      let lead = "${implementsHtml(base, page, model)}${entityDocHtml(e.doc, page, model)}"
      index.empty? then "${lead}${fns}${related}" else "${lead}${summaryHtml(index + related)}${fns}"
    else
      let impls = e.implements.empty? then "" else "<p class=\"implements\">Implements ${traitLinks(e.implements, page, model)}.</p>\n"
      "${homeNote(base, facts, page, model)}${impls}${entityDocHtml(e.doc, page, model)}${summaryHtml(index)}${fns}"
    end
    return "<section class=\"entity\" id=\"${anchorOf(MakeDecl(e))}\">\n${head}\n${body}\n</section>"
  end

  foul firstMakeOnPage?(facts: Tey.Docgen.Model.TypeFacts, e: MakeEntry, page: SourcePage) -> Bool do
    match facts.extensions.find { |x| x.urlPath == page.urlPath } do
      Just(x) => x.anchor == anchorOf(MakeDecl(e))
      None => false
    end
  end

  foul homeNote(base: String, facts: Tey.Docgen.Model.TypeFacts?, page: SourcePage, model: PackageModel) -> String do
    match Tey.Docgen.Relations.traitFactsFor(model, base) do
      Just(t) => do
        let href = Tey.Docgen.Nav.hrefFrom(page.urlPath, t.urlPath, t.anchor)
        return "<p class=\"home-note\">Functions for <a class=\"xref\" href=\"${href}\"><code>${esc(base)}</code></a>, defined by this module.</p>\n"
      end
      None => ()
    end
    match facts do
      Just(f) => do
        return "" if f.homePath.empty? || f.homePath == page.urlPath
        let href = Tey.Docgen.Nav.hrefFrom(page.urlPath, f.homePath, f.homeAnchor)
        return "<p class=\"home-note\">More functions for <a class=\"xref\" href=\"${href}\"><code>${esc(base)}</code></a>, added by this module.</p>\n"
      end
      None => ""
    end
  end

  # A module's own functions and constants are its API, listed under it
  # (h3) like a type's functions. Types, traits and nested modules it declares
  # stand as sections of their own after that.
  foul moduleSection(e: ModuleEntry, page: SourcePage, model: PackageModel) -> String do
    let (members, declarations) = e.children.partition { |c| memberEntity?(c) }
    let api = members.map { |c| moduleMemberHtml(c, page, model) }.join("\n")
    let apiHtml = api.empty? then "" else "<div class=\"functions\">\n${api}\n</div>\n"
    let head = "<h2><span class=\"kind kind-module\">module</span> <code>${esc(e.qualifiedName)}</code> ${permalinkHtml(anchorOf(ModuleDecl(e)))}</h2>"
    let rows = memberIndexRows(members, "")
    let index = rows.count >= 6 then summaryHtml(indexHtml(rows, "index")) else ""
    let own = if namespaceOnly?(e, page)
      "<div class=\"intro\" id=\"${anchorOf(ModuleDecl(e))}\">\n${entityDocHtml(e.doc, page, model)}</div>"
    else
      "<section class=\"entity\" id=\"${anchorOf(ModuleDecl(e))}\">\n${head}\n${entityDocHtml(e.doc, page, model)}${index}${apiHtml}</section>"
    end
    return own + "\n" + entitiesHtml(declarations, page, model)
  end

  # A file that opens with a bare `module Data` and declares `Set` inside
  # it is the page "Data.Set": the outer module is only the namespace the
  # file lives in. Its comment is the page's introduction, and a "module
  # Data" heading over it names something the page is not about.
  foul namespaceOnly?(e: ModuleEntry, page: SourcePage) -> Bool do
    return page.title.startsWith?("${e.qualifiedName}.") && !e.children.any? { |c| memberEntity?(c) }
  end

  # One row per member name, shown with `prefix` in front of it.
  foul memberIndexRows(members: [Entity], prefix: String) -> [IndexRow] do
    return members.map { |c| nameOf(c) }.uniq.map { |n| memberIndexRow(members.filter { |c| nameOf(c) == n }, prefix + n) }
  end

  foul memberIndexRow(same: [Entity], name: String) -> IndexRow do
    let summary = same.map { |c| firstSentence(summaryOf(c)) }.find { |t| !t.empty? }.or("")
    return IndexRow { name: name, href: "#${same.map { |c| anchorOf(c) }.first.or("")}", summary: summary, isFoul: same.any? { |c| foulEntity?(c) } }
  end

  foul foulEntity?(e: Entity) -> Bool do
    match e do
      FuncDecl(f) => f.isFoul
      _ => false
    end
  end

  # Purity is half of what a Kex signature says: a foul function may touch
  # the outside world, and only foul code may call it. The chip says so
  # wherever the function is named.
  foul foulTag(isFoul: Bool) -> String do
    return isFoul then " <span class=\"tag-foul\" title=\"May have side effects; callable only from foul code\">foul</span>" else ""
  end

  foul summaryOf(e: Entity) -> String do
    match e do
      TypeDecl(entry) => entry.doc.summary
      RecordDecl(entry) => entry.doc.summary
      TraitDecl(entry) => entry.doc.summary
      MakeDecl(entry) => entry.doc.summary
      ModuleDecl(entry) => entry.doc.summary
      FuncDecl(entry) => entry.doc.summary
      ConstDecl(entry) => entry.doc.summary
    end
  end

  foul memberEntity?(e: Entity) -> Bool do
    match e do
      FuncDecl(_) => true
      ConstDecl(_) => true
      _ => false
    end
  end

  foul moduleMemberHtml(e: Entity, page: SourcePage, model: PackageModel) -> String do
    let anchor = anchorOf(e)
    match e do
      FuncDecl(f) => do
        let heading = "<h3><a class=\"self\" href=\"#${anchor}\"><code>${esc(f.name)}</code></a>${foulTag(f.isFoul)} ${permalinkHtml(anchor)}</h3>"
        "<div class=\"fn\" id=\"${anchor}\">\n${memberHeadHtml(heading, signaturesHtml(f, page, model), f.name)}${overloadBodyHtml(f, page, model)}\n</div>"
      end
      ConstDecl(c) => do
        let typePart = c.typeName.empty? then "" else "<pre class=\"code sig\"><code>${signatureLine(namedFirst(Tey.Docgen.Highlight.highlightLinked("${c.name} : ${c.typeName}", hrefer(page, model)), c.name))}</code></pre>\n"
        let heading = "<h3><a class=\"self\" href=\"#${anchor}\"><code>${esc(c.name)}</code></a> <span class=\"tag-kind\">constant</span> ${permalinkHtml(anchor)}</h3>"
        "<div class=\"fn\" id=\"${anchor}\">\n${memberHeadHtml(heading, typePart, c.name)}${docHtml(c.doc, page, model)}${examplesHtml(c.doc)}\n</div>"
      end
      _ => ""
    end
  end

  foul functionSection(e: FunctionEntry, page: SourcePage, model: PackageModel) -> String do
    let head = "<h2><span class=\"kind kind-function\">function</span> <code>${esc(e.name)}</code> ${permalinkHtml(anchorOf(FuncDecl(e)))}</h2>"
    return "<section class=\"entity\" id=\"${anchorOf(FuncDecl(e))}\">\n${head}\n${overloadHtml(e, page, model)}\n</section>"
  end

  foul constantSection(e: ConstantEntry, page: SourcePage, model: PackageModel) -> String do
    let typePart = if e.typeName.empty?
      ""
    else
      " <code>: ${linkTypeText(linker(page, model), e.typeName)}</code>"
    end
    return "<section class=\"entity\" id=\"${anchorOf(ConstDecl(e))}\">\n<h2><span class=\"kind kind-constant\">constant</span> <code>${esc(e.name)}</code>${typePart} ${permalinkHtml(anchorOf(ConstDecl(e)))}</h2>\n${entityDocHtml(e.doc, page, model)}\n</section>"
  end

  # Members of a trait or make block, one heading per NAME: overloads
  # (`count` and `count(pred)`) are one function with several signatures, not
  # two unrelated entries. `owner` scopes the anchors; `implements` lets a
  # member that fulfils a trait function say which trait.
  foul functionsHtml(functions: [FunctionEntry], owner: String, level: Integer, implements: [String],
                     page: SourcePage, model: PackageModel) -> String do
    return "" if functions.empty?
    let names = functions.map { |f| f.name }.uniq
    let sections = names.map { |n|
      functionGroupHtml(functions.filter { |f| f.name == n }, n, owner, level, implements, page, model)
    }.join("\n")
    return "\n<div class=\"functions\">\n${sections}\n</div>"
  end

  foul functionGroupHtml(fs: [FunctionEntry], name: String, owner: String, level: Integer, implements: [String],
                         page: SourcePage, model: PackageModel) -> String do
    let anchor = memberAnchorOf(owner, name)
    let tags = foulTag(fs.any? { |f| f.isFoul }) + traitTag(name, implements, page, model)
    let head = "<h${level}><a class=\"self\" href=\"#${anchor}\"><code>${esc(name)}</code></a>${tags} ${permalinkHtml(anchor)}</h${level}>"
    # The first overload's signature heads the card; the others follow
    # with theirs, each above its own prose.
    let lead = fs.take(1).map { |f| signaturesHtml(f, page, model) }.join("")
    let body = fs.take(1).map { |f| overloadBodyHtml(f, page, model) } + fs.drop(1).map { |f| overloadHtml(f, page, model) }
    return "<div class=\"fn\" id=\"${anchor}\">\n${memberHeadHtml(head, lead, name)}${body.join("\n")}\n</div>"
  end

  # The head of a member's card: its signature, with the heading's chips
  # beside it. They share a row rather than one lying over the other, so a
  # long signature scrolls in the room it has instead of running under them.
  # (The permalink is the exception a stylesheet may make: shown only under
  # the pointer, it can sit in the corner and take no room.)
  # A member the source gives no type — an untyped constant, a function
  # nobody annotated — is headed the same way by its name alone, so every
  # card on a page has the same shape.
  foul memberHeadHtml(heading: String, signature: String, name: String) -> String do
    let shown = signature.empty? then "<pre class=\"code sig\"><code>${signatureLine("<span class=\"tok-fn\">${esc(name)}</span>")}</code></pre>\n" else signature
    return "<div class=\"fn-head\">\n${heading}\n${shown}</div>\n"
  end

  # "from Enumerable": this member is the type's own version of a function the
  # trait declares, linked to the trait's description of it.
  foul traitTag(name: String, implements: [String], page: SourcePage, model: PackageModel) -> String do
    let hits = implements.flatMap { |t|
      match Tey.Docgen.Relations.traitFactsFor(model, t) do
        None => []
        Just(facts) => match Tey.Docgen.Relations.traitEntryFor(model, facts) do
          None => []
          Just(entry) => entry.functions.any? { |f| f.name == name } then [facts] else []
        end
      end
    }
    return hits.map { |facts|
      let href = Tey.Docgen.Nav.hrefFrom(page.urlPath, facts.urlPath, memberAnchorOf(facts.qualifiedName, name))
      " <a class=\"tag-trait\" href=\"${href}\" title=\"Implements ${esc(facts.name)}.${esc(name)}\">${esc(facts.name)}</a>"
    }.join("")
  end

  # One overload: its signature first (what you call), then the prose.
  foul overloadHtml(f: FunctionEntry, page: SourcePage, model: PackageModel) -> String do
    return signaturesHtml(f, page, model) + overloadBodyHtml(f, page, model)
  end

  foul overloadBodyHtml(f: FunctionEntry, page: SourcePage, model: PackageModel) -> String do
    let link = linker(page, model)
    return "${docHtml(f.doc, page, model)}${paramsHtml(f, link, page, model)}${returnsHtml(f, link, page, model)}${examplesHtml(f.doc)}${deprecatedHtml(f.doc)}"
  end

  foul signaturesHtml(f: FunctionEntry, page: SourcePage, model: PackageModel) -> String do
    if f.signatures.empty?
      return ""
    end
    let hrefOf = hrefer(page, model)
    let lines = f.signatures.map { |s| signatureLine(namedFirst(Tey.Docgen.Highlight.highlightLinked(s, hrefOf), f.name)) }
    return "<pre class=\"code sig\"><code>${lines.join("")}</code></pre>\n"
  end

  # Each signature is an element of its own, one per line, so a stylesheet
  # can treat an overload as a unit.
  foul signatureLine(html: String) -> String do
    return "<span class=\"sig-line\">${html}</span>"
  end

  # A signature opens with the name of what it declares, and the highlighter
  # does not know that: it marks the name as a function only where a
  # parameter list follows (`count : Integer` came out plain beside
  # `count(pred)`), and a function called `from` or `in` as the keyword it
  # is spelled like. Here the opening name is always marked as the name.
  foul namedFirst(html: String, name: String) -> String do
    let plain = esc(name)
    let named = "<span class=\"tok-fn\">${plain}</span>"
    let keyword = "<span class=\"tok-keyword\">${plain}</span>"
    return named + html.drop(keyword.count) if html.startsWith?(keyword)
    return html.startsWith?("${plain} ") then named + html.drop(plain.count) else html
  end

  # The address of a declaration or member, as a control beside its heading:
  # a plain link to its own anchor, which the page script turns into "copy
  # this address".
  foul permalinkHtml(anchor: String) -> String do
    return "<a class=\"permalink\" href=\"#${esc(anchor)}\" title=\"Copy link\" aria-label=\"Copy link\">#</a>"
  end

  foul docHtml(doc: Doc, page: SourcePage, model: PackageModel) -> String do
    if doc.summary.empty?
      return ""
    end
    let hrefOf = hrefer(page, model)
    let paras = summaryParagraphs(doc.summary).map { |p| paragraphHtml(p, hrefOf) }.join("\n")
    return paras + "\n"
  end

  # A declaration's doc: prose, then its examples and any deprecation —
  # a type's @example is as much a part of it as a function's.
  foul entityDocHtml(doc: Doc, page: SourcePage, model: PackageModel) -> String do
    return "${docHtml(doc, page, model)}${examplesHtml(doc)}${deprecatedHtml(doc)}"
  end

  # Unlinked: for prose with no page to resolve against (the prelude
  # comment, card summaries).
  foul plainDocHtml(doc: Doc) -> String do
    if doc.summary.empty?
      return ""
    end
    return summaryParagraphs(doc.summary).map { |p| paragraphHtml(p, { |_| "" }) }.join("\n") + "\n"
  end

  # Paragraphs break on blank lines — except inside a fenced block, where a
  # blank line is part of the code rather than the end of a paragraph.
  foul summaryParagraphs(summary: String) -> [String] do
    return groupParagraphs(summary.split("\n"), [], [], false)
  end

  foul groupParagraphs(lines: [String], current: [String], accum: [String],
                       fenced: Bool) -> [String] do
    if lines.empty?
      return current.empty? then accum else accum + [current.join("\n")]
    end
    let line = lines.first.or("")
    let rest = lines.drop(1)
    if line.startsWith?("```")
      if fenced
        return groupParagraphs(rest, [], accum + [(current + [line]).join("\n")], false)
      end
      let beforeFence = current.empty? then accum else accum + [current.join("\n")]
      return groupParagraphs(rest, [line], beforeFence, true)
    end
    if !fenced && line.trim.empty?
      let flushed = current.empty? then accum else accum + [current.join("\n")]
      return groupParagraphs(rest, [], flushed, false)
    end
    return groupParagraphs(rest, current + [line], accum, fenced)
  end

  # A summary paragraph is prose, a fenced block that Rdoc produced from an
  # indented (verbatim) block, or a bullet list — each rendered as what it
  # is rather than reflowed into one paragraph.
  foul paragraphHtml(p: String, hrefOf: (String -> String)) -> String do
    if p.startsWith?("```")
      let fenced = p.split("\n")
      let body = fenced.drop(1).takeWhile { |l| l != "```" }.join("\n")
      return codeBlockHtml(body)
    end
    let lines = p.split("\n")
    if lines.all? { |l| bulletLine?(l) || l.startsWith?("  ") }
      return bulletListHtml(lines, hrefOf)
    end
    # Soft line breaks in a comment are the width of the source file, not
    # the author's intent: the paragraph reflows.
    return "<p>${linkedInline(lines.map { |l| l.trim }.join(" "), hrefOf)}</p>"
  end

  foul bulletLine?(line: String) -> Bool do
    let t = line.trim
    return t.startsWith?("- ") || t.startsWith?("* ")
  end

  # `- item` lines, with indented continuation lines folded into the item
  # above them.
  foul bulletListHtml(lines: [String], hrefOf: (String -> String)) -> String do
    let items = lines.reduce([], { |acc, line|
      bulletLine?(line) then acc + [line.trim.drop(2)] else acc.take(acc.count - 1) + ["${acc.last.or("")} ${line.trim}"]
    })
    return "<ul>\n" + items.map { |i| "<li>${linkedInline(i, hrefOf)}</li>" }.join("\n") + "\n</ul>"
  end

  # Minimal inline Markdown for doc prose: `code` spans. Splitting on the
  # backtick alternates plain/code segments; an unmatched trailing backtick
  # degrades to literal text rather than swallowing the rest of the page.
  foul inlineCode(text: String) -> String do
    return linkedInline(text, { |_| "" })
  end

  # The same, with a code span that names something documented — a type, a
  # trait, `List.map` — linked to it.
  foul linkedInline(text: String, hrefOf: (String -> String)) -> String do
    let parts = text.split("`")
    if parts.count == 1 || parts.count % 2 == 0
      return esc(text)
    end
    return parts.mapIndexed { |part, i|
      if i % 2 == 1
        let href = linkableCode?(part) then hrefOf(part) else ""
        href.empty? then "<code>${esc(part)}</code>" else "<a class=\"xref\" href=\"${esc(href)}\"><code>${esc(part)}</code></a>"
      else
        esc(part)
      end
    }.join("")
  end

  # Only a bare name is a reference: `List`, `FS.Path`, `List.map`. A code
  # span with spaces or parentheses is an expression, not a name.
  foul linkableCode?(code: String) -> Bool do
    return !code.empty? && code.chars.all? { |c| c.letter? || c.digit? || c == '.' || c == '_' || c == '?' || c == '!' }
  end

  foul firstSentence(text: String) -> String do
    let para = summaryParagraphs(text).first.or("")
    return "" if para.startsWith?("```")
    let flat = para.split("\n").map { |l| l.trim }.join(" ")
    let sentences = flat.split(". ")
    return sentences.count > 1 then sentences.first.or("") + "." else flat
  end

  # Each parameter's meaning. Its type is in the signature right above,
  # so it is repeated here only when there is no signature to read it from.
  foul paramsHtml(f: FunctionEntry, link: (String -> String), page: SourcePage, model: PackageModel) -> String do
    let doc = f.doc
    if doc.params.empty?
      return ""
    end
    let hrefOf = hrefer(page, model)
    let typed = !f.signatures.empty?
    let rows = doc.params.map { |p|
      let typePart = if typed || p.typeName.empty? then "" else " <code>${linkTypeText(link, p.typeName)}</code>" end
      "<div class=\"param\"><dt><code>${esc(p.name)}</code>${typePart}</dt><dd>${linkedInline(p.description, hrefOf)}</dd></div>"
    }.join("\n")
    return "<h5>Parameters</h5>\n<dl class=\"params\">\n${rows}\n</dl>\n"
  end

  # The signature already states the result type, so when there is one
  # "Returns" says only what the value MEANS. A @return tag whose type
  # disagrees would otherwise put two answers side by side
  # (`min : X?` above "Returns: Number?").
  foul returnsHtml(f: FunctionEntry, link: (String -> String), page: SourcePage, model: PackageModel) -> String do
    match f.doc.returns do
      Just(r) => do
        let typed = !f.signatures.empty?
        if r.description.empty? && (typed || r.typeName.empty?)
          return ""
        end
        let typePart = if typed || r.typeName.empty? then "" else "<code>${linkTypeText(link, r.typeName)}</code> — " end
        return "<p class=\"returns\"><strong>Returns</strong> ${typePart}${linkedInline(r.description, hrefer(page, model))}</p>\n"
      end
      None => ""
    end
  end

  foul examplesHtml(doc: Doc) -> String do
    if doc.examples.empty?
      return ""
    end
    let blocks = doc.examples.map { |ex|
      let caption = if ex.caption.empty? then "" else "<p class=\"caption\"><em>${inlineCode(ex.caption)}</em></p>\n" end
      "${caption}${codeBlockHtml(ex.code)}"
    }.join("\n")
    return "<h5>Examples</h5>\n${blocks}\n"
  end

  # Kex source as a highlighted block, with the control that copies it. The
  # control is inert markup until the page script enables it, so it stays
  # hidden where there is no script to act on it.
  foul codeBlockHtml(source: String) -> String do
    let copy = "<button class=\"copy-code\" type=\"button\" title=\"Copy code\" hidden>Copy</button>"
    return "<div class=\"code-block\"><pre class=\"code\"><code>${Tey.Docgen.Highlight.highlight(source)}</code></pre>${copy}</div>"
  end

  foul deprecatedHtml(doc: Doc) -> String do
    match doc.deprecated do
      Just(msg) => "<p class=\"deprecated\"><strong>Deprecated.</strong> ${inlineCode(msg)}</p>\n"
      None => ""
    end
  end

  # Escape text for HTML (content and double-quoted attributes).
  foul esc(s: String) -> String do
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
  end

  foul labelOf(model: PackageModel) -> String do
    if model.label.empty?
      return model.package
    end
    return model.label
  end

  # The page the version switcher tries first in the target version.
  foul pageTarget(current: String) -> String do
    if current.empty?
      return "index.html"
    end
    return current + ".html"
  end

  # Every page's raw Markdown, next to its HTML: the footer link humans see,
  # and the address llms.txt tells models about. Index pages have none. The
  # target is a bare sibling filename — the page already stands in the
  # directory its `.md` was written to, so no prefix climbing is wanted.
  foul markdownLink(current: String) -> String do
    if current.empty?
      return ""
    end
    let stem = current.split("/").last.or(current)
    return " · <a href=\"${stem}.md\">Markdown</a>"
  end

  foul slug(name: String) -> String do
    return Tey.Docgen.Model.slugOf(name)
  end

  foul typeParamSuffix(typeParams: [String]) -> String do
    if typeParams.empty?
      return ""
    end
    return "<" + typeParams.join(", ") + ">"
  end

  # Relative path from a page's urlPath back to the version directory:
  # "string" → "" (sibling), "kex/ast" → "../".
  foul versionPrefix(urlPath: String) -> String do
    if urlPath.empty?
      return ""
    end
    return ups(urlPath.split("/").count - 1)
  end

  # From the page to the site root: version dir is <pkg>/<version>/.
  foul rootPrefix(urlPath: String) -> String do
    return versionPrefix(urlPath) + "../../"
  end

  foul ups(n: Integer) -> String do
    if n <= 0
      return ""
    end
    return "../" + ups(n - 1)
  end
end
