# Turns +Kex.AST+ nodes into the typed entity model of +Tey.Docgen.Model+.
#
# A declaration body mixes type annotations (+name : type+) with function
# definitions (+let name(args) ...+), and overloads repeat both. Functions are
# collected per name as +PendingFunction+ records, keeping annotations and
# parameter lists apart, and finished only after the whole body is read:
# pairing an annotation's curried type with a clause's parameter names needs
# both.

module Tey.Docgen.Extract do
  using Kex.AST, only: [Node, TypeRef, PatternRef]
  using Tey.Docgen.Model, only: [Entity, TypeDecl, RecordDecl, TraitDecl, MakeDecl, ModuleDecl, FuncDecl, ConstDecl, TypeEntry, RecordEntry, TraitEntry, MakeEntry, ModuleEntry, FunctionEntry, ConstantEntry, VariantEntry, FieldEntry, SourcePage, Doc, nameOf, qualifiedNameOf]

  let fileEntities(items: [Kex.AST.Node]) -> [Entity] do
    return entitiesIn(items, "")
  end

  # Builds the page for one source file.
  #
  # +header+ is the file's opening comment, when a blank line separates it
  # from what follows (+Index.fileHeader+). The AST reader attaches every
  # comment above a declaration to it, blank lines included, so the first
  # declaration's doc starts with the file's introduction. This cuts the
  # header off that doc and keeps it as the page's intro; otherwise
  # algebra.kex's "Algebraic structures: ..." would be the summary of
  # +Monoid+.
  let pageFor(source: String, items: [Kex.AST.Node], header: String) -> SourcePage do
    let detached = detachHeader(items, header)
    let entities = fileEntities(detached)
    return SourcePage {
      source: source,
      urlPath: stripExt(source),
      title: pageTitle(source, entities),
      entities: entities,
      intro: header
    }
  end

  # Returns the items with the header removed from the first documented one.
  let detachHeader(items: [Kex.AST.Node], header: String) -> [Kex.AST.Node] do
    return items if header.trim.empty?
    match items.findIndex { |item| docOf(item) != None } do
      None => items
      Just(index) => items.mapIndexed { |item, i|
        i == index then withoutHeader(item, header) else item
      }
    end
  end

  let withoutHeader(item: Kex.AST.Node, header: String) -> Kex.AST.Node do
    let doc = docOf(item).or("")
    let head = header.trim
    # A doc that does not start with the header keeps everything: the header
    # then belongs to the page alone.
    return item if !doc.trim.startsWith?(head)
    let remaining = doc.trim.drop(head.count).trim
    return withDoc(item, remaining.empty? then None else Just(remaining))
  end

  let docOf(item: Kex.AST.Node) -> String? do
    match item do
      TypeDef(info) => info.doc
      RecordDef(info) => info.doc
      TraitDef(info) => info.doc
      MakeDef(info) => info.doc
      ModuleDef(info) => info.doc
      TypeAnnotation(info) => info.doc
      FunctionDef(info) => info.doc
      ConstantDef(info) => info.doc
      _ => None
    end
  end

  let withDoc(item: Kex.AST.Node, doc: String?) -> Kex.AST.Node do
    match item do
      TypeDef(info) => TypeDef(Kex.AST.TypeInfo { ...info, doc: doc })
      RecordDef(info) => RecordDef(Kex.AST.RecordInfo { ...info, doc: doc })
      TraitDef(info) => TraitDef(Kex.AST.TraitInfo { ...info, doc: doc })
      MakeDef(info) => MakeDef(Kex.AST.MakeInfo { ...info, doc: doc })
      ModuleDef(info) => ModuleDef(Kex.AST.ModuleInfo { ...info, doc: doc })
      TypeAnnotation(info) => TypeAnnotation(Kex.AST.AnnotationInfo { ...info, doc: doc })
      FunctionDef(info) => FunctionDef(Kex.AST.FunctionInfo { ...info, doc: doc })
      ConstantDef(info) => ConstantDef(Kex.AST.ConstantInfo { ...info, doc: doc })
      _ => item
    end
  end

  # Returns a page's title: the name of the declaration the file is about,
  # spelled as the source spells it ("OptionParser", "FileHandle").
  #
  # The title is a single top-level module if there is one, else a single
  # top-level type, record or trait, else a declaration named like the file,
  # else the file name in PascalCase.
  let pageTitle(source: String, entities: [Entity]) -> String do
    let tops = entities.into { |e|
      match e do
        ModuleDecl(entry) => [entry]
        _ => []
      end
    }
    if tops.count == 1
      match tops.first do
        Just(entry) => return moduleTitle(entry, fileStem(stripExt(source)))
        None => return ""
      end
    end
    let primaries = entities.into { |e|
      match e do
        TypeDecl(entry) => [entry.name]
        RecordDecl(entry) => [entry.name]
        TraitDecl(entry) => [entry.name]
        _ => []
      end
    }.uniq
    if primaries.count == 1
      return primaries.first.or("")
    end
    # Several declarations, so prefer one named like the file: file_handle.kex
    # declaring `FileHandle` is titled "FileHandle", not "Filehandle".
    let stem = stripExt(source)
    let named = entities.map { |e| baseSpelling(nameOf(e)) }.filter { |name|
      namesStem?(name, fileStem(stem))
    }
    return named.first.or(stem.pascalCase)
  end

  # Returns +true+ when +name+ is the name a file stem spells, ignoring case
  # and underscores: +file_handle+ names +FileHandle+ (kexhq/kex#721), and
  # +dns+ names +DNS+.
  let namesStem?(name: String, stem: String) -> Bool do
    return name.lowerCase == stem.pascalCase.lowerCase
  end

  # Returns the part of a name a file could be named after:
  # "FileHandle<CanRead, W>" gives "FileHandle", and "FS.Path" gives "Path".
  let baseSpelling(name: String) -> String do
    return (name.split("<").first.or("")).split(".").last.or("")
  end

  # Returns the title of a file with one top-level module.
  #
  # The file name matters when several files share a module: data/queue.kex,
  # set.kex and stack.kex all wrap their module in +module Data+, and titling
  # each page "Data" would make the sidebar entries identical. So the title
  # is the module if its last segment matches the file name ("dns.kex" gives
  # Net.DNS), else a nested module that matches ("queue.kex" gives
  # Data.Queue), else the top module ("mock.kex" gives Mock).
  let moduleTitle(entry: ModuleEntry, stem: String) -> String do
    return entry.qualifiedName if lastSegmentMatches?(entry.qualifiedName, stem)
    match nestedModuleNamed(entry.children, stem) do
      Just(qualified) => return qualified
      None => return entry.qualifiedName
    end
  end

  let lastSegmentMatches?(qualifiedName: String, stem: String) -> Bool do
    return namesStem?(qualifiedName.split(".").last.or(""), stem)
  end

  let nestedModuleNamed(children: [Entity], stem: String) -> String? do
    match children.find { |c| namesStem?(nameOf(c), stem) } do
      Just(child) => Just(qualifiedNameOf(child))
      None => None
    end
  end

  # Returns the last segment of a path: "kex/ast" gives "ast".
  let fileStem(path: String) -> String do
    return path.split("/").last.or(path)
  end

  let entitiesIn(body: [Kex.AST.Node], prefix: String) -> [Entity] do
    return finalize(bodyEntities(body, prefix, []))
  end

  # An accumulator entry: a finished entity, or a function still collecting
  # its clauses.
  type Pending
    = Done(Entity)
    | PendingFn(PendingFunction)

  record PendingFunction do
    name : String
    qualifiedName : String
    annotations : [Kex.AST.AnnotationInfo]
    paramLists : [[ParamSig]]
    clauseCount : Integer
    doc : Doc
    line : Integer
    # The return type a clause declares inline (`-> This`), if any.
    returnType : String = ""
    # Whether any clause is declared `foul`.
    foul? : Bool = false
  end

  # One parameter as a clause declares it. +named?+ is +false+ for a pattern
  # parameter (+let repeat(0) = ...+), whose spelling is a value that a
  # signature should not show as a name.
  record ParamSig do
    name : String
    typeName : String
    named? : Bool
    default? : Bool
  end

  let bodyEntities(body: [Kex.AST.Node], prefix: String, accum: [Pending]) -> [Pending] do
    if body.empty?
      return accum
    end
    let [head | rest] = body
    match head do
      TypeDef(info) => bodyEntities(rest, prefix, accum + [Done(typeEntity(info, prefix))])
      RecordDef(info) => bodyEntities(rest, prefix, accum + [Done(recordEntity(info, prefix))])
      TraitDef(info) => bodyEntities(rest, prefix, accum + [Done(traitEntity(info, prefix))])
      MakeDef(info) => bodyEntities(rest, prefix, accum + [Done(makeEntity(info))])
      ModuleDef(info) => bodyEntities(rest, prefix, accum + [Done(moduleEntity(info, prefix))])
      TypeAnnotation(info) => bodyEntities(rest, prefix, noteAnnotation(accum, info, prefix))
      FunctionDef(info) => bodyEntities(rest, prefix, noteFunction(accum, info, prefix))
      ConstantDef(info) => bodyEntities(rest, prefix, accum + [Done(constantEntity(info, prefix))])
      _ => bodyEntities(rest, prefix, accum)
    end
  end

  let finalize(accum: [Pending]) -> [Entity] do
    return mergeMakes(accum.map { |p| finalizeOne(p) })
  end

  # Merges make blocks with the same target in one file, appending the later
  # block's traits and functions to the first. Two +make Queue<A>+ blocks,
  # one for the collection traits and one for +Blankable+, read as one set of
  # functions.
  let mergeMakes(entities: [Entity]) -> [Entity] do
    return entities.reduce([], { |acc, e|
      match e do
        MakeDecl(entry) => match acc.findIndex { |a| sameMakeTarget?(a, entry.target) } do
          Just(index) => acc.mapIndexed { |a, i| i == index then absorbMake(a, entry) else a }
          None => acc + [e]
        end
        _ => acc + [e]
      end
    })
  end

  let sameMakeTarget?(e: Entity, target: String) -> Bool do
    match e do
      MakeDecl(entry) => entry.target == target
      _ => false
    end
  end

  let absorbMake(e: Entity, later: MakeEntry) -> Entity do
    match e do
      MakeDecl(first) => MakeDecl(MakeEntry {
        target: first.target,
        final?: first.final? || later.final?,
        implements: (first.implements + later.implements).uniq,
        functions: first.functions + later.functions,
        doc: first.doc.summary.empty? then later.doc else first.doc,
        line: first.line
      })
      _ => e
    end
  end

  let finalizeOne(p: Pending) -> Entity do
    match p do
      Done(entity) => entity
      PendingFn(fn) => FuncDecl(finalizeFunction(fn))
    end
  end

  let typeEntity(info: Kex.AST.TypeInfo, prefix: String) -> Entity do
    let variants = match info.variants do
      Just(vs) => Just(vs.map { |v| variantEntry(v) })
      None => None
    end
    return TypeDecl(TypeEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      parents: info.parents.map { |p| typeText(p) },
      variants: variants,
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  # Converts one variant. It is a named function so that the element type of
  # +v.fields+ comes from +VariantInfo+, not from +VariantEntry+'s +[String]+.
  let variantEntry(v: Kex.AST.VariantInfo) -> VariantEntry do
    return VariantEntry { name: v.name, fields: v.fields.map { |f| typeText(f) } }
  end

  let recordEntity(info: Kex.AST.RecordInfo, prefix: String) -> Entity do
    return RecordDecl(RecordEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      fields: info.fields.map { |f|
        FieldEntry { name: f.name, typeName: fieldTypeName(f), default?: f.default? }
      },
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  let traitEntity(info: Kex.AST.TraitInfo, prefix: String) -> Entity do
    return TraitDecl(TraitEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      functions: functionEntries(info.body, qualify(prefix, info.name), false),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  let makeEntity(info: Kex.AST.MakeInfo) -> Entity do
    return MakeDecl(MakeEntry {
      target: typeText(info.target),
      final?: info.final?,
      implements: info.implements.map { |t| typeText(t) },
      # Members are qualified by the type they extend, so search shows
      # `List.first` rather than `[X].first`.
      functions: functionEntries(info.body, Tey.Docgen.Model.baseTypeOf(typeText(info.target)), true),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  let moduleEntity(info: Kex.AST.ModuleInfo, prefix: String) -> Entity do
    let nested = qualify(prefix, info.name)
    return ModuleDecl(ModuleEntry {
      name: info.name,
      qualifiedName: nested,
      children: entitiesIn(info.items, nested),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  let constantEntity(info: Kex.AST.ConstantInfo, prefix: String) -> Entity do
    return ConstDecl(ConstantEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeName: annotationTypeOf(info),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  let functionEntries(body: [Kex.AST.Node], prefix: String, receiverMethods: Bool) -> [FunctionEntry] do
    let entities = entitiesIn(body, prefix)
    let grouped = entities.map { |e|
      match e do
        FuncDecl(fn) => [fn]
        ConstDecl(entry) => if receiverMethods
          [FunctionEntry {
            name: entry.name, qualifiedName: entry.qualifiedName,
            signatures: entry.typeName.empty? then [] else ["${entry.name} -> ${entry.typeName}"],
            clauseCount: 1, doc: entry.doc, line: entry.line
          }]
        else
          []
        end
        _ => []
      end
    }
    return grouped.reduce([], { |accum, group| accum + group })
  end

  let noteAnnotation(accum: [Pending], info: Kex.AST.AnnotationInfo, prefix: String) -> [Pending] do
    match findPending(accum, info.name) do
      None => accum + [PendingFn(PendingFunction {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        annotations: [info],
        paramLists: [],
        clauseCount: 0,
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line
      })]
      Just(_) => accum.map { |p| addAnnotation(p, info) }
    end
  end

  let addAnnotation(p: Pending, info: Kex.AST.AnnotationInfo) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        return PendingFn(PendingFunction {
          name: fn.name,
          qualifiedName: fn.qualifiedName,
          annotations: fn.annotations + [info],
          paramLists: fn.paramLists,
          clauseCount: fn.clauseCount,
          doc: doc,
          line: fn.line,
          returnType: fn.returnType,
          foul?: fn.foul?
        })
      end
      _ => p
    end
  end

  let noteFunction(accum: [Pending], info: Kex.AST.FunctionInfo, prefix: String) -> [Pending] do
    # A module-level `let NAME = value` arrives as a zero-clause-param
    # function whose clause has NO parameter list — that, not arity, is what
    # distinguishes it from `foul f() = ...` (empty list, but present).
    # Document it as the constant it is.
    if constantBinding?(info)
      return noteConstant(accum, info, prefix)
    end
    let lists = info.clauses.map { |c| clauseParams(c) }
    match findPending(accum, info.name) do
      None => accum + [PendingFn(PendingFunction {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        annotations: [],
        paramLists: lists,
        clauseCount: info.clauses.count,
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line,
        returnType: returnTypeText(info),
        foul?: info.foul?
      })]
      Just(_) => accum.map { |p| addClause(p, info, lists) }
    end
  end

  # Returns +true+ for a binding with no parameter list that is not +foul+.
  #
  # A +foul+ binding with no parameter list is a zero-argument function that
  # Kex calls each time it is named: +IO.getLine+ reads a new line every time,
  # so it is documented as a function. +IO.out+, always the same handle, is a
  # constant.
  let constantBinding?(info: Kex.AST.FunctionInfo) -> Bool do
    if info.foul?
      return false
    end
    match info.clauses.first do
      Just(clause) => !clause.paramList?
      None => false
    end
  end

  let noteConstant(accum: [Pending], info: Kex.AST.FunctionInfo, prefix: String) -> [Pending] do
    match findPending(accum, info.name) do
      None => accum + [Done(ConstDecl(ConstantEntry {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        typeName: returnTypeText(info),
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line
      }))]
      Just(_) => accum.map { |p| constantFromPending(p, info, prefix) }
    end
  end

  # Replaces the +PendingFunction+ an earlier annotation created with a
  # constant entry, keeping its name, doc and line.
  let constantFromPending(p: Pending, info: Kex.AST.FunctionInfo, prefix: String) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        # `foul printError = ...` sitting under `foul printError(msg) = ...`
        # is that function's zero-argument CLAUSE — the no-argument spelling
        # Kex auto-calls — not a constant. Once parameter lists have been
        # seen for a name, the name is a function and stays one.
        if !fn.paramLists.empty?
          return PendingFn(PendingFunction {
            name: fn.name,
            qualifiedName: fn.qualifiedName,
            annotations: fn.annotations,
            paramLists: fn.paramLists,
            clauseCount: fn.clauseCount + info.clauses.count,
            doc: fn.doc,
            line: fn.line,
            returnType: fn.returnType,
            foul?: fn.foul? || info.foul?
          })
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        let typeName = match fn.annotations.first do
          Just(a) => typeText(annotationRef(a))
          None => returnTypeText(info)
        end
        return Done(ConstDecl(ConstantEntry {
          name: fn.name,
          qualifiedName: qualify(prefix, fn.name),
          typeName: typeName,
          doc: doc,
          line: fn.line
        }))
      end
      Done(_) => p
    end
  end

  let returnTypeText(info: Kex.AST.FunctionInfo) -> String do
    let declared = info.clauses.into { |clause|
      match clause.returnType do
        Just(ref) => [signatureTypeText(ref)]
        None => []
      end
    }
    return declared.first.or("")
  end

  let addClause(p: Pending, info: Kex.AST.FunctionInfo, lists: [[ParamSig]]) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        let declared = returnTypeText(info)
        return PendingFn(PendingFunction {
          name: fn.name,
          qualifiedName: fn.qualifiedName,
          annotations: fn.annotations,
          paramLists: fn.paramLists + lists,
          clauseCount: fn.clauseCount + info.clauses.count,
          doc: doc,
          line: fn.line,
          returnType: fn.returnType.empty? then declared else fn.returnType,
          foul?: fn.foul? || info.foul?
        })
      end
      _ => p
    end
  end

  let findPending(accum: [Pending], name: String) -> Integer? do
    return indexedFind(accum, name, 0)
  end

  let indexedFind(accum: [Pending], name: String, index: Integer) -> Integer? do
    if accum.empty?
      return None
    end
    let [head | rest] = accum
    match head do
      PendingFn(fn) => if fn.name == name then Just(index) else indexedFind(rest, name, index + 1) end
      _ => indexedFind(rest, name, index + 1)
    end
  end

  let finalizeFunction(fn: PendingFunction) -> FunctionEntry do
    return FunctionEntry {
      name: fn.name,
      qualifiedName: fn.qualifiedName,
      signatures: signatureTexts(fn),
      clauseCount: fn.clauseCount,
      doc: fn.doc,
      line: fn.line,
      types: functionTypes(fn),
      returnType: declaredReturn(fn),
      foul?: fn.foul?
    }
  end

  # Returns the return type the source declares: the annotation's result, or
  # the inline +-> T+ of an unannotated clause. The +@return+ tag is checked
  # against it (+Index.reportDocDrift+) and never shown in its place.
  let declaredReturn(fn: PendingFunction) -> String do
    match fn.annotations.first do
      Just(a) => do
        let ref = annotationRef(a)
        let arity = match bestParams(matchingParamLists(ref, fn.paramLists)) do
          Just(ps) => ps.count
          None => 0
        end
        match flattenToArity(ref, arity) do
          FunctionType(params, result) => arity > 0 && params.count == arity then signatureTypeText(result) else signatureTypeText(finalResult(ref))
          other => signatureTypeText(other)
        end
      end
      None => fn.returnType.empty? then docReturnType(fn.doc) else fn.returnType
    end
  end

  # Returns the final result of a curried type: for +A -> (A -> T -> A) -> A+
  # it is +A+.
  let finalResult(ref: Kex.AST.TypeRef) -> Kex.AST.TypeRef do
    match ref do
      FunctionType(_, result) => finalResult(result)
      _ => ref
    end
  end

  let docReturnType(doc: Doc) -> String do
    match doc.returns do
      Just(r) => r.typeName
      None => ""
    end
  end

  # Returns the type names a function mentions: every parameter type and the
  # result type of each annotation, without duplicates. Search uses them to
  # find every function that takes or returns +Integer+.
  let functionTypes(fn: PendingFunction) -> [String] do
    let per = fn.annotations.map { |a| annotationTypes(a, fn.paramLists) }
    let inline = fn.paramLists.flatten.map { |p| p.typeName }
    let declared = fn.returnType.empty? then [] else [fn.returnType]
    return (per.flatten + inline + declared).reject { |t| t.empty? }.uniq
  end

  let annotationTypes(info: Kex.AST.AnnotationInfo, paramLists: [[ParamSig]]) -> [String] do
    let ref = annotationRef(info)
    match matchingParamList(ref, paramLists) do
      Just(names) => match flattenToArity(ref, names.count) do
        FunctionType(params, result) => params.map { |p| typeText(p) } + [typeText(result)]
        _ => []
      end
      # A required trait function has no clause to pair with; keep its whole
      # type as one string so search still finds it.
      None => [typeText(ref)]
    end
  end

  # Returns the signatures shown for a function, one per annotation.
  #
  # A signature names every parameter with its type and ends in the result:
  # +and(a: Integer, b: Integer) -> Integer+. The names come from a clause.
  # The types come from the annotation (flattened to the clause's arity),
  # from the clause's inline annotations, or, for an unannotated function,
  # from its +@param+ and +@return+ tags. A function with no parameters is
  # written as its definition is (+let sum -> Number+ gives +sum -> Number+);
  # the +name : Type+ form is kept for constants. A required trait function
  # has no clause, only a type, and takes its parameter names from its
  # +@param+ tags when the counts match.
  let signatureTexts(fn: PendingFunction) -> [String] do
    if fn.annotations.empty?
      return match bestParams(fn.paramLists) do
        Just(params) => [plainSignature(fn, params)]
        None => []
      end
    end
    return fn.annotations.map { |a| renderSignature(a, fn) }
  end

  # Builds a signature from the clause alone: inline types first, then the
  # doc tags, and bare names when neither gives a type.
  let plainSignature(fn: PendingFunction, params: [ParamSig]) -> String do
    let result = fn.returnType.empty? then docReturnType(fn.doc) else fn.returnType
    if params.empty?
      return result.empty? then fn.name else "${fn.name} -> ${result}"
    end
    let shown = params.mapIndexed { |p, i|
      let typeName = p.typeName.empty? then docParamType(fn.doc, displayName(p, i, fn)) else p.typeName
      paramText(displayName(p, i, fn), typeName, p.default?)
    }
    let tail = result.empty? then "" else " -> ${result}"
    return "${fn.name}(${shown.join(", ")})${tail}"
  end

  let renderSignature(info: Kex.AST.AnnotationInfo, fn: PendingFunction) -> String do
    let ref = annotationRef(info)
    match bestParams(matchingParamLists(ref, fn.paramLists)) do
      Just(params) => do
        if params.empty?
          return "${info.name} -> ${signatureTypeText(ref)}"
        end
        match flattenToArity(ref, params.count) do
          FunctionType(types, result) => do
            let shown = params.mapIndexed { |p, i|
              paramText(displayName(p, i, fn), signatureParamText(types.at(i).or(Kex.AST.AnyType)), p.default?)
            }
            return "${info.name}(${shown.join(", ")}) -> ${signatureTypeText(result)}"
          end
          _ => return "${info.name} ${annotationSigil(info)} ${signatureTypeText(ref)}"
        end
      end
      None => return docNamedSignature(info.name, ref, fn.doc)
    end
  end

  # Builds a signature for an annotation with no clause, naming the
  # parameters from the +@param+ tags when there are exactly as many tags as
  # the type has parameters.
  let docNamedSignature(name: String, ref: Kex.AST.TypeRef, doc: Doc) -> String do
    let arity = doc.params.count
    let plain = unnamedSignature(name, ref)
    return plain if arity == 0
    match flattenToArity(ref, arity) do
      FunctionType(types, result) => do
        return plain if types.count != arity
        let shown = doc.params.mapIndexed { |p, i|
          paramText(p.name, signatureParamText(types.at(i).or(Kex.AST.AnyType)), false)
        }
        return "${name}(${shown.join(", ")}) -> ${signatureTypeText(result)}"
      end
      _ => return plain
    end
  end

  # Returns the sigil an annotation was written with. A type that cannot be
  # paired with a clause is shown as written, and +:>+ is what says the
  # receiver is implied; a plain +:+ would describe a function with no
  # receiver.
  let annotationSigil(info: Kex.AST.AnnotationInfo) -> String do
    return info.implicitThis? then ":>" else ":"
  end

  # Builds a signature with types but no parameter names, such as
  # +combine(This) -> This+, or +lines -> [String]+ when there are no
  # parameters.
  let unnamedSignature(name: String, ref: Kex.AST.TypeRef) -> String do
    match ref do
      FunctionType(types, result) => "${name}(${types.map { |t| signatureParamText(t) }.join(", ")}) -> ${signatureTypeText(result)}"
      _ => "${name} -> ${signatureTypeText(ref)}"
    end
  end

  let paramText(name: String, typeName: String, optional: Bool) -> String do
    let base = typeName.empty? then name else "${name}: ${parenthesized(typeName)}"
    return optional then "${base} = …" else base
  end

  # Wraps a function type in parentheses, so a parameter reads
  # +f: (T -> Void)+.
  let parenthesized(typeName: String) -> String do
    return typeName if !typeName.contains?("->") || (typeName.startsWith?("(") && typeName.endsWith?(")"))
    return "(${typeName})"
  end

  # Returns the name shown for a parameter. A pattern parameter
  # (+repeat(0)+) shows the name its +@param+ tag gives that position, or
  # +_+, since the literal would read as an argument.
  let displayName(p: ParamSig, index: Integer, fn: PendingFunction) -> String do
    return p.name if p.named? || (fn.name == ConversionName && typeArgument?(p.name))
    match fn.doc.params.at(index) do
      Just(tag) => tag.name
      None => "_"
    end
  end

  # The conversion function's name. In +value.to(String)+ the argument is the
  # type itself, so that clause's capitalised pattern is shown as written.
  # Anywhere else a capitalised pattern is a constructor being matched
  # (+None+) and is not shown.
  let ConversionName = "to"

  let typeArgument?(pattern: String) -> Bool do
    return pattern.take(1).chars.all? { |c| c.upper? } && !pattern.empty? && pattern.chars.all? { |c| c.letter? || c.digit? || c == '.' }
  end

  let docParamType(doc: Doc, name: String) -> String do
    match doc.params.find { |p| p.name == name } do
      Just(p) => p.typeName
      None => ""
    end
  end

  # Returns, of several clauses' parameter lists, the one that names the most
  # parameters (+repeat(n: Integer)+ over +repeat(0)+), with types filled in
  # from the other clauses of the same arity.
  let bestParams(lists: [[ParamSig]]) -> [ParamSig]? do
    match lists.first do
      None => None
      Just(first) => do
        let best = lists.reduce(first, { |acc, list| namedCount(list) > namedCount(acc) then list else acc })
        let peers = lists.filter { |list| list.count == best.count }
        return Just(best.mapIndexed { |p, i| withPeerType(p, i, peers) })
      end
    end
  end

  let namedCount(list: [ParamSig]) -> Integer do
    return list.filter { |p| p.named? }.count
  end

  let withPeerType(p: ParamSig, index: Integer, peers: [[ParamSig]]) -> ParamSig do
    return p if !p.typeName.empty?
    let typed = peers.into { |list|
      match list.at(index) do
        Just(q) => q.typeName.empty? then [] else [q.typeName]
        None => []
      end
    }
    return ParamSig { ...p, typeName: typed.first.or("") }
  end

  # Renders a type as source would write it: arrows chain to the right
  # without the extra parentheses +typeRefText+ adds, and a function-typed
  # parameter is parenthesized, so +(X -> Y) -> Z+ stays distinct from
  # +X -> Y -> Z+.
  let signatureTypeText(ref: Kex.AST.TypeRef) -> String do
    match ref do
      FunctionType(params, result) =>
        "${params.map { |p| signatureParamText(p) }.join(", ")} -> ${signatureTypeText(result)}"
      _ => typeText(ref)
    end
  end

  let signatureParamText(p: Kex.AST.TypeRef) -> String do
    match p do
      FunctionType(_, _) => "(${signatureTypeText(p)})"
      _ => typeText(p)
    end
  end

  let annotationRef(info: Kex.AST.AnnotationInfo) -> Kex.AST.TypeRef do
    match info do
      Kex.AST.AnnotationInfo { type: t } => t
    end
  end

  let matchingParamList(ref: Kex.AST.TypeRef, paramLists: [[ParamSig]]) -> [ParamSig]? do
    return paramLists.find { |names| paramsMatch?(ref, names) }
  end

  let matchingParamLists(ref: Kex.AST.TypeRef, paramLists: [[ParamSig]]) -> [[ParamSig]] do
    return paramLists.filter { |names| paramsMatch?(ref, names) }
  end

  let paramsMatch?(ref: Kex.AST.TypeRef, names: [ParamSig]) -> Bool do
    match flattenToArity(ref, names.count) do
      FunctionType(params, _) => params.count == names.count
      _ => names.empty?
    end
  end

  # Merges curried layers until the type takes +arity+ arguments:
  # +FilePath -> Read -> Mode -> R+ with arity 3 becomes
  # +(FilePath, Read, Mode) -> R+. A type that runs out of layers, or whose
  # next layer would overshoot, is left as it is.
  let flattenToArity(ref: Kex.AST.TypeRef, arity: Integer) -> Kex.AST.TypeRef do
    match ref do
      FunctionType(params, FunctionType(innerParams, innerResult)) => do
        return ref if params.count >= arity
        return flattenToArity(FunctionType(params + innerParams, innerResult), arity)
      end
      _ => ref
    end
  end

  # Returns a clause's parameters, leaving out a receiver pattern: in
  # +let factor(@Nanosecond) = ...+ the pattern picks the clause and is not
  # something a caller passes.
  let clauseParams(clause: Kex.AST.ClauseInfo) -> [ParamSig] do
    return clause.params.reject { |p| receiverPattern?(p) }.map { |p| paramSig(p) }
  end

  let receiverPattern?(p: Kex.AST.ParamInfo) -> Bool do
    match p do
      Kex.AST.ParamInfo { name: None, pattern: Just(ThisPattern(_)) } => true
      _ => false
    end
  end

  let paramSig(p: Kex.AST.ParamInfo) -> ParamSig do
    let typeName = match p do
      Kex.AST.ParamInfo { type: Just(t) } => signatureParamText(t)
      _ => ""
    end
    let named = match p do
      Kex.AST.ParamInfo { name: Just(_) } => true
      _ => false
    end
    return ParamSig { name: paramName(p), typeName: typeName, named?: named, default?: p.default? }
  end

  let paramName(p: Kex.AST.ParamInfo) -> String do
    match p do
      Kex.AST.ParamInfo { name: Just(n) } => n
      Kex.AST.ParamInfo { name: None, pattern: Just(pattern) } => Kex.AST.patternRefText(pattern)
      _ => "_"
    end
  end

  let annotationTypeOf(info: Kex.AST.ConstantInfo) -> String do
    match info do
      Kex.AST.ConstantInfo { type: Just(t) } => typeText(t)
      _ => ""
    end
  end

  let fieldTypeName(f: Kex.AST.FieldInfo) -> String do
    match f do
      Kex.AST.FieldInfo { type: t } => typeText(t)
    end
  end

  let typeText(ref: Kex.AST.TypeRef) -> String do
    return Kex.AST.typeRefText(ref)
  end

  let typeTextOpt(ref: Kex.AST.TypeRef?) -> String do
    match ref do
      Just(r) => Kex.AST.typeRefText(r)
      None => "?"
    end
  end

  # Prefixes +name+ with its parent module's name. A module may be written
  # fully qualified (+module FS.File do+ inside +module FS do+), so a name
  # that already starts with the prefix is left alone.
  let qualify(prefix: String, name: String) -> String do
    if prefix.empty? || name.startsWith?("${prefix}.")
      return name
    end
    return "${prefix}.${name}"
  end

  let stripExt(name: String) -> String do
    return name.take(name.count - 4) if name.endsWith?(".kex")
    return name
  end
end
