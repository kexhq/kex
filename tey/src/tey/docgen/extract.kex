# Kex.AST nodes → the typed entity model (Tey.Docgen.Model).
#
# Declaration bodies interleave TypeAnnotations (`name : type`) with
# FunctionDefs (`let name(args) ...`); overloads repeat both. Functions are
# collected per name as PendingFunction records (annotations + parameter
# lists kept apart), then finalised once the body is fully walked, because
# pairing an annotation's curried type with a clause's parameter names needs
# both sides.

module Tey.Docgen.Extract do
  using Tey.Docgen.Model, only: [Entity, TypeDecl, RecordDecl, TraitDecl, MakeDecl, ModuleDecl, FuncDecl, ConstDecl, TypeEntry, RecordEntry, TraitEntry, MakeEntry, ModuleEntry, FunctionEntry, ConstantEntry, VariantEntry, FieldEntry, SourcePage, Doc, nameOf, qualifiedNameOf]

  foul fileEntities(items: [Kex.AST.Node]) -> [Entity] do
    return entitiesIn(items, "")
  end

  # `header` is the file's opening comment when a blank line separates it
  # from what follows (Index.fileHeader). The AST reader attaches every
  # comment above a declaration to it, blank lines and all, so the first
  # declaration's doc arrives with the file's introduction glued on top —
  # algebra.kex's "Algebraic structures: ..." read as the summary of
  # `Monoid`. The header is cut off that doc here and kept as the page's
  # own intro.
  foul pageFor(source: String, items: [Kex.AST.Node], header: String) -> SourcePage do
    let detached = detachHeader(items, header)
    let entities = fileEntities(detached)
    return SourcePage {
      source: source,
      urlPath: stripExt(source),
      title: pageTitle(source, entities),
      entities: entities,
      intro: header
    }
  end

  # The items with the header removed from the first documented one.
  foul detachHeader(items: [Kex.AST.Node], header: String) -> [Kex.AST.Node] do
    return items if header.trim.empty?
    match items.findIndex { |item| docOf(item) != None } do
      None => items
      Just(index) => items.mapIndexed { |item, i|
        i == index then withoutHeader(item, header) else item
      }
    end
  end

  foul withoutHeader(item: Kex.AST.Node, header: String) -> Kex.AST.Node do
    let doc = docOf(item).or("")
    let head = header.trim
    # A doc that does not start with the header keeps everything: the header
    # then belongs to the page alone.
    return item if !doc.trim.startsWith?(head)
    let remaining = doc.trim.drop(head.count).trim
    return withDoc(item, remaining.empty? then None else Just(remaining))
  end

  foul docOf(item: Kex.AST.Node) -> String? do
    match item do
      TypeDef(info) => info.doc
      RecordDef(info) => info.doc
      TraitDef(info) => info.doc
      MakeDef(info) => info.doc
      ModuleDef(info) => info.doc
      TypeAnnotation(info) => info.doc
      FunctionDef(info) => info.doc
      ConstantDef(info) => info.doc
      _ => None
    end
  end

  foul withDoc(item: Kex.AST.Node, doc: String?) -> Kex.AST.Node do
    match item do
      TypeDef(info) => TypeDef(Kex.AST.TypeInfo { ...info, doc: doc })
      RecordDef(info) => RecordDef(Kex.AST.RecordInfo { ...info, doc: doc })
      TraitDef(info) => TraitDef(Kex.AST.TraitInfo { ...info, doc: doc })
      MakeDef(info) => MakeDef(Kex.AST.MakeInfo { ...info, doc: doc })
      ModuleDef(info) => ModuleDef(Kex.AST.ModuleInfo { ...info, doc: doc })
      TypeAnnotation(info) => TypeAnnotation(Kex.AST.AnnotationInfo { ...info, doc: doc })
      FunctionDef(info) => FunctionDef(Kex.AST.FunctionInfo { ...info, doc: doc })
      ConstantDef(info) => ConstantDef(Kex.AST.ConstantInfo { ...info, doc: doc })
      _ => item
    end
  end

  # A page's title is the declaration it is really about — "OptionParser",
  # not the file name's "Optionparser", and "FileHandle", not "Filehandle".
  # Preference order: a single top-level module, then a single top-level
  # type/record/trait, then the file name title-cased.
  foul pageTitle(source: String, entities: [Entity]) -> String do
    let tops = entities.flatMap { |e|
      match e do
        ModuleDecl(entry) => [entry]
        _ => []
      end
    }
    if tops.count == 1
      match tops.first do
        Just(entry) => return moduleTitle(entry, fileStem(stripExt(source)))
        None => return ""
      end
    end
    let primaries = entities.flatMap { |e|
      match e do
        TypeDecl(entry) => [entry.name]
        RecordDecl(entry) => [entry.name]
        TraitDecl(entry) => [entry.name]
        _ => []
      end
    }.uniq
    if primaries.count == 1
      return primaries.first.or("")
    end
    # Several declarations, so nothing is obviously THE one — but a file named
    # filehandle.kex that declares `FileHandle` is about FileHandle, and the
    # source's own spelling beats a title-cased file name ("Filehandle").
    let stem = stripExt(source)
    let named = entities.map { |e| baseSpelling(nameOf(e)) }.filter { |name|
      name.lowerCase == fileStem(stem).lowerCase
    }
    return named.first.or(titleCase(stem))
  end

  # "FileHandle<CanRead, W>" -> "FileHandle", "FS.Path" -> "Path": what the
  # file could plausibly be named after.
  foul baseSpelling(name: String) -> String do
    return (name.split("<").first.or("")).split(".").last.or("")
  end

  # The title of a file with one top-level module. The file's stem has a
  # say when the module is shared across several files: data/queue.kex
  # declares `module Data` around `module Queue`, and so do set.kex and
  # stack.kex — without the stem, every one of those pages is titled
  # "Data" and the sidebar shows indistinguishable entries. A module whose
  # last segment matches the stem is the page ("dns.kex" -> Net.DNS); else
  # a nested module matching it is ("queue.kex" -> Data.Queue); else the
  # top module stands ("mock.kex" -> Mock, a file about the family).
  foul moduleTitle(entry: ModuleEntry, stem: String) -> String do
    return entry.qualifiedName if lastSegmentMatches?(entry.qualifiedName, stem)
    match nestedModuleNamed(entry.children, stem) do
      Just(qualified) => return qualified
      None => return entry.qualifiedName
    end
  end

  foul lastSegmentMatches?(qualifiedName: String, stem: String) -> Bool do
    return (qualifiedName.split(".").last.or("")).lowerCase == stem.lowerCase
  end

  foul nestedModuleNamed(children: [Entity], stem: String) -> String? do
    match children.find { |c| nameOf(c).lowerCase == stem.lowerCase } do
      Just(child) => Just(qualifiedNameOf(child))
      None => None
    end
  end

  # "kex/ast" -> "ast".
  foul fileStem(path: String) -> String do
    return path.split("/").last.or(path)
  end

  foul entitiesIn(body: [Kex.AST.Node], prefix: String) -> [Entity] do
    return finalize(bodyEntities(body, prefix, []))
  end

  # Accumulator entries: finished entities or functions still collecting.
  type Pending
    = Done(Entity)
    | PendingFn(PendingFunction)

  record PendingFunction do
    name : String
    qualifiedName : String
    annotations : [Kex.AST.AnnotationInfo]
    paramLists : [[ParamSig]]
    clauseCount : Integer
    doc : Doc
    line : Integer
    # The return type a clause declares inline (`-> This`), if any.
    returnType : String = ""
  end

  # One parameter as a clause declares it. `named` is false for a pattern
  # parameter (`let repeat(0) = ...`), whose spelling is a value, not a name
  # a signature should show.
  record ParamSig do
    name : String
    typeName : String
    named : Bool
    hasDefault : Bool
  end

  foul bodyEntities(body: [Kex.AST.Node], prefix: String, accum: [Pending]) -> [Pending] do
    if body.empty?
      return accum
    end
    let [head | rest] = body
    match head do
      TypeDef(info) => bodyEntities(rest, prefix, accum + [Done(typeEntity(info, prefix))])
      RecordDef(info) => bodyEntities(rest, prefix, accum + [Done(recordEntity(info, prefix))])
      TraitDef(info) => bodyEntities(rest, prefix, accum + [Done(traitEntity(info, prefix))])
      MakeDef(info) => bodyEntities(rest, prefix, accum + [Done(makeEntity(info))])
      ModuleDef(info) => bodyEntities(rest, prefix, accum + [Done(moduleEntity(info, prefix))])
      TypeAnnotation(info) => bodyEntities(rest, prefix, noteAnnotation(accum, info, prefix))
      FunctionDef(info) => bodyEntities(rest, prefix, noteFunction(accum, info, prefix))
      ConstantDef(info) => bodyEntities(rest, prefix, accum + [Done(constantEntity(info, prefix))])
      _ => bodyEntities(rest, prefix, accum)
    end
  end

  foul finalize(accum: [Pending]) -> [Entity] do
    return mergeMakes(accum.map { |p| finalizeOne(p) })
  end

  # Two `make Queue<A>` blocks in one file (one for the collection traits,
  # one for Blankable) are one set of methods to a reader: the later block
  # folds into the first, traits and members appended.
  foul mergeMakes(entities: [Entity]) -> [Entity] do
    return entities.reduce([], { |acc, e|
      match e do
        MakeDecl(entry) => match acc.findIndex { |a| sameMakeTarget?(a, entry.target) } do
          Just(index) => acc.mapIndexed { |a, i| i == index then absorbMake(a, entry) else a }
          None => acc + [e]
        end
        _ => acc + [e]
      end
    })
  end

  foul sameMakeTarget?(e: Entity, target: String) -> Bool do
    match e do
      MakeDecl(entry) => entry.target == target
      _ => false
    end
  end

  foul absorbMake(e: Entity, later: MakeEntry) -> Entity do
    match e do
      MakeDecl(first) => MakeDecl(MakeEntry {
        target: first.target,
        isFinal: first.isFinal || later.isFinal,
        implements: (first.implements + later.implements).uniq,
        functions: first.functions + later.functions,
        doc: first.doc.summary.empty? then later.doc else first.doc,
        line: first.line
      })
      _ => e
    end
  end

  foul finalizeOne(p: Pending) -> Entity do
    match p do
      Done(entity) => entity
      PendingFn(fn) => FuncDecl(finalizeFunction(fn))
    end
  end

  foul typeEntity(info: Kex.AST.TypeInfo, prefix: String) -> Entity do
    let variants = match info.variants do
      Just(vs) => Just(vs.map { |v| variantEntry(v) })
      None => None
    end
    return TypeDecl(TypeEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      parents: info.parents.map { |p| typeText(p) },
      variants: variants,
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  # A named helper (rather than an inline lambda) so the element type of
  # `v.fields` comes from VariantInfo, not from VariantEntry's [String].
  foul variantEntry(v: Kex.AST.VariantInfo) -> VariantEntry do
    return VariantEntry { name: v.name, fields: v.fields.map { |f| typeText(f) } }
  end

  foul recordEntity(info: Kex.AST.RecordInfo, prefix: String) -> Entity do
    return RecordDecl(RecordEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      fields: info.fields.map { |f|
        FieldEntry { name: f.name, typeName: fieldTypeName(f), hasDefault: f.hasDefault }
      },
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  foul traitEntity(info: Kex.AST.TraitInfo, prefix: String) -> Entity do
    return TraitDecl(TraitEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeParams: info.typeParams,
      functions: functionEntries(info.body, qualify(prefix, info.name), false),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  foul makeEntity(info: Kex.AST.MakeInfo) -> Entity do
    return MakeDecl(MakeEntry {
      target: typeText(info.target),
      isFinal: info.isFinal,
      implements: info.implements.map { |t| typeText(t) },
      # Members are qualified by the type they extend, so search shows
      # `List.first` rather than `[X].first`.
      functions: functionEntries(info.body, Tey.Docgen.Model.baseTypeOf(typeText(info.target)), true),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  foul moduleEntity(info: Kex.AST.ModuleInfo, prefix: String) -> Entity do
    let nested = qualify(prefix, info.name)
    return ModuleDecl(ModuleEntry {
      name: info.name,
      qualifiedName: nested,
      children: entitiesIn(info.items, nested),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  foul constantEntity(info: Kex.AST.ConstantInfo, prefix: String) -> Entity do
    return ConstDecl(ConstantEntry {
      name: info.name,
      qualifiedName: qualify(prefix, info.name),
      typeName: annotationTypeOf(info),
      doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
      line: info.location.line
    })
  end

  foul functionEntries(body: [Kex.AST.Node], prefix: String, receiverMethods: Bool) -> [FunctionEntry] do
    let entities = entitiesIn(body, prefix)
    let grouped = entities.map { |e|
      match e do
        FuncDecl(fn) => [fn]
        ConstDecl(entry) => if receiverMethods
          [FunctionEntry {
            name: entry.name, qualifiedName: entry.qualifiedName,
            signatures: entry.typeName.empty? then [] else ["${entry.name} : ${entry.typeName}"],
            clauseCount: 1, doc: entry.doc, line: entry.line
          }]
        else
          []
        end
        _ => []
      end
    }
    return grouped.reduce([], { |accum, group| accum + group })
  end

  foul noteAnnotation(accum: [Pending], info: Kex.AST.AnnotationInfo, prefix: String) -> [Pending] do
    match findPending(accum, info.name) do
      None => accum + [PendingFn(PendingFunction {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        annotations: [info],
        paramLists: [],
        clauseCount: 0,
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line
      })]
      Just(_) => accum.map { |p| addAnnotation(p, info) }
    end
  end

  foul addAnnotation(p: Pending, info: Kex.AST.AnnotationInfo) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        return PendingFn(PendingFunction {
          name: fn.name,
          qualifiedName: fn.qualifiedName,
          annotations: fn.annotations + [info],
          paramLists: fn.paramLists,
          clauseCount: fn.clauseCount,
          doc: doc,
          line: fn.line
        })
      end
      _ => p
    end
  end

  foul noteFunction(accum: [Pending], info: Kex.AST.FunctionInfo, prefix: String) -> [Pending] do
    # A module-level `let NAME = value` arrives as a zero-clause-param
    # function whose clause has NO parameter list — that, not arity, is what
    # distinguishes it from `foul f() = ...` (empty list, but present).
    # Document it as the constant it is.
    if isConstantBinding(info)
      return noteConstant(accum, info, prefix)
    end
    let lists = info.clauses.map { |c| clauseParams(c) }
    match findPending(accum, info.name) do
      None => accum + [PendingFn(PendingFunction {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        annotations: [],
        paramLists: lists,
        clauseCount: info.clauses.count,
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line,
        returnType: returnTypeText(info)
      })]
      Just(_) => accum.map { |p| addClause(p, info, lists) }
    end
  end

  # A binding with no parameter list is a constant — unless it is `foul`, in
  # which case it is a zero-argument FUNCTION that Kex auto-calls. `IO.out` is
  # a handle that is always the same one; `IO.getLine` reads a new line every
  # time it is named, and calling that a constant is a lie about both what it
  # does and when it happens.
  foul isConstantBinding(info: Kex.AST.FunctionInfo) -> Bool do
    if info.isFoul
      return false
    end
    match info.clauses.first do
      Just(clause) => !clause.hasParamList
      None => false
    end
  end

  foul noteConstant(accum: [Pending], info: Kex.AST.FunctionInfo, prefix: String) -> [Pending] do
    match findPending(accum, info.name) do
      None => accum + [Done(ConstDecl(ConstantEntry {
        name: info.name,
        qualifiedName: qualify(prefix, info.name),
        typeName: returnTypeText(info),
        doc: Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or("")),
        line: info.location.line
      }))]
      Just(_) => accum.map { |p| constantFromPending(p, info, prefix) }
    end
  end

  # The annotation arrived first and created a PendingFunction; the binding
  # now replaces it with the constant entry, keeping name/doc/line.
  foul constantFromPending(p: Pending, info: Kex.AST.FunctionInfo, prefix: String) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        # `foul printError = ...` sitting under `foul printError(msg) = ...`
        # is that function's zero-argument CLAUSE — the no-argument spelling
        # Kex auto-calls — not a constant. Once parameter lists have been
        # seen for a name, the name is a function and stays one.
        if !fn.paramLists.empty?
          return PendingFn(PendingFunction {
            name: fn.name,
            qualifiedName: fn.qualifiedName,
            annotations: fn.annotations,
            paramLists: fn.paramLists,
            clauseCount: fn.clauseCount + info.clauses.count,
            doc: fn.doc,
            line: fn.line
          })
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        let typeName = match fn.annotations.first do
          Just(a) => typeText(annotationRef(a))
          None => returnTypeText(info)
        end
        return Done(ConstDecl(ConstantEntry {
          name: fn.name,
          qualifiedName: qualify(prefix, fn.name),
          typeName: typeName,
          doc: doc,
          line: fn.line
        }))
      end
      Done(_) => p
    end
  end

  foul returnTypeText(info: Kex.AST.FunctionInfo) -> String do
    let declared = info.clauses.flatMap { |clause|
      match clause.returnType do
        Just(ref) => [signatureTypeText(ref)]
        None => []
      end
    }
    return declared.first.or("")
  end

  foul addClause(p: Pending, info: Kex.AST.FunctionInfo, lists: [[ParamSig]]) -> Pending do
    match p do
      PendingFn(fn) => do
        if fn.name != info.name
          return p
        end
        let doc = if fn.doc.summary.empty?
          Tey.Docgen.Rdoc.parseOrEmpty(info.doc.or(""))
        else
          fn.doc
        end
        let declared = returnTypeText(info)
        return PendingFn(PendingFunction {
          name: fn.name,
          qualifiedName: fn.qualifiedName,
          annotations: fn.annotations,
          paramLists: fn.paramLists + lists,
          clauseCount: fn.clauseCount + info.clauses.count,
          doc: doc,
          line: fn.line,
          returnType: fn.returnType.empty? then declared else fn.returnType
        })
      end
      _ => p
    end
  end

  foul findPending(accum: [Pending], name: String) -> Integer? do
    return indexedFind(accum, name, 0)
  end

  foul indexedFind(accum: [Pending], name: String, index: Integer) -> Integer? do
    if accum.empty?
      return None
    end
    let [head | rest] = accum
    match head do
      PendingFn(fn) => if fn.name == name then Just(index) else indexedFind(rest, name, index + 1) end
      _ => indexedFind(rest, name, index + 1)
    end
  end

  foul finalizeFunction(fn: PendingFunction) -> FunctionEntry do
    return FunctionEntry {
      name: fn.name,
      qualifiedName: fn.qualifiedName,
      signatures: signatureTexts(fn),
      clauseCount: fn.clauseCount,
      doc: fn.doc,
      line: fn.line,
      types: functionTypes(fn),
      returnType: declaredReturn(fn)
    }
  end

  # The one return type the source commits to: the annotation's result, or
  # the inline `-> T` of an unannotated clause. What the @return tag says is
  # checked against this (Index.reportDocDrift), never shown instead of it.
  foul declaredReturn(fn: PendingFunction) -> String do
    match fn.annotations.first do
      Just(a) => do
        let ref = annotationRef(a)
        let arity = match bestParams(matchingParamLists(ref, fn.paramLists)) do
          Just(ps) => ps.count
          None => 0
        end
        match flattenToArity(ref, arity) do
          FunctionType(params, result) => arity > 0 && params.count == arity then signatureTypeText(result) else signatureTypeText(finalResult(ref))
          other => signatureTypeText(other)
        end
      end
      None => fn.returnType.empty? then docReturnType(fn.doc) else fn.returnType
    end
  end

  # What a curried type finally answers: `A -> (A -> T -> A) -> A` is A.
  foul finalResult(ref: Kex.AST.TypeRef) -> Kex.AST.TypeRef do
    match ref do
      FunctionType(_, result) => finalResult(result)
      _ => ref
    end
  end

  foul docReturnType(doc: Doc) -> String do
    match doc.returns do
      Just(r) => r.typeName
      None => ""
    end
  end

  # The type names a function is about — every parameter type plus the
  # result type of each annotation, deduplicated. This is what lets search
  # answer "what touches Integer" rather than just "what is called Integer".
  foul functionTypes(fn: PendingFunction) -> [String] do
    let per = fn.annotations.map { |a| annotationTypes(a, fn.paramLists) }
    let inline = fn.paramLists.flatten.map { |p| p.typeName }
    let declared = fn.returnType.empty? then [] else [fn.returnType]
    return (per.flatten + inline + declared).reject { |t| t.empty? }.uniq
  end

  foul annotationTypes(info: Kex.AST.AnnotationInfo, paramLists: [[ParamSig]]) -> [String] do
    let ref = annotationRef(info)
    match matchingParamList(ref, paramLists) do
      Just(names) => match flattenToArity(ref, names.count) do
        FunctionType(params, result) => params.map { |p| typeText(p) } + [typeText(result)]
        _ => []
      end
      # An abstract method has no clause to pair with, but its type is still
      # the thing a reader might search for — keep it as one string.
      None => [typeText(ref)]
    end
  end

  #
  # A signature names every parameter WITH its type and ends in the result:
  # `and(a: Integer, b: Integer) -> Integer`. The names come from a clause,
  # the types from the annotation (flattened to the clause's arity), from
  # the clause's own inline annotations, or — for a method nobody annotated
  # — from its @param/@return tags. A zero-parameter member reads as the
  # property it looks like at the call site (`sum : Number`). A method with
  # no clause at all (a trait's required method) has only its type, and
  # borrows parameter names from its @param tags when they line up.

  foul signatureTexts(fn: PendingFunction) -> [String] do
    if fn.annotations.empty?
      return match bestParams(fn.paramLists) do
        Just(params) => [plainSignature(fn, params)]
        None => []
      end
    end
    return fn.annotations.map { |a| renderSignature(a, fn) }
  end

  # A signature built from the clause alone: inline types first, the doc
  # tags as the fallback, bare names when neither says.
  foul plainSignature(fn: PendingFunction, params: [ParamSig]) -> String do
    let result = fn.returnType.empty? then docReturnType(fn.doc) else fn.returnType
    if params.empty?
      return result.empty? then fn.name else "${fn.name} : ${result}"
    end
    let shown = params.mapIndexed { |p, i|
      let typeName = p.typeName.empty? then docParamType(fn.doc, displayName(p, i, fn.doc)) else p.typeName
      paramText(displayName(p, i, fn.doc), typeName, p.hasDefault)
    }
    let tail = result.empty? then "" else " -> ${result}"
    return "${fn.name}(${shown.join(", ")})${tail}"
  end

  foul renderSignature(info: Kex.AST.AnnotationInfo, fn: PendingFunction) -> String do
    let ref = annotationRef(info)
    match bestParams(matchingParamLists(ref, fn.paramLists)) do
      Just(params) => do
        if params.empty?
          return "${info.name} : ${signatureTypeText(ref)}"
        end
        match flattenToArity(ref, params.count) do
          FunctionType(types, result) => do
            let shown = params.mapIndexed { |p, i|
              paramText(displayName(p, i, fn.doc), signatureParamText(types.at(i).or(AnyType)), p.hasDefault)
            }
            return "${info.name}(${shown.join(", ")}) -> ${signatureTypeText(result)}"
          end
          _ => return "${info.name} : ${signatureTypeText(ref)}"
        end
      end
      None => return docNamedSignature(info.name, ref, fn.doc)
    end
  end

  # An annotation with no clause to take names from: the @param tags name
  # the parameters when there are exactly as many as the type has.
  foul docNamedSignature(name: String, ref: Kex.AST.TypeRef, doc: Doc) -> String do
    let arity = doc.params.count
    let plain = "${name} : ${signatureTypeText(ref)}"
    return plain if arity == 0
    match flattenToArity(ref, arity) do
      FunctionType(types, result) => do
        return plain if types.count != arity
        let shown = doc.params.mapIndexed { |p, i|
          paramText(p.name, signatureParamText(types.at(i).or(AnyType)), false)
        }
        return "${name}(${shown.join(", ")}) -> ${signatureTypeText(result)}"
      end
      _ => return plain
    end
  end

  foul paramText(name: String, typeName: String, hasDefault: Bool) -> String do
    let base = typeName.empty? then name else "${name}: ${parenthesized(typeName)}"
    return hasDefault then "${base} = …" else base
  end

  # A function type inside a parameter list reads as the parameter's type
  # only in parentheses: `f: (T -> Void)`, not `f: T -> Void`.
  foul parenthesized(typeName: String) -> String do
    return typeName if !typeName.contains?("->") || (typeName.startsWith?("(") && typeName.endsWith?(")"))
    return "(${typeName})"
  end

  # A pattern parameter (`repeat(0)`) shows the name its @param tag gives
  # that position, or `_` — never the literal, which reads as an argument.
  foul displayName(p: ParamSig, index: Integer, doc: Doc) -> String do
    return p.name if p.named
    match doc.params.at(index) do
      Just(tag) => tag.name
      None => "_"
    end
  end

  foul docParamType(doc: Doc, name: String) -> String do
    match doc.params.find { |p| p.name == name } do
      Just(p) => p.typeName
      None => ""
    end
  end

  # Of several clauses' parameter lists, the one that names the most
  # parameters — `repeat(n: Integer)` over `repeat(0)` — merged with the
  # types the other clauses of the same arity declare.
  foul bestParams(lists: [[ParamSig]]) -> [ParamSig]? do
    match lists.first do
      None => None
      Just(first) => do
        let best = lists.reduce(first, { |acc, list| namedCount(list) > namedCount(acc) then list else acc })
        let peers = lists.filter { |list| list.count == best.count }
        return Just(best.mapIndexed { |p, i| withPeerType(p, i, peers) })
      end
    end
  end

  foul namedCount(list: [ParamSig]) -> Integer do
    return list.filter { |p| p.named }.count
  end

  foul withPeerType(p: ParamSig, index: Integer, peers: [[ParamSig]]) -> ParamSig do
    return p if !p.typeName.empty?
    let typed = peers.flatMap { |list|
      match list.at(index) do
        Just(q) => q.typeName.empty? then [] else [q.typeName]
        None => []
      end
    }
    return ParamSig { ...p, typeName: typed.first.or("") }
  end

  # Source-style type text: function arrows chain to the right without the
  # redundant parentheses typeRefText adds, and a function-typed parameter is
  # parenthesized so `(X -> Y) -> Z` stays distinct from `X -> Y -> Z`.
  foul signatureTypeText(ref: Kex.AST.TypeRef) -> String do
    match ref do
      FunctionType(params, result) =>
        "${params.map { |p| signatureParamText(p) }.join(", ")} -> ${signatureTypeText(result)}"
      _ => typeText(ref)
    end
  end

  foul signatureParamText(p: Kex.AST.TypeRef) -> String do
    match p do
      FunctionType(_, _) => "(${signatureTypeText(p)})"
      _ => typeText(p)
    end
  end

  foul annotationRef(info: Kex.AST.AnnotationInfo) -> Kex.AST.TypeRef do
    match info do
      Kex.AST.AnnotationInfo { type: t } => t
    end
  end

  foul matchingParamList(ref: Kex.AST.TypeRef, paramLists: [[ParamSig]]) -> [ParamSig]? do
    return paramLists.find { |names| paramsMatch(ref, names) }
  end

  foul matchingParamLists(ref: Kex.AST.TypeRef, paramLists: [[ParamSig]]) -> [[ParamSig]] do
    return paramLists.filter { |names| paramsMatch(ref, names) }
  end

  foul paramsMatch(ref: Kex.AST.TypeRef, names: [ParamSig]) -> Bool do
    match flattenToArity(ref, names.count) do
      FunctionType(params, _) => params.count == names.count
      _ => names.empty?
    end
  end

  # Absorbs single-parameter curried layers while more than one argument
  # remains. `(FilePath) -> (Read) -> R` with arity 2 becomes
  # `(FilePath, Read) -> R`.
  foul flattenToArity(ref: Kex.AST.TypeRef, arity: Integer) -> Kex.AST.TypeRef do
    if arity <= 1
      return ref
    end
    match ref do
      FunctionType([only], FunctionType(innerParams, innerResult)) => do
        let absorbed = FunctionType([only] + innerParams, innerResult)
        return flattenToArity(absorbed, arity - 1)
      end
      _ => ref
    end
  end

  #
  # `type` is a keyword after `.`, so typed-record access goes through
  # pattern matching instead.

  foul clauseParams(clause: Kex.AST.ClauseInfo) -> [ParamSig] do
    return clause.params.map { |p| paramSig(p) }
  end

  foul paramSig(p: Kex.AST.ParamInfo) -> ParamSig do
    let typeName = match p do
      Kex.AST.ParamInfo { type: Just(t) } => signatureParamText(t)
      _ => ""
    end
    let named = match p do
      Kex.AST.ParamInfo { name: Just(_) } => true
      _ => false
    end
    return ParamSig { name: paramName(p), typeName: typeName, named: named, hasDefault: p.hasDefault }
  end

  foul paramName(p: Kex.AST.ParamInfo) -> String do
    match p do
      Kex.AST.ParamInfo { name: Just(n) } => n
      Kex.AST.ParamInfo { name: None, pattern: Just(pattern) } => Kex.AST.patternRefText(pattern)
      _ => "_"
    end
  end

  foul annotationTypeOf(info: Kex.AST.ConstantInfo) -> String do
    match info do
      Kex.AST.ConstantInfo { type: Just(t) } => typeText(t)
      _ => ""
    end
  end

  foul fieldTypeName(f: Kex.AST.FieldInfo) -> String do
    match f do
      Kex.AST.FieldInfo { type: t } => typeText(t)
    end
  end

  foul typeText(ref: Kex.AST.TypeRef) -> String do
    return Kex.AST.typeRefText(ref)
  end

  foul typeTextOpt(ref: Kex.AST.TypeRef?) -> String do
    match ref do
      Just(r) => Kex.AST.typeRefText(r)
      None => "?"
    end
  end

  # Modules may be written fully qualified (`module FS.File do` inside
  # `module FS do`), so a dotted name already carries its prefix — never
  # prepend twice. A short name gets the parent's prefix as usual.
  foul qualify(prefix: String, name: String) -> String do
    if prefix.empty? || name.startsWith?("${prefix}.")
      return name
    end
    return "${prefix}.${name}"
  end

  foul stripExt(name: String) -> String do
    return name.take(name.count - 4) if name.endsWith?(".kex")
    return name
  end

  foul titleCase(s: String) -> String do
    if s.empty?
      return s
    end
    # The total `get`: the empty string already returned above, so the
    # fallback never fires. (`capitalize` is not this — it lower-cases the
    # tail, and a title here keeps whatever case the source wrote.)
    return s.get(0, ' ').upperCase + s.drop(1)
  end
end
