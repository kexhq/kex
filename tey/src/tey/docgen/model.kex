# The records +tey docs+ extracts from source, from which the Markdown, the
# JSON and the search index are all produced.
#
# No field is called +type+, because +type+ after a dot is read as a keyword.
# The JSON key names are chosen in +Tey.Docgen.Json+.

module Tey.Docgen.Model do

  record Param do
    name : String
    typeName : String
    description : String
  end

  record Return do
    typeName : String
    description : String
  end

  record Example do
    caption : String
    code : String
  end

  record Doc do
    summary : String
    params : [Param]
    returns : Return?
    examples : [Example]
    deprecated : String?
  end

  let emptyDoc() -> Doc do
    return Doc { summary: "", params: [], returns: None, examples: [], deprecated: None }
  end

  record VariantEntry do
    name : String
    fields : [String]
  end

  record FieldEntry do
    name : String
    typeName : String
    default? : Bool
  end

  record TypeEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    parents : [String]
    variants : [VariantEntry]?
    doc : Doc
    line : Integer
  end

  record RecordEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    fields : [FieldEntry]
    doc : Doc
    line : Integer
  end

  record TraitEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    functions : [FunctionEntry]
    doc : Doc
    line : Integer
  end

  record MakeEntry do
    target : String
    final? : Bool
    implements : [String]
    functions : [FunctionEntry]
    doc : Doc
    line : Integer
  end

  record ModuleEntry do
    name : String
    qualifiedName : String
    children : [Entity]
    doc : Doc
    line : Integer
  end

  record FunctionEntry do
    name : String
    qualifiedName : String
    signatures : [String]
    clauseCount : Integer
    doc : Doc
    line : Integer
    types : [String] = []
    # The result type the source declares (annotation or inline `-> T`),
    # or "" when it declares none.
    returnType : String = ""
    # Whether the function is declared +foul+.
    foul? : Bool = false
  end

  record ConstantEntry do
    name : String
    qualifiedName : String
    typeName : String
    doc : Doc
    line : Integer
  end

  type Entity
    = TypeDecl(TypeEntry)
    | RecordDecl(RecordEntry)
    | TraitDecl(TraitEntry)
    | MakeDecl(MakeEntry)
    | ModuleDecl(ModuleEntry)
    | FuncDecl(FunctionEntry)
    | ConstDecl(ConstantEntry)

  record SourcePage do
    source : String
    urlPath : String
    title : String
    entities : [Entity]
    # The file's opening comment, when a blank line separates it from the
    # first declaration. Without this the comment would be taken as that
    # declaration's doc.
    intro : String = ""
  end

  # One +make+ block as seen from the type it extends: where it is, the
  # names it adds and the traits it declares.
  #
  # A type's functions can be spread over many files (there is a +make
  # Integer+ in number.kex, period.kex, units.kex and others), and these rows
  # gather them on the type's page.
  record Extension do
    target : String
    urlPath : String
    pageTitle : String
    anchor : String
    implements : [String]
    names : [String]
  end

  # Everything the package says about one type, across files.
  #
  # +homePath+ is the type's main page: the one declaring it, or for a builtin
  # such as Integer or String the one named after it.
  record TypeFacts do
    name : String
    homePath : String
    # The section on the home page to land on: the type's declaration, or
    # its first make block there.
    homeAnchor : String
    extensions : [Extension]
    traits : [String]
  end

  # A trait seen from the outside: where it is documented and which make
  # blocks implement it.
  record TraitFacts do
    name : String
    qualifiedName : String
    urlPath : String
    anchor : String
    implementors : [Extension]
  end

  # One module of the package and the page its entities are on.
  #
  # The sidebar and the module index of model.json are built from these.
  # Readers navigate by module, and a module need not match a file.
  record ModuleIndexEntry do
    qualifiedName : String
    summary : String
    urlPath : String
    members : [MemberEntry]
  end

  # One documented member of a module and the anchor of its section, for the
  # sidebar and the JSON index.
  record MemberEntry do
    name : String
    anchor : String
  end

  # One row of the cross-link index: a name that a type reference may
  # mention, such as "String" or "FS.Path", and where it links to. Every
  # renderer resolves names against this one list.
  record LinkEntry do
    name : String
    urlPath : String
    anchor : String
    kind : String
  end

  # Everything extracted from one package: its pages, modules, links and
  # cross-file relations.
  record PackageModel do
    package : String
    version : String
    label : String
    baseUrl : String
    generatedAt : String
    pages : [SourcePage]
    modules : [ModuleIndexEntry] = []
    links : [LinkEntry] = []
    # The modules a +prelude.kex+ in the source tree makes visible without
    # +using+. Empty for a package without a prelude.
    preludeModules : [String] = []
    # The prelude's path, so its page can be recognised, and its opening
    # comment. The prelude declares nothing, so without the comment its page
    # would be empty.
    preludeSource : String = ""
    preludeDoc : String = ""
    # Cross-file relations (Tey.Docgen.Relations): every type's extensions
    # and traits, every trait's implementors.
    types : [TypeFacts] = []
    traits : [TraitFacts] = []
  end

  # One row of the search index, for an entity or for a function inside a
  # trait, make or module.
  #
  # +types+ are the type names its signature mentions, so a search can match
  # by type as well as by name. +anchor+ is the section a result links to.
  record SearchEntry do
    name : String
    qualifiedName : String
    kind : String
    signatures : [String]
    types : [String] = []
    summary : String
    urlPath : String
    anchor : String = ""
    line : Integer
  end

  # One row of versions.json. Each build adds or replaces its own
  # +(package, id)+ row in the file already in the output directory, so the
  # file lists every version built there.
  record VersionEntry do
    id : String
    label : String
    generatedAt : String
    package : String
  end

  # Returns the kind label an entity has in indexes and JSON, such as
  # +"record"+ or +"make"+.
  let kindOf(entity: Entity) -> String do
    match entity do
      TypeDecl(_) => "type"
      RecordDecl(_) => "record"
      TraitDecl(_) => "trait"
      MakeDecl(_) => "make"
      ModuleDecl(_) => "module"
      FuncDecl(_) => "function"
      ConstDecl(_) => "constant"
    end
  end

  # Returns an entity's display name; a make's is its target type.
  let nameOf(entity: Entity) -> String do
    match entity do
      TypeDecl(e) => e.name
      RecordDecl(e) => e.name
      TraitDecl(e) => e.name
      MakeDecl(e) => e.target
      ModuleDecl(e) => e.name
      FuncDecl(e) => e.name
      ConstDecl(e) => e.name
    end
  end

  let qualifiedNameOf(entity: Entity) -> String do
    match entity do
      TypeDecl(e) => e.qualifiedName
      RecordDecl(e) => e.qualifiedName
      TraitDecl(e) => e.qualifiedName
      MakeDecl(e) => e.target
      ModuleDecl(e) => e.qualifiedName
      FuncDecl(e) => e.qualifiedName
      ConstDecl(e) => e.qualifiedName
    end
  end

  let lineOf(entity: Entity) -> Integer do
    match entity do
      TypeDecl(e) => e.line
      RecordDecl(e) => e.line
      TraitDecl(e) => e.line
      MakeDecl(e) => e.line
      ModuleDecl(e) => e.line
      FuncDecl(e) => e.line
      ConstDecl(e) => e.line
    end
  end

  # Returns the id of an entity's HTML section.
  #
  # It is here, not in the HTML renderer, because the cross-link index and the
  # sidebar need the same ids.
  let anchorOf(entity: Entity) -> String do
    match entity do
      MakeDecl(e) => return "make-${ownerSlugOf(e.target)}"
      _ => return "${kindOf(entity)}-${slugOf(anchorNameOf(entity))}"
    end
  end

  # Returns the text an entity's anchor is made from: a make's full target,
  # type parameters included, or otherwise the qualified name.
  let anchorNameOf(entity: Entity) -> String do
    match entity do
      MakeDecl(e) => e.target
      _ => qualifiedNameOf(entity)
    end
  end

  # Returns the anchor of a function documented inside a trait or make
  # section. It includes the owner, because one page can hold several owners
  # with a +count+, such as +[X]+ and +String+.
  let memberAnchorOf(owner: String, name: String) -> String do
    return "${ownerSlugOf(owner)}-${slugOf(name)}"
  end

  # Returns the slug of an owner type: +[X]+ gives "list", +[Number]+ gives
  # "list-number" and +FileHandle<CanRead, W>+ gives "filehandle-canread".
  # Type variables (a capital letter, optionally followed by a digit) are
  # dropped.
  let ownerSlugOf(owner: String) -> String do
    let spelled = owner.replace("[", " List ").replace("{", " Map ")
    let words = Tey.Docgen.Model.wordsOf(spelled).reject { |w| typeVariable?(w) }
    let joined = words.map { |w| w.lowerCase }.join("-")
    return joined.empty? then slugOf(owner) else joined
  end

  let typeVariable?(word: String) -> Bool do
    return false if word.empty? || word.count > 2
    let head = word.take(1)
    return head.upperCase == head && head.lowerCase != head && word.drop(1).all? { |c| c.digit? }
  end

  # Returns the runs of letters, digits, +_+, +?+ and +!+ in a type's text.
  let wordsOf(text: String) -> [String] do
    return text.split(" ").into { |part| wordSplit(part, "", []) }.reject { |w| w.empty? }
  end

  let wordSplit(rest: String, word: String, out: [String]) -> [String] do
    return out + [word] if rest.empty?
    let ch = rest.take(1)
    if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?!".contains?(ch)
      return wordSplit(rest.drop(1), word + ch, out)
    end
    return wordSplit(rest.drop(1), "", out + [word])
  end

  # Returns a name spelled for an HTML id: lower case, with each run of
  # punctuation turned into one dash. +?+ and +!+ are kept, as in +empty?+.
  let slugOf(name: String) -> String do
    let words = wordsOf(name.replace(".", " ").replace("/", " "))
    return operatorSlug(name) if words.empty?
    return words.map { |w| w.lowerCase }.join("-")
  end

  # Returns the slug of an operator, which has no letters of its own: +<=>+
  # gives "op-lt-eq-gt" and a plus sign "op-plus".
  let operatorSlug(name: String) -> String do
    let names = name.chars.map { |c| operatorCharName(c) }.reject { |n| n.empty? }
    return "op-" + names.join("-")
  end

  let operatorCharName(c: Char) -> String do
    match c do
      '+' => "plus"
      '-' => "minus"
      '*' => "times"
      '/' => "div"
      '%' => "mod"
      '<' => "lt"
      '>' => "gt"
      '=' => "eq"
      '!' => "not"
      '&' => "and"
      '|' => "or"
      '^' => "xor"
      '~' => "tilde"
      '[' => "index"
      '.' => "dot"
      '?' => "q"
      _ => ""
    end
  end

  # Returns the type a make block extends, without its type arguments:
  # "[X]" gives "List", "{K: V}" and "Map<K, V>" give "Map", and
  # "FileHandle<R, W>" gives "FileHandle".
  let baseTypeOf(target: String) -> String do
    let t = target.trim
    return "List" if t.startsWith?("[")
    return "Map" if t.startsWith?("{")
    return (t.split("<").first.or(t)).trim
  end
end
