# The canonical documentation model.
#
# Extraction produces these records; Markdown, JSON and the search index are
# all derived from them. Field names avoid `type` (a keyword after `.`), so
# every field is dot-accessible; JSON keys are chosen at the emission
# boundary in Tey.Docgen.Json.

module Tey.Docgen.Model do

  record Param do
    name : String
    typeName : String
    description : String
  end

  record Return do
    typeName : String
    description : String
  end

  record Example do
    caption : String
    code : String
  end

  record Doc do
    summary : String
    params : [Param]
    returns : Return?
    examples : [Example]
    deprecated : String?
  end

  foul emptyDoc() -> Doc do
    return Doc { summary: "", params: [], returns: None, examples: [], deprecated: None }
  end

  record VariantEntry do
    name : String
    fields : [String]
  end

  record FieldEntry do
    name : String
    typeName : String
    hasDefault : Bool
  end

  record TypeEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    parents : [String]
    variants : [VariantEntry]?
    doc : Doc
    line : Integer
  end

  record RecordEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    fields : [FieldEntry]
    doc : Doc
    line : Integer
  end

  record TraitEntry do
    name : String
    qualifiedName : String
    typeParams : [String]
    functions : [FunctionEntry]
    doc : Doc
    line : Integer
  end

  record MakeEntry do
    target : String
    isFinal : Bool
    implements : [String]
    functions : [FunctionEntry]
    doc : Doc
    line : Integer
  end

  record ModuleEntry do
    name : String
    qualifiedName : String
    children : [Entity]
    doc : Doc
    line : Integer
  end

  record FunctionEntry do
    name : String
    qualifiedName : String
    signatures : [String]
    clauseCount : Integer
    doc : Doc
    line : Integer
    types : [String] = []
    # The result type the source declares (annotation or inline `-> T`),
    # or "" when it declares none.
    returnType : String = ""
  end

  record ConstantEntry do
    name : String
    qualifiedName : String
    typeName : String
    doc : Doc
    line : Integer
  end

  type Entity
    = TypeDecl(TypeEntry)
    | RecordDecl(RecordEntry)
    | TraitDecl(TraitEntry)
    | MakeDecl(MakeEntry)
    | ModuleDecl(ModuleEntry)
    | FuncDecl(FunctionEntry)
    | ConstDecl(ConstantEntry)

  record SourcePage do
    source : String
    urlPath : String
    title : String
    entities : [Entity]
    # The file's opening comment when it stands apart from the first
    # declaration (a blank line between them): prose about the FILE, which
    # the AST reader would otherwise glue onto whatever is declared first.
    intro : String = ""
  end

  # One `make` block seen from the type it extends: where it is, what it
  # adds, and which traits it declares. A type's methods are spread over
  # many files (`make Integer` lives in number.kex, time.kex, units.kex and
  # algebra.kex), and these rows are what put them back together.
  record Extension do
    target : String
    urlPath : String
    pageTitle : String
    anchor : String
    implements : [String]
    names : [String]
  end

  # Everything the package says about one type, across files. `homePath` is
  # the page a reader should land on for the type — the one declaring it, or
  # the one named after it for builtins such as Integer and String.
  record TypeFacts do
    name : String
    homePath : String
    # The section on the home page to land on: the type's declaration, or
    # its first make block there.
    homeAnchor : String
    extensions : [Extension]
    traits : [String]
  end

  # A trait seen from the outside: where it is documented and which make
  # blocks implement it.
  record TraitFacts do
    name : String
    qualifiedName : String
    urlPath : String
    anchor : String
    implementors : [Extension]
  end

  # The navigation unit: one per module in the package, pointing at the page
  # its entities live on. The sidebar and the module index of model.json are
  # built from these — a FILE is where source lives, a MODULE is what a
  # reader navigates by, and the two only coincide by accident.
  record ModuleIndexEntry do
    qualifiedName : String
    summary : String
    urlPath : String
    members : [MemberEntry]
  end

  # One documented member of a module, with the anchor its section renders
  # at — the sidebar's expanded list and the JSON index both use these.
  record MemberEntry do
    name : String
    anchor : String
  end

  # One row of the cross-link index: a name a type reference elsewhere in
  # the package may mention ("String", "FS.Path") and where it lands. The
  # index is what makes interlinked docs possible without per-renderer
  # guesswork: every renderer resolves names against the same list.
  record LinkEntry do
    name : String
    urlPath : String
    anchor : String
    kind : String
  end

  record PackageModel do
    package : String
    version : String
    label : String
    baseUrl : String
    generatedAt : String
    pages : [SourcePage]
    modules : [ModuleIndexEntry] = []
    links : [LinkEntry] = []
    # The modules a `prelude.kex` in the source tree makes visible without an
    # import. Empty for a package that has no prelude — then every module is
    # reached the same way and the index says nothing about it.
    preludeModules : [String] = []
    # That file's own path (so its page can be recognised) and its opening
    # comment, which is the only prose anyone has written about what the
    # prelude IS. It declares no entities, so without this its page is blank.
    preludeSource : String = ""
    preludeDoc : String = ""
    # Cross-file relations (Tey.Docgen.Relations): every type's extensions
    # and traits, every trait's implementors.
    types : [TypeFacts] = []
    traits : [TraitFacts] = []
  end

  # A flattened search row: one per entity (and per function inside traits,
  # makes and modules), joining name/kind/signature to the page URL. The
  # `types` are the type names the entity is about — the types its signature
  # mentions — so search can answer by name AND by type; `anchor` is the
  # section id a result deep-links to.
  record SearchEntry do
    name : String
    qualifiedName : String
    kind : String
    signatures : [String]
    types : [String] = []
    summary : String
    urlPath : String
    anchor : String = ""
    line : Integer
  end

  # One row of versions.json. The file accumulates across builds — the
  # output directory IS the site, so each build upserts its (package, id)
  # entry into whatever is already published there.
  record VersionEntry do
    id : String
    label : String
    generatedAt : String
    package : String
  end

  # The kind label used in indexes and JSON for each entity variant.
  foul kindOf(entity: Entity) -> String do
    match entity do
      TypeDecl(_) => "type"
      RecordDecl(_) => "record"
      TraitDecl(_) => "trait"
      MakeDecl(_) => "make"
      ModuleDecl(_) => "module"
      FuncDecl(_) => "function"
      ConstDecl(_) => "constant"
    end
  end

  # The primary display name of an entity (a make's is its target type).
  foul nameOf(entity: Entity) -> String do
    match entity do
      TypeDecl(e) => e.name
      RecordDecl(e) => e.name
      TraitDecl(e) => e.name
      MakeDecl(e) => e.target
      ModuleDecl(e) => e.name
      FuncDecl(e) => e.name
      ConstDecl(e) => e.name
    end
  end

  foul qualifiedNameOf(entity: Entity) -> String do
    match entity do
      TypeDecl(e) => e.qualifiedName
      RecordDecl(e) => e.qualifiedName
      TraitDecl(e) => e.qualifiedName
      MakeDecl(e) => e.target
      ModuleDecl(e) => e.qualifiedName
      FuncDecl(e) => e.qualifiedName
      ConstDecl(e) => e.qualifiedName
    end
  end

  foul lineOf(entity: Entity) -> Integer do
    match entity do
      TypeDecl(e) => e.line
      RecordDecl(e) => e.line
      TraitDecl(e) => e.line
      MakeDecl(e) => e.line
      ModuleDecl(e) => e.line
      FuncDecl(e) => e.line
      ConstDecl(e) => e.line
    end
  end

  # The anchor id an entity's HTML section renders at. Lives here — not in
  # the HTML renderer — because the cross-link index and the sidebar compute
  # the same ids, and the HTML must match whatever they resolved to.
  foul anchorOf(entity: Entity) -> String do
    match entity do
      MakeDecl(e) => return "make-${ownerSlugOf(e.target)}"
      _ => return "${kindOf(entity)}-${slugOf(anchorNameOf(entity))}"
    end
  end

  # A make's anchor is keyed by its full target spelling (type params
  # included), a module's by its qualified name — the section ids are
  # derived from the same texts.
  foul anchorNameOf(entity: Entity) -> String do
    match entity do
      MakeDecl(e) => e.target
      _ => qualifiedNameOf(entity)
    end
  end

  # The anchor of a function documented inside a trait or make section:
  # scoped by its owner, because `count` is a member of both `[X]` and
  # `String`, and one page can hold several owners.
  foul memberAnchorOf(owner: String, name: String) -> String do
    return "${ownerSlugOf(owner)}-${slugOf(name)}"
  end

  # An owner spelled as a type: `[X]` -> "list", `[Number]` -> "list-number",
  # `FileHandle<CanRead, W>` -> "filehandle-canread". Type variables (a lone
  # capital, optionally numbered) say nothing about WHICH methods these are,
  # so they are dropped rather than baked into every anchor.
  foul ownerSlugOf(owner: String) -> String do
    let spelled = owner.replace("[", " List ").replace("{", " Map ")
    let words = Tey.Docgen.Model.wordsOf(spelled).reject { |w| typeVariable?(w) }
    let joined = words.map { |w| w.lowerCase }.join("-")
    return joined.empty? then slugOf(owner) else joined
  end

  foul typeVariable?(word: String) -> Bool do
    return false if word.empty? || word.count > 2
    let head = word.take(1)
    return head.upperCase == head && head.lowerCase != head && word.drop(1).all? { |c| c.digit? }
  end

  # Identifier-ish runs of a type text: letters, digits, `_`, `?`, `!`.
  foul wordsOf(text: String) -> [String] do
    return text.split(" ").flatMap { |part| wordSplit(part, "", []) }.reject { |w| w.empty? }
  end

  foul wordSplit(rest: String, word: String, out: [String]) -> [String] do
    return out + [word] if rest.empty?
    let ch = rest.take(1)
    if "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_?!".contains?(ch)
      return wordSplit(rest.drop(1), word + ch, out)
    end
    return wordSplit(rest.drop(1), "", out + [word])
  end

  # An id-safe spelling of a name: lower case, every run of punctuation one
  # dash. `?` and `!` survive — they are part of Kex names (`empty?`) and
  # legal in a fragment.
  foul slugOf(name: String) -> String do
    let words = wordsOf(name.replace(".", " ").replace("/", " "))
    return operatorSlug(name) if words.empty?
    return words.map { |w| w.lowerCase }.join("-")
  end

  # An operator method has no letters to slug: `+` is "op-plus", `<=>` is
  # "op-lt-eq-gt" — distinct, stable and readable in a URL.
  foul operatorSlug(name: String) -> String do
    let names = name.chars.map { |c| operatorCharName(c) }.reject { |n| n.empty? }
    return "op-" + names.join("-")
  end

  foul operatorCharName(c: Char) -> String do
    match c do
      '+' => "plus"
      '-' => "minus"
      '*' => "times"
      '/' => "div"
      '%' => "mod"
      '<' => "lt"
      '>' => "gt"
      '=' => "eq"
      '!' => "not"
      '&' => "and"
      '|' => "or"
      '^' => "xor"
      '~' => "tilde"
      '[' => "index"
      '.' => "dot"
      '?' => "q"
      _ => ""
    end
  end

  # "[X]" -> "List", "{K: V}" -> "Map", "FileHandle<R, W>" -> "FileHandle",
  # "Map<K, V>" -> "Map": the type a make block extends, whatever
  # specialisation it spells.
  foul baseTypeOf(target: String) -> String do
    let t = target.trim
    return "List" if t.startsWith?("[")
    return "Map" if t.startsWith?("{")
    return (t.split("<").first.or(t)).trim
  end
end
