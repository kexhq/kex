# Serves a generated output directory over HTTP. Tey runs on the BEAM, so
# Net.HTTP.Server is available wherever `tey docs -- serve` runs.

module Tey.Docgen.Serve do
  using Net.HTTP, only: [Context, Headers, Request, Response, Router, Server]
  using Net.Socket, only: [TCP]

  record ServedFile do
    route : String
    path : String
  end

  foul serveCommand(parsed: OptionParser.ParsedOptions) -> Integer do
    let out = parsed.values.get("out").or("")
    let port = Integer.parse(parsed.values.get("port").or("4322")).or(4322)
    if out.empty?
      IO.printError("docgen: --out is required")
      return 1
    end
    let files = collectServeFiles(out, "/")
    if files.empty?
      IO.printError("docgen: no files to serve in ${out}")
      return 1
    end
    let listenPort = match Net.Port.from(port) do
      Ok(value) => value
      Error(_) => do
        IO.printError("docgen: invalid --port ${port}")
        return 1
      end
    end
    # One exact route per spelling of each file (see routesFor): the router
    # matches paths exactly, so there is no directory fallback to lean on.
    let router = files.reduce(Router.build) do |routes, file|
      routes.get(file.route, ~serveFile(file.path))
    end
    IO.printLine("docgen: serving ${files.count} file(s) on http://localhost:${port}")
    match Server.serve(TCP.Endpoint.loopback(listenPort), router) do
      Ok(_) => return 0
      Error(error) => do
        IO.printError("docgen: server failed: ${error.message}")
        return 1
      end
    end
  end

  # The URL paths a browser would type for this file: an index.html is
  # reached by its directory ("/", "/prelude/0.4.0-alpha/") as much as by
  # its name, and the router matches exactly — so it answers the bare, the
  # slash-terminated, and the named spelling. Every other file answers its
  # own path only.
  foul routesFor(prefix: String, name: String) -> [String] do
    let path = FS.Path.join(prefix, name)
    if name == "index.html"
      return [path, prefix, "${prefix}/"]
    end
    return [path]
  end

  foul collectServeFiles(dir: String, prefix: String) -> [ServedFile] do
    let names = FS.Directory.files(dir).or([])
    let subdirs = FS.Directory.directories(dir).or([])
    let fileEntries = names.flatMap { |n|
      routesFor(prefix, n).map { |r| ServedFile { route: r, path: FS.Path.join(dir, n) } }
    }
    let subEntries = subdirs.map { |d| collectServeFiles(FS.Path.join(dir, d), FS.Path.join(prefix, d)) }.flatten
    return fileEntries + subEntries
  end

  # A route handler once `filePath` is applied: `~serveFile(path)`. Reads the
  # file as bytes, not text: the site ships images and fonts beside its HTML,
  # and decoding those as UTF-8 would turn them into a 404.
  foul serveFile(filePath: String, _request: Request<Binary>,
                 _context: Context) -> Response<Binary> do
    let body = match FS.File.readBytes(filePath) do
      Ok(bytes) => bytes
      Error(_) => return Response.text(404, "not found")
    end
    # The site regenerates in place, so nothing here is immutable: send
    # no-cache so a rebuild (or an accumulated versions.json) is never
    # shadowed by a browser's cached copy.
    let headers = Headers.empty.add("Content-Type", contentTypeFor(filePath))
      .flatMap { |added| added.add("Cache-Control", "no-cache") }
    match headers do
      Ok(value) => return Response.binary(200, body, value)
      Error(error) => return Response.text(500, error.message)
    end
  end

  foul contentTypeFor(path: String) -> String do
    return "text/html; charset=utf-8" if path.endsWith?(".html")
    return "text/css; charset=utf-8" if path.endsWith?(".css")
    return "text/javascript; charset=utf-8" if path.endsWith?(".js")
    return "text/markdown; charset=utf-8" if path.endsWith?(".md")
    return "application/json" if path.endsWith?(".json")
    return "application/xml" if path.endsWith?(".xml")
    return "text/plain; charset=utf-8"
  end
end
