using Tey.Commands

# Which backend `tey run` and `tey test` reach for.
#
# `tey build` compiles to the BEAM, so what a package IS built as and what it
# is run and tested as have to be the same thing — processes, `Erlang.*`
# interop and the String/Char representation all differ between the two
# backends, and a spec suite green under the interpreter is no evidence about
# the artifact that ships.
describe("Tey.Commands.backendFlags") do
  it("compiles and runs on the BEAM by default") do
    assert(Tey.Commands.backendFlags(false) == ["-R"])
  end

  it("passes nothing extra under --interpret") do
    # The escape hatch, for a backend gap or a debugging session: without a
    # flag the toolchain tree-walks the source, which is what it did for
    # everything before this.
    assert(Tey.Commands.backendFlags(true) == [])
  end
end

# What `tey test --json` / `--list` / `--only` ask the compiler for.
#
# An editor's test tree is built on these (kexhq/kex#199), and it calls `tey`
# rather than `kex` because only Tey knows the package's source roots. So the
# flags have to arrive at the compiler exactly as spelled — a filter that goes
# missing silently runs the whole suite, and a mode that goes missing floods a
# JSON reader with ✓/✗ prose.
describe("Tey.Commands.testReportingFlags") do
  it("asks for nothing when a person is watching") do
    assert(Tey.Commands.testReportingFlags(false, false, "") == [])
  end

  it("asks for one JSON record per case under --json") do
    assert(Tey.Commands.testReportingFlags(true, false, "") == ["--test-json"])
  end

  it("asks for discovery under --list") do
    assert(Tey.Commands.testReportingFlags(false, true, "") == ["--test-list"])
  end

  it("prefers discovery when asked for both") do
    # Discovery is already a JSON mode, and it is the one that runs nothing —
    # so asking for both can only mean the one that runs nothing.
    assert(Tey.Commands.testReportingFlags(true, true, "") == ["--test-list"])
  end

  it("passes --only through as the compiler's own filter") do
    assert(Tey.Commands.testReportingFlags(true, false, "outer > inner > case")
           == ["--test-json", "--test-only", "outer > inner > case"])
  end

  it("passes no filter for an empty --only") do
    # An unset `--only` reads as "" here, and "" as a filter matches nothing:
    # the difference between "run everything" and "run nothing" is this line.
    assert(Tey.Commands.testReportingFlags(false, false, "") == [])
  end
end

describe("Tey.Commands.mergeUpdate") do
  let dependency(name: String, commit: String,
                 edges: [String] = []) -> Tey.Lockfile.Dependency do
    return Tey.Lockfile.Dependency {
      name: name, source: "git", git: "https://example.com/${name}",
      commit: commit, sha256: "hash-${commit}", dependencies: edges
    }
  end

  let state(dependencies: [Tey.Lockfile.Dependency],
            approval: String) -> Tey.Lockfile.LockState do
    return Tey.Lockfile.LockState {
      kexRequirement: ">= 0.4", kexVersion: "0.4.0",
      lockedDependencies: dependencies,
      pluginApprovals: { "tool": approval }
    }
  end

  it("updates only a named dependency and its transitive closure") do
    let old = state([dependency("a", "old-a", ["child"]),
                     dependency("child", "old-child", []),
                     dependency("other", "old-other", [])], "approved")
    let fresh = state([dependency("a", "new-a", ["child"]),
                       dependency("child", "new-child", []),
                       dependency("other", "new-other", [])], "")
    let merged = Tey.Commands.mergeUpdate(old, fresh, ["a"], false)
    assert(merged.lockedDependencies.find { |dep| dep.name == "a" }.try.commit == "new-a")
    assert(merged.lockedDependencies.find { |dep| dep.name == "child" }.try.commit == "new-child")
    assert(merged.lockedDependencies.find { |dep| dep.name == "other" }.try.commit == "old-other")
    assert(merged.pluginApprovals["tool"] == Just("approved"))
  end

  it("replaces every resolution for a workspace-root update") do
    let old = state([dependency("a", "old", []), dependency("b", "old", [])], "approved")
    let fresh = state([dependency("a", "new", []), dependency("b", "new", [])], "")
    let merged = Tey.Commands.mergeUpdate(old, fresh, [], true)
    assert(merged.lockedDependencies.map { |dep| dep.commit } == ["new", "new"])
    assert(merged.pluginApprovals["tool"] == Just("approved"))
  end

  it("changes no external pins for a member with no dependencies") do
    let old = state([dependency("a", "old", [])], "approved")
    let fresh = state([dependency("a", "new", [])], "")
    let merged = Tey.Commands.mergeUpdate(old, fresh, [], false)
    assert(merged.lockedDependencies.first.try.commit == "old")
  end
end

describe("Tey.Commands.lockReusable?") do
  let lock = Tey.Lockfile.LockState {
    kexRequirement: ">= 0.4", kexVersion: "0.5.0", otpRelease: 27,
    manifestFingerprint: "manifest", lockedDependencies: []
  }
  let toolchain = Tey.Toolchain.ToolchainInfo {
    version: "0.5.0-beta.1", reportedRuntimeOtpFloor: Just(27)
  }

  it("requires the selected release and reported runtime floor to match") do
    assert(Tey.Commands.lockReusable?(lock, "manifest", toolchain))
    assert(!Tey.Commands.lockReusable?(
      Tey.Lockfile.LockState { ...lock, kexVersion: "0.4.0" },
      "manifest", toolchain
    ))
    assert(!Tey.Commands.lockReusable?(
      Tey.Lockfile.LockState { ...lock, otpRelease: 26 },
      "manifest", toolchain
    ))
  end

  it("requires the normalized workspace fingerprint to match") do
    assert(!Tey.Commands.lockReusable?(lock, "changed", toolchain))
  end
end

describe("Tey.Commands.updateScopeMembers") do
  let rootPackage = Tey.Manifest.ManifestPackage { name: "root" }
  let childPackage = Tey.Manifest.ManifestPackage { name: "child" }
  let rootMember = Tey.Workspace.Member {
    memberRoot: "/work", memberManifest: rootPackage
  }
  let childMember = Tey.Workspace.Member {
    memberRoot: "/work/packages/child", memberManifest: childPackage
  }

  it("limits a member-local update to the current member") do
    let context = Tey.Workspace.Context {
      workspaceRoot: "/work", members: [rootMember, childMember],
      currentMember: Just(childMember)
    }
    assert(Tey.Commands.updateScopeMembers(context) == [childMember])
  end

  it("keeps every member in scope at a package-root workspace root") do
    let context = Tey.Workspace.Context {
      workspaceRoot: "/work", members: [rootMember, childMember],
      currentMember: Just(rootMember)
    }
    assert(Tey.Commands.updateScopeMembers(context) == [rootMember, childMember])
  end

  it("keeps every member in scope at a virtual workspace root") do
    let context = Tey.Workspace.Context {
      workspaceRoot: "/work", members: [rootMember, childMember]
    }
    assert(Tey.Commands.updateScopeMembers(context) == [rootMember, childMember])
  end
end
