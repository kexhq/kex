using Tey.Docgen.Model
using Tey.Docgen.Nav, only: [buildModules, buildLinks, resolve, segmentsOf, hrefFrom, isIdentChar?]
using Tey.Docgen.Html, only: [packageNames, linkType, linkTypeText, preludePaths]
using Tey.Docgen.Extract, only: [isConstantBinding]
using Tey.Docgen.Index, only: [upsertVersion]
using Tey.Docgen.Rdoc, only: [parseDoc]

# Navigation and interlinking: the indexes every renderer resolves against.
# All pure — hand-built pages in, indexes and hrefs out — because the rules
# ARE the feature: what a module is, when a simple name links, and where a
# name lands must not vary between the HTML and Markdown renderings.

let aPage(entities: [Entity], path: String) -> SourcePage do
  return SourcePage { source: "${path}.kex", urlPath: path, title: path, entities: entities }
end

let aRecord(name: String, qualifiedName: String) -> Entity do
  return RecordDecl(RecordEntry {
    name: name, qualifiedName: qualifiedName, typeParams: [],
    fields: [], doc: emptyDoc(), line: 1
  })
end

let aModule(name: String, qualifiedName: String, children: [Entity]) -> Entity do
  return ModuleDecl(ModuleEntry {
    name: name, qualifiedName: qualifiedName, children: children,
    doc: emptyDoc(), line: 1
  })
end

let versionEntry(pkg: String, id: String) -> VersionEntry do
  return VersionEntry { id: id, label: pkg, generatedAt: "", package: pkg }
end

describe("Tey.Docgen.Nav.buildModules") do
  it("indexes nested modules with their members") do
    let fileModule = aModule("File", "FS.File", [aRecord("Handle", "FS.File.Handle")])
    let page = aPage([aModule("FS", "FS", [fileModule])], "fs")
    let names = buildModules([page]).map { |m| m.qualifiedName }
    assert(names == ["FS", "FS.File"])
  end

  it("carries member anchors that match the entity sections") do
    let handle = aRecord("Handle", "FS.File.Handle")
    let page = aPage([aModule("File", "FS.File", [handle])], "fs")
    let modules = buildModules([page])
    let anchor = match modules.first do
      Just(first) => match first.members.first do
        Just(member) => member.anchor
        None => ""
      end
      None => ""
    end
    assert(anchor == anchorOf(handle))
  end
end

describe("Tey.Docgen.Nav.buildLinks") do
  it("links a qualified name and its simple spelling when unambiguous") do
    let page = aPage([aModule("FS", "FS", [aRecord("Path", "FS.Path")])], "fs")
    let links = buildLinks([page])
    assert(resolve(links, "FS.Path") != None)
    assert(resolve(links, "Path") != None)
  end

  it("drops the simple spelling once two entities claim it") do
    # Web.Request and Mock.Request: plain "Request" must not choose a side.
    let web = aPage([aModule("Web", "Web", [aRecord("Request", "Web.Request")])], "web")
    let mock = aPage([aModule("Mock", "Mock", [aRecord("Request", "Mock.Request")])], "mock")
    let links = buildLinks([web, mock])
    assert(resolve(links, "Request") == None)
    assert(resolve(links, "Web.Request") != None)
    assert(resolve(links, "Mock.Request") != None)
  end

  it("links a make under its base name, parameters stripped") do
    let mapMake = MakeDecl(MakeEntry {
      target: "Map<K, V>", isFinal: false, implements: [],
      functions: [], doc: emptyDoc(), line: 1
    })
    let links = buildLinks([aPage([mapMake], "map")])
    assert(resolve(links, "Map") != None)
    assert(resolve(links, "Map<K, V>") == None)
  end

  it("does not link bare functions") do
    let fn = FuncDecl(FunctionEntry { name: "peek", qualifiedName: "FS.File.peek",
                                      signatures: [], clauseCount: 1, doc: emptyDoc(), line: 1 })
    let links = buildLinks([aPage([fn], "fs")])
    assert(resolve(links, "peek") == None)
  end
end

describe("Tey.Docgen.Nav.segmentsOf") do
  it("splits a type reference into identifiers and punctuation") do
    assert(segmentsOf("Map<String, FS.Path>") == ["Map", "<", "String", ", ", "FS.Path", ">"])
  end

  it("keeps a plain identifier as one segment") do
    assert(segmentsOf("String") == ["String"])
  end

  it("classifies identifier characters") do
    assert(isIdentChar?("a"))
    assert(isIdentChar?("."))
    assert(!isIdentChar?("<"))
    assert(!isIdentChar?(" "))
  end
end

describe("Tey.Docgen.Nav.hrefFrom") do
  it("anchors within the same page") do
    assert(hrefFrom("fs", "fs", "module-FS") == "#module-FS")
  end

  it("climbs out of nested pages to the version directory") do
    assert(hrefFrom("kex/ast", "fs", "module-FS") == "../fs.html#module-FS")
  end
end

describe("Tey.Docgen.Html.linkType") do
  it("renders a resolved name as a link and an unknown one as text") do
    let links = [LinkEntry { name: "String", urlPath: "string", anchor: "module-String", kind: "module" }]
    let linked = linkType(links, "fs", "String")
    let plain = linkType(links, "fs", "Nowhere")
    assert(linked.contains?("href=\"string.html#module-String\""))
    assert(!plain.contains?("<a"))
  end

  it("links only the identifiers inside a composite type") do
    let links = [LinkEntry { name: "String", urlPath: "string", anchor: "module-String", kind: "module" }]
    let link = { |name| linkType(links, "fs", name) }
    let rendered = linkTypeText(link, "Map<String, Int>")
    assert(rendered.contains?("<a class=\"xref\" href=\"string.html#module-String\">String</a>"))
    assert(rendered.contains?("&lt;"))
  end
end

describe("Tey.Docgen.Html.packageNames") do
  it("groups versions by package, first-seen order") do
    let versions = [versionEntry("prelude", "0.4"), versionEntry("tey", "0.2"),
                    versionEntry("prelude", "0.3"), versionEntry("tey", "0.1")]
    assert(packageNames(versions) == ["prelude", "tey"])
  end
end

describe("Tey.Docgen.Index.upsertVersion") do
  it("replaces this package's same version, keeps the rest") do
    let existing = [versionEntry("prelude", "0.4"), versionEntry("tey", "0.2"),
                    versionEntry("prelude", "0.3")]
    let upserted = upsertVersion(versionEntry("prelude", "0.3"), existing)
    let ids = upserted.map { |v| "${v.package}/${v.id}" }
    assert(ids == ["prelude/0.3", "prelude/0.4", "tey/0.2"])
  end
end

describe("Tey.Docgen.Rdoc.parseDoc") do
  it("parses consecutive @param lines as separate parameters") do
    # The Bits module's own shape: directives on consecutive lines, no blank
    # line between them — each must start its own paragraph or the second
    # @param is swallowed.
    let doc = parseDoc("Bitwise AND.\n\n@param a [Integer]\n@param b [Integer]\n@return [Integer]").or(emptyDoc())
    let names = doc.params.map { |p| p.name }
    assert(names == ["a", "b"])
    assert(doc.returns != None)
  end

  it("keeps an @example's code lines in its own block") do
    let doc = parseDoc("Shifts.\n\n@example\n  Bits.not(0)  # => -1\n  Bits.not(5)  # => -6").or(emptyDoc())
    assert(doc.examples.count == 1)
    let code = match doc.examples.first do
      Just(ex) => ex.code
      None => ""
    end
    assert(code.contains?("Bits.not(0)"))
  end

  it("strips an @example's common indentation") do
    let doc = parseDoc("Reads.\n\n@example\n  read(\"hosts\")\n    .or([])").or(emptyDoc())
    let code = exampleCode(doc, 0)
    assert(code == "read(\"hosts\")\n  .or([])")
  end

  it("ends an @example at the first unindented line") do
    # An implementation note written straight under the last example, with no
    # blank line between them, must not become part of the example.
    let doc = parseDoc("Reads.\n\n@example\n  read(\"a\")\nNOT `lines`: the name would collide.").or(emptyDoc())
    let code = exampleCode(doc, 0)
    assert(code == "read(\"a\")")
    assert(doc.summary.contains?("would collide"))
  end

  it("keeps an indented block as a fenced code block in the summary") do
    let doc = parseDoc("Start with:\n\n  using FS\n\n  main do\n    read(\"x\")\n  end\n\nThat is all.").or(emptyDoc())
    assert(doc.summary.contains?("```kex\nusing FS\n\nmain do\n  read(\"x\")\nend\n```"))
    assert(doc.summary.contains?("That is all."))
  end
end

foul exampleCode(doc: Doc, index: Integer) -> String do
  match doc.examples.drop(index).first do
    Just(ex) => ex.code
    None => ""
  end
end

describe("Tey.Docgen.Html.preludePaths") do
  it("maps a prelude's using list to pages by file, not by title") do
    # `using Env` is env.kex, whose page is titled "ENV", and `using Test` is
    # test.kex, titled "Assert" — matching on the title alone drops both.
    let model = aModel(["Env", "Test", "List"], [
      aPage([aModule("ENV", "ENV", [])], "env"),
      aPage([aModule("Assert", "Assert", [])], "test"),
      aPage([aModule("List", "List", [])], "list"),
      aPage([aModule("FS", "FS", [])], "fs")
    ])
    assert(preludePaths(model) == ["env", "test", "list"])
  end

  it("is empty for a package with no prelude") do
    let model = aModel([], [aPage([aModule("Tey", "Tey", [])], "tey")])
    assert(preludePaths(model) == [])
  end
end

describe("Tey.Docgen.Extract.isConstantBinding") do
  it("calls a pure no-argument binding a constant") do
    # `let out = Kex.Intrinsic.IO.stdout` — always the same handle.
    assert(isConstantBinding(aBinding("out", false)))
  end

  it("calls a foul one a function") do
    # `foul getLine = ...` reads a new line every time it is named, so it is
    # a zero-argument function Kex auto-calls, not a constant.
    assert(!isConstantBinding(aBinding("getLine", true)))
  end

  it("calls anything with a parameter list a function") do
    assert(!isConstantBinding(aClause("printLine", false, true)))
  end
end

let aModel(preludeModules: [String], pages: [SourcePage]) -> PackageModel do
  return PackageModel {
    package: "prelude", version: "0.4.0", label: "Standard Library",
    baseUrl: "", generatedAt: "", pages: pages,
    preludeModules: preludeModules,
    preludeSource: preludeModules.empty? then "" else "prelude.kex"
  }
end

let aBinding(name: String, isFoul: Bool) -> Kex.AST.FunctionInfo = aClause(name, isFoul, false)

let aClause(name: String, isFoul: Bool, hasParamList: Bool) -> Kex.AST.FunctionInfo do
  let clause = Kex.AST.ClauseInfo {
    params: [], body: [], returnType: None, rescueInfo: None, hasParamList: hasParamList
  }
  return Kex.AST.FunctionInfo {
    name: name, doc: None, isFoul: isFoul, predicate: false,
    clauses: [clause], location: noLocation()
  }
end

let noLocation() -> Kex.AST.Location do
  return Kex.AST.Location { file: "io.kex", line: 1, column: 1, startOffset: 0, endOffset: 0 }
end
