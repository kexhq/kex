using Tey.Manifest, only: [DependencySource, GitSource, ManifestPackage, PathSource, WorkspaceSource, read]

# What a `package.kex` means. The reader is strict on purpose — an unknown
# declaration is a mistake rather than a comment — which makes every field it
# accepts part of the format's contract: adding one is a change to what a
# package MAY say, and forgetting one turns a reasonable manifest into an
# error message. These are the fields, checked without a disk or a network.

describe("Tey.Manifest.read") do
  it("rejects the retired bundle root") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      bundle "greet" do
        version("0.1.0")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("package"))
      Ok(_) => assert(false, "unexpectedly accepted bundle")
    end
  end

  it("reads workspace members nested in a package") do
    let manifest = Tey.Manifest.read(`
      package "compiler" do
        workspace do
          members(["packages/*", "apps/*"])
        end
      end
    `).try
    assert(manifest.manifestWorkspace.set?, "workspace was absent: ${manifest}")
    assert(manifest.manifestWorkspace.try.memberPatterns == ["packages/*", "apps/*"],
           "members were ${manifest.manifestWorkspace.try.memberPatterns}")
  end

  it("reads a virtual workspace") do
    let workspace = Tey.Manifest.readWorkspace(`
      workspace do
        members(["packages/*"])
      end
    `).try
    assert(workspace.memberPatterns == ["packages/*"], "members were ${workspace.memberPatterns}")
  end

  it("reads the name, version and Kex requirement") do
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.2.1")
        kex(">= 0.3.3")
      end
    `).try
    assert(package.name == "greet")
    assert(package.version == "0.2.1")
    assert(package.packageKexRequirement == ">= 0.3.3")
  end

  it("reads a description") do
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")
        description("The first Kex package")
        license("MIT")
      end
    `).try
    assert(package.description == "The first Kex package")
    assert(package.license == "MIT")
  end

  it("leaves the description empty when there is none") do
    # Optional, because a manifest nobody can write until they have phrased a
    # sentence is a manifest nobody writes.
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")
      end
    `).try
    assert(package.description == "")
  end

  it("refuses a declaration it does not recognize") do
    # The strictness that makes `description` need declaring here at all: a
    # typo must not be read as a comment and silently dropped.
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "greet" do
        describtion("typo")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("describtion"), "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted unknown declaration")
    end
  end

  # A manifest is Kex source rather than JSON so that it can be commented, so
  # every position a reader would naturally put one has to work. The last case
  # is the one that bit: the parenthesis in a trailing comment made the
  # declaration look unfinished, and the reader swallowed the rest of the
  # manifest without reporting anything.
  it("allows comments on their own line, after a declaration, and inside one") do
    let package = Tey.Manifest.read(`
      # What this package is.
      package "greet" do
        # The version people depend on.
        version("0.1.0")
        description("The first Kex package")  # and what it is for
        kex(">= 0.3.3")

        tey("other", git: "https://example.com/o",   # why we need it
            tag: "~> 0.1")
      end
    `).try
    assert(package.name == "greet")
    assert(package.version == "0.1.0")
    assert(package.description == "The first Kex package")
    assert(package.packageKexRequirement == ">= 0.3.3")
    assert(package.manifestDependencies.count == 1)
  end

  it("does not let a comment's parenthesis swallow the next declaration") do
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")  # bump when you cut a release (see docs/releasing
        description("still here")
        kex(">= 0.3.3")
      end
    `).try
    assert(package.description == "still here")
    assert(package.packageKexRequirement == ">= 0.3.3")
  end

  it("keeps a # that is inside a string") do
    let package = Tey.Manifest.read(`
      package "greet" do
        description("C# interop, of all things")
      end
    `).try
    assert(package.description == "C# interop, of all things")
  end

  it("defaults the entrypoint, and a library leaves it unused") do
    let library = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")
      end
    `).try
    assert(library.entrypoint == "src/main.kex")
    assert(library.targets.empty?)
  end

  it("reads dependencies with their selector") do
    let package = Tey.Manifest.read(`
      package "app" do
        version("0.1.0")
        tey("greet", git: "https://github.com/kexhq/greet", tag: "~> 0.1")
      end
    `).try
    assert(package.manifestDependencies.count == 1)
    let dependency = package.manifestDependencies.first.try
    assert(dependency.manifestName == "greet")
    match dependency.manifestSource do
      GitSource(git, selector, requested, subdir) => do
        assert(git == "https://github.com/kexhq/greet")
        assert(selector == "tag")
        assert(requested == "~> 0.1")
        assert(subdir == "")
      end
      _ => assert(false, "dependency was not a Git source")
    end
  end
end

# The rest of the format. Every field here is part of what a `package.kex` is
# allowed to say, so a reimplementation has to accept all of them and mean the
# same things by them.
describe("Tey.Manifest.read — the whole format") do
  it("parses plugin capabilities, commands, generators, and typed options") do
    let package = Tey.Manifest.read(`
      package "kex-github" do
        version("1.0.0")
        plugin namespace: "github", tey: ">= 0.6, < 0.8" do
          capabilities([
            FS.Read.package,
            FS.Write.workspace,
            Process.Run(["git"]),
            Net.Connect(["api.github.com"])
          ])
          command("setup", entrypoint: "src/github/setup.kex") do
            option("branch", type: String)
          end
          generator("workflow", entrypoint: "src/github/workflow.kex") do
            option("otp", type: Integer)
          end
        end
      end
    `).try
    let plugin = package.plugins.first.try
    assert(plugin.pluginNamespace == "github")
    assert(plugin.pluginTeyRequirement == ">= 0.6, < 0.8")
    assert(plugin.pluginCapabilities.map { |resource| resource.capabilityKind } ==
           ["FS.Read.package", "FS.Write.workspace", "Process.Run", "Net.Connect"])
    assert(plugin.pluginCapabilities.third.try.capabilityValues == ["git"])
    assert(plugin.pluginCommands.first.try.operationName == "setup")
    assert(plugin.pluginCommands.first.try.operationOptions.first.try.optionType == "String")
    assert(plugin.pluginGenerators.first.try.operationName == "workflow")
    assert(plugin.pluginGenerators.first.try.operationOptions.first.try.optionType == "Integer")
  end

  it("rejects malformed plugin schemas without executing their bodies") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "unsafe" do
        plugin namespace: "github", tey: ">= 0.6" do
          Process.run("touch", ["/tmp/should-never-exist"])
        end
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("unknown plugin declaration"))
      Ok(_) => assert(false, "accepted executable plugin manifest code")
    end
  end

  it("rejects ignored plugin fields and extra positional arguments") do
    let manifests = [`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6", hidden: true do end
      end
    `, `
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          capabilities([FS.Read.package(scope: "all")])
        end
      end
    `, `
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          command("setup", "ignored", entrypoint: "setup.kex")
        end
      end
    `, `
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          generator("workflow", entrypoint: "workflow.kex") do
            option("otp", "ignored", type: Integer)
          end
        end
      end
    `]
    manifests.each do |text|
      match Tey.Manifest.read(text) do
        Error(_) => assert(true)
        Ok(_) => assert(false, "accepted ignored plugin schema data")
      end
    end
  end

  it("rejects duplicate plugin schema labels") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", namespace: "other", tey: ">= 0.6" do end
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("more than once"))
      Ok(_) => assert(false, "accepted duplicate namespace:")
    end
  end

  it("rejects unknown capabilities and empty resource allowlists") do
    let unknown: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          capabilities([Danger.All.system])
        end
      end
    `)
    let empty: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          capabilities([Process.Run([])])
        end
      end
    `)
    match unknown do
      Error(message) => assert(message.contains?("unsupported plugin capability"))
      Ok(_) => assert(false, "accepted an unknown capability")
    end
    match empty do
      Error(message) => assert(message.contains?("non-empty resource list"))
      Ok(_) => assert(false, "accepted an empty process allowlist")
    end
  end

  it("rejects duplicate plugin namespaces and invalid option types") do
    let duplicate: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do end
        plugin namespace: "github", tey: ">= 0.6" do end
      end
    `)
    match duplicate do
      Error(message) => assert(message.contains?("declared twice"))
      Ok(_) => assert(false, "accepted a duplicate namespace")
    end
    let invalid: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          command("setup", entrypoint: "setup.kex") do
            option("branch", type: "String")
          end
        end
      end
    `)
    match invalid do
      Error(message) => assert(message.contains?("name and type"))
      Ok(_) => assert(false, "accepted a string in a static type schema")
    end
  end

  it("keeps plugin entrypoints inside the provider package") do
    let absolute: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          generator("workflow", entrypoint: "/tmp/workflow.kex")
        end
      end
    `)
    let parent: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          command("setup", entrypoint: "../setup.kex")
        end
      end
    `)
    assert(absolute.error?)
    assert(parent.error?)
  end

  it("restricts plugin options to protocol scalar types") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "plugins" do
        plugin namespace: "github", tey: ">= 0.6" do
          generator("workflow", entrypoint: "workflow.kex") do
            option("config", type: Configuration)
          end
        end
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("unsupported type"))
      Ok(_) => assert(false, "accepted an unserializable option type")
    end
  end

  it("reads an entrypoint and a target") do
    let package = Tey.Manifest.read(`
      package "greeter" do
        version("0.1.0")
        entrypoint("src/main.kex")

        target("greeter", entrypoint: "src/main.kex")
      end
    `).try
    assert(package.entrypoint == "src/main.kex")
    assert(package.targets.count == 1)
    assert(package.targets.first.try.name == "greeter")
    assert(package.targets.first.try.entrypoint == "src/main.kex")
  end

  it("lets a target default its entrypoint to the package's") do
    let package = Tey.Manifest.read(`
      package "greeter" do
        entrypoint("src/cli.kex")
        target("greeter")
      end
    `).try
    assert(package.targets.first.try.entrypoint == "src/cli.kex")
  end

  it("reads several targets") do
    # Each names a separate executable, so they must not collapse into one.
    let package = Tey.Manifest.read(`
      package "tools" do
        target("build", entrypoint: "src/build.kex")
        target("serve", entrypoint: "src/serve.kex")
      end
    `).try
    assert(package.targets.count == 2)
    assert(package.targets.map { |t| t.name } == ["build", "serve"])
  end

  it("reads an otp requirement") do
    let package = Tey.Manifest.read(`
      package "greet" do
        kex(">= 0.3.3")
        otp(">= 26")
      end
    `).try
    assert(package.packageOtpRequirement == ">= 26")
    assert(package.packageKexRequirement == ">= 0.3.3")
  end

  it("leaves the otp requirement empty when there is none") do
    # Absent means "no opinion", which is different from asking for OTP 0.
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")
      end
    `).try
    assert(package.packageOtpRequirement == "")
  end

  it("tags a dependency with the group it was declared in") do
    let package = Tey.Manifest.read(`
      package "app" do
        tey("greet", git: "https://example.com/greet", tag: "~> 0.1")

        group :dev do
          tey("spec-helper", git: "https://example.com/h", branch: "main")
        end
      end
    `).try
    assert(package.manifestDependencies.count == 2)
    let production = package.manifestDependencies.first.try
    let development = package.manifestDependencies.second.try
    assert(production.manifestGroups.empty?)
    assert(development.manifestGroups == ["dev"])
  end

  it("closes a group at its end rather than swallowing what follows") do
    let package = Tey.Manifest.read(`
      package "app" do
        group :dev do
          tey("helper", git: "https://example.com/h", branch: "main")
        end

        tey("greet", git: "https://example.com/greet", tag: "~> 0.1")
      end
    `).try
    assert(package.manifestDependencies.second.try.manifestGroups.empty?)
  end

  it("reads a declaration spread over several lines") do
    let package = Tey.Manifest.read(`
      package "app" do
        tey("greet",
            git: "https://example.com/greet",
            tag: "~> 0.1")
      end
    `).try
    let dependency = package.manifestDependencies.first.try
    assert(dependency.manifestName == "greet")
    match dependency.manifestSource do
      GitSource(git, _, requested, _) => do
        assert(git == "https://example.com/greet")
        assert(requested == "~> 0.1")
      end
      _ => assert(false)
    end
  end

  it("distinguishes the three dependency selectors") do
    let package = Tey.Manifest.read(`
      package "app" do
        tey("a", git: "https://example.com/a", tag: "v1.0.0")
        tey("b", git: "https://example.com/b", branch: "main")
        tey("c", git: "https://example.com/c", ref: "abc123")
      end
    `).try
    let selectors = package.manifestDependencies.map do |dependency|
      match dependency.manifestSource do
        GitSource(_, selector, _, _) => selector
        _ => ""
      end
    end
    let requested = package.manifestDependencies.map do |dependency|
      match dependency.manifestSource do
        GitSource(_, _, value, _) => value
        _ => ""
      end
    end
    assert(selectors == ["tag", "branch", "ref"])
    assert(requested == ["v1.0.0", "main", "abc123"])
  end

  it("reads workspace and path dependency sources") do
    let package = Tey.Manifest.read(`
      package "app" do
        tey("parser", workspace: true)
        tey("fixtures", path: "../fixtures")
      end
    `).try
    match package.manifestDependencies.first.try.manifestSource do
      WorkspaceSource => assert(true)
      _ => assert(false, "workspace source was not preserved")
    end
    match package.manifestDependencies.second.try.manifestSource do
      PathSource(path) => assert(path == "../fixtures")
      _ => assert(false, "path source was not preserved")
    end
  end

  it("reads an optional Git monorepo subdirectory") do
    let dependency = Tey.Manifest.read(`
      package "app" do
        tey("parser", git: "https://example.com/compiler", tag: "~> 1.2",
            subdir: "packages/parser")
      end
    `).try.manifestDependencies.first.try
    match dependency.manifestSource do
      GitSource(_, _, _, subdir) =>
        assert(subdir == "packages/parser")
      _ => assert(false)
    end
  end

  it("rejects subdir on non-Git dependency sources") do
    [`
      package "app" do
        tey("dep", path: "../dep", subdir: "packages/dep")
      end
    `, `
      package "app" do
        tey("dep", workspace: true, subdir: "packages/dep")
      end
    `].each do |text|
      match Tey.Manifest.read(text) do
        Error(message) => assert(message.contains?("subdir: without git:"))
        Ok(_) => assert(false, "accepted subdir: on a non-Git dependency")
      end
    end
  end

  it("requires exactly one dependency source") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        tey("parser", workspace: true, path: "../parser")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("exactly one"))
      Ok(_) => assert(false, "accepted two dependency sources")
    end
  end

  it("requires an explicit selector for a Git dependency") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        tey("parser", git: "https://example.com/parser")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("tag:"))
      Ok(_) => assert(false, "accepted an unpinned Git dependency")
    end
  end

  it("refuses a manifest with no package name") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`version("0.1.0")
`)
    match outcome do
      Error(message) => assert(message.contains?("package"))
      Ok(_) => assert(false)
    end
  end

  it("refuses a dependency with no source") do
    # Nothing else can locate it, so accepting this would only defer the
    # failure to fetch time with less to say.
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        tey("greet", tag: "~> 0.1")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("exactly one"),
                               "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted dependency without a source")
    end
  end
end

# `command(name, run:, description:)` — the manifest's answer to the Makefile
# every package used to grow beside it. What matters here is that a declaration
# can never take a name Tey already answers: `tey test` must mean the same
# thing in every checkout, and a manifest that tries to change that has to say
# so loudly rather than win quietly.
describe("Tey.Manifest.read — commands") do
  it("reads a command's name, line and description") do
    let package = Tey.Manifest.read(`
      package "app" do
        command("fmt", run: "kex --format src", description: "Format the sources")
      end
    `).try
    assert(package.commands.count == 1)
    let command = package.commands.first.try
    assert(command.commandName == "fmt")
    assert(command.commandRun == "kex --format src")
    assert(command.commandDescription == "Format the sources")
  end

  it("leaves the description empty when there is none") do
    let package = Tey.Manifest.read(`
      package "app" do
        command("release", run: "script/release.kex")
      end
    `).try
    assert(package.commands.first.try.commandDescription == "")
  end

  it("keeps declared commands in order") do
    let package = Tey.Manifest.read(`
      package "app" do
        command("fmt", run: "kex --format src")
        command("release", run: "script/release.kex")
      end
    `).try
    assert(package.commands.map { |command| command.commandName } == ["fmt", "release"])
  end

  it("has no commands when the manifest declares none") do
    let package = Tey.Manifest.read(`
      package "app" do
        version("0.1.0")
      end
    `).try
    assert(package.commands == [])
  end

  it("refuses to redeclare a built-in command") do
    # A silent shadow would make `tey test` mean something different depending
    # on which directory you are standing in.
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        command("test", run: "make test")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("built-in"), "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted a command shadowing `tey test`")
    end
  end

  it("takes a colon-namespaced name") do
    # `:` is the separator every other package manager already taught people,
    # and it survives a shell without quoting.
    let package = Tey.Manifest.read(`
      package "app" do
        command("db:migrate", run: "script/migrate.kex")
      end
    `).try
    assert(package.commands.first.try.commandName == "db:migrate")
  end

  it("refuses a name with a space in it") do
    # It would be two words on the command line, and the second would look
    # like an argument. The colon is the way to group.
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        command("db migrate", run: "script/migrate.kex")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("colon"), "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted a two-word command name")
    end
  end

  it("refuses a command with no run:") do
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        command("fmt", description: "Format the sources")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("run:"), "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted a command with nothing to run")
    end
  end

  it("refuses the same command twice") do
    # Two answers to one name; the second would silently never run.
    let outcome: ManifestPackage or! String = Tey.Manifest.read(`
      package "app" do
        command("fmt", run: "kex --format src")
        command("fmt", run: "make fmt")
      end
    `)
    match outcome do
      Error(message) => assert(message.contains?("twice"), "unexpected error: ${message}")
      Ok(_) => assert(false, "unexpectedly accepted a command declared twice")
    end
  end
end

# `toolchain(name, compiler:, runtime:, stdlib:)` — what makes a package a
# compiler distribution rather than a library or an application. Kex's own
# package.kex declares it, so a tey that cannot read it cannot run commands in
# the compiler's own checkout — the exact place tey is developed.
describe("Tey.Manifest.read — toolchain declarations") do
  it("reads a toolchain's name and parts") do
    let package = Tey.Manifest.read(`
      package "kex" do
        version("0.3.0")
        toolchain("kex", compiler: "bin/kex", runtime: "share/kex/runtime",
                  stdlib: "share/kex/stdlib")
      end
    `).try
    let toolchain = package.manifestToolchain.try
    assert(toolchain.toolchainName == "kex")
    assert(toolchain.toolchainCompiler == "bin/kex")
    assert(toolchain.toolchainRuntime == "share/kex/runtime")
    assert(toolchain.toolchainStdlib == "share/kex/stdlib")
  end

  it("leaves the parts empty when only the name is given") do
    let package = Tey.Manifest.read(`
      package "kex" do
        toolchain("kex")
      end
    `).try
    let toolchain = package.manifestToolchain.try
    assert(toolchain.toolchainCompiler == "")
    assert(toolchain.toolchainRuntime == "")
    assert(toolchain.toolchainStdlib == "")
  end

  it("has no toolchain when the manifest declares none") do
    let package = Tey.Manifest.read(`
      package "greet" do
        version("0.1.0")
      end
    `).try
    assert(package.manifestToolchain == None)
  end
end

describe("Tey.Manifest.readLocal") do
  it("parses live path overrides without executing them") do
    let overrides = Tey.Manifest.readLocal(`
      local("parser", path: "../../parser")
      local("fixtures", path: "/src/fixtures")
    `).try
    assert(overrides.map { |override| override.localName } ==
           ["parser", "fixtures"])
    assert(overrides.first.try.localPath == "../../parser")
  end

  it("rejects duplicate overrides") do
    match Tey.Manifest.readLocal(`
      local("parser", path: "one")
      local("parser", path: "two")
    `) do
      Error(message) => assert(message.contains?("twice"))
      Ok(_) => assert(false)
    end
  end

  it("rejects ignored local override syntax") do
    [`
      local("dep", "ignored", path: "../dep")
    `, `
      local("dep", path: "../dep", hidden: true)
    `, `
      local("dep", path: "../dep") do end
    `].each do |text|
      match Tey.Manifest.readLocal(text) do
        Error(_) => assert(true)
        Ok(_) => assert(false, "accepted ignored local override syntax")
      end
    end
  end
end
