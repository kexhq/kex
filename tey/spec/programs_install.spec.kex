describe("Tey program receipts integration") do
  let root = "/tmp/tey_programs_install_spec"
  let home = "${root}/home"
  let checkout = FS.Directory.current
  let compiler = FS.Path.join(checkout, "build/kex")

  let writePackage(name: String, targets: [String]) -> Void do
    let declarations = targets.map { |target| "  target(\"${target}\")" }.join("\n")
    FS.Directory.create("${root}/${name}/src")
    FS.File.write("${root}/${name}/package.kex",
                  "package \"${name}\" do\n  kex(\">= 0.3.0\")\n${declarations}\nend\n")
    FS.File.write("${root}/${name}/src/main.kex",
                  "main do\n  IO.printLine(\"${name}\")\nend\n")
    ()
  end

  # Runs `tey <arguments>` from `directory` through Tey.Cli, with the Tey home
  # pointed at the scratch directory.
  let tey(directory: String, arguments: String) -> ProcessResult do
    return Process.run("sh", ["-c",
      "cd \"$1\" && TEY_HOME=\"$5\" TEY_CACHE=\"$5/cache\" exec \"$2\" --no-colors --source-root \"$3\" \"$4\" -- ${arguments}",
      "tey-programs-spec", directory, compiler,
      FS.Path.join(checkout, "tey/src"), "${root}/run-tey.kex", home]).try
  end

  before do
    FS.Directory.deleteAll(root)
    FS.Directory.create(root)
    FS.File.write("${root}/run-tey.kex", `
      using Tey.Cli

      main(args) do
        System.exit(Tey.Cli.dispatch(args))
      end
    `)
    ENV.set("TEY_KEX", compiler)
  end

  after { FS.Directory.deleteAll(root) }

  it("records a receipt and lists the program outside any project") do
    writePackage("alpha", ["alpha"])
    let installed = tey("${root}/alpha", "install")
    assert(installed.exitCode == 0, installed.stderr)
    assert(FS.File.file?("${home}/bin/alpha"))
    # A `main do` program compiles to main/0; the escript must still start it.
    let ran = Process.run("${home}/bin/alpha", []).try
    assert(ran.stdout.trim == "alpha", ran.stdout + ran.stderr)
    let receipt = Tey.Programs.decode(FS.File.read("${home}/programs/alpha/receipt.json").try).try
    assert(receipt.targets == ["alpha"], "${receipt}")
    assert(receipt.sourcePath == "${root}/alpha", receipt.sourcePath)

    let listed = tey(root, "list")
    assert(listed.exitCode == 0, listed.stderr)
    assert(listed.stdout.contains?("Installed programs"), listed.stdout)
    assert(listed.stdout.contains?("alpha 0.1.0 (alpha) from ${root}/alpha"), listed.stdout)
  end

  it("refuses another package's program unless forced, then transfers it") do
    writePackage("alpha", ["shared"])
    writePackage("beta", ["shared"])
    assert(tey("${root}/alpha", "install").exitCode == 0)

    let refused = tey("${root}/beta", "install")
    assert(refused.exitCode != 0, "took over another package's program")
    assert(refused.stderr.contains?("already installed by `alpha`"), refused.stderr)
    assert(!FS.Directory.directory?("${home}/programs/beta"))

    let forced = tey("${root}/beta", "install --force")
    assert(forced.exitCode == 0, forced.stderr)
    assert(forced.stdout.contains?("Took over shared"), forced.stdout)
    assert(FS.File.file?("${home}/programs/beta/receipt.json"))
    assert(!FS.Directory.directory?("${home}/programs/alpha"),
           "the previous owner kept a receipt for a program it no longer owns")
  end

  it("refuses a file Tey did not write, and adopts one it did") do
    writePackage("alpha", ["alpha"])
    FS.Directory.create("${home}/bin")
    FS.File.write("${home}/bin/alpha", "#!/bin/sh\necho mine\n")
    let refused = tey("${root}/alpha", "install")
    assert(refused.exitCode != 0, "replaced a file Tey did not write")
    assert(FS.File.read("${home}/bin/alpha").try.contains?("echo mine"))

    FS.File.write("${home}/bin/alpha", "#!/usr/bin/env escript\n%%!-escript main kex_main\n")
    let adopted = tey("${root}/alpha", "install")
    assert(adopted.exitCode == 0, adopted.stderr)
    assert(FS.File.file?("${home}/programs/alpha/receipt.json"))
  end

  it("removes a program the package no longer declares") do
    writePackage("alpha", ["alpha", "alpha-extra"])
    assert(tey("${root}/alpha", "install").exitCode == 0)
    assert(FS.File.file?("${home}/bin/alpha-extra"))

    writePackage("alpha", ["alpha"])
    let reinstalled = tey("${root}/alpha", "install")
    assert(reinstalled.exitCode == 0, reinstalled.stderr)
    assert(!FS.File.file?("${home}/bin/alpha-extra"))
    let receipt = Tey.Programs.decode(FS.File.read("${home}/programs/alpha/receipt.json").try).try
    assert(receipt.targets == ["alpha"], "${receipt}")
  end

  it("installs a program from a path without touching its checkout") do
    writePackage("alpha", ["alpha"])
    let installed = tey(root, "install ./alpha")
    assert(installed.exitCode == 0, installed.stderr)
    assert(FS.File.file?("${home}/bin/alpha"))
    let ran = Process.run("${home}/bin/alpha", []).try
    assert(ran.stdout.trim == "alpha", ran.stdout + ran.stderr)
    let receipt = Tey.Programs.decode(FS.File.read("${home}/programs/alpha/receipt.json").try).try
    assert(receipt.sourcePath == "${root}/alpha", receipt.sourcePath)
    assert(!receipt.sourceDigest.empty?, "no source digest")
    assert(FS.File.file?("${home}/programs/alpha/build/package.kex"))
    assert(!FS.Directory.directory?("${root}/alpha/ebin"), "built inside the checkout")
    assert(!FS.File.file?("${root}/alpha/tey.lock"), "wrote a lock into the checkout")
    assert(FS.Directory.directories("${home}/staging").or([]).empty?, "left a staging tree behind")
  end

  it("refuses a library with a pointer to `tey add`") do
    writePackage("helpers", [])
    let refused = tey(root, "install ./helpers")
    assert(refused.exitCode != 0, "installed a library")
    assert(refused.stderr.contains?("tey add"), refused.stderr)
    assert(!FS.Directory.directory?("${home}/programs/helpers"))
  end

  it("installs a workspace member, and asks which one at the root") do
    FS.Directory.create("${root}/ws/packages/cli/src")
    FS.File.write("${root}/ws/package.kex", `
      package "ws" do
        kex(">= 0.3.0")
        workspace do
          members(["packages/*"])
        end
      end
    `)
    FS.File.write("${root}/ws/packages/cli/package.kex", `
      package "cli" do
        kex(">= 0.3.0")
        target("cli")
      end
    `)
    FS.File.write("${root}/ws/packages/cli/src/main.kex", "main do\n  IO.printLine(\"cli\")\nend\n")

    let ambiguous = tey(root, "install ./ws")
    assert(ambiguous.exitCode != 0, "picked a member without being told")
    assert(ambiguous.stderr.contains?("--package"), ambiguous.stderr)

    let byPath = tey(root, "install ./ws/packages/cli")
    assert(byPath.exitCode == 0, byPath.stderr)
    assert(FS.File.file?("${home}/bin/cli"))

    let byName = tey(root, "install ./ws --package cli")
    assert(byName.exitCode == 0, byName.stderr)
  end

  it("builds against a path dependency outside the program's workspace") do
    FS.Directory.create("${root}/greeting/src")
    FS.File.write("${root}/greeting/package.kex", `
      package "greeting" do
        kex(">= 0.3.0")
      end
    `)
    FS.File.write("${root}/greeting/src/greeting.kex",
                  "module Greeting\n\nlet text -> String = \"hello from a path dependency\"\n")
    FS.Directory.create("${root}/hello/src")
    FS.File.write("${root}/hello/package.kex", `
      package "hello" do
        kex(">= 0.3.0")
        tey("greeting", path: "../greeting")
        target("hello")
      end
    `)
    FS.File.write("${root}/hello/src/main.kex",
                  "using Greeting\n\nmain do\n  IO.printLine(Greeting.text)\nend\n")
    let installed = tey(root, "install ./hello")
    assert(installed.exitCode == 0, installed.stdout + installed.stderr)
    let ran = Process.run("${home}/bin/hello", []).try
    assert(ran.stdout.trim == "hello from a path dependency", ran.stdout + ran.stderr)
  end

  # A Git repository at `${root}/<name>.git` with two commits: `v1.0.0`, whose
  # programs print "one", and `main` after it, printing "two". Answers the
  # file:// URL to install from.
  let gitRepository(name: String, targets: [String]) -> String do
    let repo = "${root}/${name}.git"
    let declarations = targets.map { |target| "  target(\"${target}\", entrypoint: \"src/${target}.kex\")" }.join("\n")
    FS.Directory.create("${repo}/src")
    FS.File.write("${repo}/package.kex",
                  "package \"${name}\" do\n  kex(\">= 0.3.0\")\n${declarations}\nend\n")
    let git = "git -c user.name=spec -c user.email=spec@example.com"
    let write(text: String) -> Void do
      targets.each do |target|
        FS.File.write("${repo}/src/${target}.kex", "main do\n  IO.printLine(\"${text}\")\nend\n")
      end
      ()
    end
    write("one")
    Process.run("sh", ["-c", "cd \"$1\" && git init -q -b main && ${git} add -A && ${git} commit -q -m one && git tag v1.0.0",
                       "spec", repo]).try
    write("two")
    Process.run("sh", ["-c", "cd \"$1\" && ${git} commit -q -am two", "spec", repo]).try
    return "file://${repo}"
  end

  it("installs from a Git URL at HEAD, or at a tag") do
    let url = gitRepository("gitty", ["gitty"])
    let head = tey(root, "install ${url}")
    assert(head.exitCode == 0, head.stdout + head.stderr)
    let ranTwo = Process.run("${home}/bin/gitty", []).try
    assert(ranTwo.stdout.trim == "two", "head: [${ranTwo.exitCode}] ${ranTwo.stdout}${ranTwo.stderr}")
    let receipt = Tey.Programs.decode(FS.File.read("${home}/programs/gitty/receipt.json").try).try
    assert(receipt.sourceKind == "git", "${receipt}")
    assert(receipt.sourcePath == url, receipt.sourcePath)
    assert(receipt.sourceRequested == "HEAD", receipt.sourceRequested)
    assert(Tey.Git.commitId?(receipt.sourceCommit), receipt.sourceCommit)

    let tagged = tey(root, "install ${url} --tag v1.0.0")
    assert(tagged.exitCode == 0, tagged.stdout + tagged.stderr)
    let ranOne = Process.run("${home}/bin/gitty", []).try
    assert(ranOne.stdout.trim == "one", "tag: [${ranOne.exitCode}] ${ranOne.stdout}${ranOne.stderr}")
    let pinned = Tey.Programs.decode(FS.File.read("${home}/programs/gitty/receipt.json").try).try
    assert(pinned.sourceSelector == "tag" && pinned.sourceRequested == "v1.0.0", "${pinned}")
    let listed = tey(root, "list")
    assert(listed.stdout.contains?("@ v1.0.0"), listed.stdout)

    # A full commit id is a pin of its own.
    let exact = tey(root, "install ${url} --ref ${receipt.sourceCommit}")
    assert(exact.exitCode == 0, exact.stdout + exact.stderr)
    let ranExact = Process.run("${home}/bin/gitty", []).try
    assert(ranExact.stdout.trim == "two", "exact: [${ranExact.exitCode}] ${ranExact.stdout}${ranExact.stderr}")
  end

  it("installs only the targets --target names") do
    let url = gitRepository("pair", ["first", "second"])
    let unknown = tey(root, "install ${url} --target third")
    assert(unknown.exitCode != 0, "installed an undeclared target")
    assert(unknown.stderr.contains?("no target third"), unknown.stderr)

    let one = tey(root, "install ${url} --target second")
    assert(one.exitCode == 0, one.stdout + one.stderr)
    assert(FS.File.file?("${home}/bin/second"))
    assert(!FS.File.file?("${home}/bin/first"), "installed a target not asked for")

    # Resolving anew rather than from the program's lock installs the same.
    let fresh = tey(root, "install ${url} --fresh")
    assert(fresh.exitCode == 0, fresh.stdout + fresh.stderr)
    assert(FS.File.file?("${home}/bin/first") && FS.File.file?("${home}/bin/second"))
  end

  it("refuses more than one Git pin") do
    let refused = tey(root, "install file:///nowhere.git --tag v1 --branch main")
    assert(refused.exitCode != 0)
    assert(refused.stderr.contains?("only one of"), refused.stderr)
  end

  # Commits a new message for every target of the repository `gitRepository`
  # made, on `main`.
  let commitMessage(name: String, targets: [String], text: String) -> Void do
    let repo = "${root}/${name}.git"
    targets.each do |target|
      FS.File.write("${repo}/src/${target}.kex", "main do\n  IO.printLine(\"${text}\")\nend\n")
    end
    let git = "git -c user.name=spec -c user.email=spec@example.com"
    Process.run("sh", ["-c", "cd \"$1\" && ${git} commit -q -am \"$2\"", "spec", repo, text]).try
    ()
  end

  let output(program: String) -> String do
    return Process.run("${home}/bin/${program}", []).map { |ran| ran.stdout.trim }.or("")
  end

  it("updates a path install by name only when its source changed") do
    writePackage("alpha", ["alpha"])
    assert(tey(root, "install ./alpha").exitCode == 0)
    let unchanged = tey(root, "install alpha")
    assert(unchanged.exitCode == 0, unchanged.stderr)
    assert(unchanged.stdout.contains?("up to date"), unchanged.stdout)

    FS.File.write("${root}/alpha/src/main.kex", "main do\n  IO.printLine(\"alpha two\")\nend\n")
    let changed = tey(root, "install alpha")
    assert(changed.exitCode == 0, changed.stdout + changed.stderr)
    assert(output("alpha") == "alpha two", output("alpha"))

    let rebuilt = tey(root, "install alpha --rebuild")
    assert(rebuilt.exitCode == 0, rebuilt.stderr)
    assert(rebuilt.stdout.contains?("Installed alpha"), rebuilt.stdout)
  end

  it("updates a branch install, and keeps a tag pinned until told") do
    let url = gitRepository("gitty", ["gitty"])
    assert(tey(root, "install ${url}").exitCode == 0)
    assert(tey(root, "install gitty").stdout.contains?("up to date"))
    commitMessage("gitty", ["gitty"], "three")
    let moved = tey(root, "install gitty")
    assert(moved.exitCode == 0, moved.stdout + moved.stderr)
    assert(output("gitty") == "three", output("gitty"))

    assert(tey(root, "install ${url} --tag v1.0.0").exitCode == 0)
    let pinned = tey(root, "install gitty")
    assert(pinned.exitCode == 0, pinned.stderr)
    assert(pinned.stdout.contains?("pinned at v1.0.0"), pinned.stdout)
    assert(output("gitty") == "one", output("gitty"))

    let repinned = tey(root, "install gitty --branch main")
    assert(repinned.exitCode == 0, repinned.stdout + repinned.stderr)
    assert(output("gitty") == "three", output("gitty"))
  end

  it("keeps a --target selection when updating, and updates several at once") do
    let url = gitRepository("pair", ["first", "second"])
    assert(tey(root, "install ${url} --target second").exitCode == 0)
    writePackage("alpha", ["alpha"])
    assert(tey(root, "install ./alpha").exitCode == 0)
    commitMessage("pair", ["first", "second"], "three")
    let both = tey(root, "install pair alpha")
    assert(both.exitCode == 0, both.stdout + both.stderr)
    assert(output("second") == "three", output("second"))
    assert(!FS.File.file?("${home}/bin/first"), "an update installed an unselected target")

    let mixed = tey(root, "install pair ./alpha")
    assert(mixed.exitCode != 0, "accepted a source among names")
  end

  it("uninstalls what its receipt owns and leaves what it does not") do
    writePackage("alpha", ["alpha", "alpha-extra"])
    assert(tey(root, "install ./alpha").exitCode == 0)
    FS.File.write("${home}/bin/alpha-extra", "#!/bin/sh\necho mine\n")
    let removed = tey(root, "uninstall alpha")
    assert(removed.exitCode == 0, removed.stderr)
    assert(!FS.File.file?("${home}/bin/alpha"))
    assert(FS.File.file?("${home}/bin/alpha-extra"), "removed a file Tey did not write")
    assert(removed.stderr.contains?("alpha-extra"), removed.stderr)
    assert(!FS.Directory.directory?("${home}/programs/alpha"))

    let missing = tey(root, "uninstall alpha")
    assert(missing.exitCode != 0 && missing.stderr.contains?("not installed"), missing.stderr)
  end
end
