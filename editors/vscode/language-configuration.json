{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["`", "`"]],
  "indentationRules": {
    "increaseIndentPattern": "\\b(do|then|else|elif|rescue)\\b\\s*(#.*)?$|[({[]\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:end|else|elif|rescue|[)}\\]])"
  }
}
