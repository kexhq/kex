# Build output
build/
build-wasm/
out/
node_modules/
*.vsix
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Object/binary files
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Caches (clangd, etc.)
.cache/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Written by `brew bundle` next to the Brewfile it ran against
Brewfile.lock.json

# Scratch files left behind by an interrupted `make spec` IO test run
spec/io_scratch.txt

# BEAM/Erlang build artifacts
*.core
*.beam
*.dump
*.S

# Generated by third_party/gmp-wasm/README.md's build recipe, not
# vendored — regenerate locally when building the wasm target (gmp.h is
# partially generated by GMP's own configure step, so it's build output
# too, not pure source, same reasoning as the .a libs below it).
third_party/gmp-wasm/include/
third_party/gmp-wasm/lib/

# Likewise generated, by third_party/pcre2-wasm/README.md's recipe. Ignoring
# the whole directory rather than listing include/ and lib/: PCRE2's `make
# install` also drops bin/, share/ and lib/pkgconfig, none of which is linked
# or vendored. Only the recipe itself is tracked.
third_party/pcre2-wasm/*
!third_party/pcre2-wasm/README.md

# Assembled by packages/kex/scripts/build.sh from build-wasm/ — build
# output, not source, same reasoning as the gmp-wasm entries above.
packages/kex/dist/

# Tey compiled to BEAM by `make build-tey` (and by tey/Makefile's own build
# target). Generated from tey/src by whichever kex is to hand, so it is build
# output like the entries above — and a .beam cannot be loaded by an older OTP
# than the one that produced it, which makes a checked-in copy actively wrong
# for anyone on a different Erlang.
tey/ebin/

# Generated by tey/Makefile from tey/package.kex, so that `tey --version` and
# the manifest cannot disagree. Source-shaped but not source: the number lives
# in package.kex.
tey/src/tey/version.kex

# The BEAM writes a crash dump into whatever directory it died in, so these
# land in the repo root whenever a spec, an example or the REPL takes down an
# erl. Never source, never worth committing.
erl_crash.dump

# The source-tree Tey launcher, written by the top-level Makefile's `tey-run`
# target. Generated rather than tracked for the same reason `make -C tey
# install` generates one: it bakes in the `erl` that sits beside the `erlc`
# which built tey/ebin, and that path is machine-specific. It was a tracked
# symlink to tey/bin/tey once, which could not work — that script is the
# INSTALLED launcher and defaults TEY_EBIN to the $PREFIX/lib layout `make -C
# tey install` creates, not to the tey/ebin a checkout builds.
/tey-run
